msgstr " escriba el nombre común de la especie a la que pertenece la población. Pulse el botón “asociar organismo” y continúe con el resto del formulario."

#: mason/qtl/submission/guide/population_details.mas:34
msgctxt "help.qtl.population.parents"
msgid "Female and male parents:"
msgstr "Progenitores femenino y masculino:"

#: mason/qtl/submission/guide/population_details.mas:34

#: mason/index.mas:38
msgctxt "global.index.what_is_breedbase"
msgid "What is Breedbase?"
msgstr "Що таке Breedbase?"

# Draft translation; human review required.
#: mason/index.mas:27
msgctxt "global.index.workshops_description"
msgid "You can watch the Breedbase workshops on %{youtube_link}, covering topics such as ontologies, trial design, data collection using fieldbook, data analysis, and genomic selection."
msgstr "Ви можете переглянути семінари Breedbase на %{youtube_link}. У них розглядаються онтології, планування дослідів, збирання даних за допомогою fieldbook, аналіз даних і геномна селекція."


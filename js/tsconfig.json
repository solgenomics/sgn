{
	"compilerOptions": {
		"target": "es2015",
		"module": "es2015",
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"lib": [
			"dom",
			"dom.iterable",
		]
	},
	"include": [
		"source/**/*.ts",
		"source/**/*.tsx",
		"test/**/*.ts",
	]
}
#!/usr/bin/env python3
"""One entry point for release builders, translators and site operators."""

# Standard command names use hyphens.
# pylint: disable=invalid-name
import argparse
import os
import sys
from pathlib import Path

COMMANDS = {
    "review": "review.py",
    **{name: "catalog.py" for name in ("extract", "update", "freeze", "init", "build")},
    **{name: "pack.py" for name in ("create", "validate", "install", "activate", "rollback")},
}


def main():
    """Dispatch to the documented tool without invoking a shell."""
    parser = argparse.ArgumentParser(
        description=__doc__,
        usage="%(prog)s COMMAND [OPTIONS]",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Ready packs:  install, activate, rollback (Python standard library only)
Translations: init, review, build, create, validate
Source release: extract, update, freeze

Use COMMAND --help for its options. Put options after the command.
Source commands accept --root; install/activate/rollback use --root for the pack store.""",
    )
    parser.add_argument("command", choices=COMMANDS)
    command = parser.parse_args(sys.argv[1:2]).command
    script = Path(__file__).resolve().parent / COMMANDS[command]
    os.execv(sys.executable, [sys.executable, str(script), *sys.argv[1:]])


if __name__ == "__main__":
    raise SystemExit(main())

<%args>
$unigene
</%args>
<%init>
use HTML::Entities ();
my @xrefs = map {
    $_->xrefs({
        -types   => ['match'],
        -name    => 'SGN-U'.$unigene->get_unigene_id,
        -aliases => 1,
    })
} $c->enabled_feature('gbrowse2');

</%init>
<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p("program.unigene.genomic_locations", "Genomic locations (%{count})", {count => scalar(@xrefs)})),collapsible => 1, &>
% if( @xrefs ) {
  <& /sitefeatures/gbrowse2/xref_set/rich.mas, xrefs => \@xrefs &>
% }
</&>

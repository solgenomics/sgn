<%args>
$programs
$locations
</%args>


<& /util/import_javascript.mas, classes => ['CXGN.TrialTreeFolders'] &>

<div class="modal fade" id="create_transformation_project_dialog" name="create_transformation_project_dialog" tabindex="-1" role="dialog" aria-labelledby="createTransformationProjectDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header">
                <button type="reset" class="close" id="add_transformation_project_dismiss_button_1" name="add_transformation_project_dismiss_button" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <center><h4 class="modal-title" id="createTransformationProjectDialog"><% $c->i18n->p("transformation.add_new_transformation_project", "Add New Transformation Project") |h %></h4></center>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "add_transformation_project_workflow" &>
                        <&| /util/workflow.mas:step, title=> $c->i18n->p("cross.ui.intro", "Intro") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("transformation.what_are_transformation_projects.b3cc06c", "What are Transformation Projects?")) &>

                            <p><% $c->i18n->p("transformation.you_can_use_transformation_projects_to_manage_and_organize_your", "You can use Transformation Projects to manage and organize your transformation experiemnts") |h %></p>
                            <ul>
                                <li><% $c->i18n->p("transformation.each_transformation_experiment_is_linked_to_a_globally_unique_transformation", "Each transformation experiment is linked to a globally unique transformation ID.") |h %></li>
                                <li><% $c->i18n->p("transformation.transformation_id_captures_information_about_plant_material_and_vector_construct", "Transformation ID captures information about plant material and vector construct used in that experiment.") |h %></li>
                                <li><% $c->i18n->p("transformation.you_can_use_transformation_details_page_to_automatically_add_new", "You can use transformation details page to automatically add new transformant (accession) names to database by simply indicating the number of transformants generated.") |h %></li>
                                <li><% $c->i18n->p("transformation.each_auto_generated_transformant_accession_name_has_transformation_id_as", "Each auto-generated transformant (accession) name has transformation ID as basename and an incremental serial number.") |h %> </li>
                            </ul>
                            <hr>
                            <center>
                                <button id="next_step_add_new_intro" class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p("cross.ui.go_to_next_step", "Go to Next Step") |h %></button>
                            </center>
                        </&>

                        <form class="form-horizontal" role="form" name="create_transformation_project_form" id="create_transformation_project_form">
                            <&| /util/workflow.mas:step, title=> $c->i18n->p("transformation.add_a_transformation_project", "Add a transformation project") &>
                                <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("transformation.enter_basic_information_about_the_transformation_project", "Enter basic information about the transformation project")) &>
                                    <br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-lable"><% $c->i18n->p("seedlot.project_name", "Project Name:") |h %> </label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="text" id="transformation_project_name" name="transformation_project_name"  />
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p("cross.ui.breeding_program.2c9b17e", "Breeding Program:") |h %> </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="transformation_project_program" name="transformation_project_program">
                                                <option value=""><% $c->i18n->p("cross.ui.select_breeding_program", "Select Breeding Program") |h %></option>
<%perl>
foreach my $program (@$programs) {
    if (@$program[3]) {
        print "<option selected=\"selected\" value='".@$program[0]."'>".@$program[1]."</option>";
    } else {
        print "<option value='".@$program[0]."'>".@$program[1]."</option>";
    }
}
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p("seedlot_record.ui.location", "Location:") |h %> </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="transformation_project_location" name="transformation_project_location">
                                                <option value=""><% $c->i18n->p("cross.ui.select_location", "Select Location") |h %></option>
<%perl>
    foreach my $location_hashref (@$locations) {
        my $properties = $location_hashref->{'properties'};
        my $program = $properties->{'Program'};
        my $name = $properties->{'Name'};
        print "<option value=\"$name\" data-program=\"$program\">".$name."</option>";
    }
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p("cross.ui.year.c9410fe", "Year:") |h %></label>
                                        <div class="col-sm-9">
                                            <div id="transformation_project_year" name="transformation_project_year" ></div>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p("global.dataset_publish.description", "Description:") |h %></label>
                                        <div class="col-sm-9">
                                            <textarea class="form-control" id="transformation_project_description" name="transformation_project_description" ></textarea>
                                        </div>
                                    </div>
                                <br/>
                                <br/>
                                <br/>
                                <center>
                                    <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="create_transformation_project_submit" id="create_transformation_project_submit"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
                                </center>
                            </&>
                        </form>

                        <&| /util/workflow.mas:complete, title=> $c->i18n->p("cross.ui.complete", "Complete") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("transformation.finished_your_transformation_project_is_now_in_the_database", "Finished! Your transformation project is now in the database")) &>
                            <ul>
                                <li><% $c->i18n->p("seedlot.please_click_on_refresh_button_to_view_your_newly_created", "Please click on 'Refresh' button to view your newly created project on the manage page.") |h %></li>
                                <li><% $c->i18n->p("transformation.you_can_use_your_transformation_project_page_to_create_transformation", "You can use your transformation project page to create transformation IDs.") |h %></li>
                                <li><b><% $c->i18n->p("transformation.if_your_transformation_project_is_automatically_linked_to_the_tracking", "If your transformation project is automatically linked to the tracking tool, please set up a naming format for the autogenerated names of your transformation project before using the tracking tool.") |h %></b></li>
                            </ul>
                            <br/>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_transformation_project_dismiss_button_2" name="add_transformation_project_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    var selectedProgram = jQuery('#transformation_project_program option:selected').text()

    filter_options(selectedProgram, 'program', 'transformation_project_location');

    jQuery('#transformation_project_program').change(function() {
        filter_options(jQuery('#transformation_project_program option:selected').text(), 'program', 'transformation_project_location');
    });

    jQuery("[name='add_transformation_project_dismiss_button']").click(function() {
        jQuery('#create_transformation_project_dialog').modal('hide');
        jQuery('#transformation_project_name').val('');
        jQuery('#transformation_project_program').val('');
        jQuery('#transformation_project_location').val('');
        jQuery('#transformation_project_year').val('');
        jQuery('#transformation_project_description').val('');
    });

    jQuery('#create_transformation_project_submit').click(function() {
        var transformation_project_name = jQuery("#transformation_project_name").val();
        if (!transformation_project_name) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.project_name_is_required", "Project name is required") : "Project name is required"));
            return;
        }

        var selectedProgram = jQuery("#transformation_project_program").val();
        if (!selectedProgram) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.breeding_program_is_required", "Breeding program is required") : "Breeding program is required"));
            return;
        }

        var transformation_project_location = jQuery("#transformation_project_location").val();
        if (!transformation_project_location) {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlots.ui.location_is_required", "Location is required") : "Location is required"));
            return;
        }

        var year = jQuery("#transformation_project_year_select").val();
        if (!year) {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.project.validation.year_required", "Year is required") : "Year is required"));
            return;
        }

        var project_description = jQuery('textarea#transformation_project_description').val();
        if (!project_description) {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.project.validation.description_required", "Description is required") : "Description is required"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/transformation/add_transformation_project',
            dataType: "json",
            type: 'POST',
            data:{
                'project_name': transformation_project_name,
                'project_program_id': selectedProgram,
                'project_location': transformation_project_location,
                'year': year,
                'project_description': project_description,
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            error: function(response) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.files.files.error", "An error occurred!") : "An error occurred!") + JSON.stringify(response));
                return;
            },
            parseerror: function(response) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.a_parse_error_occurred", "A parse error occurred!") : "A parse error occurred!") + response);
                return;
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.error) {
                    alert(response.error);
                }
                if (response.success == 1) {
                    Workflow.focus("#add_transformation_project_workflow", -1); //Go to success page
                    Workflow.check_complete("#add_transformation_project_workflow");
                }
            },

        });

    });

});

</script>

<%once>
use HTML::Entities ();
</%once>

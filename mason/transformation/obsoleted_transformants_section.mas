<%args>
$transformation_id
</%args>

<&| /page/info_section.mas, anchor_title => 'Obsoleted Transgenic Lines (Accessions)', title => HTML::Entities::encode_entities($c->i18n->p("transformation.root.obsoleted_transgenic_lines_accessions", 'Obsoleted Transgenic Lines (Accessions)')), collapsible=>1, collapsed=>1 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table class="table table-hover table-bordered" id="obsoleted_transformants_table">
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

<script>

jQuery(document).ready(function(){

    const transformation_stock_id = "<%$transformation_id%>";

    const obsoleted_transformants_table = jQuery('#obsoleted_transformants_table').DataTable({
        'ajax': '/ajax/transformation/obsoleted_transformants/'+transformation_stock_id,
        'autoWidth': false,
        'order': false,
        'columns': [
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.index_logged_in_user.accession", "Accession") : "Accession")).html(), "data": null, "render": function ( data, type, row ) { return "<a href='/stock/"+row.transformant_id+"/view'>"+row.transformant_name+"</a>"; } },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.root.note", "Note") : "Note")).html(), "data": "obsolete_note" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.file_dump_share_files.date", "Date") : "Date")).html(), "data": "obsolete_date" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.obsoleted_by", "Obsoleted by") : "Obsoleted by")).html(), "data": "obsolete_person" },
        ],
    });

});

</script>

<%once>
use HTML::Entities ();
</%once>

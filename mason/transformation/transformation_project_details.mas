<%once>
use HTML::Entities ();
</%once>

<%args>
$trial_id
$trial_name
$breeding_program_name
$breeding_program_id
$location_name
$country_name
$year
$trial_description
$folder_name
$folder_id
$identifier_prefix
$trial_owner
$tracking_project_id
$autogenerated_name_formats => ()
$name_format
$default_plant_material_id
$default_plant_material_name
</%args>


<div class="row">
    <div class="col-sm-12">
        <table class="table table-hover table-bordered" >
            <tr>
                <td><b><% $c->i18n->p("transformation.transformation_project_name", "Transformation Project Name") |h %></b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%     print "$trial_name";
% } else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("transformation.no_transformation_project_name", "[No Transformation Project Name]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("global.index_logged_in_user.breeding_program", "Breeding Program") |h %> </b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
%     print "$breeding_program_name";
% }
% else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_breeding_program", "[No Breeding Program]")) . "</span>");
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("global.search.features.location", "Location") |h %></b></td>
                <td>
                    <div id="trial_location">
% if ($location_name) {
%     print "$location_name ( $country_name )";
% } else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_location", "[No Location]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("accession.sequencing.table.year", "Year") |h %></b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%    print "$year";
% } else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_year", "[No Year]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></b></td>
                <td>
% if ($trial_description) {
%     print "<div id='trial_description' style='white-space: pre-wrap;'>$trial_description</div>";
% } else {
%     print ("<div id='trial_description'><span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_description", "[No Description]")) . "</span></div>");
% }
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("transformation.name_format_for_transformants", "Name Format for Transformants") |h %></b></td>
                <td>
                    <div id="name_format">
% if ($name_format) {
%     print "$name_format";
% } else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("transformation.not_set", "[Not Set]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("transformation.default_plant_material.2b9a162", "Default Plant Material") |h %></b></td>
                <td>
% if ($default_plant_material_id) {
      <span id="default_plant_material"><a href="/stock/<%$default_plant_material_id%>/view"><%$default_plant_material_name%></a></span>
% } else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("transformation.not_set", "[Not Set]")) . "</span>");
% }
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("cross.ui.folder", "Folder") |h %></b></td>
                <td>
                    <span id="trial_folder_div"><a href="/folder/<% $folder_id %>"><% $folder_name %></a></span>
                    <br/><br/>
                    <button class="btn btn-sm btn-default" style="margin:3px" id="new_folder_dialog_link"><% $c->i18n->p("cross.ui.new_folder", "New Folder") |h %></button> <button class="btn btn-sm btn-default" style="margin:3px" id="open_folder_dialog_link"><% $c->i18n->p("cross.ui.change_folder", "Change Folder") |h %></button>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("cross.ui.created_by", "Created by") |h %></b></td>
                <td>
                    <div id="trial_owner">
% if ($trial_owner) {
%     print "$trial_owner";
% } else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.n_a", "[N/A]")) . "</span>");
% }
                    </div>
                </td>
            </tr>
        </table>

    </div>
</div>
<button class="btn btn-sm btn-default" style="margin:3px" id="set_plant_material_link"><% $c->i18n->p("transformation.set_default_plant_material", "Set Default Plant Material") |h %></button><button class="btn btn-sm btn-default" style="margin:3px" id="set_autogenerated_names_link"><% $c->i18n->p("transformation.set_autogenerated_names_for_transformants", "Set Autogenerated Names for Transformants") |h %></button>
<br/>
<button class="btn btn-sm btn-primary" style="margin:3px" id="new_transformation_identifier_link"><% $c->i18n->p("transformation.add_new_transformation_id", "Add New Transformation ID") |h %></button><button class="btn btn-sm btn-primary" style="margin:3px" id="upload_transformation_ids_link"><% $c->i18n->p("transformation.upload_new_transformation_ids", "Upload New Transformation IDs") |h %></button>
<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_transgenic_lines_link"><% $c->i18n->p("transformation.upload_transgenic_lines", "Upload Transgenic Lines") |h %></button>
<br/>
<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_transgenic_historical_data_link"><% $c->i18n->p("transformation.upload_transgenic_historical_data", "Upload Transgenic Historical Data") |h %></button>
</br>
</br>
% if ($tracking_project_id) {
    <td>
        <a href='/breeders/trial/<%$tracking_project_id%>'><p><% $c->i18n->p("transformation.go_to_transformation_progress", "Go to Transformation Progress") |h %></p></a>
    </td>
% }

<& /transformation/add_transformation_identifier_dialog.mas, trial_id => $trial_id, breeding_program_name => $breeding_program_name, default_plant_material_id => $default_plant_material_id, default_plant_material_name => $default_plant_material_name &>
<& /transformation/upload_transformation_ids_dialog.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /transformation/set_transformant_names_dialog.mas, trial_id => $trial_id, breeding_program_id => $breeding_program_id, autogenerated_name_formats => $autogenerated_name_formats, breeding_program_name => $breeding_program_name &>
<& /transformation/set_default_plant_material_dialog.mas, project_id => $trial_id, breeding_program_name => $breeding_program_name &>
<& /transformation/upload_transgenic_historical_data_dialog.mas, trial_id => $trial_id, trial_name => $trial_name, default_plant_material_id => $default_plant_material_id, default_plant_material_name => $default_plant_material_name, breeding_program_name => $breeding_program_name &>
<& /transformation/upload_transgenic_lines_dialog.mas, breeding_program_name => $breeding_program_name &>

<script>

jQuery(document).ready(function($) {

    jQuery('#new_transformation_identifier_link').click(function() {
        jQuery("#add_transformation_identifier_dialog").modal("show");
    });

});

</script>

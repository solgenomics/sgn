<%once>
use HTML::Entities ();
</%once>

<%doc>

=head1 NAME

/transformation/transformation_project.mas - a mason component to display a transformation detail page

=head1

=cut

</%doc>


<%args>
$trial_id
$trial_name
$breeding_program_id
$breeding_program_name
$location_id
$location_name
$country_name
$year => undef
$trial_type => undef
$trial_description => undef
$folder_name => undef
$folder_id => undef
$locations_by_program_json
$trial_owner => undef
$tracking_project_id => undef
$autogenerated_name_formats => ()
$name_format => undef
$default_plant_material_id => undef
$default_plant_material_name => undef
</%args>


<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial', 'jstree/dist/jstree', 'CXGN.BreedersToolbox.HTMLSelect', 'moment_min', 'daterangepicker'] &>

<br/>


<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("seedlot.details_for", "Details for ")).HTML::Entities::encode_entities($trial_name) &>

<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Transformation Project Details</h4>", info_section_collapsed => 0, trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("transformation.transformation_project_details", "Transformation Project Details")) . "</h4>"), info_section_subtitle => $c->i18n->p("seedlot.view_and_edit_basic_information_about_the_project", 'View and edit basic information about the project.'), buttons_html => ("<button class=\"btn btn-primary btn-sm\" id=\"edit_transformation_project_details\" style=\"margin:3px\">" . HTML::Entities::encode_entities($c->i18n->p("seedlot.edit_project_details", "Edit Project Details")) . "</button>"), icon_class => "glyphicon glyphicon-dashboard", info_section_id => "transformation_project_details", trial_name => $trial_name, breeding_program_name => $breeding_program_name, breeding_program_id => $breeding_program_id, location_name => $location_name, country_name => $country_name, year => $year, trial_description => $trial_description, folder_name => $folder_name, folder_id => $folder_id, trial_owner => $trial_owner, tracking_project_id => $tracking_project_id, autogenerated_name_formats => $autogenerated_name_formats, name_format => $name_format, default_plant_material_id => $default_plant_material_id, default_plant_material_name => $default_plant_material_name  &>
<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Active Transformation IDs</h4>", info_section_collapsed => 0, trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("transformation.active_transformation_ids", "Active Transformation IDs")) . "</h4>"), info_section_subtitle => $c->i18n->p("transformation.view_information_about_ongoing_transformation_ids_in_this_project", 'View information about ongoing transformation ids in this project.'), icon_class => "glyphicon glyphicon-list-alt", info_section_id => "transformations_in_project_section" &>
<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Inactive Transformation IDs</h4>", info_section_collapsed => 0, trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("transformation.inactive_transformation_ids", "Inactive Transformation IDs")) . "</h4>"), info_section_subtitle => $c->i18n->p("transformation.view_information_about_completed_or_terminated_transformation_ids_in_this", 'View information about completed or terminated transformation ids in this project.'), icon_class => "glyphicon glyphicon-ban-circle", info_section_id => "inactive_transformation_ids_in_project_section" &>
<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Delete Project or Transformation IDs</h4>", info_section_collapsed => 1, trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("transformation.delete_project_or_transformation_ids", "Delete Project or Transformation IDs")) . "</h4>"), info_section_subtitle => $c->i18n->p("transformation.delete_transformation_project_or_transformation_ids_in_this_project", 'Delete transformation project or transformation IDs in this project.'), icon_class => "glyphicon glyphicon-trash", info_section_id => "transformation_project_deletion_section" &>


<div id="trialIDDiv" class="trialIDDivClass" style="display:none;">
% print $trial_id;
</div>

<& /transformation/edit_transformation_project_details.mas, trial_name => $trial_name, breeding_program_id => $breeding_program_id, location_id => $location_id, year => $year, trial_description => $trial_description &>
<& /breeders_toolbox/folder/folder_set.mas, project_type => 'transformation_project', breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name, trial_id => $trial_id, trial_name =>$trial_name &>
<& /breeders_toolbox/folder/folder_new.mas, project_type => 'transformation_project', breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name &>

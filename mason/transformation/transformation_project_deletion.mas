<%once>
use HTML::Entities ();
</%once>

<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'CXGN.Transformation' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<&| /page/info_section.mas, anchor_title => 'Delete Transformation IDs', id=>'delete_transformation_ids_section', title => HTML::Entities::encode_entities($c->i18n->p("transformation.root.delete_transformation_ids", 'Delete Transformation IDs')), subtitle => ("<font color=\"red\">" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.deletion_cannot_be_undone", "Deletion cannot be undone")) . "</font>"), collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <center><% $c->i18n->p("transformation.root.you_cannot_delete_any_transformation_id_with_associated_transformants_but", "You cannot delete any transformation ID with associated transformants, but you can mark the transformation ID as terminated.") |h %></center>
    </div>

    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table class="table table-hover table-bordered" id="transformation_ids_deletion_table">
                </table>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, anchor_title => 'Delete Transformation Project', id=>'delete_transformation_project_section', title => HTML::Entities::encode_entities($c->i18n->p("transformation.root.delete_transformation_project.18671e2", 'Delete Transformation Project')), subtitle => ("<font color=\"red\">" . HTML::Entities::encode_entities($c->i18n->p("cross.forms.deletion_cannot_be_undone", "Deletion cannot be undone.")) . "</font>"), collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <center><% $c->i18n->p("transformation.root.you_cannot_delete_any_transformation_project_with_associated_transformation_ids", "You cannot delete any transformation project with associated transformation IDs. Please delete those associated transformation IDs in the project first.") |h %></center>
    </div>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-primary" id="delete_transformation_project" role="button"><% $c->i18n->p("transformation.root.delete_transformation_project.8007a6e", "Delete transformation project") |h %></button><br/><br/>
            </div>
        </div>
    </div>
</&>


<script>

jQuery(document).ready(function(){

    const project_id = "<% $trial_id %>";

    jQuery('#delete_transformation_project').click(function() {
        const confirmation = confirm((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.are_you_sure_you_want_to_delete_this_transformation_project", "Are you sure you want to delete this transformation project? The deletion cannot be undone.") : "Are you sure you want to delete this transformation project? The deletion cannot be undone."));
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/trial/'+project_id+'/delete/transformation_project',
                beforeSend: function(){
                    jQuery('#working_modal').modal("show");
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.soil_table.delete_success", "Deletion was successful") : 'Deletion was successful'));
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.soil_table.delete_error", "An error occurred during deletion") : 'An error occurred during deletion'));
                }
            });
        }
    });

    const deletion_table = jQuery('#transformation_ids_deletion_table').DataTable({
        'ajax': '/ajax/transformation/all_transformation_ids_in_project/'+project_id,
        'autoWidth': false,
        'columns': [
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.transformation_id.6f39808", "Transformation ID") : "Transformation ID")).html(), "data": null, "render": function ( data, type, row ) { return "<a href='/transformation/"+row.transformation_id+"'>"+row.transformation_name+"</a>"; } },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_publish.status.heading", "Status") : "Status")).html(), "data": "status_type" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.number_of_transformants", "Number of Transformants") : "Number of Transformants")).html(), "data": "number_of_transformants" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_cxgn_dataset.delete", "Delete") : "Delete")).html(), "data": null, "render": function ( data, type, row ) {
                if (row.number_of_transformants > 0){
                    return 'Cannot Delete'
                } else {
                    return "<a onclick='deleteTransformationID("+row.transformation_id+(")'>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_cxgn_dataset.delete", "Delete") : "Delete")).html() + "</a>");

                }
            }},

        ],

    });

});

</script>

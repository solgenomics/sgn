<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'CXGN.List', 'jquery.iframe-post-form' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<div style="overflow:scroll">
    <table class="table table-hover table-bordered" id="inactive_transformation_ids_in_project_table">
        <thead>
            <tr>
                <th><% $c->i18n->p("transformation.transformation_id.6f39808", "Transformation ID") |h %></th>
                <th><% $c->i18n->p("global.dataset_publish.status.heading", "Status") |h %></th>
                <th><% $c->i18n->p("transformation.plant_material", "Plant Material") |h %></th>
                <th><% $c->i18n->p("transformation.vector_construct.d77fa05", "Vector Construct") |h %></th>
                <th><% $c->i18n->p("cross.ui.notes", "Notes") |h %></th>
                <th><% $c->i18n->p("transformation.control", "Control") |h %></th>
                <th><% $c->i18n->p("transformation.root.no_of_transformants_accessions", "No of Transformants (Accessions)") |h %></th>
            </tr>
        </thead>
    </table>
</div>


<script>

jQuery(document).ready(function(){
    var project_id = "<% $trial_id %>";

    var transformation_table = jQuery('#inactive_transformation_ids_in_project_table').DataTable({
        'ajax': '/ajax/transformation/inactive_transformation_ids_in_project/'+project_id,
        'autoWidth': false,
    });


});

</script>

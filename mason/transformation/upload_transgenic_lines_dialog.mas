<%args>
$breeding_program_name
</%args>

<div class="modal fade" id="upload_transgenic_lines_dialog" name="upload_transgenic_lines_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadTransgenicLinesDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="reset" class="close" id="upload_transgenic_lines_dismiss_button_1" name="upload_transgenic_lines_dismiss_button" aria-label="<% $c->i18n->p('transformation.dialog.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTransgenicLinesDialog"><% $c->i18n->p('transformation.transgenic_lines.upload_title', 'Upload Transgenic Lines') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>$c->i18n->p('transformation.transgenic_lines.template_information', 'Template Information') &>
                        <p>
                            <b><% $c->i18n->p('transformation.transgenic_lines.file_format_information', 'File format information') |h %></b>
                            <br>
                            <a id="transgenic_lines_upload_spreadsheet_format_info"><% $c->i18n->p('cross.ui.spreadsheet_format.f1285ec', 'Spreadsheet Format') |h %></a>
                        </p>
                    </&>
                    <form method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_transgenic_lines_form" name="upload_transgenic_lines_form">
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p('transformation.transgenic_lines.upload_file', 'Upload File: ') |h %></label>
                            <div class="col-sm-9" >
                                <input type="file" name="transgenic_lines_upload_file" id="transgenic_lines_upload_file" encoding="multipart/form-data" />
                                <input name="project_breeding_program_name" id="project_breeding_program_name" type="hidden" value="<% $breeding_program_name %>">
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="upload_transgenic_lines_dismiss_button_2" name="upload_transgenic_lines_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('transformation.dialog.close', 'Close') |h %></button>
                <button type="button" class="btn btn-primary" name="upload_transgenic_lines_submit" id="upload_transgenic_lines_submit"><% $c->i18n->p('transformation.transgenic_lines.upload', 'Upload') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="transgenic_lines_saved_dialog_message" name="transgenic_lines_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="transgenicLinesSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('transformation.dialog.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="transgenicLinesSavedDialog"><% $c->i18n->p('transformation.transgenic_lines.success_title', 'Success') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p('transformation.transgenic_lines.saved_successfully', 'The transgenic lines were saved successfully.') |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_transgenic_lines_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('transformation.transgenic_lines.close_reload', 'Close & Reload') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_transgenic_lines_error_display" name="upload_transgenic_lines_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadTransgenicLinesErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('transformation.dialog.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTransgenicLinesErrorDialog"><% $c->i18n->p('transformation.transgenic_lines.error_title', 'Upload Transgenic Lines Error') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('transformation.dialog.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="transgenic_lines_upload_spreadsheet_info_dialog" name="transgenic_lines_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadTransgenicLinesInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('transformation.dialog.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTransgenicLinesInfoDialog"><% $c->i18n->p('transformation.transgenic_lines.template_title', 'Upload Template Information For Transgenic Lines') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% $c->i18n->p('transformation.transgenic_lines.header', 'Header:') |h %></b>
                    <br>
                    <% $c->i18n->p('transformation.transgenic_lines.header_instruction', 'The first row (header) should contain the following:') |h %>
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>transformation_identifier</td>
                                <td>transgenic_line_name</td>
                            </tr>
                        </tbody>
                    </table>

                    <b><% $c->i18n->p('transformation.transgenic_lines.required_fields', 'Required fields:') |h %></b>
                    <ul>
                        <li>transformation_identifier (<% $c->i18n->p('transformation.transgenic_lines.identifier_must_exist', 'must exist in the database') |h %>). <% $c->i18n->p('transformation.transgenic_lines.multiple_identifiers', 'Multiple transformation identifiers can be included in the same spreadsheet.') |h %></li>
                        <li>transgenic_line_name (<% $c->i18n->p('transformation.transgenic_lines.line_name_must_not_exist', 'must NOT exist in the database') |h %>)</li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => $c->i18n->p('transformation.transgenic_lines.type_name', 'Transgenic Lines'), optional_column => 0 &>
            </div>
            <div class="modal-footer">
                <button id="close_transgenic_lines_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('transformation.dialog.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    function transgenicLinesLocaleHeaders(url) {
        try {
            var target = new URL(url, window.location.href);
            if (target.origin !== window.location.origin || target.pathname !== '/ajax/transformation/upload_transgenic_lines') return {};
            var root = typeof document !== 'undefined' && document.documentElement;
            var runtime = window.SGN && window.SGN.i18n;
            var requested = root && root.getAttribute('data-sgn-locale');
            var locale = requested || (runtime && runtime.requestedLocale) || (root && root.lang) || (runtime && runtime.locale) || 'en';
            return {'X-SGN-Locale': typeof locale === 'string' && /^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$/.test(locale) ? locale : 'en'};
        } catch (error) {
            return {};
        }
    }

    jQuery('#upload_transgenic_lines_link').click(function() {
        jQuery("#upload_transgenic_lines_dialog").modal("show");
    });

    jQuery('#upload_transgenic_lines_spreadsheet_format_info').click(function(){
        jQuery("#transgenic_lines_upload_spreadsheet_info_dialog").modal("show");
    });


    jQuery("#upload_transgenic_lines_submit").click(function(){
        if (transgenic_lines_upload_file === ''){
            alert((window.SGN && window.SGN.i18n ? SGN.i18n.p('global.manage_file_share_dump.select_file', 'Please select a file') : 'Please select a file'));
            return;
        }

        jQuery("#working_modal").modal("show");
        jQuery.ajax({
            url: "/ajax/transformation/upload_transgenic_lines",
            type: 'POST',
            data: new FormData(jQuery("#upload_transgenic_lines_form")[0]),
            processData: false,
            contentType: false,
            headers: transgenicLinesLocaleHeaders('/ajax/transformation/upload_transgenic_lines'),
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error_string) {
                    jQuery("#upload_transgenic_lines_error_display tbody").html('');
                    jQuery("#upload_transgenic_lines_error_display tbody").append(response.error_string);
                    jQuery("#upload_transgenic_lines_error_display").modal("show");
                    return;
                }
                if (response.error) {
                    alert(response.error);
                    return;
                }
                if (response.success) {
                    jQuery('#upload_transgenic_lines_dialog').modal('hide');
                    jQuery('#transgenic_lines_saved_dialog_message').modal("show");
                }
            }
        });
    });

    jQuery("#dismiss_transgenic_lines_saved_dialog").click(function(){
        location.reload();
    });

    jQuery('#transgenic_lines_upload_spreadsheet_format_info').click(function() {
        jQuery("#transgenic_lines_upload_spreadsheet_info_dialog").modal("show");
    });

    jQuery("[name='upload_transgenic_lines_dismiss_button']").click(function() {
        jQuery('#upload_transgenic_lines_dialog').modal('hide');
        jQuery('#transgenic_lines_upload_file').val('');
    });


});

</script>

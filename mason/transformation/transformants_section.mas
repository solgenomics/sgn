<%once>
use HTML::Entities ();
</%once>

<%args>
$transformation_id
$program_name
$can_obsolete
$vector_id
</%args>


<&| /page/info_section.mas, anchor_title => 'Transgenic Lines (Accessions) Derived from this Transformation ', title => HTML::Entities::encode_entities($c->i18n->p("transformation.transgenic_lines_accessions_derived_from_this_transformation", 'Transgenic Lines (Accessions) Derived from this Transformation ')), collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table class="table table-hover table-bordered" id="transformants_table">
                    </table>
                </div>
                <div class="panel panel-default">
                    <div class="panel-body">
                        <&| /page/info_section.mas, anchor_title => 'Add accessions to a List', title => HTML::Entities::encode_entities($c->i18n->p("transformation.add_accessions_to_a_list", 'Add accessions to a List')), collapsible=>1, collapsed=>1, subtitle=>("<i>" . HTML::Entities::encode_entities($c->i18n->p("transformation.adding_transgenic_lines_accessions_to_a_new_or_exisiting_list", "Adding transgenic lines (accessions) to a new or existing list")) . "</i>")&>
                            <br>
                            <div id="transformant_to_new_list" style="display:none"></div>
                            <div id="transformant_add_to_list"></div>
                        </&>
                    </div>
                </div>
% if($can_obsolete) {
                <button class="btn btn-sm btn-primary" style="margin:3px" id="obsolete_accessions_in_bulk_link"><% $c->i18n->p("transformation.obsolete_accessions_in_bulk", "Obsolete Accessions in Bulk") |h %></button>
% }
            </div>
        </div>
    </div>
</&>

<& /transformation/obsolete_stock_dialog.mas &>
<& /transformation/obsolete_accessions_dialog.mas, transformation_id => $transformation_id, program_name => $program_name, vector_id => $vector_id &>


<script>

jQuery(document).ready(function(){
    const transformation_stock_id = "<%$transformation_id%>";
    const can_obsolete = "<%$can_obsolete%>";
    const transformants_table = jQuery('#transformants_table').DataTable({
        'ajax': '/ajax/transformation/transformants/'+transformation_stock_id,
        'autoWidth': false,
        'order': false,
        'columns': [
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.index_logged_in_user.accession", "Accession") : "Accession")).html(), "data": null, "render": function ( data, type, row ) { return "<a href='/stock/"+row.transformant_id+"/view'>"+row.transformant_name+"</a>"; } },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.obsolete_accession", "Obsolete Accession") : "Obsolete Accession")).html(), "data": null, "render": function ( data, type, row ) {
                if (can_obsolete) {
                    if (row.is_a_parent){
                        return (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.used_as_a_parent_cannot_obsolete", "Used as a parent, cannot obsolete") : 'Used as a parent, cannot obsolete');
                    } else {
                        return "<a onclick='obsoleteStock("+row.transformant_id+",\""+row.transformant_name+"\")'>X</a>";
                    }
                } else {
                    return '';
                }
            }},
        ],

        "fnInitComplete": function(oSettings, json) {
            //console.log(json);
            if (!isLoggedIn()) {
                jQuery('#transformant_add_to_list').html(("<div class='well well-sm'><h3>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.related_stock.login_lists", "Please login to use lists!") : "Please login to use lists!")).html() + "</h3></div>"));
            } else {
                let html = "";
                for(let i=0; i<json.data.length; i++){
                    html += json.data[i].transformant_name+"\n";
                }

                jQuery("#transformant_to_new_list").html(html);
                addToListMenu("transformant_add_to_list", "transformant_to_new_list", {
                    selectText: true,
                    listType: 'accessions',
                });
            }
        }
    });

    jQuery('#obsolete_accessions_in_bulk_link').click(function() {
        jQuery("#obsolete_accessions_in_bulk_dialog").modal("show");
    });

});


</script>

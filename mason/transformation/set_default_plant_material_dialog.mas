<%args>
$project_id
$breeding_program_name
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<div class="modal fade" id="set_default_plant_material_dialog" tabindex="-1" role="dialog" aria-labelledby="setDefaultPlantMaterialDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header text-center">
                <button type="reset" class="close" id="set_default_plant_material_dismiss_button_1" name="set_default_plant_material_dismiss_button" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="setDefaultPlantMaterialDialog"><% $c->i18n->p("transformation.root.set_default_plant_material_for_transformation", "Set Default Plant Material for Transformation") |h %></h4>
            </div>
            <div class="modal-body" id="set_default_plant_material_body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data">
                        <div class="form-group">
                            <label class="col-sm-5 control-label" ><% $c->i18n->p("transformation.plant_material_accession_name", "Plant Material (accession name):") |h %> </label>
                            <div class="col-sm-7">
                                <input class="form-control" type="text" id="default_plant_material_input" name="default_plant_material_input"  />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="set_default_plant_material_dismiss_button_2" name="set_default_plant_material_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" id="set_default_plant_material_submit"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="default_plant_material_saved_dialog_message" name="default_plant_material_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="defaultPlantMaterialSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="defaultPlantMaterialSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("transformation.root.the_default_plant_material_was_set_successfully", "The default plant material was set successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_default_plant_material_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    jQuery('#set_plant_material_link').click(function() {
        jQuery("#set_default_plant_material_dialog").modal("show");
    });

    var transformation_project_id = "<%$project_id%>";
    var program_name = "<%$breeding_program_name%>";

    jQuery("#default_plant_material_input").autocomplete({
        source: '/ajax/stock/only_accession_autocomplete',
    });


    jQuery('#set_default_plant_material_submit').click(function() {

        var default_plant_material = jQuery("#default_plant_material_input").val();
        if (!default_plant_material) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.plant_material_is_required", "Plant material is required") : "Plant material is required"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/transformation/set_default_plant_material',
            dataType: "json",
            type: 'POST',
            data:{
                'default_plant_material': default_plant_material,
                'transformation_project_id': transformation_project_id,
                'program_name': program_name
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#set_default_plant_material_dialog').modal('hide');
                    jQuery('#default_plant_material_saved_dialog_message').modal("show");
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.an_error_occurred_saving_default_plant_material", "An error occurred saving default plant material") : 'An error occurred saving default plant material'));
            }
        });

    });

    jQuery("[name='set_default_plant_material_dismiss_button']").click(function() {
        jQuery('#set_default_plant_material_dialog').modal('hide');
        jQuery('#default_plant_material').val('');
    });

    jQuery("#dismiss_default_plant_material_saved_dialog").click(function(){
        jQuery('#default_plant_material_input').val('');
        location.reload();
    });

});


</script>

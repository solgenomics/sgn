<%args>
$trial_id
$breeding_program_name
$default_plant_material_id
$default_plant_material_name
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<div class="modal fade" id="add_transformation_identifier_dialog" tabindex="-1" role="dialog" aria-labelledby="addTransformationIdentifierDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header text-center">
                <button type="reset" class="close" id="add_transformation_id_dismiss_button_1" name="add_transformation_id_dismiss_button" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addTransformationIdentifierDialog"><% $c->i18n->p("transformation.add_new_transformation_id", "Add New Transformation ID") |h %></h4>
            </div>
            <div class="modal-body" id="add_new_transformation_identifier_body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" ><% $c->i18n->p("transformation.transformation_id.2d7a636", "Transformation ID:") |h %> </label>
                            <div class="col-sm-8">
                                <input class="form-control" type="text" id="new_transformation_identifier_name" name="new_transformation_identifier_name"  />
                            </div>
                        </div>
% if ($default_plant_material_name) {
                        <div class="form-group">
                            <label class="col-sm-4 control-label" ><% $c->i18n->p("transformation.plant_material_accession_name", "Plant Material (accession name):") |h %> </label>
                            <div class="col-sm-8">
                                <input class="form-control" name="plant_material" id="plant_material" disabled value="<% $default_plant_material_name %>">
                            </div>
                        </div>
% } else {
                        <div class="form-group">
                            <label class="col-sm-4 control-label" ><% $c->i18n->p("transformation.plant_material_accession_name", "Plant Material (accession name):") |h %> </label>
                                <div class="col-sm-8">
                                    <input class="form-control" type="text" id="plant_material" name="plant_material"  />
                                </div>
                        </div>
% }
                        <div class="form-group">
                            <label class="col-sm-4 control-label" ><% $c->i18n->p("transformation.vector_construct.dc7aa9e", "Vector Construct:") |h %> </label>
                                <div class="col-sm-8">
                                    <input class="form-control" type="text" id="vector_construct" name="vector_construct"  />
                                </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("transformation.is_a_control", "Is a Control:") |h %> </label>
                            <div class="col-sm-8">
                                <input type="checkbox" id="is_a_transformation_control_checkbox" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label" ><% $c->i18n->p("seedlots.ui.notes", "Notes:") |h %> </label>
                                <div class="col-sm-8">
                                    <div class="input-group">
                                        <textarea class="form-control" id="transformation_notes" ></textarea>
                                    </div>
                                </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_transformation_id_dismiss_button_2" name="add_transformation_id_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" id="new_transformation_identifier_submit"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="transformation_id_saved_dialog_message" name="transformation_id_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="transformationIDSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="transformationIDSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("transformation.the_transformation_id_was_saved_successfully", "The transformation ID was saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_transformation_id_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    var transformation_project_id = "<%$trial_id%>";
    var program_name = "<%$breeding_program_name%>";
    var default_plant_material_name = "<%$default_plant_material_name%>";

    jQuery("#plant_material").autocomplete({
        source: '/ajax/stock/only_accession_autocomplete',
    });

    jQuery("#vector_construct").autocomplete({
        source: '/ajax/stock/vector_construct_autocomplete',
    });

    jQuery('#new_transformation_identifier_submit').click(function() {
        var transformation_identifier = jQuery("#new_transformation_identifier_name").val();
        if (!transformation_identifier) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.transformation_id_is_required", "Transformation ID is required") : "Transformation ID is required"));
            return;
        }

        var plant_material = jQuery("#plant_material").val();
        if (!plant_material) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.plant_material_is_required", "Plant material is required") : "Plant material is required"));
            return;
        }

        var vector_construct = jQuery("#vector_construct").val();
        if (!vector_construct) {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.vector_construct_is_required", "Vector construct is required") : "Vector construct is required"));
            return;
        }

        let is_a_control;
        if(jQuery('#is_a_transformation_control_checkbox').is(":checked")){
            is_a_control = 1;
        }

        var notes = jQuery("#transformation_notes").val();

        jQuery.ajax({
            url: '/ajax/transformation/add_transformation_identifier',
            dataType: "json",
            type: 'POST',
            data:{
                'transformation_identifier': transformation_identifier,
                'plant_material': plant_material,
                'vector_construct': vector_construct,
                'notes': notes,
                'transformation_project_id': transformation_project_id,
                'program_name': program_name,
                'is_a_control': is_a_control
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#add_transformation_identifier_dialog').modal('hide');
                    jQuery('#transformation_id_saved_dialog_message').modal("show");

                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.an_error_occurred_creating_transformation_id", "An error occurred creating transformation ID") : 'An error occurred creating transformation ID'));
            }
        });

    });

    jQuery("[name='add_transformation_id_dismiss_button']").click(function() {
        jQuery('#add_transformation_identifier_dialog').modal('hide');
        jQuery('#new_transformation_identifier_name').val('');

        if (!default_plant_material_name) {
            jQuery('#plant_material').val('');
        }

        jQuery('#vector_construct').val('');
        jQuery('#transformation_notes').val('');
        jQuery('#is_a_transformation_control_checkbox').prop('checked', false);
    });

    jQuery("#dismiss_transformation_id_saved_dialog").click(function(){
        jQuery('#new_transformation_identifier_name').val('');

        if (!default_plant_material_name) {
            jQuery('#plant_material').val('');
        }

        jQuery('#vector_construct').val('');
        jQuery('#transformation_notes').val('');
        jQuery('#is_a_transformation_control_checkbox').prop('checked', false);

        location.reload();
    });

});


</script>

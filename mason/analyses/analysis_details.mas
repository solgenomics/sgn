<%once>
use HTML::Entities ();
</%once>

<%args>
$trial_id
$trial_name
$trial_description
$breeding_program_name
$breeding_program_id
$year
$identifier_prefix
$trial_stock_type
$analysis_metadata
</%args>

<div class="row">
    <div class="col-sm-8">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b><% $c->i18n->p("analysis.interface.analysis_name", "Analysis Name") |h %></b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("trial.summary.empty.name", "[No Trial Name]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("global.index_logged_in_user.breeding_program", "Breeding Program") |h %> </b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
                    <a href="/breeders/program/<% $breeding_program_id %>"><% $breeding_program_name %></a>
% }
% else {
%  print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_breeding_program", "[No Breeding Program]")) . "</span>");
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("global.trial_table.year", "Year") |h %></b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print "$year";
% } else {
%  print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_year", "[No Year]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></b></td>
                <td>
                    <div id="trial_description">
% if ($trial_description) {
%  print "$trial_description";
% } else {
%  print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_description", "[No Description]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("global.search_wizard.protocol", "Protocol") |h %></b></td>
                <td>
                    <div id="analysis_protocol">
%  print $analysis_metadata->analysis_protocol;
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("lists_datasets.shared.dataset", "Dataset") |h %></b></td>
                <td>
                    <div id="analysis_dataset_id">
%  print "<a href=/dataset/".$analysis_metadata->dataset_id.">".$analysis_metadata->dataset_id."</a>";
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("analysis.interface.created", "Created") |h %></b></td>
                <td>
                    <div id="analysis_create_timestamp">
%  print $analysis_metadata->create_timestamp;
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("analysis.interface.result_summary", "Result Summary") |h %></b></td>
                <td>
                    <div id="analysis_result_summary">
%  if ($analysis_metadata->result_summary) {
%    while (my($k,$v) = each %{$analysis_metadata->result_summary}) {
%       print $k." : ".$v."<br/>";
%    }
%  }
                    </div>
                </td>
            </tr>

        </table>

    </div>
    <div class="col-sm-4">
        <div class="well well-sm">
            <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
        </div>
    </div>
</div>
<%once>
use HTML::Entities ();
</%once>


<%args>
</%args>

<%doc>

=head1 NAME

/mason/analyses/index.mas - show user-specific analyses in the system

=head1 DESCRIPTION

Displays a page with a table of all the analyses run by the currently logged in user.

=head1 AUTHOR

Lukas Mueller <lam87@cornell.edu>

=cut

</%doc>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ], entries => ['analyses' ] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("analysis.interface.your_analyses_and_analysis_models", "Your Analyses and Analysis Models")) &>

<button class='btn btn-primary' style='margin:3px;float:right' id='drone_imagery_calculate_statistics_link'><% $c->i18n->p("analysis.interface.drone_imagery_statistics", "Drone Imagery Statistics") |h %></button><button class='btn btn-primary' style='margin:3px;float:right' id='analysis_calculate_statistics_link'><% $c->i18n->p("analysis.interface.single_multi_trial_gebv_analysis", "Single/Multi Trial GEBV Analysis") |h %></button><button class="btn btn-default" name="upload_new_analysis_button" style="margin:3px;float:right"><% $c->i18n->p("analysis.interface.upload_analysis", "Upload Analysis") |h %></button><br />
<hr>

<& /analyses/analysis_calculate_statistics.mas &>
<& /analyses/upload_analysis_dialogs.mas &>
<& /breeders_toolbox/drone_imagery/drone_imagery_analysis.mas &>
<& /analyses/store_new_analysis_values_and_model.mas &>

<div class="well">
<h3><% $c->i18n->p("analysis.interface.your_analyses", "Your Analyses") |h %></h3>
<table class="table table-bordered table-hover" id="analyses_by_user_table">
  <thead>
  <tr>
    <th>
      <% $c->i18n->p("analysis.interface.analysis_name", "Analysis Name") |h %>
    </th>
    <th>
      <% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %>
    </th>
    <th>
      <% $c->i18n->p("analysis.interface.model_type", "Model Type") |h %>
    </th>
    <th>
      <% $c->i18n->p("global.search_wizard.protocol", "Protocol") |h %>
    </th>
    <th>
      <% $c->i18n->p("analysis.interface.application", "Application") |h %>
    </th>
    <th>
      <% $c->i18n->p("language.select", "Language") |h %>
    </th>
  </tr>
  </thead>
  <tbody>
  </tbody>
</table>
</div>

<div class="well">
<h3><% $c->i18n->p("analysis.interface.your_models", "Your Models") |h %></h3>
<table class="table table-bordered table-hover" id="models_by_user_table">
  <thead>
  <tr>
    <th>
      <% $c->i18n->p("analysis.interface.model_name", "Model Name") |h %>
    </th>
    <th>
      <% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %>
    </th>
    <th>
      <% $c->i18n->p("analysis.interface.model_type", "Model Type") |h %>
    </th>
    <th>
      <% $c->i18n->p("global.search_wizard.protocol", "Protocol") |h %>
    </th>
    <th>
      <% $c->i18n->p("analysis.interface.application", "Application") |h %>
    </th>
    <th>
      <% $c->i18n->p("language.select", "Language") |h %>
    </th>
  </tr>
  </thead>
  <tbody>
  </tbody>
</table>
</div>

<script>
jQuery(document).ready(function(){
    jQuery('#analyses_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/by_user' }
    });

    jQuery('#models_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/models/by_user' }
    });
});
</script>
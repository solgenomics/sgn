<%args>
$model_id
</%args>

<table class="table table-hover table-bordered" id="analyses_by_model_table">
    <thead>
        <tr>
            <th><% $c->i18n->p("analysis.interface.analysis_name", "Analysis Name") |h %></th>
            <th><% $c->i18n->p("analysis.interface.analysis_description", "Analysis Description") |h %></th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>

<script>
jQuery(document).ready(function(){

    jQuery('#analyses_by_model_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/by_model?model_id=<% $model_id %>' }
    });

});
</script>


<& /util/import_javascript.mas, classes => [ "calendar.moment_min", "calendar.fullcalendar_min", "jquery.dataTables", "calendar.fullcalendar_gcal_min", "calendar.bootstrap_datepicker_min" ] &>

<& /util/import_css.mas, paths => ['/css/datepicker.css'] &>

<style>
.fc-center h2 {
    font-size:1.4em;
 }

.fc-day-header {
    font-size: 0.9em;
}
.datepicker{z-index:1151 !important;}
</style>

<div class="modal fade" id="calendar_modal" name="calendar_modal"  tabindex="-1" role="dialog" aria-labelledby="calendarDialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("community.calendar.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="calendarDialog"><% $c->i18n->p("community.calendar.your_calendar", "Your Calendar") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <div id='calendar' style="background:#f9f9f9; padding:2px; width:100%">
            </div>
            <br/><br/>

            <div class="well well-sm">
                <center>
                    <p><b><% $c->i18n->p("community.calendar.having_trouble_viewing_events_on_the_calendar", "Having trouble viewing events on the calendar?") |h %></b> <br/><% $c->i18n->p("community.calendar.are_you_associated_with_the_breeding_program_you_are_interested_in_viewing", "Are you associated with the breeding program you are interested in viewing?") |h %></p>
                    <a class="btn btn-primary" id="calendar_bp_user_roles_show" href="/breeders/manage_roles/"><% $c->i18n->p("community.calendar.calendar_permissions", "Calendar Permissions") |h %></a>
                </center>
            </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("community.calendar.close", "Close") |h %></button>
      </div>
    </div>
  </div>
</div>



<div class="modal fade" id="day_dialog" name="day_dialog"  tabindex="-1" role="dialog" aria-labelledby="addEventDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("community.calendar.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addEventDialog"><% $c->i18n->p("community.calendar.add_new_event", "Add New Event") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
  	  <form class="form-horizontal" role="form" name="day_dialog_add_event_form" id="day_dialog_add_event_form">
    	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.project", "Project:") |h %> </label>
      	      <div class="col-sm-10">
		<select class="form-control" name="event_project_select" id="event_project_select"></select>
              </div>
	    </div>
	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.event_type", "Event Type:") |h %> </label>
      	      <div class="col-sm-10">
	        <select class="form-control" name="event_type_select" id="event_type_select" ></select>
              </div>
	    </div>
	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.start", "Start:") |h %> </label>
      	      <div class="col-sm-10">
	        <div class="input-group date">
    		  <input type="text" class="form-control datepicker" name="event_start" id="event_start">
    		  <div class="input-group-addon">
        	    <span class="glyphicon glyphicon-th"></span>
    		  </div>
		</div>
              </div>
	    </div>
	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.end", "End:") |h %> </label>
      	      <div class="col-sm-10">
	        <div class="input-group date">
                  <input type="text" class="form-control datepicker" name="event_end" id="event_end" placeholder="<% $c->i18n->p("community.calendar.leave_blank_if_not_applicable", "Leave Blank if Not Applicable") |h %>">
    		  <div class="input-group-addon">
        	    <span class="glyphicon glyphicon-th"></span>
    		  </div>
		</div>
              </div>
	    </div>
	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.description", "Description:") |h %> </label>
      	      <div class="col-sm-10">
		<input class="form-control" name="event_description" id="event_description" type="text" >
              </div>
	    </div>
	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.web_url", "Web URL:") |h %> </label>
      	      <div class="col-sm-10">
	        <div class="input-group">
		  <span class="input-group-addon" id="basic-addon2">http://www.</span>
  		  <input type="text" name="event_url" id="event_url" class="form-control" placeholder="example.com" aria-describedby="basic-addon2" />
  		</div>
              </div>
	    </div>
          </form>      
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("community.calendar.close", "Close") |h %></button>
        <button type="button" class="btn btn-primary" name="add_event_submit" id="add_event_submit"><% $c->i18n->p("community.calendar.add_event", "Add Event") |h %></button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="event_dialog" name="event_dialog"  tabindex="-1" role="dialog" aria-labelledby="eventDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("community.calendar.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="eventDialog"><% $c->i18n->p("community.calendar.event_info", "Event Info") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
	  <table class="table table-hover">
	    <thead>
	      <tr>
	        <th><% $c->i18n->p("community.calendar.attribute", "Attribute") |h %></th>
	        <th><% $c->i18n->p("community.calendar.value", "Value") |h %></th>
	      </tr>
	    </thead>
	    <tbody>
    	      <tr>
                <td><% $c->i18n->p("community.calendar.project_name", "Project Name:") |h %> </td>
      	        <td id="event_info_title"></td>
    	      <tr>
    	      <tr>
                <td><% $c->i18n->p("community.calendar.start_date", "Start Date:") |h %> </td>
      	        <td id="event_info_start_display"></td>
		<input id="event_info_start" type="hidden" />
    	      </tr>
    	      <tr>
                <td><% $c->i18n->p("community.calendar.end_date", "End Date:") |h %> </td>
      	        <td id="event_info_end_display"></td>
		<input id="event_info_end" type="hidden" />
    	      </tr>
    	      <tr>
                <td><% $c->i18n->p("community.calendar.event_type", "Event Type:") |h %> </td>
      	        <td id="event_info_property"></td>
		<input id="event_info_cvterm_id" type="hidden" />
    	      </tr>
    	      <tr>
                <td><% $c->i18n->p("community.calendar.event_description", "Event Description:") |h %> </td>
      	        <td id="event_info_description"></td>
    	      </tr>
    	      <tr>
                <td><% $c->i18n->p("community.calendar.event_web_url", "Event Web URL:") |h %> </td>
      	        <td id="event_info_url"></td>
		<input id="event_info_url_raw" type="hidden" />
    	      </tr>
	    </tbody>
  	  </table>
        </div>
      </div>
      <div class="modal-footer">
        <form name="event_dialog_more_info_form" id="event_dialog_more_info_form">
          <input type="hidden" name="event_project_id" id="event_project_id" />
	  <input type="hidden" name="event_project_title" id="event_project_title" />
        </form>
	<form name="event_dialog_delete_event_form" id="event_dialog_delete_event_form">
          <input type="hidden" name="event_projectprop_id" id="event_projectprop_id" />
        </form>
	<button type="button" class="btn btn-primary" name="event_edit_display" id="event_edit_display"><% $c->i18n->p("community.calendar.edit_event", "Edit Event") |h %></button>
	<button type="button" class="btn btn-danger" name="delete_event_submit" id="delete_event_submit"><% $c->i18n->p("community.calendar.delete_event", "Delete Event") |h %></button>
	<button type="button" class="btn btn-info" name="export_event_display" id="export_event_display"><% $c->i18n->p("community.calendar.export_event", "Export Event") |h %></button>
	<button type="button" class="btn btn-default" data-dismiss="modal" id="event_dialog_dismiss"><% $c->i18n->p("community.calendar.close", "Close") |h %></button>
      </div>
    </div>
  </div>
</div>


<div class="modal fade" id="edit_event_dialog" name="edit_event_dialog" tabindex="-1" role="dialog" aria-labelledby="editEventDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("community.calendar.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="editEventDialog"><% $c->i18n->p("community.calendar.edit_event", "Edit Event") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
  	  <form class="form-horizontal" role="form" name="edit_event_form" id="edit_event_form">
    	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.project", "Project:") |h %> </label>
      	      <div class="col-sm-10">
		<select class="form-control" name="edit_event_project_select" id="edit_event_project_select"></select>
              </div>
	    </div>
	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.event_type", "Event Type:") |h %> </label>
      	      <div class="col-sm-10">
		<select class="form-control" name="edit_event_type_select" id="edit_event_type_select" ></select>
              </div>
	    </div>
	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.start", "Start:") |h %> </label>
      	      <div class="col-sm-10">
	        <div class="input-group date">
    		  <input type="text" class="form-control datepicker" name="edit_event_start" id="edit_event_start">
    		  <div class="input-group-addon">
        	    <span class="glyphicon glyphicon-th"></span>
    		  </div>
		</div>
              </div>
	    </div>
	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.end", "End:") |h %> </label>
      	      <div class="col-sm-10">
	        <div class="input-group date">
                  <input type="text" class="form-control datepicker" name="edit_event_end" id="edit_event_end" placeholder="<% $c->i18n->p("community.calendar.leave_blank_if_not_applicable", "Leave Blank if Not Applicable") |h %>">
    		  <div class="input-group-addon">
        	    <span class="glyphicon glyphicon-th"></span>
    		  </div>
		</div>
              </div>
	    </div>
	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.description", "Description:") |h %> </label>
      	      <div class="col-sm-10">
		<input class="form-control" name="edit_event_description" id="edit_event_description" type="text" >
              </div>
	    </div>
	    <div class="form-group">
              <label class="col-sm-2 control-label"><% $c->i18n->p("community.calendar.web_url", "Web URL:") |h %> </label>
      	      <div class="col-sm-10">
		<input type="hidden" id="edit_event_projectprop_id" name="edit_event_projectprop_id" />
  		<input type="text" name="edit_event_url" id="edit_event_url" class="form-control" placeholder="example.com">
              </div>
	    </div>
          </form>      
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("community.calendar.close", "Close") |h %></button>
        <button type="button" class="btn btn-primary" name="edit_event_submit" id="edit_event_submit"><% $c->i18n->p("community.calendar.save", "Save") |h %></button>
      </div>
    </div>
  </div>
</div>



<script>

function calendarDisplayOptions() {
    if (!window.SGN || !SGN.i18n || SGN.i18n.locale === "en") return {};
    return {
monthNames: [(window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.january", "January") : "January"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.february", "February") : "February"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.march", "March") : "March"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.april", "April") : "April"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.may", "May") : "May"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.june", "June") : "June"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.july", "July") : "July"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.august", "August") : "August"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.september", "September") : "September"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.october", "October") : "October"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.november", "November") : "November"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.december", "December") : "December")],
        monthNamesShort: [(window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.jan", "Jan") : "Jan"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.feb", "Feb") : "Feb"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.mar", "Mar") : "Mar"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.apr", "Apr") : "Apr"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.may", "May") : "May"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.jun", "Jun") : "Jun"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.jul", "Jul") : "Jul"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.aug", "Aug") : "Aug"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.sep", "Sep") : "Sep"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.oct", "Oct") : "Oct"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.nov", "Nov") : "Nov"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.dec", "Dec") : "Dec")],
        dayNames: [(window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.sunday", "Sunday") : "Sunday"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.monday", "Monday") : "Monday"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.tuesday", "Tuesday") : "Tuesday"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.wednesday", "Wednesday") : "Wednesday"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.thursday", "Thursday") : "Thursday"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.friday", "Friday") : "Friday"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.saturday", "Saturday") : "Saturday")],
        dayNamesShort: [(window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.sun", "Sun") : "Sun"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.mon", "Mon") : "Mon"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.tue", "Tue") : "Tue"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.wed", "Wed") : "Wed"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.thu", "Thu") : "Thu"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.fri", "Fri") : "Fri"), (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.sat", "Sat") : "Sat")],
        buttonText: {today: (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.today", "today") : "today"), month: (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.month", "month") : "month"), week: (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.week", "week") : "week"), day: (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.day", "day") : "day"), prev: (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.prev", "prev") : "prev"), next: (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.next", "next") : "next"), prevYear: (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.prev_year", "prev year") : "prev year"), nextYear: (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.next_year", "next year") : "next year"), year: (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.year", "year") : "year")},
        allDayText: (window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.all_day", "all-day") : "all-day"),
        isRTL: SGN.i18n.dir === "rtl"
    };
}


jQuery(document).ready(function() {

    jQuery(document).on('click', "button[name='personal_calendar_link']", function() {
        jQuery("#calendar_modal").modal("show");
    });

    //If a date is given in the url, using the query parameter currentDate=<timestamp>
    var captured = /currentDate=([^&]+)/.exec(window.location.href);
    var result = captured ? captured[1] : Date.now();
    var valid = (new Date(result)).getTime() > 0;
    if (valid && captured) {
      jQuery('#calendar').fullCalendar('gotoDate', result);
      jQuery("#calendar_modal").modal("show");
    }

    jQuery('#calendar_modal').on('shown.bs.modal', function () {
        jQuery("#calendar").fullCalendar('render');
    });

    jQuery('.datepicker').datepicker({
        format: 'yyyy-mm-dd',
    });

    var fcSources = {
        //month_view: {
        //    url: '/ajax/calendar/populate/personal/month',
        //    error: function() {window.location.replace('/solpeople/login.pl');},
        //    className: 'bg-info',
        //    textColor: '#000',
        //    borderColor: '#FFF',
        //},
        agendaWeek_view: {
            url: '/ajax/calendar/populate/personal/agendaWeek',
            error: function() {window.location.replace('/user/login');},
            className: 'bg-info',
            textColor: '#000',
            borderColor: '#FFF',
        },
        //gcal_cassbase: {
        //    googleCalendarId: 'mtm2tg9p10nvqttdjas4v0n0sg@group.calendar.google.com',
        //    className: 'bg-success',
        //    textColor: '#000',
        //    borderColor: '#FFF',
        //},
        //gcal_holidays: {
        //    googleCalendarId: 'en.usa#holiday@group.v.calendar.google.com',
        //    className: 'bg-danger',
        //    textColor: '#000',
        //    borderColor: '#FFF',
        //}
    };

    var lastView;
    jQuery('#calendar').fullCalendar(jQuery.extend({}, calendarDisplayOptions(), {        editable: true,
        eventLimit: true,
        lazyFetching: false,
        header: {
            left:   'title',
            center: 'month,agendaWeek',
            right:  'prevYear,prev,today,next,nextYear'
        },
        views: {
            month: {
                titleFormat: 'MMM YYYY'
            },
            agendaWeek: {
                titleFormat: 'MMM D YYYY'
            }
        },
        eventSources: [fcSources.month_view, fcSources.agendaWeek_view, fcSources.gcal_cassbase, fcSources.gcal_holidays],
        defaultView: 'month',
        googleCalendarApiKey: 'AIzaSyDHH6NGHEYJcYRcxr5mHBWKcqNlKyu-L-Q',
        eventRender: function(event, element, view) {
            if (!event.url) {
                element.find('.fc-title').html(event.title + ": " + event.property ); 
            }
        },
        dayClick: function(date, jsEvent, view) {
            jQuery.ajax({
                url: "/ajax/calendar/dayclick/personal",
                type: "GET",
                dataType: "json",
                success: function(data) {
                    jQuery("input#event_start").val(date.format());
                    var options = jQuery("#event_project_select");
                    options.empty();
                    jQuery.each(data.project_list, function () {
                        options.append(jQuery("<option />").val(this.project_id).text(this.project_name));
                    });
                    var options = jQuery("#event_type_select");
                    options.empty();
                    jQuery.each(data.projectprop_list, function () {
                        options.append(jQuery("<option />").val(this.cvterm_id).text(this.cvterm_name));
                    });
                    return;
                },
                error: function() {
                    alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.error_preparing_day_dialog", "Error preparing Day dialog!") : "Error preparing Day dialog!"));
                }
            });
            jQuery('#day_dialog').modal('show');
            // jQuery(this).css('background-color', '#A9F5F2');
        },
        eventClick: function(event) {
            if (event.url) {
                window.open(event.url);
                return false;
            } else {
                jQuery("#event_info_title").html("<a href='" + event.project_url + "'>" + event.title + "</a>");
                jQuery("#event_info_start_display").html(event.start_display);
                jQuery("#event_info_end_display").html(event.end_display);
                jQuery("input#event_info_start").val(event.start_drag);
                jQuery("input#event_info_end").val(event.end_drag);
                jQuery("input#event_info_cvterm_id").val(event.cvterm_id);
                jQuery("#event_info_property").html("<a href='" + event.cvterm_url + "'>" + event.property + "</a>");
                jQuery("#event_info_description").html(event.event_description);
                jQuery("input#event_info_url_raw").val(event.event_url);
                jQuery("#event_info_url").html("<a href='" + event.event_url + "'>" + event.event_url + "</a>");
                jQuery("input#event_project_title").val(event.title);
                jQuery("input#event_project_id").val(event.project_id);
                jQuery("input#event_projectprop_id").val(event.projectprop_id);
                jQuery('#event_dialog').modal('show');
                return false;
            }
        },
        eventMouseover: function(event, jsEvent) {
            if (event.url) {
                jQuery(this).popover({html:true, title:event.title, placement:'right', container:'body', content: jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.location", "Location: ") : "Location: ")).html() + event.location + '<br/>' + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.description_ebc5574", "Description: ") : "Description: ")).html() + event.description,}).popover('show');
                return false;
            } else {
                jQuery(this).popover({html:true, title:event.title, placement:'right', container:'body', content: jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.start_00308aa", "Start: ") : "Start: ")).html() + event.start_display + '<br/>' + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.end_fb3ce79", "End: ") : "End: ")).html() + event.end_display + '<br/>' + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.type", "Type: ") : "Type: ")).html() + event.property + '<br/>' + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.description_ebc5574", "Description: ") : "Description: ")).html() + event.event_description + '<br/>' + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.url", "URL: ") : "URL: ")).html() + event.event_url,}).popover('show');
                return false;
              }
        },
        eventMouseout: function(event) {
            jQuery(this).popover("hide");
            return false;
        },
        eventDrop: function(event, delta, revertFunc, jsEvent, ui, view) {
            if (!confirm((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.are_you_sure_about_this_change", "Are you sure about this change?") : "Are you sure about this change?"))) {
                revertFunc();
                return;
            }
            jQuery.ajax({
                url: "/ajax/calendar/drag_or_resize",
                type: "POST",
                dataType: "json",
                data: ({
                    id: event.id,
                    start_drag: event.start_drag,
                    end_drag: event.end_drag,
                    description: event.event_description,
                    url: event.event_url,
                    projectprop_id: event.projectprop_id,
                    delta: delta.asSeconds(),
                    view: view.name,
                    allday: +event.allDay,
                    drag: 1,
                }),
                success: function(data) {
                    if (data.status ==3) {
                        alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.you_do_not_have_the_permissions_to_edit_this_event", "You do not have the permissions to edit this event.") : "You do not have the permissions to edit this event."));
                    } else if (data.error ==1) {
                        alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.the_was_a_problem_editing_this_event", "The was a problem editing this event.") : "The was a problem editing this event."));
                    } else if (data.success == 1) {
                        event.start = data.start;
                        event.start_drag = data.start_drag;
                        event.start_display = data.start_display;
                        event.end = data.end;
                        event.end_drag = data.end_drag;
                        event.end_display = data.end_display;
                    }
                    jQuery('#calendar').fullCalendar('updateEvent', event);
                    return;
                },
                error: function() {
                    revertFunc();
                    alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.error_did_not_update_event_e_001", "Error! Did Not Update Event! E.001") : "Error! Did Not Update Event! E.001"));
                }
            });
        },
        eventResize: function(event, delta, revertFunc, jsEvent, ui, view) {
            if (!confirm((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.are_you_sure_about_this_change", "Are you sure about this change?") : "Are you sure about this change?"))) {
                revertFunc();
                return;
            }
            jQuery.ajax({
                url: "/ajax/calendar/drag_or_resize",
                type: "POST",
                dataType: "json",
                data: ({
                    id: event.id,
                    start_drag: event.start_drag,
                    end_drag: event.end_drag,
                    description: event.event_description,
                    url: event.event_url,
                    projectprop_id: event.projectprop_id,
                    delta: delta.asSeconds(),
                    view: view.name,
                    allday: +event.allDay,
                    drag: 0,
                }),
                success: function(data) {
                    if (data.status ==3) {
                        alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.you_do_not_have_the_permissions_to_edit_this_event", "You do not have the permissions to edit this event.") : "You do not have the permissions to edit this event."));
                    } else if (data.error ==1) {
                        alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.the_was_a_problem_editing_this_event", "The was a problem editing this event.") : "The was a problem editing this event."));
                    } else if (data.success == 1) {
                        event.start = data.start;
                        event.start_drag = data.start_drag;
                        event.start_display = data.start_display;
                        event.end = data.end;
                        event.end_drag = data.end_drag;
                        event.end_display = data.end_display;
                    }
                    jQuery('#calendar').fullCalendar('updateEvent', event);
                    return;
                },
                error: function() {
                    revertFunc();
                    alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.error_did_not_update_event_e_001", "Error! Did Not Update Event! E.001") : "Error! Did Not Update Event! E.001"));
                }
            });
        },
    }));

    jQuery('button#add_event_submit').click( function(event) {
        event.preventDefault();
        jQuery.ajax({
            url: "/ajax/calendar/add_event",
            type: "POST",
            dataType: "json",
            data: jQuery('form#day_dialog_add_event_form').serialize(),
            success: function(data) {
                if(data.status == 1){
                    alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.event_successfully_added", "Event Successfully Added!") : "Event Successfully Added!"));
                    jQuery('#day_dialog').modal('hide');
                    jQuery('#calendar').fullCalendar('refetchEvents');
                }else if(data.status == 2){
                    alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.error_event_not_added_e_002", "Error! Event Not Added! E.002") : "Error! Event Not Added! E.002"));
                }else if(data.status == 3){
                    alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.you_do_not_have_the_permissions_to_add_an_event", "You do not have the permissions to add an event.") : "You do not have the permissions to add an event."));
                }
            },
            error: function() {
                alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.error_event_not_added_e_001", "Error! Event Not Added! E.001") : "Error! Event Not Added! E.001"));
            }
        });
    });

    jQuery('button#delete_event_submit').click( function(event) {
        event.preventDefault();
        jQuery('button#export_event_display').popover('hide');
        if (!confirm((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.are_you_sure_you_want_to_delete_this_event", "Are you sure you want to delete this event?") : "Are you sure you want to delete this event?"))) {
            return;
        }
        jQuery.ajax({
            url: "/ajax/calendar/delete_event",
            type: "POST",
            dataType: "json",
            data: jQuery('form#event_dialog_delete_event_form').serialize(),
            success: function(data) {
                jQuery('#event_dialog').modal('hide');
                jQuery('#calendar').fullCalendar( 'refetchEvents' );
                if (data.status==3){
                    alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.you_do_not_have_the_permissions_to_delete_an_event", "You do not have the permissions to delete an event.") : "You do not have the permissions to delete an event."));
                } else if (data.status==0){
                    alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.the_event_was_not_deleted", "The event was not deleted!") : "The event was not deleted!"));
                }
            },
            error: function() {
                alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.did_not_delete_event_e_001", "Did Not Delete Event! E.001") : "Did Not Delete Event! E.001"));
            }
        });
    });
    
    jQuery('button#event_edit_display').click( function(event) {
        event.preventDefault();
        jQuery.ajax({
            url: "/ajax/calendar/dayclick/personal",
            type: "GET",
            dataType: "json",
            success: function(data) {
                var options = jQuery("#edit_event_project_select");
                options.empty();
         	      jQuery.each(data.project_list, function () {
                    options.append(jQuery("<option />").val(this.project_id).text(this.project_name));
         	      });
                options.val(jQuery("input#event_project_id").val());
                var options = jQuery("#edit_event_type_select");
                options.empty();
         	      jQuery.each(data.projectprop_list, function () {
                    options.append(jQuery("<option />").val(this.cvterm_id).text(this.cvterm_name));
         	      });
                options.val(jQuery("input#event_info_cvterm_id").val());
                return;
            },
            error: function() {
                alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.error_preparing_edit_event_dialog", "Error Preparing Edit Event Dialog!") : "Error Preparing Edit Event Dialog!"));
            }
        });

      	jQuery("#edit_event_projectprop_id").val(jQuery("#event_projectprop_id").val());
      	jQuery("#edit_event_start").val(jQuery("#event_info_start").val());
      	jQuery("#edit_event_end").val(jQuery("#event_info_end").val());
      	jQuery("#edit_event_description").val(jQuery("#event_info_description").html());
      	jQuery("#edit_event_url").val(jQuery("#event_info_url_raw").val());
      	jQuery("#edit_event_dialog").modal("show");
    });

    jQuery('button#edit_event_submit').click( function(event) {
        event.preventDefault();
        if (!confirm((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.are_you_sure_you_want_to_save_this_edit", "Are you sure you want to save this edit?") : "Are you sure you want to save this edit?"))) {
            return;
        }
        jQuery.ajax({
            url: "/ajax/calendar/edit_event",
            type: "POST",
            dataType: "json",
            data: jQuery('form#edit_event_form').serialize(),
            success: function(data) {
                if (data.status == 1) {
                    jQuery('#event_dialog').modal('hide');
                    jQuery('#edit_event_dialog').modal('hide');
                    jQuery('#calendar').fullCalendar( 'refetchEvents' );
                } else if (data.status == 0) {
                    alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.event_already_existed_your_edit_was_not_saved", "Event Already Existed! Your Edit Was Not Saved!") : "Event Already Existed! Your Edit Was Not Saved!"));
                } else if (data.status == 3) {
                    alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.you_do_not_have_the_permissions_to_edit_thie_event", "You do not have the permissions to edit thie event.") : "You do not have the permissions to edit thie event."));
                }
            },
            error: function() {
                alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.did_not_save_edit_e_001", "Did Not Save Edit! E.001") : "Did Not Save Edit! E.001"));
            }
        });
    });

    jQuery('button#export_event_display').click( function() {
        jQuery(this).popover({html:true, title:(window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.export_event", "Export Event") : "Export Event"), placement:'right', container:'body', content: "Google Calendar: <a href='http://www.google.com/calendar' target='_blank' >" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.calendar.export", "Export") : "Export")).html() + "</a>"}).popover('toggle');
    });

    jQuery('#event_dialog').on('hide.bs.modal', function (e) {
       jQuery('button#export_event_display').popover('hide');
    });

});



</script>

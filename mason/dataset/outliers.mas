<%args>
$dataset_id
$dataset_name
</%args>

<& /util/import_javascript.mas, entries => [qw|dataset_scatterplot dataset|], classes => [ qw|jqueryui.js jquery.js dataset jstree.dist.jstree thickbox jquery.dataTables| ] &>


<div class="row">
    <div id="trait_selections" style="margin: 15px">
        <label for="trait_selection"><% $c->i18n->p("lists_datasets.pages.select_a_trait", "Select a Trait: ") |h %></label>
        <select id="trait_selection" class="form-control" name="trait_selection">
            <option value="default"><% $c->i18n->p("lists_datasets.pages.select_trait", "Select Trait") |h %></option>
        </select>
    </div>

    <div class="hide_until_trait_selected" style="margin: 15px; display: none; gap: 15px; flex-wrap: wrap">
        <div style="min-width: 300px; flex-grow: 1">
            <div id="outliers_range">
                <div id="custom-handle" class="ui-slider-handle"></div>
            </div>
        </div>

        <div class="input-group">
            <span class="input-group-addon">
                <input type="radio" aria-label="<% $c->i18n->p("lists_datasets.pages.median_accessibility", "median") |h %>" id="median" value="median" name="dataset_metric" checked="true">
            </span>
            <label for="median" class="form-control" aria-label="<% $c->i18n->p("lists_datasets.pages.median_accessibility", "median") |h %>"><% $c->i18n->p("lists_datasets.pages.median", "Median") |h %></label>
            <span class="input-group-addon">
                <input type="radio" aria-label="<% $c->i18n->p("lists_datasets.pages.mean_accessibility", "mean") |h %>" id="mean" value="mean" name="dataset_metric" >
            </span>
            <label for="mean" class="form-control" aria-label="<% $c->i18n->p("lists_datasets.pages.mean_accessibility", "mean") |h %>"><% $c->i18n->p("lists_datasets.pages.mean", "Mean") |h %></label>
            <span class="input-group-addon">
                <input type="radio" aria-label="IQR" id="iqr" value="iqr" name="dataset_metric" >
            </span>
            <label for="iqr" class="form-control" aria-label="iqr">IQR</label>
        </div>
    </div>
</div>

<div style="margin: 15px 0;">
    <div id="trait_graph"></div>
    <div class="hide_until_trait_selected" style="display: none; flex-wrap: wrap; gap: 5px; justify-content: space-around">
        <button class="btn btn-sm btn-success btn-dataset" id="store_outliers"><% $c->i18n->p("lists_datasets.pages.add_selection_to_outliers", "Add selection to outliers") |h %></button>
        <button class="btn btn-sm btn-danger btn-dataset" id="reset_trait"><% $c->i18n->p("lists_datasets.pages.reset_outliers_for_current_trait", "Reset outliers for current trait") |h %></button>
        <button class="btn btn-sm btn-danger btn-dataset" id="reset_outliers"><% $c->i18n->p("lists_datasets.pages.reset_all_outliers", "Reset all outliers") |h %></button>
        <button class="btn btn-sm btn-primary btn-dataset" id="outliers_phenotype_download"><% $c->i18n->p("lists_datasets.pages.download_phenotype_table_without_outliers", "Download Phenotype Table without outliers") |h %></button>
        <button class="btn btn-sm btn-primary btn-dataset" id="rosner_test"><% $c->i18n->p("lists_datasets.pages.make_rosner_outlier_test", "Make Rosner outlier test") |h %></button>
    </div>
</div>

<div class="row well" style="margin: 5px 10px;">
    <% $c->i18n->p("lists_datasets.pages.rosner_s_test_is_calculated_by_the_r_function_rosnertest_envstats_from_package_envstats", "Rosner's test is calculated by the R function rosnerTest{EnvStats} from package EnvStats.") |h %><br>
    <a href="https://cran.r-project.org/web/packages/EnvStats/index.html">https://cran.r-project.org/web/packages/EnvStats/index.html</a>
</div>

<div id="statistic_tests">
    <!--
    <table id="rosner_table">
    </table>
    -->
</div>


<script>

jQuery(document).ready( function() {

    $("#outliers_range").slider({
        orientation: "horizontal",
        range: "min",
        max: 12,
        min: 0,
        value: 3,
        step: 0.1,
    });
    var handle = $( "#custom-handle" );
    $("#outliers_range").slider({
        create: function(event, ui) {
            handle.text(ui.value);
        },
        slide: function(event, ui) {
            handle.text(ui.value);
        }
    });

    // console.log('dataset id', '<% $dataset_id %>');
    const width = jQuery("#trait_graph").closest(".col-sm-11").width();
    var DataSet = window.jsMod['dataset_scatterplot'].init(<% $dataset_id %>, "<% $dataset_name %>", width && width > 0 ? width - 30 : undefined);
    DataSet.render();

    jQuery('#outliers_phenotype_download').click(function() {

        var speed = 'MaterializedViewTable';
        var format = '.csv';
        var level = 'all';
        var timestamp = 0;

        var url = document.location.origin+
            `/breeders/download_action?trait_ids_list=${DataSet.traitsIds}`+
            `&format=${format}`+
            `&phenotype_datalevel=${level}`+
            `&timestamp_included=${timestamp}`+
            `&dataset_id=<% $dataset_id %>`

        window.open(url,'_blank');
    });

});

</script>


<style>
    .hide_until_trait_selected {
        display: none;
    }

    .top-row {
        # display: flex;
        # justify-content: center;
        margin-top: 20px;
    }

    ::-webkit-slider-runnable-track {
        background: #f7756c;
    }

    #pagefooter {
        min-height: 150px !important;
    }

    #trait_selection {
        font-size: 15px;
    }

    #trait_graph {
        // width: 65%;
        font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
    }

    table, th, td {
        padding: 15px;
    }

    .sd-line-top {
        stroke-dasharray: 5,5;
    }

    .sd-line-bottom {
        stroke-dasharray: 5,5;
    }

    .mean-line {
        stroke-dasharray: 5,5;
    }

    .btn-dataset {
        margin-left: 4px;
    }

    #rosner_table_wrapper {
        margin-top: 10px;
        margin-bottom: 10px;
    }

    #rosner_table {
        padding: 0px;
    }

    #outliers_range .ui-slider-range { background: #5cb85c; }
    #outliers_range .ui-slider-handle { border-color: #d9534f; }
    #outliers_range { background: #d9534f; margin-top: 0.7em;}
    #custom-handle {
        width: 3em;
        height: 1.6em;
        top: 50%;
        margin-top: -.8em;
        text-align: center;
        line-height: 1.6em;
    }

</style>
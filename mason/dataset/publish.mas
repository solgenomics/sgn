<%init>
use HTML::Entities ();
my $dataset_publish_external_service = HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.external_service_fallback", "the external service"));
my $dataset_publish_permanent = HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.permanently_available", "permanently available"));
my $dataset_publishing_disabled = HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.publishing_disabled", "Dataset Publishing has not been enabled on this database."));
my $dataset_publishing_disabled_external = HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.publishing_disabled_external", "You may generate archive files but they cannot be published to an external service.  Contact an administrator to have this feature enabled."));
</%init>

<%args>
$dataset_id
$dataset_name
$is_dataset_owner => 0
$is_dataset_public => 0
</%args>

<%once>
    my $project_name = $c->get_conf('project_name');
    my $user = $c->user();
    my $user_name = $user ? $user->get_first_name() . " " . $user->get_last_name() : "";
</%once>

<div id="dataset-archive-loading" style="margin: 50px auto; text-align: center">
    <p><em><% $c->i18n->p("global.dataset_publish.loading", "Loading...") |h %></em></p>
</div>

<div id="dataset-archive-enabled" style="display: none">
    <table class="table table-hover">
        <thead>
            <tr>
                <th><% $c->i18n->p("global.dataset_publish.date_published", "Date Published") |h %></th>
                <th><% $c->i18n->p("global.dataset_publish.user", "User") |h %></th>
                <th><% $c->i18n->p("global.dataset_publish.files", "Files") |h %></th>
                <th><% $c->i18n->p("global.dataset_publish.published_to", "Published To") |h %></th>
                <th></th>
            </tr>
        </thead>
        <tbody id="dataset-publish-status"></tbody>
    </table>

    <br /><br />

% if ( $is_dataset_owner ) {
    <button id="dataset-generate-archive" class="btn btn-primary"><span class="glyphicon glyphicon-folder-open"></span>&nbsp;&nbsp;<% $c->i18n->p("global.dataset_publish.generate_archive", "Generate Archive Files") |h %></button>
% } else {
    <button class="btn btn-primary" disabled><span class="glyphicon glyphicon-folder-open"></span>&nbsp;&nbsp;<% $c->i18n->p("global.dataset_publish.generate_archive", "Generate Archive Files") |h %></button>
    <p><small><% $c->i18n->p("global.dataset_publish.only_owner_generate", "Only the dataset owner can generate archive files") |h %></small></p>
% }
</div>

<div id="dataset-archive-no-services" style="display: none; margin-top: 50px">
    <& /generic_message.mas, message => '<p>' . $dataset_publishing_disabled . '</p><p>' . $dataset_publishing_disabled_external . '</p>' &>
</div>

<br /><br />

<&| /page/info_section.mas, id=> "publish_dataset_info", title => HTML::Entities::encode_entities($c->i18n->p('global.dataset_publish.info_title', 'Information about Publishing Datasets')), collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
    <p><% $c->i18n->p("global.dataset_publish.publishing_definition", "Dataset publishing allows the owner of a dataset to take a snapshot of the data contained within the dataset and publish it to an external service (such as FigShare), where it can be made publicly available and have a DOI assigned to it.") |h %></p>
    <p><% $c->i18n->p("global.dataset_publish.steps_intro", "The steps to publish a dataset are:") |h %></p>
    <ol>
        <li><strong><% $c->i18n->p("global.dataset_publish.step_generate", "Generate the archived files") |h %></strong> - <% $c->i18n->p("global.dataset_publish.step_generate_desc", "this creates a static snapshot of the data within the dataset at the time when the files are generated") |h %></li>
        <li><strong><% $c->i18n->p("global.dataset_publish.step_upload", "Upload the files to an external service") |h %></strong> - <% $c->i18n->p("global.dataset_publish.step_upload_desc", "this will upload the archived files to a new or existing dataset on the external service") |h %></li>
        <li><strong><% $c->i18n->p("global.dataset_publish.step_publish", "Publish the external dataset") |h %></strong> - <% $c->i18n->p("global.dataset_publish.step_publish_desc", "make the external dataset publicly available for others to find") |h %></li>
        <li><strong><% $c->i18n->p("global.dataset_publish.step_doi", "Reserve a DOI") |h %></strong> - <% $c->i18n->p("global.dataset_publish.step_doi_desc", "generate a Digital Object Identifier (DOI) for the external dataset that can be used as a reference in publications.") |h %></li>
    </ol>
    <hr />
    <p><% $c->i18n->p("global.dataset_publish.important_notes", "Important Notes:") |h %></p>
    <ul>
        <li><% $c->i18n->p("global.dataset_publish.permanent_note", "Once the external dataset has been published (made public), the uploaded files and metadata are permanently available.  Any changes you make will need to be republished to a new version of the external dataset.") |h %></li>
    </ul> 
</&>

<!-- Generate Archive Files Dialog -->
<div class="modal fade" id="dataset-archive-generate-dialog" name="dataset-archive-generate-dialog" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
          <h4 class="modal-title"><% $c->i18n->p("global.dataset_publish.generating_archive", "Generating Archive Files") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid" id="dataset-archive-generate-dialog-content">
        </div>
      </div>
      <div class="modal-footer">
        <button id="dataset-archive-generate-dialog-close" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
    </div>
    </div>
  </div>
</div>

<!-- Upload Files Dialog -->
<div class="modal modal-md fade" id="dataset-archive-upload-dialog" name="dataset-archive-upload-dialog" tabindex="-1" role="dialog" aria-labelledby="datasetArchiveUploadDialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content ui-front">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('global.dataset_publish.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="datasetArchiveUploadDialog"><% $c->i18n->p("global.dataset_publish.upload_dataset", "Upload Dataset") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <div class="warning-alert">
                <span class="warning-alert-icon glyphicon glyphicon-exclamation-sign"></span>
                <div>
                    <p><strong><% $c->i18n->p("global.dataset_publish.important", "IMPORTANT!") |h %></strong> <% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.upload_acknowledgement", "By continuing to upload these files, you acknowledge that this data is allowed to be shared on %{service} and can be made publicly available (once the dataset on %{service} is published).", {service => "__DATASET_SERVICE__"})) =~ s/__DATASET_SERVICE__/<span class="dataset-archive-publish-service-name">$dataset_publish_external_service<\/span>/gr %></p>
                </div>
            </div>

            <ol id="dataset-archive-publish-instructions">
                <li>
                    <p><% $c->i18n->p("global.dataset_publish.select_service", "Select the external service to upload this dataset to:") |h %></p>
                    <select id="dataset-archive-publish-services" class="form-control"></select>
                </li>
                <li class="dataset-archive-publish-connect">
                    <p><% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.account_login", "Make sure you have an account and are logged in to %{service}", {service => "__SERVICE__"})) =~ s/__SERVICE__/<span class="dataset-archive-publish-service-name"><\/span>/gr %></p>
                    <a id="dataset-archive-publish-account" class="btn btn-info btn-sm" href="#" target="_blank">
                        <span class="glyphicon glyphicon-user"></span>&nbsp;&nbsp;<% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.view_account", "View your %{service} account", {service => "__SERVICE__"})) =~ s/__SERVICE__/<span class="dataset-archive-publish-service-name"><\/span>/gr %>
                    </a>
                </li>
                <li class="dataset-archive-publish-connect">
                    <p><% do { my $caption = HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.grant_access", "Grant %{project} access to your %{service} account", {project => "%{project}", service => "%{service}"})); $caption =~ s{%\{(project|service)\}}{$1 eq "project" ? HTML::Entities::encode_entities($project_name) : q{<span class="dataset-archive-publish-service-name"></span>}}ger } %></p>
                    <button class="dataset-archive-publish-connect-btn btn btn-primary btn-sm">
                        <span class="glyphicon glyphicon-resize-small"></span>&nbsp;&nbsp;<% $c->i18n->p("global.dataset_publish.connect_accounts", "Connect Accounts") |h %>
                    </button>
                </li>
                <li class="dataset-archive-publish-connected">
                    <p><% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.connected_account", "You are connected to this %{service} account:", {service => "__SERVICE__"})) =~ s/__SERVICE__/<span class="dataset-archive-publish-service-name"><\/span>/gr %></p>
                    <p><strong><% $c->i18n->p("global.dataset_publish.name", "Name:") |h %></strong> <span class="dataset-archive-publish-connected-name"></span></p>
                    <p><strong><% $c->i18n->p("global.dataset_publish.email", "Email:") |h %></strong> <span class="dataset-archive-publish-connected-email"></span></p>
                    <button class="dataset-archive-publish-disconnect-btn btn btn-danger btn-sm">
                        <span class="glyphicon glyphicon-resize-full"></span>&nbsp;&nbsp;<% $c->i18n->p("global.dataset_publish.disconnect_accounts", "Disconnect Accounts") |h %>
                    </button>
                </li>
                <li class="dataset-archive-publish-connected">
                    <p><% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.select_dataset", "Select a %{service} dataset to associate this data with:", {service => "__SERVICE__"})) =~ s/__SERVICE__/<span class="dataset-archive-publish-service-name"><\/span>/gr %></p>
                    <select id="dataset-archive-publish-articles" class="form-control">
                        <option value=""><% $c->i18n->p("global.dataset_publish.create_new_dataset_prompt", "Create a new dataset") |h %></option>
                    </select>
                    <hr />
                    <label><% $c->i18n->p("global.dataset_publish.title", "Title:") |h %></label>
                    <div class="input-group">
                        <span id="dataset-archive-publish-article-title-addon" class="input-group-addon"></span>
                        <input id="dataset-archive-publish-article-title" class="form-control dataset-archive-publish-article-details" />
                    </div>
                    <br />
                    <label><% $c->i18n->p("global.dataset_publish.description", "Description:") |h %></label>
                    <textarea id="dataset-archive-publish-article-description" class="form-control dataset-archive-publish-article-details"></textarea>
                    <br />
                    <label><% $c->i18n->p("global.dataset_publish.additional_authors", "Additional Authors (one per line):") |h %></label>
                    <textarea id="dataset-archive-publish-article-authors" class="form-control dataset-archive-publish-article-details" placeholder="<% $c->i18n->p('global.dataset_publish.auto_author', 'You will automatically be added as an Author') |h %>"></textarea>
                    <br />
                    <p><em><% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.metadata_update_note", "The dataset metadata can be updated later on %{service} until the dataset on %{service} is published and made public.", {service => "__SERVICE__"})) =~ s/__SERVICE__/<span class="dataset-archive-publish-service-name dataset-archive-publish-article-details"><\/span>/gr %></em></p>
                </li>
                <li class="dataset-archive-publish-connected">
                    <p><% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.send_attach_note", "Send and attach the files to the selected %{service} dataset.", {service => "__SERVICE__"})) =~ s/__SERVICE__/<span class="dataset-archive-publish-service-name"><\/span>/gr %></p>
                    <button id="dataset-archive-publish-send" class="dataset-archive-publish-connected-btn btn btn-primary btn-sm">
                        <span class="glyphicon glyphicon-export"></span>&nbsp;&nbsp;<span id="dataset-archive-publish-send-label"><% $c->i18n->p("global.dataset_publish.send_files", "Send Files") |h %></span>
                    </button>
                    <br /><br />
                    <div class="progress">
                        <div id="dataset-archive-publish-send-pb" class="progress-bar progress-bar-striped" role="progressbar" style="width: 0%;">
                            <span class="sr-only"><% $c->i18n->p('global.dataset_publish.progress_percent_complete', '60% Complete') |h %></span>
                        </div>
                    </div>
                    <div class="progress">
                        <div id="dataset-archive-publish-send-subpb" class="progress-bar progress-bar-info" role="progressbar" style="width: 0%;">
                            <span class="sr-only"><% $c->i18n->p('global.dataset_publish.progress_percent_complete', '60% Complete') |h %></span>
                        </div>
                    </div>
                    <div style="display: flex; justify-content: space-between; gap: 15px">
                        <p id="dataset-archive-publish-send-status"></p>
                        <p id="dataset-archive-publish-send-substatus" style="font-size: 95%; font-style: italic"></p>
                    </div>
                </li>
            </ol>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
      </div>
    </div>
  </div>
</div>

<!-- Publish Dataset Dialog -->
<div class="modal modal-md fade" id="dataset-archive-publish-dialog" name="dataset-archive-publish-dialog" tabindex="-1" role="dialog" aria-labelledby="datasetArchivePublishDialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content ui-front">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('global.dataset_publish.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="datasetArchivePublishDialog"><% $c->i18n->p("global.dataset_publish.publish_dataset", "Publish Dataset") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <div class="warning-alert">
                <span class="warning-alert-icon glyphicon glyphicon-exclamation-sign"></span>
                <div>
                    <p><strong><% $c->i18n->p("global.dataset_publish.important", "IMPORTANT!") |h %></strong> <% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.public_warning", "Once you make the external dataset public, all of the uploaded files and metadata become %{permanent} and cannot be removed or modified from this version of the dataset.  If you need to make updates, changes can be made and new files can be uploaded and a new version of the external dataset will need to be published (the original version will still be accessible).", {permanent => "__PERMANENT__"})) =~ s/__PERMANENT__/<em>$dataset_publish_permanent<\/em>/gr %></p>
                    <p><strong><em><% $c->i18n->p("global.dataset_publish.confirm_all_correct", "Make sure everything is correct before publishing!") |h %></em></strong></p>
                </div>
            </div>

            <hr />

            <div class="dataset-archive-publish-connect">
                <p><% do { my $caption = HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.grant_access", "Grant %{project} access to your %{service} account", {project => "%{project}", service => "%{service}"})); $caption =~ s{%\{(project|service)\}}{$1 eq "project" ? HTML::Entities::encode_entities($project_name) : q{<span class="dataset-archive-publish-service-name"></span>}}ger } %></p>
                <button class="dataset-archive-publish-connect-btn btn btn-primary btn-sm">
                    <span class="glyphicon glyphicon-resize-small"></span>&nbsp;&nbsp;<% $c->i18n->p("global.dataset_publish.connect_accounts", "Connect Accounts") |h %>
                </button>
            </div>
            <div class="dataset-archive-publish-connected">
                <p><% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.connected_account", "You are connected to this %{service} account:", {service => "__SERVICE__"})) =~ s/__SERVICE__/<span class="dataset-archive-publish-service-name"><\/span>/gr %></p>
                <p><strong><% $c->i18n->p("global.dataset_publish.name", "Name:") |h %></strong> <span class="dataset-archive-publish-connected-name"></span></p>
                <p><strong><% $c->i18n->p("global.dataset_publish.email", "Email:") |h %></strong> <span class="dataset-archive-publish-connected-email"></span></p>
                <button class="dataset-archive-publish-disconnect-btn btn btn-danger btn-sm">
                    <span class="glyphicon glyphicon-resize-full"></span>&nbsp;&nbsp;<% $c->i18n->p("global.dataset_publish.disconnect_accounts", "Disconnect Accounts") |h %>
                </button>
            </div>

            <hr />

            <p><strong><% $c->i18n->p("global.dataset_publish.service", "Service:") |h %></strong> <span class="dataset-archive-publish-service-name"></span></p>
            <p><strong><% $c->i18n->p("global.dataset_publish.title", "Title:") |h %></strong> <span id="dataset-archive-publish-title"></span></p>
            <p><strong><% $c->i18n->p("global.dataset_publish.authors", "Authors:") |h %></strong> <span id="dataset-archive-publish-authors"></span></p>
            <p><strong><% $c->i18n->p("global.dataset_publish.description", "Description:") |h %></strong><br /><span id="dataset-archive-publish-description"></span></p>
            <p><strong><% $c->i18n->p('global.dataset_publish.files_label', 'Files:') |h %></strong> <span id="dataset-archive-publish-files"></span></p>
            <p><a id="dataset-archive-publish-link" href="#" target="_blank"><% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.view_details", "View Details on %{service}", {service => "__SERVICE__"})) =~ s/__SERVICE__/<span class="dataset-archive-publish-service-name"><\/span>/gr %></a></p>

            <hr />

            <button id="dataset-archive-publish-public" class="dataset-archive-publish-connected-btn btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-share"></span>&nbsp;&nbsp;<span id="dataset-archive-publish-send-label"><% $c->i18n->p("global.dataset_publish.make_public", "Publish & Make Public") |h %></span>
            </button>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
      </div>
    </div>
  </div>
</div>

<!-- Reserve DOI Dialog -->
<div class="modal modal-md fade" id="dataset-archive-doi-dialog" name="dataset-archive-doi-dialog" tabindex="-1" role="dialog" aria-labelledby="datasetArchiveDOIDialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content ui-front">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('global.dataset_publish.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="datasetArchiveDOIDialog"><% $c->i18n->p("global.dataset_publish.step_doi", "Reserve a DOI") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <div id="dataset-archive-doi-private-warning" class="warning-alert">
                <span class="warning-alert-icon glyphicon glyphicon-exclamation-sign"></span>
                <div>
                    <p><% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.doi_private_warning", "This dataset on %{service} is still private. The generated DOI will become active once the dataset is published and made public.", {service => "__SERVICE__"})) =~ s/__SERVICE__/<span class="dataset-archive-publish-service-name"><\/span>/gr %></p>
                </div>
            </div>

            <hr />

            <div class="dataset-archive-publish-connect">
                <p><% do { my $caption = HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.grant_access", "Grant %{project} access to your %{service} account", {project => "%{project}", service => "%{service}"})); $caption =~ s{%\{(project|service)\}}{$1 eq "project" ? HTML::Entities::encode_entities($project_name) : q{<span class="dataset-archive-publish-service-name"></span>}}ger } %></p>
                <button class="dataset-archive-publish-connect-btn btn btn-primary btn-sm">
                    <span class="glyphicon glyphicon-resize-small"></span>&nbsp;&nbsp;<% $c->i18n->p("global.dataset_publish.connect_accounts", "Connect Accounts") |h %>
                </button>
            </div>
            <div class="dataset-archive-publish-connected">
                <p><% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.connected_account", "You are connected to this %{service} account:", {service => "__SERVICE__"})) =~ s/__SERVICE__/<span class="dataset-archive-publish-service-name"><\/span>/gr %></p>
                <p><strong><% $c->i18n->p("global.dataset_publish.name", "Name:") |h %></strong> <span class="dataset-archive-publish-connected-name"></span></p>
                <p><strong><% $c->i18n->p("global.dataset_publish.email", "Email:") |h %></strong> <span class="dataset-archive-publish-connected-email"></span></p>
                <button class="dataset-archive-publish-disconnect-btn btn btn-danger btn-sm">
                    <span class="glyphicon glyphicon-resize-full"></span>&nbsp;&nbsp;<% $c->i18n->p("global.dataset_publish.disconnect_accounts", "Disconnect Accounts") |h %>
                </button>
            </div>

            <hr />

            <p><strong><% $c->i18n->p("global.dataset_publish.service", "Service:") |h %></strong> <span class="dataset-archive-publish-service-name"></span></p>
            <p><strong><% $c->i18n->p("global.dataset_publish.title", "Title:") |h %></strong> <span id="dataset-archive-doi-title"></span></p>
            <p><strong><% $c->i18n->p("global.dataset_publish.authors", "Authors:") |h %></strong> <span id="dataset-archive-doi-authors"></span></p>
            <p><strong><% $c->i18n->p("global.dataset_publish.description", "Description:") |h %></strong><br /><span id="dataset-archive-doi-description"></span></p>
            <p><strong><% $c->i18n->p('global.dataset_publish.files_label', 'Files:') |h %></strong> <span id="dataset-archive-doi-files"></span></p>
            <p><a id="dataset-archive-doi-link" href="#" target="_blank"><% HTML::Entities::encode_entities($c->i18n->p("global.dataset_publish.view_details", "View Details on %{service}", {service => "__SERVICE__"})) =~ s/__SERVICE__/<span class="dataset-archive-publish-service-name"><\/span>/gr %></a></p>

            <hr />

            <button id="dataset-archive-publish-doi" class="dataset-archive-publish-connected-btn btn btn-primary btn-sm">
                <span class="glyphicon glyphicon-barcode"></span>&nbsp;&nbsp;<span id="dataset-archive-publish-send-label"><% $c->i18n->p("global.dataset_publish.generate_a_doi", "Generate a DOI") |h %></span>
            </button>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
      </div>
    </div>
  </div>
</div>

<script>
function datasetPublishFallback(source, args = {}) {
    return source.replace(/%\{([^}]+)\}/g, (match, key) => Object.prototype.hasOwnProperty.call(args, key) ? args[key] : match);
}
function datasetPublishEscapeHtml(value) {
    return String(value == null ? "" : value).replace(/[&<>"']/g, function (character) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[character];
    });
}
var ISSUES = {};             // Status information about individual published issues of the dataset
var SELECTED_ISSUE;          // The currently selected published issue
var SERVICES = {};           // Information about available external services
var SELECTED_SERVICE = {};   // The currently selected external service
var SELECTED_ACCOUNT = {};   // Information on the currently selected account

jQuery(document).ready(() => {
    jQuery("#dataset-generate-archive").click(initArchive)
    jQuery("#dataset-archive-publish-services").on("change", () => onServiceChanged());
    jQuery(".dataset-archive-publish-connect-btn").click(connectService);
    jQuery(".dataset-archive-publish-disconnect-btn").click(disconnectService);
    jQuery("#dataset-archive-publish-send").click(sendArchive);
    jQuery("#dataset-archive-publish-public").click(makePublic);
    jQuery("#dataset-archive-publish-doi").click(getDOI);
    jQuery("#dataset-archive-publish-articles").on("change", onArticleChanged);

    updateServices().then(updateIssues);
});


/**
 * Get the available external services from the server config
 * - Call displayServices() on success
 */
function updateServices() {
    return new Promise((resolve, reject) => {
        jQuery.ajax({
            url: '/ajax/dataset/publish/services',
            success: (resp) => {
                if ( resp?.error ) {
                    alert(resp.error);
                }
                else {
                    displayServices(resp);
                    resolve(resp);
                }
            },
            error: () => {
                alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.services", "Could not get external services") : "Could not get external services"));
            }
        });
    })
}

/**
 * Display the external services as options in the select menu
 */
function displayServices(services = {}) {
    SERVICES = services;

    jQuery("#dataset-archive-loading").hide();
    jQuery("#dataset-archive-enabled").show();

    if ( Object.keys(SERVICES).length > 0 ) {
        jQuery("#dataset-archive-no-services").hide();
    }
    else {
        jQuery("#dataset-archive-no-services").show();
    }

    var html = "";
    Object.keys(SERVICES).sort().forEach((key) => {
        html += `<option value='${key}'>${SERVICES[key].display_name} [${SERVICES[key].web_url}]</option>`;
    });
    jQuery("#dataset-archive-publish-services").html(html);
    onServiceChanged();
}

/**
 * Handle a service change
 * - display selected service name throughout the dialog
 * - update the link for the user to check their account
 * - call updateConnection() to check for already-provided user account on the service
 */
function onServiceChanged(service) {
    SELECTED_SERVICE = SERVICES[service || jQuery("#dataset-archive-publish-services").val()];
    if ( SELECTED_SERVICE ) {
        jQuery(".dataset-archive-publish-service-name").html(SELECTED_SERVICE.display_name);
        jQuery("#dataset-archive-publish-account").attr('href', `${SELECTED_SERVICE.web_url}${SELECTED_SERVICE.user_path}`);
    }
    updateConnection();
}

/**
 * Check the User Prefs on the server to see if the user has an account with the selected service
 * - Call displayConnection()
 */
function updateConnection() {
    if ( SELECTED_SERVICE && SELECTED_SERVICE.key ) {
        jQuery.ajax({
            url: `/ajax/dataset/publish/connection/${SELECTED_SERVICE.key}`,
            success: (resp) => {
                if ( resp?.error ) {
                    alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.connection_detail", "Could not update connection info [%{error}]", {error: resp.error}) : datasetPublishFallback("Could not update connection info [%{error}]", {error: resp.error})));
                    displayConnection();
                }
                else {
                    displayConnection(resp);
                }
            },
            error: () => {
                alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.connection", "Could not update connection info") : "Could not update connection info"));
                displayConnection();
            }
        });
    }
    else {
        displayConnection();
    }
}

/**
 * Display the user's stored account with the selected service
 * - check if provided token is still valid
 * - toggle connection / connect steps depending on account status and selected service
 */
function displayConnection(account = {}) {
    SELECTED_ACCOUNT = account;

    // A service and account have been selected
    if ( !!SELECTED_SERVICE && SELECTED_ACCOUNT.hasOwnProperty('token') && SELECTED_ACCOUNT.hasOwnProperty('profile') ) {
        const now = new Date().getTime();
        if ( SELECTED_ACCOUNT.token.expiration > now ) {
            jQuery(".dataset-archive-publish-connected").show();
            jQuery(".dataset-archive-publish-connect").hide();
            jQuery(".dataset-archive-publish-connected-name").html(SELECTED_ACCOUNT.profile.first_name + ' ' + SELECTED_ACCOUNT.profile.last_name);
            jQuery(".dataset-archive-publish-connected-email").html(SELECTED_ACCOUNT.profile.email);
            jQuery(".dataset-archive-publish-connected-btn").attr("disabled", false);
            updateArticles();
            return;
        }
    }

    // Only a service has been selected
    else if ( !!SELECTED_SERVICE ) {
        jQuery(".dataset-archive-publish-connected").hide();
        jQuery(".dataset-archive-publish-connect").show();
        jQuery(".dataset-archive-publish-connected-btn").attr("disabled", true);
    }

    // Service not selected
    else {
        jQuery(".dataset-archive-publish-connected").hide();
        jQuery(".dataset-archive-publish-connect").hide();
        jQuery(".dataset-archive-publish-connected-btn").attr("disabled", true);
    }
}

/**
 * Start the OAuth flow to allow the user to connect their account on the selected service
 * - launches a pop-up window to grant access to the user's account
 * - the pop-up will store the user's info in the User Prefs on the server
 * - once the pop-up is closed, call updateConnection() to reflect changes
 */
function connectService() {
    if ( SELECTED_SERVICE ) {
        jQuery(".dataset-archive-publish-connect-btn").attr("disabled", true);
        window.authorize_data = { service: SELECTED_SERVICE };
        const popup = window.open(`/dataset/publish/authorize/${SELECTED_SERVICE.key}`, '_authorize', 
            `toolbar=no,
            location=no,
            status=no,
            menubar=no,
            scrollbars=yes,
            resizable=yes,
            width=700, 
            height=700`
        );

        if ( !popup ) {
            jQuery(".dataset-archive-publish-connect-btn").attr("disabled", false);
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.popup_required", "You must allow popup windows in your browser to continue") : "You must allow popup windows in your browser to continue"));
        }

        const interval = setInterval(() => {
            if (popup.closed) {
                clearInterval(interval);
                jQuery(".dataset-archive-publish-connect-btn").attr("disabled", false);
                window.authorize_data = {};
                updateConnection();
            }
        }, 500);
    }
}

/**
 * Remove the selected account from the User Prefs
 * - call updateConnection() to reflect the changes
 */
function disconnectService() {
    SELECTED_ACCOUNT = {};
    jQuery.ajax({
        url: `/ajax/dataset/publish/connection/remove/${SELECTED_SERVICE.key}`,
        method: 'DELETE',
        success: () => {
            updateConnection();
        }
    });
}

/**
 * Get a list of the user's account articles
 * - Call displayArticles() with the results
 */
function updateArticles() {
    jQuery.ajax({
        url: `/ajax/dataset/publish/articles/${SELECTED_SERVICE.key}`,
        success: (resp) => {
            if ( resp?.error ) {
                alert(resp.error)
            }
            else {
                displayArticles(resp?.articles);
            }
        },
        error: () => {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.articles", "Could not get account articles") : "Could not get account articles"));
        }
    });
}

/**
 * Display the user's account articles in the article select menu
 * @param articles = Array of article metadata
 */
function displayArticles(articles = []) {
    var html = `<option value="">${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.create_new_dataset", "Create a new %{service} dataset", {service: SELECTED_SERVICE.display_name}) : datasetPublishFallback("Create a new %{service} dataset", {service: SELECTED_SERVICE.display_name})))}</option>`;
    articles.forEach((a) => {
        html += `<option value='${a.id}'>${a.title}</a>`;
    });
    jQuery("#dataset-archive-publish-articles").html(html);
    onArticleChanged();
}

/**
 * Handle a changed article
 * - If a specific article is selected, fetch and display its details
 * - If a new article is selected, clear the form
 */
async function onArticleChanged() {
    var selected = jQuery("#dataset-archive-publish-articles").val();
    if ( selected && selected !== '' ) {
        jQuery(".dataset-archive-publish-connected-btn").attr("disabled", true);
        jQuery(".dataset-archive-publish-article-details").attr("disabled", true);
        try {
            const details = await getArticleDetails(SELECTED_SERVICE.key, selected);
            jQuery("#dataset-archive-publish-article-title").val(details.title);
            jQuery("#dataset-archive-publish-article-title-addon").html(details.status.toUpperCase());
            jQuery("#dataset-archive-publish-article-description").val(details.description);
            jQuery("#dataset-archive-publish-article-authors").val(details.authors.map((e) => e.full_name).join('\n'));
            jQuery("#dataset-archive-publish-send-label").html(datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.add_files_to_dataset", "Add files to selected dataset") : "Add files to selected dataset")));
            jQuery(".dataset-archive-publish-connected-btn").attr("disabled", false);
        }
        catch (err) {
            alert(err);
        }
    }
    else {
        jQuery(".dataset-archive-publish-connected-btn").attr("disabled", false);
        jQuery(".dataset-archive-publish-article-details").attr("disabled", false);
        jQuery("#dataset-archive-publish-article-title").val("");
        jQuery("#dataset-archive-publish-article-title-addon").html(datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.new", "NEW") : "NEW")));
        jQuery("#dataset-archive-publish-article-description").val("");
        jQuery("#dataset-archive-publish-article-authors").val("");
        jQuery("#dataset-archive-publish-send-label").html(datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.create_dataset_and_add_files", "Create new dataset and add files") : "Create new dataset and add files")));
    }
}

/**
 * Get the details of the specified article from the external service
 * @param service = key of the external service where the article is hosted
 * @param article_id = id of the specific article
 */
function getArticleDetails(service, article_id) {
    return new Promise((resolve, reject) => {
        jQuery.ajax({
            url: `/ajax/dataset/publish/articles/${service}/${article_id}`,
            success: (resp) => {
                if ( resp?.error ) {
                    reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.article_details_detail", "Could not get article details [%{error}]", {error: resp.error}) : datasetPublishFallback("Could not get article details [%{error}]", {error: resp.error})));
                }
                else if ( resp?.article ) {
                    resolve(resp.article);
                }
            },
            error: () => {
                reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.article_details", "Could not get article details") : "Could not get article details"));
            }
        });
    })
}

/**
 * Get the stored published metadata for this dataset
 * - Call displayIssues() with the results
 */
function updateIssues() {
    jQuery.ajax({
        url: '/ajax/dataset/publish/issues/<% $dataset_id %>',
        success: (resp) => {
            if ( resp?.error ) {
                alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.issues_detail", "Could not get the dataset published issues [%{error}]", {error: resp.error}) : datasetPublishFallback("Could not get the dataset published issues [%{error}]", {error: resp.error})));
            }
            else {
                displayIssues(resp?.published);
            }
        },
        error: () => {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.issues", "Could not get dataset published issues") : "Could not get dataset published issues"));
        }
    });
}

/**
 * Display the stored published metadata
 * @param issues = Object of issue metadata, where the key is the issue key
 */
async function displayIssues(issues = {}) {
    ISSUES = issues;
    const keys = Object.keys(ISSUES);
    const rows = [];
    if ( keys.length > 0 ) {
        for ( const k of keys ) {
            const s = ISSUES[k];
            const types = Object.keys(s.data || {});
            let overallSubmitted = false;
            let overallComplete = true;

            // Publish date
            var html = `<td>${new Date(s.ts).toLocaleString()}</td>`;

            // Publish User
            html += `<td><a href='/solpeople/personal-info.pl?sp_person_id=${s.user.id}'>${s.user.name}</a></td>`;

            // File List
            html += `<td><ul style='padding-left: 15px'>`;
            for ( const t of types ) {
                const file = s.data[t].file
                if ( file ) {
                    const url = `/ajax/dataset/publish/file/<% $dataset_id %>/${k}/${t}`;

                    // Check the status of each file, to see if it's been uploaded
                    let isSubmitted = s.data[t].submitted?.file_id;
                    let isComplete = s.data[t].complete === 1;

                    // Display the file name, link to download, and check if completely uploaded
                    html += `<li>`;
                    html += `<a href='${url}' target='_blank'>${file}</a>`;
                    if ( isSubmitted && isComplete ) html += `&nbsp;&nbsp;<span class='glyphicon glyphicon-ok text-success'></span>`;
                    html += `</li>`;

                    if ( isSubmitted ) overallSubmitted = true;
                    if ( !isComplete ) overallComplete = false;
                }
            };
            html += `</ul></td>`;

            // Display external reference, if published
            if ( s.article?.id ) {
                html += `<td><div style="display: flex; flex-direction: column; gap: 15px">`;

                // Display Service Name
                if ( SERVICES.hasOwnProperty(s.service) ) {
                    html += `<span><strong>${SERVICES[s.service].display_name}</strong></span>`;
                }

                // Display Public Link
                if ( s.article.is_public ) {
                    html += `<div><span class="label label-primary">${datasetPublishEscapeHtml(window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.status.public", "Public") : "Public")}</span>&nbsp;<a href='${s.article.url_public_html}' target='_blank'>${s.article.title}</a></div>`;
                }

                // Display Private Link, only to the dataset owner
% if ( $is_dataset_owner ) {
                    html += `<div><span class="label label-info">${datasetPublishEscapeHtml(window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.status.preview", "Preview") : "Preview")}</span>&nbsp;<a href='${s.article.url_private_html}' target='_blank'>${s.article.title}</a></div>`;
% } else {
                    if ( !s.article.is_public ) html += `<em>${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.status.private", "Published to a private dataset") : "Published to a private dataset"))}</em>`;
% }

                // Display DOI, if available
                if ( s.article.doi && s.article.doi !== '' ) html += `<div><a href='https://doi.org/${s.article.doi}' target='_blank'>${s.article.doi}</a></div>`;
                html += `</div></td>`;
            }
            else {
                html += `<td><em>${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.status.not_uploaded", "Not uploaded") : "Not uploaded"))}</em></td>`;
            }

            // Display actions only to owner
% if ( $is_dataset_owner ) {
            html += `<td><div style='display: flex; flex-wrap: wrap; gap: 5px;'>`
            if ( Object.keys(SERVICES).length > 0 ) {
                if ( !overallSubmitted || !overallComplete ) html += `<button class='btn btn-primary btn-xs' onclick='uploadIssue(${s.key})'><span class='glyphicon glyphicon-export'></span>&nbsp;&nbsp;${datasetPublishEscapeHtml(window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.action.upload", "Upload") : "Upload")}</button>`;
                if ( overallSubmitted && overallComplete ) html += `<button class='btn btn-primary btn-xs' onclick='editIssue(${s.key}, "${s.service}")'><span class='glyphicon glyphicon-pencil'></span>&nbsp;&nbsp;${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.action.edit_on", "Edit on %{service}", {service: SERVICES[s.service]?.display_name}) : datasetPublishFallback("Edit on %{service}", {service: SERVICES[s.service]?.display_name})))}</button>`;
                if ( overallSubmitted && overallComplete && s.published !== 1 ) html += `<button class='btn btn-warning btn-xs' onclick='publishIssue(${s.key}, "${s.service}")'><span class='glyphicon glyphicon-share'></span>&nbsp;&nbsp;${datasetPublishEscapeHtml(window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.action.publish", "Publish") : "Publish")}</button>`;
                if ( s.article?.id && (!s.article?.doi || s.article?.doi === '') ) html += `<button class='btn btn-primary btn-xs' onclick='reserveDOI(${s.key}, "${s.service}")'><span class='glyphicon glyphicon-barcode'></span>&nbsp;&nbsp;${datasetPublishEscapeHtml(window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.action.reserve_doi", "Reserve DOI") : "Reserve DOI")}</button>`;
            }
            html += `<button class='btn btn-danger btn-xs' onclick='removeIssue(${s.key})'><span class='glyphicon glyphicon-trash'></span>&nbsp;&nbsp;${datasetPublishEscapeHtml(window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.action.remove", "Remove") : "Remove")}</button>`;
            html += `</div></td>`;
% } else {
            html += `<td></td>`;
% }
            rows.push(html);
        }

        jQuery("#dataset-publish-status").html(`<tr>${rows.join('</tr><tr>')}</tr>`);
    }
    else {
        const html = `<tr><td colspan=5><p style='text-align: center'><em>${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.not_published", "This dataset has not been published") : "This dataset has not been published"))}</em></p><br /><p style='text-align: center'>${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.generate_first", "To publish this dataset, first generate a set of archived files.") : "To publish this dataset, first generate a set of archived files."))}</p></td></tr>`;
        jQuery("#dataset-publish-status").html(html);
    }
}

/**
 * Generate the archived files that are stored on breedbase
 * - Initialize a new issue for this dataset, which calculates which files need to be generated
 * - After initialization, display the generate dialog and start to generate each file
 */
function initArchive() {
    jQuery("#dataset-archive-generate-dialog-content").html(`<p>${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.analyzing", "Analyzing Dataset...") : "Analyzing Dataset..."))}</p>`);
    jQuery("#dataset-archive-generate-dialog").modal("show");
    jQuery("#dataset-archive-generate-dialog-close").attr("disabled", true);
    jQuery.ajax({
        url: '/ajax/dataset/publish/init/<% $dataset_id %>',
        success: (resp = {}) => {
            if ( resp?.error ) {
                alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.init_detail", "Could not initialize dataset archive files [%{error}]", {error: resp.error}) : datasetPublishFallback("Could not initialize dataset archive files [%{error}]", {error: resp.error})));
            }
            else {
                const { key, data } = resp;
                displayArchiveFiles(key, data);
            }
        },
        error: () => {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.init", "Could not initialize dataset archive files") : "Could not initialize dataset archive files"));
        }
    });
}

/**
 * Display the table of archive files to generate in the modal dialog
 * @param key = the key for the specific issue being generated
 * @param data = Object of archive file info (where the key is the file type and the value is the IDs of the items in the file type)
 * - This will display the generate files modal with the table of file types
 * - This will call generateArchiveFile() in sequence for each file type
 */
async function displayArchiveFiles(key, data = {}) {
    const types = Object.keys(data).sort();

    // Display the file type table
    let html = `<p>${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.files_to_generate", "Files to generate:") : "Files to generate:"))}</p>`;
    html += `<table class='table table-striped'>`;
    html += `<thead><tr><th>${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.data_type", "Data Type") : "Data Type"))}</th><th>${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.item_count", "Item Count") : "Item Count"))}</th><th>${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.status.heading", "Status") : "Status"))}</th></tr></thead>`;
    for (const t of types ) {
        const ids = data[t];
        if ( ids && ids.length > 0 ) {
            html += `<tr><td>${t}</td><td>${ids.length}</td><td id='dataset-archive-generate-dialog-status-${t}'><span class='glyphicon glyphicon-option-horizontal'></span>&nbsp;&nbsp;<em>${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.pending", "Pending...") : "Pending..."))}</em></td></tr>`;
        }
    }
    html += `</table>`
    jQuery("#dataset-archive-generate-dialog-content").html(html);

    // Generate each file type
    for ( const t of types ) {
        try {
            const ids = data[t];
            if ( ids && ids.length > 0 ) {
                const file = await generateArchiveFile(key, t);
                if ( file && file !== '' ) {
                    jQuery(`#dataset-archive-generate-dialog-status-${t}`).html(`<strong><span class='glyphicon glyphicon-ok text-success'></span></strong>&nbsp;&nbsp;${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.created_file", "Created archived file: %{file}", {file}) : datasetPublishFallback("Created archived file: %{file}", {file})))}`);
                }
                else {
                    jQuery(`#dataset-archive-generate-dialog-status-${t}`).html(`<strong><span class='glyphicon glyphicon-exclamation-sign text-danger'></span></strong>&nbsp;&nbsp;${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.could_not_generate", "Could not generate file") : "Could not generate file"))}`);
                }
            }
        }
        catch (err) {
            jQuery(`#dataset-archive-generate-dialog-status-${t}`).html(`<strong><span class='glyphicon glyphicon-exclamation-sign text-danger'></span></strong>&nbsp;&nbsp;${datasetPublishEscapeHtml(err)}`);
        }
    }

    // Refresh the Issues
    jQuery("#dataset-archive-generate-dialog-close").attr("disabled", false);
    updateIssues();
}

/**
 * Generate an archived file for a specific data type
 * @param key = the issue key
 * @param type = the data type
 */
function generateArchiveFile(key, type) {
    return new Promise((resolve, reject) => {
        jQuery.ajax({
            url: '/ajax/dataset/publish/generate',
            method: 'POST',
            data: {
                dataset_id: <% $dataset_id %>,
                key,
                type
            },
            success: (resp) => {
                if ( resp?.error ) {
                    reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.generate_detail", "Could not generate %{type} file [%{error}]", {type, error: resp.error}) : datasetPublishFallback("Could not generate %{type} file [%{error}]", {type, error: resp.error})));
                }
                else {
                    resolve(resp.file);
                }
            },
            error: () => {
                reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.generate_type", "Could not generate %{type} file", {type}) : datasetPublishFallback("Could not generate %{type} file", {type})));
            }
        });
    })
}


/**
 * Show the upload dialog for the specific issue
 */
function uploadIssue(key) {
    SELECTED_ISSUE = ISSUES[key];
    jQuery("#dataset-archive-upload-dialog").modal("show");
}

/**
 * Open the Article edit page on the external service
 */
function editIssue(key, service) {
    SELECTED_ISSUE = ISSUES[key];
    onServiceChanged(service);
    if ( SELECTED_ISSUE.article && SELECTED_ISSUE.article.id ) {
        window.open(`${SELECTED_SERVICE.web_url}/account/items/${SELECTED_ISSUE.article.id}/edit`, "_blank");
    }
}

/**
 * Show the publish dialog for the specific issue (on the set external service)
 */
function publishIssue(key, service) {
    SELECTED_ISSUE = ISSUES[key];
    onServiceChanged(service);
    if ( !SELECTED_ISSUE.article || !SELECTED_ISSUE.article.id ) {
        alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.no_article", "The selected dataset archive is not associated with an external article!") : "The selected dataset archive is not associated with an external article!"));
        return;
    }

    // Update article metadata to display
    jQuery("#dataset-archive-publish-title").html(SELECTED_ISSUE.article.title);
    jQuery("#dataset-archive-publish-authors").html((SELECTED_ISSUE.article.authors || []).map((e) => e.full_name).join(', '));
    jQuery("#dataset-archive-publish-description").html(SELECTED_ISSUE.article.description);
    jQuery("#dataset-archive-publish-files").html((SELECTED_ISSUE.article.files || []).map((e) => e.name).join(', '));
    jQuery("#dataset-archive-publish-link").attr("href", SELECTED_ISSUE.article.url_private_html);

    jQuery("#dataset-archive-publish-dialog").modal("show");
}

/**
 * Show the reserve DOI dialog for the specific issue (on the set external service)
 */
function reserveDOI(key, service) {
    SELECTED_ISSUE = ISSUES[key];
    onServiceChanged(service);
    if ( !SELECTED_ISSUE.article || !SELECTED_ISSUE.article.id ) {
        alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.no_article", "The selected dataset archive is not associated with an external article!") : "The selected dataset archive is not associated with an external article!"));
        return;
    }

    // Update article metadata to display
    !SELECTED_ISSUE.article.is_public ? jQuery("#dataset-archive-doi-private-warning").show() : jQuery("#dataset-archive-doi-private-warning").hide();
    jQuery("#dataset-archive-doi-title").html(SELECTED_ISSUE.article.title);
    jQuery("#dataset-archive-doi-authors").html((SELECTED_ISSUE.article.authors || []).map((e) => e.full_name).join(', '));
    jQuery("#dataset-archive-doi-description").html(SELECTED_ISSUE.article.description);
    jQuery("#dataset-archive-doi-files").html((SELECTED_ISSUE.article.files || []).map((e) => e.name).join(', '));
    jQuery("#dataset-archive-doi-link").attr("href", SELECTED_ISSUE.article.url_private_html);

    jQuery("#dataset-archive-doi-dialog").modal("show");
}

/**
 * Remove the issue from the dataset
 * - This removes the archived files and the metadata stored with the dataset
 * - Call updateIssues() when complete to reflect changes
 */
function removeIssue(key) {
    if (confirm((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.confirm.remove", "Are you sure you want to unlink this published metadata from the dataset?  This will remove the archived data on this server and the connection between the dataset and the external service.  This will NOT remove anything from the external service.") : "Are you sure you want to unlink this published metadata from the dataset?  This will remove the archived data on this server and the connection between the dataset and the external service.  This will NOT remove anything from the external service.")) ) {
        jQuery.ajax({
            url: `/ajax/dataset/publish/issues/remove/<% $dataset_id %>/${key}`,
            success: (resp) => {
                if ( resp?.error ) {
                    alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.remove_issues_detail", "Could not remove dataset published issues [%{error}]", {error: resp.error}) : datasetPublishFallback("Could not remove dataset published issues [%{error}]", {error: resp.error})));
                }
                else {
                    updateIssues();
                }
            },
            error: () => {
                alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.remove_issues", "Could not remove dataset published issues") : "Could not remove dataset published issues"));
            }
        });
    }
}

/**
 * Submit the archived files to a new or existing dataset on the external service
 * - This will call createArticle() to create a new article on the service, if needed
 * - Submit each of the dataset's archived files, using submitFile() to the specified article
 * - Upload each of the chunks for each file
 * - Finalize the file
 * - Update the Issues when complete to reflect the changes
 */
async function sendArchive() {
    if ( confirm((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.confirm.upload", "Are you sure you want to upload the files to %{service} now?", {service: SELECTED_SERVICE.display_name}) : datasetPublishFallback("Are you sure you want to upload the files to %{service} now?", {service: SELECTED_SERVICE.display_name}))) ) {
        try {
            jQuery(".dataset-archive-publish-connected-btn").attr("disabled", true);
            let article_id = jQuery("#dataset-archive-publish-articles").val();
            const types = [];
            for ( const t of Object.keys(SELECTED_ISSUE.data || {}) ) {
                if ( SELECTED_ISSUE.data[t].file ) {
                    types.push(t);
                }
            }

            let total = !article_id || article_id === '' ? types.length+1 : types.length;
            let count = 0;

            // Create article first, if necessary
            if ( !article_id || article_id === '' ) {
                const title = jQuery("#dataset-archive-publish-article-title").val();
                progress({ msg: (window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.creating_dataset", "Creating new dataset: %{title}", {title}) : datasetPublishFallback("Creating new dataset: %{title}", {title})), count, total });
                article_id = await createArticle();
                count ++;
            }

            // Submit each of the file types
            for (const t of types) {
                let subTotal = 1;
                let subCount = 0;

                // Submit the file
                progress({ msg: (window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.progress.sending_type", "Sending data type: %{type}", {type: t}) : datasetPublishFallback("Sending data type: %{type}", {type: t})), count, total });
                subProgress({ clear: true });
                const { parts = {}, file_id, upload_url } = await submitFile(article_id, t);
                subTotal = Object.keys(parts).length;
                subCount++;

                // Upload each part of the file
                const partNos = Object.keys(parts);
                for ( const partNo of partNos ) {
                    const part = parts[partNo];
                    subProgress({ msg: (window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.progress.uploading_chunk", "Uploading chunk: %{count}/%{total}", {count: subCount, total: subTotal}) : datasetPublishFallback("Uploading chunk: %{count}/%{total}", {count: subCount, total: subTotal})), count: subCount, total: subTotal+1 });
                    await submitPart(t, upload_url, part);
                    subCount++;
                };

                // Finalize the File
                subProgress({ msg: (window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.progress.finalizing_file", "Finalizing File") : "Finalizing File"), count: subCount, total: subTotal });
                await finalizeFile(t, file_id, article_id);

                // Show success for file
                subCount++;
                count++;
                subProgress({ msg: '', count: subCount, total: subTotal });
                progress({ msg: (window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.progress.uploaded_file", "Uploaded file: %{type}", {type: t}) : datasetPublishFallback("Uploaded file: %{type}", {type: t})), count, total });
            };

            // Show completed status
            count++;
            progress({ msg: (window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.progress.all_files_uploaded", "All Files Uploaded!") : "All Files Uploaded!"), bold: true, count, total });
            subProgress({ clear: true });
            jQuery(".dataset-archive-publish-connected-btn").attr("disabled", false);
            updateIssues();
        }
        catch (err) {
            jQuery(".dataset-archive-publish-connected-btn").attr("disabled", false);
            fail(err);
        }
    }
}

/**
 * Create a new article on the exernal service
 * - This uses the user-provided title, description, and additonal authors
 * - This will resolve with the new article id, if successful
 */
function createArticle() {
    return new Promise((resolve, reject) => {
        const title = jQuery("#dataset-archive-publish-article-title").val();
        const description = jQuery("#dataset-archive-publish-article-description").val();
        const authors = jQuery("#dataset-archive-publish-article-authors").val();

        if ( !title || title === '' ) return reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.article_required", "Please provide a name for the new dataset") : "Please provide a name for the new dataset"));
        if ( !description || description === '' ) return reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.description_required", "Please provide a description for the new dataset") : "Please provide a description for the new dataset"));

        jQuery.ajax({
            url: `/ajax/dataset/publish/articles/new`,
            method: 'POST',
            data: {
                dataset_id: <% $dataset_id %>,
                service: SELECTED_SERVICE.key,
                title,
                description,
                authors
            },
            success: (resp) => {
                if ( resp?.error || !resp?.entity_id) {
                    reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.create_article_detail", "Could not create new article [%{error}]", {error: resp.error}) : datasetPublishFallback("Could not create new article [%{error}]", {error: resp.error})));
                }
                else {
                    resolve(resp.entity_id);
                }
            },
            error: () => {
                reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.create_article", "Could not create new article") : "Could not create new article"))
            }
        });
    });
}

/**
 * Submit the specified file to the specified article
 * - This creates the file entry, but does not upload the content
 */
function submitFile(article, data_type) {
    return new Promise((resolve, reject) => {
        jQuery.ajax({
            url: `/ajax/dataset/publish/submit`,
            method: 'POST',
            data: {
                service: SELECTED_SERVICE.key,
                article_id: article,
                dataset_id: <% $dataset_id %>,
                key: SELECTED_ISSUE.key,
                type: data_type
            },
            success: (resp) => {
                if ( resp?.error ) {
                    reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.submit_detail", "Could not submit data type: %{type} [%{error}]", {type: data_type, error: resp.error}) : datasetPublishFallback("Could not submit data type: %{type} [%{error}]", {type: data_type, error: resp.error})));
                }
                else {
                    resolve(resp);
                }
            },
            error: () => {
                reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.submit", "Could not submit data_type: %{type}", {type: data_type}) : datasetPublishFallback("Could not submit data_type: %{type}", {type: data_type})));
            }
        });
    });
}

/**
 * Upload the specified chunk of a file to the submitted file upload URL
 */
function submitPart(data_type, upload_url, part) {
    return new Promise((resolve, reject) => {
        if ( part.status === 'COMPLETE' ) {
            return resolve();
        }

        jQuery.ajax({
            url: `/ajax/dataset/publish/upload`,
            method: 'POST',
            data: {
                service: SELECTED_SERVICE.key,
                dataset_id: <% $dataset_id %>,
                key: SELECTED_ISSUE.key,
                type: data_type,
                partNo: part.partNo,
                startOffset: part.startOffset,
                endOffset: part.endOffset,
                uploadUrl: upload_url
            },
            success: (resp) => {
                if ( resp?.error ) {
                    reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.upload_detail", "Could not upload file: %{type} [%{error}]", {type: data_type, error: resp.error}) : datasetPublishFallback("Could not upload file: %{type} [%{error}]", {type: data_type, error: resp.error})));
                }
                else {
                    resolve();
                }
            },
            error: () => {
                reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.upload", "Could not upload file: %{type}", {type: data_type}) : datasetPublishFallback("Could not upload file: %{type}", {type: data_type})));
            }
        });
    });
}

/**
 * Finalize the file upload, done after all of the parts have been uploaded
 */
function finalizeFile(data_type, file_id, article_id) {
    return new Promise((resolve, reject) => {
        jQuery.ajax({
            url: '/ajax/dataset/publish/finalize',
            method: 'POST',
            data: {
                service: SELECTED_SERVICE.key,
                dataset_id: <% $dataset_id %>,
                key: SELECTED_ISSUE.key,
                type: data_type,
                file_id: file_id,
                article_id: article_id
            },
            success: (resp) => {
                if ( resp?.error ) {
                    reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.finalize_detail", "Could not finalize file: %{type} [%{error}]", {type: data_type, error: resp.error}) : datasetPublishFallback("Could not finalize file: %{type} [%{error}]", {type: data_type, error: resp.error})));
                }
                else {
                    resolve();
                }
            },
            error: () => {
                reject((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.finalize", "Could not finalize file: %{type}", {type: data_type}) : datasetPublishFallback("Could not finalize file: %{type}", {type: data_type})));
            }
        });
    });
}

/**
 * Set the article from the selected issue as public
 */
function makePublic() {
    if ( !SELECTED_ISSUE.article || !SELECTED_ISSUE.article.id ) {
        alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.no_article", "The selected dataset archive is not associated with an external article!") : "The selected dataset archive is not associated with an external article!"));
        return;
    }

    if ( confirm((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.confirm.publish", "Are you sure you want to publish this dataset now? This cannot be undone.") : "Are you sure you want to publish this dataset now? This cannot be undone.")) ) {
        jQuery("#working_modal").modal("show");
        jQuery.ajax({
            url: `/ajax/dataset/publish/issues/publish/<% $dataset_id %>/${SELECTED_ISSUE.key}`,
            success: (resp) => {
                jQuery("#working_modal").modal("hide");
                if ( resp?.error ) {
                    alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.publish_detail", "Could not publish dataset [%{error}]", {error: resp.error}) : datasetPublishFallback("Could not publish dataset [%{error}]", {error: resp.error})));
                }
                else {
                    updateIssues();
                    if ( confirm((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.confirm.published", "The dataset has been published and is now publicly available on %{service}", {service: SELECTED_SERVICE.display_name}) : datasetPublishFallback("The dataset has been published and is now publicly available on %{service}", {service: SELECTED_SERVICE.display_name}))) ) {
                        jQuery("#dataset-archive-publish-dialog").modal("hide");
                    }
                }
            },
            error: () => {
                jQuery("#working_modal").modal("hide");
                alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.publish", "Could not publish dataset") : "Could not publish dataset"));
            }
        });
    }
}

/**
 * Reserve a DOI for the specified dataset on the specified service
 */
function getDOI(key, service) {
    if ( !SELECTED_ISSUE.article || !SELECTED_ISSUE.article.id ) {
        alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.no_article", "The selected dataset archive is not associated with an external article!") : "The selected dataset archive is not associated with an external article!"));
        return;
    }

    if ( confirm((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.confirm.reserve_doi", "Are you sure you want to reserve a DOI now?  If the external dataset is still private, the DOI will become active once it is published.  Once a DOI is active, it cannot be disabled.") : "Are you sure you want to reserve a DOI now?  If the external dataset is still private, the DOI will become active once it is published.  Once a DOI is active, it cannot be disabled.")) ) {
        jQuery("#working_modal").modal("show");
        jQuery.ajax({
            url: `/ajax/dataset/publish/issues/reserveDOI/<% $dataset_id %>/${SELECTED_ISSUE.key}`,
            success: (resp) => {
                jQuery("#working_modal").modal("hide");
                if ( resp?.error ) {
                    alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.reserve_doi_detail", "Could not reserve a DOI for this dataset [%{error}]", {error: resp.error}) : datasetPublishFallback("Could not reserve a DOI for this dataset [%{error}]", {error: resp.error})));
                }
                else {
                    updateIssues();
                    if ( confirm((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.confirm.doi_generated", "A DOI has been generated for this dataset on %{service}", {service: SELECTED_SERVICE.display_name}) : datasetPublishFallback("A DOI has been generated for this dataset on %{service}", {service: SELECTED_SERVICE.display_name}))) ) {
                        jQuery("#dataset-archive-doi-dialog").modal("hide");
                    }
                }
            },
            error: () => {
                jQuery("#working_modal").modal("hide");
                alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.error.reserve_doi", "Could not reserve a DOI for this dataset") : "Could not reserve a DOI for this dataset"));
            }
        });
    }
}

/**
 * Set main progress and message
 */
function progress({ msg, count, total, clear, bold = false } = {}) {
    if ( clear ) {
        jQuery("#dataset-archive-publish-send-pb").css("width", `0%`);
        jQuery("#dataset-archive-publish-send-status").html("");
        return;
    }

    const percent = (count/total)*100;

    jQuery("#dataset-archive-publish-send-pb").removeClass('progress-bar-danger');
    if ( percent >= 100 ) {
        jQuery("#dataset-archive-publish-send-pb").addClass('progress-bar-success');
        jQuery("#dataset-archive-publish-send-pb").removeClass('progress-bar-info');
        jQuery("#dataset-archive-publish-send-pb").removeClass('active');
    }
    else {
        jQuery("#dataset-archive-publish-send-pb").removeClass('progress-bar-success');
        jQuery("#dataset-archive-publish-send-pb").addClass('progress-bar-info');
        jQuery("#dataset-archive-publish-send-pb").addClass('active');
    }

    jQuery("#dataset-archive-publish-send-pb").css("width", `${percent}%`);
    jQuery("#dataset-archive-publish-send-status").text(msg);
}

/**
 * Set error message
 */
function fail(msg) {
    jQuery("#dataset-archive-publish-send-pb").removeClass('active');
    jQuery("#dataset-archive-publish-send-pb").removeClass('progress-bar-success');
    jQuery("#dataset-archive-publish-send-pb").removeClass('progress-bar-info');
    jQuery("#dataset-archive-publish-send-pb").addClass('progress-bar-danger');
    jQuery("#dataset-archive-publish-send-pb").css("width", `100%`);
    jQuery("#dataset-archive-publish-send-status").html(`<strong>(${datasetPublishEscapeHtml((window.SGN && SGN.i18n ? SGN.i18n.p("global.dataset_publish.upload_failed", "Upload Failed") : "Upload Failed"))}) ${datasetPublishEscapeHtml(msg)}</strong>`);
}

/**
 * Set secondary progress and message
 */
function subProgress({ msg, count, total, clear } = {}) {
    if ( clear ) {
        jQuery("#dataset-archive-publish-send-subpb").css("width", `0%`);
        jQuery("#dataset-archive-publish-send-substatus").html("");
        return;
    }

    const percent = (count/total)*100;

    jQuery("#dataset-archive-publish-send-subpb").css("width", `${percent}%`);
    jQuery("#dataset-archive-publish-send-substatus").text(msg);
}
</script>


<style>
    #dataset-archive-publish-instructions li:not(:last-child) {
        margin-bottom: 15px;
    }
    a.btn-info {
        color: #fff !important;
    }
    a.btn-info:hover {
        color: #fff;
        background-color: #31b0d5;
    }
    .dataset-archive-publish-service-name {
        font-weight: 600;
    }
    .warning-alert {
        max-width: 600px;
        display: flex;
        align-items: center;
        gap: 15px;
        margin: 15px auto;
        padding: 5px;
        border-radius: 5px;
        background: rgba(252, 211, 77, 0.5);
        border: 1px solid #d97706;
    }
    .warning-alert-icon {
        color: #B96F1A;
        font-size: 200%;
    }
</style>
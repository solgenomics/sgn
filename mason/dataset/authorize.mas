<%args>
$code => undef
</%args>

<p id="authorize-status">
% if ( defined $code ) {
    <% $c->i18n->p("lists_datasets.authorize.connecting", "Connecting account...") |h %>
% } else {
    <% $c->i18n->p("lists_datasets.authorize.no_code", "ERROR: Authorization code not returned") |h %>
% }
</p>

<script>

jQuery(document).ready(() => {
    storeConnection("<% $code %>");
});

function storeConnection(code) {
    if ( code && code !== "" && window.opener ) {
        const service = window.opener.authorize_data?.service || {};
        jQuery.ajax({
            url: `/ajax/dataset/publish/connection/`,
            method: 'POST',
            data: { code, service: service.key },
            success: (resp) => {
                if ( resp?.error ) {
                    alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.authorize.store_error_detail", "Could not store connection info [%{error}]", {error:resp.error}) : "Could not store connection info [" + resp.error + "]"));
                }
                else {
                    jQuery("#authorize-status").text((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.authorize.connected", "Accounts connected - you may close this window") : "Accounts connected - you may close this window"));
                    window.close();
                }
            },
            error: () => {
                alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.authorize.store_error", "Could not store connection info") : "Could not store connection info"));
            }
        });
    }
}

</script>
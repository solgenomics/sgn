<%doc>

=head1 NAME

/ontology/browser.mas - a mason component that displays an ontology browser

=head1 DESCRITPION

The ontology browser is relying on JavaScript and uses AJAX requests to pull in the data. The AJAX requests are handled by a Catalyst controller SGN::Controller::AJAX::Onto. The JavaScript code is in js/CXGN/Tools/Onto.js.

The ontologies displayed are the CVs marked visible in the cvprop table (see
CXGN::Onto->onto_root_namespaces()); visibility is managed on the Manage
Ontologies page.

=head1 AUTHOR

Lukas Mueller <lam87@cornell.edu>

=cut

</%doc>

<%args>
    # cv_ids whose root terms are shown, separated by commas and/or whitespace
    # (optional; default is every visible cv). Hidden cvs are always left out.
    $cv_ids => undef
    # cv_ids to restrict the text search to (optional; default shows a
    # drop-down of all visible cvs)
    $search_cv_ids => undef
    $expand => undef
    # if true, the browser markup is rendered but not initialized; the page
    # must create the global o itself (e.g. o.initializeBrowserWithRoots(...))
    $defer_init => 0
</%args>
<& /util/import_javascript.mas,
    classes => [
        'MochiKit.DOM',
        'MochiKit.Visual',
        'MochiKit.Async',
        'Prototype',
        'MochiKit.Logging',
        'CXGN.Onto.Browser',
        'CXGN.Page.FormattingHelpers',
        'jquery',
     ]
&>

<%init>
    # only digits and separators reach the inline javascript below
    $_ = join(',', grep { length } split /[^0-9]+/, ($_ // '')) for ($cv_ids, $search_cv_ids);
</%init>

<table title="ontology browser input form" cellpadding="0" summary="" border="0"><tr><td><div id="ontology_browser_input" >&nbsp;&nbsp;&nbsp;</div></td></tr>
<tr><td><div id="ontology_term_input" >loading...</div></td></tr></table>
<input id="hide_link" type="button" value="show results" display="none" onClick="MochiKit.Visual.toggle('search_results', 'blind'); o.toggleSearchResultsVisible(); o.setSearchButtonText();  "><br />

<div id="search_results" ></div>
<div id="ontology_browser" style="font-size:12px; line-height:10px; font-face:arial,helvetica" >&nbsp;</div>


<script language="javascript" type="text/javascript" defer="defer" >

var o;

% if (!$defer_init) {
jQuery(document).ready( function() { 
  o = new CXGN.Onto.Browser();
//  o.setUpBrowser();
  o.initializeBrowser('<% $cv_ids %>');
  o.renderSearchById();
  o.renderSearchByName('<% $search_cv_ids %>');
  var rn = o.rootnode.getChildren();   
  var expand = "<% $expand %>";
  if (expand == 1) {
    for (var i=0; i<rn.length; i++) {
      rn[i].openNode(1);
    }
  }
  o.render();
});
% }


</script>

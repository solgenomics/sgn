      <div id="gen_select_div"></div><br>
      <button class="btn btn-default btn-sm" id="gen_select_all" name="gen_select_all"/><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
      <button class="btn btn-default btn-sm" id="gen_select_clear" name="gen_select_clear"/><% $c->i18n->p("global.search_wizard.clear", "Clear") |h %></button>
    </div>
    <div id="evt_div" class="col-md-6" style="display: none;">
      <label for="evt_select_div" class="control-label"><% $c->i18n->p("seedlot_overdue.ui.event", "Event") |h %></label>
      <p class="help-block"><small><i><% $c->i18n->p("accession.stock.optional", "Optional") |h %></i> <% $c->i18n->p("phenotype.root.pick_the_breeding_event_to_which_you_selected_time_term", "Pick the breeding event to which you selected time term relates.") |h %></small></p>
      <div id="evt_select_div"></div><br>
      <button class="btn btn-default btn-sm" id="evt_select_all" name="evt_select_all"/><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
      <button class="btn btn-default btn-sm" id="evt_select_clear" name="evt_select_clear"/><% $c->i18n->p("global.search_wizard.clear", "Clear") |h %></button>
    </div>

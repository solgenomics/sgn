
<%args>
$object_select => undef
$attribute_select => undef
$method_select => undef
$unit_select => undef
$trait_select => undef
$meta_select => undef

$composable_cvs => undef
$composable_cvs_allowed_combinations => undef
$composable_tod_root_cvterm => undef
$composable_toy_root_cvterm => undef
$composable_tiy_root_cvterm => undef
$composable_gen_root_cvterm => undef
$composable_evt_root_cvterm => undef
$composable_meta_root_cvterm => undef
</%args>

<& /util/import_javascript.mas, classes => ['CXGN.BreederSearch', 'CXGN.ComposeTrait'] &>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("phenotype.root.compose_a_new_trait", "Compose a new trait")) &>
</br>

<div class="panel panel-default">
    <div class="panel-heading" data-toggle="collapse" data-parent="#accordion" data-target="#collapse0">
        <div class="panel-title"><a href="#form" class="accordion-toggle"><% $c->i18n->p("phenotype.root.trait_combinations", "Trait Combinations") |h %></a><span class="pull-right clickable" onmouseover="" style="cursor: pointer;"><i class="glyphicon glyphicon-chevron-up"></i></span></div>
    </div>
    <div id="collapse0" class="panel-collapse collapse in">
        <div class="panel-body form-horizontal container-fluid" style="overflow:hidden">
            <div class="col-sm-12 col-md-12 col-lg-12">
                <div id="cv_combination_allowed_select_div">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="panel panel-default">
  <div class="panel-heading" data-toggle="collapse" data-parent="#accordion" data-target="#collapse1">
    <div class="panel-title"><a href="#form" class="accordion-toggle"><% $c->i18n->p("phenotype.root.base_trait", "Base Trait") |h %></a><span class="pull-right clickable" onmouseover="" style="cursor: pointer;"><i class="glyphicon glyphicon-chevron-up"></i></span></div>
  </div>
  <div id="collapse1" class="panel-collapse collapse in">
    <div class="panel-body form-horizontal container-fluid" style="overflow:hidden">
        <div class="col-sm-12 col-md-12 col-lg-12">
        <div id="object_div" class="col-md-6" style="display: none;">
            <label for="object_select_div" class="control-label"><% $c->i18n->p("shared.form.object", "Object") |h %></label>
            <p class="help-block"><small><% $c->i18n->p("phenotype.root.pick_the_object_on_which_the_new_trait_is_measured", "Pick the object on which the new trait is measured") |h %></small></p>
            <div id="object_select_div"></div><br>
            <button class="btn btn-default btn-sm" id="object_select_all" name="object_select_all"/><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
            <button class="btn btn-default btn-sm" id="object_select_clear" name="object_select_clear"/><% $c->i18n->p("global.search_wizard.clear", "Clear") |h %></button>
        </div>
        <div id="attribute_div" class="col-md-6" style="display: none;">
            <label for="attribute_select_div" class="control-label"><% $c->i18n->p("trial.card.design.header.attribute", "Attribute") |h %></label>
            <p class="help-block"><small><% $c->i18n->p("phenotype.root.pick_the_attribute_the_new_trait_measures", "Pick the attribute the new trait measures") |h %></small></p>
            <div id="attribute_select_div"></div><br>
            <button class="btn btn-default btn-sm" id="attribute_select_all" name="attribute_select_all"/><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
            <button class="btn btn-default btn-sm" id="attribute_select_clear" name="attribute_select_clear"/><% $c->i18n->p("global.search_wizard.clear", "Clear") |h %></button>
        </div>

        <div id="method_div" class="col-md-6" style="display: none;">
            <label for="method_select_div" class="control-label"><% $c->i18n->p("phenotype.root.method", "Method") |h %></label>
            <p class="help-block"><small><% $c->i18n->p("phenotype.root.pick_the_method_by_which_the_new_trait_is_measured", "Pick the method by which the new trait is measured") |h %></small></p>
            <div id="method_select_div"></div><br>
            <button class="btn btn-default btn-sm" id="method_select_all" name="method_select_all"/><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
            <button class="btn btn-default btn-sm" id="method_select_clear" name="method_select_clear"/><% $c->i18n->p("global.search_wizard.clear", "Clear") |h %></button>
        </div>
        <div id="unit_div" class="col-md-6" style="display: none;">
            <label for="unit_select_div" class="control-label"><% $c->i18n->p("phenotype.root.unit", "Unit") |h %></label>
            <p class="help-block"><small><% $c->i18n->p("phenotype.root.pick_the_units_in_which_the_new_trait_is_measured", "Pick the units in which the new trait is measured") |h %></small></p>
            <div id="unit_select_div"></div><br>
            <button class="btn btn-default btn-sm" id="unit_select_all" name="unit_select_all"/><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
            <button class="btn btn-default btn-sm" id="unit_select_clear" name="unit_select_clear"/><% $c->i18n->p("global.search_wizard.clear", "Clear") |h %></button>
        </div>

        <div id="trait_div" class="col-md-6" style="display: none;">
            <label for="trait_select_div" class="control-label"><% $c->i18n->p("accession.stock.phenotype.header.trait", "Trait") |h %></label>
            <p class="help-block"><small><% $c->i18n->p("phenotype.root.pick_an_existing_trait", "Pick an existing trait") |h %></small></p>
            <input type="text" id="trait_search" class="form-control input-sm" placeholder="<% $c->i18n->p("phenotype.root.search_traits", "Search traits...") |h %>">
            <div id="trait_select_div"></div><br>
            <button class="btn btn-default btn-sm" id="trait_select_all" name="trait_select_all"/><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
            <button class="btn btn-default btn-sm" id="trait_select_clear" name="trait_select_clear"/><% $c->i18n->p("global.search_wizard.clear", "Clear") |h %></button>
        </div>

        <div id="meta_div" class="col-md-6" style="display: none;">
            <label for="meta_select_div" class="control-label"><% $c->i18n->p("global.search_wizard.metadata", "Metadata") |h %></label>
            <p class="help-block"><small><% $c->i18n->p("phenotype.root.pick_a_metadata_property", "Pick a metadata property") |h %></small></p>
            <div id="meta_select_div"></div><br>
            <button class="btn btn-default btn-sm" id="meta_select_all" name="meta_select_all"/><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
            <button class="btn btn-default btn-sm" id="meta_select_clear" name="meta_select_clear"/><% $c->i18n->p("global.search_wizard.clear", "Clear") |h %></button>
        </div>
        </div>
</div>
</div>
</div>


      <button class="btn btn-default btn-sm" id="tiy_select_all" name="tiy_select_all"/><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
      <button class="btn btn-default btn-sm" id="tiy_select_clear" name="tiy_select_clear"/><% $c->i18n->p("global.search_wizard.clear", "Clear") |h %></button>
    </div>
    <div id="gen_div" class="col-md-6" style="display: none;">
      <label for="gen_select_div" class="control-label"><% $c->i18n->p("phenotype.root.generation", "Generation") |h %></label>

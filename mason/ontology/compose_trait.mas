      <input type="text" id="toy_search" class="form-control input-sm" placeholder="<% $c->i18n->p("phenotype.root.search_minute_hour_day_week_month", "Search minute, hour, day, week, month...") |h %>">
      <div id="toy_select_div"></div><br>

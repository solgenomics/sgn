      <label for="tiy_select_div" class="control-label"><% $c->i18n->p("phenotype.root.time_in_years", "Time in Years") |h %></label>
      <p class="help-block"><small><i><% $c->i18n->p("accession.stock.optional", "Optional") |h %></i> <% $c->i18n->p("phenotype.root.pick_the_year_in_which_the_new_trait_is_measured", "Pick the year in which the new trait is measured") |h %></small></p>
      <input type="text" id="tiy_search" class="form-control input-sm" placeholder="<% $c->i18n->p("phenotype.root.search_year", "Search year...") |h %>">

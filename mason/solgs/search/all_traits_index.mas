<%doc>
A subset of GS traits list.
</%doc>

<%args>

$index
$traits_list

</%args>

<& /page/page_title.mas, 
   title=>HTML::Entities::encode_entities($c->i18n->p("solgs.interface.list_of_traits_with_gs_data", "List of traits with GS data"))
&>

<&| /page/info_section.mas, anchor_title => qq |Traits beginning with "$index" |,
   title    => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.traits_beginning_with_index", "Traits beginning with \"%{index}\" ", {index => "" . ($index // "")}))
&>

<&/page/columnar_table.mas,
   data         => $traits_list,
  __align       => 'l',
  __alt_freq    => 2,
  __alt_width   => 1,
  __cellpadding => 20,
 &>

</&>

<%once>
use HTML::Entities ();
</%once>

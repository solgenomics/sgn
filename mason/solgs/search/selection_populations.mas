<%doc>

displays selection populations one can apply the model on.  If predicted output exists for a
selection population, a link to the output is displayed.

</%doc>

<%args>

$result => ''
$selection_prediction_download
$training_pop_analyzed_traits
$training_pop_id
$training_pop_name
$selection_pop_id
$selection_pop_name => ''
$list_of_prediction_pops => ''
$selection_pop_analyzed_traits => ''

</%args>

<%perl>

my $title;
my $title_anchor;

if ($c->req->path =~ /solgs\/traits\/all\/population/) {
    $title = $c->i18n->p("solgs.interface.predict_gebvs_of_a_selection_population_using_the_models", "Predict GEBVs of a selection population using the models");
 $title_anchor = 'Predict GEBVs of a selection population using the models';
  } else {
 $title = $c->i18n->p("solgs.interface.predict_gebvs_of_a_selection_population_using_the_model", "Predict GEBVs of a selection population using the model");
 $title_anchor = 'Predict GEBVs of a selection population using the model';
}

</%perl>


<& /util/import_javascript.mas, classes => ["solGS.solGS", "solGS.Dataset", "jquery.dataTables", "solGS.selectionPopulations",  "solGS.ajaxAutocomplete"] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<&| /page/info_section.mas,
    collapsible => 1,
    collapsed   => 0,
    anchor_title => $title_anchor, title       => $title,
&>

  <div  id="selection_pops_div">
    <div id="search_div" class="form-inline">
    <input  type="text"
	    class="form-control"
	    placeholder="<% $c->i18n->p("solgs.interface.search_for_a_trial", "search for a trial") |h %>"
	    size="30" id="trial_search_box"/>

    <button type="submit"
	    class="btn btn-success"
	    id="search_selection_pop">
      <span class="glyphicon glyphicon-search"></span>
    </button>
    <div  id="form-feedback-search-trials" style="color:red"> </div>
  </div>

  <div id="selection_pops_message"  class="message"></div>
  <& /solgs/spinner/spinner.mas &>
  
  <div id="selection_pops_result" style="padding: 20px 0px 20px 0px;display:none;">
    <table class="table" id="selection_pops_table" style="text-align:left;">
      <thead>
	<tr>
	  <th><% $c->i18n->p("solgs.interface.selection_population", "Selection population") |h %></th>
	  <th><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></th>
	  <th><% $c->i18n->p("global.trial_table.year", "Year") |h %></th>
	  <th><% $c->i18n->p("solgs.interface.more_details", "More details") |h %></th>
	  <th><% $c->i18n->p("solgs.interface.view_gebvs", "View GEBVs") |h %></th>
	</tr>
      </thead>
  </table>
  </div>

  <& /solgs/search/list_type_selection_population.mas &>
</div>
</&>

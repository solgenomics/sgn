<%doc>

solGS search results view.

</%doc>

<%args>

$result
$form

</%args>

<& /page/page_title.mas,
    title => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.solgs_search_results", "solGS search results")),
&>
  
% if ($result) 
% { 

<&| /page/info_section.mas, anchor_title => "Search", anchor_title => "No Search Results", anchor_title => "Search Results",
      title => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.search_results", "Search Results")),
&>

<& /page/columnar_table.mas,
     headings    => [ $c->i18n->p("solgs.interface.population", "Population"), $c->i18n->p("solgs.interface.location", "Location"), $c->i18n->p("solgs.interface.year", "Year"), 'PI' ],
     data        => $result,
    __alt_freq   => 2,
    __alt_width  => 1,
    __align      => 'l'
 &>
</&>

%}
%else
%{
<&| /page/info_section.mas, anchor_title => 'No Search Results',
      title => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.no_search_results", "No Search Results")),
&>

<br><% $c->i18n->p("solgs.interface.no_results_search_again_with_a_different_term", "No results. Search again with a different term.") |h %><br />

</&>

%}

<&| /page/info_section.mas, anchor_title => 'Search',
    title       => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.search", "Search")),
    collapsible => '1',
    collapsed   =>  1
&>

<& /search/solgs.mas, form => $form &>

</&>

<%once>
use HTML::Entities ();
</%once>

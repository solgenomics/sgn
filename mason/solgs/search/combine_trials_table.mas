<%doc>

=head1 NAME

/search/combine_trials_table.mas - a table with trials to combine

=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

</%args>

<%perl>
	my $combine_button;
	if ($c->req->path =~ /solgs\/search\/trials\/trait/) {
		$combine_button = $c->i18n->p("solgs.interface.combine_trials_build_model", "Combine trials & build model");
	} else {
		$combine_button = $c->i18n->p("solgs.interface.combine_trials", "Combine trials");
	}


</%perl>

<div id="selected_trials" style="display:none;width:100%">

 <p class="message"> <% $c->i18n->p("solgs.interface.selected_trials", "Selected trials") |h %> </p>

<table class ="table" id="selected_trials_table" style="text-align:left;width:100%">
<tr>
  <th></th>
  <th><% $c->i18n->p("global.index_logged_in_user.trial", "Trial") |h %></th>
  <th><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></th>
  <th><% $c->i18n->p("solgs.interface.location", "Location") |h %></th>
  <th><% $c->i18n->p("global.trial_table.year", "Year") |h %></th>
  <th><% $c->i18n->p("solgs.interface.more_details", "More details") |h %></th>
</tr>
<tr>
</tr>
</table>
</div>


<table class="table" id="selected_trials_header" style="text-align:left;width:100%">
<tr>
  <td>
    <div id="combine_trials_div" style="display:none">
      <input  class="button" type="button" id="combine_trait_trials" value="<% $combine_button %>"/>
  </div>
  </td>
  <td>
    <div id="search_again_div" style="display:none;text-align:right">
    <input style class="button" type="button" id="search_again" value="<% $c->i18n->p("global.gem_experiment_search.search_again", "Search again") |h %>"/>
  </div>
 </td>
</tr>
</table>

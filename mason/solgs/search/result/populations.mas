<%once>
use HTML::Entities ();
</%once>

<%doc>

displays list of GS populations evaluated for a trait.

</%doc>

<%args>

$result
$form
$pager
$page_links
$query
$trait_id
$trait_name

</%args>

<& /util/import_javascript.mas, classes => ["solGS.solGS"] &>

<& /util/import_css.mas, paths => ['/static/css/solgs/solgs.css'] &>

<& /page/page_title.mas,
    title => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.gs_populations_evaluated_for_query", "GS populations evaluated for %{query}", {query => "" . ($query // "")})) ,
&>
  
% if ($result) 
% { 

<&| /page/info_section.mas, anchor_title => "Create a training population using individuals from one or more trials to fit a prediction model for $trait_name",
      title => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.create_a_training_population_using_individuals_from_one_or_more", "Create a training population using individuals from one or more trials to fit a prediction model for %{trait_name}", {trait_name => "" . ($trait_name // "")})),
&>



<& /solgs/search/result/confirm/populations_list.mas,
   result     => $result,
   pager      => $pager,
   page_links => $page_links
&>

<div id="trait_id">
  <input type="hidden" name="trait_id" value="<% $trait_id %>" />
</div>

% if (scalar(@$result) > 1) 
% {

<div id="select_done">
  <input  class="button" type="button" value="<% $c->i18n->p("global.select", "Select") |h %>" onclick="selectedPops();"/>
</div>

%}

</&>

%}
%else
%{
<&| /page/info_section.mas, anchor_title => 'No Search Results',
      title => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.no_search_results", 'No Search Results')),
&>

%if ( $query )
%{
<br><% $c->i18n->p("analysis.qtl.ui.no_results_found_for", "No results found for") |h %> <i><strong>'<% $query %>'.</strong></i><br />
%}
%else
%{
<br><% $c->i18n->p("solgs.interface.no_results_search_again_with_a_trait_name", "No results. Search again with a trait name.") |h %><br />
%}
</&>
%}

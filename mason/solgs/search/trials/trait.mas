<%once>
use HTML::Entities ();
</%once>

<%doc>

=head1 NAME

/search/solgs.mas - a view for solgs search form - startpage for GEBV prediction model building

=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$trait_id
$trait_name

</%args>

<%perl>

</%perl>

<& /util/import_css.mas, paths => ['/static/css/solgs/solgs.css'] &>



<& /util/import_javascript.mas, classes => ["solGS.solGS", "solGS.searchTrials", "solGS.combineTrials"] &>

<p>&nbsp</p>

<& /page/page_title.mas,
    title => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.gs_populations_evaluated_for_trait_name", "GS populations evaluated for %{trait_name}", {trait_name => "" . ($trait_name // "")})) ,
&>

 <& /solgs/genotyping_protocol/index.mas &>

<&| /page/info_section.mas, anchor_title => "Select a training population or create a new one using one or more trials",
    collapsible => 1,
    collapsed   => 0,
    title       => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.select_a_training_population_or_create_a_new_one_using", "Select a training population or create a new one using one or more trials")),
&>

  <& /solgs/search/trials_search_result.mas &>
  <& /solgs/search/combine_trials_table.mas &>

</&>

<div id="trait_detail">
  <input type="hidden" name="trait_id" value="<% $trait_id %>" />
  <input type="hidden" name="trait_name" value="<% $trait_name %>" />
</div>

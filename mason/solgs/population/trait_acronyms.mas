<%doc>

=head1 NAME

/solgs/population/acronym.mas -- displays a list of traits and their acronyms.

=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$trial_id => undef;
$training_pop_id => undef;

</%args>

<%perl>
</%perl>


<& /util/import_javascript.mas, classes => ["solGS.loadAcronyms", "jquery.dataTables"] &>

<&| /page/info_section.mas, anchor_title => "Acronyms legend",
    collapsible => 1,
    collapsed   => 1,
    title       => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.acronyms_legend", "Acronyms legend")),
  &>

  
  <div id="trait_acronyms_div" style="display:none">
    <div id="acronyms_message"  class="message"></div>

      <table class="table" id="trait_acronyms_table" style="text-align: left;">
        <thead>
          <tr>
<% "        \t" %><th><% $c->i18n->p("solgs.interface.acronym", "Acronym") |h %></th>
            <th><% $c->i18n->p("solgs.interface.trait", "Trait") |h %></th>
          </tr>
        </thead>
      </table>

      <input type="hidden" id="trial_id" value="<% $trial_id %>" />

</div>



</&>

<%once>
use HTML::Entities ();
</%once>

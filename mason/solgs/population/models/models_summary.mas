<%once>
use HTML::Entities ();
</%once>

<%doc>

=head1 NAME

/solgs/population/models/model_summary.mas - displays multiple traits GS analysis output and links to traits' GS detailed output pages

=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$model_data

</%args>

<%perl>

</%perl>

<&| /page/info_section.mas, anchor_title => "Models summary",
    collapsible => 1,
    collapsed   => 0,
    title       => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.models_summary", "Models summary"))
&>

<table id="model_summary" style="width:95%">
  <tr>
    <th><% $c->i18n->p("solgs.interface.training_population", "Training population") |h %></th>
    <th><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></th>
    <th><% $c->i18n->p("solgs.interface.models", "Models") |h %></th>
  </tr>

% foreach my $model (@$model_data)
%{
%
  <tr style="background-color:#ccccff">
    <td>
   <%  $model->[0] %>
    </td>
    <td>
   <%  $model->[1] %>
    </td>
    <td>
      <& /page/columnar_table.mas,
         headings    => [HTML::Entities::encode_entities($c->i18n->p("accession.population_cgi.trait", "Trait")), HTML::Entities::encode_entities($c->i18n->p("solgs.interface.model_accuracy", "Model accuracy")), HTML::Entities::encode_entities($c->i18n->p("solgs.interface.additive_variance", "Additive variance")),  HTML::Entities::encode_entities($c->i18n->p("solgs.interface.snp_heritability", "SNP heritability"))],
         data        => $model->[2],
        __alt_freq   => 1,
        __align      => "l",
        __tableattrs => 'style="padding: 1px"',
      &>
    </td>
  </tr>

%}

</table>

</&>

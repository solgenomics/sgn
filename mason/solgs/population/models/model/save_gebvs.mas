<%doc>

=head1 NAME

/solgs/model/save_gebvs.mas - save gebvs

=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

</%args>


 <& /util/import_javascript.mas, classes => ["solGS.analysisSave", "solGS.gebvsSave"] &>
 <div id="gebvs_output" class="mb-2">
<% " \t" %><button id="save_gebvs" class="btn btn-success"><% $c->i18n->p("solgs.interface.save_gebvs", "Save GEBVs") |h %></button>
    <button id="save_genetic_values" class="btn btn-success"><% $c->i18n->p("solgs.interface.save_genetic_values", "Save genetic values") |h %></button><% "\t" %>
    <input type="hidden" id="analysis_result_save_type" value="gebvs" />
    <div id="gebvs_save_message" class="message"" style="display:none"></div>
    <& /solgs/spinner/spinner.mas &>
</div>

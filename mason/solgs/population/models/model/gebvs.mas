<%doc>

=head1 NAME

/solgs/population/models/model/gebvs.mas - displays a plot of the gebvs and download links.
=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

</%args>

<& /solgs/tools/base.mas &>
<& /util/import_javascript.mas, classes => [  "solGS.gebvs", "solGS.histogram"] &>

<&|  /page/info_section.mas, anchor_title => "Genomic estimated breeding values (GEBVs) - GBLUP method",
  collapsible => 1,
  collapsed   => 0,
  title     => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.genomic_estimated_breeding_values_gebvs_gblup_method", "Genomic estimated breeding values (GEBVs) - GBLUP method"))
&>

<div id="gebvs">
    <div id="gebvs_histo_canvas"></div>
    <& save_gebvs.mas &>
</div>

</&>

<%once>
use HTML::Entities ();
</%once>

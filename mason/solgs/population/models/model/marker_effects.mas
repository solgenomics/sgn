<%doc>

=head1 NAME
 
/model/marker_effcts.mas - displays top marker effects and data download link

=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$top_marker_effects

</%args>


<&| /page/info_section.mas, anchor_title => "Marker effects",
  collapsible => 1, 
  collapsed   => 1, 
  title       => HTML::Entities::encode_entities($c->i18n->p("solgs.interface.marker_effects", "Marker effects"))
&>
 
<i><% $c->i18n->p("solgs.interface.top_10_markers", "Top 10 markers") |h %></i>:

<& /page/columnar_table.mas,
  headings     => [$c->i18n->p("solgs.interface.marker", "Marker"), $c->i18n->p("solgs.interface.effects", "Effects")],
  data         => $top_marker_effects,
  __alt_freq   => 2,
  __alt_width  => 1,
  __alt_offset => 3,
  __align      => 'll',
&>

<div id="marker_effects_download"></div>
<div id="marker_effcts_download_message"  class="message"></div>
</&>

<%once>
use HTML::Entities ();
</%once>

<%once>
use HTML::Entities ();
</%once>

<%doc>

=head1 NAME

/solgs/genotyping_protocol/index.mas - genotyping protocol selection template



=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%perl>

my $url = $c->req->path;
my $geno_msg = ("<p>" . HTML::Entities::encode_entities($c->i18n->p("solgs.interface.this_database_has_no_genotype_data_or_you_have_not", "This database has no genotype data or you have not selected a genotyping protocol.")) . " ");
my $geno_msg_part = $c->i18n->p("solgs.interface.either_load_genotype_data_to_the_database_and_try_again", "either load genotype data to the database and try again or select a genotyping protocol (from above).");
if ($url =~ /solgs/) {
  $geno_msg = ("$geno_msg " . HTML::Entities::encode_entities($c->i18n->p("solgs.interface.therefore_solgs_does_not_function_in_this_website", "Therefore, solGS does not function in this website.")) . "</p>\n  <p>" . HTML::Entities::encode_entities($c->i18n->p("solgs.interface.please", "Please")) . " $geno_msg_part</p>");
} else {
  $geno_msg = ("$geno_msg  " . HTML::Entities::encode_entities($c->i18n->p("solgs.interface.therefore_this_tool_does_not_function_on_genotype_data_in", "Therefore, this tool does not function on genotype data in this website.")) . "</p>\n  <p>" . HTML::Entities::encode_entities($c->i18n->p("solgs.interface.if_you_intend_to_use_the_tool_on_genotype_data", "If you intend to use the tool on genotype data, please")) . " $geno_msg_part</p>");
}

</%perl>

<& /util/import_javascript.mas, classes => ['solGS.genotypingProtocol'] &>

<div id="genotyping_protocols_canvas">
  <div id="genotyping_protocols_message" class="message" style="display:none;"><% $c->i18n->p("solgs.interface.retrieving_genotyping_protocols_please_wait", "Retrieving genotyping protocols...please wait...") |h %></div>
    <div id="genotyping_protocols_progress">
      <& /solgs/spinner/spinner.mas &>
    </div>
  </div>

<div  class='row text-center'
       id='genotyping_protocol'
       style='margin:40px 0 40px 0;display:none'>
    <div>
      <button class='btn btn-light'
	      type='button'
	      id='genotyping_protocol_message'><% $c->i18n->p("solgs.interface.retrieving_genotyping_protocols", "Retrieving genotyping protocols...") |h %>
      </button>
      <button class='btn btn-success'
	      type='button'
	      id='genotyping_protocols_change'><% $c->i18n->p("solgs.interface.change", "Change") |h %>
      </button>
    </div>
    <div id='genotyping_protocols_list_div' style='text-align:center;width:40%;display:none;margin:0 auto;'>
      <select class='form-control text-center'
	      id='genotyping_protocols_list_select'>
      </select>
    </div>

   <input type='hidden'
	   id='genotyping_protocol_id'
	   value=''/>
</div>

<div class="row" style="margin-top:10px;margin-bottom:10px">
	<div  id="genotype_missing_message"  class="col-md-6 col-md-offset-3  bg-danger" style="padding-top:10px;padding-bottom:10px;display:none">
  	<% $geno_msg %>
  </div>
</div>


<%once>
use HTML::Entities ();
</%once>


<%args>  
$tool_url => $tool_url
$analysis_type => $analysis_type
</%args>

<%perl>

my $login_msg = $c->i18n->p("solgs.interface.to_view_your_datasets_and_use_this_tool", "To view your datasets and use this tool ") .
("" . HTML::Entities::encode_entities($c->i18n->p("solgs.interface.you_need_to", "you need to")) . " <a href=\"/user/login?goto_url=$tool_url\">" . HTML::Entities::encode_entities($c->i18n->p("solgs.interface.login", "login")) . "</a>.");

</%perl>


% if ($c->user) {
    <& /solgs/tools/datatable_display.mas,
    analysis_type => $analysis_type &>
%} else {
    <div class="row">
    <div class="col-md-8 col-md-offset-2">
    <& /generic_message.mas, message => $login_msg &>
    </div>
    </div>
%}
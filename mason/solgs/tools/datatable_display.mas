<%doc>

=head1 NAME

/solgs/tools/datatable_display.mas -  displays datasets or lists of trials or plots or accessions with phenotype data or genotype data

=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>
$analysis_type => $analysis_type
$wizard_link_txt => undef
$breeder_search_params =>''
</%args>
<%perl>
my $label = $analysis_type =~ s/_/ /gr;
my $analysis_abbr = $analysis_type =~ /correlation/ ? 'corr' : $analysis_type;
$wizard_link_txt = 'Create a new list or dataset' if !$wizard_link_txt;
</%perl>

<& /util/import_javascript.mas, classes => [ "solGS.Dataset", "CXGN.List", "solGS.dataTableTabs"] &>

<div id="lists_datasets_canvas">

    <div id="lists_datasets_message" class="message" style="display:none;">Retrieving lists and datasets...please wait...it may take minutes.
    </div>
    <div id="lists_datasets_progress">
    <& /solgs/spinner/spinner.mas &>
    </div>

<ul class="nav nav-tabs" id="<% $analysis_abbr %>_population_tabs" style="margin-top:25px">
    <li class="active"><a class="population-tab" data-target="#<% $analysis_abbr %>_private_datasets" data-source="dataset" data-ownership="private">Private datasets</a></li>
    <li><a class="population-tab" data-target="#<% $analysis_abbr %>_public_datasets" data-source="dataset" data-ownership="public">Public datasets</a></li>
    <li><a class="population-tab" data-target="#<% $analysis_abbr %>_private_lists" data-source="list" data-ownership="private">Private lists</a></li>
    <li><a class="population-tab" data-target="#<% $analysis_abbr %>_public_lists" data-source="list" data-ownership="public">Public lists</a></li>
</ul>

<div class="tab-content sub_infosectioncontent" id="<% $analysis_abbr %>_pops_data_div">
    <div class="tab-pane active" id="<% $analysis_abbr %>_private_datasets" style="display:block"></div>
    <div class="tab-pane" id="<% $analysis_abbr %>_public_datasets" style="display:none"></div>
    <div class="tab-pane" id="<% $analysis_abbr %>_private_lists" style="display:none"></div>
    <div class="tab-pane" id="<% $analysis_abbr %>_public_lists" style="display:none"></div>
</div>
<br>

<div id="create_new_list_dataset" class="pull-right margin-bottom-lg" style="display:none;">
    <a type="button" class="btn btn-success" href="/solgs/breeder_search/<% $breeder_search_params %>" style="color:#ffffff"><%
    $wizard_link_txt %></a>
</div>

</div>

<%args>
    $deny_url
    $authorize_url
    $user_name
    $client_id
    $database_name
</%args>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("integrations.consent.title", "BrAPI Client Authorization")) &>

<!-- <div class="row">
    <div class="col-lg-12">
        <p>To tie Field Book to your account on Breedbase, open Field Book and go to Settings -> External Data Source and scan the below QR code</p>
    </div>
</div>
<div class="row">
    <img class="col-md-2 col-md-offset-5" src="/user/field-book/generate">
</div> -->

<div class="row center">
    <p><% $c->i18n->p("integrations.consent.hello", "Hello ") |h %><b><% $user_name |h %></b>!</p>
    <p><b><% $client_id |h %></b><% $c->i18n->p("integrations.consent.access_request", " would like to access ") |h %><b><% $database_name |h %></b><% $c->i18n->p("integrations.consent.explanation", " through your account. Use the buttons below to authorize or deny this request.") |h %></p><br>
    <a class="btn btn-success" href="<% $authorize_url |h %>"><% $c->i18n->p("integrations.consent.authorize", "Authorize Access") |h %></a>
    <a class="btn btn-danger" href="<% $deny_url |h %>"><% $c->i18n->p("integrations.consent.deny", "Deny Access") |h %></a>
</div>

<%once>
use HTML::Entities ();
</%once>

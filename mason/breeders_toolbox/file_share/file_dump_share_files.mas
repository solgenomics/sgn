<%args>
</%args>

<table class="table table-bordered table-hover" id="manage_file_share_dump_table">
    <thead>
        <tr>
            <th><% $c->i18n->p('global.file_dump_share_files.file_name', 'File Name') |h %></th>
            <th><% $c->i18n->p('global.file_dump_share_files.user_name', 'User Name') |h %></th>
            <th><% $c->i18n->p('global.file_dump_share_files.date', 'Date') |h %></th>
            <th><% $c->i18n->p('global.file_dump_share_files.options', 'Options') |h %></th>
        </tr>
    </thead>
</table>

<script>
jQuery(document).ready(function(){
    jQuery('#manage_file_share_dump_table').DataTable({
        'lengthMenu': [10,20,50,100,1000,5000],
        'ajax': { 'url':  '/ajax/filesharedump/list' }
    });
});
</script>

<& /util/import_javascript.mas, classes => [ 'bootstrap_min.js', 'jquery.iframe-post-form','CXGN.List', 'CXGN.BreedersToolbox.AddTrial','CXGN.BreedersToolbox.UploadTrial','CXGN.BreedersToolbox.Trial', 'CXGN.Trial','CXGN.BreedersToolbox.GenotypingTrial','CXGN.BreedersToolbox.Accessions', 'CXGN.BreedersToolbox.UploadPedigrees','CXGN.BreedersToolbox.Crosses','CXGN.BreedersToolbox.FieldBook','CXGN.BreedersToolbox.UploadPhenotype', 'CXGN.BreederSearch', 'CXGN.Trial','CXGN.TrialTreeFolders' ] &>

<& /page/page_title.mas, title=>"Manage Ontologies" &>

<style>
    #manage_ontologies_tabs > li > a {
        background-color: #e6e6e6;
        color: #333;
    }
    #manage_ontologies_tabs > li > a:hover {
        background-color: #d4d4d4;
    }
    #manage_ontologies_tabs > li.active > a,
    #manage_ontologies_tabs > li.active > a:hover,
    #manage_ontologies_tabs > li.active > a:focus {
        background-color: #337ab7;
        color: #fff;
    }

    /* Compact stacked pills for the ontology list */
    #manage_ontologies_db_list > li > a {
        padding: 4px 10px;
    }
    #manage_ontologies_db_list > li + li {
        margin-top: 1px;
    }

    /* CV property table in the bottom-right pane */
    #manage_ontologies_cv_table td {
        vertical-align: middle;
    }

    /* Resizable split layout for the Manage tab */
    .mo-split {
        display: flex;
        height: 70vh;
        min-height: 400px;
        border: 1px solid #ccc;
    }
    .mo-right {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }
    .mo-pane {
        overflow: auto;
        padding: 10px;
        flex: 0 0 auto;
        min-width: 0;
        min-height: 0;
    }
    .mo-pane-fill {
        flex: 1 1 auto;
    }
    .mo-gutter {
        flex: 0 0 auto;
        background-color: #e6e6e6;
    }
    .mo-gutter:hover, .mo-gutter.mo-dragging {
        background-color: #bbb;
    }
    .mo-gutter-v {
        width: 6px;
        cursor: col-resize;
    }
    .mo-gutter-h {
        height: 6px;
        cursor: row-resize;
    }
</style>

<script>
jQuery(function() {
    // The ontology browser loads Prototype.js, which adds hide()/show() to every DOM element.
    // jQuery calls those as the default action of Bootstrap's 'hide.bs.*'/'show.bs.*' events,
    // which would hide the Manage/Upload tabs and navbar dropdowns. Shadow them for the
    // duration of each Bootstrap event so jQuery has nothing to call.
    if (typeof Prototype !== 'undefined' && Prototype.BrowserFeatures.ElementExtensions) {
        ['hide', 'show'].forEach(function(method) {
            ['collapse', 'dropdown', 'modal', 'tooltip', 'popover', 'tab'].forEach(function(plugin) {
                jQuery(window).on(method + '.bs.' + plugin, function(event) {
                    event.target[method] = undefined;
                    setTimeout(function() { delete event.target[method]; }, 0);
                });
            });
        });
    }

    var MIN_SIZE = 50; // px, smallest a pane can be dragged to

    jQuery('#manage_ontologies_split .mo-gutter').on('mousedown', function(e) {
        e.preventDefault();
        var gutter = jQuery(this);
        var target = jQuery('#' + gutter.data('target'));
        var container = target.parent();
        var vertical = gutter.hasClass('mo-gutter-v');
        var startPos = vertical ? e.pageX : e.pageY;
        var startSize = vertical ? target.outerWidth() : target.outerHeight();
        var total = vertical ? container.width() : container.height();
        var gutterSize = vertical ? gutter.outerWidth() : gutter.outerHeight();

        gutter.addClass('mo-dragging');
        jQuery('body').css({ 'user-select': 'none', cursor: vertical ? 'col-resize' : 'row-resize' });

        jQuery(document).on('mousemove.moSplit', function(ev) {
            var delta = (vertical ? ev.pageX : ev.pageY) - startPos;
            var size = Math.max(MIN_SIZE, Math.min(total - gutterSize - MIN_SIZE, startSize + delta));
            target.css(vertical ? 'width' : 'height', (size / total * 100) + '%');
        });

        jQuery(document).on('mouseup.moSplit', function() {
            jQuery(document).off('.moSplit');
            gutter.removeClass('mo-dragging');
            jQuery('body').css({ 'user-select': '', cursor: '' });
        });
    });

    // Populate the left pane with the db names of populated ontologies
    var dbList = jQuery('#manage_ontologies_db_list');

    // Parentheses in cv names are replaced with spaces so they don't clash with wrapping ones
    function cleanCvName(name) {
        return name.replace(/[()]/g, ' ').replace(/\s+/g, ' ').trim();
    }

    jQuery.ajax({
        url: '/ajax/onto/get_populated_ontologies',
        dataType: 'json',
        success: function(response) {
            if (response.error) {
                dbList.empty();
                alert('Error retrieving ontologies: ' + response.error + ' Contact a server administrator.');
                return;
            }

            // Response is { db_name: { cv_id: cv_name, ... }, ... }: one list item per db,
            // labelled "db_name (cv_name[, cv_name...])".
            // Parentheses in cv names are replaced with spaces so they don't clash with the wrapping ones.
            dbList.empty();
            jQuery.each(Object.keys(response).sort(), function(i, dbName) {
                var cvs = response[dbName];
                var cvIds = Object.keys(cvs);
                var cvNames = jQuery.map(cvIds, function(cv_id) {
                    return cleanCvName(cvs[cv_id]);
                }).sort();
                var link = jQuery('<a href="#"></a>').text(dbName + ' (' + cvNames.join(', ') + ')');
                dbList.append(jQuery('<li></li>').attr({ 'data-db-name': dbName, 'data-cv-ids': cvIds.join(',') }).append(link));
            });
        },
        error: function(xhr, status, err) {
            dbList.empty();
            alert('Error retrieving ontologies: ' + (err || status) + ' Contact a server administrator.');
        }
    });

    // Bottom-right pane: Visible/Editable toggles for each cv in the selected ontology
    var cvTable = jQuery('#manage_ontologies_cv_table');
    var cvTableBody = cvTable.children('tbody');
    var cvTableMessage = jQuery('#manage_ontologies_cv_table_message');
    var cvRequestCount = 0; // used to ignore responses from superseded clicks
    var browserContainer = jQuery('#manage_ontologies_browser');
    var browserMessage = jQuery('#manage_ontologies_browser_message');

    // Builds a Yes/No bootstrap-toggle switch (same widget as the trial upload dialogs).
    // value is 1, 0, or null; null (no cvprop row yet) is shown as No.
    function makeToggle(cvId, property, value) {
        return jQuery('<input type="checkbox" data-toggle="toggle" data-on="Yes" data-off="No">')
            .attr({ 'data-cv-id': cvId, 'data-property': property })
            .prop('checked', String(value) === '1');
    }

    // Top-right pane: ontology browser rooted at the visible cvs' root nodes of a left-pane item.
    // Called on selection, and again after a visibility change so hidden cvs drop out.
    var browserRequestCount = 0; // used to ignore responses from superseded loads
    function loadBrowser(item) {
        var requestId = ++browserRequestCount;
        var dbName = item.attr('data-db-name');

        browserContainer.hide();
        browserMessage.text('Loading ontology browser...').show();

        jQuery.ajax({
            url: '/ajax/onto/get_cv_root_nodes',
            data: { cv_ids: item.attr('data-cv-ids') },
            dataType: 'json',
            success: function(response) {
                if (requestId !== browserRequestCount) { return; }
                if (response.error) {
                    browserMessage.text('');
                    alert('Error retrieving ontology root nodes: ' + response.error);
                    return;
                }
                if (response.length === 0) {
                    browserMessage.text('No visible CVs with root terms in ' + dbName + '.');
                    return;
                }
                browserMessage.hide();
                browserContainer.show();
                // o is the global the ontology browser's inline handlers refer to
                o = new CXGN.Onto.Browser();
                o.initializeBrowserWithRoots(response, dbName);
                o.renderSearchById();
                o.renderSearchByName(dbName);
                o.render();
            },
            error: function(xhr, status, err) {
                if (requestId !== browserRequestCount) { return; }
                browserMessage.text('');
                alert('Error retrieving ontology root nodes: ' + (err || status));
            }
        });
    }

    dbList.on('click', 'li:not(.disabled) > a', function(e) {
        e.preventDefault();
        var item = jQuery(this).parent();
        dbList.children('li').removeClass('active');
        item.addClass('active');

        loadBrowser(item);

        var requestId = ++cvRequestCount;
        cvTable.hide();
        cvTableBody.empty();
        cvTableMessage.text('Loading CVs...').show();

        jQuery.ajax({
            url: '/ajax/cv/get_properties',
            data: { cv_ids: item.attr('data-cv-ids') },
            dataType: 'json',
            success: function(response) {
                if (requestId !== cvRequestCount) { return; }
                if (response.error) {
                    cvTableMessage.text('');
                    alert('Error retrieving CV properties: ' + response.error);
                    return;
                }
                jQuery.each(response.cvs, function(i, cv) {
                    var row = jQuery('<tr></tr>');
                    row.append(jQuery('<td></td>').text(cleanCvName(cv.cv_name)));
                    row.append(jQuery('<td></td>').append(makeToggle(cv.cv_id, 'visible', cv.cv_visible)));
                    row.append(jQuery('<td></td>').append(makeToggle(cv.cv_id, 'editable', cv.cv_editable)));
                    cvTableBody.append(row);
                });
                cvTableMessage.hide();
                cvTable.show();
                cvTableBody.find('input[type=checkbox]').bootstrapToggle();
            },
            error: function(xhr, status, err) {
                if (requestId !== cvRequestCount) { return; }
                cvTableMessage.text('');
                alert('Error retrieving CV properties: ' + (err || status));
            }
        });
    });

    cvTableBody.on('change', 'input[type=checkbox]', function() {
        var input = jQuery(this);
        var toggle = input.data('bs.toggle');
        var property = input.attr('data-property');
        var value = input.prop('checked') ? 1 : 0;

        // Puts the switch back without firing another change event
        function revert() {
            toggle.enable();
            if (value) { toggle.off(true); } else { toggle.on(true); }
        }

        toggle.disable();
        jQuery.ajax({
            url: property === 'visible' ? '/ajax/cv/set_visibility' : '/ajax/cv/set_editable',
            type: 'POST',
            data: { cv_id: input.attr('data-cv-id'), value: value },
            dataType: 'json',
            success: function(response) {
                if (response.error) {
                    revert();
                    alert('Error saving ' + property + ' setting: ' + response.error);
                    return;
                }
                toggle.enable();
                if (property === 'visible') {
                    loadBrowser(dbList.children('li.active'));
                }
            },
            error: function(xhr, status, err) {
                revert();
                alert('Error saving ' + property + ' setting: ' + (err || status));
            }
        });
    });
});
</script>

<ul class="nav nav-pills nav-justified" id="manage_ontologies_tabs" style="margin-bottom: 20px">
    <li class="active">
        <a data-toggle="tab" href="#manage_ontologies_manage_tab">Manage</a>
    </li>
    <li>
        <a data-toggle="tab" href="#manage_ontologies_upload_download_tab">Upload/Download</a>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade in active" id="manage_ontologies_manage_tab">
        <div class="mo-split" id="manage_ontologies_split">
            <div class="mo-pane" id="manage_ontologies_left_pane" style="width: 20%">
                <ul class="nav nav-pills nav-stacked" id="manage_ontologies_db_list">
                    <li class="disabled"><a>Loading ontologies...</a></li>
                </ul>
            </div>
            <div class="mo-gutter mo-gutter-v" data-target="manage_ontologies_left_pane"></div>
            <div class="mo-right">
                <div class="mo-pane" id="manage_ontologies_top_pane" style="height: 50%">
                    <p class="text-muted" id="manage_ontologies_browser_message">Select an ontology on the left to browse it.</p>
                    <div id="manage_ontologies_browser" style="display: none">
                        <& /ontology/browser.mas, defer_init => 1 &>
                    </div>
                </div>
                <div class="mo-gutter mo-gutter-h" data-target="manage_ontologies_top_pane"></div>
                <div class="mo-pane mo-pane-fill" id="manage_ontologies_bottom_pane">
                    <p class="text-muted" id="manage_ontologies_cv_table_message">Select an ontology on the left to manage its CVs.</p>
                    <table class="table table-condensed table-hover" id="manage_ontologies_cv_table" style="display: none">
                        <thead>
                            <tr><th>CV name</th><th>Visible <span class="glyphicon glyphicon-question-sign" style="color:blue" title="Changes whether this CV is visible in the ontology browser."></span></th><th>Editable <span class="glyphicon glyphicon-question-sign" style="color:blue" title="Changes whether users can add or edit terms on this ontology."></span></th></tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="tab-pane fade" id="manage_ontologies_upload_download_tab">
        <p>Pane 2</p>
    </div>
</div>

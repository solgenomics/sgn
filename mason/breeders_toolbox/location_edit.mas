                <button type="button" style="white-space: normal; max-width: 100%; overflow-wrap: anywhere;" class="btn btn-primary" name="store_location_submit" id="store_location_submit"><% $c->i18n->p('locations.edit.store', 'Store Location Details') |h %></button>
            </div>
        </div>
    </div>
</div>


<script defer="defer">
    var locationEditorI18n = (window.SGN && window.SGN.i18n) || {p: function (context, source, variables) {
        return source.replace(/%\{([A-Za-z0-9_]+)\}/g, function (match, name) {
            return variables && Object.prototype.hasOwnProperty.call(variables, name) ? String(variables[name]) : match;
        });
    }};

// Carry the page language only on these reviewed same-origin requests.
function _sgnLocationEditorLocaleHeaders(url) {
    try {
        var target = new URL(url, window.location.href);
        if (target.origin !== window.location.origin || !/^\/ajax\/location\/store$/.test(target.pathname)) return {};
        var runtime = window.SGN && window.SGN.i18n;
        var root = typeof document !== 'undefined' && document.documentElement;
        var requested = root && typeof root.getAttribute === 'function' && root.getAttribute('data-sgn-locale');
        return {'X-SGN-Locale': requested || (runtime && runtime.requestedLocale)
            || (root && root.lang) || (runtime && runtime.locale) || 'en'};
    } catch (error) {
        return {};
    }
}
    jQuery(document).ready(function() {
        get_select_box('breeding_programs', 'breeding_program', {
            empty: 1,
            id: 'breeding_program_select',
            default: 'please select',
            multiple: 1,
        });

        $('#store_location_submit').click( function(event) {
            event.preventDefault();
            var id= $('#location_id').val();
            var name = $('#location_name').val();
            name = name.trim();
            var abbreviation = $('#location_abbreviation').val();
            var country_code = $('#location_country').val();
            var country_option = $('#location_country option:selected');
            var country_metadata = country_option.attr('data-canonical-country');
            var country_name = country_metadata !== undefined ? country_metadata : country_option.text().replace(/^[^\s]+(.*)/, '$1').trim();
            var programs = [];
            $('#breeding_program_select option:selected').each( function() {
                var canonicalEmpty = $('#breeding_program_select').attr('data-canonical-empty-label');
                programs.push(this.value === '' && this.text !== '' && canonicalEmpty !== undefined ? canonicalEmpty : $(this).text());
            });

            var noaa_station_id = $('#location_noaa_station_id').val();

            programs = programs.join("&");
            var type = $('#location_type').val();
            var latitude = $('#location_latitude').val();
            var longitude = $('#location_longitude').val();
            var altitude = $('#location_altitude').val();
            //console.log("Location programs to store are "+JSON.stringify(programs));
            //console.log("Location name to store is "+name);
            //console.log("Location country name to store is "+country_name+" and country code is "+country_code);

            if (name == '') { alert(locationEditorI18n.p('locations.edit.required_name', 'A location name is required.'));  return; }
            if (abbreviation == '') { alert(locationEditorI18n.p('locations.edit.required_abbreviation', 'A location abbreviation is required.'));  return; }
            if ($('#location_country').val() == '') { alert(locationEditorI18n.p('locations.edit.required_country', 'A location country is required.'));  return; }
            if (type == '') { alert(locationEditorI18n.p('locations.edit.required_type', 'A location type is required.'));  return; }
            if (latitude == '') { alert(locationEditorI18n.p('locations.edit.required_latitude', 'A location latitude is required.'));  return; }
            if (longitude == '') { alert(locationEditorI18n.p('locations.edit.required_longitude', 'A location longitude is required.'));  return; }
            if (altitude == '') { alert(locationEditorI18n.p('locations.edit.required_altitude', 'A location altitude is required.'));  return; }

            $.ajax({
                type: 'POST',
                url: '/ajax/location/store',
                headers: _sgnLocationEditorLocaleHeaders('/ajax/location/store'),
                data: {
                    'id': id,
                    'name': name,
                    'abbreviation': abbreviation,
                    'country_name': country_name,
                    'country_code': country_code,
                    'programs': programs,
                    'type': type,
                    'latitude':latitude,
                    'longitude':longitude,
                    'altitude': altitude,
                    'noaa_station_id': noaa_station_id
                },
                success: function(response) {
                    if (response.error) { alert(response.error); }
                    else if (response.success) {
                        alert(response.success);
                        var token = '<% $c->config->{noaa_ncdc_access_token} %>';
                        if (noaa_station_id === '') {
                            $('#store_location_dialog').modal("hide");
                            refreshLocationTableAndMap();
                        } else if (token == 'NULL') {
                            console.log(`Configuration variable 'noaa_ncdc_access_token' is undefined. Data from station `+noaa_station_id+` can't be accessed without a token.\r\nPlease visit https://www.ncdc.noaa.gov/cdo-web/token to generate a valid access token, then include the token in sgn_local.conf`);
                            $('#store_location_dialog').modal("hide");
                            refreshLocationTableAndMap();
                        } else {
                            $.ajax({
                                url:'https://www.ncdc.noaa.gov/cdo-web/api/v2/stations/'+noaa_station_id,
                                headers:{ token: token },
                                success: function(response) {
                                    console.log(response);
                                    if (response.name) {
                                        alert(locationEditorI18n.p('locations.edit.noaa_found', 'Found NOAA Station from given NOAA StationID: %{name}', {name: response.name}));
                                    }
                                    else {
                                        alert(locationEditorI18n.p('locations.edit.noaa_unverified', 'Could not verify the NOAA StationID you provided, however, your details were still updated.'));
                                    }
                                    $('#store_location_dialog').modal("hide");
                                    refreshLocationTableAndMap();
                                },
                                error: function() {
                                    alert(locationEditorI18n.p('locations.edit.noaa_failed', 'The NOAA NCDC authorization token may not be valid! We could not verify your NOAA StationID. Please contact us!'));
                                    $('#store_location_dialog').modal("hide");
                                    refreshLocationTableAndMap();
                                }
                            });
                        }
                    }
                },
                error: function() { alert(locationEditorI18n.p('locations.edit.store_failed', 'An error occurred while storing the location details. Please try again later.')); }
            });
        });
    });
</script>
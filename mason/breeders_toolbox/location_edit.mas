<%init>
use utf8;
</%init>

<& /util/import_javascript.mas, classes => ['CXGN.Locations'] &>

<div class="modal fade" id="store_location_dialog" name="store_location_dialog" tabindex="-1" role="dialog" aria-labelledby="storeLocationDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('locations.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="storeLocationDialog"><% $c->i18n->p('locations.edit.title', 'Location Details') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" name="store_location_form" id="store_location_form">
                        <div class="form-group" id="location_id" style="display: none"></div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label"><% $c->i18n->p('locations.edit.name', 'Name: ') |h %></label>
                            <div class="col-sm-10">
                                <input class="form-control" name="location_name" id="location_name" type="text" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label"><% $c->i18n->p('locations.edit.abbreviation', 'Abbreviation: ') |h %></label>
                            <div class="col-sm-10">
                                <input class="form-control" name="location_abbreviation" id="location_abbreviation" type="text" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label"><% $c->i18n->p('locations.edit.country', 'Country: ') |h %></label>
                            <div class="col-sm-10">
                                <select class="form-control" id="location_country" name="location_country">
                                    <option value=""></option>
                                    <option value="ABW" data-canonical-country="Aruba">ABW <% $c->i18n->p('locations.country.ABW', 'Aruba') |h %></option>
                                    <option value="AFG" data-canonical-country="Afghanistan">AFG <% $c->i18n->p('locations.country.AFG', 'Afghanistan') |h %></option>
                                    <option value="AGO" data-canonical-country="Angola">AGO <% $c->i18n->p('locations.country.AGO', 'Angola') |h %></option>
                                    <option value="AIA" data-canonical-country="Anguilla">AIA <% $c->i18n->p('locations.country.AIA', 'Anguilla') |h %></option>

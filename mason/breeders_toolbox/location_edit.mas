                            <div class="col-sm-10">
                                <input class="form-control" name="location_altitude" id="location_altitude" type="text" dir="ltr" size="4"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-6 control-label"><% $c->i18n->p('locations.edit.noaa_label', 'Optional: Nearest NOAA Weather Station ID') |h %> (<a href="https://www.ncdc.noaa.gov/cdo-web/datatools/findstation" target="_blank"><% $c->i18n->p('locations.search_here', 'Search Here') |h %></a>)</label>
                            <div class="col-sm-6">
                                <input class="form-control" name="location_noaa_station_id" id="location_noaa_station_id" type="text" dir="ltr" placeholder="<% $c->i18n->p('locations.edit.noaa_example', 'e.g. %{station}', {station => 'GHCND:USC00300331'}) |h %>"/>

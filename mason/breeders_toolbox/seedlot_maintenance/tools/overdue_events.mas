<%perl>
    use POSIX qw(strftime);
    my $datestr = strftime("%Y-%m-%d", localtime());
</%perl>

<style>
.seedlot-overdue-tool #overdue_events_find_seedlots {
    max-inline-size: 100%;
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
}
.seedlot-overdue-tool .control-label {
    overflow-wrap: anywhere;
}
.seedlot-overdue-tool .form-group::after {
    content: "";
    display: table;
    clear: both;
}
</style>

<div class="panel panel-default seedlot-overdue-tool">
    <div class="panel-heading">
        <h5 class="panel-title"><% $c->i18n->p('seedlot_overdue.ui.title', 'Overdue Events') |h %></h5>
    </div>
    <div class="panel-body">

        <p><% $c->i18n->p('seedlot_overdue.ui.intro', 'This search will return any Seedlots from the selected list that have not had the specified event performed on or after the selected date.') |h %></p>

        <br />
        
        <!-- Seedlots -->
        <div class="form-group">
            <label class="col-sm-3 control-label" style="text-align: right"><% $c->i18n->p('seedlot_overdue.ui.seedlots', 'Seedlots') |h %></label>
            <div class="col-sm-9">
                <div id="overdue_events_seedlot_list"></div>
            </div>
        </div>

        <br /><br />

        <!-- Event -->
        <div class="form-group">
            <label class="col-sm-3 control-label" style="text-align: right"><% $c->i18n->p('seedlot_overdue.ui.event', 'Event') |h %></label>
            <div class="col-sm-9">
                <select class="form-control input-sm" id="overdue_events_event_select" disabled>
                    <option value=""><% $c->i18n->p('seedlot_overdue.ui.loading', 'Loading...') |h %></option>
                </select>
            </div>
        </div>

        <br /><br />

        <!-- Date -->
        <div class="form-group">
            <label class="col-sm-3 control-label" style="text-align: right"><% $c->i18n->p('seedlot_overdue.ui.date', 'Date') |h %></label>
            <div class="col-sm-9">
                <input class="form-control input-sm" type="date" id="overdue_events_date" name="overdue_events_date" value="<% $datestr %>" max="<% $datestr %>">
            </div>
        </div>

        <br /><br />

        <div style="margin: 0 auto; max-width: 400px">
            <button id="overdue_events_find_seedlots" class="btn btn-primary btn-block"><% $c->i18n->p('seedlot_overdue.ui.find', 'Find Seedlots') |h %></button>
        </div>


        <!-- RESULTS -->

        <div id="overdue_events_results" style="display: none">

            <br /><br />
            
            <h4><% $c->i18n->p('seedlot_overdue.ui.overdue_seedlots', 'Overdue Seedlots') |h %></h4>
            <table class="table table-striped" style="width: 100%">
                <thead>
                    <tr>
                        <th style="width: 50%"><% $c->i18n->p('seedlot_overdue.ui.seedlot', 'Seedlot') |h %></th>
                        <th style="width: 50%"><% $c->i18n->p('seedlot_overdue.ui.record', 'Record') |h %></th>
                    </tr>
                </thead>
                <tbody id="overdue_events_results_overdue"></tbody>
            </table>

            <br /><br />

            <h4><% $c->i18n->p('seedlot_overdue.ui.not_overdue_seedlots', 'Not Overdue Seedlots') |h %></h4>
            <table class="table table-striped" style="width: 100%">
                <thead>
                    <tr>
                        <th style="width: 50%"><% $c->i18n->p('seedlot_overdue.ui.seedlot', 'Seedlot') |h %></th>
                        <th style="width: 50%"><% $c->i18n->p('seedlot_overdue.ui.last_recorded_event', 'Last Recorded Event') |h %></th>
                    </tr>
                </thead>
                <tbody id="overdue_events_results_not_overdue"></tbody>
            </table>

        </div>

    </div>
</div>


<script type="text/javascript">

// Optional browser language assets preserve the canonical list/event data.
var overdueI18n = (window.SGN && window.SGN.i18n) || {
    p: function (context, source, variables) {
        return source.replace(/%\{([A-Za-z0-9_]+)\}/g, function (match, name) {
            return variables && Object.prototype.hasOwnProperty.call(variables, name) ? String(variables[name]) : match;
        });
    }
};
function overdueRequestedLocale() {
    var root = document.documentElement;
    var runtime = window.SGN && window.SGN.i18n;
    var locale = root.getAttribute('data-sgn-locale') || (runtime && runtime.requestedLocale) || root.lang || (runtime && runtime.locale) || 'en';
    return typeof locale === 'string' && /^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$/.test(locale) ? locale : 'en';
}
function overdueLocaleHeaders(url) {
    try {
        var target = new URL(url, window.location.href);
        if (target.origin !== window.location.origin || !/^\/ajax\/breeders\/seedlot\/maintenance\/(?:ontology|overdue)$/.test(target.pathname)) return {};
        return {'X-SGN-Locale': overdueRequestedLocale()};
    } catch (error) { return {}; }
}

let TOOLS_LO = new CXGN.List();
let TOOLS_ONTOLOGY = [];

jQuery(document).ready(function() {

    // Set seedlot list select
    jQuery('#overdue_events_seedlot_list').html(TOOLS_LO.listSelect('overdue_events_filter_seedlot', [ 'seedlots' ], overdueI18n.p("seedlot_overdue.ui.list_select", "select"), undefined, undefined));

    // Get event ontology and set events
    getToolsEventOntology(function() {
        setOverdueEventsSelect();
    });

    // Click Listeners
    jQuery("#overdue_events_find_seedlots").click(findOverdueSeedlots);

});

/**
 * Get the maintenance event ontology
 * @param {Function} [callback] Callback function()
 */
function getToolsEventOntology(callback) {
    jQuery.ajax({
        type: 'GET',
        dataType: 'json',
        url: '/ajax/breeders/seedlot/maintenance/ontology',
        headers: overdueLocaleHeaders('/ajax/breeders/seedlot/maintenance/ontology'),
        success: function(data) {
            if ( data && data.ontology ) {
                TOOLS_ONTOLOGY = data.ontology;
                if ( callback ) return callback();
            }
            else {
                alert(overdueI18n.p("seedlot_overdue.ui.ontology_error", "ERROR: Could not fetch ontology terms"));
            }
        },
        error: function() {
            alert(overdueI18n.p("seedlot_overdue.ui.ontology_error", "ERROR: Could not fetch ontology terms"));
        }
    });
}

/**
* Set the selection box for the overdue events list
* - Parse the ONTOLOGY array into option groups and options
*/
function setOverdueEventsSelect() {
    const select = jQuery("#overdue_events_event_select").empty();
    select.append(jQuery('<option>').val('').text(overdueI18n.p("seedlot_overdue.ui.event_select", "...Select Maintenance Event...")));
    for ( let i = 0; i < TOOLS_ONTOLOGY.length; i++ ) {
        // Ontology labels and IDs are canonical scientific values, not UI messages.
        const group = jQuery('<optgroup>').attr('label', TOOLS_ONTOLOGY[i].name);
        if ( TOOLS_ONTOLOGY[i].children ) {
            for ( let j = 0; j < TOOLS_ONTOLOGY[i].children.length; j++ ) {
                group.append(jQuery('<option>').val(TOOLS_ONTOLOGY[i].children[j].cvterm_id).text(TOOLS_ONTOLOGY[i].children[j].name));
            }
        }
        select.append(group);
    }
    select.prop("disabled", false);
}

/**
 * Query the database for the overdue status of the requested seedlots
 */
function findOverdueSeedlots() {
    let list_id = jQuery("#overdue_events_filter_seedlot_list_select").val();
    let event_id = jQuery("#overdue_events_event_select").val();
    let date = jQuery("#overdue_events_date").val();
    let seedlot_names = list_id ? TOOLS_LO.getList(list_id) : [];

    // Check required parameters
    if ( !list_id || list_id === '' ) {
        alert(overdueI18n.p("seedlot_overdue.ui.list_required", "Select a list of seedlots"));
        return false;
    }
    if ( !event_id || event_id === '' ) {
        alert(overdueI18n.p("seedlot_overdue.ui.event_required", "Select a maintenance event"));
        return false;
    }
    if ( !date || date === '' ) {
        alert(overdueI18n.p("seedlot_overdue.ui.date_required", "Select a date"));
        return false;
    }
    let regex = /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/;
    if ( !date.match(regex) ) {
        alert(overdueI18n.p("seedlot_overdue.ui.date_format", "Incorrect date format - the date must be in the format of YYYY-MM-DD"));
        return false;
    }

    // Build body of request
    let body = {
        seedlots: seedlot_names,
        event: event_id,
        date: date
    }

    // Make request
    jQuery("#overdue_events_find_seedlots").attr("disabled", true);
    let overdue_seedlots = [];
    jQuery.ajax({
        type: 'POST',
        url: '/ajax/breeders/seedlot/maintenance/overdue',
        headers: overdueLocaleHeaders('/ajax/breeders/seedlot/maintenance/overdue'),
        data: JSON.stringify(body),
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function(data) {
            if ( data && data.results ) {
                overdue_seedlots = data.results;
            }
            else {
                alert(overdueI18n.p("seedlot_overdue.ui.overdue_error", "ERROR: Could not find overdue seedlots!"));
            }
        },
        error: function() {
            alert(overdueI18n.p("seedlot_overdue.ui.overdue_error", "ERROR: Could not find overdue seedlots!"));
        },
        complete: function() {
            jQuery("#overdue_events_find_seedlots").attr("disabled", false);
            displayOverdueSeedlots(overdue_seedlots);
        }
    });

    return false;
}

/**
 * Display the tables of overdue / not overdue seedlots
 * @param {Object[]} seedlots Array of seedlot status info
 */
function displayOverdueSeedlots(seedlots) {
    const overdue = jQuery("#overdue_events_results_overdue").empty();
    const not_overdue = jQuery("#overdue_events_results_not_overdue").empty();
    for ( let i = 0; i < seedlots.length; i++ ) {
        const row = jQuery('<tr>').append(jQuery('<td>').text(seedlots[i].seedlot));
        if ( seedlots[i].overdue === 1 ) {
            const query = new URLSearchParams({seedlot_name: seedlots[i].seedlot, lang: overdueRequestedLocale()});
            const link = jQuery('<a>').attr('href', '/breeders/seedlot/maintenance/record?' + query.toString()).attr('target', '_blank').text(overdueI18n.p("seedlot_overdue.ui.record_event", "Record Maintenance Event"));
            row.append(jQuery('<td>').append(link)).appendTo(overdue);
        }
        else {
            row.append(jQuery('<td>').text(parseTS(seedlots[i].timestamp))).appendTo(not_overdue);
        }
    }
    jQuery("#overdue_events_results").css("display", "block");
}

/**
 * Parse a YYYY-MM-DD HH:MM:SS timestamp into a human-friendly form
 */
function parseTS(ts) {
    let dow = [overdueI18n.p("seedlot_overdue.ui.weekday_sun", "Sun"), overdueI18n.p("seedlot_overdue.ui.weekday_mon", "Mon"), overdueI18n.p("seedlot_overdue.ui.weekday_tue", "Tue"), overdueI18n.p("seedlot_overdue.ui.weekday_wed", "Wed"), overdueI18n.p("seedlot_overdue.ui.weekday_thu", "Thu"), overdueI18n.p("seedlot_overdue.ui.weekday_fri", "Fri"), overdueI18n.p("seedlot_overdue.ui.weekday_sat", "Sat")];
    let month = [overdueI18n.p("seedlot_overdue.ui.month_jan", "Jan"), overdueI18n.p("seedlot_overdue.ui.month_feb", "Feb"), overdueI18n.p("seedlot_overdue.ui.month_mar", "Mar"), overdueI18n.p("seedlot_overdue.ui.month_apr", "Apr"), overdueI18n.p("seedlot_overdue.ui.month_may", "May"), overdueI18n.p("seedlot_overdue.ui.month_jun", "Jun"), overdueI18n.p("seedlot_overdue.ui.month_jul", "Jul"), overdueI18n.p("seedlot_overdue.ui.month_aug", "Aug"), overdueI18n.p("seedlot_overdue.ui.month_sep", "Sep"), overdueI18n.p("seedlot_overdue.ui.month_oct", "Oct"), overdueI18n.p("seedlot_overdue.ui.month_nov", "Nov"), overdueI18n.p("seedlot_overdue.ui.month_dec", "Dec")];
    let d = new Date(ts);
    let h = d.getHours();
    let m = d.getMinutes();
    let s = d.getSeconds();
    if ( h <= 9 ) h = '0' + h;
    if ( m <= 9 ) m = '0' + m;
    if ( s <= 9 ) s = '0' + s;
    return dow[d.getDay()] + " " + month[d.getMonth()] + " " + d.getDate() + " " + h + ":" + m + ":" + s + " " + d.getFullYear();
}

</script>
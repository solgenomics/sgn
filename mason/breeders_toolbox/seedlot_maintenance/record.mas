<%args>
    $ontology => undef
    $info_event_cvterms => undef
    $operator => undef
</%args>

<%init>
    if ( !$ontology ) {
        print '<p><strong>' . HTML::Entities::encode_entities($c->i18n->p('seedlot_record.ui.ontology_error_label', 'ERROR:')) . '</strong> ' . HTML::Entities::encode_entities($c->i18n->p('seedlot_record.ui.ontology_missing', 'Seedlot Maintenance Event Ontology not loaded!')) . '</p>';
        return;
    }
    use JSON::PP ();
    use HTML::Entities ();
    my $ontology_json = JSON::PP->new->ascii->encode($ontology);
    my $ontology_str = JSON::PP->new->ascii->encode($ontology_json);
    $ontology_str =~ s/([<>&])/sprintf("\\u%04x", ord($1))/ge;
</%init>

<& /util/import_javascript.mas, classes => [ 'bootstrap_min.js', 'jquery' ] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p('seedlot_record.ui.title', 'Record Seedlot Maintenance')) &>

<div id="seedlot-maintenance-record">

<!-- SEEDLOT INFORMATION -->
<&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlot_record.ui.seedlot', 'Seedlot')), anchor_title=>'Seedlot',  collapsible=>1, collapsed=>0, subtitle=>"" &>
    <br /><br />
    <div class="well seedlot_event_well">
        <form class="form-horizontal">

            <!-- Seedlot Name -->
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p('seedlot_record.ui.name', 'Name:') |h %></label>
                <div class="col-sm-5">
                    <input class="form-control" id="seedlot_event_name" type="text" value="">
                </div>
                <div class="col-sm-2">
                    <button id="seedlot_event_name_update" class="btn btn-block btn-info"><span class="glyphicon glyphicon-refresh"></span> <% $c->i18n->p('seedlot_record.ui.update', 'Update') |h %></button>
                </div>
                <div class="col-sm-2">
                    <button id="seedlot_event_name_barcode" class="btn btn-block btn-default"><span class="glyphicon glyphicon-qrcode"></span> <% $c->i18n->p('seedlot_record.ui.barcode', 'Barcode') |h %></button>
                </div>
            </div>

            <!-- Seedlot Contents -->
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p('seedlot_record.ui.contents', 'Contents:') |h %></label>
                <div class="col-sm-9">
                    <p class="seedlot_event_info" id="seedlot_event_contents"></p>
                </div>
            </div>

            <!-- Seedlot Location -->
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p('seedlot_record.ui.location', 'Location:') |h %></label>
                <div class="col-sm-9">
                    <p class="seedlot_event_info" id="seedlot_event_location"></p>
                </div>
            </div>

            <!-- Seedlot Box -->
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p('seedlot_record.ui.box', 'Box:') |h %></label>
                <div class="col-sm-9">
                    <p class="seedlot_event_info" id="seedlot_event_box"></p>
                </div>
            </div>

% if ( defined $info_event_cvterms && scalar(@{$info_event_cvterms}) > 0 ) {
            <!-- Seedlot Events -->
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p('seedlot_record.ui.recent_events', 'Recent Events:') |h %></label>
                <div class="col-sm-9">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th><% $c->i18n->p('seedlot_record.ui.event_header', 'Event') |h %></th>
                                <th><% $c->i18n->p('seedlot_record.ui.value_header', 'Value') |h %></th>
                                <th><% $c->i18n->p('seedlot_record.ui.notes_header', 'Notes') |h %></th>
                                <th><% $c->i18n->p('seedlot_record.ui.timestamp_header', 'Timestamp') |h %></th>
                            </tr>
                        </thead>
                        <tbody>
% foreach my $cvterm (@$info_event_cvterms) { 
                            <tr class="seedlot_event_info_cvterm_row" data-cvterm="<% $cvterm |h %>">
                                <td class="seedlot_event_info_cvterm_event">&nbsp;</td>
                                <td class="seedlot_event_info_cvterm_value"></td>
                                <td class="seedlot_event_info_cvterm_notes"></td>
                                <td class="seedlot_event_info_cvterm_timestamp"></td>
                            </tr>
% }
                        </tbody>
                    </table>
                </div>
            </div>
% }

        </form>
    </div>
</&>


<!-- MAINTENANCE EVENTS -->
<&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlot_record.ui.events', 'Maintenance Events')), anchor_title=>'Maintenance Events',  collapsible=>1, collapsed=>0, subtitle=>"" &>
    <div id="seedlot_event_container"></div>
</&>


<!-- EVENT INFORMATION -->
<&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlot_record.ui.operator_timestamp', 'Username/Timestamp')), anchor_title=>'Username/Timestamp',  collapsible=>1, collapsed=>0, subtitle=>"" &>
    <br /><br />
    <div class="well seedlot_event_well">
        <form class="form-horizontal">

            <!-- Operator -->
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p('seedlot_record.ui.operator', 'Operator:') |h %></label>
                <div class="col-sm-9">
                    <input class="form-control" id="seedlot_event_operator" name="seedlot_event_operator" type="text" value="<% $operator |h %>">
                </div>
            </div>

            <!-- Timestamp -->
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p('seedlot_record.ui.timestamp', 'Timestamp:') |h %></label>
                <div class="col-sm-9">
                    <input class="form-control" id="seedlot_event_timestamp" name="seedlot_event_timestamp" type="text" value="">
                </div>
            </div>

        </form>
    </div>
    <br /><br />
</&>


<!-- Submit Button -->
<div class="center">
    <button id="seedlot_event_submit" class="btn btn-primary btn-block" style="max-width: 600px; margin: auto" disabled><% $c->i18n->p('seedlot_record.ui.submit', 'Submit') |h %></button>
</div>
<br /><br />



<!-- Message Modal -->
<div id="seedlot_modal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div id="seedlot_modal_body" class="modal-body"></div>
            <div class="modal-footer"><button id="seedlot_modal_close" type="button" class="btn btn-default"><% $c->i18n->p('seedlot_record.ui.close', 'Close') |h %></button></div>
        </div>
    </div>
</div>


</div>

<script type="text/javascript">
    var recordI18n = (window.SGN && window.SGN.i18n) || {
        p: function (context, source, variables) {
            return source.replace(/%\{([A-Za-z_][A-Za-z0-9_]*)\}/g, function (token, name) {
                return variables && Object.prototype.hasOwnProperty.call(variables, name) ? String(variables[name]) : token;
            });
        }
    };
    function recordRequestedLocale() {
        var locale = document.documentElement.getAttribute('data-sgn-locale') || document.documentElement.lang || 'en';
        return /^[A-Za-z]{2,8}(?:[-_][A-Za-z0-9]{1,8})*$/.test(locale) ? locale : 'en';
    }
    function recordLocaleHeaders(url) {
        try {
            var target = new URL(url, window.location.href);
            var admitted = target.pathname === '/ajax/breeders/seedlots'
                || target.pathname === '/ajax/stock/seedlot_name_autocomplete'
                || target.pathname === '/ajax/breeders/seedlot/maintenance/search'
                || /^\/ajax\/breeders\/seedlot\/[1-9][0-9]*\/maintenance$/.test(target.pathname);
            return target.origin === window.location.origin && admitted ? {'X-SGN-Locale': recordRequestedLocale()} : {};
        }
        catch (error) { return {}; }
    }
    function recordInertMarkup(html) {
        var template = document.createElement('template');
        template.innerHTML = String(html);
        return template.content;
    }
    // This source-produced carrier has one authored accession/cross link and text.
    // Parse it in a detached document and recreate only its admitted link grammar.
    function setSeedlotContents(html) {
        var target = jQuery('#seedlot_event_contents').empty();
        var inert = recordInertMarkup(html || '');
        Array.prototype.forEach.call(inert.childNodes, function (node) {
            var href = node.nodeType === 1 && node.tagName === 'A' ? node.getAttribute('href') : null;
            if (href && /^\/(?:stock\/[1-9][0-9]*\/view|cross\/[1-9][0-9]*)$/.test(href)) {
                target.append(jQuery('<a>').attr('href', href).text(node.textContent));
            }
            else {
                target.append(document.createTextNode(node.textContent));
            }
        });
    }
    function recordDefinitionText(definition) {
        return recordInertMarkup(definition).textContent;
    }

    let ONTOLOGY = JSON.parse(<% $ontology_str %>);   // Seedlot Event Ontology representation (array of categories with events and values)
    let SEEDLOT_NAME;                                   // Name of current Seedlot
    let SEEDLOT_ID;                                     // ID of current Seedlot
    let PENDING_CHANGES = false;                        // Flag set to true when event selections have been made
    let MESSAGES = [];                                  // Array of messages to display in the message modal

    jQuery(document).ready(function () {

        // Parse query arguments
        parseArgs();

        // Display the maintenance events, set initial timestamp
        resetUI();

        // Event change / Click listeners
        jQuery('#seedlot_event_name').change(getSeedlotInfo);
        jQuery('#seedlot_event_name_update').click(getSeedlotInfo);
        jQuery('#seedlot_event_name_barcode').click(scanBarcode);
        jQuery('#seedlot_event_submit').click(submitEvents);
        jQuery('#seedlot_modal_close').click(function() {
            MESSAGES = [];
            jQuery('#seedlot_modal').modal('hide');
        });
        jQuery(document).on('click', '.seedlot_event_value_btn', updateEventValue);
        jQuery(document).on('click', '.seedlot_event_notes_btn', toggleEventNotes);

        // Autocomplete for Seedlot Name input
        jQuery("#seedlot_event_name").autocomplete({
            source: function (request, response) {
                jQuery.ajax({url: '/ajax/stock/seedlot_name_autocomplete', data: {term: request.term}, dataType: 'json',
                    headers: recordLocaleHeaders('/ajax/stock/seedlot_name_autocomplete'),
                    success: response, error: function () { response([]); }});
            },
        });

    });


    /**
     * Warn when leaving the page if there are any pending events
     */
    jQuery(window).bind('beforeunload', function(e) {
        if ( PENDING_CHANGES ) {
            return e.originalEvent.returnValue = recordI18n.p("seedlot_record.ui.pending_changes", "There are pending changes that have not yet been submitted to the database! Are you sure you want to leave the page?");
        }
    });


    //
    // SETUP FUNCTIONS
    //

    /**
    * Parse the query parameters
    * - Use `seedlot_name` to set the Seedlot Name input
    */
    function parseArgs() {
        const urlSearchParams = new URLSearchParams(window.location.search);
        if ( urlSearchParams.has('seedlot_name') ) {
            let seedlot_name = urlSearchParams.get('seedlot_name');
            if (/^(?:https?:\/\/|\/)/i.test(seedlot_name) && /[?&]seedlot_name=/.test(seedlot_name)) {
                seedlot_name = seedlot_name.match(/.*[?&]seedlot_name=([\s\S]*)/)[1];
                try { seedlot_name = decodeURIComponent(seedlot_name); }
                catch (error) { if (!(error instanceof URIError)) throw error; }
            }
            jQuery('#seedlot_event_name').val(seedlot_name);
            getSeedlotInfo();
        }
    }

    /**
     * Get the details of the Seedlot specified by name
     * - Update the contents, location, and box fields
     */
    function getSeedlotInfo() {
        let name = jQuery("#seedlot_event_name").val();
        let contents = "";
        let location = "";
        let box = "";
        SEEDLOT_NAME = undefined;
        SEEDLOT_ID = undefined;

        jQuery.ajax({
            type: 'GET',
            dataType: 'json',
            url: '/ajax/breeders/seedlots', data: {seedlot_name: name},
            headers: recordLocaleHeaders('/ajax/breeders/seedlots'),
            beforeSend: function() {
                jQuery('#seedlot_event_name').attr('disabled', true);
                jQuery('#seedlot_event_name_update').attr('disabled', true);
                jQuery('#seedlot_event_name_barcode').attr('disabled', true);
                jQuery(".seedlot_event_info").text(recordI18n.p("seedlot_record.ui.loading", "Loading..."));
                jQuery(".seedlot_event_info_cvterm_value").text("");
                jQuery(".seedlot_event_info_cvterm_notes").text("");
                jQuery(".seedlot_event_info_cvterm_timestamp").text("");
            },
            success: function(response) {
                if ( response && response.data ) {
                    for ( let i = 0; i < response.data.length; i++ ) {
                        if ( response.data[i].seedlot_stock_uniquename.toUpperCase() === name.toUpperCase() ) {
                            let sl = response.data[i];
                            contents = sl.contents_html;
                            location = sl.location;
                            box = sl.box;
                            SEEDLOT_NAME = name;
                            SEEDLOT_ID = sl.seedlot_stock_id;
                            getSeedlotEvents();
                        }
                    }
                }
            },
            complete: function() {
                setSeedlotContents(contents);
                jQuery("#seedlot_event_location").text(location);
                jQuery("#seedlot_event_box").text(box);
                jQuery('#seedlot_event_name').attr('disabled', false);
                jQuery('#seedlot_event_name_update').attr('disabled', false);
                jQuery('#seedlot_event_name_barcode').attr('disabled', false);
            }
        });

        return false;
    }

    /**
     * Get the recent events for the current Seedlot
     * - Populate the table of recent event info
     */
    function getSeedlotEvents() {
        jQuery(".seedlot_event_info_cvterm_row").each(function() {
            let row = jQuery(this);
            let event = jQuery(row.find(".seedlot_event_info_cvterm_event")[0]);
            let value = jQuery(row.find(".seedlot_event_info_cvterm_value")[0]);
            let notes = jQuery(row.find(".seedlot_event_info_cvterm_notes")[0]);
            let timestamp = jQuery(row.find(".seedlot_event_info_cvterm_timestamp")[0]);
            let cvterm = row.data("cvterm");

            // Get events for seedlot
            jQuery.ajax({
                type: 'POST',
                url: '/ajax/breeders/seedlot/maintenance/search',
                headers: recordLocaleHeaders('/ajax/breeders/seedlot/maintenance/search'),
                data: JSON.stringify({
                    filters: {
                        names: [{comp: '=', value: SEEDLOT_NAME}],
                        types: [{cvterm_id: cvterm}]
                    }
                }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function(data) {
                    if ( data && data.results && data.results.length > 0 ) {
                        let e = data.results[0];
                        event.empty().append(jQuery("<strong>").text(e.cvterm_name));
                        value.text(e.value);
                        notes.text(e.notes ? e.notes : "");
                        timestamp.text(e.timestamp);
                    }
                }
            });

        });
    }

    /**
     * Redirect to the Barcode Reader
     */
    function scanBarcode() {
        var locale = recordRequestedLocale();
        var target = '/breeders/seedlot/maintenance/record?' + new URLSearchParams({lang: locale}).toString();
        window.location = '/barcode/read?' + new URLSearchParams({return: target, param: 'seedlot_name', lang: locale}).toString();
        return false;
    }

    /**
     * Reset the UI
     * - reset the Event display
     * - reset the timestamp
     */
    function resetUI() {
        setEvents();
        setTimestamp();
        PENDING_CHANGES = false;
        jQuery("#seedlot_event_submit").attr('disabled', true);
    }

    /**
     * Build the display of each of the maintenance events and their values
     */
    function setEvents() {
        let container = jQuery('#seedlot_event_container').empty();
        if ( ONTOLOGY ) {
            for ( let i = 0; i < ONTOLOGY.length; i++ ) {
                let category = ONTOLOGY[i];
                let events = category.children ? category.children : [];
                container.append(jQuery('<p>').addClass('seedlot_event_category').text(category.name));
                for ( let j = 0; j < events.length; j++ ) {
                    let event = events[j];
                    let values = event.children ? event.children : [];
                    let well = jQuery('<div>').addClass('well seedlot_event_well');
                    well.append(jQuery('<p>').addClass('seedlot_event_title').text(event.name));
                    if ( event.definition ) {
                        well.append(jQuery('<p>').addClass('seedlot_event_definition').text(recordDefinitionText(event.definition)));
                    }
                    let value_div = jQuery('<div>').addClass('seedlot_event_values_div');
                    let group = jQuery('<div>').addClass('btn-group seedlot_event_values').attr('data-cvterm', event.cvterm_id).attr('role', 'group');
                    if ( values && values.length > 0 ) {
                        group.append(jQuery('<button>').attr('type', 'button').addClass('btn btn-primary seedlot_event_value seedlot_event_value_btn')
                            .data('recordValue', 'Not Recorded').text(recordI18n.p('seedlot_record.ui.not_recorded', 'Not Recorded')));
                        for ( let k = 0; k < values.length; k++ ) {
                            // The original DOM value was a string; retain that type,
                            // without interpreting/re-serializing scientific HTML.
                            let raw_value = String(values[k].name);
                            group.append(jQuery('<button>').attr('type', 'button').addClass('btn btn-default seedlot_event_value seedlot_event_value_btn')
                                .data('recordValue', raw_value).text(raw_value));
                        }
                    }
                    else {
                        group.append(jQuery('<input>').attr('type', 'text').attr('value', '').addClass('form-control seedlot_event_value seedlot_event_value_input'));
                    }
                    value_div.append(group);
                    let note_button = jQuery('<button>').attr('type', 'button').attr('data-cvterm', event.cvterm_id).addClass('btn btn-default seedlot_event_notes_btn');
                    note_button.append(document.createTextNode('\u00a0')).append(jQuery('<span>').addClass('glyphicon glyphicon-comment')).append(document.createTextNode('\u00a0'));
                    value_div.append(jQuery('<div>').addClass('seedlot_event_notes_btn_div').append(note_button));
                    well.append(value_div);
                    let notes = jQuery('<textarea>').addClass('form-control seedlot_event_notes_input').attr('rows', '3')
                        .attr('placeholder', recordI18n.p('seedlot_record.ui.event_notes_placeholder', 'Notes about the Event'));
                    well.append(jQuery('<div>').attr('id', 'seedlot_event_notes_input_div_' + event.cvterm_id).addClass('seedlot_event_notes_input_div').append(notes));
                    container.append(well);
                }
            }
        }
    }

    /**
     * Change the highlighted button of the selected value
     */
    function updateEventValue() {
        let el = jQuery(this);
        let group = el.parent('.seedlot_event_values');
        
        group.find(".seedlot_event_value_btn").removeClass("btn-primary").addClass("btn-default");
        el.removeClass("btn-default").addClass("btn-primary");
        
        PENDING_CHANGES = true;
        jQuery("#seedlot_event_submit").attr('disabled', false);
    }

    /**
     * Toggle the display of the event notes
     */
    function toggleEventNotes() {
        let el = jQuery(this);
        let cvterm = el.data("cvterm");
        let displayed = jQuery("#seedlot_event_notes_input_div_" + cvterm).css("display") !== 'none';

        jQuery("#seedlot_event_notes_input_div_" + cvterm).css("display", displayed ? 'none' : 'block');
        if ( displayed ) jQuery("#seedlot_event_notes_input_" + cvterm).val("");
        el.removeClass(displayed ? 'btn-primary' : 'btn-default');
        el.addClass(displayed ? 'btn-default' : 'btn-primary');
    }

    /**
     * Set the value of the timestamp input to YYYY-MM-DD HH:MM:SS
     */
    function setTimestamp() {
        let now = new Date();
        let y = now.getFullYear();
        let m = now.getMonth() + 1;
        let d = now.getDate();
        let h = now.getHours();
        let i = now.getMinutes();
        let s = now.getSeconds();

        if ( m <= 9 ) m = '0' + m;
        if ( d <= 9 ) d = '0' + d;
        if ( h <= 9 ) h = '0' + h;
        if ( i <= 9 ) i = '0' + i;
        if ( s <= 9 ) s = '0' + s;

        let ts = y + '-' + m + '-' + d + ' ' + h + ':' + i + ':' + s;
        jQuery("input[name='seedlot_event_timestamp']").val(ts);
    }


    //
    // SUBMIT EVENTS
    //

    /**
     * Submit the pending events to the database
     * - Get the IDs of the Seedlots (by name) in PENDING_EVENTS
     * - Submit the events for each Seedlot
     * - If submitted, remove the events from PENDING_EVENTS
     */
    function submitEvents() {

        // Check for Seedlot ID
        if ( !SEEDLOT_ID ) {
            displayError(recordI18n.p("seedlot_record.ui.valid_seedlot_required", "Please enter a valid Seedlot name"));
            return;
        }

        // Build the event info to submit
        let events = [];
        let event_groups = jQuery(".seedlot_event_values");
        let operator = jQuery("#seedlot_event_operator").val();
        let timestamp = jQuery("#seedlot_event_timestamp").val();
        for ( let i = 0; i < event_groups.length; i++ ) {
            let event_group = jQuery(event_groups[i]);
            let cvterm_id = event_group.data("cvterm");
            let event_value = event_group.find('.seedlot_event_value_btn.btn-primary,.seedlot_event_value_input');
            let value = event_value.hasClass('seedlot_event_value_btn') ? event_value.data('recordValue') : event_value.val();
            let notes = jQuery("#seedlot_event_notes_input_div_" + cvterm_id).find(".seedlot_event_notes_input").val();

            if ( value && value !== "" && value !== "Not Recorded" ) {
                let event = {
                    cvterm_id: cvterm_id,
                    value: value,
                    notes: notes !== "" ? notes : undefined,
                    operator: operator !== "" ? operator : undefined,
                    timestamp: timestamp !== "" ? timestamp : undefined
                }
                events.push(event);
            }
        }

        // Make sure there's at least one recorded event
        if ( !events || events.length === 0 ) {
            displayError(recordI18n.p("seedlot_record.ui.event_required", "One or more Events must be recorded"));
            return;
        }

        // Disable Submit Button
        jQuery("#seedlot_event_submit").attr('disabled', true);
        jQuery("#seedlot_event_submit").text(recordI18n.p("seedlot_record.ui.submitting", "Submitting..."));

        // Submit the events
        jQuery.ajax({
            type: "POST",
            url: "/ajax/breeders/seedlot/" + SEEDLOT_ID + "/maintenance",
            headers: recordLocaleHeaders("/ajax/breeders/seedlot/" + SEEDLOT_ID + "/maintenance"),
            data: JSON.stringify({events: events}),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function(data) {
                if ( data && data.events && data.events.length === events.length ) {
                    displaySuccess(recordI18n.p("seedlot_record.ui.stored_events", "%{count} events successfully stored for Seedlot %{seedlot_name}", {count: data.events.length, seedlot_name: SEEDLOT_NAME}));
                    return _finish(true);
                }
                else if ( data && data.error ) {
                    displayError(recordI18n.p("seedlot_record.ui.database_error", "The events could not be submitted due to a database error:"), data.error);
                    return _finish();
                }
                else {
                    displayError(recordI18n.p("seedlot_record.ui.unknown_database_error", "The events could not be submitted due to an unknown database error"));
                    return _finish();
                }
            },
            error: function(msg) {
                displayError(recordI18n.p("seedlot_record.ui.database_error", "The events could not be submitted due to a database error:"), String(msg));
                return _finish();
            }
        });

        function _finish(complete) {
            jQuery("#seedlot_event_submit").attr('disabled', false);
            jQuery("#seedlot_event_submit").text(recordI18n.p("seedlot_record.ui.submit", "Submit"));
            if ( complete ) {
                window.scrollTo(0, 0);
                resetUI();
            }
        }
    }

    /**
     * Display an error message in a bootstrap modal
     * @param {string} msg Error message to display (can include HTML)
     */
    function displayError(msg, details) {
        displayModal(recordI18n.p("seedlot_record.ui.error", "Error"), "#a94442", msg, details);
    }

    /**
     * Display a success message in a bootstrap modal
     * @param {string} msg Success message to display (can include HTML)
     */
    function displaySuccess(msg) {
        displayModal(recordI18n.p("seedlot_record.ui.success", "Success"), "#3c763d", msg);
    }

    /**
     * Display a message (and any existing messages) in a bootstrap modal
     * @param {string} title Message title
     * @param {string} color Message title color
     * @param {string} msg Message to display (can include HTML)
     */
    function displayModal(title, color, msg, details) {
        MESSAGES.push({title: title, color: color, msg: msg, details: details});
        let body = jQuery('#seedlot_modal_body').empty();
        for ( let i = 0; i < MESSAGES.length; i++ ) {
            if (i > 0) body.append(jQuery('<hr>'));
            body.append(jQuery('<h1>').css('color', MESSAGES[i].color).text(MESSAGES[i].title));
            let paragraph = jQuery('<p>').css({margin: '15px 5px', 'font-size': '110%'}).text(MESSAGES[i].msg);
            if (MESSAGES[i].details !== undefined) {
                paragraph.append(jQuery('<br>')).append(jQuery('<br>'));
                paragraph.append(jQuery('<pre>').append(jQuery('<code>').text(String(MESSAGES[i].details))));
            }
            body.append(paragraph);
        }
        jQuery('#seedlot_modal').modal({backdrop: 'static', keyboard: false});
    }

</script>


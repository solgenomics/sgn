    #seedlot-maintenance-event-table th,
    #seedlot-maintenance-event-table td,
    #seedlot-maintenance-event-table .control-label,
    #seedlot-maintenance-event-table .panel-heading,
    #seedlot_maintenance_remove_modal {
        overflow-wrap: anywhere;
    }
    #seedlot-maintenance-event-table table {
        table-layout: fixed;
        max-width: 100%;
    }
    #seedlot-maintenance-event-table .infosectiontitle,
    #seedlot-maintenance-event-table .infosectionsubtitle {
        white-space: normal;
        vertical-align: top;
    }
    #seedlot-maintenance-event-table .dataTables_wrapper {
        min-width: 0;
    }

    #seedlot_maintenance_remove_modal .modal-title {
        font-size: 150%;
        weight: 700;
    }
    #seedlot_maintenance_remove_modal .modal-body {
        font-size: 110%;
    }
</style>

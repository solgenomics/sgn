<&| /page/info_section.mas, anchor_title => "Search Seedlots", title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.search_seedlots', 'Search Seedlots')),  collapsible => 1, collapsed=>0 &>

<div class="well well-sm">
    <form class="form-horizontal" id="search_seedlot_form" name="search_seedlot_form">
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.seedlot_name.72a2020', 'Seedlot Name:') |h %> </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_seedlot_name" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.breeding_program.5983e34', 'Breeding Program:') |h %> </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_breeding_program" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.contents_accession_uniquename', 'Contents (Accession Uniquename):') |h %> </label>
            <div class="col-sm-7" >
                <input class="form-control" id="search_seedlot_form_contents_accession" type="text" />
            </div>
            <div class="col-sm-2 form-check form-check-inline align-bottom">
              <input class="form-check-input" type="checkbox" id="exact_accession" value="1">
              <label class="form-check-label" for="exact_accession"><% $c->i18n->p('seedlots.ui.exact_match', 'exact match') |h %></label>
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.contents_cross_unique_id', 'Contents (Cross Unique ID):') |h %> </label>
            <div class="col-sm-7" >
                <input class="form-control" id="search_seedlot_form_contents_cross" type="text" />
            </div>
            <div class="col-sm-2 form-check form-check-inline align-bottom">
              <input class="form-check-input" type="checkbox" id="exact_cross" value="1">
              <label class="form-check-label" for="exact_cross"><% $c->i18n->p('seedlots.ui.exact_match', 'exact match') |h %></label>
            </div>
        </div>
% if (!$default_seedlot_material_type) {
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.material_type.21ab872', 'Material Type:') |h %> </label>
            <div class="col-sm-9" >
                <div id="search_seedlot_form_material_type_div"></div>
            </div>
        </div>
% }
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.location.8f494b2', 'Location:') |h %> </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_location" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.box_name.3781c9f', 'Box Name:') |h %> </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_box_name" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.minimum_count', 'Minimum Count:') |h %> </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_minimum_count" type="number" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.minimum_weight_g', 'Minimum Weight (g):') |h %> </label>

            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_minimum_weight" type="number" />
            </div>
        </div>

        <!-- div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"></label>
            <div class="col-sm-9" >
                <input id="search_seedlot_form_only_good_quality_checkbox" type="checkbox" /> Only show seedlots without quality issues
            </div>
        </div  -->

        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.quality.d50ece1', 'Quality:') |h %> </label>
            <div class="col-sm-9" >
                <input class="form-control" id="search_seedlot_form_quality" type="text" />
            </div>
        </div>
        <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.trial_usage', 'Trial Usage:') |h %> </label>
            <div class="col-sm-9">
                <div class="col-sm-5" style="padding-left: 0; padding-right: 5px">
                    <input class="form-control" id="search_seedlot_form_trial_name" type="text" placeholder="<% $c->i18n->p('seedlots.ui.trial_name', 'Trial Name') |h %>" />
                </div>
                <div class="col-sm-7" style="padding-left: 5px; padding-right: 0">
                    <select class="form-control" id="search_seedlot_form_trial_usage">
                        <option value=""><% $c->i18n->p('seedlots.ui.select_trial_seedlot_usage', 'Select trial / seedlot usage...') |h %></option>
                        <option value="source"><% $c->i18n->p('trial.tree.trial', 'Trial') |h %> --> <% $c->i18n->p('seedlots.ui.seedlot_find_seedlots_that_are_derived_from_this_trial', 'Seedlot: Find seedlots that are derived from this trial') |h %></option>
                        <option value="sink"><% $c->i18n->p('seedlot_record.ui.seedlot', 'Seedlot') |h %> --> <% $c->i18n->p('seedlots.ui.trial_find_seedlots_that_provided_seed_to_this_trial', 'Trial: Find seedlots that provided seed to this trial') |h %></option>
                        <option value="source|sink"><% $c->i18n->p('seedlots.ui.either_of_the_above', 'Either of the above') |h %></option>
                    </select>
                </div>
            </div>
        </div>

    </form>
    <div style="text-align: center">
        <button class="btn btn-primary" id="submit_seedlot_search"><% $c->i18n->p('seedlots.ui.search', 'Search') |h %></button>
    </div>
</div>
</&>

<div style="text-align: center">
    <% $c->i18n->p('seedlots.ui.enter_search_terms_and_click_the_search_button_to_view_results', 'Enter search terms and click the "Search" button to view results.') |h %>
</div>

<br />
<br />
<br />
<div style="overflow:scroll">
    <table id="available_seedlots_table" class="table table-hover table-striped table-bordered">
    </table>
</div>

<hr>

<textarea readonly id="available_seedlots_to_list" style="display:none">
</textarea>
<div id="available_seedlots_add_to_list">
</div>

        </div>
    </div>
</div>
</&>

<&| /page/info_section.mas, anchor_title => "Mark seedlots as DISCARDED using a list", title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.mark_seedlots_as_status_using_a_list', 'Mark seedlots as %{status} using a list', {status => 'DISCARDED'})),  collapsible => 1, collapsed=>1 &>
% if ($user_role eq "curator" ) {
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-sm btn-default" style="margin:3px" id ="discard_seedlot_usage_info" name = "discard_seedlot_usage_info"><% $c->i18n->p('seedlots.ui.usage_help', 'Usage Help') |h %> <span class="glyphicon glyphicon-question-sign"></span></button><button class="btn btn-sm btn-primary" style="margin:3px" id="discard_seedlot_link"><% $c->i18n->p('seedlots.ui.mark_seedlots_as_discarded', 'Mark Seedlots as Discarded') |h %></button>
            </div>
        </div>
    </div>
% } else {
    <% $c->i18n->p('seedlots.ui.you_need_to_be_logged_in_or_you_do_not_have_sufficient_privilege.5e7cc40', 'You need to be logged in or you do not have sufficient privileges to mark seedlots as %{status} using lists.', {status => 'DISCARDED'}) |h %>
% }
</&>

<&| /page/info_section.mas, anchor_title => "Delete seedlots using a list", title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.delete_seedlots_using_a_list', 'Delete seedlots using a list')),  collapsible => 1, collapsed=>1 &>
% if ($user_role eq "curator" ) {
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-sm btn-primary" style="margin:3px" id="delete_seedlots_link"><% $c->i18n->p('seedlots.ui.delete_seedlots_using_a_list', 'Delete seedlots using a list') |h %></button>
            </div>
        </div>
    </div>
% } else {
    <% $c->i18n->p('seedlots.ui.you_need_to_be_logged_in_or_you_do_not_have_sufficient_privilege.6e34ec8', 'You need to be logged in or you do not have sufficient privileges to delete seedlots.') |h %>
% }
</&>


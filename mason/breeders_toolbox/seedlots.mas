
<%args>
$timestamp
$preferred_species
$editable_stock_props => {}
$editable_stock_props_definitions => {}
$programs
$locations
$crossing_trials
$maintenance_enabled => undef
$user_role => undef
$default_seedlot_material_type => undef
</%args>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.available_seedlots', 'Available Seedlots')) &>

<style>
.ui-autocomplete {
    z-index: 5000;
}
</style>

  <& /util/import_javascript.mas, classes => [ 'bootstrap_min.js', 'jquery.iframe-post-form','CXGN.List','CXGN.BreedersToolbox.Accessions', 'CXGN.BreedersToolbox.UploadPedigrees', 'jquery', 'jquery.dataTables', 'CXGN.BreedersToolbox.Crosses', 'jqueryui' ] &>

<&| /page/info_section.mas, anchor_title => "About Seedlots", title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.about_seedlots', 'About Seedlots')),  collapsible => 1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <b><p><% $c->i18n->p('seedlots.ui.what_are_seedlots', 'What are seedlots?') |h %></p></b>
                <ul>
                <li><% $c->i18n->p('seedlots.ui.seedlots_represent_physical_plant_materials_in_packets_container', 'Seedlots represent physical plant materials in packets/containers.') |h %></li>
                <li><% $c->i18n->p('seedlots.ui.plant_material_can_be_seed_root_clone_plant_tissue_culture_or_ga', 'Plant material can be seed, root, clone, plant, tissue culture or gametophyte.') |h %></li>
                <li><% $c->i18n->p('seedlots.ui.if_you_would_like_to_set_a_default_material_type_for_seedlots_pl', 'If you would like to set a default material type for seedlots, please contact us.') |h %></li>
                <li><% $c->i18n->p('seedlots.ui.these_materials_can_be_from_crosses_or_for_named_accessions', 'These materials can be from crosses or for named accessions.') |h %></li>
                <li><% $c->i18n->p('seedlots.ui.seedlots_can_have_a_specific_location_box_column_weight_g_and_co', 'Seedlots can have a specific location, box, %{column_weight_g}, and count.', {column_weight_g => 'weight(g)'}) |h %></li>
                <li><% $c->i18n->p('seedlots.ui.plant_material_can_be_transferred_into_and_out_of_a_seedlot_such', 'Plant material can be transferred into and out of a seedlot. Such as from a seedlot into a plot.') |h %></li>
                <li><% $c->i18n->p('seedlots.ui.seedlots_can_belong_to_breeding_programs_and_organizations', 'Seedlots can belong to breeding programs and organizations.') |h %></li>
                </ul>

                <b><p><% $c->i18n->p('seedlots.ui.how_do_i_inventory_my_seed', 'How do I inventory my seed?') |h %></p></b>
                <ul>
                <li><% $c->i18n->p('seedlots.ui.make_sure_your_seedlots_are_in_the_database_use_add_new_seedlot_', 'Make sure your seedlots are in the database. Use "Add New Seedlot" to add a single seedlot or "Upload New Seedlots" to add many.') |h %></li>
                <li><% $c->i18n->p('seedlots.ui.make_sure_your_seedlots_are_barcoded_you_can_print_these_barcode', 'Make sure your seedlots are barcoded. You can print these barcodes from the database.') |h %></li>
                <li><% $c->i18n->p('seedlots.ui.the_inventory_app_is_currently_not_available_but_you_can_continu', 'The inventory app is currently not available but you can continue using it if it is installed on your tablet device.') |h %>
                <!-- li>3) Use the "Inventory" Android Application to scan seedlot barcodes and record weight. Then click "Upload Inventory" on the Manage Seedlots page to upload this info into the database. If you do not want to use the Inventory Android Application you can create your own CSV file and upload that.</li --><!-- the app is currently not available - re-instate when it is available again -->
                <!-- li><b>For more info about the "Seed Inventory" Android Application go to <a href="https://play.google.com/store/apps/details?id=org.wheatgenetics.inventory/">Inventory</a>.</b></li -->
                <% $c->i18n->p('seedlots.ui.it_is_also_possible_to_manually_enter_a_transaction_by_going_to_', 'It is also possible to manually enter a transaction by going to the seedlot detail page and clicking "Add New Transaction".') |h %></li>
                </ul>
            </div>
        </div>
    </div>
</&>

<%perl>
    my $maintenance_button = $maintenance_enabled ? ' <button onclick="location.href=\'/breeders/seedlot/maintenance\'" class="btn btn-sm btn-primary" style="margin:3px" name="seedlot_record_maintenance">' . HTML::Entities::encode_entities($c->i18n->p('seedlot_maintenance.ui.title', 'Seedlot Maintenance')) . '</button>' : '';
    my $seedlot_subtitle = !!$c->user()
        ? '<div class="btn-group"><button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">' . HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.create_seedlot_s', 'Create Seedlot(s)')) . '&nbsp;<span class="caret"></span></button><ul class="dropdown-menu"><li><a href="#" name="add_seedlot_button">' . HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.add_new_seedlot', 'Add New Seedlot')) . '</a></li><li><a href="#" name="seedlot_bulk_upload">' . HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.upload_seedlots.b7849bd', 'Upload Seedlots')) . '</a></li><li><a href="#" name="create_seedlots_trial_button">' . HTML::Entities::encode_entities($c->i18n->p('seedlot.create_seedlots_from_trial', 'Create Seedlots from Trial')) . '</a></li></ul></div>
        <div class="btn-group"><button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">' . HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.add_upload_transactions', 'Add/Upload Transactions')) . '&nbsp;<span class="caret"></span></button><ul class="dropdown-menu"><li><a href="#" name="transactions_upload_link">' . HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.upload_a_file', 'Upload a File')) . '</a></li><li><a href="#" id="add_transactions_using_list_link" name="add_transactions_using_list_link">' . HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.using_a_list', 'Using a List')) . '</a></li><li></ul></div>
        <button class="btn btn-sm btn-primary" style="margin:3px" name="seedlot_upload_inventory">' . HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.upload_inventory.f4c5421', 'Upload Inventory')) . '</button>' . $maintenance_button
        : HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.login_to_add_or_upload_seedlots', 'Login to add or upload seedlots'));
</%perl>
<&| /page/info_section.mas, anchor_title => "Seedlots", title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.seedlots', 'Seedlots')),  collapsible => 1, subtitle => $seedlot_subtitle &>

<br/>


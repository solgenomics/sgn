<& /breeders_toolbox/add_transactions_using_list.mas &>


<script>
// Optional language assets preserve the native workflow and raw data values.
var seedlotI18n = (window.SGN && window.SGN.i18n) || {
    p: function (context, source, variables) {
        return source.replace(/%\{([A-Za-z0-9_]+)\}/g, function (match, name) {
            return variables && Object.prototype.hasOwnProperty.call(variables, name) ? String(variables[name]) : match;
        });
    },
    np: function (context, one, many, count, variables) {
        return this.p(context, count === 1 ? one : many, variables);
    }
};
function seedlotHTML(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, function (character) {
        return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[character];
    });
}
// The locale is carried only by these source-traced, same-origin core routes.
function _sgnSeedlotLocaleHeaders(url) {
    try {
        var guardedURL = new URL(url, window.location.href);
        if (guardedURL.origin !== window.location.origin) return {};
        var admitted = /^\/ajax\/breeders\/(?:seedlots|seedlot\/[0-9]+(?:\/(?:edit|delete|transactions|transaction\/(?:add|[0-9]+(?:\/(?:edit|delete))?)))?|seedlot\/(?:discard|undo_discard)|seedlot-create|seedlot-upload|seedlot-inventory-upload|upload_transactions|add_transactions_using_list)\/?$/.test(guardedURL.pathname)
            || /^\/ajax\/seedlots\/(?:verify_delete_by_list|confirm_delete_by_list)$/.test(guardedURL.pathname)
            || /^\/ajax\/stock\/stock_related_seedlots\/[0-9]+$/.test(guardedURL.pathname)
            || /^\/ajax\/manage_accessions\/population_seedlots\/[0-9]+$/.test(guardedURL.pathname)
            || /^\/ajax\/accessions\/possible_seedlots$/.test(guardedURL.pathname)
            || /^\/ajax\/breeders\/program\/[0-9]+\/seedlots$/.test(guardedURL.pathname)
            || /^\/ajax\/breeders\/trial\/[0-9]+\/(?:seedlots_from_crossingtrial|seedlots|upload_used_seedlots)$/.test(guardedURL.pathname)
            || guardedURL.pathname === '/breeders/download_population_seedlots_action';
        if (!admitted) return {};
        var root = typeof document !== 'undefined' && document.documentElement;
        var runtime = window.SGN && window.SGN.i18n;
        var requested = root && typeof root.getAttribute === 'function' && root.getAttribute('data-sgn-locale');
        var locale = requested || (runtime && runtime.requestedLocale) || (root && root.lang) || (runtime && runtime.locale) || 'en';
        return {'X-SGN-Locale': typeof locale === 'string' && /^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$/.test(locale) ? locale : 'en'};
    } catch (error) {
        return {};
    }
}
function _sgnSeedlotLocaleURL(url) {
    try {
        var headers = _sgnSeedlotLocaleHeaders(url);
        if (!headers['X-SGN-Locale']) return url;
        var guardedURL = new URL(url, window.location.href);
        guardedURL.searchParams.set('lang', headers['X-SGN-Locale']);
        return guardedURL.pathname + guardedURL.search + guardedURL.hash;
    } catch (error) {
        return url;
    }
}

jQuery(document).ready(function(){
    jQuery("#search_seedlot_form_seedlot_name").autocomplete({
       source: '/ajax/stock/seedlot_name_autocomplete',
    });
    jQuery("#search_seedlot_form_trial_name").autocomplete({
        source: '/ajax/trials/trial_autocomplete'
    });

    get_select_box('material_types', 'search_seedlot_form_material_type_div', { 'name' : 'search_seedlot_form_material_type', 'id' : 'search_seedlot_form_material_type', 'empty': 1 });


    var seedlots_table;

    //run the query only when the search button is clicked
    jQuery('#submit_seedlot_search').click( function() {
        if (seedlots_table) { seedlots_table.destroy() };
        seedlots_table = jQuery('#available_seedlots_table').DataTable({
            'searching' : false,
            'ordering'  : false,
            'processing': true,
            'serverSide': true,
            'lengthMenu': [10,20,50,100,1000],

            columns: [
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.seedlot_name.8bbaf6d", "Seedlot Name")), "data": null, "render": function ( data, type, row ) { return "<a href='/breeders/seedlot/"+row.seedlot_stock_id+"'>"+seedlotHTML(row.seedlot_stock_uniquename)+"</a>"; } },
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.breeding_program.a79d70a", "Breeding Program")), "data": "breeding_program_name", "render": function (data, type, row) { return type === "display" ? seedlotHTML(data) : data; } },
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.contents.d1ce6ee", "Contents")), "data": "contents_html" },
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.material_type.b9881bc", "Material Type")), "data": "material_type", "render": function (data, type, row) { return type === "display" ? seedlotHTML(data) : data; } },
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.location.5cf58de", "Location")), "data": "location", "render": function (data, type, row) { return type === "display" ? seedlotHTML(data) : data; } },
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.count", "Count")), "data": "count" },
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.weight_g.3319361", "Weight (g)")), "data": "weight_gram" },
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.submitters", "Submitters")), "data": "owners_string" },
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.organization.989e84c", "Organization")), "data": "organization", "render": function (data, type, row) { return type === "display" ? seedlotHTML(data) : data; } },
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.box", "Box")), "data": "box", "render": function (data, type, row) { return type === "display" ? seedlotHTML(data) : data; } },
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.quality.e77b76f", "Quality")), "data": "seedlot_quality", "render": function (data, type, row) { return type === "display" ? seedlotHTML(data) : data; } },
                { title: seedlotHTML(seedlotI18n.p("seedlots.ui.delete", "Delete")), "data": "null", "render": function ( data, type, row ) { return "<a onclick='removeSeedlot("+row.seedlot_stock_id+")' >X</a>"; } },
                { title: "", "data": "seedlot_stock_uniquename"}
            ],
            'ajax': { 'url': '/ajax/breeders/seedlots',
                'headers': _sgnSeedlotLocaleHeaders('/ajax/breeders/seedlots'),
                'data': function(d) {
                    d.seedlot_name  = jQuery('#search_seedlot_form_seedlot_name').val();
                    d.breeding_program = jQuery('#search_seedlot_form_breeding_program').val();
                    d.minimum_count   = jQuery('#search_seedlot_form_minimum_count').val();
                    d.minimum_weight   = jQuery('#search_seedlot_form_minimum_weight').val();
                    d.location     = jQuery('#search_seedlot_form_location').val();
                    d.box_name = jQuery('#search_seedlot_form_box_name').val();
                    d.contents_accession = jQuery('#search_seedlot_form_contents_accession').val();
                    d.contents_cross = jQuery('#search_seedlot_form_contents_cross').val();
                    d.exact_accession = jQuery('#exact_accession').is(":checked") ? 1 : 0;
                    d.exact_cross = jQuery('#exact_cross').is(":checked") ? 1 : 0;
                    d.quality = jQuery('#search_seedlot_form_quality').val();
                    d.only_good_quality = jQuery('#search_seedlot_form_only_good_quality_checkbox').is(":checked") ? 1 : 0;
                    d.trial_name = jQuery('#search_seedlot_form_trial_name').val();
                    d.trial_usage = jQuery('#search_seedlot_form_trial_usage').val();
                    d.material_type = jQuery('#search_seedlot_form_material_type').val();
                }
            },
        });

        seedlots_table.draw();
        seedlots_table.column(12).visible(false);

    });


    jQuery('#available_seedlots_table').on( 'draw.dt', function () {
        var seedlot_names = seedlots_table.column(12).data();
        var names = "";

        for (var i = 0; i < seedlot_names.length; i++) {
            names += seedlot_names[i]+'\n';
        }

        jQuery('#available_seedlots_to_list').val(names);
        addToListMenu('available_seedlots_add_to_list', 'available_seedlots_to_list', {
            listType: 'seedlots'
        });
    });

    jQuery('#search_seedlot_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            jQuery('#submit_seedlot_search').click();
        }
    });
});

function removeSeedlot(seedlot_stock_id){
    if (confirm(seedlotI18n.p("seedlots.ui.are_you_sure_you_want_to_delete_this_seedlot", "Are you sure you want to delete this seedlot?"))){
        jQuery.ajax({
            url: '/ajax/breeders/seedlot/'+seedlot_stock_id+'/delete',
            headers: _sgnSeedlotLocaleHeaders('/ajax/breeders/seedlot/'+seedlot_stock_id+'/delete'),
            beforeSend: function(){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    alert(seedlotI18n.p("seedlots.ui.the_seedlot_has_been_deleted", "The seedlot has been deleted."));
                    location.reload();
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert(seedlotI18n.p("seedlots.ui.an_error_occurred_deleting_seed_lot", "An error occurred deleting seed lot"));
            }
        });
    }
}

</script>

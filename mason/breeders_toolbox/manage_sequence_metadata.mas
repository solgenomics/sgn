
<%args>
</%args>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('genotype.sequence_metadata.manage_title', 'Manage Sequence Metadata')) &>

<div>

<%perl>
    my $buttons_html = "<button class='btn btn-primary' style='margin:3px' id='upload_smd'>" . HTML::Entities::encode_entities($c->i18n->p('genotype.sequence_metadata.upload', 'Upload Sequence Metadata')) . "</button>";
    $buttons_html .= "<button class='btn btn-info' style='margin:3px' id='search_smd'>" . HTML::Entities::encode_entities($c->i18n->p('global.sequence_metadata.title', 'Search Sequence Metadata')) . "</button>";
</%perl>

<& /tools/sequence_metadata/upload_sequence_metadata_workflow.mas &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => "<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p('genotype.sequence_metadata.section', 'Sequence Metadata')) . "</h4>", info_section_anchor_title => "Sequence Metadata", info_section_subtitle => $c->i18n->p('genotype.sequence_metadata.subtitle', 'Upload and query sequence metadata.'), buttons_html => $buttons_html, icon_class => undef, col1_width_class => "col-sm-0", col2_width_class => "col-sm-12", info_section_id => "manage_sequence_metadata" &>

</div>


<script type="text/javascript">
jQuery(document).ready(function() {
    jQuery('#search_smd').click(function() {
        window.location = "/search/sequence_metadata";
        return false;
    });
});
</script>

<%once>
use HTML::Entities ();
</%once>

<%once>
use HTML::Entities ();
</%once>

<%args>
$facilities
</%args>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial' ] &>

<div class="modal fade" id="upload_genotypes_qc_dialog" name="upload_genotypes_qc_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypesQCDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypesQCDialog"><% $c->i18n->p("genotype.plate.upload_genotypes_qc", "Upload Genotypes QC") |h %></h4>
            </div>
            <div class="modal-body">
                <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_genotypes_qc_form" name="upload_genotypes_qc_form" action="/ajax/genotype_qc/upload">

                    <div class="container-fluid">

                        <&| /util/workflow.mas, id=> "upload_genotypes_qc_workflow" &>
                            <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p("cross.ui.intro", "Intro")) &>
                                <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("genotype.plate.this_workflow_will_guide_you_through_genotype_qc", "This workflow will guide you through genotype QC")) &>

                                <ul>
                                    <li><% $c->i18n->p("genotype.plate.genotype_qc_does_not_save_your_genotypes_in_the_database", "Genotype QC does not save your genotypes in the database, it only scans them against genotyping protocols already saved in the database.") |h %></li>
                                    <li><% $c->i18n->p("genotype.plate.to_actually_store_data_into_the_database_please_use_upload", "To actually store data into the database, please use \"Upload Genotyping Data\".") |h %></li>
                                    <li><% $c->i18n->p("genotype.plate.the_marker_names_should_be_exactly_the_marker_names_that", "The marker names should be exactly the marker names that you want to compare against and not any other ID") |h %></li>
                                </ul>

                                <br/><br/>
                                <div style="text-align: center">
                                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;"><% $c->i18n->p("cross.ui.go_to_next_step", "Go to Next Step") |h %></button>
                                </div>
                            </&>

                            <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p("genotype.plate.genotype_protocol", "Genotype Protocol")) &>
                                <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("genotype.plate.select_the_genotyping_protocol_you_want_to_compare_against", "Select the genotyping protocol you want to compare against")) &>

                                <ul>
                                    <li><% $c->i18n->p("genotype.plate.select_a_genotyping_protocol_in_the_database_against_which_you", "Select a genotyping protocol in the database against which you want to compare genotypes against.") |h %></li>
                                </ul>
                                <br/><br/>

                                <div id="genotype_qc_selected_protocol">
                                </div>

                                <br/><br/>
                                <div style="text-align: center">
                                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;"><% $c->i18n->p("cross.ui.go_to_next_step", "Go to Next Step") |h %></button>
                                </div>
                            </&>

                            <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p("genotype.plate.genotype_info", "Genotype Info")) &>
                                <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("genotype.plate.provide_genotype_information", "Provide genotype information")) &>
                                <br/><br/>

                                <div class="row">
                                    <div class="col-sm-4">
                                        <&| /page/explanation.mas, title=>HTML::Entities::encode_entities($c->i18n->p("accession.files.template_info", 'Template information')) &>
                                            <p>
                                                <b><% $c->i18n->p("accessions.dialog.file_format", "File format information") |h %></b>
                                                <br>
                                                <a id="upload_genotype_qc_spreadsheet_info_format"><% $c->i18n->p("program.profile_upload.step.file_format", "File format") |h %></a>
                                            </p>
                                        </&>
                                    </div>
                                    <div class="col-sm-8">
                                        <br/>
                                        <div class="panel panel-default">
                                            <div class="panel-body">
                                                <div class="form-group">
                                                    <label class="col-sm-6 control-label"><% $c->i18n->p("genotype.plate.select_file", "Select File:") |h %> </label>
                                                    <div class="col-sm-6">
                                                        <input type="file" name="upload_genotype_qc_file_input" id="upload_genotype_qc_file_input" encoding="multipart/form-data" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <br/><br/>
                                <div style="text-align: center">
                                    <button class="btn btn-primary" id="genotype_qc_upload_submit_button"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
                                </div>
                            </&>
                            <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p("global.gem_experiment_search.results", "Results")) &>
                                <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("genotype.plate.a_similarity_matrix_between_the_samples_in_your_file_and", "A similarity matrix between the samples in your file and the saved genotypes for the protocol you selected")) &>

                                <div id="genotype_qc_result_div"></div>

                            </&>
                        </&>

                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_genotype_qc_spreadsheet_info_format_dialog" name="upload_genotype_qc_spreadsheet_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadGenotypeQCInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadGenotypeQCInfoDialog"><% $c->i18n->p("genotype.plate.upload_genotype_qc_template_information", "Upload Genotype QC Template Information") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% $c->i18n->p("genotype.plate.this_is_for_uploading_genotype_qc_data", "This is for uploading genotype QC data.") |h %></b>
                    <br/>
                    <b><% $c->i18n->p("genotype.plate.please_use_csv_formatted_files_66cd69", "Please use CSV formatted files") |h %></b>
                    <p>
                    <br />
                    <b><% $c->i18n->p("accessions.template.header", "Header:") |h %></b>
                    <br>

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>SampleName.LabID</td>
                                <td>Separate Column For Each Marker Name (e.g. S12_7926132)</td>
                            </tr>
                        </tbody>
                    </table>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_upload_genotyping_qc_spreadsheet_info_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>


<style>

.ui-autocomplete { z-index:2147483647; }

</style>

<script>
jQuery(document).ready(function(){

    jQuery('button[name=upload_genotyping_data_qc_link]').click(function(){
        jQuery('#upload_genotypes_qc_dialog').modal('show');
    });

    get_select_box('genotyping_protocol','genotype_qc_selected_protocol', {'empty':'1', 'id':'genotype_qc_protocol_id', 'name':'genotype_qc_protocol_id'});

    jQuery('#upload_genotype_qc_spreadsheet_info_format').click(function(){
        jQuery('#upload_genotype_qc_spreadsheet_info_format_dialog').modal('show');
    });

    jQuery('#genotype_qc_upload_submit_button').click(function () {
        submit_genotype_data_qc_upload()
    });

    function submit_genotype_data_qc_upload() {
        jQuery('#working_modal').modal('show');
        jQuery("#upload_genotypes_qc_form").submit();
    }

    jQuery('#upload_genotypes_qc_form').iframePostForm({
        json: true,
        post: function () {
        },
        complete: function (response) {
            //console.log(response);
            jQuery('#working_modal').modal('hide');
            if (response.success) {

                var html = ("<table class=\"table table-hover\"><thead><tr><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.samples_in_file", "Samples In File") : "Samples In File")).html() + "</th>");
                for(var i=0; i<response.protocol_stock_names.length; i++) {
                    html = html + '<th>'+response.protocol_stock_names[i]+'</th>';
                }
                html = html + '</tr></thead><tbody>';
                for(var j=0; j<response.users_stock_names.length; j++) {
                    html = html + '<tr><td>'+response.users_stock_names[j]+'</td>';
                    for(var k=0; k<response.protocol_stock_names.length; k++) {
                        var distance = response.distance_matrix[response.users_stock_names[j]][response.protocol_stock_names[k]];
                        html = html + '<td>'+distance+'</td>';
                    }
                    html = html + '</tr>';
                }
                html = html + '</tbody></table>';
                jQuery('#genotype_qc_result_div').html(html);

                Workflow.complete('#genotype_qc_upload_submit_button');
                Workflow.focus("#upload_genotypes_qc_workflow", 3);
            }
        }
    });

});
</script>

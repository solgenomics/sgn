

<%args>
$trial_id
$genotyping_plate_format => '96'
</%args>

<& /util/import_javascript.mas, classes => [  ] &>


<div id="trial_plate_layout_html1">
<div class="well">
<% $c->i18n->p("accession.files.loading_upper", "[LOADING...]") |h %>
</div>
</div>

<script>

jQuery(document).ready(function () {

    jQuery.ajax ({
        url : '/ajax/breeders/trial/'+<% $trial_id %>+'/design',
        beforeSend: function() {
            jQuery("#working_modal").modal("show");
        },
        success: function(response){
            // console.log(response);
            jQuery("#working_modal").modal("hide");
            var trial_plate_layout_html = ("<table class='table table-hover table-condensed table-bordered' id='trial_plate_layout_table1'><thead><tr><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.well", "Well") : "Well")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.related_stock.header.accession_name", "Accession Name") : "Accession Name")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.sample_name", "Sample Name") : "Sample Name")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.volume_ul", "Volume (ul)") : "Volume (ul)")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.concentration_ng", "Concentration(ng)") : "Concentration(ng)")).html() + "</th></tr></thead><tbody>");

            var col_max = 1;
            if (<% $genotyping_plate_format %> == '96'){
                col_max = 13;
            }
            if (<% $genotyping_plate_format %> == '384'){
                col_max = 25;
            }

            var rows;
            if (<% $genotyping_plate_format %> == '96'){
                rows = "ABCDEFGH".split("");
            }
            if (<% $genotyping_plate_format %> == '384'){
                rows = "ABCDEFGHIJKLMNOP".split("");
            }

            jQuery.each(rows, function(row) {
                for (col=1; col<col_max; col++) {
                    var formatted_col = (col < 10 ? '0' : '') + col;
                    var well = rows[row] + formatted_col;
                    if (response.design[well]) {
                        if (response.design[well].accession_name) {
                            var accession_name = response.design[well].accession_name;
                            var sample_nsame = response.design[well].plot_name;
                            var volume = response.design[well].volume;
                            var concentration = response.design[well].concentration;
                            trial_plate_layout_html = trial_plate_layout_html + "<tr><td>" + well + "</td><td>" + sample_nsame + "</td><td>" + accession_name + "</td><td>" + volume + "</td><td>" + concentration + "</td></tr>";
                        }
                    }
                }
            });

            trial_plate_layout_html = trial_plate_layout_html + "</tbody></table>";
            jQuery('#trial_plate_layout_html1').empty();
            jQuery('#trial_plate_layout_html1').html(trial_plate_layout_html);
            jQuery('#trial_plate_layout_table1').DataTable();
        },
        error: function(response){
            jQuery("#working_modal").modal("hide");
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.error_retrieving_plate_layout", "Error retrieving plate layout.") : "Error retrieving plate layout."));
        }
    });

});

</script>

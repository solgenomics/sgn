<%once>
use HTML::Entities ();
</%once>

<%args>
$trial_id
</%args>

<div class="well well-sm">

    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, anchor_title => "Uploaded Additional Files", title=>HTML::Entities::encode_entities($c->i18n->p("accession.stock.files.heading", "Uploaded Additional Files")), is_subsection => 1, collapsible=>1, collapsed=>0, subtitle=>("<button class=\"btn btn-sm btn-primary\" style=\"margin:3px\" id=\"trial_upload_additional_files_link\">" . HTML::Entities::encode_entities($c->i18n->p("accession.stock.files.upload", "Upload Additional Files")) . "</button>") &>

            <& /breeders_toolbox/trial/upload_additional_file.mas, trial_id => $trial_id &>

            </&><!-- closes uploaded additional file section -->
        </div>
    </div>

</div><!-- closes well -->


<%doc>

=head1 NAME

/breeders_toolbox/folder.mas - a mason component to display a folder detail page

=head1 AUTHOR

Nicolas Morales nm529@cornell.edu

=cut

</%doc>

<%args>
$folder_id
$folder_name
$folder_description
$trials
$crossing_trials
$genotyping_trials
$genotyping_projects
$analyses_trials
$tracking_activities
$child_folders
$project_parent => undef
$breeding_program => undef
$folder_for_trials
$folder_for_crosses
$folder_for_genotyping_trials
$folder_for_genotyping_projects
$folder_for_tracking_activities
$folder_for_transformations
$has_child_folders => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui', 'jquery.iframe-post-form', 'CXGN.Trial', 'CXGN.BreedersToolbox.HTMLSelect' ] &>

<br/>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('folder.detail.page_title', 'Folder detail for %{folder_name}', {folder_name => $folder_name})) &>

<& /breeders_toolbox/folder/folder_set.mas, folder_id=>$folder_id, folder_name=>$folder_name, breeding_program_id=>$breeding_program->project_id(), breeding_program_name=>$breeding_program->name(), folder_for_trials => $folder_for_trials, folder_for_crosses => $folder_for_crosses, folder_for_genotyping_trials => $folder_for_genotyping_trials, folder_for_genotyping_projects => $folder_for_genotyping_projects , folder_for_tracking_activities => $folder_for_tracking_activities, folder_for_transformations => $folder_for_transformations &>
<& /breeders_toolbox/folder/folder_move.mas, breeding_program_id=>$breeding_program->project_id(), breeding_program_name=>$breeding_program->name()   &>
<& /breeders_toolbox/folder/edit_folder_name.mas, trial_id=>$folder_id, trial_name=>$folder_name, trial_type=>"Folder" &>
<& /breeders_toolbox/folder/folder_category_set.mas, folder_id=>$folder_id, folder_name=>$folder_name, folder_for_trials=>$folder_for_trials, folder_for_crosses=>$folder_for_crosses, folder_for_genotyping_trials=>$folder_for_genotyping_trials, folder_for_genotyping_projects=>$folder_for_genotyping_projects , folder_for_tracking_activities=>$folder_for_tracking_activities, folder_for_transformations=>$folder_for_transformations&>

<div>

  <ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="active"><a href="#trials" aria-controls="trials" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-leaf text-success"></span>&nbsp;&nbsp;&nbsp;<% $c->i18n->p('folder.detail.tab.trials', 'Trials') |h %></a></li>
    <li role="presentation"><a href="#analyses" aria-controls="analyses" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-stats text-success"></span>&nbsp;&nbsp;&nbsp;<% $c->i18n->p('folder.detail.tab.analyses', 'Analyses') |h %></a></li>
    <li role="presentation"><a href="#crosses" aria-controls="crosses" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-grain text-success"></span>&nbsp;&nbsp;&nbsp;<% $c->i18n->p('folder.detail.tab.crossing_experiments', 'Crossing Experiments') |h %></a></li>
    <li role="presentation"><a href="#genotyping_trials" aria-controls="genotyping_trials" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-th text-success"></span>&nbsp;&nbsp;&nbsp;<% $c->i18n->p('folder.detail.tab.genotyping_plates', 'Genotyping Plates') |h %></a></li>
    <li role="presentation"><a href="#genotyping_projects" aria-controls="genotyping_projects" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-th text-success"></span>&nbsp;&nbsp;&nbsp;<% $c->i18n->p('folder.detail.tab.genotyping_projects', 'Genotyping Projects') |h %></a></li>
    <li role="presentation"><a href="#tracking_activities" aria-controls="tracking_activities" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-list-alt text-success"></span>&nbsp;&nbsp;&nbsp;<% $c->i18n->p('folder.detail.tab.tracking_activities', 'Tracking Activities') |h %></a></li>
    <li role="presentation"><a href="#folders" aria-controls="folders" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-folder-open text-danger"></span>&nbsp;&nbsp;&nbsp;<% $c->i18n->p('folder.detail.tab.folders', 'Folders') |h %></a></li>
    <li role="presentation"><a href="#breeding_program" aria-controls="breeding_program" role="tab" data-toggle="tab"><span class="glyphicon glyphicon-briefcase text-info"></span>&nbsp;&nbsp;&nbsp;<% $c->i18n->p('folder.detail.tab.breeding_program', 'Breeding Program') |h %></a></li>
  </ul>

  <div class="tab-content">
    <div role="tabpanel" class="tab-pane fade in active" id="trials">
      <div class="well">
        <h3><% $c->i18n->p('folder.detail.trials_in_folder', 'Trials in Folder') |h %></h3>
        <table name="folder_datatables_table" class="table table-hover table-bordered">
        <thead><tr><th><% $c->i18n->p('folder.detail.trial_name', 'Trial Name') |h %></th></tr></thead>
        <tbody>
% my @trial_ids;
% foreach (@$trials) {
    <tr><td><a href="/breeders/trial/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% push @trial_ids, $_->folder_id();
% }
% my $trial_ids = join ',', @trial_ids;
        </tbody>
        </table>

        <br/>
        <button class="btn btn-primary" id="trial_download_phenotypes_button"><% $c->i18n->p('folder.detail.download_phenotypes', 'Download Phenotypes') |h %></button>

      </div>
    </div>

    <div role="tabpanel" class="tab-pane fade" id="analyses">
      <div class="well">
        <h3><% $c->i18n->p('folder.detail.analyses_in_folder', 'Analyses in Folder') |h %></h3>
        <table name="folder_datatables_table" class="table table-hover table-bordered">
        <thead><tr><th><% $c->i18n->p('folder.detail.analyses_name', 'Analyses Name') |h %></th></tr></thead>
        <tbody>
% foreach (@$analyses_trials) {
    <tr><td><a href="/analyses/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% }
        </tbody>
        </table>
      </div>
    </div>

    <div role="tabpanel" class="tab-pane fade" id="crosses">
      <div class="well">
        <h3><% $c->i18n->p('folder.detail.crosses_in_folder', 'Crosses in Folder') |h %></h3>
        <table name="folder_datatables_table" class="table table-hover table-bordered">
        <thead><tr><th><% $c->i18n->p('folder.detail.cross_unique_id', 'Cross Unique ID') |h %></th></tr></thead>
        <tbody>
% foreach (@$crossing_trials) {
            <tr><td><a href="/breeders/trial/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% }
        </tbody>
        </table>
      </div>
    </div>

    <div role="tabpanel" class="tab-pane fade" id="genotyping_projects">
      <div class="well">
        <h3><% $c->i18n->p('folder.detail.genotyping_projects_in_folder', 'Genotyping Projects in Folder') |h %></h3>
        <table name="folder_datatables_table" class="table table-hover table-bordered">
        <thead><tr><th><% $c->i18n->p('folder.detail.genotyping_project_name', 'Genotyping Project Name') |h %></th></tr></thead>
        <tbody>
% foreach (@$genotyping_projects) {
            <tr><td><a href="/breeders/trial/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% }
        </tbody>
        </table>
      </div>
    </div>

    <div role="tabpanel" class="tab-pane fade" id="tracking_activities">
        <div class="well">
            <h3><% $c->i18n->p('folder.detail.projects_in_folder', 'Projects in Folder') |h %></h3>
            <table name="folder_datatables_table" class="table table-hover table-bordered">
                <thead><tr><th><% $c->i18n->p('folder.detail.tracking_project_name', 'Tracking Activities Project Name') |h %></th></tr></thead>
                <tbody>
% foreach (@$tracking_activities) {
                    <tr><td><a href="/breeders/trial/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% }
                </tbody>
            </table>
        </div>
    </div>

    <div role="tabpanel" class="tab-pane fade" id="genotyping_trials">
      <div class="well">
        <h3><% $c->i18n->p('folder.detail.genotyping_plates_in_folder', 'Genotyping Plates in Folder') |h %></h3>
        <table name="folder_datatables_table" class="table table-hover table-bordered">
        <thead><tr><th><% $c->i18n->p('folder.detail.genotyping_plate_name', 'Genotyping Plate Name') |h %></th></tr></thead>
        <tbody>
% my @genotyping_trial_ids;
% foreach (@$genotyping_trials) {
            <tr><td><a href="/breeders/trial/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% push @genotyping_trial_ids, $_->folder_id();
% }
% my $genotyping_trial_ids = join ',', @genotyping_trial_ids;
        </tbody>
        </table>

        <br/>
        <button class="btn btn-primary" id="folder_download_genotyping_plates_button"><% $c->i18n->p('folder.detail.download_plate_layouts', 'Download Genotyping Plate Layouts') |h %></button>
      </div>
    </div>

    <div role="tabpanel" class="tab-pane fade" id="folders">
      <div class="well">
        <h3><% $c->i18n->p('folder.detail.parent_folder', 'Parent Folder') |h %></h3>
% if ($breeding_program->name() ne $project_parent->name()) {
        <a href="/folder/<% $project_parent->project_id %>" target=_blank><% $project_parent->name() %></a>
% } else {
      <% $c->i18n->p('folder.detail.no_parent_folder', 'No Parent Folder') |h %>
% }
      </div>

      <div class="well">
        <h3><% $c->i18n->p('folder.detail.child_folders', 'Child Folders') |h %></h3>
% if ($has_child_folders) {
        <table class="table table-hover table-bordered">
        <tbody>
% foreach (@$child_folders) {
%   if ($_->folder_type eq 'folder') {
      <tr><td><a href="/folder/<% $_->folder_id() %>" target=_blank><% $_->name() %></a></td></tr>
% }
% }
        </tbody>
        </table>
% } else {
      <% $c->i18n->p('folder.detail.no_child_folders', 'No Child Folders') |h %>
% }
      </div>

      <div class="well">
        <button class="btn btn-primary" id="move_folder_dialog_link"><% $c->i18n->p('folder.detail.move_folder', 'Move folder') |h %></button>
      </div>

    </div>

    <div role="tabpanel" class="tab-pane fade" id="breeding_program">
      <div class="well">
        <h3><% $c->i18n->p('folder.detail.folder_breeding_program', "Folder's Breeding Program") |h %></h3>
        <% $breeding_program->name() %>
      </div>
    </div>

  </div>

</div>

<hr>

<div class="row">
    <div class="col-sm-6">
        <div class="well well-sm">
            <table class="table table-bordered">
                <thead></thead>
                <tbody>
                    <tr>
                        <td><h5><% $c->i18n->p('folder.detail.folder_for_trials', 'Folder For Trials') |h %></h5></td>
% if($folder_for_trials){
                        <td><h4><span class="glyphicon glyphicon-ok"></span></h4></td>
% } else {
                        <td><h4><span class="glyphicon glyphicon-remove"></span></h4></td>
% }

                    </tr>
                    <tr>
                        <td><h5><% $c->i18n->p('folder.detail.folder_for_crosses', 'Folder For Crosses') |h %></h5></td>
% if($folder_for_crosses){
                        <td><h4><span class="glyphicon glyphicon-ok"></span></h4></td>
% } else {
                        <td><h4><span class="glyphicon glyphicon-remove"></span></h4></td>
% }
                    </tr>
                    <tr>
                        <td><h5><% $c->i18n->p('folder.detail.folder_for_genotyping_projects', 'Folder For Genotyping Projects') |h %></h5></td>
% if($folder_for_genotyping_projects){
                        <td><h4><span class="glyphicon glyphicon-ok"></span></h4></td>
% } else {
                        <td><h4><span class="glyphicon glyphicon-remove"></span></h4></td>
% }
                    </tr>
                    <tr>
                        <td><h5><% $c->i18n->p('folder.detail.folder_for_genotyping_plates', 'Folder For Genotyping Plates') |h %></h5></td>
% if($folder_for_genotyping_trials){
                        <td><h4><span class="glyphicon glyphicon-ok"></span></h4></td>
% } else {
                        <td><h4><span class="glyphicon glyphicon-remove"></span></h4></td>
% }
                    </tr>
                    <tr>
                        <td><h5><% $c->i18n->p('folder.detail.folder_for_tracking', 'Folder For Tracking Activities') |h %></h5></td>
% if($folder_for_tracking_activities){
                        <td><h4><span class="glyphicon glyphicon-ok"></span></h4></td>
% } else {
                        <td><h4><span class="glyphicon glyphicon-remove"></span></h4></td>
% }
                    </tr>
                    <tr>
                        <td><h5><% $c->i18n->p('folder.detail.folder_for_transformations', 'Folder For Transformation Projects') |h %></h5></td>
% if($folder_for_transformations){
                        <td><h4><span class="glyphicon glyphicon-ok"></span></h4></td>
% } else {
                        <td><h4><span class="glyphicon glyphicon-remove"></span></h4></td>
% }
                    </tr>

                </tbody>
            </table>
            <button class="btn btn-sm btn-default" id="change_folder_categories_button"><% $c->i18n->p('folder.detail.additional_folder_type', 'Add Additional Folder Type') |h %></button>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="well">
            <center>
<!--
            <button class="btn btn-sm btn-primary" id="open_folder_dialog_link"><% $c->i18n->p('folder.detail.add_trial_analyses', 'Add Trial and Analyses to Folder') |h %></button>
            <br/><br/>
-->
            <button class="btn btn-sm btn-default" id="edit_trial_name"><% $c->i18n->p('folder.detail.rename_folder', 'Rename Folder') |h %></button>&nbsp;&nbsp;&nbsp;&nbsp;
            <button class="btn btn-sm btn-default" id="delete_folder_button"><% $c->i18n->p('folder.detail.delete_folder', 'Delete Folder') |h %></button>
            </center>
        </div>
    </div>
</div>

<& /breeders_toolbox/trial/download_phenotypes_dialog.mas, trial_ids => $trial_ids, dialog_name => $folder_name, dialog_type => 'Folder' &>
<& /breeders_toolbox/genotyping_trials/download_genotyping_trial_layouts_dialogs.mas, genotyping_trial_ids => $genotyping_trial_ids &>

<script>

jQuery(document).ready(function() {

    jQuery("[name=folder_datatables_table]").DataTable();

    jQuery('#delete_folder_button').click( function() {
        if (confirm(window.SGN && SGN.i18n ? SGN.i18n.p('folder.detail.confirm_delete', 'Are you sure you want to delete this folder?') : 'Are you sure you want to delete this folder?')) {
            jQuery.ajax( {
                url: '/ajax/folder/'+<% $folder_id %>+'/delete',
                success: function(response) {
                    if (response.error) {
                        alert(response.error);
                    } else {
                        alert(window.SGN && SGN.i18n ? SGN.i18n.p('folder.detail.deleted', 'Folder successfully deleted.') : 'Folder successfully deleted.');
                        window.location.replace("/breeders/trials");
                    }
                },
                error: function(response) {
                    alert(window.SGN && SGN.i18n ? SGN.i18n.p('folder.detail.delete_error', 'An error occurred trying to delete folder.') : 'An error occurred trying to delete folder.');
                }
            });
        }
    });

});

</script>

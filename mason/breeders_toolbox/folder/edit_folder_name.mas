<%once>
use JSON ();
</%once>
<%args>
$trial_id
$trial_name => undef
$trial_type
</%args>

<div class="modal fade" id="edit_trial_name_dialog" name="edit_trial_name_dialog" tabindex="-1" role="dialog" aria-labelledby="editTrialNameDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('folder.ui.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="editTrialNameDialog"><% $c->i18n->p('folder.edit_name.edit_title', 'Edit Name for %{type}', {type => $trial_type}) |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

	       <form class="form-horizontal" role="form" method="post" id="new_folder_dialog_form" name="new_folder_dialog_form">
	        <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p('folder.edit_name.name_label', '%{type} Name:', {type => $trial_type}) |h %></label>
      	      <div class="col-sm-9" >
                <input name="trial_name_input" placeholder="<% $trial_name %>" id="trial_name_input" class="form-control" type="text" autofocus/>
                <input type="hidden" id="edit_trial_name_trial_id" value="<% $trial_id %>" />
              </div>
	        </div>
	       </form><br/>
         
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" name="edit_name_cancel_button" id="edit_name_cancel_button" data-dismiss="modal"><% $c->i18n->p('folder.edit_name.close', 'Close') |h %></button>
	      <button type="button" class="btn btn-primary" name="edit_name_save_button" id="edit_name_save_button" title="<% $c->i18n->p('folder.edit_name.save', 'Save') |h %>"><% $c->i18n->p('folder.edit_name.save', 'Save') |h %></button>
      </div>
    </div>
  </div>
</div>


<script>

jQuery(document).ready(function() {

  jQuery('#edit_trial_name').click( function () {
    jQuery('#edit_trial_name_dialog').modal("show");
  });
  
  jQuery('#edit_name_save_button').click( function () {
    save_trial_name();
  });

});


function save_trial_name() {
  var trial_id = jQuery('#edit_trial_name_trial_id').val();
  var new_name = jQuery('#trial_name_input').val();
   jQuery.ajax( {
    url: '/ajax/folder/'+trial_id+'/name/',
    type: 'POST',
    data: {'new_name' : new_name},
    success: function(response) {
      if (response.error) {
        alert(response.error);
      }
      else {
        alert(window.SGN && SGN.i18n ? SGN.i18n.p("folder.edit_name.update_success", "Successfully updated folder name") : "Successfully updated folder name");
        jQuery('#edit_trial_name_dialog').modal("hide");
        var detailTitle = window.SGN && SGN.i18n
          ? SGN.i18n.p('folder.edit_name.detail_title', '%{type} detail for %{name}', {type: <% JSON::encode_json($trial_type) %>, name: new_name})
          : <% JSON::encode_json($trial_type) %> + ' detail for ' + new_name;
        jQuery('#pagetitle').empty().append(jQuery('<h3>').text(detailTitle));
      }
    },
    error: function(response) {
      alert(window.SGN && SGN.i18n ? SGN.i18n.p("folder.edit_name.update_error", "An error occurred updating the folder name") : "An error occurred updating the folder name");
    },
  });
}

</script>

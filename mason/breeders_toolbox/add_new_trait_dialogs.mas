<%args>
</%args>

<div class="modal fade" id="add_new_observation_variable_dialog" name="add_new_observation_variable_dialog" tabindex="-1" role="dialog" aria-labelledby="addNewObservationVariableDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addNewObservationVariableDialog"><% $c->i18n->p("phenotype.add_new_observation_variable", "Add New Observation Variable") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "add_new_trait_workflow" &>
                        <&| /util/workflow.mas:step, title=> $c->i18n->p("cross.ui.intro", "Intro") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("phenotype.need_a_new_observation_variable", "Need a new observation variable?")) &>
                            <ul>
                                <li><% $c->i18n->p("phenotype.please_be_sure_the_observation_variable_does_not_currently_exist", "Please be sure the observation variable does not currently exist in the database using the trait search.") |h %></li>
                                <li><% $c->i18n->p("phenotype.having_many_observation_variables_that_are_in_fact_recording_the", "Having many observation variables that are in fact recording the same thing is dangerous and can cause the database data to become fragmented.") |h %></li>
                                <li><% $c->i18n->p("phenotype.an_observation_variable_is_composed_of_a_trait_for_the", "An observation variable is composed of a trait for the attribute being observed, a method describing how the attribute was measured, and a scale indicating the units of the observation.") |h %></li>
                                <li><% $c->i18n->p("phenotype.having_descriptive_observation_variables_is_critical_for_downstream_analysis", "Having descriptive observation variables is critical for downstream analysis.") |h %></li>
                            </ul>

                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" name="add_new_observation_variable_ontology_add_button"><% $c->i18n->p("phenotype.need_a_new_ontology_click_here_first", "Need a new ontology? Click here first.") |h %></button>
                            </center>

                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p("cross.ui.go_to_next_step", "Go to Next Step") |h %></button>
                            </center>
                        </&>

                        <&| /util/workflow.mas:step, title=> $c->i18n->p("accession.usage.header.variable", "Observation Variable") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("phenotype.define_your_observation_variable", "Define your observation variable")) &>

                            <p><% $c->i18n->p("phenotype.an_observation_variable_is_composed_of_a_trait_for_the", "An observation variable is composed of a trait for the attribute being observed, a method describing how the attribute was measured, and a scale indicating the units of the observation.") |h %></p>
                            <hr>

                            <center>
                                <button class="btn btn-primary" name="add_new_observation_variable_ontology_add_button"><% $c->i18n->p("phenotype.need_a_new_ontology_click_here_first", "Need a new ontology? Click here first.") |h %></button>
                            </center>
                            <br/><br/>

                            <form class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.observation_variable_ontology_name", "Observation Variable Ontology Name:") |h %> </label>
                                    <div class="col-sm-9">
                                        <div id="add_new_observation_variable_ontology_select_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_observation_variable_name", "New Observation Variable Name:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_observation_variable_name" name="add_new_observation_variable_name" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> total mass of fruit harvest from a plant using MachineX in kilograms"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_observation_variable_definition", "New Observation Variable Definition:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_observation_variable_definition" name="add_new_observation_variable_definition" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> total mass of fruit harvest from a plant using MachineX in kilograms"/>
                                    </div>
                                </div>
                            </form>
                            <br/>

                            <center>
                                <button class="btn btn-primary" id="add_new_trait_observation_variable_step"><% $c->i18n->p("cross.ui.go_to_next_step", "Go to Next Step") |h %></button>
                            </center>

                        </&>
                        <&| /util/workflow.mas:step, title=> $c->i18n->p("accession.stock.phenotype.header.trait", "Trait") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("phenotype.define_your_trait", "Define your trait")) &>

                            <ul>
                                <li><% $c->i18n->p("phenotype.a_trait_defines_the_attribute_being_measured_it_is_one", "A trait defines the attribute being measured. It is one component of an observation variable; the others are a method and a scale.") |h %></li>
                                <li><% $c->i18n->p("phenotype.here_you_can_select_a_trait_that_already_exists_in", "Here you can select a trait that already exists in an ontology in the database or you can add a new trait into an ontology.") |h %></li>
                            </ul>
                            <hr>

                            <center>
                                <button class="btn btn-primary" name="add_new_observation_variable_ontology_add_button"><% $c->i18n->p("phenotype.need_a_new_ontology_click_here_first", "Need a new ontology? Click here first.") |h %></button>
                            </center>
                            <br/><br/>

                            <form class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.trait_ontology_name", "Trait Ontology Name:") |h %> </label>
                                    <div class="col-sm-9">
                                        <div id="add_new_trait_ontology_select_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.existing_traits_in_selected_ontology", "Existing Traits in Selected Ontology:") |h %> </label>
                                    <div class="col-sm-9">
                                        <div id="add_new_trait_existing_trait_select_div">
                                        </div>
                                    </div>
                                </div>
                                <hr>

                                <div class="well">
                                    <h3><% $c->i18n->p("phenotype.if_the_trait_does_not_exist_in_the_ontology_you", "If the trait does not exist in the ontology you selected above, you can add a new trait into the ontology here.") |h %></h3>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_trait_name", "New Trait Name:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_trait_name" name="add_new_trait_name" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> harvested fruit mass per plant"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_trait_definition", "New Trait Definition:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_trait_definition" name="add_new_trait_definition" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> the total mass of fruit harvested from a plant"/>
                                    </div>
                                </div>
                            </form>

                            <center>
                                <button class="btn btn-primary" id="add_new_trait_trait_step"><% $c->i18n->p("cross.ui.go_to_next_step", "Go to Next Step") |h %></button>
                            </center>

                        </&>
                        <&| /util/workflow.mas:step, title=> $c->i18n->p("phenotype.method.c39272e", "Method") &>
                            <p><% $c->i18n->p("phenotype.a_method_defines_the_how_it_was_measured_measured_it", "A method defines the how it was measured measured. It is one component of an observation variable; the others are a trait and a scale.") |h %></p>
                            <hr>

                            <center>
                                <button class="btn btn-primary" name="add_new_observation_variable_ontology_add_button"><% $c->i18n->p("phenotype.need_a_new_ontology_click_here_first", "Need a new ontology? Click here first.") |h %></button>
                            </center>
                            <br/><br/>

                            <form class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.method_ontology_name", "Method Ontology Name:") |h %> </label>
                                    <div class="col-sm-9">
                                        <div id="add_new_trait_method_ontology_select_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.existing_methods_in_selected_ontology", "Existing Methods in Selected Ontology:") |h %> </label>
                                    <div class="col-sm-9">
                                        <div id="add_new_trait_existing_method_select_div">
                                        </div>
                                    </div>
                                </div>
                                <hr>

                                <div class="well">
                                    <h3><% $c->i18n->p("phenotype.if_the_method_does_not_exist_in_the_ontology_you", "If the method does not exist in the ontology you selected above, you can add a new method into the ontology here.") |h %></h3>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_method_name", "New Method Name:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_trait_method_name" name="add_new_trait_method_name" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> BrandA Mass Balance 0.001g Accuracy"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_method_definition", "New Method Definition:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_trait_method_definition" name="add_new_trait_method_definition" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> BrandA MachineX Mass Balance 0.001g Accuracy"/>
                                    </div>
                                </div>
                            </form>

                            <center>
                                <button type="button" class="btn btn-primary" id="add_new_trait_method_step"><% $c->i18n->p("cross.ui.go_to_next_step", "Go to Next Step") |h %></button>
                            </center>

                        </&>
                        <&| /util/workflow.mas:step, title=> $c->i18n->p("phenotype.scale", "Scale") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("phenotype.define_your_scale", "Define your scale")) &>

                            <center>
                                <button class="btn btn-primary" name="add_new_observation_variable_ontology_add_button"><% $c->i18n->p("phenotype.need_a_new_ontology_click_here_first", "Need a new ontology? Click here first.") |h %></button>
                            </center>
                            <br/><br/>

                            <form class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.scale_ontology_name", "Scale Ontology Name:") |h %> </label>
                                    <div class="col-sm-9">
                                        <div id="add_new_trait_scale_ontology_select_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.existing_scales_in_selected_ontology", "Existing Scales in Selected Ontology:") |h %> </label>
                                    <div class="col-sm-9">
                                        <div id="add_new_trait_existing_scale_select_div">
                                        </div>
                                    </div>
                                </div>
                                <hr>

                                <div class="well">
                                    <h3><% $c->i18n->p("phenotype.if_the_scale_does_not_exist_in_the_ontology_you", "If the scale does not exist in the ontology you selected above, you can add a new scale into the ontology here.") |h %></h3>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_scale_name", "New Scale Name:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_trait_scale_name" name="add_new_trait_scale_name" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> mass in kilograms"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_scale_definition", "New Scale Definition:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_trait_scale_definition" name="add_new_trait_scale_definition" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> the mass in kilograms"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_scale_format", "New Scale Format:") |h %> </label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="add_new_trait_scale_format" name="add_new_trait_scale_format" >
                                            <option value=""><% $c->i18n->p("phenotype.select_one", "Select One") |h %></option>
                                            <option value="qualitative"><% $c->i18n->p("phenotype.qualitative", "qualitative") |h %></option>
                                            <option value="quantitative"><% $c->i18n->p("phenotype.quantitative", "quantitative") |h %></option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_scale_minimum", "New Scale Minimum:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_trait_scale_minimum" name="add_new_trait_scale_minimum" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> 1"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_scale_maximum", "New Scale Maximum:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_trait_scale_maximum" name="add_new_trait_scale_maximum" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> 10000"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_scale_categories_separated", "New Scale Categories ('/' separated):") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_trait_scale_categories" name="add_new_trait_scale_categories" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> 1/3/5/7"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_scale_default_value", "New Scale Default Value:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_trait_scale_default" name="add_new_trait_scale_default" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> 5"/>
                                    </div>
                                </div>
                            </form>

                            <center>
                                <button type="button" class="btn btn-primary" id="add_new_trait_scale_step"><% $c->i18n->p("cross.ui.go_to_next_step", "Go to Next Step") |h %></button>
                            </center>

                        </&>
                        <&| /util/workflow.mas:step, title=> $c->i18n->p("global.graphical_filtering.confirm", "Confirm") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("phenotype.confirm_you_are_creating_this_observation_variable_in_the_database", "Confirm you are creating this observation variable in the database")) &>

                            <center>
                                <button class="btn btn-primary" id="add_new_trait_submit_button"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
                            </center>
                        </&>
                        <&| /util/workflow.mas:complete, title=> $c->i18n->p("cross.ui.complete", "Complete") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("phenotype.finished_your_observation_variable_is_now_in_the_database", "Finished! Your observation variable is now in the database")) &>

                            <div id="add_new_trait_added_observation_variable_div">
                            </div>
                        </&>

                    </&><!-- End of workflow -->

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="add_new_observation_variable_ontology_dialog" name="add_new_observation_variable_ontology_dialog" tabindex="-1" role="dialog" aria-labelledby="addNewObservationVariableOntologyDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addNewObservationVariableOntologyDialog"><% $c->i18n->p("phenotype.add_new_ontology", "Add New Ontology") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "add_new_ontology_workflow" &>
                        <&| /util/workflow.mas:step, title=> $c->i18n->p("cross.ui.intro", "Intro") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("phenotype.start_a_new_ontology", "Start a new ontology")) &>
                            <ul>
                                <li><% $c->i18n->p("phenotype.in_this_workflow_you_can_add_a_new_ontology_to", "In this workflow you can add a new ontology to the database. Once an ontology is added, you can add terms into it from the add observation variables workflow.") |h %></li>
                                <li><% $c->i18n->p("phenotype.ontologies_are_tagged_as_being_either_for_traits_methods_or", "Ontologies are tagged as being either for traits, methods, or scales") |h %></li>
                            </ul>

                            <br/><br/>
                            <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p("cross.ui.go_to_next_step", "Go to Next Step") |h %></button>
                            </center>
                        </&>

                        <&| /util/workflow.mas:step, title=> $c->i18n->p("phenotype.ontology", "Ontology") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("phenotype.define_your_ontology", "Define your ontology")) &>

                            <form class="form-horizontal">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_ontology_name", "New Ontology Name:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_observation_variable_ontology_name" name="add_new_observation_variable_ontology_name" type="text" placeholder="<% $c->i18n->p("phenotype.e_g", "e.g.") |h %> MyBreedingProgram Grape Ontology"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_ontology_definition", "New Ontology Definition:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_observation_variable_ontology_definition" name="add_new_observation_variable_ontology_definition" type="text" placeholder="<% $c->i18n->p("phenotype.e_g_description_of_the_ontology", "e.g. description of the ontology") |h %>"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.new_ontology_database_identifier", "New Ontology Database Identifier:") |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_new_observation_variable_ontology_db_name" name="add_new_observation_variable_ontology_db_name" type="text" placeholder="<% $c->i18n->p("phenotype.a_unique_identifier_for_the_terms_in_the_ontology_e", "a unique identifier for the terms in the ontology e.g. CO322") |h %>"/>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.ontology_type", "Ontology Type:") |h %> </label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="add_new_observation_variable_ontology_type" name="add_new_observation_variable_ontology_type"/>
                                            <option value="trait_ontology"><% $c->i18n->p("phenotype.trait_or_observation_variable", "Trait or Observation Variable") |h %></option>
                                            <option value="method_ontology"><% $c->i18n->p("phenotype.method.c39272e", "Method") |h %></option>
                                            <option value="unit_ontology"><% $c->i18n->p("phenotype.scale", "Scale") |h %></option>
                                        </select>
                                    </div>
                                </div>
                            </form>
                            <br/>

                            <center>
                                <button class="btn btn-primary" id="add_new_trait_observation_variable_ontology_step"><% $c->i18n->p("phenotype.store_ontology", "Store Ontology") |h %></button>
                            </center>

                        </&>
                        <&| /util/workflow.mas:complete, title=> $c->i18n->p("cross.ui.complete", "Complete") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("phenotype.finished_your_ontology_is_now_in_the_database_add_new", "Finished! Your ontology is now in the database. Add new terms into it from the add observation variable workflow.")) &>
                        </&>

                    </&><!-- End of workflow -->

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready(function() {

    jQuery('button[name="add_new_observation_variable_ontology_add_button"]').click(function(){
        jQuery('#add_new_observation_variable_ontology_dialog').modal('show');
    });

    jQuery('button[name="add_new_observation_variable_button"]').click(function(){
        jQuery('#add_new_observation_variable_dialog').modal('show');

        get_select_box('trait_variable_ontologies', 'add_new_observation_variable_ontology_select_div', { 'name':'add_new_observation_variable_ontology_select',    'id':'add_new_observation_variable_ontology_select', 'empty':1, 'cvprop_type_name':JSON.stringify(['trait_ontology','composed_trait_ontology','attribute_ontology']) });
        get_select_box('trait_variable_ontologies', 'add_new_trait_ontology_select_div', { 'name':'add_new_trait_ontology_select', 'id':'add_new_trait_ontology_select', 'empty':1, 'cvprop_type_name':JSON.stringify(['trait_ontology','composed_trait_ontology','attribute_ontology']) });
        get_select_box('trait_variable_ontologies', 'add_new_trait_method_ontology_select_div', { 'name':'add_new_trait_method_ontology_select', 'id':'add_new_trait_method_ontology_select', 'empty':1, 'cvprop_type_name':JSON.stringify(['method_ontology']) });
        get_select_box('trait_variable_ontologies', 'add_new_trait_scale_ontology_select_div', { 'name':'add_new_trait_scale_ontology_select', 'id':'add_new_trait_scale_ontology_select', 'empty':1, 'cvprop_type_name':JSON.stringify(['unit_ontology']) });
        
    });

    var add_new_trait_new_observation_variable_db_id;
    var add_new_trait_new_observation_variable_name;
    var add_new_trait_new_observation_variable_definition;
    jQuery('#add_new_trait_observation_variable_step').click(function() {
        if (jQuery('#add_new_observation_variable_name').val() == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.please_give_a_new_observation_variable_name", "Please give a new observation variable name!") : 'Please give a new observation variable name!'));
            return false;
        }
        if (jQuery('#add_new_observation_variable_definition').val() == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.please_give_a_new_observation_variable_definition", "Please give a new observation variable definition!") : 'Please give a new observation variable definition!'));
            return false;
        }
        var selected = [];
        jQuery('input[name="add_new_observation_variable_ontology_select"]:checked').each(function(){
            selected.push(jQuery(this).val());
        });
        if (selected.length < 1) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.please_select_one_observation_variable_ontology", "Please select one observation variable ontology!") : 'Please select one observation variable ontology!'));
        } else if (selected.length > 1) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.only_select_one_observation_variable_ontology", "Only select one observation variable ontology!") : 'Only select one observation variable ontology!'));
        } else {
            add_new_trait_new_observation_variable_name = jQuery('#add_new_observation_variable_name').val();
            add_new_trait_new_observation_variable_definition = jQuery('#add_new_observation_variable_definition').val();
            add_new_trait_new_observation_variable_db_id = selected[0];
            Workflow.complete('#add_new_trait_observation_variable_step');
            Workflow.focus('#add_new_trait_workflow', 2);
        }
        return false;
    });

    var add_new_trait_new_trait_db_id;
    jQuery(document).on('change', 'input[name="add_new_trait_ontology_select"]', function(){
        var selected = [];
        jQuery('input[name="add_new_trait_ontology_select"]:checked').each(function(){
            selected.push(jQuery(this).val());

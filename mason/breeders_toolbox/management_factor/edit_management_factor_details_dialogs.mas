<%args>
$trial_id
$trial_name
$trial_description
$year
$management_factor_type
$management_factor_date
</%args>

<div class="modal fade" id="edit_management_factor_details_dialog" tabindex="-1" role="dialog" aria-labelledby="managementFactorDetailsEditDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header texkkt-center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("folder.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="managementFactorDetailsEditDialog"><% $c->i18n->p("program.management_factor_edit.title", "Edit Treatment Details") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                  <div class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-4 control-label" ><% $c->i18n->p("program.management_factor_edit.name", "Treatment Name: ") |h %></label>
                        <div class="col-sm-8">
                            <input class="form-control" id="edit_management_factor_name" title="name" type="text" value="<%$trial_name%>" placeholder="Fertilizer01_20N40P50K" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label" ><% $c->i18n->p("program.management_factor_edit.description", "Treatment Description: ") |h %></label>
                        <div class="col-sm-8">
                            <input class="form-control" id="edit_management_factor_description" title="description" type="text" value="<%$trial_description%>" placeholder="e.g. Fertilizer Brand 40N20P30K" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label" ><% $c->i18n->p("program.management_factor_edit.type", "Treatment Type: ") |h %></label>
                        <div class="col-sm-8">
                            <input class="form-control" id="edit_management_factor_type" title="management_factor_type" type="text" value="<%$management_factor_type%>" placeholder="e.g. Fertilizer, Watering, Hormones, Weeding" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label" ><% $c->i18n->p("program.management_factor_edit.year", "Year: ") |h %></label>
                        <div class="col-sm-8">
                            <div id="edit_management_factor_year_div"></div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label" ><% $c->i18n->p("program.management_factor_edit.date", "Date: ") |h %></label>
                        <div class="col-sm-8">
                            <input class="form-control" id="edit_management_factor_date" title="treatment_date" type="text" value="<%$management_factor_date%>" placeholder="MM/DD/YYYY" />
                        </div>
                    </div>
                  </div>

                  <div id="edit_management_factor_error_messages"></div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" id="edit_management_factor_details_cancel_button"><% $c->i18n->p("trial.details.cancel", "Cancel") |h %></button>
                <button type="button" class="btn btn-primary" id="edit_management_factor_details_submit"><% $c->i18n->p("trial.details.save", "Save Changes") |h %></button>
            </div>
        </div>
    </div>
</div>

<script defer="defer">

jQuery(document).ready(function () {

    get_select_box('years', 'edit_management_factor_year_div', {'id':'edit_management_factor_year', 'name':'edit_management_factor_year', 'auto_generate': 1, 'default':<% $year %> });

    var treatment_date_element = jQuery("#edit_management_factor_date");
    set_daterangepicker_default (treatment_date_element);
    jQuery('input[title="treatment_date"]').daterangepicker(
        {
            "singleDatePicker": true,
            "showDropdowns": true,
            "autoUpdateInput": false,
        },
        function(start){
            treatment_date_element.val(start.format('MM/DD/YYYY'));
        }
    );

    jQuery('#trial_treatment_edit_details_button').click(function(){
        jQuery('#edit_management_factor_details_dialog').modal('show');
    });

    jQuery('#edit_management_factor_details_submit').click(function(){
        var new_treatment_date = jQuery('#edit_management_factor_date').val();
        if (new_treatment_date == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.management_factor_edit.required.date", "Please give a treatment date!") : "Please give a treatment date!"));
            return false;
        }
        new_treatment_date = moment(new_treatment_date).format('YYYY/MM/DD HH:mm:ss');

        var new_treatment_name = jQuery('#edit_management_factor_name').val();
        var new_treatment_description = jQuery('#edit_management_factor_description').val();
        var new_treatment_type = jQuery('#edit_management_factor_type').val();
        var new_treatment_year = jQuery('#edit_management_factor_year').val();

        if (new_treatment_name == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.management_factor_edit.required.name", "Please give a treatment name!") : "Please give a treatment name!"));
            return false;
        }
        if (new_treatment_description == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.management_factor_edit.required.description", "Please give a treatment description!") : "Please give a treatment description!"));
            return false;
        }
        if (new_treatment_type == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.management_factor_edit.required.type", "Please give a treatment type!") : "Please give a treatment type!"));
            return false;
        }
        if (new_treatment_year == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.management_factor_edit.required.year", "Please give a treatment year!") : "Please give a treatment year!"));
            return false;
        }

        jQuery.ajax({
            url : '/ajax/breeders/trial/<% $trial_id %>/edit_management_factor_details',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            data: {
                'treatment_date':new_treatment_date,
                'treatment_name':new_treatment_name,
                'treatment_description':new_treatment_description,
                'treatment_type':new_treatment_type,
                'treatment_year':new_treatment_year,
            },
            success: function(response){
                console.log(response);
                jQuery("#working_modal").modal("hide");

                if (response.error) {
                    alert(response.error);
                }
                else if (response.message) {
                    jQuery('#edit_management_factor_error_messages').html(response.message);
                }
                else {
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.management_factor_edit.saved", "Successfully saved details!") : "Successfully saved details!"));
                    location.reload();
                }
            },
            error: function(response){
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.management_factor_edit.save_error", "Error saving treatment details!") : "Error saving treatment details!"));
                jQuery("#working_modal").modal("hide");
            }
        });
    });

});

</script>

<%once>
use HTML::Entities ();
</%once>
<%args>
$trial_id
$trial_name
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'moment_min', 'daterangepicker' ] &>

<div class="modal fade" id="upload_soil_data_dialog" name="upload_soil_data_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSoilDataDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.upload.dialog.close', "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSoilDataDialog"><% $c->i18n->p('trial.soil_upload.title', "Upload Soil Data for this Trial") |h %> </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_soil_data_form" name="upload_soil_data_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p('trial.soil_upload.soil_trial', "Soil data for trial:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" name="trial_soil_data" id="trial_soil_data" disabled value="<% $trial_name %>">
                                <input name="soil_data_trial_id" id="soil_data_trial_id" type="hidden" value="<% $trial_id %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p('trial.soil_upload.description', "Description:") |h %></label>
                            <div class="col-sm-8">
                                <input class="form-control" type="text" id="soil_data_description" name="soil_data_description" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p('trial.soil_upload.sampling_date', "Sampling Date:") |h %></label>
                            <div class="col-sm-8">
                                <input class="form-control" id="soil_data_date" name="soil_data_date" title="data_date" type="text"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p('trial.soil_upload.gps', "GPS (optional):") |h %></label>
                            <div class="col-sm-8">
                                <input class="form-control" type="text" id="soil_data_gps" name="soil_data_gps" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p('trial.soil_upload.sampling_type', "Type of Sampling:") |h %></label>
                            <div class="col-sm-8">
                                <input class="form-control" type="text" id="type_of_sampling" name="type_of_sampling" />
                            </div>
                        </div>
                        <div class="well well-sm">
                            <div class="row">
                                <div class="col-sm-4">
                                    <&| /page/explanation.mas, title => HTML::Entities::encode_entities($c->i18n->p("trial.common.template_info", "Template information")) &>
                                        <p>
                                            <b><% $c->i18n->p('trial.upload.dialog.file_format_info', "File format information") |h %></b>
                                            <br>
                                            <a id="soil_data_spreadsheet_format"><% $c->i18n->p('trial.upload.coordinates.spreadsheet', "Spreadsheet format") |h %></a>
                                        </p>
                                    </&>
                                </div>
                                <div class="col-sm-8">
                                    <br/>
                                    <div class="panel panel-default">
                                        <div class="panel-body">
                                            <div class="form-group">
                                                <label class="col-sm-6 control-label"><% $c->i18n->p('trial.soil_upload.file_label', "Select an XLS File:") |h %> </label>
                                                <div class="col-sm-6">
                                                    <input type="file" name="soil_data_upload_file" id="soil_data_upload_file" encoding="multipart/form-data" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.upload.dialog.close', "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="soil_data_submit" id="soil_data_submit"><% $c->i18n->p('trial.soil_upload.upload_file', "Upload File") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_soil_data_error_display" name="upload_soil_data_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadSoilDataErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.upload.dialog.close', "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSoilDataErrorDialog"><% $c->i18n->p('trial.soil_upload.upload_error_title', "Upload Soil Data File Error") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.upload.dialog.close', "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_soil_data_spreadsheet_format_dialog" name="upload_soil_data_spreadsheet_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSoilDataFormatDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.upload.dialog.close', "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSoilDataFormatDialog"><% $c->i18n->p('trial.soil_upload.template_info', "Template Information") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>
                        <% $c->i18n->p('trial.soil_upload.excel_help', "Soil data may be uploaded in an Excel file (.xls or .xlsx)") |h %>
                    </b>
                    <br>
                    <b>
                        <% $c->i18n->p('trial.upload.dialog.header_label', "Header:") |h %>
                    </b>
                    <br>
                        <% $c->i18n->p('trial.soil_upload.first_header', "The first row (header) must contain the following:") |h %>
                    <br>

                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>soil_data_type</td>
                                <td>soil_data_value</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        <% $c->i18n->p('trial.soil_upload.example', "Example:") |h %>
                    </b>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>soil_data_type</td>
                                <td>soil_data_value</td>
                            </tr>
                            <tr>
                                <td>pH (CaCl2)</td>
                                <td>5.500</td>
                            </tr>
                            <tr>
                                <td>Ca (cmolc/dm³)</td>
                                <td>3.500</td>
                            </tr>
                            <tr>
                                <td>Zn (mg/dm³)</td>
                                <td>3.200</td>
                            </tr>
                            <tr>
                                <td>Organic matter (%)</td>
                                <td>3.500</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.upload.dialog.close', "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="soil_data_saved_dialog_message" name="soil_data_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby=soilDataSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.upload.dialog.close', "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="soilDataSavedDialog"><% $c->i18n->p('trial.soil_upload.success', "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p('trial.soil_upload.success_message', "Soil data were saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_soil_data_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.soil_upload.close_reload', "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    jQuery("#trial_upload_soil_data_button").click(function(){

        var soil_data_date_element = jQuery("#soil_data_date");
        set_daterangepicker_default (soil_data_date_element);
        jQuery('input[title="data_date"]').daterangepicker(
            {"singleDatePicker": true,
            "showDropdowns": true,
            "autoUpdateInput": false,
            },
            function(start){
                soil_data_date_element.val(start.format('YYYY-MMM-DD'));
                highlight_changed_details(soil_data_date_element);
            }
        );

        jQuery("#soil_data_spreadsheet_format").click(function(){
            jQuery("#upload_soil_data_spreadsheet_format_dialog").modal("show");
        });

        jQuery("#upload_soil_data_dialog").modal("show");
    });

    jQuery("#soil_data_submit").click(function(){

        var soil_data_description = jQuery("#soil_data_description").val();
        if ( soil_data_description === ''){
            alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_upload.description_required', "Please provide description") : "Please provide description"));
            return;
        }

        var soil_data_date = jQuery("#soil_data_date").val();
        if ( soil_data_date === ''){
            alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_upload.date_required', "Please select a date") : "Please select a date"));
            return;
        }

        var type_of_sampling = jQuery("#type_of_sampling").val();
        if ( type_of_sampling === ''){
            alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_upload.type_required', "Please indicate type of sampling") : "Please indicate type of sampling"));
            return;
        }

        var uploadFile = jQuery("#soil_data_upload_file").val();
        if (uploadFile === ''){
            alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.entry_numbers.select_file', "Please select a file") : "Please select a file"));
            return;
        }

        jQuery('#upload_soil_data_form').attr("action", "/ajax/trial/upload_soil_data");

        jQuery("#upload_soil_data_form").submit();
        jQuery("#upload_soil_data_dialog").modal("hide");
    });

    jQuery('#upload_soil_data_form').iframePostForm({
        json: true,
        post: function(){
            jQuery("#working_modal").modal("show");
        },
        complete: function(response){
            jQuery("#working_modal").modal("hide");
            if (response.error_string){
                jQuery("#upload_soil_data_error_display tbody").html('');
                jQuery("#upload_soil_data_error_display tbody").append(response.error_string);
                jQuery("#upload_soil_data_error_display").modal("show");
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                jQuery('#soil_data_saved_dialog_message').modal("show");
            }
        }
    });

    jQuery("#dismiss_soil_data_saved_dialog").click(function(){
        location.reload();
    });



});

</script>

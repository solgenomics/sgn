
<%args>
$trial_id
$trial_type
$trial_name
</%args>

<& /util/import_javascript.mas, entries => [ 'field_trial_linkage' ] &>


<div id="field_trial_to_field_trial_html">
</div>

<script>

jQuery(document).ready(function () {
    jQuery('#field_trial_from_field_trial_section_onswitch').one("click", function () {
        window.jsMod['field_trial_linkage'].init("<% $trial_id %>", "<% $trial_name %>");
    });
});

</script>

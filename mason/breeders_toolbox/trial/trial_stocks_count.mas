<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.iframe-post-form' ] &>


<script>

jQuery(document).ready(function(){
  jQuery('#trial_design_section_onswitch').one("click", function(){
    jQuery.ajax ( {
        url : '/ajax/breeders/trial/'+ <% $trial_id %> + '/stocks',
        success: function(response){
              //console.log(response);
              //alert(response.data.length);
              //console.log(response.data);
              var html = '';
              html += (window.SGN && SGN.i18n ? SGN.i18n.p('trial.counts.stocks', "Number of accessions: ") : "Number of accessions: ");
               html += response.data.length;
              jQuery("#stocks_counts").html(html);
          },
          error: function(response){
              alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.counts.accessions_error', "Error displaying accession count") : "Error displaying accession count"));
          }

      });
    });
});


</script>

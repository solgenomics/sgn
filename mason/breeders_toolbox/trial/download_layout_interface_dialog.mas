e"))+'" class="glyphicon glyphicon-ok-circle" style="color:green"></span></a></span></h2><h2><span class="label label-info">seedlot_name &nbsp;<a onClick="include_column_<% $download_type %>(\'seedlot_name\')"><span title="'+layoutDownloadEscape_<% $download_type %>(layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.help.include", "Include"))+'" class="glyphicon glyphicon-ok-circle" style="color:green"></span></a></span></h2><h2><span class="label label-info">seed_transaction_operator &nbsp;<a onClick="include_column_<% $download_type %>(\'seed_transaction_operator\')"><span title="'+layoutDownloadEscape_<% $download_type %>(layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.help.include", "Include"))+'" class="glyphicon glyphicon-ok-circle" style="color:green"></span></a></span></h2><h2><span class="label label-info">num_seed_per_plot &nbsp;<a onClick="include_column_<% $download_type %>(\'num_seed_per_plot\')"><span title="'+layoutDownloadEscape_<% $download_type %>(layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.help.include", "Include"))+'" class="glyphicon glyphicon-ok-circle" style="color:green"></span></a></span></h2><h2><span class="label label-info">range_number &nbsp;<a onClick="include_column_<% $download_type %>(\'range_number\')"><span title="'+layoutDownloadEscape_<% $download_type %>(layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.help.include", "Include"))+'" class="glyphicon glyphicon-ok-circle" style="color:green"></span></a></span></h2><h2><span class="label label-info">plot_geo_json &nbsp;<a onClick="include_column_<% $download_type %>(\'plot_geo_json\')"><span title="'+layoutDownloadEscape_<% $download_type %>(layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.help.include", "Include"))+'" class="glyphicon glyphicon-ok-circle" style="color:green"></span></a></span></h2>';


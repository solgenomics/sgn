<%once>
use HTML::Entities ();
</%once>

<%args>
$trial_id => undef
$trial_name => undef
$download_type
$trial_stock_type => undef
</%args>

<%init>
my ($layout_download_title, $layout_created_title);
if ($download_type eq 'Fieldbook') {
    $layout_download_title = $c->i18n->p('fieldbook.export.title_fieldbook', 'Download Fieldbook for %{trial}', { trial => ($trial_name // '') });
    $layout_created_title = $c->i18n->p('fieldbook.export.created_title_fieldbook', 'Fieldbook for %{trial} Created', { trial => ($trial_name // '') });
}
elsif ($download_type eq 'TrialLayout') {
    $layout_download_title = $c->i18n->p('fieldbook.export.title_trial_layout', 'Download trial layout for %{trial}', { trial => ($trial_name // '') });
    $layout_created_title = $c->i18n->p('fieldbook.export.created_title_trial_layout', 'Trial layout for %{trial} created', { trial => ($trial_name // '') });
}
elsif ($download_type eq 'TrialFieldMapLayout') {
    $layout_download_title = $c->i18n->p('fieldbook.export.title_trial_field_map', 'Download trial field map for %{trial}', { trial => ($trial_name // '') });
    $layout_created_title = $c->i18n->p('fieldbook.export.created_title_trial_field_map', 'Trial field map for %{trial} created', { trial => ($trial_name // '') });
}
else {
    $layout_download_title = $c->i18n->p('fieldbook.export.title', 'Download %{type} for %{trial}', { type => $download_type, trial => ($trial_name // '') });
    $layout_created_title = $c->i18n->p('fieldbook.export.created_title', '%{type} for %{trial} Created', { type => $download_type, trial => ($trial_name // '') });
}
</%init>
<style>
    div.layout-container {
        margin: 15px 0;
        display: flex;
        flex-wrap: wrap;
        gap: 30px;
        justify-content: space-around;
        align-items: flex-end;
    }
    div.layout-item {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
        max-width: 250px;
    }
    div.layout-item label {
        text-align: left;
    }
/* Wrap the displayed canonical column keys without changing their values. */
div[id^="create_fieldbook_dialog_"] div[id^="create_fieldbook_included_columns_"],
div[id^="create_fieldbook_dialog_"] div[id^="create_fieldbook_not_included_columns_"] {
    max-width: 100%;
}
div[id^="create_fieldbook_dialog_"] div[id^="create_fieldbook_included_columns_"] .label,
div[id^="create_fieldbook_dialog_"] div[id^="create_fieldbook_not_included_columns_"] .label {
    display: inline-block;
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
}
/* Keep native on/off behavior while allowing literal owner captions to wrap. */
div[id^="create_fieldbook_dialog_"] .control-label {
    white-space: normal;
    overflow-wrap: anywhere;
}
div[id^="create_fieldbook_dialog_"] .modal-footer .btn {
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
}
div[id^="create_fieldbook_dialog_"] div.layout-item .toggle {
    width: 250px !important;
    max-width: 100%;
    height: auto !important;
}
div[id^="create_fieldbook_dialog_"] div.layout-item .toggle-group {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    direction: ltr;
}
div[id^="create_fieldbook_dialog_"] div.layout-item .toggle-on,
div[id^="create_fieldbook_dialog_"] div.layout-item .toggle-off {
    position: static;
    grid-row: 1;
    min-width: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    direction: ltr;
}
div[id^="create_fieldbook_dialog_"] div.layout-item .toggle-on { grid-column: 1; }
div[id^="create_fieldbook_dialog_"] div.layout-item .toggle-off { grid-column: 2; }
html[dir="rtl"] div[id^="create_fieldbook_dialog_"] div.layout-item .toggle-on,
html[dir="rtl"] div[id^="create_fieldbook_dialog_"] div.layout-item .toggle-off { direction: rtl; }
div[id^="create_fieldbook_dialog_"] div.layout-item .toggle-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    height: auto;
    margin: 0;
    transform: translateX(-50%);
}
</style>

<div class="modal fade" id="create_fieldbook_dialog_<% $download_type %>" name="create_fieldbook_dialog_<% $download_type %>" tabindex="-1" role="dialog" aria-labelledby="createFieldbookDialog_<% $download_type %>">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('fieldbook.export.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="createFieldbookDialog_<% $download_type %>"><% $layout_download_title |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <form class="form-horizontal" role="form" method="post" >
                <div class="well">
                    <div class="form-group">
                        <label class="col-sm-3 control-label"><% $c->i18n->p('fieldbook.export.trial', 'Trial: ') |h %></label>
                        <div class="col-sm-9" >
                            <div id="select_trial_for_create_fieldbook_<% $download_type %>">
% if ($trial_id) {
                                <input type="text" class="form-control" value="<% $trial_name %>" disabled/>
                                <input type="hidden" id="html_select_trial_for_create_fieldbook_<% $download_type %>" name="html_select_trial_for_create_fieldbook_<% $download_type %>" value="<% $trial_id %>" />
% } else {
                    <% $c->i18n->p('fieldbook.export.loading', '[Loading...]') |h %>
% }
                            </div>
                        </div>
                    </div>
                    <div id="create_fieldbook_format_div_<% $download_type %>" style="display:none">
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p('fieldbook.export.format', 'Format: ') |h %></label>
                            <div class="col-sm-9" >
                                <select class="form-control" id="create_fieldbook_format_<% $download_type %>">
                                    <option value="csv">CSV</option>
                                    <option value="xlsx">Excel (xlsx)</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p('fieldbook.export.treatments', 'Include treatments: ') |h %></label>
                            <div class="col-sm-9" >
                                <select class="form-control" id="create_fieldbook_include_treatments_<% $download_type %>">
                                    <option value="true"><% $c->i18n->p('fieldbook.export.yes', 'Yes') |h %></option>
                                    <option value="false"><% $c->i18n->p('fieldbook.export.no', 'No') |h %></option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label"><% $c->i18n->p('fieldbook.export.data_level', 'Data Level: ') |h %></label>
                        <div class="col-sm-9" >
                            <select class="form-control" id="create_fieldbook_data_level_<% $download_type %>">
                                <option value="plots"><% $c->i18n->p('fieldbook.export.plots', 'Plots') |h %></option>
                                <option value="plants"><% $c->i18n->p('fieldbook.export.plants', 'Plants') |h %></option>
                                <option value="subplots"><% $c->i18n->p('fieldbook.export.subplots', 'Subplots') |h %></option>
                                <option value="field_trial_tissue_samples"><% $c->i18n->p('fieldbook.export.tissue_samples', 'Tissue Samples') |h %></option>
                            </select>
                        </div>
                    </div>
                </div>
                <div id="selected_columns_well">
                    <div class="well">
                        <center><h4><% $c->i18n->p('fieldbook.export.choose_columns', 'Choose the columns you want to include (Or simply use defaults and click "Submit")') |h %></h4></center>
                        <hr>
                        <div class="layout-container" style="align-items: flex-start !important";>
                            <div class="layout-item">
                                <label><% $c->i18n->p('fieldbook.export.included_columns', 'Included Columns: ') |h %></label>
                                <div id="create_fieldbook_included_columns_<% $download_type %>"></div>
                            </div>
                            <div class="layout-item">
                                <label><% $c->i18n->p('fieldbook.export.not_included_columns', 'Not Included Columns: ') |h %></label>
                                <div id="create_fieldbook_not_included_columns_<% $download_type %>"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="accession_average_performance">
                    <div class="well">
                        <div class="layout-container">
                            <div class="layout-item">
                                <label><% $c->i18n->p('fieldbook.export.measured', 'Include existing plot phenotypes: ') |h %></label>
% # bootstrap-toggle decodes attributes, then inserts captions as HTML: escape both boundaries.
                                <input id="create_fieldbook_include_measured_<% $download_type %>" type="checkbox" data-toggle="toggle" data-on="<% HTML::Entities::encode_entities($c->i18n->p('fieldbook.export.toggle_on', 'On'), q{<>&"'}) |h %>" data-off="<% HTML::Entities::encode_entities($c->i18n->p('fieldbook.export.toggle_off', 'Off'), q{<>&"'}) |h %>" />
                            </div>
                            <div class="layout-item">
                                <label><% $c->i18n->p('fieldbook.export.performance', 'Include summary of overall accession performance (for a list of traits): ') |h %></label>
                                <div id="create_fieldbook_with_trait_list_<% $download_type %>"></div>
                            </div>
                            <div class="layout-item">
                                <label><% $c->i18n->p('fieldbook.export.all_stats', 'Include all stats: ') |h %></label>
                                <input id="create_fieldbook_all_stats_<% $download_type %>" type="checkbox" checked data-toggle="toggle" data-on="<% HTML::Entities::encode_entities($c->i18n->p('fieldbook.export.toggle_on', 'On'), q{<>&"'}) |h %>" data-off="<% HTML::Entities::encode_entities($c->i18n->p('fieldbook.export.toggle_off', 'Off'), q{<>&"'}) |h %>" />
                            </div>
                            <div class="layout-item">
                                <label><% $c->i18n->p('fieldbook.export.use_synonyms', 'Use trait synonyms: ') |h %></label>
                                <input id="create_fieldbook_use_synonyms_<% $download_type %>" type="checkbox" checked data-toggle="toggle" data-on="<% HTML::Entities::encode_entities($c->i18n->p('fieldbook.export.toggle_on', 'On'), q{<>&"'}) |h %>" data-off="<% HTML::Entities::encode_entities($c->i18n->p('fieldbook.export.toggle_off', 'Off'), q{<>&"'}) |h %>" />
                            </div>
                        </div>
                    </div>
                    <div class="well">
                        <div class="layout-container">
                            <div class="layout-item">
                                <label><% $c->i18n->p('fieldbook.export.include_plot_order', 'Include Plot Order:') |h %></label>
                                <input id="create_fieldbook_include_plot_order_<% $download_type %>" type="checkbox" data-toggle="toggle" data-on="<% HTML::Entities::encode_entities($c->i18n->p('fieldbook.export.toggle_on', 'On'), q{<>&"'}) |h %>" data-off="<% HTML::Entities::encode_entities($c->i18n->p('fieldbook.export.toggle_off', 'Off'), q{<>&"'}) |h %>">
                            </div>
                            <div class="layout-item">
                                <label><% $c->i18n->p('fieldbook.export.plot_order', 'Plot Order:') |h %></label>
                                <select class="form-control" name="create_fieldbook_plot_order_<% $download_type %>" id="create_fieldbook_plot_order_<% $download_type %>">
                                    <option value=""><% $c->i18n->p('fieldbook.export.select_order', '--Select plot order--') |h %></option>
                                    <option value="by_col_serpentine"><% $c->i18n->p('fieldbook.export.column_serpentine', 'By Column: Serpentine') |h %></option>
                                    <option value="by_col_zigzag"><% $c->i18n->p('fieldbook.export.column_zigzag', 'By Column: Zigzag') |h %></option>
                                    <option value="by_row_serpentine"><% $c->i18n->p('fieldbook.export.row_serpentine', 'By Row: Serpentine') |h %></option>
                                    <option value="by_row_zigzag"><% $c->i18n->p('fieldbook.export.row_zigzag', 'By Row: Zigzag') |h %></option>
                                </select>
                            </div>
                            <div class="layout-item">
                                <label><% $c->i18n->p('fieldbook.export.starting_plot', 'Starting Plot:') |h %></label>
                                <select class="form-control" id="create_fieldbook_plot_start_<% $download_type %>" name="create_fieldbook_plot_start_<% $download_type %>">
                                    <option value=""><% $c->i18n->p('fieldbook.export.select_start', '--Select start plot--') |h %></option>
                                    <option value="bottom_left"><% $c->i18n->p('fieldbook.export.bottom_left', 'Bottom Left') |h %></option>
                                    <option value="top_left"><% $c->i18n->p('fieldbook.export.top_left', 'Top Left') |h %></option>
                                    <option value="top_right"><% $c->i18n->p('fieldbook.export.top_right', 'Top Right') |h %></option>
                                    <option value="bottom_right"><% $c->i18n->p('fieldbook.export.bottom_right', 'Bottom Right') |h %></option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </form><br/>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" name="create_fieldbook_cancel_button_<% $download_type %>" id="create_fieldbook_cancel_button_<% $download_type %>" data-dismiss="modal"><% $c->i18n->p('fieldbook.export.close', 'Close') |h %></button>
        <button type="button" class="btn btn-primary" name="create_fieldbook_ok_button_<% $download_type %>" id="create_fieldbook_ok_button_<% $download_type %>" title="<% $c->i18n->p('fieldbook.export.submit', 'Submit') |h %>"><% $c->i18n->p('fieldbook.export.submit', 'Submit') |h %></button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="tablet_field_layout_saved_dialog_message_<% $download_type %>" name="tablet_field_layout_saved_dialog_message_<% $download_type %>" tabindex="-1" role="dialog" aria-labelledby="createFieldbookSavedDialog_<% $download_type %>">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('fieldbook.export.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="createFieldbookSavedDialog_<% $download_type %>"><% $layout_created_title |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <p>
              <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
              <% $c->i18n->p('fieldbook.export.saved', 'The field book layout file(s) were saved successfully') |h %>
            </p>
            <div id="tablet_field_layout_get_file_<% $download_type %>"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" name="create_fieldbook_cancel_button_<% $download_type %>" id="create_fieldbook_cancel_button_<% $download_type %>" data-dismiss="modal"><% $c->i18n->p('fieldbook.export.close', 'Close') |h %></button>
      </div>
    </div>
  </div>
</div>

<script>

// Catalog text remains plain data; HTML attribute insertion owns its escaping.
var layoutDownloadI18n_<% $download_type %> = window.SGN && window.SGN.i18n || {
    p: function(context, text, vars) {
        return String(text).replace(/%\{([A-Za-z_][A-Za-z0-9_]*)\}/g, function(token, name) {
            return vars && Object.prototype.hasOwnProperty.call(vars, name) ? String(vars[name]) : token;
        });
    }
};
function layoutDownloadMissingLevelMessage_<% $download_type %>(level) {
    var messages = {
        plants: layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.no_plants", "This trial does not have plants."),
        subplots: layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.no_subplots", "This trial does not have subplots."),
        field_trial_tissue_samples: layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.no_tissue_samples", "This trial does not have tissue samples.")
    };
    return Object.prototype.hasOwnProperty.call(messages, level)
        ? messages[level]
        : layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.missing_level", "This trial does not have %{level}", {level: level});
}
function layoutDownloadEscape_<% $download_type %>(text) {
    return String(text).replace(/[&<>"']/g, function(character) {
        return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[character];
    });
}


var selected_columns_<% $download_type %> = {};
var not_selected_columns_<% $download_type %> = {};
var has_plants_<% $download_type %> = 0;
var has_subplots_<% $download_type %> = 0;
var has_tissue_samples_<% $download_type %> = 0;

jQuery(document).ready(function() {

    if(jQuery("#html_select_trial_for_create_fieldbook_<% $download_type %>").length == 0) {
        get_select_box(
            'trials',
            'select_trial_for_create_fieldbook_<% $download_type %>',
            {
                'name' : 'html_select_trial_for_create_fieldbook_<% $download_type %>',
                'id' : 'html_select_trial_for_create_fieldbook_<% $download_type %>',
                'include_lists' : 1
            }
        );
    }

% if ($download_type ne 'Fieldbook') {
    jQuery(document).on('change', '#html_select_trial_for_create_fieldbook_<% $download_type %>', function() {
        show_fieldbook_treatments_<% $download_type %>();
    });
% }

    jQuery("#trial_download_layout_button").click( function () {
        show_available_columns_TrialLayout('plots');
        var lo = new CXGN.List();
        jQuery('#create_fieldbook_with_trait_list_TrialLayout').html(lo.listSelect('create_fieldbook_with_trait_list_select_TrialLayout', [ 'traits' ], layoutDownloadI18n_<% $download_type %>.p('fieldbook.export.list_empty', 'select'), undefined, undefined));
        jQuery('#accession_average_performance').css("display", "inline-block");
        jQuery('#selected_columns_well').css("display", "inline-block");
        jQuery('#include_treatments_select_div').css("display", "inline-block");
        jQuery('#create_fieldbook_dialog_TrialLayout').modal('show');
        show_fieldbook_treatments_TrialLayout();
    });

    // jQuery("#trial_fieldmap_download_layout_button").click( function () {
    //     jQuery('#include_treatments_select_div').css("display", "none");
    //     jQuery("#create_fieldbook_format_TrialFieldMapLayout option[value='xlsx']").prop('selected', true);
    //     jQuery("#create_fieldbook_format_TrialFieldMapLayout").prop('disabled', 'disabled');
    //     jQuery("#create_fieldbook_data_level_TrialFieldMapLayout").prop('disabled', 'disabled');
    //     show_available_columns_TrialFieldMapLayout('plots');
    //     var lo = new CXGN.List();
    //     jQuery('#create_fieldbook_with_trait_list_TrialFieldMapLayout').html(lo.listSelect('create_fieldbook_with_trait_list_select_TrialFieldMapLayout', [ 'traits' ], 'select', undefined, undefined));
    //     jQuery('#accession_average_performance').css("display", "none");
    //     jQuery('#selected_columns_well').css("display", "none");
    //     jQuery('#create_fieldbook_dialog_TrialFieldMapLayout').modal('show');
    //     show_fieldbook_treatments_TrialFieldMapLayout();
    // });

    jQuery("[name='create_fieldbook_link']").click( function () {
        show_available_columns_Fieldbook('plots');
        var lo = new CXGN.List();
        jQuery('#create_fieldbook_with_trait_list_Fieldbook').html(lo.listSelect('create_fieldbook_with_trait_list_select_Fieldbook', [ 'traits' ], layoutDownloadI18n_<% $download_type %>.p('fieldbook.export.list_empty', 'select'), undefined, undefined));
        jQuery('#create_fieldbook_dialog_Fieldbook').modal('show');
    });

    jQuery('#create_fieldbook_ok_button_<% $download_type %>').on('click', function() {
        open_create_fieldbook_dialog_<% $download_type %>();
    });

    jQuery('#create_fieldbook_data_level_<% $download_type %>').on('change', function(){
        var selected_trial_ids = jQuery('#html_select_trial_for_create_fieldbook_<% $download_type %>').val().split(',');
        var level = jQuery('#create_fieldbook_data_level_<% $download_type %>').val();
        if (level == 'plots'){
            show_available_columns_<% $download_type %>('plots');
        } else {
            let warned = false;
            for ( let i = 0; i < selected_trial_ids.length; i++ ) {
                let trial_id = parseInt(selected_trial_ids[i]);
                if ( trial_id && trial_id !== '' ) {
                    jQuery.ajax({
                        type: 'POST',
                        url: '/ajax/breeders/trial/'+trial_id+'/has_plants',
                        dataType: "json",
                        beforeSend: function() {
                            jQuery("#working_modal").modal("show");
                        },
                        success: function (response) {
                            //console.log(response);
                            jQuery("#working_modal").modal("hide");
                            if(response.has_plants == 0){
                                has_plants_<% $download_type %> = 0;
                                if (!warned && level == 'plants'){
                                    alert(layoutDownloadMissingLevelMessage_<% $download_type %>(level));
                                    show_available_columns_<% $download_type %>('plots');
                                    jQuery('#create_fieldbook_data_level_<% $download_type %>').val('plots');
                                    warned = true;
                                }
                            } else {
                                has_plants_<% $download_type %> = 1;
                                if (level == 'plants'){
                                    show_available_columns_<% $download_type %>(level);
                                }
                            }
                        },
                        error: function () {
                            jQuery("#working_modal").modal("hide");
                            alert(layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.check_error", "An error occurred checking trial for plants or subplots."));
                        }
                    });
                    jQuery.ajax({
                        type: 'POST',
                        url: '/ajax/breeders/trial/'+trial_id+'/has_subplots',
                        dataType: "json",
                        beforeSend: function() {
                            jQuery("#working_modal").modal("show");
                        },
                        success: function (response) {
                            //console.log(response);
                            jQuery("#working_modal").modal("hide");
                            if(response.has_subplots == 0){
                                has_subplots_<% $download_type %> = 0;
                                if (!warned && level == 'subplots'){
                                    alert(layoutDownloadMissingLevelMessage_<% $download_type %>(level));
                                    show_available_columns_<% $download_type %>('plots');
                                    jQuery('#create_fieldbook_data_level_<% $download_type %>').val('plots');
                                    warned = true;
                                }
                            } else {
                                has_subplots_<% $download_type %> = 1;
                                if (level == 'subplots'){
                                    show_available_columns_<% $download_type %>(level);
                                }
                            }
                        },
                        error: function () {
                            jQuery("#working_modal").modal("hide");
                            alert(layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.check_error", "An error occurred checking trial for plants or subplots."));
                        }
                    });
                    jQuery.ajax({
                        type: 'POST',
                        url: '/ajax/breeders/trial/'+trial_id+'/has_tissue_samples',
                        dataType: "json",
                        beforeSend: function() {
                            jQuery("#working_modal").modal("show");
                        },
                        success: function (response) {
                            //console.log(response);
                            jQuery("#working_modal").modal("hide");
                            if(response.has_tissue_samples == 0){
                                has_tissue_samples_<% $download_type %> = 0;
                                if (!warned && level == 'field_trial_tissue_samples'){
                                    alert(layoutDownloadMissingLevelMessage_<% $download_type %>(level));
                                    show_available_columns_<% $download_type %>('plots');
                                    jQuery('#create_fieldbook_data_level_<% $download_type %>').val('plots');
                                    warned = true;
                                }
                            } else {
                                has_tissue_samples_<% $download_type %> = 1;
                                if (level == 'field_trial_tissue_samples'){
                                    show_available_columns_<% $download_type %>(level);
                                }
                            }
                        },
                        error: function () {
                            jQuery("#working_modal").modal("hide");
                            alert(layoutDownloadI18n_<% $download_type %>.p("fieldbook.export.check_error", "An error occurred checking trial for plants or subplots."));
                        }

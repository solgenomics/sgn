<%args>
$trial_id => undef
$data_level => undef
</%args>

<& /util/import_javascript.mas, classes => [ ] &>

<div class="well well-sm">
    <button class="btn btn-primary" id="trial_detail_page_analysis_accession_rank_workflow"><% $c->i18n->p("accession.forms.rank_accessions_on_saved_measurements", "Rank Accessions On Saved Measurements") |h %></button>
</div>
<hr>

<div class="modal fade" id="trial_analysis_accession_rank_workflow_dialog" name="trial_analysis_accession_rank_workflow_dialog" tabindex="-1" role="dialog" aria-labelledby="trialAnalysisAccessionsRankWorkflowDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="trialAnalysisAccessionsRankWorkflowDialog"><% $c->i18n->p("accession.forms.rank_accessions", "Rank Accessions") |h %></h4>
            </div>
            <div class="modal-body">

                <&| /util/workflow.mas, id=> "trial_analysis_accessions_rank_workflow_dialog_workflow" &>
                    <&| /util/workflow.mas:step, title=> $c->i18n->p("lists_datasets.download.traits", "Traits") &>
                        <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("accession.forms.select_the_input_measurements_to_use_in_ranking", "Select the input measurements to use in ranking")) &>

                        <div class="container-fluid">
                            <div class="form-horizontal">

                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("trial.card.deletion.traits", "Trait(s):") |h %> </label>
                                    <div class="col-sm-9" >
                                        <div id="trial_analysis_accessions_rank_workflow_traits_div"></div>
                                    </div>
                                </div>

                            </div>

                            <center>
                                <button class="btn btn-primary" onclick="Workflow.complete(this); return false;" ><% $c->i18n->p("cross.ui.go_to_next_step", "Go to Next Step") |h %></button>
                            </center>
                        </div>
                    </&>
                    <&| /util/workflow.mas:step, title=> $c->i18n->p("accessions.section.accessions", "Accessions") &>
                        <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("accession.forms.select_the_accessions_to_rank", "Select the accessions to rank")) &>

                        <div class="container-fluid">
                            <div class="form-horizontal">

                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("accession.forms.accessions_leave_empty_for_all", "Accessions (Leave empty for all):") |h %> </label>
                                    <div class="col-sm-9" >
                                        <div id="trial_analysis_accessions_rank_workflow_accessions_div"></div>
                                    </div>
                                </div>

                            </div>

                            <center>
                                <button type="button" class="btn btn-primary" name="trial_analysis_accessions_rank_accessions_submit" id="trial_analysis_accessions_rank_accessions_submit" ><% $c->i18n->p("accession.forms.next_step", "Next Step") |h %></button>
                            </center>
                        </div>
                    </&>
                    <&| /util/workflow.mas:step, title=> $c->i18n->p("accession.forms.trait_weightings", "Trait Weightings") &>
                        <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("accession.forms.give_weightings_for_traits", "Give weightings for traits")) &>

                        <div class="container-fluid">

                            <div id="trial_analysis_accessions_rank_trait_weights_div"></div>

                            <center>
                                <button type="button" class="btn btn-primary" name="trial_analysis_accessions_rank_workflow_submit" id="trial_analysis_accessions_rank_workflow_submit" title="<% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %>"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
                            </center>
                        </div>
                    </&>
                    <&| /util/workflow.mas:step, title=> $c->i18n->p("lists_datasets.bulk.output", "Output") &>
                        <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("global.gem_experiment_search.results", "Results")) &>

                        <div id="trial_analysis_accessions_rank_workflow_results_div"></div>
                    </&>
                </&>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery('#trial_detail_page_analysis_accession_rank_workflow').click( function(){
        jQuery('#trial_analysis_accession_rank_workflow_dialog').modal('show');

        get_select_box('traits', 'trial_analysis_accessions_rank_workflow_traits_div', { 'name' : 'trial_analysis_accessions_rank_workflow_trait_ids', 'id' : 'trial_analysis_accessions_rank_workflow_trait_ids', 'empty':1, 'multiple':1, 'size': 20, 'trial_ids':<% $trial_id %>, 'stock_type':'analysis_instance' });

        get_select_box('stocks', 'trial_analysis_accessions_rank_workflow_accessions_div', { 'name' : 'trial_analysis_accessions_rank_workflow_accessions_ids', 'id' : 'trial_analysis_accessions_rank_workflow_accessions_ids', 'empty':1, 'multiple':1, 'size': 20, 'trial_id_list':<% $trial_id %>, 'stock_type_name':'accession' });
    });

    var trial_analysis_accessions_rank_workflow_trait_ids = [];
    var trial_analysis_accessions_rank_workflow_accessions_ids = [];
    jQuery('#trial_analysis_accessions_rank_accessions_submit').click(function() {
        trial_analysis_accessions_rank_workflow_trait_ids = jQuery('#trial_analysis_accessions_rank_workflow_trait_ids').val();
        console.log(trial_analysis_accessions_rank_workflow_trait_ids);

        trial_analysis_accessions_rank_workflow_accessions_ids = jQuery('#trial_analysis_accessions_rank_workflow_accessions_ids').val();
        console.log(trial_analysis_accessions_rank_workflow_accessions_ids);

        if ( !trial_analysis_accessions_rank_workflow_trait_ids || trial_analysis_accessions_rank_workflow_trait_ids.length < 1) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.correlation.traits_required", "Please select at least one trait!") : "Please select at least one trait!"));
            return false;
        }
        else {
            var html = ("<table class=\"table table-bordered table-hover\"><thead><tr><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.stock.phenotype.header.trait", "Trait") : "Trait")).html() + "</th><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.forms.weighting", "Weighting") : "Weighting")).html() + "</th></tr></thead><tbody>");
            for (var i=0; i<trial_analysis_accessions_rank_workflow_trait_ids.length; i++) {
                html = html + '<tr><td>'+trial_analysis_accessions_rank_workflow_trait_ids[i]+'</td><td><input type="text" name="trial_analysis_accessions_rank_workflow_trait_weights" data-trait_id="'+trial_analysis_accessions_rank_workflow_trait_ids[i]+'" class="form-control" value="1"></td></tr>';
            }
            html = html + '</tbody></table>';
            jQuery('#trial_analysis_accessions_rank_trait_weights_div').html(html);

            Workflow.complete("#trial_analysis_accessions_rank_accessions_submit");
            Workflow.focus('#trial_analysis_accessions_rank_workflow_dialog_workflow', 2);
        }
    });

    jQuery('#trial_analysis_accessions_rank_workflow_submit').click(function() {
        var trial_analysis_accessions_rank_workflow_trait_weights_values = [];
        jQuery('input[name="trial_analysis_accessions_rank_workflow_trait_weights"]').each(function() {
            if (jQuery(this).val() == '') {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.forms.please_give_weights", "Please give weights!") : "Please give weights!"));
                return false;
            }
            trial_analysis_accessions_rank_workflow_trait_weights_values.push([jQuery(this).data('trait_id'), jQuery(this).val()]);
        });
        if (trial_analysis_accessions_rank_workflow_trait_weights_values.length != trial_analysis_accessions_rank_workflow_trait_ids.length) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.forms.please_give_weights", "Please give weights!") : "Please give weights!"));
            return false;
        }
        else {
            jQuery.ajax({
                url : '/ajax/breeders/trial/<% $trial_id %>/accessions_rank?trait_ids='+JSON.stringify(trial_analysis_accessions_rank_workflow_trait_ids)+'&accession_ids='+JSON.stringify(trial_analysis_accessions_rank_workflow_accessions_ids)+'&trait_weights='+JSON.stringify(trial_analysis_accessions_rank_workflow_trait_weights_values)+'&data_level=<% $data_level %>',
                beforeSend: function() {
                    jQuery("#working_modal").modal("show");
                },
                success: function(response){
                    console.log(response);
                    jQuery("#working_modal").modal("hide");
                    if (response.error) {
                        alert(response.error);
                    }
                    else {
                        var html = ("<table class=\"table table-hover table-bordered\"><thead><tr><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.forms.rank", "Rank") : "Rank")).html() + "</th><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.related_stock.header.accession_name", "Accession Name") : "Accession Name")).html() + "</th><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot_maintenance_table.ui.value_header", "Value") : "Value")).html() + "</th></tr></thead><tbody>");
                        for (var i=0; i<response.sorted_accessions.length; i++) {
                            var accession_name = response.sorted_accessions[i];
                            var value = response.sorted_values[i];
                            var rank = response.sorted_ranks[i];
                            html = html + '<tr><td>'+rank+'</td><td>'+accession_name+'</td><td>'+value+'</td></tr>';
                        }
                        html = html + '</tbody></table>';
                        jQuery('#trial_analysis_accessions_rank_workflow_results_div').html(html);

                        Workflow.complete("#trial_analysis_accessions_rank_workflow_submit");
                        Workflow.focus('#trial_analysis_accessions_rank_workflow_dialog_workflow', 3);
                    }
                },
                error: function(response){
                    jQuery("#working_modal").modal("hide");
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.forms.error_doing_accessions_rank", "Error doing accessions rank!") : "Error doing accessions rank!"));
                }
            });
        }
    });

});

</script>

<%once>
use HTML::Entities ();
</%once>

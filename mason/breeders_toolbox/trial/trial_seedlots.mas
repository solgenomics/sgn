
<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ "jquery", "jqueryui", "thickbox", "CXGN.Page.FormattingHelpers", "jquery.cookie", "CXGN.List", "CXGN.BreederSearch" ] &>


<div id="trial_seedlots_html">
</div>

<script>
// Optional language assets preserve the native workflow and raw data values.
var seedlotI18n = (window.SGN && window.SGN.i18n) || {
    p: function (context, source, variables) {
        return source.replace(/%\{([A-Za-z0-9_]+)\}/g, function (match, name) {
            return variables && Object.prototype.hasOwnProperty.call(variables, name) ? String(variables[name]) : match;
        });
    },
    np: function (context, one, many, count, variables) {
        return this.p(context, count === 1 ? one : many, variables);
    }
};
function seedlotHTML(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, function (character) {
        return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[character];
    });
}
// The locale is carried only by these source-traced, same-origin core routes.
function _sgnSeedlotLocaleHeaders(url) {
    try {
        var guardedURL = new URL(url, window.location.href);
        if (guardedURL.origin !== window.location.origin) return {};
        var admitted = /^\/ajax\/breeders\/(?:seedlots|seedlot\/[0-9]+(?:\/(?:edit|delete|transactions|transaction\/(?:add|[0-9]+(?:\/(?:edit|delete))?)))?|seedlot\/(?:discard|undo_discard)|seedlot-create|seedlot-upload|seedlot-inventory-upload|upload_transactions|add_transactions_using_list)\/?$/.test(guardedURL.pathname)
            || /^\/ajax\/seedlots\/(?:verify_delete_by_list|confirm_delete_by_list)$/.test(guardedURL.pathname)
            || /^\/ajax\/stock\/stock_related_seedlots\/[0-9]+$/.test(guardedURL.pathname)
            || /^\/ajax\/manage_accessions\/population_seedlots\/[0-9]+$/.test(guardedURL.pathname)
            || /^\/ajax\/accessions\/possible_seedlots$/.test(guardedURL.pathname)
            || /^\/ajax\/breeders\/program\/[0-9]+\/seedlots$/.test(guardedURL.pathname)
            || /^\/ajax\/breeders\/trial\/[0-9]+\/(?:seedlots_from_crossingtrial|seedlots|upload_used_seedlots)$/.test(guardedURL.pathname)
            || guardedURL.pathname === '/breeders/download_population_seedlots_action';
        if (!admitted) return {};
        var root = typeof document !== 'undefined' && document.documentElement;
        var runtime = window.SGN && window.SGN.i18n;
        var requested = root && typeof root.getAttribute === 'function' && root.getAttribute('data-sgn-locale');
        var locale = requested || (runtime && runtime.requestedLocale) || (root && root.lang) || (runtime && runtime.locale) || 'en';
        return {'X-SGN-Locale': typeof locale === 'string' && /^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$/.test(locale) ? locale : 'en'};
    } catch (error) {
        return {};
    }
}
function _sgnSeedlotLocaleURL(url) {
    try {
        var headers = _sgnSeedlotLocaleHeaders(url);
        if (!headers['X-SGN-Locale']) return url;
        var guardedURL = new URL(url, window.location.href);
        guardedURL.searchParams.set('lang', headers['X-SGN-Locale']);
        return guardedURL.pathname + guardedURL.search + guardedURL.hash;
    } catch (error) {
        return url;
    }
}


jQuery(document).ready(function () {

    jQuery("#trial_seedlot_used_upload_spreadsheet_info_format").click( function () {
        jQuery("#trial_seedlot_used_upload_spreadsheet_info_dialog" ).modal("show");
    });

    jQuery('#trial_seedlots_onswitch').one("click", function() {

        jQuery.ajax ( {
            url : '/ajax/breeders/trial/'+<% $trial_id %>+'/seedlots',
            headers: _sgnSeedlotLocaleHeaders('/ajax/breeders/trial/'+<% $trial_id %>+'/seedlots'),
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response){

                //console.log(response);
                jQuery("#working_modal").modal("hide");

                html = '<table class="table borderless" alt="breeder search" border="0" ><tr><td><select multiple class="form-control" id="seedlot_data" name="1" size="10" style="min-width: 200px;overflow:auto;"></select></td></tr>'

                html += '<tr><td><button class="btn btn-default btn-sm" id="seedlot_select_all" name="1">' + seedlotHTML(seedlotI18n.p("seedlots.ui.select_all", "Select All")) + '</button><br><br>'
                html += '<div class="well well-sm"><div id="seedlot_data_count" name="1">' + seedlotHTML(seedlotI18n.p("seedlots.ui.no_selection", "No Selection")) + '</div></div>'
                html += '<div id="seedlot_to_list_menu"></div><td><tr></table>'

                jQuery('#trial_seedlots_html').html(html);

                var seedlot = response.seedlots[0].sort() || [];

                var seedlot_html = seedlotTrialOptions(seedlot);
                jQuery('#seedlot_data').html(seedlot_html);
 
                var data = jQuery('#seedlot_data').val() || [];
                seedlotTrialShowCounts('seedlot_data_count', response.seedlots[0].length, data.length);
 
                if (jQuery('#seedlot_data').length) {
                      addToListMenu('seedlot_to_list_menu', 'seedlot_data', {
                      selectText: true,
                      listType: 'seedlots'
                    });
                }

                jQuery('#seedlot_select_all').click( function() { // select all
                    var data_id = "seedlot_data";
                    selectAllOptions(document.getElementById(data_id));

                    var data = jQuery("#"+data_id).val() || [];
                    var count_id = "seedlot_data_count";
                    seedlotTrialShowCounts(count_id, jQuery('#'+data_id).text().split("\n").length-1, data.length);
                });

                jQuery('#seedlot_data').change( function() { // update count when data selections change
                    var data_id = jQuery(this).attr('id');
                    var data = jQuery('#'+data_id).val() || [];
                    var count_id = "seedlot_data_count";
                    seedlotTrialShowCounts(count_id, jQuery('#'+data_id).text().split("\n").length-1, data.length);
                });

                jQuery('select').dblclick( function() { // open detail page
                    window.open("../../breeders/seedlot/"+this.value);
                });

            },
            error: function(response){
                jQuery("#working_modal").modal("hide");
                alert(seedlotI18n.p("seedlots.ui.error_retrieving_plots", "Error retrieving plots."));
            }
        });
    });

});


function seedlotTrialOptions(items) {
    var html = '';
    if (items) {
        for (var i=0; i<items.length; i++) {
            html = html + '<option value="'+seedlotHTML(items[i][0])+'" title="'+seedlotHTML(items[i][1])+'">'+seedlotHTML(items[i][1])+'</a>\n';
        }
        return html;
    }
    return seedlotHTML(seedlotI18n.p("seedlots.ui.no_data", "no data"));
}
function seedlotTrialShowCounts(count_div, total_count, selected) {
    var html = seedlotHTML(seedlotI18n.p("seedlots.ui.items_count", "Items: %{count}", {count: total_count}))+'<br />';
    if (selected) {
        html += seedlotHTML(seedlotI18n.p("seedlots.ui.selected_count", "Selected: %{count}", {count: selected}));
    }
    jQuery('#'+count_div).html(html);
}
</script>

<%args>
$trial_id
</%args>

<p id="trial_jbrowse_check"><% $c->i18n->p('trial.jbrowse.loading', '[loading...]') |h %></p>

<%perl>

my $jbrowse_path = $c->config->{jbrowse_path};
my @path_parts = split('/', $jbrowse_path);
my $basepath = $path_parts[1];
my $test_url = "/" . $basepath . "/jbrowse.conf";
my $jbrowse_url = $jbrowse_path ."%2Ftrials%2F" . $trial_id ."&tracks=DNA%2CGene%20exons%2C&cat=Diversity/NEXTGEN/Imputed&highlight=";

</%perl>

<script type="text/javascript" defer="defer">
jQuery(document).ready(function () {
    var trialJBrowseI18n = (window.SGN && window.SGN.i18n) || {
        p: function (context, source) { return source; }
    };

	jQuery.ajax({
		url: "<% $test_url %>",
		success: function(response) {
			if ( response.indexOf("Trial_<%$trial_id%>") > -1 ) { // if jbrowse instance is found, create and display link
				jQuery('#trial_jbrowse_check').replaceWith(jQuery('<a>')
                .attr({id: 'jbrowse_link', href: "<% $jbrowse_url %>"})
                .text(trialJBrowseI18n.p('trial.jbrowse.open', 'View the dataset for this trial in JBrowse')));
			}
			else { // if not found, display message that jbrowse instance wasn't found
				jQuery('#trial_jbrowse_check').empty().append(' ', jQuery('<i>').text(trialJBrowseI18n.p('trial.jbrowse.no_dataset', 'This trial does not have a dataset in Jbrowse.')));
			}
		},
		error: function() {
			jQuery('#trial_jbrowse_check').empty().append(' ', jQuery('<i>').text(trialJBrowseI18n.p('trial.jbrowse.unconfigured', 'Jbrowse has not been set up for this database.')));
		}
	});
});
</script>


<%args>
$trial_id => ''
$trial_name => ''
$identifier => ''
$trial_stock_type => undef
</%args>

<style>
#legacy_barcode_btn {
    margin-top: 20px;
}
</style>

 <& /util/import_javascript.mas, classes => [ 'jqueryui.js', 'jquery.js'] &>

<div class="modal fade" id="generate_trial_barcode_dialog" name="generate_trial_barcode_dialog" tabindex="-1" role="dialog" aria-labelledby="generateTrialBarcodeDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="generateTrialBarcodeDialog"><% $c->i18n->p("barcode.mason.generate_stock_barcode", "Generate Stock Barcode") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p id = "barcode_dialog_subtitle2">
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                    </p>
                    <% $c->i18n->p("seedlot_maintenance_table.ui.or", "OR") |h %>   <button type="button" class="btn btn-primary" name="custom_barcode_trial_link" id="custom_barcode_trial_link"><% $c->i18n->p("barcode.mason.design_custom_barcode", "Design Custom Barcode") |h %></button>   <% $c->i18n->p("barcode.mason.on_label_designer_page", "ON LABEL DESIGNER PAGE!") |h %>
                    <center>
                        <div class="well">
                            <& /util/barcode.mas, identifier => "$identifier", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
                        </div>
                    </center>

                    <div class="well well-sm">
                        <div class="row">
                          <div class="col-md-1 col-lg-1">
                          </div>
                          <div class="col-md-10 col-lg-10">

                            <form class="form-horizontal" role="form" enctype="multipart/form-data" method="post" action="/barcode/stock/download/pdf" >

                             <div class="form-group form-group-sm" >
                               <label class="col-sm-4 control-label"><% $c->i18n->p("barcode.mason.list_of_stock_names", "List of Stock Names:") |h %> </label>
                               <div class="col-sm-8" id="trial_accessions">
                               </div>
                             </div>

                             <div class="form-group form-group-sm">
                              <label class="col-sm-4 control-label"><% $c->i18n->p("barcode.helper.barcode_type", "Barcode Type:") |h %> </label>
                              <div class="col-sm-8">
                                  <select class="form-control" id="select_barcode_type" name="select_barcode_type">
                                    <option value="2D"><% $c->i18n->p("barcode.helper.2d_barcode", "2D Barcode") |h %></option>
                                    <option value="1D"><% $c->i18n->p("barcode.helper.1d_barcode", "1D Barcode") |h %></option>
                                  </select>
                              </div>
                             </div>

                               <div id="2D_fieldbook_option" >
                               <div class="form-group form-group-sm" >
                                 <label class="col-sm-4 control-label"><% $c->i18n->p("barcode.helper.enable_2d_barcode_for_fieldbook", "Enable 2D Barcode For FieldBook:") |h %> </label>
                                 <div class="col-sm-8">
                                   <input type="checkbox" id="enable_fieldbook_2d_barcode" name="enable_fieldbook_2d_barcode" value="enable_fieldbook_2d_barcode" checked/>
                                 </div>
                               </div>
                               </div>

                               <script defer="defer">
                                jQuery(document).ready(function() {

                                   jQuery(document).on('change', '#select_barcode_type', function () {
                                       var barcode_type = jQuery("#select_barcode_type").val();
                                       if (barcode_type == "2D") {
                                           jQuery("#2D_fieldbook_option").show();
                                       }
                                       else if (barcode_type == "1D") {
                                         jQuery("#2D_fieldbook_option").hide();
                                       }
                                   });

                                   jQuery('#custom_barcode_trial_link').click(function () {
                                       location.href = '/tools/label_designer';
                                   });

                                   jQuery(document).on('change', '#select_print_format', function () {
                                       var format = jQuery("#select_print_format").val();
                                       if (format == "32A4") {
                                         var labels_row = 10;
                                         var labels_cols = 4;
                                         var tops_margin = 12;
                                         var lefts_margin = 17;
                                         var bottoms_margin = 12;
                                         var rights_margin = 10;
                                       }
                                       if (format == "32_unique") {
                                         var labels_row = 10;
                                         var labels_cols = 4;
                                         var tops_margin = 12;
                                         var lefts_margin = 17;
                                         var bottoms_margin = 12;
                                         var rights_margin = 10;
                                       }
                                       else if (format == "CASS") {
                                       var labels_row = 10;
                                       var labels_cols = 2;
                                       var tops_margin = 10;
                                       var lefts_margin = 112;
                                       var bottoms_margin = 13;
                                       var rights_margin = 20;
                                       }
                                       else if (format == "MUSA") {
                                       var labels_row = 10;
                                       var labels_cols = 2;
                                       var tops_margin = 10;
                                       var lefts_margin = 112;
                                       var bottoms_margin = 13;
                                       var rights_margin = 20;
                                       }
                                       else if (format == "NCSU") {
                                       var labels_row = 10;
                                       var labels_cols = 3;
                                       var tops_margin = 12;
                                       var lefts_margin = 10;
                                       var bottoms_margin = 12;
                                       var rights_margin = 10;
                                       var text = 'year,location';
                                       }
                                       else if (format == "20A4") {
                                       var labels_row = 10;
                                       var labels_cols = 2;
                                       var tops_margin = 12;
                                       var lefts_margin = 10;
                                       var bottoms_margin = 12;
                                       var rights_margin = 10;
                                       }
                                       else if (format == "IITA-3") {
                                       var labels_row = 20;
                                       var labels_cols = 3;
                                       var tops_margin = 13;
                                       var lefts_margin = 130;
                                       var bottoms_margin = 11;
                                       var rights_margin = 10;
                                       }
                                       else if (format == "IITA-2") {
                                       var labels_row = 20;
                                       var labels_cols = 2;
                                       var tops_margin = 13;
                                       var lefts_margin = 130;
                                       var bottoms_margin = 11;
                                       var rights_margin = 10;
                                       }
                                       else if (format == "crossing") {
                                       var labels_row = 1;
                                       var labels_cols = 1;
                                       var tops_margin = 5;
                                       var lefts_margin = 2;
                                       var bottoms_margin = 0;
                                       var rights_margin = 0;
                                       }
                                       jQuery("#text_margin").empty();
                                       jQuery("#text_margin").val(text);
                                       jQuery("#label_rows").empty();
                                       jQuery("#label_rows").val(labels_row);
                                       jQuery("#label_cols").empty();
                                       jQuery("#label_cols").val(labels_cols);
                                       jQuery("#select_barcode_type").prop('selectedIndex',1);
                                       jQuery("#page_format").prop('selectedIndex',0);
                                       jQuery("#tops_margin").empty();
                                       jQuery("#tops_margin").val(tops_margin);
                                       jQuery("#left_margin").empty();
                                       jQuery("#left_margin").val(lefts_margin);
                                       jQuery("#bottom_margin").empty();
                                       jQuery("#bottom_margin").val(bottoms_margin);
                                       jQuery("#right_margin").empty();
                                       jQuery("#right_margin").val(rights_margin);
                                   });
                                });
                               </script>

                               <div class="form-group form-group-sm">
                                 <label class="col-sm-4 control-label"><% $c->i18n->p("barcode.helper.printing_format_optional", "Printing Format (Optional):") |h %> </label>
                                 <div class="col-sm-8">
                                     <select class="form-control" id="select_print_format" name="select_print_format">
                                       <!--<option selected disabled>select printing format</option>-->
                                       <option value=""><% $c->i18n->p("barcode.helper.select_printing_format", "select printing format") |h %></option>
                                       <option value="CASS"><% $c->i18n->p("barcode.helper.cass_printing_format", "CASS printing format") |h %></option>
                                       <option value="MUSA"><% $c->i18n->p("barcode.helper.musa_printing_format", "MUSA printing format") |h %></option>
                                       <option value="32A4"><% $c->i18n->p("barcode.helper.32_label_size_sticker_paper", "32 label Size Sticker Paper") |h %></option>
                                       <option value="32_unique"><% $c->i18n->p("barcode.helper.32_unique_label_size_sticker_paper", "32 Unique label Size Sticker Paper") |h %></option>
                                       <option value="20A4"><% $c->i18n->p("barcode.helper.20_label_size_sticker_paper", "20 label Size Sticker Paper") |h %></option>
                                       <option value="NCSU"><% $c->i18n->p("barcode.mason.ncsu_printing_format", "NCSU printing format") |h %></option>
                                       <option value="IITA-3">IITA-3-barcode</option>
                                       <option value="IITA-2">IITA-2-barcode</option>
                                       <option value="crossing">CROSS</option>
                                     </select>
                                 </div>
                               </div>

                                <div class="form-group form-group-sm" style="display: none">
                                  <label class="col-sm-4 control-label"><% $c->i18n->p("barcode.helper.print_duplicate_labels_per_row", "Print Duplicate Labels Per Row:") |h %> </label>
                                  <div class="col-sm-8">
                                    <input type="checkbox" name="duplicate_labels_per_row" checked="1" disabled="1" />
                                  </div>
                                  </div>
                                  <!-- <div class="form-group form-group-sm">
                                    <label class="col-sm-4 control-label">Print Field Information For Plots: </label>
                                    <div class="col-sm-8">
                                        <input type="checkbox" name="plots" value="plots" />
                                    </div>
                                </div>
                                <div class="form-group form-group-sm">
                                    <label class="col-sm-4 control-label">Print Parents For Nurseries: </label>
                                    <div class="col-sm-8">
                                        <input type="checkbox" name="nursery" value="nursery" />
                                    </div>
                                </div> -->
                            </div>
                        </div>
                        <div class="col-md-1 col-lg-1">
                        </div>
                      </div>

                    </p>

                            <& /barcode/printer_settings.mas &>
                        </center>
             </div>
            </div>
            <div class="modal-footer">

                <button class="btn btn-primary type="submit" type="submit" value="Download Barcodes"><% $c->i18n->p("barcode.helper.download_barcodes", "Download Barcodes") |h %></button>
                <button id="trial_barcode_dialog_ok_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>

            </div>
        </form>
        </div>
    </div>
</div>

<div class="modal fade" id="barcode_design_option_dialog" name="barcode_design_option_dialog" tabindex="-1" role="dialog" aria-labelledby="generateTrialBarcodeDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="barcodeDesignOptionDialog"><% $c->i18n->p("barcode.mason.generate_barcode_label", "Generate Barcode Label") |h %></h4>
            </div>
            <div class="modal-body">
            <div class="container-fluid">
                    <center>
                    <button type="button" class="btn btn-primary" name="custom_barcode_trial_link" id="label_designer_link"><% $c->i18n->p("barcode.mason.go_to_label_designer_recommended", "Go To Label Designer (Recommended)") |h %></button>
                <p id="legacy_barcode_btn">
                    <button type="button" class="btn" name="generate_trial_barcode_link" id="generate_trial_barcode_link"><% $c->i18n->p("barcode.mason.use_legacy_barcode_generator", "Use Legacy Barcode Generator") |h %></button>
                </p>
                    <center>
            </div>
            <script>
            jQuery(document).ready(function() {
                jQuery('#label_designer_link').click(function() {
                    var trialId = "<% $trial_id %>";
                    location.href = '/tools/label_designer?source_type=field_trials&source_id=' + encodeURIComponent(trialId);
                });
            });
            </script>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="generate_trial_barcode_button_dialog" name="generate_trial_barcode_button_dialog" tabindex="-1" role="dialog" aria-labelledby="generateTrialBarcodeButtonDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="generateTrialBarcodeButtonDialog"><% $c->i18n->p("barcode.mason.generate_stock_barcode", "Generate Stock Barcode") |h %></h4>
            </div>
            <div class="modal-body">
            <div class="container-fluid">
                <p id = "barcode_dialog_subtitle">
                    <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                </p>
                    <center>
                    <div class="well">
                    <& /util/barcode.mas, identifier => "$identifier", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
                    </div>
                <p>
                    <button type="button" class="btn btn-primary" name="trial_plot_barcode" id="trial_plot_barcode"><% $c->i18n->p("barcode.mason.plot_barcodes", "Plot Barcodes") |h %></button>
                    <button type="button" class="btn btn-primary" name="trial_plant_barcode" id="trial_plant_barcode"><% $c->i18n->p("barcode.mason.plant_barcodes", "Plant Barcodes") |h %></button>
                    <button type="button" class="btn btn-primary" name="trial_stock_barcode" id="trial_stock_barcode"></button>
                    <button type="button" class="btn btn-primary" name="custom_barcode" id="custom_barcode"><% $c->i18n->p("barcode.mason.custom_barcodes", "Custom Barcodes") |h %></button>
                </p>

                      </center>
              </div>
          </div>
          <div class="modal-footer">
              <button id="trial_barcode_dialog_ok_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>

          </div>
      </div>
  </div>
</div>


<div class="modal fade" id="generate_crossing_experiment_barcode_dialog" name="generate_crossing_experiment_barcode_dialog" tabindex="-1" role="dialog" aria-labelledby="generateTrialBarcodeButtonDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="generateCrossingTrialBarcodeButtonDialog"><% $c->i18n->p("barcode.mason.generate_barcode", "Generate Barcode") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("barcode.mason.generate_barcodes_for_cross_unique_ids_female_parents_and_male", "Generate barcodes for cross unique ids, female parents and male parents in this crossing experiment.") |h %>
                    </p>
                    <center>
                        <div class="well">
                            <& /util/barcode.mas, identifier => "$identifier", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
                        </div>
                        <p>
                            <button type="button" class="btn btn-primary" name="cross_barcodes" id="cross_barcodes"><% $c->i18n->p("barcode.mason.cross_unique_id_barcodes", "Cross Unique ID Barcodes") |h %></button>
                        </p>
                        <p>
                            <button type="button" class="btn btn-primary" name="female_accession_barcodes" id="female_accession_barcodes"><% $c->i18n->p("barcode.mason.female_accession_barcodes", "Female Accession Barcodes") |h %></button>
                            <button type="button" class="btn btn-primary" name="female_plot_barcodes" id="female_plot_barcodes"><% $c->i18n->p("barcode.mason.female_plot_barcodes", "Female Plot Barcodes") |h %></button>
                            <button type="button" class="btn btn-primary" name="female_plant_barcodes" id="female_plant_barcodes"><% $c->i18n->p("barcode.mason.female_plant_barcodes", "Female Plant Barcodes") |h %></button>
                        </p>
                        <p>
                            <button type="button" class="btn btn-primary" name="male_accession_barcodes" id="male_accession_barcodes"><% $c->i18n->p("barcode.mason.male_accession_barcodes", "Male Accession Barcodes") |h %></button>
                            <button type="button" class="btn btn-primary" name="male_plot_barcodes" id="male_plot_barcodes"><% $c->i18n->p("barcode.mason.male_plot_barcodes", "Male Plot Barcodes") |h %></button>
                            <button type="button" class="btn btn-primary" name="male_plant_barcodes" id="male_plant_barcodes"><% $c->i18n->p("barcode.mason.male_plant_barcodes", "Male Plant Barcodes") |h %></button>
                        </p>
                    </center>
                </div>
            </div>
            <div class="modal-footer">
                <button id="trial_barcode_dialog_ok_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function () {

    var trial_stock_type = "<% $trial_stock_type %>";
    var dialog_subtitle = '';
    var dialog_subtitle2 = '';
    var barcode_button_label = '';

    if (trial_stock_type == 'family_name') {
        dialog_subtitle = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.generate_barcodes_for_plots_plants_and_family_names_used_in_this_trial", "Generate barcodes for plots, plants and family names used in this trial.") : 'Generate barcodes for plots, plants and family names used in this trial.');
        barcode_button_label = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.family_name_barcodes", "Family Name Barcodes") : 'Family Name Barcodes');
    } else if (trial_stock_type == 'cross') {
        dialog_subtitle = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.generate_barcodes_for_plots_plants_and_cross_unique_ids_used_in_this_trial", "Generate barcodes for plots, plants and cross unique ids used in this trial.") : 'Generate barcodes for plots, plants and cross unique ids used in this trial.');
        barcode_button_label = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.cross_unique_id_barcodes", "Cross Unique ID Barcodes") : 'Cross Unique ID Barcodes');
    } else {
        dialog_subtitle = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.generate_barcodes_for_plots_plants_and_accessions_used_in_this_trial", "Generate barcodes for plots, plants and accessions used in this trial.") : 'Generate barcodes for plots, plants and accessions used in this trial.');
        barcode_button_label = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.accession_barcodes", "Accession Barcodes") : 'Accession Barcodes');
    }

    jQuery('#barcode_dialog_subtitle').text(dialog_subtitle);

    document.getElementById('trial_stock_barcode').textContent = barcode_button_label;

    jQuery('#trial_stock_barcode').click(function() {

        if (trial_stock_type == 'family_name') {
            jQuery('#barcode_dialog_subtitle2').text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.generate_barcodes_for_family_names_used_in_this_trial", "Generate barcodes for family names used in this trial") : 'Generate barcodes for family names used in this trial'));
        } else if (trial_stock_type == 'cross') {
            jQuery('#barcode_dialog_subtitle2').text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.generate_barcodes_for_cross_unique_ids_used_in_this_trial", "Generate barcodes for Cross unique ids used in this trial") : 'Generate barcodes for Cross unique ids used in this trial'));
        } else {
            jQuery('#barcode_dialog_subtitle2').text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.generate_barcodes_for_accessions_used_in_this_trial", "Generate barcodes for accessions used in this trial") : 'Generate barcodes for accessions used in this trial'));
        }

	jQuery.ajax ( {
            url : '/ajax/breeders/trial/'+<% $trial_id %>+'/accessions',
            success: function(response) {
		var trial_accessions_html = '<textarea class="form-control" id="stock_names" name="stock_names" >';

		for (i=0; i<response.accessions[0].length; i++) {
		    trial_accessions_html = trial_accessions_html + response.accessions[0][i].accession_name + "\n";
		}
                trial_accessions_html = trial_accessions_html + "</textarea>";
		jQuery('#trial_accessions').empty();
		jQuery('#trial_accessions').html(trial_accessions_html);
            },
            error: function(response){
		      alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.forms.error_retrieving_accessions", "Error retrieving accessions.") : "Error retrieving accessions."));
            }
        });
    });

    jQuery('#trial_plot_barcode').click(function() {

        jQuery('#barcode_dialog_subtitle2').text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.generate_barcodes_for_plots_used_in_this_trial", "Generate barcodes for plots used in this trial") : 'Generate barcodes for plots used in this trial'));

        jQuery.ajax ( {
            url : '/ajax/breeders/trial/'+<% $trial_id %>+'/plots',

            success: function(response){
                var trial_plots_html = '<textarea class="form-control" id="stock_names" name="stock_names" >';
                for (i=0; i<response.plots[0].length; i++) {
                    trial_plots_html = trial_plots_html + response.plots[0][i][1] + "\n";
                }
                trial_plots_html = trial_plots_html + "</textarea>";
                jQuery('#trial_accessions').empty();
                jQuery('#trial_accessions').html(trial_plots_html);
            },
            error: function(response){
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlots.ui.error_retrieving_plots", "Error retrieving plots.") : "Error retrieving plots."));
            }
        });
    });

    jQuery('#trial_plant_barcode').click(function() {

        jQuery('#barcode_dialog_subtitle2').text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.generate_barcodes_for_plants_used_in_this_trial", "Generate barcodes for plants used in this trial") : 'Generate barcodes for plants used in this trial'));

        jQuery.ajax ( {
            url : '/ajax/breeders/trial/'+<% $trial_id %>+'/plants',

            success: function(response){
                if (response.plants == '') {
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.trial_has_no_plant_entries", "Trial has no plant entries.") : "Trial has no plant entries."));
                }
                var trial_plants_html = '<textarea class="form-control" id="stock_names" name="stock_names" >';
                for (i=0; i<response.plants[0].length; i++) {
                    trial_plants_html = trial_plants_html + response.plants[0][i][1] + "\n";
                }
                trial_plants_html = trial_plants_html + "</textarea>";
                jQuery('#trial_accessions').empty();
                jQuery('#trial_accessions').html(trial_plants_html);
            },
            error: function(response){
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.error_retrieving_plants", "Error retrieving plants.") : "Error retrieving plants."));
            }

        });

    });

    jQuery('#crossing_experiment_barcode').click(function(){
        jQuery('#generate_crossing_experiment_barcode_dialog').modal("show");
    });

    jQuery('#cross_barcodes').click(function() {
        jQuery('#generate_crossing_experiment_barcode_dialog').modal("hide");
        jQuery('#generate_trial_barcode_dialog').modal("show");
        jQuery('#barcode_dialog_subtitle2').text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.generate_barcodes_for_cross_unique_ids", "Generate barcodes for cross unique ids") : 'Generate barcodes for cross unique ids'));
        jQuery.ajax ( {
            url : '/ajax/breeders/trial/'+<% $trial_id %>+'/get_crosses',

            success: function(response){
                var crosses_html = '<textarea class="form-control" id="stock_names" name="stock_names" >';

                for (i=0; i<response.crosses.length; i++) {
                    crosses_html = crosses_html + response.crosses[i][1] + "\n";

                }
                crosses_html = crosses_html + "</textarea>";
                jQuery('#trial_accessions').empty();
                jQuery('#trial_accessions').html(crosses_html);

            },
            error: function(response){
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.mason.error_retrieving_crosses", "Error retrieving crosses.") : "Error retrieving crosses."));
            }
        });
    });



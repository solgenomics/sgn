<%args>

$trial_id
$trial_name
$user_name

</%args>

% my $activities = $c->config->{'trial_activities'};
% my @all_activities = ('Please select a status');
% my @activity_list= split ',',$activities;
% my %activity_display_labels = (
%     'Please select a status' => $c->i18n->p('trial.status_dialog.sentinel', 'Please select a status'),
%     "Started Phenotyping" => $c->i18n->p('trial.status_dialog.activity.started_phenotyping', "Started Phenotyping"),
%     "Phenotyping Completed" => $c->i18n->p('trial.status_dialog.activity.phenotyping_completed', "Phenotyping Completed"),
%     "Data Cleaning Completed" => $c->i18n->p('trial.status_dialog.activity.data_cleaning_completed', "Data Cleaning Completed"),
%     "Data Analysis Completed" => $c->i18n->p('trial.status_dialog.activity.data_analysis_completed', "Data Analysis Completed"),
% );
% push @all_activities, @activity_list;

<div class="modal fade" id="update_trial_status_dialog" name="update_trial_status_dialog" tabindex="-1" role="dialog" aria-labelledby="updateTrialStatusDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.upload.dialog.close', "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updateTrialStatusDialog"><% $c->i18n->p('trial.status_dialog.title', "Update %{trial_name} Status", {trial_name => $trial_name}) |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p('trial.status_dialog.status_label', "Trial Status: ") |h %></label>
                            <div class="col-sm-6" >
                                <select class="form-control" id="trial_status_select">
% foreach my $activity(@all_activities){
                                    <option value="<%$activity%>"><% (exists $activity_display_labels{$activity} ? $activity_display_labels{$activity} : $activity) |h %></option>
%}
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="trial_activity_date"><% $c->i18n->p('trial.status_dialog.date_label', "Trial Activity Date: ") |h %></label>
                            <div class="col-sm-6">
                                <input class="form-control" id="trial_activity_date" title="activity_date" type="text" value=""/>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_trial_set_phenotypes_fully_loaded_modal" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.upload.dialog.close', "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="update_trial_status_submit" id="update_trial_status_submit" ><% $c->i18n->p('trial.status_dialog.update', "Update") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="update_trial_status_message" name="update_trial_status_message" tabindex="-1" role="dialog" aria-labelledby="updateTrialStatusMessage">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.upload.dialog.close', "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updateTrialStatusMessage"><% $c->i18n->p('trial.status_dialog.success', "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p('trial.status_dialog.success_message', "Trial status was updated successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_update_message_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.status_dialog.close_reload', "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery("#update_trial_status_link").click(function(){
        jQuery("#update_trial_status_dialog").modal("show");

        var trial_activity_date_element = jQuery("#trial_activity_date");
        set_daterangepicker_default (trial_activity_date_element);
        trial_activity_date_element.daterangepicker(
            {
                "singleDatePicker": true,
                "showDropdowns": true,
                "autoUpdateInput": false,
            },
            function(start){
                trial_activity_date_element.val(start.format('YYYY-MMMM-DD'));
            }
        );
    });

    jQuery("#update_trial_status_submit").click(function() {
        var trial_status = jQuery("#trial_status_select").val();
        if (trial_status == 'Please select a status') {
            alert(window.SGN && SGN.i18n ? SGN.i18n.p('trial.status_dialog.sentinel', 'Please select a status') : 'Please select a status');
            return;
        }

        var activity_date = jQuery("#trial_activity_date").val();
        if (activity_date == '') {
            alert(window.SGN && SGN.i18n ? SGN.i18n.p('trial.status_dialog.select_date', 'Please select a date') : 'Please select a date');
            return;
        }

        jQuery.ajax({
            url : '/ajax/breeders/trial/'+ <% $trial_id %> + '/update_trial_status',
            dataType: "json",
            type: 'POST',
            data : {
                'trial_id': "<% $trial_id %>",
                'trial_status': trial_status,
                'user_name': "<% $user_name %>",
                'activity_date': activity_date
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#update_trial_status_dialog').modal('hide');
                    jQuery('#update_trial_status_message').modal("show");
                }
                if (response.error_string) {
                    alert(response.error_string);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert(window.SGN && SGN.i18n ? SGN.i18n.p('trial.status_dialog.update_error', 'An error occurred updating trial status') : 'An error occurred updating trial status');
            }
        });
    });

    jQuery("#dismiss_update_message_dialog").click(function(){
        location.reload();
    });

});

</script>

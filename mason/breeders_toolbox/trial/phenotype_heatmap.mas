<%args>
$trial_id
$stockref => undef
$data_level => 'plot'
$has_col_and_row_numbers => undef
$has_subplot_entries => undef
$has_plant_entries => undef
$trial_stock_type => undef
</%args>

<& /util/import_css.mas, paths => ['fieldmap/leaflet-search.min.css', 'fieldmap/leaflet.css'] &>
<& /util/import_javascript.mas, entries => ['fieldmap'], classes => [ 'jqueryui.js', 'jquery.js', 'jstree.dist.jstree', "thickbox", "CXGN.Page.FormattingHelpers", 'brapi.fieldmap.leaflet', 'brapi.fieldmap.L-Path-Transform', 'brapi.fieldmap.leaflet-search', 'brapi.fieldmap.turf', 'brapi.BrAPI', 'brapi.BrAPIFieldmap' ] &>

<style id='heatmap_stylesheet'>
    #trait_heatmap {display: inline; }
    #trial_no_phenoMSG {display: none; }
    #trial_no_rowColMSG {display: none; }
    #trial_heatmap_div  {display: none; }
    #chart {display: none; }
    #chart_fm {display: none; }
    #d3legend {display: none; }
    #plot_image_ids {display: none;}


    #tooltip {
        position: absolute;
        max-width: 400px;
        max-height: 200px;
        padding: 5px;
        font: 12px sans-serif;
        background: lightsteelblue;
        border: 0px;
        border-radius: 8px;
        pointer-events: none;
    }

    #container_heatmap {
        /*border:2px dashed #000;*/
        height: 390px;
        width: 700px;
        overflow: auto;
        /*overflow: scroll;*/
        display: none;
        margin: 10px;
    }
    #container_fm {
        /*border:2px dashed #000;*/
        height: 100%;
        /*width: 390px;*/
        width: 100%;
        overflow: auto;
        /*overflow: scroll;*/
        display: none;
        transition: all 1s ease-in-out;
    }

    #fieldmap_wrapper {
        width: 90%;
        margin-left: auto;
        margin-right: auto;
        overflow-x: scroll;
        margin-top: 1%;
    }

    .interactive_fieldmap_buttons {
        margin-top: 4%;
        width: 405px;
        margin-left: auto;
        margin-right: auto;
    }

    rect.bordered {
        stroke: #E6E6E6;
        stroke-width:2px;
      }

      text.mono {
        font-size: 9pt;
        font-family: Consolas, courier;
        fill: #aaa;
      }

      text.axis-workweek {
        fill: #000;
      }

      text.axis-worktime {
        fill: #000;
      }

      .legend { list-style: none; }
      .legend li { float: left; margin-left: 10px; margin-right: 10px;}
      .legend span { border: 1px solid #ccc; float: left; width: 12px; height: 12px; margin: 2px; }

      .legend .border_plots { background-color: #d3d3d3}
      .legend .block_even_number { background-color: #c7e9b4; }
      .legend .block_odd_number { background-color: #41b6c4; }
      .legend .checks { background-color: #6a5acd; }
      .legend .rep_even_number { background-color: red;}
      .legend .rep_odd_number { background-color: green;}
      .legend .overlapping_plot { background-color: #000; }
      .legend .trait_not_measured {background-color: darkgrey;} 
      .legend .value_scale {display: inline-block; width: 80px;}

      .rotated {
          transform: rotate(-180deg);
      }

    ul {
        list-style-type: none;
        padding-left: 20px;
    }
    .collapsible {
        cursor: pointer;
        display: flex;
        align-items: center;
    }
    .arrow {
        margin-right: 5px;
        transition: transform 0.2s ease;
    }
    .hidden {
        display: none;
    }

    


    /* Keep translated spatial-export controls within their existing containers. */
    #download_field_layout_modal .modal-title,
    #download_field_layout_modal .control-label,
    #download_field_layout_modal .checkbox label,
    #download_field_layout_modal .modal-footer .btn,
    #trial_fieldmap_download_layout_button,
    #trial_download_layout_button {
        overflow-wrap: anywhere;
    }
    #download_field_layout_modal .checkbox label {
        white-space: normal;
    }
    html[dir="rtl"] #download_field_layout_modal .checkbox label {
        padding-left: 0;
        padding-right: 20px;
    }
    html[dir="rtl"] #download_field_layout_modal .checkbox input[type="checkbox"] {
        margin-left: 0;
        margin-right: -20px;
    }
    #download_field_layout_modal .modal-footer .btn,
    #trial_fieldmap_download_layout_button,
    #trial_download_layout_button {
        max-width: 100%;
        white-space: normal;
    }
    @media (min-width: 768px) {
        html[dir="rtl"] #download_field_layout_modal .form-horizontal .col-sm-3,
        html[dir="rtl"] #download_field_layout_modal .form-horizontal .col-sm-9 {
            float: right;
        }
    }
</style>


<div class="well well-sm">
    <div style="display: flex; gap: 25px">
        <div class="form-group form-group-sm" id="traitdiv" style="display:inline-block">
            <label for="trait_list_dropdown" class="col-sm-2 control-label"><% $c->i18n->p("phenotype.select", "Select:") |h %></label><br />
            <div class="col-sm-12">
                <div id="heatmap_traits_assayed_dropdown">
                    <% $c->i18n->p("trial.heatmap.loading_traits_assayed", "Loading Traits Assayed...") |h %>
                </div>
            </div>
        </div>
        <div id="include_linked_trials" class="form-group form-group-sm">
            <label for="include_linked_trials_checkmark" class="control-label"><% $c->i18n->p("trial.heatmap.display_linked_trials", "Display Trials in Same Field:") |h %></label><br />
            <input type="checkbox" id="include_linked_trials_checkmark" name="include_linked_trials_checkmark">
            <div id="include_linked_trials_list_container" style="margin-top: 10px; display: none">
                <p><strong><% $c->i18n->p("trial.heatmap.linked_trials_heading", "Trials in Same Field:") |h %></strong></p>
                <ul id="include_linked_trials_list">
                    <p><% $c->i18n->p("trial.fieldmap.loading", "Loading...") |h %></p>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="form-group form-group-sm" id="ctrldiv" style="diaplay:none">
    <label for="check_list_dropdown" class="col-sm-2 control-label"><% $c->i18n->p("trial.heatmap.view_check_plots", "View Check Plots:") |h %></label><br />
    <div class="col-sm-12">
        <div id="heatmap_trial_checks_dropdown">
        </div>
        <div class="col-sm-4" id="check_plot_link">
        </div>
    </div>
    <br>
</div>

<div id="view_ctrl_button" style="display:none">
  <a id="view_ctrl_button_link"><button class="btn btn-primary"  type="button" id="view_ctrl_id_button" value="delete_cords" ><% $c->i18n->p("trial.heatmap.view_controls", "View Controls") |h %></button></a>
</div>

<div id="container_heatmap" ></div>

<div id="container_legend">

    <ul id='legend_list' class="legend">
        <li><span class="border_plots"></span> <% $c->i18n->p("trial.heatmap.legend_border_filler_plots", "Border Plots and Filler Plots") |h %> </li>
        <li><span class="block_even_number"></span> <% $c->i18n->p("trial.heatmap.legend_even_blocks", "Even Block Numbers (e.g. 2,4,...)") |h %> </li>
        <li><span class="block_odd_number"></span> <% $c->i18n->p("trial.heatmap.legend_odd_blocks", "Odd Block Numbers (e.g. 1,3,...)") |h %></li>
        <li><span class="checks"></span> <% $c->i18n->p("trial.heatmap.legend_checks", "Checks") |h %></li>
        <li><span class="rep_odd_number"></span> <% $c->i18n->p("trial.heatmap.legend_odd_replicates", "Odd Rep Numbers (e.g. 1,3,...)") |h %> </li>
        <li><span class="rep_even_number"></span> <% $c->i18n->p("trial.heatmap.legend_even_replicates", "Even Rep Numbers (e.g. 2,4,...)") |h %> </li>
        <li><span class="overlapping_plot"></span> <% $c->i18n->p("trial.heatmap.legend_overlapping_plots", "Overlapping Plots (2+ plots at some position)") |h %>  </li>
        <li> <img src="/static/css/images/plot_images.png" alt="<% $c->i18n->p("trial.heatmap.camera_alt", "Camera") |h %>" height="20" width="20"> <% $c->i18n->p("trial.heatmap.legend_plot_has_image", "Plot Has Image") |h %> </li>
        <li><span class="trait_not_measured"></span><% $c->i18n->p("trial.heatmap.legend_no_measurement", "No measurement") |h %> </li>
        <li style='display:flex'><div><% $c->i18n->p("trial.heatmap.legend_low_value", "Low trait value") |h %></div> <span class="value_scale" id="pheno_color_scale"></span> <div><% $c->i18n->p("trial.heatmap.legend_high_value", "High trait value") |h %></div></li>
    </ul>
</div>
<br><br>

<div id="container_fm">
    <div style="margin-top: 2%; position: relative">
        <div style="display: flex; flex-wrap: wrap; gap: 25px">
            <div class="form-inline">
                <label><% $c->i18n->p("trial.fieldmap_edit.plot_layout", "Plot Layout") |h %></label>
                <select class="form-control fieldmap_edit" name="plot_layout" id="plot_layout">
                    <option value=""><% $c->i18n->p("trial.heatmap.select_plot_layout", "--Select Plot Layout--") |h %></option>
                    <option value="serpentine"><% $c->i18n->p("trial.create.field_map.serpentine", "Serpentine") |h %></option>
                    <option value="zigzag"><% $c->i18n->p("trial.heatmap.zigzag", "Zigzag") |h %></option>
                </select>
            </div>
            <div clas="form-inline">
                <label for="invert_row_checkmark"><% $c->i18n->p("trial.heatmap.invert_rows", "Invert Rows") |h %></label>
                <input type="checkbox" id="invert_row_checkmark" name="invert_row_checkmark" value="yes">
            </div>
        </div>
        <br />
        <div style="display: flex; flex-wrap: wrap; gap: 25px">
            <div class="form-inline">
                <label for="top_border_selection"><% $c->i18n->p("trial.heatmap.top_border", "Top Border") |h %></label>
                <input type="checkbox" id="top_border_selection" name="top_border_selection" value="yes" class="fieldmap_edit">
            </div>
            <div class="form-inline">
                <label for="left_border_selection"><% $c->i18n->p("trial.heatmap.left_border", "Left Border") |h %></label>
                <input type="checkbox" id="left_border_selection" name="left_border_selection" value="yes" class="fieldmap_edit">
            </div>
            <div class="form-inline">
                <label for="right_border_selection"><% $c->i18n->p("trial.heatmap.right_border", "Right Border") |h %></label>
                <input type="checkbox" id="right_border_selection" name="right_border_selection" value="yes" class="fieldmap_edit">
            </div>
            <div class="form-inline">
                <label for="bottom_border_selection"><% $c->i18n->p("trial.heatmap.bottom_border", "Bottom Border") |h %></label>
                <input type="checkbox" id="bottom_border_selection" name="bottom_border_selection" value="yes" class="fieldmap_edit">
            </div>
        </div>
        <div id="fieldmap_edit_info" style="display: none">
            <p style="font-style: italic"><% $c->i18n->p("trial.heatmap.linked_trials_note", "NOTE: Field Map cannot be modified and borders are not shown when linked trials are displayed.") |h %></p>
        </div>
        <br>
        <div class="interactive_fieldmap_buttons">
            <button type="button" class="btn btn-primary fieldmap_edit" id="transpose_fieldmap"><% $c->i18n->p("trial.heatmap.transpose", "Transpose") |h %></button>
            <button type="button" class="btn btn-primary fieldmap_edit" id="change_dimensions_button"><% $c->i18n->p("trial.heatmap.change_dimensions", "Change Dimensions") |h %></button>
            <button type="button" class="btn btn-primary fieldmap_edit" id ="remove_fillers"><% $c->i18n->p("trial.heatmap.remove_filler_plots", "Remove Filler Plots") |h %></button>
            <button type="button" id="print_fieldmap" name="print_fieldmap" class="btn btn-primary fieldmap_edit"><% $c->i18n->p("trial.heatmap.print_fieldmap", "Print Fieldmap") |h %></button>
            <button type="button" id="submit_fieldmap" name="submit_fieldmap" class="btn btn-success fieldmap_edit"><% $c->i18n->p("trial.fieldmap_edit.submit_layout", "Submit Field Layout") |h %></button>
        </div>
    </div>
    <div id="fieldmap_wrapper">
        <div id="fieldmap_chart"></div>
    </div>
% if ( $has_col_and_row_numbers ) {
    <div style="margin-top: 40px" class="well well-sm">
        <h3 style="margin: 0 0 10px 0"><% $c->i18n->p("trial.heatmap.download_plot_order", "Download Plot Order") |h %></h3>
        <div style="display: flex; flex-wrap: wrap; gap: 25px; justify-content: space-around; align-items: center">
            <div>
                <label><% $c->i18n->p("trial.heatmap.download_type", "Download Type:") |h %></label>
                <select class="form-control" name="plot_download_type" id="plot_download_type">
                    <option value=""><% $c->i18n->p("trial.heatmap.select_type", "--Select Type--") |h %></option>
                    <option value="planting"><% $c->i18n->p("trial.heatmap.planting_order", "Planting Order") |h %></option>
                    <option value="collection"><% $c->i18n->p("trial.heatmap.collection_order", "Collection Order") |h %></option>
                    <option value="harvest"><% $c->i18n->p("trial.heatmap.harvest_order", "Harvest Order") |h %></option>
                    <option value="harvestmaster">HarvestMaster</option>
                </select>
            </div>
            <div>
                <label><% $c->i18n->p("fieldbook.export.plot_order", "Plot Order:") |h %></label>
                <select class="form-control" name="plot_download_order" id="plot_download_order" style="max-width: 300px">
                    <option value=""><% $c->i18n->p("trial.heatmap.select_plot_order", "--Select Plot Order--") |h %></option>
                    <option value="by_col_serpentine"><% $c->i18n->p("fieldbook.export.column_serpentine", "By Column: Serpentine") |h %></option>
                    <option value="by_col_zigzag"><% $c->i18n->p("fieldbook.export.column_zigzag", "By Column: Zigzag") |h %></option>
                    <option value="by_row_serpentine"><% $c->i18n->p("fieldbook.export.row_serpentine", "By Row: Serpentine") |h %></option>
                    <option value="by_row_zigzag"><% $c->i18n->p("fieldbook.export.row_zigzag", "By Row: Zigzag") |h %></option>
                </select>
            </div>
            <div>
                <label><% $c->i18n->p("fieldbook.export.starting_plot", "Starting Plot:") |h %></label>
                <select class="form-control" id="plot_download_start" name="plot_download_start" style="max-width: 300px">
                    <option value="bottom_left"><% $c->i18n->p("fieldbook.export.bottom_left", "Bottom Left") |h %></option>
                    <option value="top_left"><% $c->i18n->p("fieldbook.export.top_left", "Top Left") |h %></option>
                    <option value="top_right"><% $c->i18n->p("fieldbook.export.top_right", "Top Right") |h %></option>
                    <option value="bottom_right"><% $c->i18n->p("fieldbook.export.bottom_right", "Bottom Right") |h %></option>
                </select>
            </div>
            <div style="display: flex; flex-direction: column; justify-content: end; text-align: right">
                <div>
                    <label for="plot_download_borders"><% $c->i18n->p("trial.heatmap.include_borders", "Include Borders") |h %></label>
                    <input type="checkbox" id="plot_download_borders" name="plot_download_borders" value="no">
                </div>
                <div>
                    <label for="plot_download_gaps"><% $c->i18n->p("trial.heatmap.include_gaps", "Include Gaps") |h %></label>
                    <input type="checkbox" id="plot_download_gaps" name="plot_download_gaps" value="no">
                </div>
% if ( $has_subplot_entries ) {
                <div>
                    <label for="plot_download_subplots"><% $c->i18n->p("trial.heatmap.include_subplots", "Include Subplots") |h %></label>
                    <input type="checkbox" id="plot_download_subplots" name="plot_download_subplots" value="no">
                </div>
% }
% if ( $has_plant_entries ) {
                <div>
                    <label for="plot_download_plants"><% $c->i18n->p("trial.heatmap.include_plants", "Include Plants") |h %></label>
                    <input type="checkbox" id="plot_download_plants" name="plot_download_plants" value="no">
                </div>
% }
            </div>
        </div>
        <div id="plot_download_harvestmaster_options" style="display: none; padding: 15px">
            <p><strong><% $c->i18n->p("trial.heatmap.harvestmaster_options", "HarvestMaster Options:") |h %></strong></p>
            <div style="display: flex; flex-wrap: wrap; gap: 25px; justify-content: space-around; align-items: center">
                <div>
                    <label><% $c->i18n->p("trial.heatmap.harvestmaster_pltid", "HarvestMaster PLTID:") |h %></label>
                    <select class="form-control" id="hm_pltid" name="hm_pltid" style="max-width: 400px">
                        <option value="plot_id" selected><% $c->i18n->p("trial.heatmap.plot_database_id", "Plot Database ID") |h %></option>
                        <option value="plot_name"><% $c->i18n->p("trial.design.header.plot_name", "Plot Name") |h %></option>
                        <option value="plot_number"><% $c->i18n->p("trial.design.header.plot_number", "Plot Number") |h %></option>
                    </select>
                </div>
                <div>
                    <label><% $c->i18n->p("trial.heatmap.harvestmaster_range", "HarvestMaster Range:") |h %></label>
                    <select class="form-control" id="hm_range" name="hm_range" style="max-width: 400px">
                        <option value="col_number"><% $c->i18n->p("trial.heatmap.breedbase_column", "Breedbase Column") |h %></option>
                        <option value="row_number" selected><% $c->i18n->p("trial.heatmap.breedbase_row", "Breedbase Row") |h %></option>
                    </select>
                </div>
                <div>
                    <label><% $c->i18n->p("trial.heatmap.harvestmaster_row", "HarvestMaster Row:") |h %></label>
                    <select class="form-control" id="hm_row" name="hm_row" style="max-width: 400px">
                        <option value="col_number" selected><% $c->i18n->p("trial.heatmap.breedbase_column", "Breedbase Column") |h %></option>
                        <option value="row_number"><% $c->i18n->p("trial.heatmap.breedbase_row", "Breedbase Row") |h %></option>
                    </select>
                </div>
            </div>
        </div>
        <div style="padding: 15px 50px; text-align: center">
            <button class="btn btn-primary" id="plot_download_button"><% $c->i18n->p("trial.spatial_export.download", "Download") |h %></button>
        </div>
    </div>
</div>
% }


<div id="trait_heatmap" ><% $c->i18n->p("trial.heatmap.loading_heatmap", "loading...") |h %></div>
<div id="container_heatmap_geo" ></div>
<div id="trial_no_phenoMSG" ><% $c->i18n->p("trial.heatmap.upload_trial_phenotypes", "Upload trial phenotypes to view trait assayed heatmap") |h %></div>
<div class="container" id="trial_no_rowColMSG">
    <div class="well">
    <!--    <centre><div id="trial_no_rowColMSG2" ><b>Trial plots have no row and column number to display heatmap</b></div></centre> -->
    </div>
</div>

<canvas id='trial_phenotype_heatmap_download_image_canvas' width="3000" height="3000" style="display:none"></canvas>

<div id="chart"></div>
<!--<div class="col-sm-10" id="d_button" style="display:none";>
  <a id="delete_trait" class="btn btn-primary">Delete Selected Trait</a> &nbsp;
</div> -->


<div id="delete_field_map_dialog" title="<% $c->i18n->p("trial.card.coords.delete_title", "Physical Field Map Deletion") |h %>" style="display:none;">
   <div id="trait_list_dc" name="trait_list">
       <label id="trait_list_label_dc" for="trait_list_list_select" style="display: inline-block; width: 300px;"><% $c->i18n->p("trial.card.coords.confirm_delete", "Please, confirm field map deletion...") |h %> <br />

       </label>

   </div>
</div>

<div class="modal  fade" id="suppress_plot_pheno_dialog" name="suppress_plot_pheno_dialog" tabindex="-1" role="dialog" aria-labelledby="SuppressPlotPhenoDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="SuppressPlotPhenoDialog"><% $c->i18n->p("trial.heatmap.suppress_plot_phenotype", "Suppress Plot Phenotype Measurement") |h %> </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="suppress_plot_pheno_form" name="suppress_plot_pheno_form">

                    <center>
                    <p3> <% $c->i18n->p("trial.heatmap.suppressed_measurement_help", "Suppressed measurement will be seen as an outlier and can be excluded during phenotype analysis and download.") |h %></p3>
                    </center></br>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("trial.heatmap.plot_name_label", "Plot Name:") |h %></label>
                            <div class="col-sm-8" id="myplot_name">

                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("trial.heatmap.phenotype_value", "Phenotype Value:") |h %> </label>
                            <div class="col-sm-8" id="pheno_value">

                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("trial.heatmap.phenotype_id", "Phenotype ID:") |h %> </label>
                            <div class="col-sm-8" id="mypheno_id">

                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("trial.heatmap.trait_id", "Trait ID:") |h %> </label>
                            <div class="col-sm-8" id="mytrait_id">

                            </div>
                        </div>

                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_suppress_plot_pheno_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="suppress_plot_pheno_dialog_submit" id="suppress_plot_pheno_dialog_submit"><% $c->i18n->p("trial.heatmap.suppress_phenotype_button", "Suppress Phenotype") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal  fade" id="suppress_phenotype_dialog_success_message" name="suppress_phenotype_dialog_success_message" tabindex="-1" role="dialog" aria-labelledby="SuppressPhenoDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="SuppressPhenoDialog"><% $c->i18n->p("trial.heatmap.suppress_phenotype_for_plot", "Suppress Phenotype For Plot ") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">


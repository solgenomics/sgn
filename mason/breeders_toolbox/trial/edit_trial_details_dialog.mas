                      </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label" ><% $c->i18n->p('trial.details.plan_to_genotype', 'Trial Will Be Genotyped: ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                          <select class="form-control" id="edit_trial_plan_to_genotype" title="plan_to_genotype" value="<% $field_trial_is_planned_to_be_genotyped %>">
                              <option value="no"><% $c->i18n->p('trial.details.no', 'No') |h %></option>
                              <option value="yes"><% $c->i18n->p('trial.details.yes', 'Yes') |h %></option>
                          </select>
                      </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label" ><% $c->i18n->p('trial.details.plan_to_cross', 'Trial Will Be Crossed: ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                          <select class="form-control" id="edit_trial_plan_to_cross" title="plan_to_cross" value="<% $field_trial_is_planned_to_cross %>">
                              <option value="no"><% $c->i18n->p('trial.details.no', 'No') |h %></option>
                              <option value="yes"><% $c->i18n->p('trial.details.yes', 'Yes') |h %></option>
                          </select>
                      </div>
                    </div>
                </div>
              </form>
            </div>
        </div>
        <div class="modal-footer">
            <p class="text-success vertical-align pull-left"><span class="glyphicon glyphicon-pencil"></span> <% $c->i18n->p('trial.details.pending', 'Indicates pending change') |h %></p>
            <button type="button" class="btn btn-default" data-dismiss="modal" id="edit_trial_details_cancel_button"><% $c->i18n->p('trial.details.cancel', 'Cancel') |h %></button>
            <button type="button" class="btn btn-primary" id="save_trial_details"><% $c->i18n->p('trial.details.save', 'Save Changes') |h %></button>
        </div>
    </div>
</div>
</div>

<div class="modal fade" id="trial_details_saved_dialog" tabindex="-1" role="dialog" aria-labelledby="trialDetailsSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header text-center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.details.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="trialDetailsSavedDialog"><% $c->i18n->p('trial.details.saved', 'Details Saved') |h %></h4>
            </div>
            <div class="modal-body" id="trial_details_saved_body">
              <ul class="list-group" id="trial_details_saved_message"></ul>
            </div>
            <div class="modal-footer">
                <button id="trial_details_saved_close_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.details.reload', 'Close & Reload') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="trial_details_error_dialog" tabindex="-1" role="dialog" aria-labelledby="trialDetailsErrorDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header text-center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.details.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="trialDetailsErrorDialog"><% $c->i18n->p('trial.details.error_title', 'Error Saving Trial Details') |h %></h4>
            </div>
            <div class="modal-body" id="trial_details_error_body">
              <ul class="list-group" id="trial_details_error_message"></ul>
            </div>
            <div class="modal-footer">
                <button id="trial_details_error_close_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.details.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

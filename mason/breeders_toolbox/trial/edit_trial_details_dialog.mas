
<%args>
$trial_name
$breeding_program
$location
$year
$trial_type
$trial_type_id
$planting_date
$show_transplanting_date
$transplanting_date
$harvest_date
$trial_description
$field_size
$plot_width
$plot_length
$field_trial_is_planned_to_be_genotyped
$field_trial_is_planned_to_cross
</%args>

<div class="modal fade" id="trial_details_edit_dialog" tabindex="-1" role="dialog" aria-labelledby="trialDetailsEditDialog">
<div class="modal-dialog modal-xl" role="document">
    <div class="modal-content ui-front">
        <div class="modal-header text-center">
            <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.details.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
            <h4 class="modal-title" id="trialDetailsEditDialog"><% $c->i18n->p('trial.details.edit', 'Edit Trial Details') |h %></h4>
        </div>
        <div class="modal-body" id="trial_details_edit_body">
            <div class="container-fluid">
            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data">
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="edit_trial_name"><% $c->i18n->p('trial.details.name', 'Trial Name: ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                        <input class="form-control col-sm-8" id="edit_trial_name" title="name" type="text" value="<% $trial_name |h %>" aria-describedby="edit_trial_name_status"/>
                      </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="edit_trial_breeding_program"><% $c->i18n->p('trial.details.program', 'Breeding Program: ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                        <select class="form-control" id="edit_trial_breeding_program" title="breeding_program" value="<%$breeding_program%>"></select>
                      </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="edit_trial_location"><% $c->i18n->p('trial.details.location', 'Location: ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                        <select class="form-control" id="edit_trial_location" title="location" value="<%$location%>"></select>
                      </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="edit_trial_year"><% $c->i18n->p('trial.details.year', 'Year: ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                        <select class="form-control" id="edit_trial_year" title="year" value="<%$year%>"></select>
                      </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="edit_trial_type"><% $c->i18n->p('trial.details.type', 'Trial Type: ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                        <select class="form-control" id="edit_trial_type" title="type" value="<%$trial_type_id%>"></select>
                      </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="edit_trial_planting_date"><% $c->i18n->p('trial.details.planting_date', 'Planting Date: ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                        <span class="input-group-btn"><button class="btn btn-default" id="clear_planting_date" type="button"><% $c->i18n->p('trial.details.clear', 'Clear') |h %></button></span>
                        <input class="form-control" id="edit_trial_planting_date" title="planting_date" type="text" value="<% $planting_date |h %>"/>
                      </div>
                    </div>
                </div>
% if($show_transplanting_date == 1){
    <div class="form-group">
        <label class="col-sm-3 control-label" for="edit_trial_transplanting_date"><% $c->i18n->p('trial.details.transplanting_date', 'Transplanting Date: ') |h %></label>
        <div class="col-sm-8">
            <div class="input-group">
                <span class="input-group-btn"><button class="btn btn-default" id="clear_transplanting_date" type="button"><% $c->i18n->p('trial.details.clear', 'Clear') |h %></button></span>
                <input class="form-control" id="edit_trial_transplanting_date" title="transplanting_date" type="text" value="<% $transplanting_date |h %>"/>
            </div>
        </div>
    </div>
% }
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="edit_trial_harvest_date"><% $c->i18n->p('trial.details.harvest_date', 'Harvest Date: ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                        <span class="input-group-btn"><button class="btn btn-default" id="clear_harvest_date" type="button"><% $c->i18n->p('trial.details.clear', 'Clear') |h %></button></span>
                        <input class="form-control" id="edit_trial_harvest_date" title="harvest_date" type="text" value="<% $harvest_date |h %>"/>
                      </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="edit_trial_description"><% $c->i18n->p('trial.details.description', 'Description: ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                        <textarea class="form-control" id="edit_trial_description" title="description" rows="5"><% $trial_description |h %></textarea>
                      </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label" for="edit_trial_field_size"><% $c->i18n->p('trial.details.field_size', 'Field Size (ha): ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                        <input type="number" class="form-control" id="edit_trial_field_size" title="field_size" value="<% $field_size %>" >
                      </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label" ><% $c->i18n->p('trial.details.plot_width', 'Plot Width (m): ') |h %></label>
                    <div class="col-sm-8">
                      <div class="input-group">
                        <input class="form-control col-sm-8" id="edit_trial_plot_width" title="plot_width" type="text" value="<%$plot_width%>" aria-describedby="edit_plot_width_status"/>
                          <!-- <select class="form-control" id="edit_trial_plot_width" title="plot_width" value="<% $plot_width %>">
                              <option value="">NA</option>
                              <option value="0.1">0.1</option>
                              <option value="0.15">0.15</option>

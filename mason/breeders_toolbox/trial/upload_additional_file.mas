<%once>
use HTML::Entities ();
</%once>
<%args>
$trial_id => undef
</%args>

<& /util/import_javascript.mas, classes => [ ] &>

<div id="trial_additional_uploaded_files_div">
[LOADING...]
</div>

<div class="modal fade" id="trial_upload_additional_file_dialog" name="trial_upload_additional_file_dialog" tabindex="-1" role="dialog" aria-labelledby="trialUploadAdditionalFileDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.upload.dialog.close', "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="trialUploadAdditionalFileDialog"><% $c->i18n->p('trial.additional_file.dialog_title', "Upload Additional File to Trial") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title => HTML::Entities::encode_entities($c->i18n->p("trial.common.template_info", "Template information")) &>
                        <p>
                            <b><% $c->i18n->p('trial.additional_file.file_info', "File upload information") |h %></b>
                            <br>
                            <a id="trial_upload_additional_file_format"><% $c->i18n->p('trial.additional_file.upload_info', "Upload Information") |h %></a>
                        </p>
                    </&>

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="trial_upload_additional_file_form" name="trial_upload_additional_file_form">

                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p('trial.additional_file.upload_file', "Upload File: ") |h %></label>
                            <div class="col-sm-8" >
                                <input type="file" name="trial_upload_additional_file" id="trial_upload_additional_file" encoding="multipart/form-data" />
                            </div>
                        </div>

                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="trial_upload_additional_file_cancel_button" id="trial_upload_additional_file_cancel_button"     data-dismiss="modal"><% $c->i18n->p('trial.upload.dialog.close', "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="trial_upload_additional_file_submit_button" id="trial_upload_additional_file_submit_button" title="<% $c->i18n->p('trial.upload.coordinates.submit', "Submit") |h %>"><% $c->i18n->p('trial.upload.coordinates.submit', "Submit") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="trial_upload_additional_file_info_dialog" name="trial_upload_additional_file_info_dialog" tabindex="-1" role="dialog" aria-labelledby="trialUploadAdditionalFileInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.upload.dialog.close', "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="trialUploadAdditionalFileInfoDialog"><% $c->i18n->p('trial.additional_file.upload_info', "Upload Information") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% $c->i18n->p('trial.additional_file.help', "This is for uploading any additional files you may have for a trial.") |h %></b>
                    <br/><br/>
                    <p><% $c->i18n->p('trial.additional_file.examples', "Possible additional files include, but are not limited to:") |h %></p>
                    <ul>
                        <li><% $c->i18n->p('trial.additional_file.images', "Trial Related Images, such as a physical field image or an aerial picture of the field.") |h %></li>
                        <li><% $c->i18n->p('trial.additional_file.documentation', "Trial Related Documentation, such as protocols or permits for the trial.") |h %></li>
                        <li><% $c->i18n->p('trial.additional_file.reports', "Trial Related Reports, such as supplementary information or publications.") |h %></li>
                        <li><% $c->i18n->p('trial.additional_file.recordings', "Trial Related Recordings, whether audio or video.") |h %></li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_trial_upload_additional_file_info_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.upload.dialog.close', "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>
var _sgnB11AdditionalFileEscape = function(value) { return jQuery('<div>').text(value).html(); };


jQuery(document).ready(function(){

    display_trial_additional_upload_files();

    jQuery('#trial_upload_additional_files_link').click( function(){
        jQuery('#trial_upload_additional_file_dialog').modal('show');
    });

    jQuery('#trial_upload_additional_file_format').click( function(){
        jQuery('#trial_upload_additional_file_info_dialog').modal('show');
    });

    jQuery('#trial_upload_additional_file_submit_button').click(function () {
        trial_upload_additional_file_submit();
    });
    function trial_upload_additional_file_submit() {
        var uploadFile = jQuery("#trial_upload_additional_file").val();
        jQuery('#trial_upload_additional_file_form').attr("action", "/ajax/breeders/trial/<% $trial_id %>/upload_additional_file");
        if (uploadFile === '') {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.entry_numbers.select_file', "Please select a file") : "Please select a file"));
            return;
        }
        jQuery("#trial_upload_additional_file_form").submit();
    }

    jQuery('#trial_upload_additional_file_form').iframePostForm({
        json: true,
        post: function () {
            var uploadedAdditionalFile = jQuery("#trial_upload_additional_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadedAdditionalFile === '') {
                jQuery('#working_modal').modal("hide");
                alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.no_file', "No file selected") : "No file selected"));
            }
        },
        complete: function (response) {
            console.log(response);
            jQuery('#working_modal').modal("hide");

            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.error_string) {
                alert(response.error_string);
                return;
            }
            if (response.success) {
                alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.upload_success', "File uploaded successfully") : "File uploaded successfully"));
                display_trial_additional_upload_files();
            }
        }
    });
});		

function display_trial_additional_upload_files(){
    jQuery.ajax ({
        url : '/ajax/breeders/trial/'+<% $trial_id %>+'/get_uploaded_additional_file',
        beforeSend : function(){
            jQuery('#trial_additional_uploaded_files_div').html("[LOADING...]");
        },
        success: function(response){
            //console.log(response);
            var html = "<table class='table table-hover table-condensed table-bordered' id='trial_additional_uploaded_files_table'><thead><tr><th>" + _sgnB11AdditionalFileEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.filename', "Filename") : "Filename") + "</th><th>" + _sgnB11AdditionalFileEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.date_uploaded', "Date Uploaded") : "Date Uploaded") + "</th><th>" + _sgnB11AdditionalFileEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.uploaded_by', "Uploaded By") : "Uploaded By") + "</th><th>" + _sgnB11AdditionalFileEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.options', "Options") : "Options") + "</th></tr></thead><tbody>";
            for (i=0; i<response.files.length; i++) {
                html = html + '<tr><td>'+response.files[i][4]+'</td><td>'+response.files[i][1]+'</td><td><a href="/solpeople/profile/'+response.files[i][2]+'">'+response.files[i][3]+'</a></td><td><a href="/breeders/phenotyping/download/'+response.files[i][0]+'">' + _sgnB11AdditionalFileEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.download', "Download") : "Download") + '</a> | <a href="javascript:obsolete_additional_file('+<% $trial_id %>+', '+response.files[i][0]+')">' + _sgnB11AdditionalFileEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.remove', "Remove") : "Remove") + '</a></td></tr>';
            }
            html = html + "</tbody></table>";
            jQuery('#trial_additional_uploaded_files_div').html(html);
            jQuery('#trial_additional_uploaded_files_table').DataTable();
        },
        error: function(response){
            alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.retrieve_error', "Error retrieving additional uploaded files.") : "Error retrieving additional uploaded files."));
        }
    });
}	
						   
function obsolete_additional_file(trial_id, file_id) {
    var yes = confirm((window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.obsolete_confirm', "Are you sure you want to obsolete this file? This operation cannot be undone.") : "Are you sure you want to obsolete this file? This operation cannot be undone."));
    if (yes) {
        jQuery.ajax({
            url: '/ajax/breeders/trial/'+trial_id+'/obsolete_uploaded_additional_file/'+file_id,
            success: function(r) {
                if (r.error) { 
                    alert(r.error); 
                }
                else {
                    alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.obsolete_success', "The file has been obsoleted.") : "The file has been obsoleted."));
                    display_trial_additional_upload_files();
                }
            },
            error: function(r) {  alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.additional_file.operation_error', "An error occurred!") : "An error occurred!")) }
        });
    }
}


</script>


<%args>
$trial_id => undef
$trial_name => undef
$trial_stock_type => undef
</%args>


<div class="modal fade" id="create_spreadsheet_dialog" name="create_spreadsheet_dialog" tabindex="-1" role="dialog" aria-labelledby="createSpreadsheetDialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.upload.dialog.close', "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="createSpreadsheetDialog"><% $c->i18n->p('trial.spreadsheet.title', "Download Phenotype Spreadsheet for %{trial_name}", {trial_name => "" . ($trial_name)}) |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <form class="form-horizontal" role="form" method="post" >

                <div class="form-group">
		     
                    <label class="col-sm-3 control-label"><% $c->i18n->p('trial.spreadsheet.trial_label', "Trial:") |h %> </label>
                    <div class="col-sm-9">
                        <div id="select_trial_for_create_spreadsheet" >
% if ($trial_id) {
                            <input type="text" id="input_for_trial_name_disabled" class="form-control" style="width:400px" value="<% $trial_name %>" text="<% $trial_name %>" disabled />
                            <input type="hidden" id="html_select_trial_for_create_spreadsheet" name="html_select_trial_for_create_spreadsheet" value="<% $trial_id %>" >
% } else {
                        [Loading...]
% }
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label"><% $c->i18n->p('trial.spreadsheet.trait_list', "Trait List:") |h %> </label>
                    <div class="col-sm-9" >
                        <div id="trait_list_spreadsheet">
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label"><% $c->i18n->p('trial.spreadsheet.include_notes', "Include Notes Column") |h %> </label>
                    <div class="col-sm-9" >
                        <input type="checkbox" id="include_notes_column" name="include_notes_column" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label"><% $c->i18n->p('trial.spreadsheet.spreadsheet_format', "Spreadsheet Format:") |h %> </label>
                    <div class="col-sm-9" >
                        <select class="form-control" id="create_spreadsheet_phenotype_file_format" name="create_spreadsheet_phenotype_file_format">
                            <option value="ExcelBasic"><% $c->i18n->p('trial.spreadsheet.detailed', "Detailed") |h %></option>
                            <option value="ExcelBasicSimple"><% $c->i18n->p('trial.spreadsheet.simple', "Simple") |h %></option>
                            <option value="ExcelAssociatedImages"><% $c->i18n->p('trial.spreadsheet.associated_images', "Associated Images") |h %></option>
                        </select>
                    </div>
                </div>
                <div id="create_spreadsheet_phenotype_data_level_div">
                    <div class="form-group">
                        <label class="col-sm-3 control-label"><% $c->i18n->p('trial.spreadsheet.data_level', "Data Level:") |h %> </label>
                        <div class="col-sm-9" >
                            <select class="form-control" id="create_spreadsheet_data_level">
                                <option value="plots"><% $c->i18n->p('trial.spreadsheet.plots', "Plots") |h %></option>
                                <option value="plants"><% $c->i18n->p('trial.spreadsheet.plants', "Plants") |h %></option>
                                <option value="subplots"><% $c->i18n->p('trial.spreadsheet.subplots', "Subplots") |h %></option>
                                <option value="plants_subplots"><% $c->i18n->p('trial.spreadsheet.plants_and_subplots', "Plants and Subplots") |h %></option>
                                <option value="tissue_samples"><% $c->i18n->p('trial.spreadsheet.tissue_samples', "Tissue Samples") |h %></option>
                            </select>
                        </div>
                    </div>
                </div>

            <div id="create_spreadsheet_plant_options" style="display:none">
                <hr>
                <div class="form-group">
                    <label class="col-sm-5 control-label "><small><% $c->i18n->p('trial.spreadsheet.sample_number', "Sample Number:") |h %> </small></label>
                    <div class="col-sm-7" >
                        <input type="text" class="form-control" id="create_spreadsheet_sample_number" placeholder="<% $c->i18n->p('trial.spreadsheet.sample_all', "Leave blank for all") |h %>"/>
                    </div>
                </div>
            </div>

        </form><br/>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" name="create_phenotyping_cancel_button" id="create_phenotyping_cancel_button" data-dismiss="modal"><% $c->i18n->p('trial.upload.dialog.close', "Close") |h %></button>
        <button type="button" class="btn btn-primary" name="create_phenotyping_ok_button" id="create_phenotyping_ok_button" title="<% $c->i18n->p('trial.upload.coordinates.submit', "Submit") |h %>"><% $c->i18n->p('trial.upload.coordinates.submit', "Submit") |h %></button>
      </div>
    </div>
  </div>
</div>

<script>

jQuery(document).ready(function() {

    if(jQuery("#html_select_trial_for_create_spreadsheet").length == 0) {
        get_select_box('trials', 'select_trial_for_create_spreadsheet', { 'name' : 'html_select_trial_for_create_spreadsheet', 'id' : 'html_select_trial_for_create_spreadsheet', 'multiple':1, 'size':10 });
    }

    jQuery("[name='create_spreadsheet_link']").click( function () {
        jQuery('#create_spreadsheet_dialog').modal("show");
        var list = new CXGN.List();
        jQuery("#trait_list_spreadsheet").html(list.listSelect("trait_list_spreadsheet", [ 'traits' ], undefined, undefined, undefined));
    });

    jQuery(document).on('change', '#create_spreadsheet_data_level', function(){
%  if ($trial_id){
        var selected_trial_ids = [<% $trial_id %>];
        var selected_trial_names = ["<% $trial_name %>"];
%  } else {
        var selected_trial_ids = jQuery("#html_select_trial_for_create_spreadsheet").val();
        var selected_trial_names = [];
        jQuery("#html_select_trial_for_create_spreadsheet").find('option:selected').each(function(){
            selected_trial_names.push(jQuery(this).text());
        });
%  }
        console.log(selected_trial_names);
        var level = jQuery('#create_spreadsheet_data_level').val();
        var url = '';
        if (level == 'plants'){
            url = 'has_plants';
        }
        if (level == 'subplots' || level == 'plants_subplots'){
            url = 'has_subplots';
        }
        if (level == 'tissue_samples'){
            url = 'has_tissue_samples';
        }

        for (var i=0; i<selected_trial_ids.length; i++){
            if (level == 'plants' || level == 'subplots' || level == 'plants_subplots' || level == 'tissue_samples'){
                new jQuery.ajax({
                    type: 'POST',
                    url: '/ajax/breeders/trial/'+selected_trial_ids[i]+'/'+url,
                    dataType: "json",
                    beforeSend: function() {
                        jQuery("#working_modal").modal("show");
                    },
                    success: function (response) {
                        //console.log(response);
                        jQuery("#working_modal").modal("hide");
                        if(response.has_plants == 0 || response.has_subplots == 0 || response.has_tissue_samples == 0){
                            alert(window.SGN && SGN.i18n ? SGN.i18n.p('trial.spreadsheet.level_missing', "The trial %{trial_name} does not have %{level}", {trial_name: response.trial_name, level: level}) : 'The trial '+response.trial_name+' does not have '+level);
                            jQuery('#create_spreadsheet_data_level').val('plots');
                            jQuery('#create_spreadsheet_plant_options').hide();
                        }
                    },
                    error: function () {
                        jQuery("#working_modal").modal("hide");
                        alert(window.SGN && SGN.i18n ? SGN.i18n.p('trial.spreadsheet.level_check_error', "An error occurred checking trial %{trial_name} for plants or subplots.", {trial_name: selected_trial_names[i]}) : 'An error occurred checking trial '+selected_trial_names[i]+' for plants or subplots.');
                    }
                });
            }
        }
    });

    jQuery('#create_spreadsheet_data_level').change(function() {
        jQuery("#create_spreadsheet_sample_number").val('');
        if ( jQuery('#create_spreadsheet_data_level').val() == 'plants' || jQuery('#create_spreadsheet_data_level').val() == 'subplots' ) {
            jQuery('#create_spreadsheet_plant_options').show();
        } else {
            jQuery('#create_spreadsheet_plant_options').hide();
        }
    });

    jQuery('#create_phenotyping_ok_button').on('click', function () {
        create_phenotype_spreadsheet();
    });

});


function create_phenotype_spreadsheet() {
    var list = new CXGN.List();
    var trait_list_id = jQuery('#trait_list_spreadsheet_list_select').val();
    var include_notes = jQuery('#include_notes_column').is(':checked');
    var trait_list;
    if (! trait_list_id == "") {
        trait_list = JSON.stringify(list.getList(trait_list_id));
    }
    else {
        alert(window.SGN && SGN.i18n ? SGN.i18n.p('trial.spreadsheet.trait_list_required', "You must select a Trait List first") : "You must select a Trait List first");
        return;
    }
%  if ($trial_id){
        var trial_ids = [<% $trial_id %>];
%  } else {
        var trial_ids = jQuery("#html_select_trial_for_create_spreadsheet").val();
%  }
    var trial_stock_type = "<% $trial_stock_type %>";
    new jQuery.ajax({
        type: 'POST',
        url: '/ajax/phenotype/create_spreadsheet',
        dataType: "json",
        data: {
            'trial_ids': JSON.stringify(trial_ids),
            'trait_list': trait_list,
            'include_notes': include_notes,
            'data_level': jQuery("#create_spreadsheet_data_level").val(),
            'sample_number': jQuery("#create_spreadsheet_sample_number").val(),
            'format': jQuery('#create_spreadsheet_phenotype_file_format').val(),
            'trial_stock_type': trial_stock_type
        },
        beforeSend: function() {
            jQuery('#working_modal').modal("show");
        },
        success: function (response) {
            jQuery('#working_modal').modal("hide");
            if (response.error) {
                alert(response.error);
            } else {
                //alert(response.filename);
                jQuery('#working_modal').modal("hide");
                window.location.href = "/download/"+response.filename;
            }
        },
        error: function () {
            jQuery('#working_modal').modal("hide");
            alert(window.SGN && SGN.i18n ? SGN.i18n.p('trial.spreadsheet.create_error', "An error occurred creating a phenotype file.") : "An error occurred creating a phenotype file.");
            jQuery('#create_spreadsheet_dialog').modal("hide");
        }
    });
}


</script>

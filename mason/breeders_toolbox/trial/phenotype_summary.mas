<%once>
use HTML::Entities ();
</%once>


<%args>
$trial_id
$trial_stock_type => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.dataTables-buttons-min', 'jquery.iframe-post-form', 'jszip-min', 'pdfmake.pdfmake-min', 'pdfmake.vfs_fonts', 'buttons.bootstrap-min', 'buttons.html5-min', 'jquery', 'jquery.dataTables', 'jquery.dataTables-select-min', 'd3.d3v4Min', 'd3.graphers.stackedObservationPhenotypeHistogram'] &>
<style>

.bar rect {
  fill: steelblue;
  shape-rendering: crispEdges;
}

.bar text {
  fill: #fff;
}

.axis path, .axis line {
  fill: none;
  stroke: #000;
  shape-rendering: crispEdges;
}

.form-group {
  display: flex;
  align-items: center;
}

.form-group label {
  margin-right: 10px;
  white-space: nowrap;
}

.form-group input,
.form-group select {
  flex-grow: 1;
}

input[type="text"] {
  width: 100px;
}

</style>


<div class="well well-sm table-responsive">

    <br/>

    <form class="form-horizontal" role="form" >
        <div style="display: flex; align-items: flex-start; gap: 25px; width: max-content; margin: 0 auto;">
            <div>
                <label for="summary_start_date"><% $c->i18n->p("trial.repetitive.start_date", "Start Date:") |h %> </label>
	            <input type="text" id="summary_start_date" title="summary_start_date" />
            </div>
            <div>
                <label for="summary_end_date"><% $c->i18n->p("trial.card.raw_data.end_date", "End Date:") |h %> </label>
	            <input type="text" id="summary_end_date" title="summary_end_date" />
            </div>
            <div>
                <label><% $c->i18n->p("lists_datasets.download.data_level", "Data Level:") |h %> </label>
                <div style="margin-top: 4px;">
% if ($trial_stock_type eq 'analysis_instance') {
                    <div><input type="radio" name="pheno_summary_table_data_level" id="pheno_summary_analysis_level" value="analysis_instance" checked> <label for="pheno_summary_analysis_level"><% $c->i18n->p("phenotype.analysis_values", "Analysis values") |h %></label></div>
% } else {
                    <div><input type="radio" name="pheno_summary_table_data_level" id="pheno_summary_plot_level" value="plots" checked> <label for="pheno_summary_plot_level"><% $c->i18n->p("global.graphical_filtering.plots", "Plots") |h %></label></div>
                    <div><input type="radio" name="pheno_summary_table_data_level" id="pheno_summary_subplot_level" value="subplots"> <label for="pheno_summary_subplot_level"><% $c->i18n->p("fieldbook.export.subplots", "Subplots") |h %></label></div>
                    <div><input type="radio" name="pheno_summary_table_data_level" id="pheno_summary_plant_level" value="plants"> <label for="pheno_summary_plant_level"><% $c->i18n->p("global.graphical_filtering.plants", "Plants") |h %></label></div>
                    <div><input type="radio" name="pheno_summary_table_data_level" id="pheno_summary_tissue_sample_level" value="tissue_samples"> <label for="pheno_summary_tissue_sample_level"><% $c->i18n->p("fieldbook.export.tissue_samples", "Tissue Samples") |h %></label></div>
% }
                </div>
            </div>
% if ($trial_stock_type ne 'analysis_instance') {
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <input type="checkbox" id="group_by_accession_check" title="group_by_accession_check" />
                    <label for="group_by_accession_check"><% $c->i18n->p("phenotype.group_by_accession", "Group by accession") |h %></label>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    <input type="checkbox" id="group_by_treatments_check" title="group_by_treatments_check" />
                    <label for="group_by_treatments_check"><% $c->i18n->p("phenotype.group_by_treatments", "Group by treatments") |h %></label>
                </div>
            </div>
% }
        </div>
    </form>
    <br>
    <div style="display:flex; align-items:center; white-space:nowrap; width:70%; margin-center: auto;">
        <label for="summary_phenotype_slider_range" style="margin-right: 10px;"><% $c->i18n->p("phenotype.choose_date_range", "Choose Date Range:") |h %></label>
        <div id="summary_phenotype_slider_range" style="width: 80%; margin: 10px auto;"></div>
    </div>
    <hr>

    <div id="pheno_summary_table_div">
        <table id="phenotype_summary_data" class="display">
        <thead>
        <tr>
        <th>Trait</th>
        <th>Mean</th>
        <th>Min</th>
        <th>Max</th>
        <th>Std Dev</th>
        <th>CV</th>
        <th>Count</th>
        <th>Percent Missing</th>
        <th>Histogram</th>
        </tr>
        </thead>
        <tbody>
        </tbody>
        </table>
    </div>
    <div>
        <button type="button" class="selectAll-dt"><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
        <button type="button" class="deselectAll-dt"><% $c->i18n->p("phenotype.deselect_all", "Deselect All") |h %></button>
    </div>
    <br>
    <div class="panel panel-default">
        <div class="panel-body">

            <&| /page/info_section.mas, anchor_title => 'Copy Selected Results to a List', title => HTML::Entities::encode_entities($c->i18n->p("phenotype.copy_selected_results_to_a_list", 'Copy Selected Results to a List')), collapsible=>1, collapsed=>0, subtitle=>("<i>" . HTML::Entities::encode_entities($c->i18n->p("phenotype.copy_the_names_currently_selected_in_the_first_column_of", "Copy the names currently selected in the first column of the summary table to a new or existing list")) . "</i>")&>
            <br>
            <p><em><span id="selected_row_count">0</span> <% $c->i18n->p("phenotype.row_s_selected", "row(s) selected.") |h %></em></p>
            <div style="text-align:right" id="names_to_list_menu"></div>
            <div id="selected_names" style="display: none;"></div>
            </&>

        </div>
    </div>
</div>

<div class="well well-sm" id="raw_data_histogram_well">
    <center><h4><% $c->i18n->p("phenotype.raw_data_histogram", "Raw Data Histogram") |h %></h4></center><hr>
    <div id="trial_summary_hist_div">
        <div class="row">
            <div class="col-sm-8">
                <form class="form-horizontal">
                    <div class="form-group form-group-sm">
                        <label for="trial_summary_hist_dropdown" class="col-sm-2 control-label"><% $c->i18n->p("phenotype.select", "Select:") |h %></label>
                        <div class="col-sm-10">
                            <div id="traits_assayed_dropdown">
                            </div>
                        </div>
                    </div>
                    <div class="form-group form-group-sm">
                        <label class="col-sm-2 control-label"><% $c->i18n->p("phenotype.data_level", "Data level:") |h %> </label>
                        <div class="col-sm-10" >
                            <select class="form-control" id="display_trial_phenosummary_hist">
%  if ($trial_stock_type eq 'analysis_instance') {
                                <option id="phenosummary_hist_analysis_instance_level" value="analysis_instance"><% $c->i18n->p("phenotype.values_for_analysis", "Values for Analysis") |h %></option>
%  } else {
                                <option id="phenosummary_hist_plot_level" value="plot"><% $c->i18n->p("global.graphical_filtering.plots", "Plots") |h %></option>
                                <option id="phenosummary_hist_plant_level" value="plant"><% $c->i18n->p("global.graphical_filtering.plants", "Plants") |h %></option>
                                <option id="phenosummary_hist_subplot_level" value="subplot"><% $c->i18n->p("fieldbook.export.subplots", "Subplots") |h %></option>
                                <option id="phenosummary_hist_tissue_sample_level" value="tissue_sample"><% $c->i18n->p("fieldbook.export.tissue_samples", "Tissue Samples") |h %></option>
%  }
                            </select>
                        </div>
                    </div>
                </form>
                <br/>

            </div>
            <div class="col-sm-4" id="traits_assayed_histogram_cvterm_link">
            </div>
        </div>

        <div id="trial_summary_hist">
        </div>

    </div>
</div>


<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<script>
// wrap code in an immediately invoked function, so we can use d3v4 as d3;
(function(){
    var d3 = d3v4;
    var draw_histogram = stackedObservationPhenotypeHistogram.draw;

    jQuery(document).ready(function () {
        var type = "<% $trial_stock_type %>";
        var trial_id = "<% $trial_id %>";

        var observation_levels = ['plot', 'plant', 'subplot', 'tissue_sample'];
    	for (let observation_level of observation_levels) {
    	    get_observation_variable_count(trial_id, observation_level)
    	    .then(function(count) {
				if (count < 1) {
                    jQuery(`#pheno_summary_${observation_level}_level`).prop('disabled', true);
                    jQuery(`#phenosummary_hist_${observation_level}_level`).prop('disabled', true);
                } 
    	    });
    	}

    	jQuery.ajax( {
            url: '/ajax/breeders/trial/'+ trial_id + '/collect_date_range',
    	}).done( function(r) {
            //alert('Setting start date to '+r.start_date+' and end date to '+r.end_date);
            if (!r.start_date || !r.end_date) { return; }
            // collect dates are 'YYYY-MM-DD HH:MM:SS' without time zone: keep the calendar day, because
            // new Date(...).toISOString() converts local time to UTC and can move it by one day
            var raw_startDate = r.start_date.split(' ')[0];
            var raw_endDate = r.end_date.split(' ')[0];
            jQuery('#summary_start_date').val(raw_startDate);
            jQuery('#summary_end_date').val(raw_endDate);

            jQuery('input[title="summary_start_date"]').on('focus', function () {
                jQuery(this).daterangepicker({
	                "singleDatePicker": true,
	                "showDropdowns": true,
	                "autoUpdateInput": true,
	                "startDate": "1960-01-01",
	                "yearSelect" : true,
	                "minDate": jQuery('#summary_start_date').val(),
	                "maxDate": jQuery('#summary_end_date').val(),
	                locale: {
	            	    format: 'YYYY-MM-DD'
	                }
	            },function(start) { 
                    var summary_new_start_date = new Date(start.format('YYYY-MM-DD')).getTime();
                    var summary_new_end_date = new Date(jQuery('#summary_end_date').val()).getTime();
                    jQuery('#summary_phenotype_slider_range').slider('values', [summary_new_start_date, summary_new_end_date]);
                });

            });
            jQuery('input[title="summary_end_date"]').on('focus', function () {
                jQuery(this). daterangepicker({
	                "singleDatePicker": true,
                    "showDropdowns": true,
	                "autoUpdateInput": true,
                    "minDate": jQuery('#summary_start_date').val(),
	                "maxDate": jQuery('#summary_end_date').val(),
	                "yearSelect" : true,
	                locale: { 
	            	    format: 'YYYY-MM-DD'
	                },
	            },function (end) {
                    var summary_new_start_date = new Date(jQuery('#summary_start_date').val()).getTime();
                    var summary_new_end_date = new Date(end.format('YYYY-MM-DD')).getTime();
                    jQuery('#summary_phenotype_slider_range').slider('values', [summary_new_start_date, summary_new_end_date]);
                });
            });

            jQuery('#summary_phenotype_slider_range').slider({
                range: true,
                min: new Date(raw_startDate).getTime(),
                max: new Date(raw_endDate).getTime(),
                values: [new Date(raw_startDate).getTime(), new Date(raw_endDate).getTime()],
                slide: function(event, ui) {
                    //the start and end date of this measurement will be updated based on the slider moved from.
                    var raw_phenotype_startDate = new Date(ui.values[0]).toISOString().split('T')[0];
                    var raw_phenotype_endDate = new Date(ui.values[1]).toISOString().split('T')[0];
                    jQuery('#summary_start_date').val(raw_phenotype_startDate);
                    jQuery('#summary_end_date').val(raw_phenotype_endDate);
                    //console.log("Slided moved Start_date in Pheno summ :", raw_phenotype_startDate);
                    //console.log("Slided moved End Date in pheno Summ :", raw_phenotype_endDate);

                    var html = setup_tables(type);
                    jQuery('#pheno_summary_table_div').empty().html(html);
                    datatables_display_phenosummary(type);
                }
            });
	    }).fail( function(xhr, status, error) { 
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.files.files.error", "An error occurred!") : 'An error occurred!') + xhr.responseText);
            console.error("the status:", xhr.status);
            console.error("the error:", error);
        });
        jQuery("#group_by_treatments_check").change( function() {
            var html = setup_tables(type);
            jQuery('#pheno_summary_table_div').empty().html(html);
            datatables_display_phenosummary(type);
        });
        jQuery("#group_by_accession_check").change( function() {
            var html = setup_tables(type);
            jQuery('#pheno_summary_table_div').empty().html(html);
            datatables_display_phenosummary(type);
        });
        jQuery('input[name="pheno_summary_table_data_level"]').on('change', function() {
            
            let level = jQuery('input[name="pheno_summary_table_data_level"]:checked').val();

            switch (level) {
                case 'plots' :
                    jQuery('#display_trial_phenosummary_hist').val('plot').trigger('change');
                    jQuery('#group_by_accession_check').prop('disabled', false);
                    break;
                case 'subplots' :
                    jQuery('#display_trial_phenosummary_hist').val('subplot').trigger('change');
                    jQuery('#group_by_accession_check').prop('checked', false);
                    jQuery('#group_by_accession_check').prop('disabled', true);
                    break;
                case 'plants' :
                    jQuery('#display_trial_phenosummary_hist').val('plant').trigger('change');
                    jQuery('#group_by_accession_check').prop('disabled', false);
                    break;
                case 'tissue_samples' :
                    jQuery('#display_trial_phenosummary_hist').val('tissue_sample').trigger('change');
                    jQuery('#group_by_accession_check').prop('disabled', false);
                    break;
            }

            var html = setup_tables(type);
            jQuery('#pheno_summary_table_div').empty().html(html);
            datatables_display_phenosummary(type);
        });
	    jQuery("#summary_start_date").change( function() {
	        //datatables_display_phenosummary(type);
            var html = setup_tables(type);
            jQuery('#pheno_summary_table_div').empty().html(html);
            datatables_display_phenosummary(type);
        });
    
        jQuery('#summary_end_date').change( function() {
	        //datatables_display_phenosummary(type);
	        var html = setup_tables(type);
            jQuery('#pheno_summary_table_div').empty().html(html);
            datatables_display_phenosummary(type);
        });

        jQuery("#display_trial_phenosummary_hist").change(function(){
            trait_summary_hist_display_change(this.value);
            jQuery(`#pheno_summary_${this.value}_level`).prop('checked', true);
            switch (this.value) {
                case 'plot':
                    jQuery('#group_by_accession_check').prop('disabled', false);
                    break;
                case 'tissue_sample':
                    jQuery('#group_by_accession_check').prop('disabled', false);
                    break;
                case 'subplot':
                    jQuery('#group_by_accession_check').prop('checked', false);
                    jQuery('#group_by_accession_check').prop('disabled', true);
                    break;
                case 'plant':
                    jQuery('#group_by_accession_check').prop('disabled', false);
                    break;
            }
            var html = setup_tables(type);
            jQuery('#pheno_summary_table_div').empty().html(html);
            datatables_display_phenosummary(type);
        });

        jQuery('#trial_detail_traits_assayed_onswitch').click( function() {
            init_summary_table(type);
        

%  if ($trial_stock_type eq 'analysis_instance') {
        trait_summary_hist_display_change('analysis_instance');
%  } else {
        trait_summary_hist_display_change('plot');
%  }
        });
        jQuery('#phenotype_summary_data').on('click', 'a[href^="#"]', function(event) {
            //console.log("scrolling histo into view");
            var offset = jQuery(window).height() - jQuery('#raw_data_histogram_well').height() - 40;
            var target = jQuery(this.getAttribute('href'));
            if( target.length ) {
                event.preventDefault();
                jQuery('html, body').stop().animate({
                    scrollTop: target.offset().top - offset
                }, 1500);
            }
        });

        var plots_stock_text = '';
        var plants_stock_text = '';
        var tissue_samples_stock_text = '';

        if (type == 'family_name') {
            plots_stock_text = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.plots_grouped_by_family_name", "Plots grouped by Family Name") : 'Plots grouped by Family Name');
            plants_stock_text = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.plants_grouped_by_family_name", "Plants grouped by Family Name") : 'Plants grouped by Family Name');
            tissue_samples_stock_text = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.tissue_samples_grouped_by_family_name", "Tissue Samples grouped by Family Name") : 'Tissue Samples grouped by Family Name');
        } else if (type == 'cross') {
            plots_stock_text = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.plots_grouped_by_cross_unique_id", "Plots grouped by Cross Unique ID") : 'Plots grouped by Cross Unique ID');
            plants_stock_text = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.plants_grouped_by_cross_unique_id", "Plants grouped by Cross Unique ID") : 'Plants grouped by Cross Unique ID');
            tissue_samples_stock_text = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.tissue_samples_grouped_by_cross_unique_id", "Tissue Samples grouped by Cross Unique ID") : 'Tissue Samples grouped by Cross Unique ID');
        } else {
            plots_stock_text = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.plots_grouped_by_accession", "Plots grouped by Accession") : 'Plots grouped by Accession');
            plants_stock_text = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.plants_grouped_by_accession", "Plants grouped by Accession") : 'Plants grouped by Accession');
            tissue_samples_stock_text = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.tissue_samples_grouped_by_accession", "Tissue Samples grouped by Accession") : 'Tissue Samples grouped by Accession');
        }
        jQuery('#plots_stock_option').text(plots_stock_text);
        jQuery('#plants_stock_option').text(plants_stock_text);
        jQuery('#tissue_samples_stock_option').text(tissue_samples_stock_text);

    });

    function datatables_display_phenosummary(type) {
        var start_date = jQuery('#summary_start_date').val();
        var end_date = jQuery('#summary_end_date').val();
        var group_by_treatments = jQuery('#group_by_treatments_check').prop('checked') ? 1 : 0;
        var group_by_accession = jQuery('#group_by_accession_check').prop('checked') ? 1 : 0;

        //alert('datatables_display_phenosummary: START: '+start_date+' END: '+end_date);
        var b22_summary_canonical_headers;
        var b22_summary_export_options = {
            format: {
                header: function(data, column, node) {
                    return b22_summary_canonical_headers[column];
                }
            }
        };
        var summary_table = jQuery('#phenotype_summary_data').DataTable( {
            "lengthMenu": [ 10, 20, 50, 100, 500, 1000 ],
            "retrieve": true,
            "dom": 'Bfrtip',
            'columnDefs': [ {
                'orderable': false,
                'className': 'select-checkbox',
                'targets':   0
            } ],
            'select': {
                'style':    'multi'
            },
            "buttons":  [
                'pageLength',
                { extend: 'copy', exportOptions: b22_summary_export_options },
                { extend: 'excel', exportOptions: b22_summary_export_options },
                { extend: 'csv', exportOptions: b22_summary_export_options },
                { extend: 'pdf', exportOptions: b22_summary_export_options }
            ],
            "ajax": '/ajax/breeders/trial/'+ trial_id + '/phenotypes?display='+jQuery('input[name="pheno_summary_table_data_level"]:checked').val() + '&trial_stock_type='+type + '&start_date='+start_date+'&end_date='+end_date+'&include_dateless_items=1&group_by_treatments='+group_by_treatments+'&group_by_accession='+group_by_accession,
            "processing": true,
            'language':{
                "zeroRecords": jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.no_data_available", "No data available") : "No data available")).html(),
                "processing": jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_publish.loading", "Loading...") : "Loading...")).html()
            }
        });

        b22_summary_canonical_headers = summary_table.buttons.exportData({rows: []}).header;
        var b22_summary_display_headers = [
            (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.stock.phenotype.header.trait", "Trait") : "Trait"),
            (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.usage.header.mean", "Mean") : "Mean"),
            (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.usage.header.min", "Min") : "Min"),
            (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.usage.header.max", "Max") : "Max"),
            (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.usage.header.stddev", "Std Dev") : "Std Dev"),
            "CV",
            (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.stock.phenotype.header.count", "Count") : "Count"),
            (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.percent_missing", "Percent Missing") : "Percent Missing"),
            (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.histogram", "Histogram") : "Histogram")
        ];
        if (group_by_treatments) {
            b22_summary_display_headers.unshift((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.treatment", "Treatment") : "Treatment"));
        }
        if (group_by_accession) {
            b22_summary_display_headers.unshift(type === 'family_name' ? (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.forms.family_name", "Family Name") : "Family Name") : type === 'cross' ? (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.cross_unique_id.923bfbc", "Cross Unique ID") : "Cross Unique ID") : (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.index_logged_in_user.accession", "Accession") : "Accession"));
        }
        summary_table.columns().every(function(column) {
            jQuery(this.header()).text(b22_summary_display_headers[column]);
        });

        summary_table.clear().draw();

        var selection_changed = function () {
            var selected_rows = summary_table.rows({'selected':true});
            var list_type = jQuery('#group_by_accession_check').prop('checked') ? 'accessions' : 'traits';
            jQuery("#selected_row_count").text(selected_rows.count());
            // console.log(selected_rows.data());

            var selected_names = [];
            selected_rows.data().map(function(row){
                selected_names.push(row[0].match(/<a [^>]+>([^<]+)<\/a>/)[1] + '\n');
            });

            jQuery('#selected_names').html(selected_names);
            addToListMenu('names_to_list_menu', 'selected_names', {
                listType: list_type
            });
        };

        summary_table.on( 'draw', selection_changed);
        summary_table.on( 'deselect', selection_changed);
        summary_table.on( 'select', selection_changed);

        jQuery('.selectAll-dt').click(function(){
          summary_table.rows().select();
          return false;
        });
        jQuery('.deselectAll-dt').click(function(){
          summary_table.rows().deselect();
          return false;
        });
    }

    function get_observation_variable_count(trial_id, observation_level) {
        return jQuery.ajax({
            url: "/brapi/v2/search/observations",
            method: "POST",
            data: { studyDbIds: [trial_id], observationLevel: [observation_level] }
        })
        .then(function(result) {
            //console.log('Search Results DbId:', result.result.searchResultsDbId);
            var searchResultsDbId = result.result.searchResultsDbId;
            return fetch_observations(searchResultsDbId);
        })
        .then(function(observations) {
            var variableIds = observations.map(function(obs) { return obs.observationVariableDbId; });
            var unique_obs_VariableIds = Array.from(new Set(variableIds));
            return unique_obs_VariableIds.length;
        });
    }

    function fetch_observations(searchResultsDbId) {
    	var observations = [];
    	function fetchPage(page) {
    	    return jQuery.ajax({
    	        url: "/brapi/v2/search/observations/" + searchResultsDbId,
    	        method: "GET",
    	        data: { page: page, pageSize: 10000 }
    	    })
    	    .then(function(result) {
    	        observations = observations.concat(result.result.data);
    	        var currentPage = result.metadata.pagination.currentPage;
    	        var totalPages = result.metadata.pagination.totalPages;
    	        if (currentPage < totalPages - 1) {
    	            return fetchPage(currentPage + 1);
    	        } else {
					//console.log('All pages fetched. Total observations:', observations.length);
    	            return observations;
    	        }
    	    });
    	}
    	return fetchPage(0);
	}

    function trait_summary_hist_display_change(value) {
        var start_date = jQuery('#summary_start_date').val();
        var end_date = jQuery('#summary_end_date').val();

        jQuery.ajax ( {
            url : '/ajax/breeders/trial/'+ trial_id + '/traits_assayed?stock_type='+value,
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response){
                //console.log(response);
                if (response.traits_assayed[0][0]) {
                    var traits_assayed_html = "<select class='form-control' id='trial_summary_hist_dropdown'>";
                    for (i=0; i<response.traits_assayed[0].length; i++) {
                        if (response.traits_assayed[0][i][1].includes("_TREATMENT")) {
                            continue;
                        }
                        traits_assayed_html = traits_assayed_html + "<option value="+ response.traits_assayed[0][i][0] + " >" + response.traits_assayed[0][i][1] + "</option>";
                    }
                    traits_assayed_html = traits_assayed_html +"</select>";
                    jQuery("#traits_assayed_dropdown").html(traits_assayed_html);
                    jQuery("#trial_summary_hist_dropdown").change(function(){
                      trait_summary_hist_change(this.value);
                    });

                    jQuery('#traits_assayed_histogram_cvterm_link').html("<a href='/cvterm/"+response.traits_assayed[0][0][0]+("/view'>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.definition", "Definition") : "Definition")).html() + "</a>"));


                let trait_value = jQuery('#trial_summary_hist_dropdown').val();

                if (trait_value == null) {
                jQuery('#working_modal').modal("hide");
                return;
		        }			

                    jQuery.ajax( {
                        url : '/ajax/breeders/trial/'+ trial_id +'/trait_phenotypes/?trait='+trait_value+'&display='+value+'&start_date='+start_date+'&end_date='+end_date+'&include_dateless_items=1',
                        type: 'POST',
                        success: function(response){
                            jQuery("#working_modal").modal("hide");
                            if (response.error) {
                                alert(response.error);
                            }
                            else if (response.status!="success"){
                                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.problem_loading_plant_plot_data", "Problem loading plant/plot data: ") : "Problem loading plant/plot data: ")+response.status);
                            }
                            else {
                                draw_histogram(response.data, d3.select("#trial_summary_hist").node());
                            }
                        },
                        error: function(response) {
                            jQuery("#working_modal").modal("hide");
                            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.an_error_occured_retrieving_trait_histogram_data", "An error occurred retrieving trait histogram data.") : 'An error occurred retrieving trait histogram data.'));
                        }
                    });
                } else {
                    jQuery("#working_modal").modal("hide");
                    jQuery("#trial_summary_hist").html(("<center><h4>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.there_is_no_data_to_plot", "There is no data to plot.") : "There is no data to plot.")).html() + "</h4></center>"));
                }

            },
            error: function(response){
                jQuery("#working_modal").modal("hide");
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.error_retrieving_traits_assayed_in_this_trial", "Error retrieving traits assayed in this trial") : 'Error retrieving traits assayed in this trial'));
            }

        });
    }

    function init_summary_table(type) {

        datatables_display_phenosummary(type);

        // get the earliest and last measurement date in the trial
    
        jQuery(document).on('change', '#display_trial_phenosummary', function() {
            var html = setup_tables(type);
            jQuery('#pheno_summary_table_div').empty().html(html);
            datatables_display_phenosummary(type);
        });
        //catch( function(r) { alert('An error occurred :-( '); )});
    }

    function setup_tables(type) {
        var html = '';
        var display = jQuery('input[name="pheno_summary_table_data_level"]:checked').val()
        var group_by_treatments = jQuery('#group_by_treatments_check').prop('checked') ? 1 : 0;
        var group_by_accession = jQuery('#group_by_accession_check').prop('checked') ? 1 : 0;
        var treatment_html = '';
        if (group_by_treatments) {
            treatment_html = '<th>Treatment</th>';
        }
        if (!group_by_accession) {
            html = html +'<table id="phenotype_summary_data" class="display"><thead><tr>'+treatment_html+'<th>Trait</th><th>Mean</th><th>Min</th><th>Max</th><th>Std Dev</th><th>CV</th><th>Count</th><th>Percent Missing</th><th>Histogram</th></tr></thead><tbody></tbody></table>';
        } else {
            if (type == 'family_name') {
                html = html +'<table id="phenotype_summary_data" class="display"><thead><tr><th>Family Name</th>'+treatment_html+'<th>Trait</th><th>Mean</th><th>Min</th><th>Max</th><th>Std Dev</th><th>CV</th><th>Count</th><th>Percent Missing</th><th>Histogram</th></tr></thead><tbody></tbody></table>';
            } else if (type == 'cross') {
                html = html +'<table id="phenotype_summary_data" class="display"><thead><tr><th>Cross Unique ID</th>'+treatment_html+'<th>Trait</th><th>Mean</th><th>Min</th><th>Max</th><th>Std Dev</th><th>CV</th><th>Count</th><th>Percent Missing</th><th>Histogram</th></tr></thead><tbody></tbody></table>';
            } else {
                html = html +'<table id="phenotype_summary_data" class="display"><thead><tr><th>Accession</th>'+treatment_html+'<th>Trait</th><th>Mean</th><th>Min</th><th>Max</th><th>Std Dev</th><th>CV</th><th>Count</th><th>Percent Missing</th><th>Histogram</th></tr></thead><tbody></tbody></table>';
            }
        }
        return html;
    }

    function trait_summary_hist_change(value) {
        jQuery("#trial_summary_hist_dropdown").val(value);
        jQuery('#traits_assayed_histogram_cvterm_link').html("<a href='/cvterm/"+value+("/view'>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.definition", "Definition") : "Definition")).html() + "</a>"));
        var start_date = jQuery('#summary_start_date').val();
        var end_date = jQuery('#summary_end_date').val();
    
        // console.log("value",value);
        jQuery.ajax( {
            url : '/ajax/breeders/trial/'+ trial_id +'/trait_phenotypes/?trait='+value+'&display='+jQuery('#display_trial_phenosummary_hist').val()+'&start_date='+start_date+'&end_date='+end_date+'&include_dateless_items=1',
            type: 'POST',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response){
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                }
                else if (response.status!="success"){
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.problem_loading_plant_plot_data", "Problem loading plant/plot data: ") : "Problem loading plant/plot data: ")+response.status);
                }
                else {
                    draw_histogram(response.data, d3.select("#trial_summary_hist").node());
                }
            },
            error: function(response) {
                jQuery("#working_modal").modal("hide");
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.an_error_occured_retrieving_trait_histogram_data", "An error occurred retrieving trait histogram data.") : 'An error occurred retrieving trait histogram data.'));
            }
        });
    }

//end of immediately inoked function
})();

</script>

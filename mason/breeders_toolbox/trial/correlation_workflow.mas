<%once>
use HTML::Entities ();
</%once>
<%args>
$trial_id => undef
$is_analysis => undef
</%args>

<& /util/import_javascript.mas, classes => [ ] &>

<div class="well well-sm">
    <button class="btn btn-primary" id="trial_detail_page_analysis_correlation_workflow"><% $c->i18n->p("trial.correlation.title", "Find Correlation Between Saved Measurements") |h %></button>
</div>
<hr>

<div class="modal fade" id="trial_analysis_correlation_workflow_dialog" name="trial_analysis_correlation_workflow_dialog" tabindex="-1" role="dialog" aria-labelledby="trialAnalysisCorrelationWorkflowDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("trial.correlation.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="trialAnalysisCorrelationWorkflowDialog"><% $c->i18n->p("trial.correlation.title", "Find Correlation Between Saved Measurements") |h %></h4>
            </div>
            <div class="modal-body">

                <&| /util/workflow.mas, id=> "trial_analysis_correlation_workflow_dialog_workflow" &>
                    <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p("trial.correlation.step_input", "Input")) &>
                        <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("trial.correlation.page_input", "Select the input measurements to correlate")) &>
                
                        <div class="container-fluid">
                            <div class="form-horizontal">

                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("trial.correlation.observation_level", "Observation Unit Level: ") |h %></label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="trial_analysis_correlation_workflow_observation_level">
%  if ($is_analysis) {
                                            <option value="analysis_instance"><% $c->i18n->p("trial.correlation.level.analysis_instance", "Analysis Instance") |h %></option>
%  } else {
                                            <option value="plot"><% $c->i18n->p("trial.correlation.level.plot", "Plot") |h %></option>
%  }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("trial.correlation.method", "Correlation Method: ") |h %></label>
                                    <div class="col-sm-9" >
                                        <select class="form-control" id="trial_analysis_correlation_workflow_correlation_type">
                                            <option value="pearson">Pearson</option>
                                            <option value="spearman">Spearman</option>
                                            <option value="kendall">Kendall</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("trial.correlation.traits", "Trait(s): ") |h %></label>
                                    <div class="col-sm-9" >
                                        <div id="trial_analysis_correlation_workflow_traits_div"></div>
                                    </div>
                                </div>

                            </div>
                            
                            <hr>
                            <center>
                                <button type="button" class="btn btn-primary" name="trial_analysis_correlation_workflow_submit" id="trial_analysis_correlation_workflow_submit" title="<% $c->i18n->p("trial.correlation.submit", "Submit") |h %>"><% $c->i18n->p("trial.correlation.submit", "Submit") |h %></button>
                            </center>
                        </div>
                    </&>
                    <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p("trial.correlation.step_output", "Output")) &>
                        <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("trial.correlation.results", "Results")) &>

                        <div id="trial_analysis_correlation_workflow_results_div"></div>
                    </&>
                </&>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("trial.correlation.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery('#trial_detail_page_analysis_correlation_workflow').click( function(){
        jQuery('#trial_analysis_correlation_workflow_dialog').modal('show');

        get_select_box('traits', 'trial_analysis_correlation_workflow_traits_div', { 'name' : 'trial_analysis_correlation_workflow_traits_ids', 'id' : 'trial_analysis_correlation_workflow_traits_ids', 'empty':1, 'trial_ids':<% $trial_id %>, 'stock_type':'plot', 'multiple':1, 'size':30 });
    });

    jQuery('#trial_analysis_correlation_workflow_submit').click(function() {
        var selected_trait_ids = jQuery('#trial_analysis_correlation_workflow_traits_ids').val();
        console.log(selected_trait_ids);

        if (!selected_trait_ids || selected_trait_ids.length < 1) {
            alert(window.SGN && SGN.i18n ? SGN.i18n.p("trial.correlation.traits_required", "Please select at least one trait!") : "Please select at least one trait!");
            return false;
        }
        else {
            jQuery.ajax({
                url : '/ajax/breeders/trial/<% $trial_id %>/correlate_traits?trait_ids='+JSON.stringify(selected_trait_ids)+'&observation_unit_level='+jQuery('#trial_analysis_correlation_workflow_observation_level').val()+'&correlation_type='+jQuery('#trial_analysis_correlation_workflow_correlation_type').val(),
                beforeSend: function() {
                    jQuery("#working_modal").modal("show");
                },
                success: function(response){
                    console.log(response);
                    jQuery("#working_modal").modal("hide");
                    if (response.error) {
                        alert(response.error);
                    }
                    else {
                        var html = '<table class="table table-hover table-bordered"><thead><tr>';
                        for(var i=0; i<response.result[0].length; i++) {
                            html = html + '<th>'+response.result[0][i]+'</th>';
                        }
                        html = html + '</tr></thead>';
                        for(var i=1; i<response.result.length; i++) {
                            html = html + '<tr>';
                            for(var j=0; j<response.result[i].length; j++) {
                                html = html + '<td>'+response.result[i][j]+'</td>';
                            }
                            html = html + '</tr>';
                        }
                        html = html + '</tbody></table>';
                        jQuery('#trial_analysis_correlation_workflow_results_div').html(html);

                        Workflow.complete("#trial_analysis_correlation_workflow_submit");
                        Workflow.focus('#trial_analysis_correlation_workflow_dialog_workflow', 1);
                    }
                },
                error: function(response){
                    jQuery("#working_modal").modal("hide");
                    alert(window.SGN && SGN.i18n ? SGN.i18n.p("trial.correlation.error", "Error doing correlation!") : "Error doing correlation!");
                }
            });
        }
        
    });

});

</script>

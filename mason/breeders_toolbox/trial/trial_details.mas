<%args>
$trial_id
$trial_name
$breeding_program_name
$breeding_program_id
$location_name
$country_name
$year
$trial_type
$planting_date
$transplanting_date
$harvest_date
$trial_description
$folder_name
$folder_id
$identifier_prefix
$plot_width
$plot_length
$field_size
$field_trial_is_planned_to_be_genotyped
$field_trial_is_planned_to_cross
$trial_stock_type
$trial_stock_count
$trial_owner
$latest_trial_activity => undef
$plot_name_template => undef

</%args>

<%init>
use HTML::Entities ();
use CXGN::JSONUtils qw(decode_stored_json);
my ($dap, $dah);

sub _normalize_to_ymd {
    my ($s) = @_;
    return undef unless defined $s;
    $s =~ s/^\s+|\s+$//g;

    # "YYYY-MonthName-DD" -> "YYYY-mm-dd"  (e.g., 2025-November-14)
    if ($s =~ /^(\d{4})[-\/](\p{L}+)[-\/](\d{1,2})$/) {
        my ($y, $mon, $d) = ($1, lc($2), $3);
        $mon =~ s/[^a-z]//g;

        my %m = (
            jan=>1, january=>1, feb=>2, february=>2, mar=>3, march=>3,
            apr=>4, april=>4, may=>5, jun=>6, june=>6, jul=>7, july=>7,
            aug=>8, august=>8, sep=>9, sept=>9, september=>9,
            oct=>10, october=>10, nov=>11, november=>11, dec=>12, december=>12
        );

        my $mnum = $m{$mon} || $m{substr($mon,0,3)};
        return $mnum ? sprintf("%04d-%02d-%02d", $y, $mnum, $d) : undef;
    }

    # "YYYY-m-d" or "YYYY/mm/dd" -> "YYYY-mm-dd"
    if ($s =~ /^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})$/) {
        return sprintf("%04d-%02d-%02d", $1, $2, $3);
    }

    return undef;
}

sub _days_since {
    my ($date_str) = @_;
    return undef unless $date_str;

    my $ymd = _normalize_to_ymd($date_str);
    return undef unless $ymd;

    eval {
        require Time::Piece;
        my $tp = Time::Piece->strptime($ymd, '%Y-%m-%d');
        my $today = Time::Piece::localtime();
        my $diff_days = int( ($today - $tp) / (24*60*60) );
        return ($diff_days >= 0) ? $diff_days : undef;
    } || undef;
}

sub _positive_integer_conf {
    my ($conf_name) = @_;
    my $value = eval { $c->get_conf($conf_name) };
    return undef unless defined $value && $value =~ /^\d+$/ && $value > 0;
    return int($value);
}

sub _limit_days_display {
    my ($days, $limit) = @_;
    return undef unless defined $days;
    return (defined $limit && $days >= $limit) ? '>'.$limit : $days;
}

$dap = _days_since($planting_date);
$dah = _days_since($harvest_date);
my $display_dap_dah = eval { $c->get_conf('display_dap_dah') } ? 1 : 0;
my $dap_display = $display_dap_dah ? _limit_days_display($dap, _positive_integer_conf('limit_dap')) : undef;
my $dah_display = $display_dap_dah ? _limit_days_display($dah, _positive_integer_conf('limit_dah')) : undef;

my ($plot_name_template_name, $plot_name_template_display);
if ($plot_name_template) {
    my $tmpl = eval { decode_stored_json($plot_name_template) };
    if ($tmpl) {
        ($plot_name_template_name) = keys %$tmpl;
        my $name_attributes = $tmpl->{$plot_name_template_name}->{name_attributes} || [];
        my @parts = map { ref $_ eq 'HASH' ? ($_->{text} // '') : '{' . $_ . '}' } @$name_attributes;
        $plot_name_template_display = join('_', @parts);
    }
}
</%init>


<div class="row">
    <div class="col-sm-8">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b><% $c->i18n->p('trial.summary.label.name', 'Trial Name') | h %></b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print HTML::Entities::encode_entities($trial_name);
% } else {
%   print "<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.name', '[No Trial Name]')) . "</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('trial.summary.label.program', 'Breeding Program ') | h %></b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
                    <a href="/breeders/program/<% $breeding_program_id | h %>"><% $breeding_program_name | h %></a>
% }
% else {
%  print "<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.program', '[No Breeding Program]')) . "</span>";
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('trial.summary.label.location', 'Trial Location') | h %></b></td>
                <td>
                    <div id="trial_location">
% if ($location_name) {
%  print HTML::Entities::encode_entities("$location_name ( $country_name )");
% } else {
%  print "<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.location', '[No Location]')) . "</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('trial.summary.label.year', 'Year') | h %></b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print HTML::Entities::encode_entities($year);
% } else {
%  print "<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.year', '[No Year]')) . "</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('trial.summary.label.stock_type', 'Stock Type Being Evaluated in This Trial') | h %></b></td>
                <td>
                    <div id="stock_type_in_trial">
% if ($trial_stock_type) {
%     print HTML::Entities::encode_entities($trial_stock_type);
% } else {
%     print "accession";
% }
                    </div>
                </td>
            </tr>

	    <tr>
                <td><b><% $c->i18n->p('trial.summary.label.stock_count', 'Number of Stocks in This Trial') | h %></b></td>
                <td>
                    <div id="stock_number_in_trial">
% if ($trial_stock_count) {
%     print HTML::Entities::encode_entities($trial_stock_count);
% } else {
% print "<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.stocks', '[No Stocks in Trial]')) . "</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('trial.summary.label.type', 'Trial Type') | h %></b></td>
                <td>
                    <div id="trial_type">
% if ($trial_type) {
%  print HTML::Entities::encode_entities($trial_type);
% } else {
% print "<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.type', '[Type not set]')) . "</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('trial.summary.label.planting_date', 'Planting Date') | h %></b></td>
                <td>
                    <div id="planting_date">
% if ($planting_date) {
<a href="/breeders/trial/<% $trial_id | h %>?currentDate=<% $planting_date | h %>" ><% $planting_date | h %></a>
% if (defined $dap_display) {
&nbsp;<span>| DAP: <% $dap_display %> </span>
% }
% } else {
%  print "<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.planting_date', '[No Planting Date]')) . "</span>";
% }
                    </div>
                </td>
            </tr>
% if ($transplanting_date && $transplanting_date ne '') {
<tr>
    <td><b><% $c->i18n->p('trial.summary.label.transplanting_date', 'Transplanting Date') | h %></b></td>
    <td>
        <div id="transplanting_date">
            <a href="/breeders/trial/<% $trial_id | h %>?currentDate=<% $transplanting_date | h %>" ><% $transplanting_date | h %></a>
        </div>
    </td>
</tr>
% }
            <tr>
                <td><b><% $c->i18n->p('trial.summary.label.harvest_date', 'Harvest Date') | h %></b></td>
                <td>
                    <div id="harvest_date">
% if ($harvest_date) {
<a href="/breeders/trial/<% $trial_id | h %>?currentDate=<% $harvest_date | h %>" ><% $harvest_date | h %></a>
% if (defined $dah_display) {
&nbsp;<span> | DAH: <% $dah_display %> </span>
% }
% } else {
%  print "<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.harvest_date', '[No Harvest Date]')) . "</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p('trial.summary.label.description', 'Description') | h %></b></td>
                <td>
% if ($trial_description) {
%  print "<div id='trial_description' style='white-space: pre-wrap;'>" . HTML::Entities::encode_entities($trial_description) . "</div>";
% } else {
%  print "<div id='trial_description'><span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.description', '[No Description]')) . "</span></div>";
% }
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('trial.summary.label.folder', 'Folder') | h %></b></td>
                <td>
                    <span id="trial_folder_div"><a href="/folder/<% $folder_id | h %>"><% $folder_name | h %></a></span>
                    <br/><br/>
                    <button class="btn btn-sm btn-default" style="margin:3px" id="new_folder_dialog_link"><% $c->i18n->p('trial.summary.folder.new', 'New Folder') | h %></button> <button class="btn btn-sm btn-default" style="margin:3px" id="open_folder_dialog_link"><% $c->i18n->p('trial.summary.folder.change', 'Change Folder') | h %></button>
                </td>
            </tr>

	    <tr><td><b><% $c->i18n->p('trial.summary.label.owner', 'Created by') | h %></b></td>
                <td>
                    <div id="trial_owner">
% if ($trial_owner) {
%  print "$trial_owner";
% } else {
%  print "<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.owner', '[N/A]')) . "</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('trial.summary.label.latest_activity', 'Latest Trial Activity') | h %></b></td>
                <td>
                        <div id="latest_trial_activity">
% if ($latest_trial_activity) {
%  print "<span class='text-success'>" . HTML::Entities::encode_entities($latest_trial_activity) . "</span>";
% } else {
%  print "<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.activity', '[No Record]')) . "</span>";
% }
                        </div>
                    </td>
                </tr>

% if ($plot_name_template_display) {
            <tr>
                <td><b><% $c->i18n->p('trial.summary.label.plot_name_template', 'Plot Name Template') | h %></b></td>
                <td>
                    <div id="plot_name_template">
                        <div><b><% $plot_name_template_name | h %></b></div>
                        <div><% $plot_name_template_display | h %></div>
                    </div>
                </td>
            </tr>
% }

        </table>

    </div>
    <div class="col-sm-4">
        <div class="well well-sm">
            <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> HTML::Entities::encode_entities($trial_name), format=>"trial_qrcode"  &>
        </div>

        <table class="table table-hover table-bordered">
            <tr><td><b><% $c->i18n->p('trial.summary.label.plot_width', 'Plot Width (m)') | h %></b></td>
                <td>
                    <div id="plot_width">
% if ($plot_width) {
%  print HTML::Entities::encode_entities($plot_width);
% } else {
%  print "<span class='text-default'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.plot_width', '[No Plot Width]')) . "</span>";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b><% $c->i18n->p('trial.summary.label.plot_length', 'Plot Length (m)') | h %></b></td>
                <td>
                    <div id="plot_length">
% if ($plot_length) {
%  print HTML::Entities::encode_entities($plot_length);
% } else {
%  print "<span class='text-default'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.plot_length', '[No Plot Length]')) . "</span>";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b><% $c->i18n->p('trial.summary.label.field_size', 'Field Size (ha)') | h %></b></td>
                <td>
                    <div id="field_size">
% if ($field_size) {
%  print HTML::Entities::encode_entities($field_size);
% } else {
%  print "<span class='text-default'>" . HTML::Entities::encode_entities($c->i18n->p('trial.summary.empty.field_size', '[No Field Size]')) . "</span>";
% }
                    </div>
                </td>
            </tr>
            <tr><td><b><% $c->i18n->p('trial.summary.label.planned_genotyping', 'Trial Will Be Genotyped') | h %></b></td>
                <td>
                    <div id="planned_to_be_genotyped">
% if ($field_trial_is_planned_to_be_genotyped && $field_trial_is_planned_to_be_genotyped eq 'yes') {
    <% $c->i18n->p('trial.summary.plan.yes', 'yes') | h %>
% } elsif (!$field_trial_is_planned_to_be_genotyped || $field_trial_is_planned_to_be_genotyped eq 'no') {
    <% $c->i18n->p('trial.summary.plan.no', 'no') | h %>
% } else {
    <% $field_trial_is_planned_to_be_genotyped | h %>
% }
                    </div>
                </td>
            </tr>
            <tr><td><b><% $c->i18n->p('trial.summary.label.planned_crossing', 'Trial Will Be In Crosses') | h %></b></td>
                <td>
                    <div id="planned_to_cross">
% if ($field_trial_is_planned_to_cross && $field_trial_is_planned_to_cross eq 'yes') {
    <% $c->i18n->p('trial.summary.plan.yes', 'yes') | h %>
% } elsif (!$field_trial_is_planned_to_cross || $field_trial_is_planned_to_cross eq 'no') {
    <% $c->i18n->p('trial.summary.plan.no', 'no') | h %>
% } else {
    <% $field_trial_is_planned_to_cross | h %>
% }
                    </div>
                </td>
            </tr>
        </table>
    </div>
</div>

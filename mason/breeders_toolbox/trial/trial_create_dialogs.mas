                                <button id="next_step_design_information_button" type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this); return false;" ><% $c->i18n->p('trial.create.next_metadata', 'Continue to Next Step') |h %></button>
                                <center>

                            </&>
                            <&| /util/workflow.mas:step, title=> encode_entities($c->i18n->p('trial.create.step.linkage', 'Trial Linkage')) &>
                                <& /page/page_title.mas, title=>encode_entities($c->i18n->p('trial.create.linkage.title', 'Is your trial linked with other field trials, genotyping plates, or crossing experiments in the database? If you are unsure, you can skip this. This information can be added from the trial detail page after the trial is saved.')) &>

                                <br/>
                                <div class="well">
                                    <div class="form-group">
                                        <label class="col-sm-5 control-label"><% $c->i18n->p('trial.create.linkage.previous_question', 'Is this trial following-up a previous field trial?:') |h %> </label>
                                        <div class="col-sm-7">
                                            <select class="form-control" id="add_project_trial_sourced" name="add_project_trial_sourced">
                                                <option value="no"><% $c->i18n->p('trial.create.linkage.no', 'No') |h %></option>
                                                <option value="yes"><% $c->i18n->p('trial.create.linkage.yes', 'Yes') |h %></option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group" style="display:none" id="add_trial_source_trial_section">
                                        <label class="col-sm-5 control-label"><% $c->i18n->p('trial.create.linkage.previous_select', 'Select the trial(s) which preceded this trial:') |h %> </label>
                                        <div class="col-sm-7">
                                            <div id="add_project_trial_source" name="add_project_trial_source">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <p><% $c->i18n->p('trial.create.linkage.genotyping_help', 'If you go on to collect tissue samples for creating a 96 well plate for genotyping, when adding the genotyping plate (96 well plate layout) to the database you can use plot names or plant names or tissue sample names from this field trial. By doing so, we can create linkage between this field trial and the genotyping plate.') |h %></p>

                                <div class="well">
                                    <div class="form-group">
                                        <label class="col-sm-5 control-label"><% $c->i18n->p('trial.create.linkage.genotyped_question', 'Will this trial be genotyped?:') |h %> </label>
                                        <div class="col-sm-7">
                                            <select class="form-control" id="add_project_trial_will_be_genotyped" name="add_project_trial_will_be_genotyped">
                                                <option value="no"><% $c->i18n->p('trial.create.linkage.no', 'No') |h %></option>
                                                <option value="yes"><% $c->i18n->p('trial.create.linkage.yes', 'Yes') |h %></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <p><% $c->i18n->p('trial.create.linkage.crossing_help', 'If you go on to perform crosses on this field trial, each cross can be linked to specific female and male plots. When you upload these crosses we can then automatically link this field trial to the crossing experiment in the database.') |h %></p>

                                <div class="well">
                                    <div class="form-group">
                                        <label class="col-sm-5 control-label"><% $c->i18n->p('trial.create.linkage.crossed_question', 'Will crosses be done on this trial?:') |h %> </label>
                                        <div class="col-sm-7">
                                            <select class="form-control" id="add_project_trial_will_be_crossed" name="add_project_trial_will_be_crossed">
                                                <option value="no"><% $c->i18n->p('trial.create.linkage.no', 'No') |h %></option>
                                                <option value="yes"><% $c->i18n->p('trial.create.linkage.yes', 'Yes') |h %></option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <br/>
                                <center>
                                <button id="next_step_trail_linkage_button" type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this); return false;" ><% $c->i18n->p('trial.create.next_metadata', 'Continue to Next Step') |h %></button>
                                <center>
                            </&>
                            <&| /util/workflow.mas:step, title=> encode_entities($c->i18n->p('trial.create.step.field_map', 'Field Map Information')) &>
                                <& /page/page_title.mas, title=>encode_entities($c->i18n->p('trial.create.field_map.title', 'Specify the number of rows and columns for the entire field')) &>
                                <p><% $c->i18n->p('trial.create.field_map.default', 'By default field map display is set to serpentine and uses the block or rep number as row number.') |h %></p>
                                <p><% $c->i18n->p('trial.create.field_map.skip', 'If you do not want to create field map along with this trial, set \'Plot layout format\' to \'select plot layout format\'.') |h %></p>
                                <p><% $c->i18n->p('trial.create.field_map.unknown', 'If you do not know exactly in which rows and columns you will end up planting the plots, do not provide this and go to the next step.') |h %></p>
                                <p><% $c->i18n->p('trial.create.field_map.irregular', 'If you will plant your plots in an irregular (non-rectangular) layout, do not provide this and go to the next step.') |h %></p>
                                <p><% $c->i18n->p('trial.create.field_map.upload_later', 'You can upload the exact row and column information for your plots (in any layout shape) on the Trial Detail Page after you have created the trial in the database and actually planted the experiment.') |h %></p>

                                <hr>
                                <div class="form-group"  id="FieldMap_westcott" style="display: none">
                                    <label class="col-sm-4 control-label"><% $c->i18n->p('trial.create.field_map.display', 'Field map display:') |h %> </label>
                                    <div class="col-sm-8" > <label class="col-sm-8 control-label">
                                        <input type="checkbox" id="westcott_field_map" checked="checked" disabled/>  <% $c->i18n->p('trial.create.field_map.included', '(comes with design)') |h %></label>
                                    </div>
                                </div>
                                <div class="form-group"  id="FieldMap">
                                    <label class="col-sm-4 control-label"><% $c->i18n->p('trial.create.field_map.display', 'Field map display:') |h %> </label>
                                    <div class="col-sm-8" >
                                        <input type="checkbox" id="show_field_map_options" checked="checked"/>
                                    </div>
                                </div>

                                <div id="field_map_options" >
                                    <!--<div class="form-group form-group-sm" >
                                        <label class="col-sm-7 control-label">Number of columns per row (uses accession number by default): </label>
                                        <div class="col-sm-5" >
                                            <input type="text" class="form-control" id="fieldMap_col_number" name="fieldMap_col_number" />
                                        </div>
                                    </div> -->
                                    <div class="form-group form-group-sm" id="field_map_row_aug">
                                        <label class="col-sm-7 control-label"><% $c->i18n->p('trial.create.field_map.rows', 'Number of rows (required):') |h %> </label>
                                        <div class="col-sm-5" >
                                          <input type="text" class="form-control" id="fieldMap_row_number" name="fieldMap_row_number" placeholder="<% $c->i18n->p('trial.create.field_map.rows_default', 'Will use number of blocks by default') |h %>"/>
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm" >
                                        <label class="col-sm-7 control-label"><% $c->i18n->p('trial.create.field_map.layout', 'Plot layout format:') |h %> </label>
                                        <div class="col-sm-5" >
                                          <select class="form-control" id="plot_layout_format" name="plot_layout_format">
                                            <option value=""><% $c->i18n->p('trial.create.field_map.select_layout', 'select plot layout format') |h %></option>
                                            <option value=zigzag><% $c->i18n->p('trial.create.field_map.zigzag', 'Zigzag(unserpentine)') |h %></option>
                                            <option value=serpentine selected="selected"><% $c->i18n->p('trial.create.field_map.serpentine', 'Serpentine') |h %></option>
                                          </select>
                                        </div>
                                    </div>
                                </div>

                                <br/>
                                <center>
                                <button id="next_step_field_map_button"  type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this); return false;" ><% $c->i18n->p('trial.create.next_metadata', 'Continue to Next Step') |h %></button>
                                <center>

                            </&>
                            <&| /util/workflow.mas:step, title=> encode_entities($c->i18n->p('trial.create.step.plot_naming', 'Custom Plot Naming')) &>
                                <& /page/page_title.mas, title=>encode_entities($c->i18n->p('trial.create.plot_naming.title', 'If you want to change the way in which plot names will be generated by the database')) &>
                                <ul class="nav nav-pills nav-justified" id="plot_naming_tabs">
                                    <li class="active"><a href="#plot_naming_tab_default" data-toggle="tab"><% $c->i18n->p('trial.create.plot_naming.default', 'Default plot names') |h %></a></li>
                                    <li><a href="#plot_naming_tab_template" data-toggle="tab"><% $c->i18n->p('trial.create.plot_naming.template', 'Use plot name template from breeding program') |h %></a></li>
                                    <li><a href="#plot_naming_tab_custom" data-toggle="tab"><% $c->i18n->p('trial.create.plot_naming.custom', 'Custom plot naming/numbering') |h %></a></li>
                                </ul>
                                <div class="tab-content" style="margin-top:15px">
                                    <div id="plot_naming_tab_default" class="tab-pane active">
                                    </div>
                                    <div id="plot_naming_tab_template" class="tab-pane">
                                        <div id="plot_template_radios">
                                            <p><em><% $c->i18n->p('trial.create.plot_naming.loading', 'Loading available templates...') |h %></em></p>
                                        </div>
                                        <br>
                                        <button type="button" class="btn btn-sm btn-primary" id="trial_design_add_plot_name_template_button" style="margin-top:5px"><% $c->i18n->p('trial.create.plot_naming.create_template', 'Create New Plot Name Template') |h %></button>
                                    </div>
                                    <div id="plot_naming_tab_custom" class="tab-pane">
                                        <p><% $c->i18n->p('trial.create.plot_naming.prefix_help', 'It is recommended to allow the database to create the plot prefixes, so leave the prefix blank unless necessary.') |h %></p>

                                <div id="plot_naming_options">
	                          <div class="form-group form-group-sm">
				    <span class="col-sm-1">
				      <input type="radio" name="plot_numbering_scheme"  id="block_based" value="block_based" checked="checked" />
				    </span>
                                    <span class="col-sm-11"><% $c->i18n->p('trial.create.plot_naming.block_based', 'block based plot numbers (increment leading digit for every block)') |h %></span>
				  </div>
				  <div class="form-group form-group-sm">
				    <span class="col-sm-1">
				      <input type="radio" name="plot_numbering_scheme" id="consecutive" value="consecutive" />
				    </span>
				    <span class="col-sm-11">
				      <% $c->i18n->p('trial.create.plot_naming.consecutive', 'consecutive plot numbers throughout the blocks') |h %>
				    </span>
				  </div>

                                     <div class="form-group form-group-sm" >
                                         <label class="col-sm-4 control-label"><% $c->i18n->p('trial.create.plot_naming.prefix', 'Plot prefix:') |h %> </label>
                                         <div class="col-sm-8" >
                                             <input type="text" class="form-control" id="plot_prefix" name="plot_prefix" placeholder="<% $c->i18n->p('trial.create.plot_naming.optional', 'Optional') |h %>" />
                                         </div>
                                      </div>
                                      <div class="form-group form-group-sm" >
                                          <label class="col-sm-4 control-label"><% $c->i18n->p('trial.create.plot_naming.start', 'Plot start number:') |h %> </label>
                                          <div class="col-sm-8" >
                                              <select class="form-control" id="start_number" name="start_number">
                                                  <option value=1 >1</option>
                                                  <option value=101 >101</option>
                                                  <option value=1001 >1001</option>
                                               </select>
                                            <!--<input type="text" class="form-control" id="start_number" name="start_number" />-->
                                          </div>
                                       </div>
                                       <div class="form-group form-group-sm" >
                                           <label class="col-sm-4 control-label"><% $c->i18n->p('trial.create.plot_naming.increment', 'Plot number increment:') |h %> </label>
                                           <div class="col-sm-8" >
                                               <input type="text" class="form-control" id="increment" name="increment" placeholder="1"/>
                                           </div>
                                       </div>
                                   </div>
                                    </div>
                                </div>
                                <br/>
                                <center>
                                <button type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this, false); return false;" name="new_trial_submit" id="new_trial_submit"><% $c->i18n->p('trial.create.next_metadata', 'Continue to Next Step') |h %></button>
                                <center>

                            </&>
                            <&| /util/workflow.mas:step, title=> encode_entities($c->i18n->p('trial.create.step.review', 'Review Designed Trial')) &>
                                <& /page/page_title.mas, title=>encode_entities($c->i18n->p('trial.create.review.title', 'Review the generated trial layout. Make sure to click Submit at the bottom of this page if you approve of the trial!')) &>

                                <div id="trial_design_warning_message">
                                </div>

                                <div class="well">
                                    <center><p><% $c->i18n->p('trial.create.review.help', 'Check to confirm that your design looks good. If there are any problems you can redo the randomization step.') |h %></p></center>
                                    <div class="d3_legend" id="d3_legend"> <p></br>  &nbsp;&nbsp; <ul class="legend">
                                        <li><span class="d3_block_even_number"></span> <% $c->i18n->p('trial.create.review.even_blocks', 'Even Block Numbers (e.g. 2,4,...)') |h %></li>
                                        <li><span class="d3_block_odd_number"></span> <% $c->i18n->p('trial.create.review.odd_blocks', 'Odd Block Numbers (e.g. 1,3,...)') |h %></li>
                                        <li><span class="d3_checks"></span> <% $c->i18n->p('trial.create.review.checks', 'Checks') |h %></li>
                                        <li><span class="d3_rep_odd_number"></span> <% $c->i18n->p('trial.create.review.odd_reps', 'Odd Rep Numbers (e.g. 1,3,...)') |h %></li>
                                        <li><span class="d3_rep_even_number"></span> <% $c->i18n->p('trial.create.review.even_reps', 'Even Rep Numbers (e.g. 2,4,...)') |h %></li>
                                    </div>
                                    <div id="container_field_map_view" ></div>
                                    <div id="no_map_view_MSG" ><% $c->i18n->p('trial.create.review.no_map', 'No field map to display...') |h %></div>
                                </div>

                                <div id="trial_design_view_layout_return">
                                </div>
                                <br/>
                                <center>
                                    <button class="btn btn-info btn-lg" id="redo_trial_layout_button" ><% $c->i18n->p('trial.create.review.redo', 'Redo Randomization') |h %></button>
                                </center>

                                <hr>
                                <p><span class="ui-icon ui-icon-check"></span><% $c->i18n->p('trial.create.review.valid', 'Trial Is Valid') |h %><br><% $c->i18n->p('trial.create.review.will_add', 'The following trial will be added') |h %></p>
                                <hr>
                                <div id="trial_design_information">
                                </div>

                                <br/>
                                <center>
                                <button type="button" class="btn btn-lg btn-primary" name="new_trial_confirm_submit" id="new_trial_confirm_submit"><% $c->i18n->p('trial.create.review.confirm', 'Confirm (Saves Trial In Database)') |h %></button>
                                </center>

                            </&>
                            <&| /util/workflow.mas:complete, title=> encode_entities($c->i18n->p('trial.create.complete.step', 'Complete')) &>
                                <& /page/page_title.mas, title=>encode_entities($c->i18n->p('trial.create.complete.title', 'Complete! Your trial was saved in the database.')) &>

                                <p>
                                    <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                    <% $c->i18n->p('trial.create.complete.saved', 'The trial was saved successfully') |h %>
                                </p>

                                <ul>
                                    <li><% $c->i18n->p('trial.create.complete.details', 'You may want to proceed to the trial detail page for the trial you just created.') |h %></li>
                                    <li><% $c->i18n->p('trial.create.complete.barcodes', 'You can print barcodes for the plots or plants or tissue samples in this trial.') |h %></li>
                                    <li><% $c->i18n->p('trial.create.complete.phenotypes', 'You an add phenotypes for the plots or plants in this trial now.') |h %></li>
                                </ul>
                                <br/>
                                <center>
                                <button id="create_trial_success_complete_button" class="btn btn-primary" name="create_trial_success_complete_button"><% $c->i18n->p('trial.create.complete.open', 'The trial was saved to the database with no errors! Congrats Click Here') |h %></button><br/><br/>
                                </center>
                            </&>

                        </&><!-- End of workflow-->
                    </form>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.create.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<& /breeders_toolbox/trial/add_trial_treatment_dialogs.mas, management_factor_types => $management_factor_types &>

<div class="modal fade" id="partial_rep_help_dialog" name="partial_rep_help_dialog" tabindex="-1" role="dialog" aria-labelledby="partialRepHelpDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.create.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="partialRepHelpDialog"><% $c->i18n->p('trial.create.help.title', 'Partially Replicated Design Usage Help') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <h4>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                          <b><% $c->i18n->p('trial.create.help.background_title', 'Background:') |h %></b>
                        </h4>
                          <center><p><% $c->i18n->p('trial.create.help.background', 'Partially replicated designs have some treatments that are unreplicated and rely on replicated treatments to make the trial analysable. The design were described in %{design_citation}. It is recommended that at least 20% of the experimental units are occupied by replicated treatments. The aim of these experiments is usually to select promising treatments from a set of replicated and unreplicated test treatments, with check and quality standard treatments providing the necessary replication overall to give a valid experiment. DiGGer (%{software_citation}) was used to implement this design. DiGGer is a flexible tool for creating experimental designs that are efficient for specified blocking and correlation patterns. DiGGer package (%{software_url}) is an add-on for the statistical computing language and environment R (%{r_citation}).', { design_citation => 'Cullis et al. (2006)', software_citation => 'Coombes, 2002', software_url => 'http://www.austatgen.org/files/software/downloads', r_citation => 'R Development Core Team, 2009' }) |h %></p></center>
                        <h4>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <b><% $c->i18n->p('trial.create.help.parameters_title', 'Design Parameters:') |h %></b>
                        </h4>
                            <center><p> <% $c->i18n->p('trial.create.help.example', 'The parameters will consider a sample partially replicated design trial with 200 unreplicated accessions, 119 accessions replicated 4 times, 26 rows in design, 26 columns in design, bock sequence of 13 by 2 (13, 2) i.e 2 blocks with each having 13 rows; sub-block sequence of block of 13 by 1 (13, 1) i.e 1 sub-block with each having 13 rows in each block.') |h %> </p></center>

                        <dl>
                            <dt><% $c->i18n->p('trial.create.help.unrep_label', 'List of Unreplicated Accession') |h %></dt>
                            <ul>
                                <li>
                                    <dd> <% $c->i18n->p('trial.create.help.unrep_text', 'You\'re expected to provide the list of unreplicated accessions in this selectbox. E.g. is a list of 200 accessions.') |h %></dd>
                                </li>
                            </ul>
                            <dt><% $c->i18n->p('trial.create.help.rep_label', 'List of Replicated Accession') |h %></dt>
                            <ul>
                                <li>
                                    <dd><% $c->i18n->p('trial.create.help.rep_text', 'List of replicated accessions should be provided in this selectbox. E.g. is a list of 119 accessions.') |h %></dd>
                                </li>
                            </ul>
                            <dt><% $c->i18n->p('trial.create.help.rows_label', 'Number of rows in design') |h %></dt>
                            <ul>
                                <li>
                                    <dd> <% $c->i18n->p('trial.create.help.rows_text', 'Provide the number of rows you want to have in the design. E.g. 26 number of rows.') |h %> </dd>
                                </li>
                            </ul>
                            <dt><% $c->i18n->p('trial.create.help.columns_label', 'Number of Columns in Design') |h %></dt>
                            <ul>
                                <li>
                                    <dd> <% $c->i18n->p('trial.create.help.columns_text', 'Provide the number of columns you want to have in the design. E.g. 26 number of columns.') |h %> </dd>
                                </li>
                            </ul>
                            <dt><% $c->i18n->p('trial.create.help.rep_count_label', 'Number of Times Replicated Accessions are Replicated') |h %></dt>
                            <ul>
                                <li>
                                    <dd><% $c->i18n->p('trial.create.help.rep_count_text', 'Provide the number of times you want the replicated accessions to be replicated. E.g. 4') |h %></dd>
                                </li>
                            </ul>
                            <dt><% $c->i18n->p('trial.create.help.block_sequence_label', 'Block Sequence') |h %></dt>
                            <ul>
                                <li>
                                    <dd><% $c->i18n->p('trial.create.help.block_sequence_text', 'The block sequence should reflect the blocking structure of your design. E.g. (13, 2), meaning the design has 2 blocks and each block has 13 rows.') |h %></dd>
                                </li>
                            </ul>
                            <dt><% $c->i18n->p('trial.create.help.subblock_sequence_label', 'Sub-block Sequence') |h %></dt>
                            <ul>
                                <li>
                                    <dd><% $c->i18n->p('trial.create.help.subblock_sequence_text', 'The sub-block sequence should reflect the sub-blocking structure of your design. E.g. (13, 1), meaning the design has 1 sub-block (column) and each sub-block has 13 rows.') |h %></dd>
                                </li>
                            </ul>
                        </dl>
                        <h4>
                            <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                            <b><% $c->i18n->p('trial.create.help.note_title', 'NOTE:') |h %></b>
                        </h4>
                        <dl><dt>
                        <ul>
                            <li>
                                <dd><% $c->i18n->p('trial.create.help.plot_product', 'The product of the number of rows and columns in the design should equal the total number of plots.') |h %></dd>
                            </li>
                            <li>
                                <dd><% $c->i18n->p('trial.create.help.plot_sum', 'The sum of the unreplicated accessions and the replicated accessions (given the number of times it was replicated) should equal the total number of plots.') |h %> </dd>
                            </li>
                        </ul>
                        </dt></dl>

                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="partial_rep_usage_dialog_ok_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.create.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready(function(){

    jQuery(document).on('focusin', function(e) {
        if (jQuery(e.target).closest('.flatpickr-calendar').length) {
            e.stopImmediatePropagation();
        }
    });

    jQuery('#trial_create_rows_and_columns_to_plants').click( function () {
        if (jQuery('#trial_create_rows_and_columns_to_plants').is(':checked')){
            jQuery('#trial_create_plant_row_column_format_dialog').show();
        } else {
            jQuery('#trial_create_plant_row_column_format_dialog').hide();
        }

    });

    var selectedProgram = jQuery('#select_breeding_program option:selected').text()

    filter_options(selectedProgram, 'program', 'add_project_location');

    jQuery('#select_breeding_program').change(function() {
        filter_options(jQuery('#select_breeding_program option:selected').text(), 'program', 'add_project_location');
    });

    jQuery('#add_project_location').change(function() {
        var number_selected = jQuery(this).val().length;
        var i18n = window.SGN && SGN.i18n;
        var selected_message = i18n && typeof i18n.np === 'function'
            ? i18n.np('trial.create.locations_selected', 'Locations Selected: %{count}', 'Locations Selected: %{count}', number_selected, { count: number_selected })
            : 'Locations Selected: '+number_selected;
        if (number_selected > 1) {
            jQuery('#locations_count').text(selected_message);
            jQuery('#randomization_div').show();
        } else if (number_selected > 0) {
            jQuery('#locations_count').text(selected_message);
            jQuery('#randomization_div').hide();
        } else {
            jQuery('#locations_count').text(i18n && typeof i18n.p === 'function' ? i18n.p('trial.create.no_locations', 'No Locations Selected') : 'No Locations Selected');
            jQuery('#randomization_div').hide();
        }
    });

    flatpickr("#add_project_planting_date", {
        allowInput: true,
        dateFormat: "Y/m/d",
    });
});
</script>

<%init>
use HTML::Entities qw(encode_entities);
</%init>

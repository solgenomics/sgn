                                                </div>
                                            </div>
                                            <center><% $c->i18n->p('trial.create.seedlots.need_list', 'Need a list of seedlots for the selected accessions?') |h %>&nbsp;&nbsp;&nbsp;&nbsp;<button name="convert_accessions_to_seedlots" class="btn btn-default btn-sm" style="margin:6px 0px 0px 0px" type="button" ><% $c->i18n->p('trial.create.seedlots.search', 'Search Seedlots for Accessions') |h %></button></center>

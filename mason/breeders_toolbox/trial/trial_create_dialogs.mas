                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p('trial.create.field_size', 'Field Size (ha): ') |h %></label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="new_trial_field_size" name="new_trial_field_size" type="text" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p('trial.create.plants_per_plot', 'Plants per Plot: ') |h %></label>
                                    <div class="col-sm-9">
                                        <input class="form-control" id="add_plant_entries" name="add_plant_entries" type="text" />
                                        <p><i><% $c->i18n->p('trial.create.plant_entries_help', 'Creates plant entries for each plot. Ignore if not adding plant entries.') |h %></i></p>
                                    </div>
                                    <label style="font-size: 80%;" class="col-sm-3 control-label"><% $c->i18n->p('trial.create.inherit_treatments', 'Inherits Treatment(s) From Plots: ') |h %></label>
                                        <div class="col-sm-8" >
                                            <input name="trial_create_plants_per_plot_inherit_treatments" id="trial_create_plants_per_plot_inherit_treatments" type="checkbox" checked disabled/>
                                        </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p('trial.create.plant_coordinates', 'Assign row and column data to plants within plots?') |h %></label>
                                        <div class="col-sm-9" >
                                            <input name="trial_create_rows_and_columns_to_plants" id="trial_create_rows_and_columns_to_plants" type="checkbox"/>
                                            <div id="trial_create_plant_row_column_format_dialog" style="display:none">
                                                <p><i><% $c->i18n->p('trial.create.plant_coordinates_help', 'One plant per (row,column) coordinate. Rows and columns will be populated in a zigzag pattern. Row and column numbers start at 1 within each plot.') |h %></i></p>
                                                <table style="width:60%">
                                                    <tr>
                                                        <td>
                                                            <label><% $c->i18n->p('trial.create.rows_per_plot', 'Number of rows per plot') |h %></label>
                                                        </td>
                                                        <td>
                                                            <input name="trial_create_rows_per_plot" id="trial_create_rows_per_plot" type="number"/>
                                                        </td>
                                                    </tr><tr>
                                                        <td>
                                                            <label><% $c->i18n->p('trial.create.columns_per_plot', 'Number of columns per plot') |h %></label>
                                                        </td>
                                                        <td>
                                                            <input name="trial_create_cols_per_plot" id="trial_create_cols_per_plot" type="number"/>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </div>
                                        </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p('trial.create.description', 'Description: ') |h %></label>
                                    <div class="col-sm-9">
                                        <textarea class="form-control" id="add_project_description" name="add_project_description"></textarea>
                                    </div>
                                </div>
                                <hr>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p('trial.create.stock_type', 'Stock Type Being Evaluated in Trial: ') |h %></label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="select_stock_type">
                                            <option value=""><% $c->i18n->p('trial.create.select_stock_type', 'Select a stock type') |h %></option>
                                            <option value="accession"><% $c->i18n->p('trial.create.stock.accession', 'accession') |h %></option>
                                            <option value="cross"><% $c->i18n->p('trial.create.stock.cross', 'cross') |h %></option>
                                            <option value="family_name"><% $c->i18n->p('trial.create.stock.family_name', 'family_name') |h %></option>
                                        </select>
                                    </div>
                                </div>
                                <hr>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p('trial.create.design_type', 'Design Type: ') |h %></label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="select_design_method" name="select_design_method">
% foreach my $type (@$design_types) {
%    my $method;
%    my $label;
%    if ($type eq 'Completely Randomized'){
%        $method = 'CRD';
%        $label = $c->i18n->p('trial.create.design.crd', 'Completely Randomized');
%    } elsif ($type eq 'Complete Block'){
%        $method = 'RCBD';
%        $label = $c->i18n->p('trial.create.design.rcbd', 'Complete Block');
%    } elsif ($type eq 'Resolvable Row-Column'){
%        $method = 'RRC';
%        $label = $c->i18n->p('trial.create.design.rrc', 'Resolvable Row-Column');
%    } elsif ($type eq 'Doubly-Resolvable Row-Column'){
%        $method = 'DRRC';
%        $label = $c->i18n->p('trial.create.design.drrc', 'Doubly-Resolvable Row-Column');
%    } elsif ($type eq 'Un-Replicated Diagonal Design'){
%        $method = 'URDD';
%        $label = $c->i18n->p('trial.create.design.urdd', 'Un-Replicated Diagonal Design');
%    } elsif ($type eq 'Alpha Lattice'){
%        $method = 'Alpha';
%        $label = $c->i18n->p('trial.create.design.alpha', 'Alpha Lattice');
%    } elsif ($type eq 'Modified Augmented Design'){
%        $method = 'MAD';
%        $label = $c->i18n->p('trial.create.design.mad', 'Modified Augmented Design');
%    } elsif ($type eq 'Nursery/Greenhouse'){
%        $method = 'greenhouse';
%        $label = $c->i18n->p('trial.create.design.greenhouse', 'Nursery/Greenhouse');
%    } elsif ($type eq 'Split Plot'){
%        $method = 'splitplot';
%        $label = $c->i18n->p('trial.create.design.splitplot', 'Split Plot');
%    } elsif ($type eq 'Partially Replicated'){
%        $method = 'p-rep';
%        $label = $c->i18n->p('trial.create.design.p_rep', 'Partially Replicated');
%    } else {
%        $method = $type;
%        $label = $type;
%    }
    <option value="<% $method |h %>"><% $label |h %></option>
%}
                                        </select>
                                        <div id="create_trial_design_description_div">
                                        </div>
                                        <div id="prephelp" style="display: none">
                                            <button type="button" class="btn btn-link" data-toggle="modal" data-target="#partial_rep_help_dialog"><% $c->i18n->p('trial.create.design_help', 'Usage Help ') |h %><span class="glyphicon glyphicon-question-sign"></span></button>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group" id="randomization_div" style="display:none;">
                                    <label class="col-sm-4 control-label"><% $c->i18n->p('trial.create.same_randomization', 'Use same randomization for all locations: ') |h %></label>
                                    <div class="col-sm-8" >
                                        <input type="checkbox" id="use_same_layout" value="same_design" />
                                    </div>
                                </div>
                                <hr>
                                <center>
                                <button type="button" class="btn btn-lg btn-primary" name="create_trial_validate_form_button" id="create_trial_validate_form_button"><% $c->i18n->p('trial.create.validate', 'First validate the form') |h %></button>
                                <button type="button" class="btn btn-lg btn-primary" disabled onclick="Workflow.complete(this); return false;" name="create_trial_submit"><% $c->i18n->p('trial.create.next_metadata', 'Continue to Next Step') |h %></button>
                                <center>

                            </&>
                            <&| /util/workflow.mas:step, title=> encode_entities($c->i18n->p('trial.create.step.design', 'Design Information')) &>
                                <& /page/page_title.mas, title=>encode_entities($c->i18n->p('trial.create.design.title', 'Design your trial layout')) &>
                                <div class="well well-sm">
                                    <div class="form-group form-group-sm" id="show_list_of_accession_section" >
                                        <center><h4><% $c->i18n->p('trial.create.design.accessions_question', 'Which accessions will be in the field?') |h %></h4></center>
                                        <hr>
                                        <label class="col-sm-7 control-label"><% $c->i18n->p('trial.create.design.accessions_list', 'List of accessions to include (required):') |h %></label>
                                        <div class="col-sm-5" id="select_list" name="select_list">
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm" id="show_list_of_cross_section" >
                                        <center><h4><% $c->i18n->p('trial.create.design.crosses_question', 'Which crosses will be in the field?') |h %></h4></center>
                                        <hr>
                                        <label class="col-sm-7 control-label"><% $c->i18n->p('trial.create.design.crosses_list', 'List of crosses to include (required):') |h %></label>
                                        <div class="col-sm-5" id="select_cross_list" name="select_cross_list">
                                        </div>
                                    </div>
                                    <div class="form-group form-group-sm" id="show_list_of_family_name_section" >
                                        <center><h4><% $c->i18n->p('trial.create.design.families_question', 'Which family names will be in the field?') |h %></h4></center>
                                        <hr>
                                        <label class="col-sm-7 control-label"><% $c->i18n->p('trial.create.design.families_list', 'List of family names to include (required):') |h %></label>
                                        <div class="col-sm-5" id="select_family_name_list" name="select_family_name_list">
                                        </div>
                                    </div>
                                    <div class="form-group" id="westcott_check_1_section" style="display: none">
                                      <label class="col-sm-3 control-label"><% $c->i18n->p('trial.create.design.check_one', 'Name of Check 1:') |h %> </label>
                                      <div class="col-sm-9" >

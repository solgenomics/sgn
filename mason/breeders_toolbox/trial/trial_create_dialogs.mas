                                                <input class="form-control treatment-value-input-box" id="create_trial_with_treatment_value_input3" name="create_trial_with_treatment_value_input3" type="text" placeholder="<% $c->i18n->p('trial.create.design.treatment_value', 'treatment value') |h %>"/>

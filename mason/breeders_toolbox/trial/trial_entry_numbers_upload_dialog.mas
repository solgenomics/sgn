
<%args>
$trial_id => undef
$trial_name => undef
</%args>

<div class="modal fade" id="trial_entry_numbers_upload_dialog" name="trial_entry_numbers_upload_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadTrialEntryNumbersDialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('trial.create.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="uploadTrialEntryNumbersDialog"><% $c->i18n->p('trial.card.entry_numbers.upload_title', 'Upload Trial Entry Numbers') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
          <b><% $c->i18n->p('trial.card.entry_numbers.upload_format', 'Trial Entry Numbers may be uploaded in an Excel file (%{xls} or %{xlsx})', { xls => '.xls', xlsx => '.xlsx' }) |h %></b><br>
          <br><br>
          <b><% $c->i18n->p('trial.card.entry_numbers.header', 'Header:') |h %></b><br>
          <% $c->i18n->p('trial.card.entry_numbers.header_help', 'The first row (header) must contain the following:') |h %>
          <br>
          <table class="table table-bordered table-hover">
            <tbody>
              <tr>
                <td>accession_name</td>
                <td>trial_names</td>
                <td>entry_number</td>
              </tr>
            </tbody>
          </table>
          <b><% $c->i18n->p('trial.card.entry_numbers.column_definitions', 'Column Definitions:') |h %></b><br>
          <b>accession_name:</b> <% $c->i18n->p('trial.card.entry_numbers.accession_definition', ' (required) the unique name of the Accession record, must exist in the database') |h %><br>
          <b>trial_names:</b> <% $c->i18n->p('trial.card.entry_numbers.trials_definition', ' (required) the name(s) of the Trials to assign entry numbers in (can include more than one comma-separated Trial name)') |h %><br>
          <b>entry_number:</b> <% $c->i18n->p('trial.card.entry_numbers.number_definition', ' The entry number to assign to the Accession in all of the specified Trial(s).  The entry number should be unique in this set of Trial(s).') |h %><br>
          <br>
          <form method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_entry_numbers_form" name="upload_entry_numbers_form">
            <label for="upload_entry_numbers_file" style="display: inline-block;"><% $c->i18n->p('trial.card.entry_numbers.file_label', 'Entry Numbers File:') |h %></label>
            <input class="form-control" type="file" name="upload_entry_numbers_file" id="upload_entry_numbers_file" encoding="multipart/form-data" />
            <input id="upload_entry_numbers_ignore_warnings_cb" name="upload_entry_numbers_ignore_warnings_cb" type="checkbox" value="">
            <label for="upload_entry_numbers_ignore_warnings_cb"> <% $c->i18n->p('trial.card.entry_numbers.ignore_warnings', 'Ignore Warnings - check to upload even if there are warnings with the file') |h %></label><br>
          </form>

          <br /><br />

          <div id="upload_entry_numbers_messages">
            <ul id="upload_entry_numbers_messages_list" class='list-group'></ul>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.create.close', 'Close') |h %></button>
	      <button type="button" class="btn btn-primary" name="upload_entry_numbers_submit" id="upload_entry_numbers_submit"><% $c->i18n->p('trial.card.entry_numbers.upload', 'Upload') |h %></button>
      </div>
    </div>
  </div>
</div>

<script defer="defer">

jQuery(document).ready(function() {

  /**
   * Upload the selected entry number template to the database
   */
  jQuery('#upload_entry_numbers_submit').click( function() {
    var uploadFile = jQuery("#upload_entry_numbers_file").val();
    if (uploadFile === '') {
      alert(window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.entry_numbers.select_file', 'Please select a file') : 'Please select a file');
      return;
    }

    jQuery('#working_modal').modal("show");
    jQuery('#upload_entry_numbers_messages_list').empty();
    let formData = new FormData();
    formData.append('upload_entry_numbers_file', jQuery('#upload_entry_numbers_file').prop('files')[0]);
    formData.append('ignore_warnings', jQuery('#upload_entry_numbers_ignore_warnings_cb').is(':checked'));

    jQuery.ajax({
      url: '/ajax/breeders/trial_entry_numbers/upload',
      type: 'POST',
      data: formData,
      cache: false,
      contentType: false,
      processData: false,
      success: function(response) {
        jQuery('#working_modal').modal("hide");
        jQuery("#upload_entry_numbers_file").val("");
        if ( response ) {
          if ( response.error ) {
            addErrors(response.error);
          }
          if ( response.warning ) {
            addWarnings(response.warning);
          }
          if ( response.success === 1) {
            addSuccess(window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.entry_numbers.stored', 'Trial entry numbers stored!') : 'Trial entry numbers stored!');
	    loadEntryNumbers();
          }
        }
      },
      error: function() {
        jQuery('#working_modal').modal("hide");
        jQuery("#upload_entry_numbers_file").val("");
        alert(window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.entry_numbers.upload_error', 'ERROR: Could not upload and process file due to server error!') : 'ERROR: Could not upload and process file due to server error!');
      }
    });
  });
});



/**
 * Add a result message
 * @param {string} message Message text
 * @param {string} [type] Type of message (error=default, warning, success)
 */
function addResultMessage(message, type) {
  let html = "";
  let class_name = "danger";
  let icon_name = "remove";
  
  if ( type === "success" ) {
    class_name = "success";
    icon_name = "ok";
  }
  else if ( type === "warning" ) {
    class_name = "warning";
    icon_name = "asterisk";
  }

  html += "<li class='list-group-item list-group-item-" + class_name + "'>";
  html += "<span class='badge'><span class='glyphicon glyphicon-" + icon_name + "'></span></span>";
  html += message;
  html += "</li>";

  jQuery('#upload_entry_numbers_messages_list').append(html);
}

/**
 * Add multiple error messages
 * @param {String[]} errors Array of error messages
 */
function addErrors(errors) {
  for ( let i = 0; i < errors.length; i++ ) {
    addResultMessage(errors[i]);
  }
}

/**
 * Add multiple warning messages
 * @param {String[]} warnings Array of warning messages
 */
function addWarnings(warnings) {
  for ( let i = 0; i < warnings.length; i++ ) {
    addResultMessage(warnings[i], "warning");
  }
}

/**
 * Add a single success message
 * @param {String} message Success message
 */
function addSuccess(message) {
  addResultMessage(message, "success");
}

</script>

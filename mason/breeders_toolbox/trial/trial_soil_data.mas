<%once>
use HTML::Entities ();
</%once>
<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => ['jquery','jquery.dataTables'] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>



<&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('trial.soil_table.title', "Trial Soil Data")), collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "soil_data_table" class="table table-hover table-striped">
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

<script defer="defer">
var _sgnB11SoilTableEscape = function(value) { return jQuery('<div>').text(value).html(); };


jQuery(document).ready(function () {

    var soil_data_table = jQuery('#soil_data_table').DataTable({
        'searching': false,
        'order': false,
        'autoWidth': false,
        'ajax':'/ajax/breeders/trial/'+ <% $trial_id %> + '/all_soil_data',
        columns: [
            { title: _sgnB11SoilTableEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.soil_id', "Soil Data ID") : "Soil Data ID"), "data": "prop_id" },
            { title: _sgnB11SoilTableEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.description', "Description") : "Description"), "data": "description" },
            { title: _sgnB11SoilTableEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.date', "Date") : "Date"), "data": "date" },
            { title: _sgnB11SoilTableEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.gps', "GPS") : "GPS"), "data": "gps" },
            { title: _sgnB11SoilTableEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.type_sampling', "Type of Sampling") : "Type of Sampling"), "data": "type_of_sampling" },
            { title: _sgnB11SoilTableEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.soil_data', "Soil Data") : "Soil Data"), "data": "soil_data" },
            { title: _sgnB11SoilTableEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.download', "Download") : "Download"), "data": "download_link" },
            { title: _sgnB11SoilTableEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.delete', "Delete") : "Delete"), "data": "null", "render": function ( data, type, row ) { return "<a onclick='deleteSoilData("+row.prop_id+")'>" + _sgnB11SoilTableEscape(window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.delete', "Delete") : "Delete") + "</a>"; } },
        ]
    });

});

function deleteSoilData(prop_id){
    var confirmation = confirm((window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.delete_confirm', "Are you sure you want to delete this soil data id. The deletion cannot be undone.") : "Are you sure you want to delete this soil data id. The deletion cannot be undone."));

    if (confirmation) {
        jQuery.ajax({
            url : '/ajax/breeders/trial/'+ <% $trial_id %> + '/delete_soil_data',
            method: 'POST',
            data : {
                'prop_id': prop_id
            },

            destroy: true,
            beforeSend: function(response) {
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.delete_success', "Deletion was successful") : "Deletion was successful"));
                    location.reload();
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response) {
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.soil_table.delete_error', "An error occurred during deletion") : "An error occurred during deletion"));
            }
        });
    }
}


</script>

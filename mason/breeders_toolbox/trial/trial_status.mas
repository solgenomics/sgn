<%args>
$trial_id
$trial_name
$breeding_program_name
$location_name
$user_name
$year => undef
$trial_type => undef
$planting_date => undef
$harvest_date => undef
$trial_description => undef
$has_plant_entries => undef
$folder_id => undef
$design_name => undef
$phenotypes_fully_uploaded => undef
$user_can_modify => undef
</%args>

<& /util/import_javascript.mas, classes => ['jquery','jquery.dataTables'] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

%  if ($user_can_modify) {
<button class="btn btn-sm btn-primary" style="margin:3px" id="update_trial_status_link"><% $c->i18n->p('trial.card.status.update_status', "Update Trial Status") |h %></button>
<br/><br/>
% }


<&| /page/info_section.mas, anchor_title => 'Trial Activities',  title => HTML::Entities::encode_entities($c->i18n->p('trial.card.status.activities', "Trial Activities")), collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <table id = "trial_activities_table" class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th><% $c->i18n->p('trial.card.status.status_type', "Status Type") |h %></th>
                            <th><% $c->i18n->p('trial.card.status.date', "Date") |h %></th>
                            <th><% $c->i18n->p('trial.card.status.updated_by', "Updated by") |h %></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<div class="panel-body">

<&| /page/info_section.mas, anchor_title => 'Field Design',  id=>"trial_completion_layout_section", title=>HTML::Entities::encode_entities($c->i18n->p('trial.card.status.field_design', "Field Design")), collapsible=>1, collapsed=>1 &>
%  if ($design_name) {
            <p class="text-success" title="<% $c->i18n->p('trial.card.status.has_field_design_tip', "This trial has a design type saved. You can view and download this information in the Design section on this page.") |h %>"><small><% $c->i18n->p('trial.card.status.has_field_design_label', "Has Field Design") |h %>&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>
%  } else {
            <p class="text-danger" title="<% $c->i18n->p('trial.card.status.no_field_design_tip', "This trial does not have a design type saved! If this happens please contact us because this should not happen!") |h %>"><small><% $c->i18n->p('trial.card.status.no_field_design_label', "No Field Design") |h %>&nbsp;&nbsp;</small><span class="glyphicon glyphicon-remove-sign"></span></p>
%  }

            <div id="trial_completion_layout_section_div">
                <div class="well well-sm"><% $c->i18n->p('trial.card.status.loading', "LOADING...") |h %></div>
            </div>

%  if ($has_plant_entries) {
            <p class="text-success" title="<% $c->i18n->p('trial.card.status.has_plots_plants_tip', "This trial has plot and plant entries saved. This means that phenotypes can be recorded on the plot and plant level.") |h %>"><small><% $c->i18n->p('trial.card.status.has_plots', "Has Plots") |h %><br/><% $c->i18n->p('trial.card.status.and_plants', "And Plants") |h %>&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>
%  } else {
            <p class="text-info" title="<% $c->i18n->p('trial.card.status.has_plots_no_plants_tip', "This trial has plot entries saved, but no plant entries. Plant entries are needed for plant level phenotyping. You can create plant entries in Design->Plant Entries section on this page.") |h %>"><small><% $c->i18n->p('trial.card.status.has_plots', "Has Plots") |h %><br/><% $c->i18n->p('trial.card.status.no_plants', "No Plants") |h %>&nbsp;&nbsp;</small><span class="glyphicon glyphicon-info-sign"></span></p>
%  }
</&>

<&| /page/info_section.mas, anchor_title => 'Phenotyping',  id=>"trial_completion_phenotype_section", title=>HTML::Entities::encode_entities($c->i18n->p('trial.card.status.phenotyping_section', "Phenotyping")), collapsible=>1, collapsed=>1 &>

            <div id="trial_completion_phenotype_section_div">
                <div class="well well-sm"><% $c->i18n->p('trial.card.status.loading', "LOADING...") |h %></div>
            </div>
<!--
%  if ($phenotypes_fully_uploaded) {
            <p class="text-success" title="All recorded phenotypes for this trial are saved in the database. You can change this by clicking [Phenotypes Fully Uploaded?] in the Files section on this page."><small><% $c->i18n->p('trial.card.status.phenotyping', "Phenotyping") |h %><br/>Complete&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>
%  } else {
            <p class="text-info" title="Once phenotypes are fully uploaded for a trial, you can click [Phenotypes Fully Uploaded?] in the Files section on this page."><small><% $c->i18n->p('trial.card.status.phenotyping', "Phenotyping") |h %><br/>Incomplete&nbsp;&nbsp;</small><span class="glyphicon glyphicon-info-sign"></span></p>
%  }
-->
</&>

</div>

<& /breeders_toolbox/trial/update_trial_status_dialog.mas, trial_id => $trial_id, trial_name => $trial_name, user_name => $user_name &>

<script defer="defer">
function _sgnTrialStatusE(text) { return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;'); }


jQuery(document).ready(function () {

    jQuery('#trial_activities_table').DataTable({
        'autoWidth': false,
        'searching': false,
        'info': false,
        'paging': false,
        'order': false,
        'ajax':'/ajax/breeders/trial/'+ <% $trial_id %> + '/all_trial_activities',
    });

    jQuery('#trial_completion_layout_section_onswitch').click( function() {
        jQuery.ajax ( {
            url : '/ajax/breeders/trial/'+ <% $trial_id %> + '/trial_completion_layout_section',
            success: function(response){
                var html = '';
                if (response.has_layout == 1){
                    html += '<p class="text-success" title="' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.has_layout_tip', "This trial has plots and their layout information saved in the database. All relationships between accessions, plots, seedlots, plants, and subplots are consistent. You can view and download this information in the Design section on this page.") : "This trial has plots and their layout information saved in the database. All relationships between accessions, plots, seedlots, plants, and subplots are consistent. You can view and download this information in the Design section on this page.")) + '"><small>' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.has_layout_label', "Has Field Layout") : "Has Field Layout")) + '&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>';
                } else {
                    html += '<p class="text-danger" title="' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.bad_layout_tip', "There is something wrong with the layout! If this occurs please contact us because this should not occur! (click here for more info)") : "There is something wrong with the layout! If this occurs please contact us because this should not occur! (click here for more info)")) + '"><span id="layout_error_button"><small>' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.bad_layout_label', "Bad Field Layout") : "Bad Field Layout")) + '&nbsp;&nbsp;</small><span class="glyphicon glyphicon-remove-sign"></span></span></p>';
                }
                if (response.has_physical_map == 1){
                    html += '<p class="text-success" title="' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.physical_map_tip', "This trial has a physical map saved. You can view and edit the physical map in the Physical Trial Layout section on this page.") : "This trial has a physical map saved. You can view and edit the physical map in the Physical Trial Layout section on this page.")) + '"><small>' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.physical_map_label', "Has Physical Map") : "Has Physical Map")) + '&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>';
                } else {
                    html += '<p class="text-info" title="' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.no_physical_map_tip', "This trial does not have physical map information. This means the map will not appear in the Physical Trial Layout section. You can add physical map info by clicking [Upload Trial Coordinates] in the Physical Trial Layout section on this page. (click here for more info)") : "This trial does not have physical map information. This means the map will not appear in the Physical Trial Layout section. You can add physical map info by clicking [Upload Trial Coordinates] in the Physical Trial Layout section on this page. (click here for more info)")) + '"><span id="physical_map_error_button"><small>' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.no_physical_map_label', "No Physical Map") : "No Physical Map")) + '&nbsp;&nbsp;</small><span class="glyphicon glyphicon-info-sign"></span></span></p>';
                }
                if (response.has_seedlots == 1){
                    html += '<p class="text-success" title="' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.seedlots_tip', "This trial has seedlots linked to plots (and the accessions are in sync). This allows us to track breeding material on the seedlots detail page. You can view this data and navigate to the seedlots on the Design section of this page.") : "This trial has seedlots linked to plots (and the accessions are in sync). This allows us to track breeding material on the seedlots detail page. You can view this data and navigate to the seedlots on the Design section of this page.")) + '"><small>' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.has_seedlots_label', "Has Seedlots") : "Has Seedlots")) + '&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>';
                } else {
                    html += '<p class="text-info" title="' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.no_seedlots_tip', "This trial does not have seedlots saved. This means we cannot track your breeding material using seedlots. You can upload this information by clicking [Upload Seedlots Planted in Trial] in the Design section on this page. (click here for more info)") : "This trial does not have seedlots saved. This means we cannot track your breeding material using seedlots. You can upload this information by clicking [Upload Seedlots Planted in Trial] in the Design section on this page. (click here for more info)")) + '"><span id="seedlot_error_button"><small>' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.no_seedlots_label', "No Seedlot Info") : "No Seedlot Info")) + '&nbsp;&nbsp;</small><span class="glyphicon glyphicon-info-sign"></span></span></p>';
                }
                jQuery(document).on('click', 'span[id="layout_error_button"]', function(){
                    alert(response.layout_errors);
                });
                jQuery(document).on('click', 'span[id="physical_map_error_button"]', function(){
                    alert(response.physical_map_errors);
                });
                jQuery(document).on('click', 'span[id="seedlot_error_button"]', function(){
                    alert(response.seedlot_errors);
                });
                jQuery('#trial_completion_layout_section_div').html(html);
            },
            error: function(response){
                alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.error_layout', "Error retrieving trial completion layout section") : "Error retrieving trial completion layout section"));
            }
        });
    });

    jQuery('#trial_completion_phenotype_section_onswitch').click( function() {
        jQuery.ajax ( {
            url : '/ajax/breeders/trial/'+ <% $trial_id %> + '/trial_completion_phenotype_section',
            success: function(response){
                var html = '';
                if (response.has_phenotypes == 1){
                    html = '<p class="text-success" title="' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.phenotypes_tip', "This trial has phenotypes saved. You can view and download this data in the Traits Assayed section on this page.") : "This trial has phenotypes saved. You can view and download this data in the Traits Assayed section on this page.")) + '"><small>' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.has_phenotypes_label', "Has Phenotypes") : "Has Phenotypes")) + '&nbsp;&nbsp;</small><span class="glyphicon glyphicon-ok-sign"></span></p>';
                } else {
                    html = '<p class="text-info" title="' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.no_phenotypes_tip', "This trial does not have any phenotypes stored. You can upload phenotypes in the Files section on this page.") : "This trial does not have any phenotypes stored. You can upload phenotypes in the Files section on this page.")) + '"><small>' + _sgnTrialStatusE((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.no_phenotypes_label', "No Phenotypes") : "No Phenotypes")) + '&nbsp;&nbsp;</small><span class="glyphicon glyphicon-info-sign"></span></p>';
                }
                jQuery('#trial_completion_phenotype_section_div').html(html);
            },
            error: function(response){
                alert((window.SGN && SGN.i18n ? SGN.i18n.p('trial.card.status.error_phenotype', "Error retrieving trial completion phenotype section") : "Error retrieving trial completion phenotype section"));
            }
        });
    });

});

</script>

<%once>
use HTML::Entities ();
</%once>

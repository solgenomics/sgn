
<%args>
$trial_id 
</%args>

<div id="data_agreement_div">

</div>

<script>

jQuery(document).ready(function () {

    get_data_agreement(<% $trial_id %>, 'data_agreement_div');

    function get_data_agreement(project_id, div) { 
      jQuery.ajax( { 
        async: true,
        url: '/breeders/trial/data_agreement/get',
        data: { 'project_id': project_id },
        success: function(response) {
           if (response.text) { 
             jQuery('#'+div).html(response.text);
           }
           else { 
             jQuery('#'+div).html(jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("administration.interface.agreement_default_intro", "By default, trial data is provided under the") : "By default, trial data is provided under the")).html() + ' Toronto agreement, ' + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("administration.interface.agreement_default_explained", "as explained in the") : "as explained in the")).html() + ' <a href="/usage_policy">' + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("administration.interface.data_usage_policy_link", "data usage policy") : "data usage policy")).html() + '</a>.');
           }
           if (response.message) { alert(response.message); }
        },
        error: function(response) { 
           alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("administration.interface.agreement_fetch_error", "An error occurred fetching the data agreement data.") : "An error occurred fetching the data agreement data."));
        }
      });
    }

});


</script>


<%doc>

=head1 NAME

/breeders_toolbox/trial.mas - a mason component to display a genotyping protocol detail page

=head1 AUTHOR

=cut

</%doc>

<%args>
$protocol_id
$protocol_name
$protocol_description
$marker_names
$header_information_lines
$reference_genome_name
$species_name
$sample_observation_unit_type_name
$create_date
$marker_type
$marker_info_headers
$assay_type
$map_details_protocolprop_id
</%args>

<%once>
use HTML::Entities ();
use SGN::I18N ();
</%once>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial', 'jstree/dist/jstree', 'CXGN.BreedersToolbox.HTMLSelect', 'moment_min'] &>

<br/>

<& /page/page_title.mas, title=>SGN::I18N::translate($c->i18n, 'genotype.protocol.page.title.prefix', 'Genotyping Protocol Detail for ', undef, {entities => '<>&'}).HTML::Entities::encode_entities($protocol_name) &>

% if ($map_details_protocolprop_id) {
    <& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.details', 'Genotype Protocol Details'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.details_help', 'View basic information about the genotyping protocol.')),buttons_html => '<button class="btn btn-primary btn-sm" id="edit_genotyping_protocol_details" style="margin:3px">'.HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.edit_details', 'Edit Genotyping Protocol Details')).'</button>', icon_class => "glyphicon glyphicon-dashboard", info_section_anchor_title => "Genotype Protocol Details", info_section_id => "genotyping_protocol_details", protocol_name => $protocol_name, protocol_description => $protocol_description, marker_names => $marker_names, header_information_lines => $header_information_lines, reference_genome_name => $reference_genome_name, species_name => $species_name, create_date => $create_date, sample_observation_unit_type_name => $sample_observation_unit_type_name, marker_type => $marker_type, assay_type => $assay_type &>
% } else {
    <& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.details', 'Genotype Protocol Details'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.details_help', 'View basic information about the genotyping protocol.')), icon_class => "glyphicon glyphicon-dashboard", info_section_anchor_title => "Genotype Protocol Details", info_section_id => "genotyping_protocol_details", protocol_name => $protocol_name, protocol_description => $protocol_description, marker_names => $marker_names, header_information_lines => $header_information_lines, reference_genome_name => $reference_genome_name, species_name => $species_name, create_date => $create_date, sample_observation_unit_type_name => $sample_observation_unit_type_name, marker_type => $marker_type, assay_type => $assay_type &>
%}
% if ($marker_type eq 'SSR') {
    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.markers', 'Markers'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.markers_help', 'View information about the markers used in this protocol.')), icon_class => "glyphicon glyphicon-map-marker", info_section_anchor_title => "Markers", info_section_id => "pcr_based_genotyping_markers" &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.marker_metadata', 'Marker Metadata'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.marker_metadata_help', 'View metadata assigned to markers used in this protocol.')), icon_class => "glyphicon glyphicon-tags", info_section_anchor_title => "Marker Metadata", info_section_id => "marker_metadata" &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, marker_names => $marker_names, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.genotype_data', 'Genotype Data'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.genotype_data_help', 'View and download genotyping data from this protocol.')),buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="download_ssr_data_link">'.HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.download_ssr_data', 'Download SSR Data')).'</button>', icon_class => "glyphicon glyphicon-save-file", info_section_anchor_title => "Genotype Data", info_section_id => "pcr_genotyping_protocol_genotype_data" &>
% } elsif ($assay_type eq 'KASP') {
    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, marker_info_headers => $marker_info_headers, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.markers', 'Markers'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.markers_help', 'View information about the markers used in this protocol.')), icon_class => "glyphicon glyphicon-map-marker", info_section_anchor_title => "Markers", info_section_id => "genotyping_protocol_markers", buttons_html => '<button class="btn btn-primary btn-sm" id="download_protocol_marker_info" style="margin:3px">'.HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.download_all_marker_info', 'Download All Marker Info (CSV)')).'</button>' &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.marker_metadata', 'Marker Metadata'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.marker_metadata_help', 'View metadata assigned to markers used in this protocol.')), icon_class => "glyphicon glyphicon-tags", info_section_anchor_title => "Marker Metadata", info_section_id => "marker_metadata" &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.genotype_data', 'Genotype Data'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.genotype_data_help', 'View and download genotyping data from this protocol.')), icon_class => "glyphicon glyphicon-save-file", info_section_anchor_title => "Genotype Data", info_section_id => "genotyping_protocol_genotype_data", buttons_html => '<button class="btn btn-primary" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_vcf">'.HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.download_all_vcf', 'Download All Genotype Data VCF')).'</button>' . '<button class="btn btn-primary" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_dosagematrix">'.HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.download_dosage_matrix', 'Download All Genotype Data Dosage Matrix')).'</button>' . '<button class="btn btn-default" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_csv">'.HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.download_all_csv', 'Download All Genotype Data (CSV)')).'</button>' &>
% } else {
    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, marker_info_headers => $marker_info_headers, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.markers', 'Markers'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.markers_help', 'View information about the markers used in this protocol.')), icon_class => "glyphicon glyphicon-map-marker", info_section_anchor_title => "Markers", info_section_id => "genotyping_protocol_markers"&>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.marker_metadata', 'Marker Metadata'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.marker_metadata_help', 'View metadata assigned to markers used in this protocol.')), icon_class => "glyphicon glyphicon-tags", info_section_anchor_title => "Marker Metadata", info_section_id => "marker_metadata" &>

    <& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.genotype_data', 'Genotype Data'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.section.genotype_data_help', 'View and download genotyping data from this protocol.')), icon_class => "glyphicon glyphicon-save-file", info_section_anchor_title => "Genotype Data", info_section_id => "genotyping_protocol_genotype_data", buttons_html => '<button class="btn btn-primary" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_vcf">'.HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.download_all_vcf', 'Download All Genotype Data VCF')).'</button>' . '<button class="btn btn-primary" style="margin:3px" id="genotyping_protocol_genotype_data_detail_page_download_all_dosagematrix">'.HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.download_dosage_matrix', 'Download All Genotype Data Dosage Matrix')).'</button>' &>
% }


% if ($c->user() && $c->user()->has_role("curator")) {
<& /page/detail_page_2_col_section.mas, protocol_id => $protocol_id, info_section_title => "<h4 style='display:inline'>".HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.delete_all_title', 'Delete Genotyping Protocol and All Data'))."</h4>", info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('genotype.protocol.delete_all_help', 'Delete genotyping protocol and all data from this protocol.')), icon_class => "glyphicon glyphicon-trash", info_section_anchor_title => "Delete Genotyping Protocol and All Data", info_section_id => "genotyping_protocol_delete_genotype_data" &>
% }


<& /breeders_toolbox/genotyping_protocol/edit_genotyping_protocol_details_dialog.mas, protocol_id => $protocol_id, protocol_name => $protocol_name, protocol_description => $protocol_description, reference_genome_name => $reference_genome_name, species_name => $species_name, sample_observation_unit_type_name => $sample_observation_unit_type_name, assay_type => $assay_type &>

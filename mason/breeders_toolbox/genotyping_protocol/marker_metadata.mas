<%once>
use JSON::PP ();
</%once>

<%args>
    $protocol_id => undef
</%args>

<%perl>
    my $curator = 0;
    if ( $c->user() && $c->user()->check_roles("curator") ) {
        $curator = 1;
    }
</%perl>

<& /util/import_javascript.mas, entries => [], classes => [ 'jquery', 'jquery.dataTables','jquery.dataTables-buttons-min', 'jszip-min', 'buttons.bootstrap-min', 'buttons.html5-min' ],  &>

<div id="marker_metadata_loading">
    <p><% $c->i18n->p('shared.datatables.loading', 'Loading...') |h %></p>
</div>

<div id="marker_metadata_table_container" style="display: none">
    <table id="marker_metadata_table" class="table table-hover table-bordered" style="width: 100%"></table>
</div>

<div id="marker_metadata_upload" style="display:none">
    <p>
        <% $c->i18n->p('genotype.protocol.marker_metadata_ui.upload_intro', 'To upload metadata and alleles for markers in this protocol, go to the ') |h %>
        <a href="/breeders/genotyping_projects"><% $c->i18n->p('genotype.projects.title', 'Manage Genotyping Projects') |h %></a>
        <% $c->i18n->p('genotype.protocol.marker_metadata_ui.page_and_select', ' page and select the ') |h %><strong><% $c->i18n->p('genotype.protocol.marker_metadata_ui.add_button', 'Add Marker Metadata') |h %></strong><% $c->i18n->p('genotype.protocol.marker_metadata_ui.button_suffix', ' button.') |h %>
    </p>
</div>

<div id="marker_metadata_delete" style="margin-top: 15px; display:none">
    <button class="btn btn-danger" <% $curator ? '' : 'disabled' %> onclick="deleteMetadata()"><span class="glyphicon glyphicon-trash"></span>&nbsp;&nbsp;<% $c->i18n->p('genotype.protocol.marker_metadata_ui.delete_all', 'Delete All Marker Metadata') |h %></button>
</div>

<div class="modal fade" id="edit_marker_metadata_dialog" name="edit_marker_metadata_dialog" tabindex="-1" role="dialog" aria-labelledby="EditMarkerMetadataDialog">
    <div class="modal-dialog " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('global.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="EditMarkerMetadataDialog"><% $c->i18n->p('genotype.protocol.marker_metadata_ui.edit_title', 'Edit Marker Metadata') |h %></h4>
            </div>
            <div class="modal-body">

                <p><strong><% $c->i18n->p('genotype.protocol.marker_metadata_ui.form.marker_name', 'Marker Name:') |h %></strong><input class="form-control" id="edit_marker_metadata_marker" name="Marker" /></p>
                <p><strong><% $c->i18n->p('genotype.protocol.marker_metadata_ui.form.alias', 'Alias:') |h %></strong><input class="form-control" id="edit_marker_metadata_alias" name="Alias" /></p>
                <p><strong><% $c->i18n->p('genotype.protocol.marker_metadata_ui.form.description', 'Description:') |h %></strong><textarea class="form-control" id="edit_marker_metadata_description" name="Description" rows="3"></textarea></p>
                <p><strong><% $c->i18n->p('genotype.protocol.marker_metadata_ui.form.alleles', 'Alleles') |h %> (<% $c->i18n->p('genotype.protocol.marker_metadata_ui.form.one_per_line', 'one per line') |h %>):</strong><textarea class="form-control" id="edit_marker_metadata_alleles" name="Alleles" rows="5"></textarea></p>
                <p><strong><% $c->i18n->p('genotype.protocol.marker_metadata_ui.form.references', 'References') |h %> (<% $c->i18n->p('genotype.protocol.marker_metadata_ui.form.one_per_line', 'one per line') |h %>):</strong><textarea class="form-control" id="edit_marker_metadata_references" name="References" rows="5"></textarea></p>
                <span><% $c->i18n->p('genotype.protocol.marker_metadata_ui.form.reference_help', 'The references include the associated trait categories and external database references.  The format of each reference is ') |h %><code>{database name}:{entity name}</code></span>
                <input type="hidden" id="edit_marker_metadata_locus_id" />
            </div>
            <div class="modal-footer">
                <button id="close_delete_model_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('global.close', 'Close') |h %></button>
                <button type="button" class="btn btn-primary" name="edit_marker_metadata_dialog_submit" id="edit_marker_metadata_dialog_submit"><% $c->i18n->p('global.save', 'Save') |h %></button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var MARKER_METADATA = {};

    jQuery(window).ready(() => {
        loadMetadata();
        jQuery("#edit_marker_metadata_dialog_submit").on('click', submitMetadata);
    });

    function loadMetadata() {
        jQuery.ajax({
            url: '/ajax/genotyping_protocol/get_marker_metadata/<% $protocol_id %>',
            method: 'GET',
            success: displayMetadata,
            error: displayError
        });
    }

    function displayMetadata(response) {
        MARKER_METADATA = response;

        // Metadata found, generate table...
        if ( response && Object.keys(response).length > 0 ) {
            jQuery("#marker_metadata_upload").hide();
            jQuery("#marker_metadata_delete").show();
            new jQuery("#marker_metadata_table").DataTable({
                destroy: true,
                dom: 'Bfrtip',
                buttons: [
                    'pageLength',
                    {
                        extend: 'excelHtml5',
                        title: 'marker_metadata',
                        exportOptions: { orthogonal: "export" }
                    },
                    {
                        extend: 'csvHtml5',
                        title: 'marker_metadata',
                        exportOptions: { orthogonal: "export" }
                    }
                ],
                data: Object.values(response),
                columns: [
                    { title: "Marker", render: (data, type, row) => {
                        var html = `<a href='/locus/${row.locus_id}/view'>`;
                        html += row.marker_name;
                        if ( row.locus_name !== row.marker_name ) html += ` = ${row.locus_name}`;
                        html += '</a>';
                        return html;
                    }},
                    { title: "Description", data: "locus_description" },
                    { title: "Alleles", render: (data, type, row) => { return row.alleles.map((x) => x.allele_name).join(type === 'export' ? ', ' : '<br />') } },
                    { title: "References", render: (data, type, row) => {
                        var html = "<ul style='padding-left: 15px;'>";
                        row.references.forEach((r) => {
                            html += `<li>`;
                            if ( r.url ) html += `<a href="${r.url}" target="_blank">`;
                            html += `${r.db_name}:${r.dbxref_accession}`
                            if ( r.cvterm_name ) html += ` (${r.cvterm_name})`;
                            if ( r.url ) html += `</a>`;
                            html += `</li>`;
                        });
                        html += "</ul>";
                        return html;
                    }},
                    { title: "Edit", render: (data, type, row) => { 
                        var html = `<button class="btn btn-sm btn-info" style="margin: 5px" onclick="editMetadata('${row.locus_name}')" <% $curator ? '' : 'disabled' %>><span class="glyphicon glyphicon-pencil"></span></button>`;
                        html += `<button class="btn btn-sm btn-danger" style="margin: 5px" onclick="deleteMetadata(${row.locus_id})" <% $curator ? '' : 'disabled' %>><span class="glyphicon glyphicon-trash"></span></button>`;
                        return html;
                    }}
                ]
            });
        }

        // No Metadata found, show upload information...
        else {
            let noMetadataText = <% JSON::PP::encode_json($c->i18n->p('genotype.protocol.marker_metadata_ui.no_data', 'There are no metadata or allele values set for the markers in this protocol.')) %>;
            let html = "<p style='font-style: italic; padding-bottom: 10px'>" + jQuery("<span>").text(noMetadataText).html() + "</p>";
            jQuery("#marker_metadata_table_container").html(html);
            jQuery("#marker_metadata_upload").show();
            jQuery("#marker_metadata_delete").hide();
        }

        jQuery("#marker_metadata_loading").hide();
        jQuery("#marker_metadata_table_container").show();

    }

    function displayError() {
        let errorLabel = <% JSON::PP::encode_json($c->i18n->p('genotype.protocol.marker_metadata_ui.error_label', 'ERROR')) %>;
        let errorText = <% JSON::PP::encode_json($c->i18n->p('genotype.protocol.marker_metadata_ui.error_get', 'There was an error getting the marker metadata for this protocol.')) %>;
        let html = "<p><strong>" + jQuery("<span>").text(errorLabel).html() + ":</strong> " + jQuery("<span>").text(errorText).html() + "</p>";
        jQuery("#marker_metadata_table_container").html(html);

        jQuery("#marker_metadata_loading").hide();
        jQuery("#marker_metadata_table_container").show();
        jQuery("#marker_metadata_upload").hide();
    }

    function editMetadata(marker_name) {
        const md = MARKER_METADATA[marker_name];

        jQuery("#edit_marker_metadata_marker").val(md.marker_name);
        jQuery("#edit_marker_metadata_alias").val(md.marker_name !== md.locus_name ? md.locus_name : '');
        jQuery("#edit_marker_metadata_description").val(md.locus_description);
        jQuery("#edit_marker_metadata_alleles").val(md.alleles.map(e => e.allele_name).join("\n"));
        jQuery("#edit_marker_metadata_references").val(md.references.map(e => `${e.db_name}:${e.dbxref_accession}`).join("\n"));
        jQuery("#edit_marker_metadata_locus_id").val(md.locus_id);

        jQuery('#edit_marker_metadata_dialog').modal('show');
    }

    function submitMetadata() {
        const marker = jQuery("#edit_marker_metadata_marker").val();
        const alias = jQuery("#edit_marker_metadata_alias").val();
        const description = jQuery("#edit_marker_metadata_description").val();
        const alleles = jQuery("#edit_marker_metadata_alleles").val().split("\n");
        const references = jQuery("#edit_marker_metadata_references").val().split("\n");
        const locus_id = jQuery("#edit_marker_metadata_locus_id").val();

        jQuery.ajax({
            url: '/ajax/genotyping_protocol/update_marker_metadata/<% $protocol_id %>',
            method: 'POST',
            data: {
                locus_id,
                marker,
                alias,
                description,
                alleles,
                references
            },
            dataType: 'json',
            beforeSend: () => {
                jQuery("#working_modal").modal("show");
            },
            success: (response) => {
                jQuery("#working_modal").modal("hide");
                if ( response?.error ) {
                    const updateError = ("" + response.error);
                    alert(window.SGN && SGN.i18n ? SGN.i18n.p('genotype.protocol.marker_metadata_ui.update_error', 'Could not update marker metadata: %{error}', {error: updateError}) : "Could not update marker metadata: " + updateError);
                }
                else {
                    jQuery('#edit_marker_metadata_dialog').modal('hide');
                    loadMetadata();
                }
            },
            error: () => {
                jQuery("#working_modal").modal("hide");
                alert(<% JSON::PP::encode_json($c->i18n->p('genotype.protocol.marker_metadata_ui.update_failed', 'Could not update marker metadata')) %>);
            }
        });
    }

    function deleteMetadata(locus_id) {
        const deleteConfirmation = locus_id
            ? <% JSON::PP::encode_json($c->i18n->p('genotype.protocol.marker_metadata_ui.delete_one_confirm', 'Are you sure you want to delete this marker\'s metadata?  This cannot be undone!')) %>
            : <% JSON::PP::encode_json($c->i18n->p('genotype.protocol.marker_metadata_ui.delete_all_confirm', 'Are you sure you want to delete all of the marker metadata for this protocol?  This cannot be undone!')) %>;
        if ( confirm(deleteConfirmation) ) {
            jQuery.ajax({
                url: `/ajax/genotyping_protocol/delete_marker_metadata/<% $protocol_id %>?${locus_id ? "locus_id=" + locus_id : ""}`,
                method: 'DELETE',
                success: (resp) => {
                    if ( resp?.error ) {
                        const deleteError = ("" + resp.error);
                        alert(window.SGN && SGN.i18n ? SGN.i18n.p('genotype.protocol.marker_metadata_ui.delete_error', 'Could not delete marker metadata: %{error}', {error: deleteError}) : "Could not delete marker metadata: " + deleteError);
                    }
                    else {
                        loadMetadata();
                    }
                },
                error: (err) => {
                    console.log(err);
                    const deleteStatus = ("" + err?.statusText);
                    alert(window.SGN && SGN.i18n ? SGN.i18n.p('genotype.protocol.marker_metadata_ui.delete_transport_error', 'Could not delete marker metadata: %{status}', {status: deleteStatus}) : "Could not delete marker metadata: " + deleteStatus);
                }
            });
        }
    }

</script>

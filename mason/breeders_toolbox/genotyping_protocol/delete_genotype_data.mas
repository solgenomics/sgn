<%once>
use JSON::PP ();
</%once>

<%args>
$protocol_id
</%args>

<button class="btn btn-danger" id="genotyping_protocol_detail_page_delete"><% $c->i18n->p('genotype.protocol.delete.button', 'Delete Genotyping Data For this Protocol') |h %></button>

<script>

jQuery('#genotyping_protocol_detail_page_delete').click(function(){
    if (confirm(<% JSON::PP::encode_json($c->i18n->p('genotype.protocol.delete.confirm', 'Are you sure you want to delete this genotyping protocol? This cannot be undone!')) %>)) {
        jQuery.ajax ({
            url : '/ajax/genotyping_protocol/delete/<% $protocol_id %>',
            beforeSend: function(){
                jQuery('#working_modal').modal('show');
            },
            success: function(response){
                console.log(response);
                jQuery('#working_modal').modal('hide');
                if (response.error) {
                    alert(response.error);
                }
                if (response.success) {
                    alert(<% JSON::PP::encode_json($c->i18n->p('genotype.plate.genotyping_protocol_deleted', 'Genotyping protocol deleted!')) %>);
                    window.location.replace("/search/genotyping_protocols");
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert(<% JSON::PP::encode_json($c->i18n->p('genotype.plate.error_deleting_genotyping_protocol', 'Error deleting genotyping protocol!')) %>);
            }

        });
    }
});

</script>


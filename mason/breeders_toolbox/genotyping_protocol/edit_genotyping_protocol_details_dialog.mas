<%once>
use JSON::PP ();
</%once>


<%args>
$protocol_id
$protocol_name
$protocol_description
$reference_genome_name
$species_name
$sample_observation_unit_type_name
$assay_type
</%args>

<div class="modal fade" id="genotyping_protocol_details_edit_dialog" tabindex="-1" role="dialog" aria-labelledby="genotypingProtocolDetailsEditDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header text-center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('global.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="genotypingProtocolDetailsEditDialog"><% $c->i18n->p('genotype.protocol.edit.title', 'Edit Genotyping Protocol Details') |h %></h4>
            </div>
            <div class="modal-body" id="protocol_details_edit_body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data">
                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="edit_protocol_name"><% $c->i18n->p('genotype.plate.genotyping_protocol_name', 'Genotyping Protocol Name:') |h %> </label>
                            <div class="col-sm-7">
                                <div class="input-group">
                                    <input class="form-control col-sm-8" id="edit_protocol_name" title="name" type="text" value="<%$protocol_name%>" aria-describedby="edit_protocol_name_status"/>
                                </div>
                            </div>
                        </div>
                        <!--
                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="edit_protocol_assay_type">Assay Type: </label>
                            <div class="col-sm-7">
                                <div class="input-group">
                                    <select class="form-control" id="edit_protocol_assay_type" title="assay_type" value="<%$assay_type%>"></select>
                                </div>
                            </div>
                        </div>
                        -->
                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="edit_protocol_reference_genome_name"><% $c->i18n->p('genotype.protocol.edit.reference_genome', 'Reference Genome Name: ') |h %></label>
                            <div class="col-sm-7">
                                <div class="input-group">
                                    <input class="form-control" id="edit_protocol_reference_genome_name" title="reference_genome_name" value="<%$reference_genome_name%>"/>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="edit_protocol_species_name"><% $c->i18n->p('genotype.protocol.edit.species_name', 'Species Name: ') |h %></label>
                            <div class="col-sm-7">
                                <div class="input-group">
                                    <input class="form-control" id="edit_protocol_species_name" title="species_name" value="<%$species_name%>"/>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label" for="edit_protocol_description"><% $c->i18n->p('genotype.protocol.edit.description', 'Description: ') |h %></label>
                            <div class="col-sm-7">
                                <div class="input-group">
                                    <textarea class="form-control" id="edit_protocol_description" title="description" rows="3"><% $protocol_description %></textarea>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <p class="text-success vertical-align pull-left"><span class="glyphicon glyphicon-pencil"></span> <% $c->i18n->p('genotype.protocol.edit.pending_change', 'Indicates pending change') |h %></p>
                <button type="button" class="btn btn-default" data-dismiss="modal" id="edit_protocol_details_cancel_button"><% $c->i18n->p('trial.details.cancel', 'Cancel') |h %></button>
                <button type="button" class="btn btn-primary" id="save_protocol_details"><% $c->i18n->p('genotype.protocol.edit.save_changes', 'Save Changes') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="protocol_details_saved_dialog" tabindex="-1" role="dialog" aria-labelledby="protocolDetailsSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header text-center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('global.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="protocolDetailsSavedDialog"><% $c->i18n->p('trial.details.saved', 'Details Saved') |h %></h4>
            </div>
            <div class="modal-body" id="protocol_details_saved_body">
                <ul class="list-group" id="protocol_details_saved_message"></ul>
            </div>
            <div class="modal-footer">
                <button id="protocol_details_saved_close_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('trial.details.reload', 'Close & Reload') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="protocol_details_error_dialog" tabindex="-1" role="dialog" aria-labelledby="protocolDetailsErrorDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header text-center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('global.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="protocolDetailsErrorDialog"><% $c->i18n->p('genotype.protocol.edit.error_title', 'Error Saving Genotyping Protocol Details') |h %></h4>
            </div>
            <div class="modal-body" id="protocol_details_error_body">
                <ul class="list-group" id="protocol_details_error_message"></ul>
            </div>
            <div class="modal-footer">
                <button id="protocol_details_error_close_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('global.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery('#edit_genotyping_protocol_details').click(function(){
        jQuery('#genotyping_protocol_details_edit_dialog').modal("show");
        edit_protocol_details();
    });

    jQuery('#save_protocol_details').click(function(){
        var protocol_id = "<% $protocol_id %>";
        var changed_elements = document.getElementsByName("changed");
        var categories = [];
        var new_details = {};
        var success_message = '';
        for(var i=0; i<changed_elements.length; i++){
            var id = changed_elements[i].id;
            var type = changed_elements[i].title;
            var new_value = changed_elements[i].value;
            categories.push(type);
            new_details[type] = new_value;
            var ui_changed_field = String(type);
            var ui_changed_prefix = window.SGN && SGN.i18n ? SGN.i18n.p('genotype.protocol.edit.changed_prefix', 'Changed %{field} to:', {field: ui_changed_field}) : "Changed " + ui_changed_field + " to:";
            success_message += "<li class='list-group-item list-group-item-success'> " + jQuery("<span>").text(ui_changed_prefix).html() + " <b>" + new_value + "</b></li>";
        }

        save_protocol_details(protocol_id, categories, new_details, success_message);

    });
});

function edit_protocol_details(){

    jQuery('[id^="edit_protocol_"]').change(function (){
        var this_element = jQuery(this);
        highlight_changed_details(this_element);
    });

    var edit_details_body_html = document.getElementById('protocol_details_edit_body').innerHTML;

    jQuery('#edit_protocol_details_cancel_button').click(function(){
        reset_dialog_body('protocol_details_edit_body', edit_details_body_html);
    });

    jQuery('#protocol_details_error_close_button').click( function() {
        document.getElementById('protocol_details_error_message').innerHTML = "";
    });

    jQuery('#protocol_details_saved_close_button').click( function() {
        location.reload();
    });

}

function save_protocol_details (protocol_id, categories, details, success_message) {

    jQuery.ajax( {
        url: '/ajax/genotyping_protocol/details',
        type: 'POST',
        data: { 'protocol_id' : protocol_id, 'categories' : categories, 'details' : details },
        success: function(response) {
            if (response.success) {
                document.getElementById('protocol_details_saved_message').innerHTML = success_message;
                jQuery('#protocol_details_saved_dialog').modal("show");
                return;
            } else {
                document.getElementById('protocol_details_error_message').innerHTML = "<li class='list-group-item list-group-item-danger'>"+response.error+"</li>";
                jQuery('#protocol_details_error_dialog').modal("show");
            }
        },
        error: function(response) {
            var ui_update_failure = <% JSON::PP::encode_json($c->i18n->p('genotype.protocol.edit.ajax_failed', ' Protocol detail update AJAX request failed. Update not completed.')) %>;
            document.getElementById('protocol_details_error_message').innerHTML = "<li class='list-group-item list-group-item-danger'>" + jQuery("<span>").text(ui_update_failure).html() + "</li>";
            jQuery('#protocol_details_error_dialog').modal("show");
        },
    });

}

</script>

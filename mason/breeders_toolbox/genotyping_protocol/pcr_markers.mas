<%args>
$protocol_id
</%args>

<table id="pcr_protocol_markers_table" class="table table-hover table-bordered">
    <thead>
        <tr>
            <th><% $c->i18n->p('genotype.protocol.pcr_markers.marker_name', 'Marker Name') |h %></th>
            <th><% $c->i18n->p('genotype.protocol.pcr_markers.product_sizes', 'Product Sizes') |h %></th>
            <th><% $c->i18n->p('genotype.protocol.pcr_markers.forward_primer', 'Forword Primer') |h %></th>
            <th><% $c->i18n->p('genotype.protocol.pcr_markers.reverse_primer', 'Reverse Primer') |h %></th>
            <th><% $c->i18n->p('genotype.protocol.pcr_markers.annealing_temperature', 'Annealing Temperature') |h %></th>
            <th><% $c->i18n->p('genotype.protocol.pcr_markers.sequence_motif', 'Sequence Motif') |h %></th>
            <th><% $c->i18n->p('genotype.protocol.pcr_markers.sequence_source', 'Sequence Source') |h %></th>
            <th><% $c->i18n->p('genotype.protocol.pcr_markers.linkage_group', 'Linkage Group') |h %></th>
        </tr>
    </thead>
    </tbody>
</table>

<script>

jQuery(document).ready(function(){

    var pcr_genotyping_protocol_table = jQuery('#pcr_protocol_markers_table').DataTable({
        'autoWidth': false,
        'ajax': {'url': '/ajax/genotyping_protocol/pcr_markers',
                 'data': function(d) {
                    d.protocol_id = <% $protocol_id %>;
                }
        },
    });

});


</script>

<%once>
use HTML::Entities ();
</%once>
<%doc>

=head1 NAME

breeders_toolbox/trial_trait.mas - trial specific trait data display

=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$trial_id
$trial_name
$trait_id
$trait_name

</%args>

<%perl>

$trait_name = ucfirst($trait_name);

</%perl>

<& /page/page_title.mas, 
   title => HTML::Entities::encode_entities($c->i18n->p("trial.trait.title", "%{trait} in %{trial}", {trait => $trait_name, trial => $trial_name}))
&>

<&| /page/info_section.mas,
   title => HTML::Entities::encode_entities($c->i18n->p("trial.trait.frequency_title", "Trait phenotype data frequency distribution from %{trial}", {trial => $trial_name}))
&>
 
  <div id="histogram_message"  style="font-weight:bold;text-align:center;color:#A7C942">
    <p><% $c->i18n->p("trial.trait.loading", "Loading frequency distribution graph...") |h %></p>
  </div>

 
  <& /solgs/population/trait_phenotype_histogram.mas,
     trial_id => $trial_id,
     trait_id => $trait_id
    &>

</&>


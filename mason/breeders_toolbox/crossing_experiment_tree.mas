
<%args>
$user_id => undef
@programs => ()
@locations => ()
@roles => ()
$odk_service => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form','CXGN.BreedersToolbox.Crosses', 'jstree.dist.jstree', 'CXGN.TrialTreeFolders'] &>

<& /util/import_css.mas, paths => ['/static/documents/inc/jstree_theme/jstree-bstheme-min.css'] &>

% if ($odk_service eq 'ONA') {
    <& /breeders_toolbox/cross/cross_wishlist.mas &>
%}
<& /breeders_toolbox/cross/add_cross_dialogs.mas, programs=>\@programs, locations=>\@locations &>
<& /breeders_toolbox/cross/upload_crosses_dialogs.mas, programs=>\@programs, locations=>\@locations &>
<& /breeders_toolbox/cross/add_crossing_trial_dialogs.mas, programs=>\@programs, locations=>\@locations &>
<& /breeders_toolbox/folder/folder_set.mas, project_type=>'crossing_experiment' &>
<& /breeders_toolbox/folder/folder_new.mas, project_type=>'crossing_experiment' &>
<& /breeders_toolbox/folder/folder_move.mas, project_type=>'crossing_experiment' &>
<& /breeders_toolbox/folder/folders_edit.mas, folder_tree_type => 'Cross', folder_tree_identifier => 'crosses_list', folder_tree_refresh_name => 'refresh_crosses_jstree_html' &>

<table class="table table-bordered">
    <thead>
        <tr>
            <th><% $c->i18n->p('cross.ui.information', 'Information') |h %></th>
            <th><% $c->i18n->p('cross.ui.breeding_programs_folders_crossing_experiments', 'Breeding Programs -- Folders -- Crossing Experiments    ') |h %><button class="btn btn-sm btn-default" id="refresh_crosses_jstree_html_trialtree_button" name="refresh_crosses_jstree_html"><% $c->i18n->p('cross.ui.refresh', 'Refresh') |h %></button></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                <h4><% $c->i18n->p('cross.ui.search', 'Search') |h %></h4>
                <input type="text" class="form-control input-sm" id="cross_tree_search" placeholder="<% $c->i18n->p('cross.ui.search', 'Search') |h %>" />
                <hr>

                <h5><i><% $c->i18n->p('cross.ui.double_click', 'Double click') |h %><br /><% $c->i18n->p('cross.ui.crossing_experiment.722f9e0', 'crossing experiment ( ') |h %><span class="glyphicon glyphicon-grain text-success"></span><% $c->i18n->p('cross.ui.or_folder', ' ) or folder ( ') |h %><span class="glyphicon glyphicon-folder-open text-danger"></span>&nbsp;)<br/><% $c->i18n->p('cross.ui.to_view_detail_page', 'to view detail page.') |h %></i></h5>
                <h5><i><% $c->i18n->p('cross.ui.breeding_programs', 'Breeding programs ( ') |h %><span class="glyphicon glyphicon-briefcase text-info"></span>&nbsp;)</i></h5>
                <hr>

                <h4><% $c->i18n->p('cross.ui.folders', 'Folders') |h %></h4>
                <button class="btn btn-sm btn-default" id="new_folder_dialog_link"><% $c->i18n->p('cross.ui.create_new_folder', 'Create new folder') |h %></button><br/><br/>
                <button class="btn btn-sm btn-default" id="open_folder_dialog_link"><% $c->i18n->p('cross.ui.move_crossing_experiment_s_to_folder', 'Move crossing experiment(s) to folder') |h %></button><br/><br/>
                <button class="btn btn-sm btn-default" id="move_folder_dialog_link"><% $c->i18n->p('cross.ui.move_folder', 'Move folder') |h %></button>

                <div id="folder_edit_options" style="display:none">
                    <hr>
                    <h5><i><% $c->i18n->p('cross.ui.select_multiple_folders_by_holding_ctrl', 'Select multiple folders by holding \'Ctrl\'.') |h %></i></h5>
                    <button class="btn btn-primary" id="edit_folders_button" title="<% $c->i18n->p('cross.ui.first_select_folder_s_to_edit', 'First Select Folder(s) to Edit') |h %>"><% $c->i18n->p('cross.ui.edit_folder_s', 'Edit Folder(s)') |h %></button>
                    <br/>
                </div>

                <!--<button id="delete" disabled="disabled" >Delete</button -->
                <br />
            </td>
            <td>
                <div id="crosses_list" ><% $c->i18n->p('cross.ui.loading', '[loading...]') |h %></div>
            </td>
        </tr>
    </tbody>
</table>


<script>
// Optional locale assets never block the native crossing workflow.
var crossI18n = (window.SGN && window.SGN.i18n) || {
    p: function (context, source, variables) {
        return source.replace(/%\{([A-Za-z0-9_]+)\}/g, function (match, name) {
            return variables && Object.prototype.hasOwnProperty.call(variables, name) ? String(variables[name]) : match;
        });
    },
    np: function (context, one, many, count, variables) {
        return this.p(context, count === 1 ? one : many, variables);
    }
};
function crossHTML(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, function (character) {
        return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[character];
    });
}



jQuery.noConflict();

jQuery(document).ready(function($) {

    jQuery('#crosses_datatable').DataTable({
        destroy: true,
        scrollY:        '30vh',
            scrollCollapse: true,
            paging:         false,
    });

    jQuery.ajax( {
      url: '/ajax/breeders/get_trials_with_folders_cached?type=cross',
      success: function(response) {
        var html = '<ul>'+response.html+'</ul>';

        jQuery('#crosses_list').html(html);
        //console.log(html);
        jQuery('#crosses_list').jstree( {
            "core": { 'themes': { 'name': 'proton', 'responsive': true}},
            "valid_children" : [ "folder", "trial", "breeding_program" ],
            "types" : {
                "breeding_program" : {
                    "icon": 'glyphicon glyphicon-briefcase text-info',
                },
                "folder" : {
                    "icon": 'glyphicon glyphicon-folder-open text-danger',
                },
                "cross" : {
                    "icon": 'glyphicon glyphicon-grain text-success',
                }
            },
            "search" : {
                 "case_insensitive" : true,
             },
          "plugins" : ["html_data","types","search"],

        });

      },
      error: function(response) {
        alert(crossI18n.p("cross.ui.an_error_occurred_while_loading_the_trial_data", "An error occurred while loading the trial data."));
      }
  });

    jQuery("#cross_tree_search").keyup(function() {
        var v = jQuery("#cross_tree_search").val();
        jQuery("#crosses_list").jstree(true).search(v);
    });

    jQuery('#crosses_list').on("changed.jstree", function (e, data) {
        //console.log(data);
        if ($('#trial_list').jstree('is_leaf', data.node) && data.node.data.jstree.type == 'folder') {
            jQuery("#folder_edit_options").show();
        }
        else {
            jQuery("#folder_edit_options").hide();
        }
    });

    jQuery("#crosses_list").delegate("li", "dblclick", function(event){
        var node = $("#crosses_list").jstree("get_node", this);
        //console.log(node);
        if (node.id.substr(0,1) !== 'j') {
            if (node.type == 'folder') {
                window.open('/folder/'+node.id);
                event.stopPropagation();
            } else if (node.type == 'cross') {
                window.open('/breeders_toolbox/trial/'+node.id);
                event.stopPropagation();
            }
        }
    });

});

</script>

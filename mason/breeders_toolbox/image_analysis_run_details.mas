<%args>
$run_project_id
$run_name
$service_name
$run_date
$analysis_info_json => '{}'
$trial_id           => undef
$trial_name         => undef
$overlay_image_id   => undef
$overlay_image_url  => undef
$source_image_id    => undef
</%args>

<div class="panel panel-default">
  <div class="panel-body">
    <div class="row">

      <!-- Left: run-level facts. Pipeline metadata is run-wide, shown once. -->
      <div class="col-sm-6">
        <table class="table table-hover table-bordered">

          <tr>
            <td style="width:35%;"><b>Run Name</b></td>
            <td><div id="run_name"><% $run_name %></div></td>
          </tr>

          <tr>
            <td><b>Service</b></td>
            <td>
              <div id="service_name">
% if ($service_name) {
                <% $service_name %>
% } else {
                <span class="text-danger">[No Service]</span>
% }
              </div>
            </td>
          </tr>

          <tr>
            <td><b>Run Date</b></td>
            <td><div id="run_date"><% $run_date || '—' %></div></td>
          </tr>

          <tr>
            <td><b>Field Trial(s)</b></td>
            <td><div id="run_trial_links"><span class="text-muted">Loading…</span></div></td>
          </tr>

          <tr>
            <td><b>Images Analyzed</b></td>
            <td><div id="run_image_count"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b>Tissue Samples</b></td>
            <td><div id="run_sample_count"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td colspan="2" style="background:#f5f5f5;"><b>Pipeline Details</b></td>
          </tr>

          <tr>
            <td><b>Pipeline Name</b></td>
            <td><div id="meta_pipeline_name"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b>Pipeline Version</b></td>
            <td><div id="meta_pipeline_version"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b>Job ID</b></td>
            <td><div id="meta_job_id" style="word-break:break-all;"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b>Timestamp</b></td>
            <td><div id="meta_timestamp"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b>Input Filename</b></td>
            <td><div id="meta_input_filename" style="word-break:break-all;"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b>QC</b></td>
            <td>
              <div id="meta_qc_json"
                   style="max-height:120px;overflow:auto;font-size:11px;white-space:pre-wrap;word-break:break-word;margin:0;">—</div>
            </td>
          </tr>

        </table>
      </div>

      <!-- Right: one row per analyzed image, links down to its results panel -->
      <div class="col-sm-6">
        <h5 style="margin-top:0;"><strong>Analyzed Images</strong></h5>

        <div id="run_images_summary_loading" class="text-muted" style="padding:10px;">
          <span class="glyphicon glyphicon-refresh"></span> Loading images…
        </div>

        <table id="run_images_summary_table"
               class="table table-bordered table-condensed table-hover"
               style="width:100%;font-size:12px;display:none;">
          <thead>
            <tr>
              <th style="width:45px;"></th>
              <th>Source Image</th>
              <th>Source Stock</th>
              <th style="width:60px;">Samples</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>

        <p class="text-muted" style="font-size:11px;margin-top:6px;">
          Click a filename to jump to that image's results below.
        </p>
      </div>

    </div>
  </div>
</div>
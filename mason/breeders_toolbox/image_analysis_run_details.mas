<%args>
$run_project_id
$run_name
$service_name
$run_date
$trial_id
$trial_name
$analysis_info_json => '{}'
$overlay_image_id   => undef
$overlay_image_url  => undef
$source_image_id    => undef
</%args>

<div class="panel panel-default">
    <div class="panel-body">
<div class="row">

    <!-- Left: details table (col-sm-8 like the trial page) -->
    <div class="col-sm-8">

        <table class="table table-hover table-bordered">

            <tr>
                <td><b>Run Name</b></td>
                <td><div id="run_name"><% $run_name %></div></td>
            </tr>

            <tr>
                <td><b>Service</b></td>
                <td>
                    <div id="service_name">
% if ($service_name) {
%     print "$service_name";
% } else {
%     print "<span class='text-danger'>[No Service]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Field Trial</b></td>
                <td>
                    <div id="trial_link">
% if ($trial_name) {
                        <a href="/breeders/trial/<% $trial_id %>"><% $trial_name %></a>
% } else {
%     print "<span class='text-danger'>[No Trial]</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b>Source Image</b></td>
                <td>
                    <div id="source_image">
% if ($source_image_id) {
                        <a href="/image/view/<% $source_image_id %>">Image #<% $source_image_id %></a>
% } else {
                        <span class="text-muted">None</span>
% }
                    </div>
                </td>
            </tr>

            <!-- ==== analysis_metadata rows (populated by JS) ==== -->
            <tr>
                <td><b>Pipeline Name</b></td>
                <td><div id="meta_pipeline_name"><span class="text-muted">—</span></div></td>
            </tr>

            <tr>
                <td><b>Pipeline Version</b></td>
                <td><div id="meta_pipeline_version"><span class="text-muted">—</span></div></td>
            </tr>

            <tr>
                <td><b>Job ID</b></td>
                <td><div id="meta_job_id" style="word-break:break-all;"><span class="text-muted">—</span></div></td>
            </tr>

            <tr>
                <td><b>Timestamp</b></td>
                <td><div id="meta_timestamp"><span class="text-muted">—</span></div></td>
            </tr>

            <tr>
                <td><b>Input Filename</b></td>
                <td><div id="meta_input_filename" style="word-break:break-all;"><span class="text-muted">—</span></div></td>
            </tr>

            <tr>
                <td><b>QC</b></td>
                <td>
                    <div id="meta_qc_json"
                         style="max-height:120px;overflow:auto;font-size:11px;white-space:pre-wrap;word-break:break-word;margin:0;">—</div>
                </td>
            </tr>

        </table>

    </div>

    <!-- Right: overlay image (col-sm-4 like the trial page barcode column) -->
    <div class="col-sm-4">
            <h5 style="margin-top:0;"><strong>Result Overlay Image</strong></h5>
% if ($overlay_image_url) {
            <div style="border:1px solid #ddd;padding:5px;background:#fff;text-align:center;">
                <img id="overlay_image_display"
                     src="<% $overlay_image_url %>"
                     style="max-width:100%;max-height:450px;cursor:pointer;"
                     title="Click to view full image"
                     onclick="window.open('<% $overlay_image_url %>','_blank')"/>
            </div>
            <p class="text-muted" style="font-size:11px;margin-top:6px;margin-bottom:0;">
                Click image to open full size.
                <a href="/image/view/<% $overlay_image_id %>">View image details</a>
            </p>
% } else {
            <div class="text-center text-muted" style="padding:40px 10px;">
                <span class="glyphicon glyphicon-picture" style="font-size:48px;"></span>
                <p style="margin-top:10px;">No overlay image available.</p>
            </div>
% }
    </div>

    </div>
    </div>
</div>
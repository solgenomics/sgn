<%args>
$run_project_id
$run_name
$service_name
$run_date
$analysis_info_json => '{}'
$trial_id           => undef
$trial_name         => undef
$overlay_image_id   => undef
$overlay_image_url  => undef
$source_image_id    => undef
</%args>

<div class="panel panel-default">
  <div class="panel-body">
    <div class="row">

      <!-- Left: run-level facts. Pipeline metadata is run-wide, shown once. -->
      <div class="col-sm-6">
        <table class="table table-hover table-bordered">

          <tr>
            <td style="width:35%;"><b><% $c->i18n->p('image_analysis.run.run_name', 'Run Name') | h %></b></td>
            <td><div id="run_name"><% $run_name %></div></td>
          </tr>

          <tr>
            <td><b><% $c->i18n->p('image_analysis.run.service', 'Service') | h %></b></td>
            <td>
              <div id="service_name">
% if ($service_name) {
                <% $service_name %>
% } else {
                <span class="text-danger"><% $c->i18n->p('image_analysis.run.no_service', '[No Service]') | h %></span>
% }
              </div>
            </td>
          </tr>

          <tr>
            <td><b><% $c->i18n->p('image_analysis.run.run_date', 'Run Date') | h %></b></td>
            <td><div id="run_date"><% $run_date || '—' %></div></td>
          </tr>

          <tr>
            <td><b><% $c->i18n->p('image_analysis.run.field_trial_s', 'Field Trial(s)') | h %></b></td>
            <td><div id="run_trial_links"><span class="text-muted"><% $c->i18n->p('image_analysis.run.loading', 'Loading…') | h %></span></div></td>
          </tr>

          <tr>
            <td><b><% $c->i18n->p('image_analysis.run.images_analyzed', 'Images Analyzed') | h %></b></td>
            <td><div id="run_image_count"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b><% $c->i18n->p('image_analysis.run.tissue_samples', 'Tissue Samples') | h %></b></td>
            <td><div id="run_sample_count"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td colspan="2" style="background:#f5f5f5;"><b><% $c->i18n->p('image_analysis.run.pipeline_details', 'Pipeline Details') | h %></b></td>
          </tr>

          <tr>
            <td><b><% $c->i18n->p('image_analysis.run.pipeline_name', 'Pipeline Name') | h %></b></td>
            <td><div id="meta_pipeline_name"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b><% $c->i18n->p('image_analysis.run.pipeline_version', 'Pipeline Version') | h %></b></td>
            <td><div id="meta_pipeline_version"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b><% $c->i18n->p('image_analysis.run.job_id', 'Job ID') | h %></b></td>
            <td><div id="meta_job_id" style="word-break:break-all;"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b><% $c->i18n->p('image_analysis.run.timestamp', 'Timestamp') | h %></b></td>
            <td><div id="meta_timestamp"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b><% $c->i18n->p('image_analysis.run.input_filename', 'Input Filename') | h %></b></td>
            <td><div id="meta_input_filename" style="word-break:break-all;"><span class="text-muted">—</span></div></td>
          </tr>

          <tr>
            <td><b><% $c->i18n->p('image_analysis.run.qc', 'QC') | h %></b></td>
            <td>
              <div id="meta_qc_json"
                   style="max-height:120px;overflow:auto;font-size:11px;white-space:pre-wrap;word-break:break-word;margin:0;">—</div>
            </td>
          </tr>

        </table>
      </div>

      <!-- Right: one row per analyzed image, links down to its results panel -->
      <div class="col-sm-6">
        <h5 style="margin-top:0;"><strong><% $c->i18n->p('image_analysis.run.analyzed_images', 'Analyzed Images') | h %></strong></h5>

        <div id="run_images_summary_loading" class="text-muted" style="padding:10px;">
          <span class="glyphicon glyphicon-refresh"></span> <% $c->i18n->p('image_analysis.run.loading_images', 'Loading images…') | h %>
        </div>

        <table id="run_images_summary_table"
               class="table table-bordered table-condensed table-hover"
               style="width:100%;font-size:12px;display:none;">
          <thead>
            <tr>
              <th style="width:45px;"></th>
              <th><% $c->i18n->p('image_analysis.run.source_image', 'Source Image') | h %></th>
              <th><% $c->i18n->p('image_analysis.run.source_stock', 'Source Stock') | h %></th>
              <th style="width:60px;"><% $c->i18n->p('image_analysis.run.samples', 'Samples') | h %></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>

        <p class="text-muted" style="font-size:11px;margin-top:6px;">
          <% $c->i18n->p('image_analysis.run.click_a_filename_to_jump_to_that_image_s_results_below', 'Click a filename to jump to that image\'s results below.') | h %>
        </p>
      </div>

    </div>
  </div>
</div>
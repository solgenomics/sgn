<%once>
use HTML::Entities ();
</%once>
<%args>
</%args>

<& /util/import_javascript.mas, classes => [ ] &>

<& /util/import_css.mas, paths => [ ] &>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("program.identifiers.page_title", "Manage Identifier Generation")) &>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <p><% $c->i18n->p("program.identifiers.intro", "It is often necessary to pre-create identifiers. This is used in %{acai} and the %{banana_project} project for pre-printing barcode identifiers that are later assigned to trials in the field. This can also be used for pre-printing barcode identifiers that are later assigned to samples in the lab.", {acai => "ACAI", banana_project => "Banana Agronomy"}) |h %></p>
        </div>
    </div>
</div>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, info_section_title => '<h4 style="display:inline">' . HTML::Entities::encode_entities($c->i18n->p("program.identifiers.section_title", "Available Identifiers")) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("program.identifiers.section_help", "View, add, and download identifiers.")), buttons_html => '<button class="btn btn-primary btn-sm" id="add_new_identifier_button" style="margin:3px">' . HTML::Entities::encode_entities($c->i18n->p("program.identifiers.add_new", "Add New Identifier")) . '</button>', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "identifier_generation_list" &>

<div class="modal fade" id="add_new_identifier_dialog" name="add_new_identifier_dialog" tabindex="-1" role="dialog" aria-labelledby="addNewIdentifierDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("folder.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addNewIdentifierDialog"><% $c->i18n->p("program.identifiers.title", "Add New Identifier") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" id="create_new_identifier_form" name="create_new_identifier_form">
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("program.identifiers.name", "Name: ") |h %></label>
                            <div class="col-sm-9">
                                <input class="form-control" id="new_identifier_list_name" name="new_identifier_list_name" type="text" placeholder="<% $c->i18n->p("program.identifiers.example_list", "For example: ACTLNG_Identifiers") |h %>"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("program.identifiers.prefix", "Prefix: ") |h %></label>
                            <div class="col-sm-9">
                                <input class="form-control" id="new_identifier_prefix" name="new_identifier_prefix" type="text" placeholder="<% $c->i18n->p("program.identifiers.example_prefix", "For example: ACTLNG") |h %>"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("program.identifiers.digits", "Number of digits: ") |h %></label>
                            <div class="col-sm-9">
                                <input class="form-control" id="new_identifier_num_digits" name="new_identifier_num_digits" type="number" placeholder="<% $c->i18n->p("program.identifiers.example_digits", "For example: 6. Given the examples, the first identifier would be ACTLNG000001") |h %>" value="6"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("program.identifiers.current_number", "Current Identifier Number: ") |h %></label>
                            <div class="col-sm-9">
                                <input class="form-control" id="new_identifier_current_num" name="new_identifier_current_num" type="number" placeholder="<% $c->i18n->p("program.identifiers.example_current", "For example: 101. Given the examples, the next identifier would be ACTLNG000101") |h %>" value="1"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("program.identifiers.description", "Description: ") |h %></label>
                            <div class="col-sm-9">
                                <input class="form-control" id="new_identifier_description" name="new_identifier_description" type="text" placeholder="<% $c->i18n->p("program.identifiers.description_help", "A description of what the identifier is used for") |h %>" />
                            </div>
                        </div>
                    </form>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("folder.ui.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" id="new_identifier_submit_button"><% $c->i18n->p("trial.repetitive.submit", "Submit") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){
    jQuery('#add_new_identifier_button').click(function(){
        jQuery('#add_new_identifier_dialog').modal('show');
    });

    jQuery('#new_identifier_submit_button').click(function(){
        var identifier_list_name = jQuery('#new_identifier_list_name').val();
        var identifier_prefix = jQuery('#new_identifier_prefix').val();
        var num_digits = jQuery('#new_identifier_num_digits').val();
        var current_number = jQuery('#new_identifier_current_num').val();
        var description = jQuery('#new_identifier_description').val();
        jQuery.ajax({
            url : '/ajax/breeders/new_identifier_generation',
            data : {
                'identifier_name':identifier_list_name,
                'identifier_prefix':identifier_prefix,
                'num_digits':num_digits,
                'current_number':current_number,
                'description':description
            },
            success: function(response){
                console.log(response);
                if(response.error){
                    alert(response.error);
                }
                if(response.success){
                    alert(response.success);
                }
            },
            error: function(response){
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.identifiers.submit_error", "Error submitting new identifier!") : "Error submitting new identifier!"));
            }
        });
    });
});

</script>

<%args>
</%args>

<table class="table table-hover table-bordered" id="identifier_generator_list_table">
    <thead>
        <tr>
            <th><% $c->i18n->p("program.identifiers.list.header.name", "Name") |h %></th>
            <th><% $c->i18n->p("program.identifiers.list.header.description", "Description") |h %></th>
            <th><% $c->i18n->p("program.identifiers.list.header.prefix", "Prefix") |h %></th>
            <th><% $c->i18n->p("program.identifiers.list.header.digits", "Number of Digits") |h %></th>
            <th><% $c->i18n->p("program.identifiers.list.header.current_number", "Current Number") |h %></th>
            <th><% $c->i18n->p("program.identifiers.list.header.next_identifier", "Next Identifier") |h %></th>
            <th><% $c->i18n->p("program.identifiers.list.header.history", "History") |h %></th>
            <th><% $c->i18n->p("program.identifiers.list.header.download_next", "Download Next Identifiers") |h %></th>
        </tr>
    </thead>
</table>

<div class="modal fade" id="identifier_generation_history_dialog" name="identifier_generation_history_dialog" tabindex="-1" role="dialog" aria-labelledby="identifierGenerationHistoryDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("folder.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="identifierGenerationHistoryDialog"><% $c->i18n->p("program.identifiers.history.title", "Identifier Generation History") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="identifier_generation_history_div">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("folder.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

function _sgnB14IdentifierEscapeHTML(value) { return jQuery('<div>').text(value).html(); }

jQuery(document).ready(function(){
    var identifier_generation_list_table = jQuery('#identifier_generator_list_table').DataTable({
        ajax : '/ajax/breeders/identifier_generation_list'
    });

    jQuery(document).on('click', 'button[name="identifier_generation_download"]', function(){
        var list_id = jQuery(this).data('list_id');
        var next_number = jQuery('#identifier_generation_next_numbers_'+list_id).val();
        jQuery.ajax({
            url : '/ajax/breeders/identifier_generation_download',
            data : {
                'list_id':list_id,
                'next_number':next_number
            },
            success: function(response){
                console.log(response);
                if(response.error){
                    alert(response.error);
                }
                if(response.success){
                    window.location.href = "/download/"+response.filename;
                    identifier_generation_list_table.ajax.reload();
                }
            },
            error: function(response){
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.identifiers.error.download", "Error downloading new identifiers!") : "Error downloading new identifiers!"));
            }
        });
    });

    jQuery(document).on('click', 'button[name="identifier_generation_history"]', function(){
        var list_id = jQuery(this).data('list_id');
        jQuery.ajax({
            url : '/ajax/breeders/identifier_generation_history',
            data : {
                'list_id':list_id,
            },
            success: function(response){
                console.log(response);
                if(response.error){
                    alert(response.error);
                }
                if(response.success){
                    var html = '<table class="table table-bordered table-hover"><thead><tr><th>' + _sgnB14IdentifierEscapeHTML(window.SGN && window.SGN.i18n ? window.SGN.i18n.p('program.identifiers.history.timestamp', 'Timestamp') : 'Timestamp') + '</th><th>' + _sgnB14IdentifierEscapeHTML(window.SGN && window.SGN.i18n ? window.SGN.i18n.p('program.identifiers.history.username', 'Username') : 'Username') + '</th><th>' + _sgnB14IdentifierEscapeHTML(window.SGN && window.SGN.i18n ? window.SGN.i18n.p('program.identifiers.history.next_count', 'Next Count') : 'Next Count') + '</th><th>' + _sgnB14IdentifierEscapeHTML(window.SGN && window.SGN.i18n ? window.SGN.i18n.p('program.identifiers.history.action_type', 'Action Type') : 'Action Type') + '</th></tr></thead><tbody>';
                    for(var i=0; i<response.records.length; i++){
                        html = html + '<tr><td>' + response.records[i].timestamp + '</td><td>' + response.records[i].username + '</td><td>' + response.records[i].next_number + '</td><td>' + response.records[i].type + '</td></tr>';
                    }
                    html = html + '</tbody></table>';
                    jQuery('#identifier_generation_history_div').html(html);
                    jQuery('#identifier_generation_history_dialog').modal('show');
                }
            },
            error: function(response){
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.identifiers.error.history", "Error getting identifier list history!") : "Error getting identifier list history!"));
            }
        });
    });
});

</script>
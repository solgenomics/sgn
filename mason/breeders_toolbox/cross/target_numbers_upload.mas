<%args>
$trial_id
$trial_name
</%args>


<div class="modal fade" id="upload_target_numbers_dialog" name="upload_target_numbers_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadTargetNumbersDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTargetNumbersDialog"><% $c->i18n->p("cross.forms.upload_target_numbers_of_seeds_progenies_for_this_crossing", "Upload Target Numbers of Seeds/Progenies for This Crossing Experiment") |h %> </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>HTML::Entities::encode_entities($c->i18n->p("cross.forms.target_numbers_upload_information", "Target Numbers Upload Information")) &>
                        <p>
                            <a id="upload_target_numbers_spreadsheet_format_info"><% $c->i18n->p("cross.forms.target_numbers_upload_information", "Target Numbers Upload Information") |h %></a>
                        </p>
                    </&>
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_target_numbers_form" name="upload_target_numbers_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("cross.ui.crossing_experiment.9272d74", "Crossing Experiment:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" name="target_numbers_experiment_name" id="target_numbers_experiment_name" disabled value="<% $trial_name %>">
                                <input name="target_numbers_experiment_id" id="target_numbers_experiment_id" type="hidden" value="<% $trial_id %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("cross.forms.upload_file_xls_or_xlsx", "Upload File (.xls or .xlsx):") |h %> </label>
                            <div class="col-sm-8">
                                <input type="file" name="target_numbers_file" id="target_numbers_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="upload_target_numbers_submit" id="upload_target_numbers_submit"><% $c->i18n->p("cross.ui.upload_file.3ee3b0b", "Upload File") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_target_numbers_error_display" name="upload_target_numbers_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadTargetNumbersErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTargetNumbersErrorDialog"><% $c->i18n->p("cross.forms.upload_target_numbers_error", "Upload Target Numbers Error") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="target_numbers_saved_dialog_message" name="target_numbers_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="targetNumbersSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="targetNumbersSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("cross.forms.the_target_numbers_of_seeds_progenies_were_saved_successfully", "The target numbers of seeds/progenies were saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_target_numbers_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="target_numbers_spreadsheet_info_dialog" name="target_numbers_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="targetNumbersFileInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="targetNumbersFileInfoDialog"><% $c->i18n->p("cross.ui.template_information.bf8c643", "Template Information") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% $c->i18n->p("cross.forms.target_numbers_of_seeds_progenies_may_be_uploaded_in", "Target numbers of seeds/progenies may be uploaded in an Excel file (.xls or .xlsx)") |h %>
                    <br><br>
                    <b><% $c->i18n->p("cross.ui.header", "Header:") |h %></b>
                    <br>
                        <% $c->i18n->p("seedlots.ui.the_first_row_header_must_contain_the_following", "The first row (header) must contain the following:") |h %>
                    <br>
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>female_accession</td>
                                <td>male_accession</td>
                                <td>seed_target_number</td>
                                <td>progeny_target_number</td>
                            </tr>
                        </tbody>
                    </table>
                    <b><% $c->i18n->p("cross.forms.field_info", "Field Info:") |h %></b>
                    <ul>
                        <li><% $c->i18n->p("cross.forms.female_accession_must_exist_as_uniquename_in_the_database", "female_accession (must exist as uniquename in the database.)") |h %></li>
                        <li><% $c->i18n->p("cross.forms.male_accession_must_exist_as_uniquename_in_the_database", "male_accession (must exist as uniquename in the database.)") |h %></li>
                        <li><% $c->i18n->p("cross.forms.please_indicate_target_number_of_seeds_and_or_target", "Please indicate target number of seeds and/or target number of progenies for each cross combination") |h %></li>
                    </ul>
                    <br>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery('#upload_target_numbers_link').click(function(){
        jQuery('#upload_target_numbers_dialog').modal("show");
    });

    jQuery('#upload_target_numbers_spreadsheet_format_info').click(function(){
        jQuery("#target_numbers_spreadsheet_info_dialog").modal("show");
    });

    jQuery("#upload_target_numbers_submit").click(function(){
        var uploadFile = jQuery("#target_numbers_file").val();

        jQuery('#upload_target_numbers_form').attr("action", "/ajax/crossing_experiment/upload_target_numbers");


        if (uploadFile === ''){
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.please_select_a_file", "Please select a file") : "Please select a file"));
            return;
        }

        jQuery("#upload_target_numbers_form").submit();
        jQuery("#upload_target_numbers_dialog").modal("hide");
    });

    jQuery('#upload_target_numbers_form').iframePostForm({
        json: true,
        post: function(){
            jQuery("#working_modal").modal("show");
        },
        complete: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error_string) {
                jQuery("#upload_target_numbers_error_display tbody").html('');
                jQuery("#upload_target_numbers_error_display tbody").append(response.error_string);
                jQuery("#upload_target_numbers_error_display").modal("show");
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                jQuery('#target_numbers_saved_dialog_message').modal("show");
            }
        }
    });

    jQuery("#dismiss_target_numbers_saved_dialog").click(function(){
        location.reload();
    });

});

</script>

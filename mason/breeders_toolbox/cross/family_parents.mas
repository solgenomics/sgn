<%args>
$family_id
$family_type
</%args>

<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<div style="overflow:scroll">
    <table class="table table-hover table-bordered" id="family_parent_information">
        <thead>
            <tr>
% if ($family_type eq 'same_parents') {
                        <th><% $c->i18n->p("accession.related_stock.header.female_parent", "Female Parent") |h %></th>
                        <th><% $c->i18n->p("cross.pages.female_stock_type", "Female Stock Type") |h %></th>
                        <th><% $c->i18n->p("cross.ui.female_ploidy", "Female Ploidy") |h %></th>
                        <th><% $c->i18n->p("accession.related_stock.header.male_parent", "Male Parent") |h %></th>
                        <th><% $c->i18n->p("cross.pages.male_stock_type", "Male Stock Type") |h %></th>
                        <th><% $c->i18n->p("cross.ui.male_ploidy", "Male Ploidy") |h %></th>
% } elsif ($family_type eq 'reciprocal_parents') {
                        <th><% $c->i18n->p("cross.pages.parent_1", "Parent 1") |h %></th>
                        <th><% $c->i18n->p("cross.pages.parent_1_stock_type", "Parent 1 Stock Type") |h %></th>
                        <th><% $c->i18n->p("cross.pages.parent_1_ploidy", "Parent 1 Ploidy") |h %></th>
                        <th><% $c->i18n->p("cross.pages.parent_2", "Parent 2") |h %></th>
                        <th><% $c->i18n->p("cross.pages.parent_2_stock_type", "Parent 2 Stock Type") |h %></th>
                        <th><% $c->i18n->p("cross.pages.parent_2_ploidy", "Parent 2 Ploidy") |h %></th>
%}
            </tr>
        </thead>
    </table>
</div>

<script>

jQuery(document).ready(function(){
    const family_id = "<%$family_id%>";
    const family_parent_table = jQuery('#family_parent_information').DataTable({
        'ajax': '/ajax/family/parent_info/'+family_id,
        'paging' : false,
        'searching' : false,
        'destroy' : true,
        "bLengthChange" : false,
        'bInfo' : false,
        'autoWidth': false,
    });

});

</script>

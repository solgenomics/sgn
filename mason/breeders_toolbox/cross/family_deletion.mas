<%args>
$family_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<&| /page/info_section.mas, id=>'remove_crosses_from_family_section', title => 'Remove crosses from this family', subtitle => ' ', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table class="table table-hover table-bordered" id="family_members_table">
                </table>
            </div>
        </div>
        <button class="btn btn-default" id="remove_all_crosses" role="button">Remove all crosses in this family</button><br/><br/>
    </div>
</&>

<&| /page/info_section.mas, id=>'delete_family_section', title => 'Delete family', subtitle => '<font color="red">Deletion cannot be undone. Please remove crosses in this family first</font>', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-default" id="delete_family" role="button">Delete this family</button><br/><br/>
            </div>
        </div>
    </div>
</&>


<script>

jQuery(document).ready(function(){

    jQuery('#remove_crosses_from_family_section_onswitch').click(function(){
        const family_id = "<%$family_id%>";
        const family_members_table = jQuery('#family_members_table').DataTable({
            'ajax': '/ajax/family/members/'+family_id,
            'destroy': true,
            'autoWidth': false,
            columns: [
                { title: "Cross Unique ID", "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
                { title: "Remove", "data": "null", "render": function ( data, type, row ) { return "<a onclick='removeFamilyMember("+row.cross_id+")'>Remove</a>"; } },
            ]
        });
    });

});

function removeFamilyMember(cross_id){

    var confirmation = confirm('Are you sure you want to remove this cross?');

    if (confirmation) {
        const family_id = "<%$family_id%>";
        jQuery.ajax({
            url: '/ajax/family/remove_member',
            data : {
                'cross_id': cross_id,
                'family_id': family_id,
            },
            method: 'POST',
            destroy: true,
            beforeSend: function(response) {
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    alert('The cross was removed successful');
                    location.reload();
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response) {
                jQuery('#working_modal').modal('hide');
                alert('An error occurred during removing cross member');
            }
        });
    }
}




</script>

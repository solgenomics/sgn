<%args>
$family_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<&| /page/info_section.mas, id=>'remove_crosses_from_family_section', title => HTML::Entities::encode_entities($c->i18n->p("cross.forms.remove_crosses_from_this_family", "Remove crosses from this family")), anchor_title => 'Remove crosses from this family', subtitle => ' ', collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table class="table table-hover table-bordered" id="family_members_table">
                </table>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, id=>'delete_family_section', title => HTML::Entities::encode_entities($c->i18n->p("cross.forms.delete_family", "Delete family")), anchor_title => 'Delete family', subtitle => "<font color=\"red\">" . HTML::Entities::encode_entities($c->i18n->p("cross.forms.deletion_cannot_be_undone", "Deletion cannot be undone.")) . "</font>", collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-default" id="delete_family" role="button"><% $c->i18n->p("cross.forms.delete_this_family", "Delete this family") |h %></button><br/><br/>
            </div>
        </div>
    </div>
</&>


<script>

jQuery(document).ready(function(){

    jQuery('#remove_crosses_from_family_section_onswitch').click(function(){
        const family_id = "<%$family_id%>";
        const family_members_table = jQuery('#family_members_table').DataTable({
            'ajax': '/ajax/family/members/'+family_id,
            'destroy': true,
            'autoWidth': false,
            columns: [
                { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.cross_unique_id.923bfbc", "Cross Unique ID") : "Cross Unique ID"), "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
                { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_publish.action.remove", "Remove") : "Remove"), "data": "null", "render": function ( data, type, row ) { return "<a onclick='removeFamilyMember("+row.cross_id+(")'>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_publish.action.remove", "Remove") : "Remove")).html() + "</a>"); } },
            ]
        });
    });

    jQuery('#delete_family').click(function() {

        const family_id = "<% $family_id %>";
        const confirmation = confirm((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.are_you_sure_you_want_to_delete_this_family", "Are you sure you want to delete this family? The deletion cannot be undone.") : "Are you sure you want to delete this family? The deletion cannot be undone."));
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/family/delete_family',
                data : {
                    'family_id': family_id,
                },
                method: 'POST',
                destroy: true,
                beforeSend: function(response) {
                    jQuery('#working_modal').modal('show');
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.the_family_was_deleted", "The family was deleted") : "The family was deleted"));
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.an_error_occurred_during_delete_this_family", "An error occurred during delete this family") : "An error occurred during delete this family"));
                }
            });
        }
    });

});

function removeFamilyMember(cross_id){

    var confirmation = confirm((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.are_you_sure_you_want_to_remove_this_cross", "Are you sure you want to remove this cross?") : "Are you sure you want to remove this cross?"));

    if (confirmation) {
        const family_id = "<%$family_id%>";
        jQuery.ajax({
            url: '/ajax/family/remove_member',
            data : {
                'cross_id': cross_id,
                'family_id': family_id,
            },
            method: 'POST',
            destroy: true,
            beforeSend: function(response) {
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.the_cross_was_removed", "The cross was removed") : "The cross was removed"));
                    location.reload();
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response) {
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.an_error_occurred_during_removing_cross_member", "An error occurred during removing cross member") : "An error occurred during removing cross member"));
            }
        });
    }
}




</script>

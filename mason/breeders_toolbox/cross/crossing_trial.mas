<%doc>

=head1 NAME

/breeders_toolbox/cross/crossing_trial.mas - a mason component to display a crossing experiment detail page

=head1

=cut

</%doc>


<%args>
$trial_id
$trial_name
$breeding_program_id
$breeding_program_name
$location_id
$location_name
$country_name
$year => undef
$trial_type => undef
$planting_date => undef
$harvest_date => undef
$trial_description => undef
$folder_name => undef
$folder_id => undef
$locations_by_program_json
$trial_owner => undef
</%args>


<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial', 'jstree/dist/jstree', 'CXGN.BreedersToolbox.HTMLSelect', 'moment_min', 'daterangepicker', 'CXGN.BreedersToolbox.Crosses'] &>

<br/>


<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('cross.ui.details_for_name', 'Details for %{name}', {name => $trial_name})) &>

<& /page/detail_page_2_col_section.mas, info_section_collapsed => 0, trial_id => $trial_id, info_section_anchor_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities('Crossing Experiment Details') . '</h4>', info_section_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.crossing_experiment_details', 'Crossing Experiment Details')) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('cross.ui.view_and_edit_basic_information_about_the_experiment', 'View and edit basic information about the experiment.')), buttons_html => '<button class="btn btn-primary btn-sm" id="edit_crossingtrial_details" style="margin:3px">' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.edit_crossing_experiment_details', 'Edit Crossing Experiment Details')) . '</button>', icon_class => "glyphicon glyphicon-dashboard", info_section_id => "crossingtrial_details", trial_name => $trial_name, breeding_program_name => $breeding_program_name, breeding_program_id => $breeding_program_id, location_name => $location_name, country_name => $country_name, year => $year, planting_date => $planting_date, harvest_date => $harvest_date, trial_description => $trial_description, folder_name => $folder_name, folder_id => $folder_id, trial_owner => $trial_owner &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_anchor_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities('Target Numbers of Seeds/Progenies') . '</h4>', info_section_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.target_numbers_of_seeds_progenies', 'Target Numbers of Seeds/Progenies')) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('cross.ui.view_target_numbers_of_seeds_progenies_and_progress_of_crosses', 'View target numbers of seeds/progenies and progress of crosses in this experiment.')), buttons_html => '<button class="btn btn-sm btn-default" style="margin:3px" id ="target_numbers_usage_info">' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.usage_help', 'Usage Help')) . '<span class="glyphicon glyphicon-question-sign"></span></button><button class="btn btn-sm btn-primary" style="margin:3px" id="upload_target_numbers_link">' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.upload_target_numbers', 'Upload Target Numbers')) . '</button><button class="btn btn-sm btn-primary" style="margin:3px" id="record_target_numbers_using_lists">' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.using_lists_to_record_target_numbers', 'Using Lists to Record Target Numbers')) . '</button>', icon_class => "glyphicon glyphicon-record", info_section_id => "target_numbers_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_anchor_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities('Manage Intercross') . '</h4>', info_section_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.manage_intercross', 'Manage Intercross')) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('cross.ui.download_parents_and_wishlist_files_upload_export_file', 'Download parents and wishlist files. Upload export file.')), buttons_html => '<button class="btn btn-sm btn-default" style="margin:3px" id="download_intercross_parents">' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.download_parents_file', 'Download Parents File')) . '</button><button class="btn btn-sm btn-default" style="margin:3px" id="download_intercross_wishlist">' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.download_wishlist_file', 'Download Wishlist File')) . '</button><button class="btn btn-sm btn-primary" style="margin:3px" id="upload_intercross_file_link">' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.upload_intercross_file', 'Upload Intercross File')) . '</button>', icon_class => "glyphicon glyphicon-sort", info_section_id => "intercross_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_anchor_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities('Crosses in this experiment') . '</h4>', info_section_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.crosses_in_this_experiment', 'Crosses in this experiment')) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('cross.ui.view_cross_unique_ids_cross_combination_cross_type_parents_in_', 'View cross unique ids, cross combination, cross type, parents in this experiment.')), buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="crossing_experiment_barcode">' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.generate_barcode_labels', 'Generate Barcode Labels')) . '</button>', icon_class => "glyphicon glyphicon-list-alt", info_section_id => "crosses_in_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_anchor_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities('Additional Parent Info') . '</h4>', info_section_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.additional_parent_info', 'Additional Parent Info')) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('cross.ui.view_additional_female_and_male_parent_info_of_crosses_in_this', 'View additional female and male parent info of crosses in this experiment.')), buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_additional_info">' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.upload_additional_parent_info_of_existing_crosses', 'Upload Additional Parent Info of Existing Crosses')) . '</button>', icon_class => "glyphicon glyphicon-pencil", info_section_id => "additional_info_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_anchor_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities('Field Crossing Data') . '</h4>', info_section_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.field_crossing_data', 'Field Crossing Data')) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('cross.ui.view_crossing_details_e_g_pollination_date_number_of_flowers_n', 'View crossing details (e.g., pollination date, number of flowers, number of seeds)')), buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" name="upload_cross_info">' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.upload_field_crossing_data_of_existing_crosses', 'Upload Field Crossing Data of Existing Crosses')) . '</button>', icon_class => "glyphicon glyphicon-equalizer", info_section_id => "cross_properties_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, locations_by_program_json => $locations_by_program_json, info_section_anchor_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities('Seedlot Info') . '</h4>', info_section_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.seedlot_info', 'Seedlot Info')) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('cross.ui.view_seedlots_derived_from_this_crossing_experiment', 'View seedlots derived from this crossing experiment')), buttons_html => '<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_seedlots_from_crosses">' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.upload_seedlots_harvested_from_crosses', 'Upload Seedlots Harvested From Crosses')) . '</button>', icon_class => "glyphicon glyphicon-retweet", info_section_id => "seedlots_from_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_anchor_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities('Progenies and Family Names') . '</h4>', info_section_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.progenies_and_family_names', 'Progenies and Family Names')) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('cross.ui.view_number_of_progenies_and_family_names', 'View number of progenies and family names')), icon_class => "glyphicon glyphicon-random", info_section_id => "progenies_in_crossingtrial_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_anchor_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities('Trial Linkage') . '</h4>', info_section_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.trial_linkage', 'Trial Linkage')) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('cross.ui.view_field_trial_s_that_are_part_of_this_crossing_experiment', 'View field trial(s) that are part of this crossing experiment')), icon_class => "glyphicon glyphicon-link", info_section_id => "crossing_experiment_and_trial_linkage_section" &>
<& /page/detail_page_2_col_section.mas, info_section_collapsed => 1, trial_id => $trial_id, info_section_anchor_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities('Delete Crossing Experiment or Crosses') . '</h4>', info_section_title => '<h4 style=\'display:inline\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.delete_crossing_experiment_or_crosses', 'Delete Crossing Experiment or Crosses')) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p('cross.ui.delete_crossing_experiment_or_crosses_in_this_experiment', 'Delete crossing experiment or crosses in this experiment.')), icon_class => "glyphicon glyphicon-trash", info_section_id => "crossing_experiment_deletion_section" &>

<& /breeders_toolbox/folder/folder_set.mas, project_type => 'crossing_experiment', breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name, trial_id => $trial_id, trial_name =>$trial_name &>
<& /breeders_toolbox/folder/folder_new.mas, project_type => 'crossing_experiment',, breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name &>
<& /breeders_toolbox/cross/edit_crossingtrial_details_dialog.mas, trial_name => $trial_name, breeding_program_id => $breeding_program_id, location_id => $location_id, year => $year, planting_date => $planting_date, harvest_date => $harvest_date, trial_description => $trial_description &>
<& /breeders_toolbox/cross/upload_update_crosses.mas &>
<& /breeders_toolbox/cross/upload_crossingtrial_seedlots_dialog.mas, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, locations_by_program_json => $locations_by_program_json&>
<& /breeders_toolbox/trial/generate_trial_barcode.mas, identifier => ''."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", trial_stock_type => '' &>
<& /breeders_toolbox/cross/upload_crosses_dialogs.mas, trial_id => $trial_id, trial_name => $trial_name, breeding_program_id => $breeding_program_id &>
<& /breeders_toolbox/cross/intercross_file_upload.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/cross/intercross_parents_download.mas, trial_id => $trial_id &>
<& /breeders_toolbox/cross/intercross_wishlist_download.mas, trial_id => $trial_id &>
<& /breeders_toolbox/cross/target_numbers_upload.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/cross/target_numbers_using_lists.mas, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/cross/target_numbers_usage_info_dialog.mas &>

<div id="trialIDDiv" class="trialIDDivClass" style="display:none;">
% print $trial_id;
</div>

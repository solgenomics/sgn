<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>


<div class="modal fade" id="intercross_parents_download_dialog" name="intercross_parents_download_dialog" tabindex="-1" role="dialog" aria-labelledby="intercrossParentsDownloaddialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="intercrossParentsDownloaddialog"><% $c->i18n->p("cross.forms.download_intercross_parents_file", "Download Intercross Parents File") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-11">
                            <&| /page/explanation.mas, title=>HTML::Entities::encode_entities($c->i18n->p("cross.forms.file_information", "File Information")) &>
                                <p>
                                    <b><% $c->i18n->p("cross.forms.file_information", "File Information") |h %></b>
                                    <br>
                                    <a id="intercross_parents_file_info"><% $c->i18n->p("cross.forms.intercross_parents", "Intercross Parents") |h %></a>
                                    <br>
                                </p>
                            </&>
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-sm-3"><% $c->i18n->p("cross.forms.female_parents.825c42d", "Female parents:") |h %></label>
                                    <div class="col-sm-7" >
                                        <div class="input-group">
                                            <select class="form-control" id="female_parents_list_select"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-sm-3"><% $c->i18n->p("cross.forms.male_parents.ec42ef3", "Male parents:") |h %></label>
                                    <div class="col-sm-7" >
                                        <div class="input-group">
                                            <select class="form-control" id="male_parents_list_select"></select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="download_intercross_parents_submit" type="button" class="btn btn-primary" ><% $c->i18n->p("global.est.download", "Download") |h %></button>
                <input type="hidden" id="intercross_parents_download_token" name="intercross_parents_download_token"/>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="intercross_parents_download_message" name="intercross_parents_download_message" tabindex="-1" role="dialog" aria-labelledby="intercrossParentsDownloadMessage">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="intercrossParentsDownloadMessage"><% $c->i18n->p("cross.forms.intercross_parents_file_created", "Intercross Parents File Created") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("cross.forms.the_intercross_parents_file_was_created_successfully", "The Intercross parents file was created successfully.") |h %>
                    </p>
                    <p>
                        <a id="intercross_parents_download_link"><% $c->i18n->p("cross.forms.download_intercross_parents", "Download Intercross Parents") |h %></a>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="intercross_parents_download_close_button" id="intercross_parents_download_close_button" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="intercross_parents_file_info_dialog" name="intercross_parents_file_info_dialog" tabindex="-1" role="dialog" aria-labelledby="intercrossParentsFileInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="intercrossParentsFileInfoDialog"><% $c->i18n->p("cross.forms.intercross_parents", "Intercross Parents") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>
                        <% $c->i18n->p("cross.forms.names_in_the_list_must_be_uniquenames", "Names in the list must be uniquenames.") |h %>
                    </b>
                    <br>
                        <% $c->i18n->p("cross.forms.intercross_parents_file_is_a_csv_file_csv", "Intercross Parents file is a CSV file (.csv).") |h %>
                    <br>
                        <% $c->i18n->p("cross.forms.the_file_can_be_used_directly_with_intercross_app", "The file can be used directly with Intercross app.") |h %>
                    <br><br>
                    <b>
                        <% $c->i18n->p("cross.ui.header", "Header:") |h %>
                    </b>
                    <br>
                        <% $c->i18n->p("cross.forms.the_first_row_header_contains_the_following", "The first row (header) contains the following:") |h %>
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>codeId</td>
                                <td>sex</td>
                                <td>name</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        <% $c->i18n->p("cross.forms.column_information", "Column Information:") |h %>
                    </b>
                    <ul>
                        <li><b>codeId:</b> <% $c->i18n->p("cross.forms.stock_ids_in_the_database", "stock_ids in the database.") |h %></li>
                        <li><b>sex:</b> <% $c->i18n->p("cross.forms.0_female_1_male", "0 (female), 1 (male)") |h %></li>
                        <li><b>name:</b> <% $c->i18n->p("cross.forms.uniquenames_in_the_database", "uniquenames in the database.") |h %></li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    var crossing_experiment_id = "<% $trial_id %>";
    var lo = new CXGN.List();

    jQuery('#female_parents_list_select').html(lo.listSelect('female_parents_list_select', ['accessions'], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.select_a_list_of_female_parents", "Select a list of female parents") : "Select a list of female parents"), undefined, undefined));
    jQuery('#male_parents_list_select').html(lo.listSelect('male_parents_list_select', ['accessions'], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.select_a_list_of_male_parents", "Select a list of male parents") : "Select a list of male parents"), undefined, undefined));

    jQuery('#download_intercross_parents').click(function(){
        jQuery('#intercross_parents_download_dialog').modal("show");
    });

    jQuery("#intercross_parents_file_info").click(function(){
        jQuery("#intercross_parents_file_info_dialog").modal("show");
    });

    jQuery('#download_intercross_parents_submit').click(function(){

        var female_list_id = jQuery('#female_parents_list_select').val();
        var male_list_id = jQuery('#male_parents_list_select').val();

        if (!female_list_id) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.please_choose_a_list_of_female_parents", "Please choose a list of female parents") : "Please choose a list of female parents"));
            return;
        }

        if (!male_list_id) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.please_choose_a_list_of_male_parents", "Please choose a list of male parents") : "Please choose a list of male parents"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/intercross/create_parents_file',
            dataType: "json",
            type: 'POST',
            data:{
                'female_list_id': female_list_id,
                'male_list_id': male_list_id,
                'crossing_experiment_id': crossing_experiment_id
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                } else {
                    jQuery('#intercross_parents_download_link').attr('href', "/fieldbook/trait_file_download/" + response.file_id);
                    jQuery("#intercross_parents_download_message").modal("show");
                    jQuery('#intercross_parents_download_dialog').modal("hide");
                }
            },
            error: function() {
                jQuery("#working_modal").modal("hide");
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.an_error_occurred_creating_the_parents_file", "An error occurred creating the parents file.") : "An error occurred creating the parents file."));
                jQuery('#intercross_parents_download_dialog').modal("hide");
            },
        });
    });

    jQuery("#intercross_parents_download_close_button").click(function(){
        location.reload();
    });


});


</script>

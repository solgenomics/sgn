    var female_trial_ids_array = [];
    var male_trial_ids_array = [];
    function cross_wishlist_change_trials () {
        var female_trial_ids = jQuery('#cross_wishlist_female_trial_id').val();
        var female_trial_ids_string = '';
        if ( jQuery.isArray(female_trial_ids) ) {
            female_trial_ids_array = female_trial_ids;
            trial_ids_string = female_trial_ids.join();
        } else {
            female_trial_ids_array = [female_trial_ids];
            female_trial_ids_string = female_trial_ids;
        }

        let ona_form_name = jQuery("#cross_wishlist_availabe_odk_crossing_forms option:selected").text();
        let checkName = "MultiParental";

        jQuery.ajax({
            url: '/ajax/breeders/trial/'+female_trial_ids_array[0]+'/location',
            success: function(response) {
                //console.log(response);
                var cross_wishlist_name;
                if ('<% $c->config->{odk_crossing_data_test_form_name} %>' == jQuery("#cross_wishlist_availabe_odk_crossing_forms option:selected").text()){
                    cross_wishlist_name = 'cross_wishlist_test.csv';
                } else if (ona_form_name.includes(checkName)) {
                    cross_wishlist_name = 'cross_wishlist_'+ona_form_name+'.csv';
                } else if ('<% $c->config->{odk_crossing_data_separate_wishlist_by_location} %>' == '1') {
                    cross_wishlist_name = 'cross_wishlist_'+response.location[1]+'.csv'
                } else {
                    cross_wishlist_name = 'cross_wishlist_<% $c->config->{project_name} %>.csv';
                }
                jQuery('#cross_wishlist_trial_select_no_list_cross_wishlist_name_div').html('<input type="text" class="form-control" disabled value="'+cross_wishlist_name+'" />');
            },
            error: function(response) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.an_error_occurred_getting_trial_location", "An error occurred getting trial location") : "An error occurred getting trial location"));
            }
        });

        get_select_box('stocks', 'cross_wishlist_female_accession_select_div', { 'name' : 'cross_wishlist_female_accession_ids', 'id' : 'cross_wishlist_female_accession_ids', 'size' : 7, 'stock_type_name':'accession', 'trial_id_list':female_trial_ids_array, 'names_as_select':1 });
    };


<div class="modal fade" id="upload_wishlist_spreadsheet_info_dialog" name="upload_wishlist_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadWishlistInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadWishlistInfoDialog"><% $c->i18n->p("cross.ui.template_information.bf8c643", "Template Information") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>
                        <% $c->i18n->p("cross.forms.cross_wishlist_may_be_uploaded_in_an_excel_file", "Cross wishlist may be uploaded in an Excel file (.xls or .xlsx)") |h %>
                    </b>
                    <br>
                    <b>
                        <% $c->i18n->p("cross.ui.header", "Header:") |h %>
                    </b>
                    <br>
                        <% $c->i18n->p("seedlots.ui.the_first_row_header_must_contain_the_following", "The first row (header) must contain the following:") |h %>
                    <br>

                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>female_accession</td>
                                <td>male_accession</td>
                                <td>priority</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        <% $c->i18n->p("cross.ui.required_columns", "Required columns:") |h %>
                    </b>
                    <ul>
                        <li><b>female_accession</b> <% $c->i18n->p("cross.forms.accession_names_must_exist_as", "(accession names must exist as") |h %> <b>uniquenames</b> <% $c->i18n->p("cross.forms.in_the_database_and_are_in_the_selected_female", "in the database and are in the selected female trial. Wishlist will include all of the female plots in the trial.)") |h %></li>
                        <li><b>male_accession</b> <% $c->i18n->p("cross.forms.accession_names_must_exist_as", "(accession names must exist as") |h %> <b>uniquenames</b> <% $c->i18n->p("cross.forms.in_the_database", "in the database)") |h %></li>
                        <li><b>priority</b> <% $c->i18n->p("cross.forms.1_is_the_most_important", "(1 is the most important)") |h %> </li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

var lo = new CXGN.List();

function draw_cross_grid(female_accessions, male_accessions){
    console.log("draw cross grid");
    var cross_grid_html = ("<h3>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.set_cross_priorities_1_is_highest_and_60_is", "Set Cross Priorities: 1 is highest and 60 is lowest") : "Set Cross Priorities: 1 is highest and 60 is lowest")).html() + "</h3><h4>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.female_accessions_are_in_first_column_and_male_accessions", "Female Accessions Are in First Column and Male Accessions Are in Header") : "Female Accessions Are in First Column and Male Accessions Are in Header")).html() + "</h4><table class=\"table table-bordered\"><thead><tr><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.female_accessions", "Female Accessions") : "Female Accessions")).html() + "</th>");
    for(var i=0; i<male_accessions.length; i++){
        cross_grid_html = cross_grid_html + '<th>' + male_accessions[i] + '</th>';
    }
    cross_grid_html = cross_grid_html + '</tr></thead><tbody>';
    for(var i=0; i<female_accessions.length; i++){
        cross_grid_html = cross_grid_html + '<tr><td>' + female_accessions[i] + '</td>';
        for(var j=0; j<male_accessions.length; j++){
            cross_grid_html = cross_grid_html + '<td><input type="text" name="cross_wishlist_cross_grid_inputs" class="form-control" data-female="'+female_accessions[i]+'" data-male="'+male_accessions[j]+'"/></td>';
        }
        cross_grid_html = cross_grid_html + '</tr>';
    }
    cross_grid_html = cross_grid_html + '</tbody></table>';
    jQuery('#cross_wishlist_cross_grid_div').html(cross_grid_html);
}

jQuery(document).ready(function($) {

    jQuery('#show_cross_wishlists_select_submits').click(function(){
        jQuery('#show_cross_wishlists_response_dialog').modal('show');

        jQuery.ajax({
            url: '/ajax/cross/list_cross_wishlists',
            dataType:'json',
            beforeSend: function() {
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                //console.log(response);
                jQuery('#working_modal').modal('hide');
                var html = '';
                if(response.success){
                    html += ("<table class='table table-bordered table-hover'><thead><tr><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.file", "File") : "File")).html() + "</th><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.updated_by", "Updated By") : "Updated By")).html() + "</th><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.file_dump_share_files.date", "Date") : "Date")).html() + "</th></tr></thead><tbody>");
                    for(var i=0; i<response.files.length; i++){
                        html += "<tr><td><a href='/breeders/phenotyping/download/"+response.files[i][0]+"' >"+response.files[i][1]+"</a></td><td><a href='/solpeople/personal-info.pl?sp_person_id="+response.files[i][6]+"' >"+response.files[i][7]+" "+response.files[i][8]+"</a></td><td>"+response.files[i][5]+"</td></tr>";
                    }
                    html += "</tbody></table>";
                } else {
                    html = 'Something went wrong here.'
                }
                jQuery('#show_cross_wishlists_response_div').html(html);
            },
            error: function(response) {
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.an_error_occurred_getting_cross_wishlists", "An error occurred getting cross wishlists") : "An error occurred getting cross wishlists"));
            }
        });

    });

    jQuery("#create_cross_wishlist").click(function() {
        jQuery("#create_cross_wishlist_dialog").modal("show");
        jQuery("#female_accession_list_div").html(lo.listSelect('female_accession_list_div', ["accessions"], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.please_select_list_with_60_accessions", "Please select list with < 60 accessions") : "Please select list with < 60 accessions"), undefined, undefined ));
        jQuery("#male_accession_list_div").html(lo.listSelect('male_accession_list_div', ["accessions"], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.please_select_list_with_60_accessions", "Please select list with < 60 accessions") : "Please select list with < 60 accessions"), undefined, undefined ));
        var female_accessions;
        var male_accessions
        if (jQuery('#female_accession_list_div_list_select').val() != '' && jQuery('#male_accession_list_div_list_select').val() != '' ) {
            female_accessions = lo.getList(jQuery('#female_accession_list_div_list_select').val());
            male_accessions = lo.getList(jQuery('#male_accession_list_div_list_select').val());
        }
        jQuery.ajax ({
            url : '/ajax/odk/get_crossing_available_forms',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response){
                console.log(response);
                jQuery("#working_modal").modal("hide");

                if (response.error){
                    alert(response.error);
                }
                if (response.success){


                    jQuery.ajax ({
                        url : '/ajax/odk/get_crossing_saved_ona_forms',
                        success: function(response_forms){
                            console.log(response_forms);

                            if (response_forms.error){
                                alert(response.error);
                            }
                            if (response_forms.success){

                                var form_dropdown_select_html = '<select class="form-control" id="cross_wishlist_availabe_odk_crossing_forms"><option value="">Not Using ONA</option>';
                                var allowed_forms = response_forms.odk_ona_forms;
                                allowed_forms.push('<% $c->config->{odk_crossing_data_test_form_name} %>');
                                for(var i=0; i<response.forms.length; i++){
                                    if (jQuery.inArray(response.forms[i].id_string, allowed_forms) != -1){
                                        form_dropdown_select_html = form_dropdown_select_html + '<option value="'+response.forms[i].id+'">'+response.forms[i].id_string+'</option>';
                                    }
                                }
                                form_dropdown_select_html = form_dropdown_select_html + '</select>';
                                jQuery('#cross_wishlist_create_select_form_id_div').html(form_dropdown_select_html);

                            }
                        },
                        error: function(response_forms){
                            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.error_retrieving_saved_odk_ona_forms", "Error retrieving saved ODK ONA forms") : "Error retrieving saved ODK ONA forms"));
                        }
                    });

                }
            },
            error: function(response){
                jQuery("#working_modal").modal("hide");
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.error_retrieving_available_odk_crossing_forms", "Error retrieving available ODK crossing forms") : "Error retrieving available ODK crossing forms"));
            }
        });

        if (jQuery('#female_accession_list_div_list_select').val() != '' && jQuery('#male_accession_list_div_list_select').val() != '' ) {
            draw_cross_grid(female_accessions, male_accessions);
        }
    });


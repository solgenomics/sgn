    jQuery(document).on('change', '#male_accession_list_div_list_select', function(){
        if (jQuery('#female_accession_list_div_list_select').val() != '' && jQuery('#male_accession_list_div_list_select').val() != '' ) {
            var female_accessions = lo.getList(jQuery('#female_accession_list_div_list_select').val());
            var male_accessions = lo.getList(jQuery('#male_accession_list_div_list_select').val());
            var female_accession_list_id = $('#female_accession_list_div_list_select').val();
            var male_accession_list_id = $('#male_accession_list_div_list_select').val();
            var female_trial_id = jQuery('#cross_wishlist_list_female_trial_id').val();
            if (! lo.legacy_validate(female_accession_list_id, 'accessions', true)) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.the_female_accession_list_contains_elements_that_are_not", "The female accession list contains elements that are not accessions.") : "The female accession list contains elements that are not accessions."));
                return;
            }
            if (! lo.legacy_validate(male_accession_list_id, 'accessions', true)) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.the_male_accession_list_contains_elements_that_are_not", "The male accession list contains elements that are not accessions.") : "The male accession list contains elements that are not accessions."));
                return;
            }

            check_trial_accessions(female_trial_id, female_accession_list_id, female_accessions, male_accessions);
        }
    });


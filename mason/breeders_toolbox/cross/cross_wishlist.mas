
<style>
@media (min-width: 768px) {
  .modal-xl {
    width: 90%;
   max-width:1200px;
  }
}
</style>

<div class="modal fade" id="create_cross_wishlist_dialog" name="create_cross_wishlist_dialog" tabindex="-1" role="dialog" aria-labelledby="createCrossWishlistDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="createCrossWishlistDialog"><% $c->i18n->p("cross.forms.create_cross_wishlist", "Create Cross Wishlist") |h %></h4>
            </div>

            <div class="modal-body">
                <div class="container-fluid">
                    <div class="well">
                        <form class="form-horizontal" id="cross_wishlist_create_select_form_id" name="cross_wishlist_create_select_form_id">
                            <div class="form-group">
                                <label class="col-sm-4 control-label"><% $c->i18n->p("cross.forms.select_an_odk_form_on_ona", "Select An ODK Form on ONA:") |h %> </label>
                                <div class="col-sm-8" >
                                    <div id="cross_wishlist_create_select_form_id_div"><% $c->i18n->p("trial.card.status.loading", "LOADING...") |h %></div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <ul class="nav nav-pills nav-justified" id="cross_wishlist_tab_select">
                        <li id="cross_wishlist_list_tab"><a data-toggle="tab" href="#with_lists"><% $c->i18n->p("cross.forms.using_accession_lists", "Using Accession Lists") |h %></a></li>
                        <li class="active" id="cross_wishlist_no_list_tab"><a data-toggle="tab" href="#not_with_lists"><% $c->i18n->p("cross.forms.using_crossing_blocks", "Using Crossing Blocks") |h %></a></li>
                        <li id="cross_wishlist_upload_tab"><a data-toggle="tab" href="#upload_wishlist"><% $c->i18n->p("cross.forms.uploading_cross_combinations", "Uploading Cross Combinations") |h %></a></li>
                    </ul>

                    <div class="tab-content">

                        <div id="with_lists" class="tab-pane fade">
                            <hr>
                            <form class="form-horizontal" >
                                <div class="form-group" style="display:none" <!-- location name is coming from the trial they select --> >
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("cross.forms.location_name_optional", "Location Name (Optional):") |h %> </label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_location_select_list_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("cross.forms.female_s_trial_name", "Female's Trial Name:") |h %> </label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_female_trial_select_list_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("cross.forms.male_s_trial_name", "Male's Trial Name:") |h %> </label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_male_trial_select_list_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="well well-sm">
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label"><% $c->i18n->p("cross.forms.cross_plan_will_be_added_to_the_cross_wishlist", "Cross plan will be added to the cross wishlist named:") |h %> </label>
                                        <div class="col-sm-6" >
                                            <div id="cross_wishlist_trial_select_list_cross_wishlist_name_div">
                                                <input class="form-control" type="text" disabled value="Please Select a Trial First" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("cross.forms.female_accession_list", "Female Accession List:") |h %> </label>
                                    <div class="col-sm-9" id="female_accession_list_div" name="female_accession_list_div">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("cross.forms.male_accession_list", "Male Accession List:") |h %> </label>
                                    <div class="col-sm-9" id="male_accession_list_div" name="male_accession_list_div">
                                    </div>
                                </div>
                            </form>
                            <br/>
                            <div id="cross_wishlist_cross_grid_div"></div>
                        </div>

                        <div id="not_with_lists" class="tab-pane fade in active">
                            <hr>

                            <form class="form-horizontal" >
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("cross.forms.female_s_trial_name", "Female's Trial Name:") |h %> </label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_female_trial_select_no_list_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("cross.forms.male_s_trial_name", "Male's Trial Name:") |h %> </label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_male_trial_select_no_list_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="well well-sm">
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label"><% $c->i18n->p("cross.forms.cross_plan_will_be_added_to_the_cross_wishlist", "Cross plan will be added to the cross wishlist named:") |h %> </label>
                                        <div class="col-sm-6" >
                                            <div id="cross_wishlist_trial_select_no_list_cross_wishlist_name_div">
                                                <input class="form-control" type="text" disabled value="Please Select a Trial First" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("cross.forms.female_accession_name_s", "Female Accession Name(s):") |h %></label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_female_accession_select_div">
                                            <p><% $c->i18n->p("cross.forms.first_select_a_trial", "First Select A Trial") |h %></p>
                                        </div>
                                    </div>
                                </div>
                                <div id ="cross_wishlist_male_parent_div">
                                </div>
                            </form>
                        </div>

                        <div id="upload_wishlist" class="tab-pane fade">
                            <hr>
                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_wishlist_form" name="upload_wishlist_form">

                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("cross.forms.female_s_trial_name", "Female's Trial Name:") |h %> </label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_female_trial_select_upload_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p("cross.forms.male_s_trial_name", "Male's Trial Name:") |h %> </label>
                                    <div class="col-sm-9" >
                                        <div id="cross_wishlist_male_trial_select_upload_div">
                                        </div>
                                    </div>
                                </div>
                                <div class="well well-sm">
                                    <div class="form-group">
                                        <label class="col-sm-6 control-label"><% $c->i18n->p("cross.forms.cross_plan_will_be_added_to_the_cross_wishlist", "Cross plan will be added to the cross wishlist named:") |h %> </label>
                                        <div class="col-sm-6" >
                                            <div id="cross_wishlist_trial_select_upload_cross_wishlist_name_div">
                                                <input class="form-control" type="text" disabled value="Please Select a Trial First" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="well well-sm">
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <&| /page/explanation.mas, title=>HTML::Entities::encode_entities($c->i18n->p("cross.ui.template_information.2b5757e", "Template information")) &>
                                                <p>
                                                    <b><% $c->i18n->p("cross.ui.file_format_information", "File format information") |h %></b>
                                                    <br>
                                                    <a id="wishlist_format"><% $c->i18n->p("cross.ui.spreadsheet_format.2b7e73c", "Spreadsheet format") |h %></a>
                                                </p>
                                            </&>
                                        </div>
                                        <div class="col-sm-8">
                                            <br/>
                                            <div class="panel panel-default">
                                                <div class="panel-body">
                                                    <div class="form-group">
                                                        <label class="col-sm-6 control-label"><% $c->i18n->p("trial.soil_upload.file_label", "Select an XLS File:") |h %> </label>
                                                        <div class="col-sm-6">
                                                            <input type="file" name="wishlist_file" id="wishlist_file" encoding="multipart/form-data" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div id="wishlist_lists_footer">
                <div class="modal-footer">
                    <button class="btn btn-info" id="show_cross_wishlists_select_submits" name="show_cross_wishlists_select_submits"><% $c->i18n->p("cross.forms.available_cross_wishlist_s_for_odk_use", "Available Cross Wishlist(s) for ODK Use") |h %></button>
                    <button class="btn btn-primary" id="cross_wishlist_submit" name="cross_wishlist_submits"><% $c->i18n->p("global.annotation_search_result.next", "Next") |h %></button>
                    <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
                </div>
            </div>
            <div id="wishlist_upload_footer" style="display:none">
                <div class="modal-footer">
                    <button class="btn btn-info" id="upload_show_cross_wishlists_select_submits" name="upload_show_cross_wishlists_select_submits"><% $c->i18n->p("cross.forms.available_cross_wishlist_s_for_odk_use", "Available Cross Wishlist(s) for ODK Use") |h %></button>
                    <button class="btn btn-primary" id="wishlist_upload_submit" name="wishlist_upload_submit"><% $c->i18n->p("cross.ui.upload_file.3ee3b0b", "Upload File") |h %></button>
                    <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
                </div>
            </div>
        </div>
    </div>
</div>


<%args>

</%args>


<div class="modal fade" id="update_crossinfo_dialog" name="update_crossinfo_dialog" tabindex="-1" role="dialog" aria-labelledby="updateCrossinfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updateCrossinfoDialog"><% $c->i18n->p("cross.forms.upload_cross_info_of_existing_crosses", "Upload Cross Info of Existing Crosses") |h %> </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <label class="col-sm-12 control-label"><% $c->i18n->p("cross.forms.if_you_are_uploading_an_intercross_file_please_use", "If you are uploading an Intercross file, please use manage Intercross section") |h %></label>
                    <br>
                    <&| /page/explanation.mas, title=>HTML::Entities::encode_entities($c->i18n->p("cross.ui.template_information.bf8c643", "Template Information")) &>
                        <p>
                            <b><% $c->i18n->p("cross.forms.file_format_information", "File Format Information") |h %></b>
                            <br>
                            <a id="update_crossinfo_spreadsheet_format"><% $c->i18n->p("cross.ui.spreadsheet_format.f1285ec", "Spreadsheet Format") |h %></a>
                            <br>
                        </p>
                    </&>
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_crossinfo_form" name="upload_crossinfo_form">
                        <div class="form-group">
                            <label class="col-sm-2 control-label"><% $c->i18n->p("cross.ui.upload_file.9798051", "Upload File:") |h %> </label>
                                <div class="col-sm-10">
                                    <input type="file" name="crossinfo_upload_file" id="crossinfo_upload_file" encoding="multipart/form-data" />
                                </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="update_crossinfo_submit" id="update_crossinfo_submit"><% $c->i18n->p("cross.ui.upload_file.3ee3b0b", "Upload File") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_crossinfo_error_display" name="upload_crossinfo_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadCrossinfoErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCrossinfoErrorDialog"><% $c->i18n->p("cross.forms.upload_cross_info_file_error", "Upload Cross Info File Error") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="update_crossinfo_spreadsheet_info_dialog" name="update_crossinfo_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadCrossinfoInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCrossinfoInfoDialog"><% $c->i18n->p("cross.ui.template_information.bf8c643", "Template Information") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>
                        <% $c->i18n->p("cross.forms.cross_info_of_existing_crosses_may_be_uploaded_in", "Cross info of existing crosses may be uploaded in an Excel file (.xls or .xlsx)") |h %>
                    </b>
                    <br>
                    <b>
                        <% $c->i18n->p("cross.ui.header", "Header:") |h %>
                    </b>
                    <br>
                        <% $c->i18n->p("seedlots.ui.the_first_row_header_must_contain_the_following", "The first row (header) must contain the following:") |h %>
                    <br>

                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>cross_unique_id</td>
                                <td><% $c->i18n->p("cross.forms.at_least_one_column_of_cross_info_listed_below", "At least one column of cross info listed below (please use exact column header as shown)") |h %></td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        <% $c->i18n->p("cross.ui.required_columns", "Required columns:") |h %>
                    </b>
                    <ul>
                        <li><b>cross_unique_id:</b> <% $c->i18n->p("cross.forms.must_exist_in_the_database_must_not_have_duplicate", "Must exist in the database, must not have duplicate cross unique id in the same upload file.") |h %>
                        <li><b><% $c->i18n->p("cross.forms.at_least_one_of_the_following_columns", "At least one of the following columns:") |h %></b> <% $c->i18n->p("cross.forms.you_can_upload_different_types_of_cross_info_by", "You can upload different types of cross info by selecting corresponding column headers. All of cross info of the same cross unique id must be in a single row. Dates must be in the") |h %> <b>YYYY/MM/DD</b> <% $c->i18n->p("cross.forms.format", "format.") |h %></li>
                        <br>
% my $cross_properties = $c->config->{cross_properties};
% my @column_header = split ',',$cross_properties;
% foreach my $column_header(@column_header){
                        <%$column_header%>
                        <br>
%}
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cross_info_saved_dialog_message" name="cross_info_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="crossInfoSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="crossInfoSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("cross.forms.the_cross_information_was_saved_successfully", "The cross information was saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_cross_info_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="upload_additional_info_dialog" name="upload_additional_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadAdditionalInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadAdditionalInfoDialog"><% $c->i18n->p("cross.ui.upload_additional_parent_info_of_existing_crosses", "Upload Additional Parent Info of Existing Crosses") |h %> </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>HTML::Entities::encode_entities($c->i18n->p("cross.ui.template_information.bf8c643", "Template Information")) &>
                        <p>
                            <b><% $c->i18n->p("cross.forms.file_format_information", "File Format Information") |h %></b>
                            <br>
                            <a id="upload_additional_info_format"><% $c->i18n->p("cross.ui.spreadsheet_format.f1285ec", "Spreadsheet Format") |h %></a>
                            <br>
                        </p>
                    </&>
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_additional_info_form" name="upload_additional_info_form">
                        <div class="form-group">
                            <label class="col-sm-2 control-label"><% $c->i18n->p("cross.ui.upload_file.9798051", "Upload File:") |h %> </label>
                                <div class="col-sm-10">
                                    <input type="file" name="additional_info_upload_file" id="additional_info_upload_file" encoding="multipart/form-data" />
                                </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="upload_additional_info_submit" id="upload_additional_info_submit"><% $c->i18n->p("cross.ui.upload_file.3ee3b0b", "Upload File") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_additional_info_format_dialog" name="upload_additional_info_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadAdditionalInfoFormatDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadAdditionalInfoFormatDialog"><% $c->i18n->p("cross.ui.template_information.bf8c643", "Template Information") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>
                        <% $c->i18n->p("cross.forms.additional_parent_info_of_existing_crosses_may_be_uploaded", "Additional Parent Info of existing crosses may be uploaded in an Excel file (.xls or .xlsx)") |h %>
                    </b>
                    <br>
                    <b>
                        <% $c->i18n->p("cross.ui.header", "Header:") |h %>
                    </b>
                    <br>
                        <% $c->i18n->p("seedlots.ui.the_first_row_header_must_contain_the_following", "The first row (header) must contain the following:") |h %>
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>cross_unique_id</td>
                                <td><% $c->i18n->p("cross.forms.at_least_one_column_of_parent_info_listed_below", "At least one column of parent info listed below (please use exact column header as shown)") |h %></td>
                            </tr>
                        </tbody>
                    </table>
                    <b>
                        <% $c->i18n->p("cross.ui.required_columns", "Required columns:") |h %>
                    </b>
                    <ul>
                        <li><b>cross_unique_id:</b> <% $c->i18n->p("cross.forms.must_exist_in_the_database_must_not_have_duplicate", "Must exist in the database, must not have duplicate cross unique id in the same upload file.") |h %>
                        <li><b><% $c->i18n->p("cross.forms.at_least_one_of_the_following_columns", "At least one of the following columns:") |h %></b> <% $c->i18n->p("cross.forms.you_can_upload_different_types_of_parent_info_by", "You can upload different types of parent info by selecting corresponding column headers. All of parent info of the same cross unique id must be in a single row. Each field can have several values by using comma-delimited list (e.g. trait_1,trait_2)") |h %></li>
                        <br>
% my $cross_additional_info_string = $c->config->{cross_additional_info};
% my @additional_info_headers = split ',',$cross_additional_info_string;
% foreach my $info_header(@additional_info_headers){
                        <%$info_header%>
                        <br>
%}
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery('[name="upload_cross_info"]').click(function(){
        jQuery("#update_crossinfo_spreadsheet_format").click(function(){
            jQuery("#update_crossinfo_spreadsheet_info_dialog").modal("show");
        });

        jQuery("#update_crossinfo_dialog").modal("show");
    });

    jQuery("#update_crossinfo_submit").click(function(){
        var uploadFile = jQuery("#crossinfo_upload_file").val();
        jQuery('#upload_crossinfo_form').attr("action", "/ajax/cross/upload_info");
        if (uploadFile === ''){
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.please_select_a_file", "Please select a file") : "Please select a file"));
            return;
        }
        jQuery("#upload_crossinfo_form").submit();
        jQuery("#update_crossinfo_dialog").modal("hide");
    });

    jQuery('#upload_crossinfo_form').iframePostForm({
        json: true,
        post: function(){
            jQuery("#working_modal").modal("show");
        },
        complete: function(response){
            jQuery("#working_modal").modal("hide");
            if (response.error_string){
                jQuery("#upload_crossinfo_error_display tbody").html('');
                jQuery("#upload_crossinfo_error_display tbody").append(response.error_string);
                jQuery("#upload_crossinfo_error_display").modal("show");
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                jQuery('#cross_info_saved_dialog_message').modal("show");
            }
        }
    });

    jQuery("#dismiss_cross_info_saved_dialog").click(function(){
        location.reload();
    });

    jQuery("#upload_additional_info").click(function(){

        jQuery("#upload_additional_info_format").click(function(){
            jQuery("#upload_additional_info_format_dialog").modal("show");
        });

        jQuery("#upload_additional_info_dialog").modal("show");
    });

    jQuery("#upload_additional_info_submit").click(function(){
        var uploadFile = jQuery("#additional_info_upload_file").val();
        jQuery('#upload_additional_info_form').attr("action", "/ajax/cross/upload_info");
        if (uploadFile === ''){
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.please_select_a_file", "Please select a file") : "Please select a file"));
            return;
        }
        jQuery("#upload_additional_info_form").submit();
        jQuery("#upload_additional_info_dialog").modal("hide");
    });

    jQuery('#upload_additional_info_form').iframePostForm({
        json: true,
        post: function(){
            jQuery("#working_modal").modal("show");
        },
        complete: function(response){
            jQuery("#working_modal").modal("hide");
            if (response.error_string){
                jQuery("#upload_crossinfo_error_display tbody").html('');
                jQuery("#upload_crossinfo_error_display tbody").append(response.error_string);
                jQuery("#upload_crossinfo_error_display").modal("show");
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                jQuery('#cross_info_saved_dialog_message').modal("show");
            }
        }
    });


});

</script>

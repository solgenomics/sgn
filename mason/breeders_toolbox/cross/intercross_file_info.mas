<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<div class="panel panel-default">
    <div class="panel-body">
        <&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p("cross.forms.downloaded_intercross_files_parents_and_wishlist_files", "Downloaded Intercross Files (Parents and Wishlist Files)")), anchor_title => "Downloaded Intercross Files (Parents and Wishlist Files)", is_subsection => 1, collapsible=>1, collapsed=>1 &>
            <table class="table table-hover table-bordered" id="downloaded_intercross_files_table">
            </table>
        </&>
    </div>
</div>
<div class="panel panel-default">
    <div class="panel-body">
        <&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p("cross.forms.uploaded_intercross_files", "Uploaded Intercross Files")), anchor_title => "Uploaded Intercross Files", is_subsection => 1, collapsible=>1, collapsed=>1 &>
            <table class="table table-hover table-bordered" id="uploaded_intercross_files_table">
            </table>
        </&>
    </div>
</div>


<script>

jQuery(document).ready(function(){

jQuery('#intercross_section_onswitch').click(function(){

    jQuery('#downloaded_intercross_files_table').DataTable({
        'autoWidth': false,
        'destroy': true,
        'ajax': { 'url': '/ajax/breeders/trial/<% $trial_id %>/downloaded_intercross_file_metadata' },
        columns: [
            { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search.images.filename", "Filename") : "Filename"), "data": null, "render": function ( data, type, row ) { return row[4]; } },
            { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.create_date", "Create Date") : "Create Date"), "data": null, "render": function ( data, type, row ) { return row[1]; } },
            { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.created_by", "Created By") : "Created By"), "data": null, "render": function ( data, type, row ) { return '<a href="/solpeople/profile/'+row[2]+'">'+row[3]+'</a>'; } },
            { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("file_viewer.ui.type", "File Type") : "File Type"), "data": null, "render": function ( data, type, row ) { return row[6]; } },
            { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.file_dump_share_files.options", "Options") : "Options"), "data": null, "render": function ( data, type, row ) { return '<a href="/breeders/phenotyping/view/'+row[0]+("\">" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_cxgn_dataset.view", "View") : "View")).html() + "</a> | <a href=\"/breeders/phenotyping/download/")+row[0]+("\">" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.est.download", "Download") : "Download")).html() + "</a>"); } },
        ]
    });

    jQuery('#uploaded_intercross_files_table').DataTable({
        'autoWidth': false,
        'destroy': true,
        'ajax': { 'url': '/ajax/breeders/trial/<% $trial_id %>/uploaded_intercross_file_metadata' },
        columns: [
            { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search.images.filename", "Filename") : "Filename"), "data": null, "render": function ( data, type, row ) { return row[4]; } },
            { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.create_date", "Create Date") : "Create Date"), "data": null, "render": function ( data, type, row ) { return row[1]; } },
            { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.created_by", "Created By") : "Created By"), "data": null, "render": function ( data, type, row ) { return '<a href="/solpeople/profile/'+row[2]+'">'+row[3]+'</a>'; } },
            { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("file_viewer.ui.type", "File Type") : "File Type"), "data": null, "render": function ( data, type, row ) { return row[6]; } },
            { title: (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.file_dump_share_files.options", "Options") : "Options"), "data": null, "render": function ( data, type, row ) { return '<a href="/breeders/phenotyping/view/'+row[0]+("\">" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_cxgn_dataset.view", "View") : "View")).html() + "</a> | <a href=\"/breeders/phenotyping/download/")+row[0]+("\">" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.est.download", "Download") : "Download")).html() + "</a>"); } },
        ]
    });


});


});

</script>

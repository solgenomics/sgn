<%once>
use HTML::Entities ();
</%once>

<%args>
$family_id
</%args>

<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<div class = "panel-body">
    <div style="overflow:scroll">
        <table class="table table-hover table-bordered" id="all_progenies">
        </table>
    </div>
    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, anchor_title => 'Add progenies to a List', title => HTML::Entities::encode_entities($c->i18n->p("cross.pages.add_progenies_to_a_list", "Add progenies to a List")), collapsible=>1, collapsed=>1, subtitle=>("<i>" . HTML::Entities::encode_entities($c->i18n->p("cross.pages.adding_progenies_of_this_family_to_a_new_or_exisiting", "Adding progenies of this family to a new or exisiting list")) . "</i>")&>
                <br>
                <div id="progenies_to_new_list" style="display:none"></div>
                <div id="progenies_add_to_list"></div>
            </&>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){
    const family_id = "<%$family_id%>";
    const progenies = jQuery('#all_progenies').DataTable({
        'ajax': '/ajax/family/all_progenies/'+family_id,
        'destroy': true,
        'autoWidth': false,
        columns: [
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.pages.progeny_name", "Progeny Name") : "Progeny Name")).html(), "data": null, "render": function ( data, type, row ) { return "<a href='/stock/"+row.progeny_id+"/view'>"+row.progeny_name+"</a>"; } },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.cross_unique_id.923bfbc", "Cross Unique ID") : "Cross Unique ID")).html(), "data": null, "render": function ( data, type, row ) { return "<a href='/cross/"+row.cross_id+"'>"+row.cross_name+"</a>"; } },
        ],
        "fnInitComplete": function(oSettings, json) {
            //console.log(json);
            if (!isLoggedIn()) {
                jQuery('#progenies_add_to_list').html(("<div class='well well-sm'><h3>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.related_stock.login_lists", "Please login to use lists!") : "Please login to use lists!")).html() + "</h3></div>"));
            } else {
                var html = "";
                for(var i=0; i<json.data.length; i++){
                    html += json.data[i].progeny_name+"\n";
                }
                jQuery("#progenies_to_new_list").html(html);
                addToListMenu("progenies_add_to_list", "progenies_to_new_list", {
                    selectText: true,
                    listType: 'accessions',
                });
            }
        }
    });

});

</script>

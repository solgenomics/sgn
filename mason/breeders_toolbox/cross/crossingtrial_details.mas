<%args>
$trial_id
$trial_name
$breeding_program_name
$breeding_program_id
$location_name
$country_name
$year
$planting_date
$harvest_date
$trial_description
$folder_name
$folder_id
$identifier_prefix
$trial_owner
</%args>


<div class="row">
    <div class="col-sm-8">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b><% $c->i18n->p('cross.ui.crossing_experiment_name.c83dfee', 'Crossing Experiment Name') |h %></b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print '<span class=\'text-danger\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.no_crossing_experiment_name', '[No Crossing Experiment Name]')) . '</span>';
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('cross.ui.breeding_program.2f6b84b', 'Breeding Program') |h %> </b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
%  print "$breeding_program_name";
% }
% else {
%  print '<span class=\'text-danger\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.no_breeding_program', '[No Breeding Program]')) . '</span>';
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('cross.ui.location', 'Location') |h %></b></td>
                <td>
                    <div id="trial_location">
% if ($location_name) {
%  print "$location_name ( $country_name )";
% } else {
%  print '<span class=\'text-danger\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.no_location', '[No Location]')) . '</span>';
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('cross.ui.year.6813944', 'Year') |h %></b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print "$year";
% } else {
%  print '<span class=\'text-danger\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.no_year', '[No Year]')) . '</span>';
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('cross.ui.planting_date', 'Planting Date') |h %></b></td>
                <td>
                    <div id="planting_date">
% if ($planting_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $planting_date %>" ><% $planting_date %></a>
% } else {
%  print '<span class=\'text-danger\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.no_planting_date', '[No Planting Date]')) . '</span>';
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('cross.ui.harvest_date', 'Harvest Date') |h %></b></td>
                <td>
                    <div id="harvest_date">
% if ($harvest_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $harvest_date %>" ><% $harvest_date %></a>
% } else {
%  print '<span class=\'text-danger\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.no_harvest_date', '[No Harvest Date]')) . '</span>';
% }
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p('cross.ui.description.7f85a32', 'Description') |h %></b></td>
                <td>
                    <div id="trial_description">
% if ($trial_description) {
%  print "$trial_description";
% } else {
%  print '<span class=\'text-danger\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.no_description', '[No Description]')) . '</span>';
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('cross.ui.folder', 'Folder') |h %></b></td>
                <td>
                    <span id="trial_folder_div"><a href="/folder/<% $folder_id %>"><% $folder_name %></a></span>
                    <br/><br/>
                    <button class="btn btn-sm btn-default" style="margin:3px" id="new_folder_dialog_link"><% $c->i18n->p('cross.ui.new_folder', 'New Folder') |h %></button> <button class="btn btn-sm btn-default" style="margin:3px" id="open_folder_dialog_link"><% $c->i18n->p('cross.ui.change_folder', 'Change Folder') |h %></button>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p('cross.ui.created_by', 'Created by') |h %></b></td>
                <td>
                    <div id="trial_owner">
% if ($trial_owner) {
%  print "$trial_owner";
% } else {
%  print '<span class=\'text-danger\'>' . HTML::Entities::encode_entities($c->i18n->p('cross.ui.n_a', '[N/A]')) . '</span>';
% }
                    </div>
                </td>
            </tr>
        </table>

    </div>
    <div class="col-sm-4">
        <div class="well well-sm">
            <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
        </div>
    </div>
</div>
<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_new_crosses_link"><% $c->i18n->p('cross.ui.upload_new_crosses', 'Upload New Crosses') |h %></button><a href="/breeders/trial/<% $trial_id %>/download/crosses?format=crossing_experiment_xls&dataLevel=cross" class="btn btn-sm btn-default"><% $c->i18n->p('cross.ui.download_crosses_in_this_crossing_experiment', 'Download Crosses in this Crossing Experiment') |h %></a>

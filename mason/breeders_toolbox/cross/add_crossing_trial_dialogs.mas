<%args>
$programs
$locations
</%args>


<& /util/import_javascript.mas, classes => ['CXGN.BreedersToolbox.Crosses', 'CXGN.TrialTreeFolders'] &>

<div class="modal fade" id="create_crossingtrial_dialog" name="create_crossingtrial_dialog" tabindex="-1" role="dialog" aria-labelledby="createCrossingTrialDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header">
                <button type="reset" class="close" id="add_crossing_experiment_dismiss_button_1" name="add_crossing_experiment_dismiss_button" aria-label="<% $c->i18n->p('cross.ui.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <center><h4 class="modal-title" id="creatCrossingTrial"><% $c->i18n->p('cross.ui.add_new_crossing_experiment', 'Add New Crossing Experiment') |h %></h4></center>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "add_crossing_trial_workflow" &>
                        <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p('cross.ui.intro', 'Intro')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('cross.ui.what_are_crossing_experiments', 'What are crossing experiments?')) &>

                            <p><% $c->i18n->p('cross.ui.crossing_experiments_group_crosses_the_grouping_can_reflect_cr', 'Crossing experiments group crosses. The grouping can reflect crosses done in the same field trial, crosses in a breeding program in a given year, or crosses that have the same breeding objective. This grouping can be used to encapsulate all the crosses done in a crossing block field trial that you have saved in the database (e.g. in Manage Trials your crossing block will appear as a field trial with plots)') |h %></p>
                            <hr>

                            <center>
                                <button id="next_step_add_new_intro" class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p('cross.ui.go_to_next_step', 'Go to Next Step') |h %></button>
                            </center>
                        </&>

                        <form class="form-horizontal" role="form" name="create_crossingtrial_form" id="create_crossingtrial_form">
                            <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p('cross.ui.add_a_crossing_experiment', 'Add a crossing experiment')) &>
                                <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('cross.ui.enter_basic_information_about_the_crossing_experiment', 'Enter basic information about the crossing experiment')) &>
                                    <br/>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-lable"><% $c->i18n->p('cross.ui.crossing_experiment_name.2050c65', 'Crossing Experiment Name:') |h %> </label>
                                        <div class="col-sm-8">
                                            <input class="form-control" type="text" id="crossingtrial_name" name="crossingtrial_name"  />
                                        </div>
                                    </div><br/><br/>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label"><% $c->i18n->p('cross.ui.breeding_program.2c9b17e', 'Breeding Program:') |h %> </label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="crossingtrial_program" name="crossingtrial_program">
                                                <option value=""><% $c->i18n->p('cross.ui.select_breeding_program', 'Select Breeding Program') |h %></option>
<%perl>
foreach my $program (@$programs) {
    if (@$program[3]) {
        print "<option selected=\"selected\" value='".@$program[0]."'>".@$program[1]."</option>";
    } else {
        print "<option value='".@$program[0]."'>".@$program[1]."</option>";
    }
}
</%perl>
                                            </select>
                                        </div>
                                    </div><br/><br/>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label"><% $c->i18n->p('cross.ui.location_of_crossing_experiment', 'Location of crossing experiment:') |h %> </label>
                                        <div class="col-sm-8">
                                            <select class="form-control" id="crossingtrial_location" name="crossingtrial_location">
                                                <option value=""><% $c->i18n->p('cross.ui.select_location', 'Select Location') |h %></option>
<%perl>
    foreach my $location_hashref (@$locations) {
        my $properties = $location_hashref->{'properties'};
        my $program = $properties->{'Program'};
        my $name = $properties->{'Name'};
        print "<option value=\"$name\" data-program=\"$program\">".$name."</option>";
    }
</%perl>
                                            </select>
                                        </div>
                                    </div><br/><br/>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label"><% $c->i18n->p('cross.ui.year.c9410fe', 'Year:') |h %></label>
                                        <div class="col-sm-8">
                                            <div id="crosses_add_project_year" name="crosses_add_project_year" ></div>
                                        </div>
                                    </div><br/><br/>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label"><% $c->i18n->p('cross.ui.description.00d6aa4', 'Description:') |h %></label>
                                        <div class="col-sm-8">
                                            <textarea class="form-control" id="crosses_add_project_description" name="crosses_add_project_description" ></textarea>
                                        </div>
                                    </div>
                                <br/>
                                <br/>
                                <br/>
                                <center>
                                    <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="create_crossingtrial_submit" id="create_crossingtrial_submit"><% $c->i18n->p('cross.ui.submit', 'Submit') |h %></button>
                                </center>
                            </&>
                        </form>

                        <&| /util/workflow.mas:complete, title=> HTML::Entities::encode_entities($c->i18n->p('cross.ui.complete', 'Complete')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('cross.ui.finished_your_crossing_experiment_is_now_in_the_database', 'Finished! Your crossing experiment is now in the database')) &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                <% $c->i18n->p('cross.ui.crossing_experiment_was_added_successfully', 'Crossing experiment was added successfully') |h %>
                            </p>

                            <ul>
                                <li><% $c->i18n->p('cross.ui.you_may_want_to_proceed_to_the_crossing_experiment_detail_page', 'You may want to proceed to the crossing experiment detail page you just created.') |h %></li>
                                <li><% $c->i18n->p('cross.ui.you_can_add_or_upload_crosses_into_your_crossing_experiment_as', 'You can add or upload crosses into your crossing experiment as they become available.') |h %></li>
                                <li><% $c->i18n->p('cross.ui.you_can_add_crossing_information_as_it_becomes_available_e_g_n', 'You can add crossing information as it becomes available (e.g. number of seeds, progeny, etc).') |h %></li>
                            </ul>
                            <br/>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_crossing_experiment_dismiss_button_2" name="add_crossing_experiment_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('cross.ui.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<script>
// Optional locale assets never block the native crossing workflow.
var crossI18n = (window.SGN && window.SGN.i18n) || {
    p: function (context, source, variables) {
        return source.replace(/%\{([A-Za-z0-9_]+)\}/g, function (match, name) {
            return variables && Object.prototype.hasOwnProperty.call(variables, name) ? String(variables[name]) : match;
        });
    },
    np: function (context, one, many, count, variables) {
        return this.p(context, count === 1 ? one : many, variables);
    }
};
function crossHTML(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, function (character) {
        return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[character];
    });
}



jQuery(document).ready(function(){

    var selectedProgram = jQuery('#crossingtrial_program option:selected').text()

    filter_options(selectedProgram, 'program', 'crossingtrial_location');

    jQuery('#crossingtrial_program').change(function() {
        filter_options(jQuery('#crossingtrial_program option:selected').text(), 'program', 'crossingtrial_location');
    });

    jQuery("[name='add_crossing_experiment_dismiss_button']").click(function() {
        jQuery('#create_crossingtrial_dialog').modal('hide');
        jQuery('#crossingtrial_name').val('');
        jQuery('#crossingtrial_program').val('');
        jQuery('#crossingtrial_location').val('');
        jQuery('#crosses_add_project_year').val('');
        jQuery('#crosses_add_project_description').val('');
    });


});

</script>

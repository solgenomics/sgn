<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>


<style>
@media (min-width: 768px) {
    .modal-xl {
        width: 90%;
        max-width:1200px;
    }
}
</style>

<div class="modal fade" id="record_target_numbers_using_lists_dialog" name="record_target_numbers_using_lists_dialog" tabindex="-1" role="dialog" aria-labelledby="recordTargetNumbersUsingListsDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="recordTargetNumbersUsingListsDialog"><% $c->i18n->p("cross.forms.record_target_numbers_of_seeds_and_or_progenies", "Record Target Numbers of Seeds and/or Progenies") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-11">
                            <&| /page/explanation.mas, title=>'' &>
                                <p>
                                    <br>
                                    <a id="target_numbers_list_info"><% $c->i18n->p("cross.forms.list_information", "List Information") |h %>   </a>
                                    <br>
                                </p>
                            </&>
                            <div class="form-horizontal">
                                <div class="form-group">
                                    <label class="control-label col-sm-3"><% $c->i18n->p("cross.forms.female_parents.3c30f9b", "Female Parents:") |h %></label>
                                    <div class="col-sm-7" >
                                        <div class="input-group">
                                            <select class="form-control" id="target_numbers_female_list_select"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="control-label col-sm-3"><% $c->i18n->p("cross.forms.male_parents.45e145f", "Male Parents:") |h %></label>
                                    <div class="col-sm-7" >
                                        <div class="input-group">
                                            <select class="form-control" id="target_numbers_male_list_select"></select>
                                        </div>
                                    </div>
                                </div>
                                <div id ="target_numbers_form_div">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="target_numbers_footer" style="display:none" >
                        <div class="modal-footer">
                            <button class="btn btn-primary" id="target_numbers_submit" name="target_numbers_submit"><% $c->i18n->p("cross.forms.record_target_numbers", "Record Target Numbers") |h %></button>
                            <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="record_target_numbers_message" name="record_target_numbers_message" tabindex="-1" role="dialog" aria-labelledby="recordTargetNumbersMessage">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="recordTargetNumberMessage"><% $c->i18n->p("cross.forms.target_numbers", "Target Numbers") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("cross.forms.the_target_numbers_were_recorded_successfully", "The target numbers were recorded successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="record_target_numbers_close_button" id="record_target_numbers_close_button" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="target_numbers_list_info_dialog" name="target_numbers_list_info_dialog" tabindex="-1" role="dialog" aria-labelledby="targetNumbersListInfoDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("cross.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="targetNumbersListInfoDialog"><% $c->i18n->p("cross.forms.list_information", "List Information") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <h4>
                        <% $c->i18n->p("cross.forms.list_of_female_parents_and_list_of_male_parents", "List of Female Parents and List of Male Parents:") |h %>
                    </h4>
                    <p><% $c->i18n->p("cross.forms.lists_must_be_accessions_list_type_and_all_of", "Lists must be 'accessions' list type and all of the female and male parents in the lists must exist as uniquenames in the database.") |h %></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("cross.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    jQuery('#target_numbers_list_info').click(function(){
        jQuery("#target_numbers_list_info_dialog").modal("show");
    });

    var crossing_experiment_id = "<% $trial_id %>";
    var lo = new CXGN.List();

    jQuery('#target_numbers_female_list_select').html(lo.listSelect('target_numbers_female_list_select', ['accessions'], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.select_a_list_of_female_parents", "Select a list of female parents") : "Select a list of female parents"), undefined, undefined));
    jQuery('#target_numbers_male_list_select').html(lo.listSelect('target_numbers_male_list_select', ['accessions'], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.select_a_list_of_male_parents", "Select a list of male parents") : "Select a list of male parents"), undefined, undefined));

    jQuery('#record_target_numbers_using_lists').click(function(){
        jQuery('#record_target_numbers_using_lists_dialog').modal("show");
    });

    jQuery("#target_numbers_submit_info").click(function(){
        jQuery("#target_numbers_info_dialog").modal("show");
    });

    var female_list_id;
    var male_list_id;
    jQuery("#target_numbers_female_list_select").change(function() {
        female_list_id = jQuery('#target_numbers_female_list_select').val();
        if (female_list_id){
            var female_accession_validation = 1;
            female_accession_validation = lo.legacy_validate(female_list_id, 'uniquenames', true);
            if (female_accession_validation != 1) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.the_female_list_did_not_pass_validation_names_in", "The female list did not pass validation. Names in the list must be uniquenames in the database") : "The female list did not pass validation. Names in the list must be uniquenames in the database"));
                return;
            } else if (female_list_id && male_list_id) {
                target_numbers_form();
            }
        }
    })

    jQuery("#target_numbers_male_list_select").change(function() {
        male_list_id = jQuery('#target_numbers_male_list_select').val();
        if (male_list_id){
            var male_accession_validation = 1;
            male_accession_validation = lo.legacy_validate(male_list_id, 'uniquenames', true);
            if (male_accession_validation != 1) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.the_male_list_did_not_pass_validation_names_in", "The male list did not pass validation. Names in the list must be uniquenames in the database") : "The male list did not pass validation. Names in the list must be uniquenames in the database"));
                return;
            } else if (!female_list_id) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.please_select_female_list", "Please select female list") : "Please select female list"));
                return;
            } else if (female_list_id && male_list_id) {
                target_numbers_form();
            }
        }
    });

    function target_numbers_form () {
        var female_list_id = jQuery('#target_numbers_female_list_select').val();
        var female_list = lo.getList(female_list_id);

        var male_list_id = jQuery('#target_numbers_male_list_select').val();
        var male_list = lo.getList(male_list_id);

        var html = ("<table class=\"table table-bordered\" id=\"target_numbers_male_select_table\"><thead><tr><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.female_parent.ed89c1c", "Female Parent") : "Female Parent")).html() + "</th><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.select_male_parent", "Select Male Parent") : "Select Male Parent")).html() + "</th><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.target_numbers_of_seeds_and_or_progenies.2826583", "Target Numbers of Seeds and/or Progenies") : "Target Numbers of Seeds and/or Progenies")).html() + "</th></tr></thead><tbody>");
        for(var i=0; i<female_list.length; i++){
            html = html + '<tr><td>' + female_list[i] + '</td><td><div name="target_numbers_male_selects" id="target_numbers_male_select_' +i+ '"></div></td><td><span id="target_numbers_male_accession_id_'+ i +'_info" data-related="'+encodeURI(female_list[i])+("\" >" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.select_male_s", "Select Male(s)") : "Select Male(s)")).html() + "</span></td></tr>");
        };
        html = html + '</tbody></table>';

        jQuery('#target_numbers_form_div').html(html);

        var target_numbers_male_parents = jQuery('#target_numbers_male_select_table')
            .find("div")
            .map(function() { return this.id; })
            .get();
        for(var i=0; i<target_numbers_male_parents.length; i++){
            var female_id = jQuery('#target_numbers_male_accession_id_'+ i +'_info').data('related');
            get_select_box('items', target_numbers_male_parents[i], { 'name' : 'target_numbers_male_accession_id_select', 'id' : 'target_numbers_male_accession_id_'+i, 'size' : 7, 'stock_type_name':'accession', 'list_items':male_list, 'names_as_select':1, 'data-related':female_id});
        };
    };

    jQuery(document).on('change', "select[name='target_numbers_male_accession_id_select']", function() {
        var div_id = '#' + this.id;
        var male_names = jQuery(div_id).val();
        if (male_names.length > 0){
            target_numbers_change_males(div_id, div_id + '_info');
        }

        jQuery('#target_numbers_footer').show();
    });

    function target_numbers_change_males(div_id, select_id){
        var male_names = jQuery(div_id).val();
        var female_name = jQuery(div_id).data('related');
        var html = '<table class="table table-bordered" div="' + div_id +("_table\"><thead><tr><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.male_parent.7df4e67", "Male Parent") : "Male Parent")).html() + "</th><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.no_of_seeds", "No. of Seeds") : "No. of Seeds")).html() + "</th><th>" + jQuery("<div>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.no_of_progenies", "No. of Progenies") : "No. of Progenies")).html() + "</th></tr></thead><tbody>");
        for (var i=0; i<male_names.length; i++){
            html = html + '<tr><td>' + male_names[i] + '</td><td><input class="form-control" male_name="' + male_names[i] + '" female_name="' + female_name + '" name ="seed_target_number" id="seed_target_number_'+ i +'" value="" placeholder=""/></td><td><input class="form-control" male_name="' + male_names[i] + '" female_name="' + female_name + '" name ="progeny_target_number" id="progeny_target_number_'+ i +'" value="" placeholder=""/></td></tr>';
        };
        html = html + '</tbody></table>';
        jQuery(select_id).html(html);
    };

    jQuery('#target_numbers_submit').click(function(e){
        e.preventDefault();
        number_of_seeds = [];
        number_of_progenies = [];

        jQuery('input[name="seed_target_number"]').each(function() {
            value = this.value;
            var male_name = jQuery(this).attr('male_name');
            var female_name = jQuery(this).attr('female_name');
            number_of_seeds.push({ 'female_name':female_name, 'male_name':male_name, 'number_of_seeds':value });
        });

        jQuery('input[name="progeny_target_number"]').each(function() {
            value = this.value;
            var male_name = jQuery(this).attr('male_name');
            var female_name = jQuery(this).attr('female_name');
            number_of_progenies.push({ 'female_name':female_name, 'male_name':male_name, 'number_of_progenies':value });
        });

        jQuery.ajax({
            url: '/ajax/crossing_experiment/record_target_numbers',
            method: 'POST',
            data: {
                'number_of_seeds': JSON.stringify(number_of_seeds),
                'number_of_progenies': JSON.stringify(number_of_progenies),
                'crossing_experiment_id': crossing_experiment_id
            },
            dataType:'json',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                } else {
                    jQuery("#record_target_numbers_message").modal("show");
                    jQuery('#record_target_numbers_using_lists_dialog').modal("hide");
                }
            },
            error: function() {
                jQuery("#working_modal").modal("hide");
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.forms.an_error_occurred_storing_target_numbers", "An error occurred storing target numbers.") : "An error occurred storing target numbers."));
                jQuery('#record_target_numbers_using_lists_dialog').modal("hide");
            },
        });
    });

    jQuery("#record_target_numbers_close_button").click(function(){
        location.reload();
    });




});

</script>

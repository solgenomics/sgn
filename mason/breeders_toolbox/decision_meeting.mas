<& /util/import_javascript.mas,
   classes => ['CXGN.BreederSearch','CXGN.Trial','jquery.iframe-post-form' ],
   entries => ['decision_meeting'] &>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("decision.root.decision_meeting", "Decision Meeting")) &>

<div>

<%perl>
my $buttons_html = ("<button class='btn btn-success' style='margin:3px' id='create_meeting_dialog'>" . HTML::Entities::encode_entities($c->i18n->p("decision.root.create_meeting", "Create Meeting")) . "</button>");
</%perl>

<& /breeders_toolbox/decision_meeting/add_meeting_dialog.mas &>


<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Decision Meeting</h4>", info_section_collapsed => 0, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("decision.root.decision_meeting", "Decision Meeting")) . "</h4>"), info_section_subtitle => $c->i18n->p("decision.root.create_meeting_setup", 'Create meeting setup'), buttons_html => $buttons_html, icon_class => "glyphicon glyphicon-list-alt", info_section_id => "decision_meeting_section" &>

<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Accession Tracker</h4>", info_section_collapsed => 0, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("decision.root.accession_tracker", "Accession Tracker")) . "</h4>"), info_section_subtitle => $c->i18n->p("decision.root.accessions_stages_and_decisions", 'Accessions, stages, and decisions'),icon_class => "glyphicon glyphicon-signal", info_section_id => "accession_meeting_section" &>

</div>



<%init>
use HTML::Entities ();
</%init>
<%args>
$facilities
</%args>


<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.GenotypingTrial' ] &>

<div class="modal fade" id="create_genotyping_project_dialog" name="create_genotyping_project_dialog" tabindex="-1" role="dialog" aria-labelledby="createGenotypingProjectdialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('genotype.project.dialog.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <div style="text-align: center">
                    <h4 class="modal-title" id="createGenotypingProjectdialog"><% $c->i18n->p('genotype.project.dialog.title', 'Add New Genotyping Project') |h %></h4>
                </div>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "add_genotyping_project_workflow" &>
                        <&| /util/workflow.mas:step, title=>HTML::Entities::encode_entities($c->i18n->p('genotype.project.dialog.step_intro', 'Intro'), q{&<>"'}) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('genotype.project.dialog.project_heading', 'Genotyping Project'), q{&<>"'}) &>
                            <p><% $c->i18n->p('genotype.project.dialog.intro', 'Genotyping Project can be used to group a series of genotyping plates and genotyping data. Genotyping Project should match Vendor Project if you have one.') |h %></p>
                            <hr>
                            <div style="text-align: center">
                                <button id="next_step_add_new_genotyping_project" class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p('genotype.project.dialog.next', 'Go to Next Step') |h %></button>
                            </div>
                        </&>

                        <form class="form-horizontal" role="form" name="create_genotyping_project_form" id="create_genotyping_project_form">
                            <&| /util/workflow.mas:step, title=>HTML::Entities::encode_entities($c->i18n->p('genotype.project.dialog.step_information', 'Add a genotyping project'), q{&<>"'}) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('genotype.project.dialog.basic_heading', 'Enter basic information about the genotyping project'), q{&<>"'}) &>
                                <br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label"><% $c->i18n->p('genotype.project.dialog.project_name', 'Genotyping Project Name: ') |h %></label>
                                    <div class="col-sm-7">
                                        <input class="form-control" id="new_genotyping_project_name" name="new_genotyping_project_name" type="text" placeholder="<% $c->i18n->p('genotype.project.dialog.name_hint', 'Should match Vendor Project if you have one') |h %>"/>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label"><% $c->i18n->p('genotype.project.dialog.facility', 'Genotyping Facility: ') |h %></label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="genotyping_project_facility_select" name="genotyping_project_facility_select">
%  foreach my $facility (@$facilities) {
                                            <option value="<% $facility %>"><% $facility %></option>
%  }
                                        </select>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label"><% $c->i18n->p('genotype.project.dialog.data_type', 'Data Type: ') |h %></label>
                                    <div class="col-sm-7">
                                        <select class="form-control" id="data_type">
                                            <option value=""><% $c->i18n->p('genotype.project.dialog.select_type', 'Select a data type') |h %></option>
                                            <option value="snp">SNP</option>
                                            <option value="ssr">SSR</option>
                                        </select>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label"><% $c->i18n->p('genotype.project.dialog.program', 'Breeding Program: ') |h %></label>
                                    <div class="col-sm-7">
                                        <span id="genotyping_project_breeding_program_select_div"></span>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label"><% $c->i18n->p('genotype.project.dialog.year', 'Year: ') |h %></label>
                                    <div class="col-sm-7">
                                        <span id="genotyping_project_year_select_div"></span>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label"><% $c->i18n->p('genotype.project.dialog.location', 'Location of Data Generation (optional): ') |h %></label>
                                    <div class="col-sm-7">
                                        <span id="genotyping_project_location_select_div"></span>
                                    </div>
                                </div><br/>
                                <div class="form-group">
                                    <label class="col-sm-5 control-label"><% $c->i18n->p('genotype.project.dialog.description', 'Description: ') |h %></label>
                                    <div class="col-sm-7">
                                        <textarea class="form-control" id="genotyping_project_description" name="genotyping_project_description" maxlength="250"></textarea>
                                    </div>
                                </div>
                                <br/>
                                <br/>
                                <br/>
                                <div style="text-align: center">
                                    <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="add_new_genotyping_project_submit" id="add_new_genotyping_project_submit"><% $c->i18n->p('genotype.project.dialog.submit', 'Submit') |h %></button>
                                </div>
                            </&>
                        </form>
                        <&| /util/workflow.mas:complete, title=> "Complete" &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('genotype.project.dialog.finished', 'Finished! Your genotyping project is now in the database'), q{&<>"'}) &>
                            <ul>
                                <li><% $c->i18n->p('genotype.project.dialog.completion_help', 'You may want to proceed to add genotyping plates and/or genotyping data in the genotyping project you just created.') |h %></li>
                            </ul>
                            <br/>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_new_genotyping_project_close_modal" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('genotype.project.dialog.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    get_select_box("locations", "genotyping_project_location_select_div", {'id': 'genotyping_project_location_select', 'name': 'genotyping_project_location_select'});
    get_select_box("breeding_programs", "genotyping_project_breeding_program_select_div", {'id': 'genotyping_project_breeding_program_select', 'name': 'genotyping_project_breeding_program_select'});
    get_select_box("years", "genotyping_project_year_select_div", {'auto_generate': 1, 'id': 'genotyping_project_year_select', 'name': 'genotyping_project_year_select'});

    jQuery('#add_new_genotyping_project_submit').click(function() {

        var project_name = jQuery("#new_genotyping_project_name").val();
        if (!project_name) {
            alert(window.SGN && SGN.i18n ? SGN.i18n.p('genotype.project.validation.name_required', 'Genotyping project name is required') : 'Genotyping project name is required');
            return;
        }

        var project_facility = jQuery("#genotyping_project_facility_select").val();

        var data_type = jQuery("#data_type").val();
        if (!data_type) {
            alert(window.SGN && SGN.i18n ? SGN.i18n.p('genotype.project.validation.type_required', 'Data type is required') : 'Data type is required');
            return;
        }

        var project_breeding_program = jQuery("#genotyping_project_breeding_program_select").val();
        if (!project_breeding_program) {
            alert (window.SGN && SGN.i18n ? SGN.i18n.p('genotype.project.validation.program_required', 'Breeding program is required') : 'Breeding program is required');
            return;
        }

        var project_year = jQuery("#genotyping_project_year_select").val();
        if (!project_year) {
            alert (window.SGN && SGN.i18n ? SGN.i18n.p('genotype.project.validation.year_required', 'Year is required') : 'Year is required');
            return;
        }

        var project_description = jQuery("#genotyping_project_description").val();
        if (!project_description) {
            alert (window.SGN && SGN.i18n ? SGN.i18n.p('genotype.project.validation.description_required', 'Description is required') : 'Description is required');
            return;
        }

        var project_location = jQuery("#genotyping_project_location_select").val();

        jQuery.ajax({
            url: '/ajax/breeders/add_genotyping_project',
            dataType: "json",
            headers: {'X-SGN-Locale': document.documentElement.getAttribute('data-sgn-locale') || document.documentElement.lang || 'en'},
            type: 'POST',
            data:{
                'project_name': project_name,
                'project_breeding_program': project_breeding_program,
                'project_facility': project_facility,
                'data_type': data_type,
                'project_year': project_year,
                'project_description': project_description,
                'project_location': project_location
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                } else {
//                    refreshGenotypingTrialJsTree(0);
                    Workflow.focus("#add_genotyping_project_workflow", -1); //Go to success page
                    Workflow.check_complete("#add_genotyping_project_workflow");
                    jQuery("#working_modal").modal("hide");
                }
            },
            error: function() {
                jQuery("#working_modal").modal("hide");
                alert(window.SGN && SGN.i18n ? SGN.i18n.p('genotype.project.validation.save_error', 'An error occurred saving genotyping project.') : 'An error occurred saving genotyping project.');
                jQuery('#create_genotyping_project_dialog').modal("hide");
            },
        });
    });

    jQuery("#add_new_genotyping_project_close_modal").click(function(){
        jQuery('#create_genotyping_project_dialog').modal('hide');
        jQuery(".modal-backdrop").remove();
        location.reload();
    });

});


</script>

<%init>
use HTML::Entities ();
# Escape catalog text first; only fixed component-owned markup replaces markers.
my $genotype_linked_text = sub {
    my ($text, $replacements) = @_;
    my $html = HTML::Entities::encode_entities($text, q{&<>"'});
    for my $marker (sort { length($b) <=> length($a) } keys %$replacements) {
        $html =~ s/\Q$marker\E/$replacements->{$marker}/g;
    }
    return $html;
};
</%init>
<%args>
@programs => ()
@locations => ()
$facilities

</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'jstree.dist.jstree', 'CXGN.TrialTreeFolders'] &>

<& /util/import_css.mas, paths => ['/static/documents/inc/jstree_theme/jstree-bstheme-min.css'] &>

<& /breeders_toolbox/genotyping_trials/upload_genotyping_data_dialogs.mas, facilities => $facilities &>
<& /breeders_toolbox/genotyping_trials/create_genotyping_trial_dialogs.mas, facilities => $facilities &>
<& /breeders_toolbox/genotyping_data_project/create_genotyping_project_dialog.mas, facilities => $facilities &>
<& /breeders_toolbox/folder/folder_set.mas, project_type=>'genotyping_project' &>
<& /breeders_toolbox/folder/folder_new.mas, project_type=>'genotyping_project' &>
<& /breeders_toolbox/folder/folder_move.mas, project_type=>'genotyping_project' &>
<& /breeders_toolbox/folder/folders_edit.mas, folder_tree_type => 'genotyping_project', folder_tree_identifier => 'genotyping_project_list', folder_tree_refresh_name => 'refresh_genotyping_project_jstree_html' &>

<table class="table table-bordered">
    <thead>
        <tr>
            <th><% $c->i18n->p('genotype.tree.information', 'Information') |h %></th>
            <th><% $c->i18n->p('genotype.tree.hierarchy', 'Breeding Programs -- Folders -- Genotyping Projects') |h %>&nbsp;&nbsp;&nbsp;&nbsp;<button class="btn btn-sm btn-default" id="refresh_genotyping_project_jstree_html_button" name="refresh_genotyping_project_jstree_html"><% $c->i18n->p('genotype.tree.refresh', 'Refresh') |h %></button></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                <h4><% $c->i18n->p('genotype.tree.search', 'Search') |h %></h4>
                <input type="text" class="form-control input-sm" id="genotyping_project_tree_search" placeholder="<% $c->i18n->p('genotype.tree.search', 'Search') |h %>" />
                <hr>

                <h5><i><% $genotype_linked_text->($c->i18n->p('genotype.tree.open_details', 'Double click%{break_one}genotyping project (%{project_icon}) or folder (%{folder_icon})%{break_two}to view detail page.', {break_one => '__SGN_GENO_BREAK_ONE__', project_icon => '__SGN_GENO_PROJECT_ICON__', folder_icon => '__SGN_GENO_FOLDER_ICON__', break_two => '__SGN_GENO_BREAK_TWO__'}), {'__SGN_GENO_BREAK_ONE__' => '<br />', '__SGN_GENO_PROJECT_ICON__' => '&nbsp;<span class="glyphicon glyphicon-align-left text-warning"></span>&nbsp;', '__SGN_GENO_FOLDER_ICON__' => '&nbsp;<span class="glyphicon glyphicon-folder-open text-danger"></span>&nbsp;', '__SGN_GENO_BREAK_TWO__' => '<br/>'}) %></i></h5>
                <h5><i><% $genotype_linked_text->($c->i18n->p('genotype.tree.programs', 'Breeding programs (%{program_icon})', {program_icon => '__SGN_GENO_PROGRAM_ICON__'}), {'__SGN_GENO_PROGRAM_ICON__' => '&nbsp;<span class="glyphicon glyphicon-briefcase text-info"></span>&nbsp;'}) %></i></h5>
                <hr>
                <h4><% $c->i18n->p('genotype.tree.folders', 'Folders') |h %></h4>
                <button class="btn btn-sm btn-default" id="new_folder_dialog_link"><% $c->i18n->p('genotype.tree.create_folder', 'Create new folder') |h %></button><br/><br/>
                <button class="btn btn-sm btn-default" id="open_folder_dialog_link"><% $c->i18n->p('genotype.tree.move_projects', 'Move genotyping project(s) to folder') |h %></button><br/><br/>
                <button class="btn btn-sm btn-default" id="move_folder_dialog_link"><% $c->i18n->p('genotype.tree.move_folder', 'Move folder') |h %></button>

                <div id="folder_edit_options" style="display:none">
                    <hr>
                    <h5><i><% $c->i18n->p('genotype.tree.select_folders', 'Select multiple folders by holding \'Ctrl\'.') |h %></i></h5>
                    <button class="btn btn-primary" id="edit_folders_button" title="<% $c->i18n->p('genotype.tree.edit_hint', 'First Select Folder(s) to Edit') |h %>"><% $c->i18n->p('genotype.tree.edit', 'Edit Folder(s)') |h %></button>
                    <br/>
                </div>

                <!--<button id="delete" disabled="disabled" >Delete</button -->
                <br />
            </td>
            <td>
                <div id="genotyping_project_list" ><% $c->i18n->p('genotype.tree.loading', '[loading...]') |h %></div>
            </td>
        </tr>
    </tbody>
</table>


<script>

jQuery.noConflict();

jQuery(document).ready(function($) {

    jQuery.ajax( {
        url: '/ajax/breeders/get_trials_with_folders_cached?type=genotyping_project',
        success: function(response) {
            var html = '<ul>'+response.html+'</ul>';

            jQuery('#genotyping_project_list').html(html);
            //console.log(html);
            jQuery('#genotyping_project_list').jstree( {
                "core": { 'themes': { 'name': 'proton', 'responsive': true}},
                "valid_children" : [ "folder", "breeding_program", "genotyping_project"],
                "types" : {
                    "breeding_program" : {
                        "icon": 'glyphicon glyphicon-briefcase text-info',
                    },
                    "folder" : {
                        "icon": 'glyphicon glyphicon-folder-open text-danger',
                    },
                    "genotyping_project" : {
                        "icon": 'glyphicon glyphicon-align-left text-warning',
                    },
                },
                "search" : {
                    "case_insensitive" : true,
                },
                "plugins" : ["html_data","types","search"],
            });
        },
        error: function(response) {
            alert(window.SGN && SGN.i18n ? SGN.i18n.p('genotype.tree.load_error', 'An error occurred while loading the genotyping projects.') : 'An error occurred while loading the genotyping projects.');
        }
    });

    jQuery("#genotyping_project_tree_search").keyup(function() {
        var v = jQuery("#genotyping_project_tree_search").val();
        jQuery("#genotyping_project_list").jstree(true).search(v);
    });

    jQuery("#genotyping_project_list").delegate("li", "dblclick", function(event){
        var node = $("#genotyping_project_list").jstree("get_node", this);
        if (node.id.substr(0,1) !== 'j') {
            if (node.type == 'folder') {
                window.open('/folder/'+node.id);
                event.stopPropagation();
            } else if (node.type == 'genotyping_project') {
                window.open('/breeders_toolbox/trial/'+node.id);
                event.stopPropagation();
            }
        }
    });

});

</script>

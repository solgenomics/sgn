<%args>
$trial_id
</%args>

<div style="overflow:scroll">
    <table id="genotyping_data_project_protocols" width="100%" class="table table-hover table-striped">
        <thead>
            <tr>
                <th><% $c->i18n->p("global.search_wizard.protocol", "Protocol") |h %></th>
                <th><% $c->i18n->p("genotype.plate.marker_type", "Marker Type") |h %></th>
                <th><% $c->i18n->p("genotype.plate.header_information_lines", "Header Information Lines") |h %></th>
                <th><% $c->i18n->p("genotype.plate.number_of_markers", "Number of Markers") |h %></th>
                <th><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></th>
                <th><% $c->i18n->p("genotype.plate.reference_genome", "Reference Genome") |h %></th>
                <th><% $c->i18n->p("genotype.plate.species_name", "Species Name") |h %></th>
            </tr>
        </thead>
    </table>
</div>

<script>

jQuery(document).ready(function () {
   var protocols_table = jQuery('#genotyping_data_project_protocols').DataTable( {
       'ajax': '/ajax/genotyping_protocol/search?genotyping_data_project_ids=<% $trial_id %>',
   });
});

</script>

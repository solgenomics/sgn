<%once>
use HTML::Entities ();
</%once>

<%args>
$trial_id
</%args>

<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>
<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables'] &>


<&| /page/info_section.mas, anchor_title => 'Delete Genotyping Plate(s)', id=>'delete_genotyping_plate_section', title => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.delete_genotyping_plate_s", 'Delete Genotyping Plate(s)')), subtitle => ("<font color=\"red\">" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.deletion_cannot_be_undone_cannot_delete_any_plate_associated_with", "Deletion cannot be undone. Cannot delete any plate associated with genotyping data")) . "</font>"), collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table class="table table-hover table-bordered" id="genotyping_plate_deletion_table">
                </table>
            </div>
        </div>
        <button class="btn btn-default" id="delete_all_genotyping_plates" role="button"><% $c->i18n->p("genotype.plate.delete_all_genotyping_plates_in_this_project", "Delete all genotyping plates in this project") |h %></button><br/><br/>
    </div>
</&>

<&| /page/info_section.mas, anchor_title => 'Delete Genotyping Protocol and All Data', id=>'delete_protocol_section', title => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.delete_genotyping_protocol_and_all_data", 'Delete Genotyping Protocol and All Data')), subtitle => ("<font color=\"red\">" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.deletion_cannot_be_undone", "Deletion cannot be undone")) . "</font>"), collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table class="table table-hover table-bordered" id="genotyping_protocol_deletion_table">
                </table>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, anchor_title => 'Delete Genotyping Project Data', id=>'delete_genotyping_project_data_section', title => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.delete_genotyping_project_data", 'Delete Genotyping Project Data')), subtitle => ("<font color=\"red\">" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.deletion_cannot_be_undone", "Deletion cannot be undone")) . "</font>"), collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-default" id="delete_genotyping_project_data" role="button"><% $c->i18n->p("genotype.plate.delete_genotyping_project_data", "Delete Genotyping Project Data") |h %></button><br/><br/>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, anchor_title => 'Delete Genotyping Project', id=>'delete_genotyping_project_section', title => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.delete_genotyping_project", 'Delete Genotyping Project')), subtitle => ("<font color=\"red\">" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.deletion_cannot_be_undone_please_delete_genotyping_plates_and_or", "Deletion cannot be undone. Please delete genotyping plates and/or genotyping data first")) . "</font>"), collapsible=>1, collapsed=>1 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-default" id="delete_genotyping_project" role="button"><% $c->i18n->p("genotype.plate.delete_genotyping_project", "Delete Genotyping Project") |h %></button><br/><br/>
            </div>
        </div>
    </div>
</&>


<script>

jQuery(document).ready(function(){

    var plate_deletion_table = jQuery('#genotyping_plate_deletion_table').DataTable({
        'autoWidth': false,
        'ajax': '/ajax/genotyping_project/plate_names?genotyping_project_id=<% $trial_id %>',
        'columns': [
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.plate_names", "Plate Names") : "Plate Names")).html(), "data": null, "render": function ( data, type, row ) { return "<a href='/breeders_toolbox/trial/"+row.plate_id+"'>"+row.plate_name+"</a>"; } },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_cxgn_dataset.delete", "Delete") : "Delete")).html(), "data": null, "render": function ( data, type, row ) {
                if (row.number_of_samples_with_data > 0){
                    return 'Cannot Delete'
                } else {
                    return "<a onclick='deletePlate("+row.plate_id+(")'>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_cxgn_dataset.delete", "Delete") : "Delete")).html() + "</a>");
                }
            }},

        ]
    });

    jQuery('#delete_all_genotyping_plates').click(function() {

        var genotyping_project_id = "<% $trial_id %>";
        var confirmation = confirm((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.are_you_sure_you_want_to_delete_all_genotyping_plates", "Are you sure you want to delete all genotyping plates in this genotyping project? The deletion cannot be undone.") : "Are you sure you want to delete all genotyping plates in this genotyping project? The deletion cannot be undone."));
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/trial/'+ <% $trial_id %> + '/delete_all_genotyping_plates_in_project',
                destroy: true,
                beforeSend: function(response) {
                    jQuery('#working_modal').modal('show');
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.soil_table.delete_success", "Deletion was successful") : 'Deletion was successful'));
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.soil_table.delete_error", "An error occurred during deletion") : 'An error occurred during deletion'));
                }
            });
        }
    });

    var protocol_deletion_table = jQuery('#genotyping_protocol_deletion_table').DataTable({
        'autoWidth': false,
        'ajax': '/ajax/genotyping_project/protocols?genotyping_project_id=<% $trial_id %>',

        'columns': [
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search_wizard.protocol", "Protocol") : "Protocol")).html(), "data": null, "render": function ( data, type, row ) { return "<a href='/breeders_toolbox/protocol/"+row.protocol_id+"'>"+row.protocol_name+"</a>"; } },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_cxgn_dataset.delete", "Delete") : "Delete")).html(), "data": "null", "render": function ( data, type, row ) { return "<a onclick='deleteProtocol("+row.protocol_id+(")'>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_cxgn_dataset.delete", "Delete") : "Delete")).html() + "</a>"); } },
        ]
    });

    jQuery('#delete_genotyping_project_data').click(function() {
        var project_id = "<% $trial_id %>";
        var confirmation = confirm((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.are_you_sure_you_want_to_delete_this_genotyping_data", "Are you sure you want to delete this genotyping data? The deletion cannot be undone.") : "Are you sure you want to delete this genotyping data? The deletion cannot be undone."));
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/genotyping_project/delete/' + project_id,
                type: 'POST',
                dataType: 'json',
                beforeSend: function(){
                    jQuery('#working_modal').modal("show");
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.soil_table.delete_success", "Deletion was successful") : 'Deletion was successful'));
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.soil_table.delete_error", "An error occurred during deletion") : 'An error occurred during deletion'));
                }
            });
        }
    });

    jQuery('#delete_genotyping_project').click(function() {
        var project_id = "<% $trial_id %>";
        var confirmation = confirm((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.are_you_sure_you_want_to_delete_this_genotyping_project", "Are you sure you want to delete this genotyping project? The deletion cannot be undone.") : "Are you sure you want to delete this genotyping project? The deletion cannot be undone."));
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/breeders/trial/'+project_id+'/delete/genotyping_project',
                beforeSend: function(){
                    jQuery('#working_modal').modal("show");
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.soil_table.delete_success", "Deletion was successful") : 'Deletion was successful'));
                        location.reload();
                    }
                    if (response.error) {
                        alert(response.error);
                    }
                },
                error: function(response) {
                    jQuery('#working_modal').modal('hide');
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.soil_table.delete_error", "An error occurred during deletion") : 'An error occurred during deletion'));
                }
            });
        }
    });

});

function deletePlate(plate_id){

    var confirmation = confirm((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.are_you_sure_you_want_to_delete_this_genotyping_plate", "Are you sure you want to delete this genotyping plate? The deletion cannot be undone.") : 'Are you sure you want to delete this genotyping plate? The deletion cannot be undone.'));

    if (confirmation) {
        jQuery.ajax({
            url: '/ajax/breeders/trial/'+plate_id+'/delete/layout',
            beforeSend: function(){
                jQuery('#working_modal').modal("show");
            },
            success: function(response) {
                if (response.error) {
                    alert(response.error);
                }
                else {
                    jQuery('#working_modal').modal("hide");
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.the_genotyping_plate_has_been_deleted", "The genotyping plate has been deleted.") : 'The genotyping plate has been deleted.'));
                    location.reload();
                }
            },
            error: function(response) {
                jQuery('#working_modal').modal("hide");
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.an_error_occurred", "An error occurred.") : "An error occurred."));
            }
        });
    }
}

function deleteProtocol(protocol_id){

    var confirmation = confirm((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.are_you_sure_you_want_to_delete_this_genotyping_protocol_486e2c", "Are you sure you want to delete this genotyping protocol and all data? The deletion cannot be undone.") : 'Are you sure you want to delete this genotyping protocol and all data? The deletion cannot be undone.'));

    if (confirmation) {
        jQuery.ajax ({
            url : '/ajax/genotyping_protocol/delete/'+protocol_id,
            beforeSend: function(){
                jQuery('#working_modal').modal('show');
            },
            success: function(response){
                console.log(response);
                jQuery('#working_modal').modal('hide');
                if (response.error) {
                    alert(response.error);
                }
                if (response.success) {
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.genotyping_protocol_deleted", "Genotyping protocol deleted!") : 'Genotyping protocol deleted!'));
                    window.location.replace("/search/genotyping_protocols");
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.plate.error_deleting_genotyping_protocol", "Error deleting genotyping protocol!") : 'Error deleting genotyping protocol!'));
            }
        });
    }
}


</script>

<%once>
use HTML::Entities ();
</%once>

<%args>
$trial_id
$trial_name
$breeding_program_name
$breeding_program_id
$location_name
$year
$trial_description
$identifier_prefix
$genotyping_facility
$genotype_data_type
$trial_owner
</%args>

<div class="row">
    <div class="col-sm-8">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b><% $c->i18n->p("folder.detail.genotyping_project_name", "Genotyping Project Name") |h %></b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.no_project_name", "[No Project Name]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("global.index_logged_in_user.breeding_program", "Breeding Program") |h %> </b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
        <a href="/breeders/program/<% $breeding_program_id %>"><% $breeding_program_name %></a>
% }
% else {
%  print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_breeding_program", "[No Breeding Program]")) . "</span>");
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("global.search.features.location", "Location") |h %></b></td>
                <td>
                    <div id="trial_location">
% if ($location_name) {
%  print "$location_name";
% } else {
%  print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_location", "[No Location]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("accession.sequencing.table.year", "Year") |h %></b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%  print "$year";
% } else {
%  print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_year", "[No Year]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("genotype.plate.genotyping_facility", "Genotyping Facility") |h %></b></td>
                <td>
                    <div id="trial_genotyping_facility">
% if ($genotyping_facility) {
%  print "$genotyping_facility";
% } else {
%  print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.no_genotyping_facility", "[No Genotyping Facility]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("global.dataset_publish.data_type", "Data Type") |h %></b></td>
                <td>
                    <div id="trial_data_type">
% if ($genotype_data_type) {
%  print "$genotype_data_type";
% } else {
%      print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.no_data_type", "[No Data Type]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></b></td>
                <td>
                    <div id="trial_description">
% if ($trial_description) {
%  print "$trial_description";
% } else {
%  print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_description", "[No Description]")) . "</span>");
% }
                    </div>
                </td>
            </tr>
            <tr><td><b><% $c->i18n->p("cross.ui.created_by", "Created by") |h %></b></td>
                <td>
                    <div id="trial_owner">
% if ($trial_owner) {
%  print "$trial_owner";
% } else {
%  print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.n_a", "[N/A]")) . "</span>");
% }
                    </div>
                </td>
            </tr>
        </table>
        
    </div>
    <div class="col-sm-4">
        <div class="well well-sm">
            <& /util/barcode.mas, identifier => "$identifier_prefix"."$trial_id", trial_id=> "$trial_id", trial_name=> "$trial_name", format=>"trial_qrcode"  &>
        </div>
    </div>
</div>

<%args>
$trial_id
</%args>

<div style="overflow:scroll">
    <table id="genotyping_plates_in_genotyping_project_table" width="100%" class="table table-hover table-striped">
        <thead>
            <tr>
                <th><% $c->i18n->p("genotype.plate.plate_name", "Plate Name") |h %></th>
                <th><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></th>
                <th><% $c->i18n->p("global.search_wizard.format", "Format") |h %></th>
                <th><% $c->i18n->p("genotype.plate.sample_type", "Sample Type") |h %></th>
                <th><% $c->i18n->p("genotype.plate.number_of_samples", "Number of Samples") |h %></th>
                <th><% $c->i18n->p("global.est.download", "Download") |h %></th>
            </tr>
        </thead>
    </table>
</div>

<script>

jQuery(document).ready(function () {
   var genotyping_plates_table = jQuery('#genotyping_plates_in_genotyping_project_table').DataTable({
       'ordering'  : false,
       'ajax': '/ajax/genotyping_project/genotyping_plates?genotyping_project_id=<% $trial_id %>',
   });
});

</script>

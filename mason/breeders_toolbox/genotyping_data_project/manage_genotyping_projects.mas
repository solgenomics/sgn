<%init>
use HTML::Entities ();
# Escape catalog text first; only fixed component-owned markup replaces markers.
my $genotype_linked_text = sub {
    my ($text, $replacements) = @_;
    my $html = HTML::Entities::encode_entities($text, q{&<>"'});
    for my $marker (sort { length($b) <=> length($a) } keys %$replacements) {
        $html =~ s/\Q$marker\E/$replacements->{$marker}/g;
    }
    return $html;
};
</%init>
<%args>
$locations
$programs
$facilities
</%args>

<br />
<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p('genotype.projects.title', 'Manage Genotyping Projects'), q{&<>"'}) &>

<style>
/* Keep owner-supplied action captions within this page in either direction. */
.sgn-genotyping-projects-page .infosectionhead {
    table-layout: fixed;
}
.sgn-genotyping-projects-page .infosectiontitle {
    width: 25%;
    overflow-wrap: anywhere;
}
.sgn-genotyping-projects-page .infosectionsubtitle {
    width: auto;
    white-space: normal;
}
.sgn-genotyping-projects-page button.btn {
    max-width: calc(100% - 6px);
    white-space: normal;
    overflow-wrap: anywhere;
}
</style>
<div class="container-fluid sgn-genotyping-projects-page">
    <&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('genotype.projects.about_title', 'About Genotyping Projects and Genotyping Plates'), q{&<>"'}), anchor_title=>'About Genotyping Projects and Genotyping Plates',  collapsible => 1, collapsed=>1 &>
        <div class="well well-sm">
            <div class="panel panel-default">
                <div class="panel-body">
                    <b><p><% $c->i18n->p('genotype.projects.about.what_projects', 'What are genotyping projects?') |h %></p></b>
                    <ul>
                        <li><% $c->i18n->p('genotype.projects.about.organize', 'Genotyping projects allow you to organize both genotyping plates and associated genotyping data on the same page.') |h %></li>
                        <li><% $c->i18n->p('genotype.projects.about.select_project', 'Please select a genotyping project previously stored in the database or create a new one before you add/upload a genotyping plate or genotyping data.') |h %>
                        <li><% $c->i18n->p('genotype.projects.about.group_projects', 'Several genotyping projects can be grouped together using genotyping project folders (Note: folders for genotyping plates are now obsoleted)') |h %></li>
                    </ul>

                    <b><p><% $c->i18n->p('genotype.projects.about.what_plates', 'What are genotyping plates?') |h %></p></b>
                    <ul>
                        <li><% $c->i18n->p('genotype.projects.about.plate_sizes', 'Genotyping plates represent %{small_size} or %{large_size} well plates.', {small_size => 96, large_size => 384}) |h %></li>
                        <li><% $c->i18n->p('genotype.projects.about.unique_sample', 'Each well in the plate has a unique tissue sample ID.') |h %></li>
                        <li><% $c->i18n->p('genotype.projects.about.well_contents', 'The "contents" of each well can be either a tissue sample, plant name, plot name, or accession name. This "source" name must be in the database already.') |h %></li>
                        <li><% $c->i18n->p('genotype.projects.about.facility_requirements', 'If you choose to submit your genotyping plate to a genotyping facility (%{cornell_igd}, %{intertek}, %{bgi}, etc) we can generate the files they require for you. Please be aware of their requirements, such as blank well positions and concentrations.', {cornell_igd => 'Cornell IGD', intertek => 'Intertek', bgi => 'BGI'}) |h %></li>
                    </ul>

                    <b><p><% $c->i18n->p('genotype.projects.about.record_plate', 'How do I record a genotyping plate?') |h %></p></b>
                    <ul>
                        <li><% $c->i18n->p('genotype.projects.about.step_sources', '1) Know what the "source" units for each well will be (either a tissue sample, plant, plot, or accession name). These "source" names must exist in the database (e.g. as tissue samples or plants or plots from a trial, or just as accession names). Ideally you will have the barcodes from the field with you.') |h %></li>
                        <li><% $c->i18n->p('genotype.projects.about.step_coordinate', '2) Use the "%{application}" Android Application to scan your "source" barcodes and record the position of the tissue sample in the %{small_size} or %{large_size} well plate. If you prefer you can create your own XLS file and upload that, if you do not want to use the %{application} Application. Alternatively you can let the database generate the genotyping plate for you, and then produce the plate in that layout.', {application => 'Coordinate', small_size => 96, large_size => 384}) |h %></li>
                        <li><b><% $genotype_linked_text->($c->i18n->p('genotype.projects.about.coordinate_link', 'For more info about the "%{application}" Android Application go to %{application_link}.', {application => 'Coordinate', application_link => '__SGN_GENO_COORDINATE_LINK__'}), {'__SGN_GENO_COORDINATE_LINK__' => '<a href="https://play.google.com/store/apps/details?id=org.wheatgenetics.coordinate">Coordinate</a>'}) %></b></li>
                        <li><% $c->i18n->p('genotype.projects.about.step_create', '3) Click "Add Genotyping Plate" and fill in the form completely.') |h %></li>
                        <li><% $c->i18n->p('genotype.projects.about.step_shipping', '4) To ease shipping materials to the genotyping facility, we can generate the required templates for you after the data is in the database.') |h %></li>
                    </ul>
                </div>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('genotype.projects.section', 'Genotyping Projects'), q{&<>"'}), anchor_title=>'Genotyping Projects', collapsible=>1, collapsed=>0, subtitle => '<button class="btn btn-sm btn-primary" style="margin:3px" name="create_genotyping_project_link">' . HTML::Entities::encode_entities($c->i18n->p('genotype.projects.action.create', 'Add Genotyping Project'), q{&<>"'}) . '</button><button class="btn btn-sm btn-primary" style="margin:3px" name="create_genotyping_trial_link">' . HTML::Entities::encode_entities($c->i18n->p('genotype.projects.action.add_plate', 'Add/Upload Genotyping Plate'), q{&<>"'}) . '</button> <button class="btn btn-sm btn-primary" style="margin:3px" name="upload_genotyping_data_link">' . HTML::Entities::encode_entities($c->i18n->p('genotype.projects.action.upload_data', 'Upload Genotyping Data'), q{&<>"'}) . '</button><button class="btn btn-sm btn-primary" style="margin:3px" name="upload_marker_metadata_link">' . HTML::Entities::encode_entities($c->i18n->p('genotype.projects.action.marker_metadata', 'Add Marker Metadata'), q{&<>"'}) . '</button>' &>
        <& /breeders_toolbox/genotyping_data_project/genotyping_project_tree.mas, locations=>$locations, programs=>$programs, facilities =>$facilities &>
    </&>
</div>

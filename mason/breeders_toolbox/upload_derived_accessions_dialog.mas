<%args>

</%args>

<div class="modal fade" id="upload_derived_accessions_dialog" name="upload_derived_accessions_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadDerivedAccessionsDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadDerivedAccessionsDialog"><% $c->i18n->p("accession.forms.upload_derived_accessions", "Upload Derived Accessions") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>$c->i18n->p("cross.ui.template_information.bf8c643", "Template Information") &>
                        <p>
                            <b><% $c->i18n->p("accessions.dialog.file_format", "File format information") |h %></b>
                            <br>
                            <a id="derived_accession_upload_spreadsheet_format_info"><% $c->i18n->p("cross.ui.spreadsheet_format.f1285ec", "Spreadsheet Format") |h %></a>
                        </p>
                    </&>
                    <form method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_derived_accessions_form" name="upload_derived_accessions_form">
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("cross.ui.upload_file.9798051", "Upload File:") |h %> </label>
                            <div class="col-sm-9" >
                                <input type="file" name="derived_accessions_file" id="derived_accessions_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="upload_derived_accessions_submit" id="upload_derived_accessions_submit"><% $c->i18n->p("global.dataset_publish.action.upload", "Upload") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="derived_accessions_saved_dialog_message" name="derived_accessions_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="derivedAccessionsSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="derivedAccessionsSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("accession.forms.the_derived_accessions_were_saved_successfully", "The derived accessions were saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_derived_accessions_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_derived_accessions_error_display" name="upload_derived_accessions_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadDerivedAccessionsErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadDerivedAccessionsErrorDialog"><% $c->i18n->p("accession.forms.upload_derived_accessions_error", "Upload Derived Accessions Error") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="derived_accession_upload_spreadsheet_info_dialog" name="derived_accession_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadDerivedAccessionsInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadDerivedAccessionsInfoDialog"><% $c->i18n->p("accession.forms.upload_template_information_for_derived_accessions", "Upload Template Information For Derived Accessions") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% $c->i18n->p("accessions.template.header", "Header:") |h %></b>
                    <br>
                    <% $c->i18n->p("cross.ui.the_first_row_header_should_contain_the_following", "The first row (header) should contain the following:") |h %>
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>source_name</td>
                                <td>derived_accession_name</td>
                                <td>description</td>
                            </tr>
                        </tbody>
                    </table>

                    <b><% $c->i18n->p("cross.ui.required_fields", "Required fields:") |h %></b>
                    <ul>
                        <li><% $c->i18n->p("accession.forms.source_name_must_be_in_the_database_stock_type_can", "source_name (must be in the database. Stock type can be accession, plant or tissue sample)") |h %></li>
                        <li><% $c->i18n->p("accession.forms.derived_accession_name_must_not_exist_in_the_database", "derived_accession_name (must NOT exist in the database)") |h %></li>
                        <li>description</li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => $c->i18n->p("accession.forms.derived_accessions", "Derived Accessions"), optional_column => 0 &>
            </div>
            <div class="modal-footer">
                <button id="close_derived_accession_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

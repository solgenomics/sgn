<%once>
use HTML::Entities ();
</%once>

<%args>
$roles => undef
$is_curator => undef
</%args>

<& /util/import_javascript.mas, entries => [ "manage_user_roles" ] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("program.roles.page_title", "Manage User Roles")) &>

<table id="manage_user_roles_table" class="table table-bordered">
<thead>
% if ($is_curator){
<tr><th><% $c->i18n->p("program.roles.header.user", "User") |h %></th><th><% $c->i18n->p("program.roles.header.roles", "Roles") |h %></th></tr>
% } else {
<tr><th><% $c->i18n->p("program.roles.header.user", "User") |h %></th><th><% $c->i18n->p("program.roles.header.programs", "Breeding Programs") |h %></th></tr>
% }
</thead>
<tbody>
</tbody>
</table>

<div id="manage_user_roles" >

<div class="modal fade" id="add_person_role_dialog" name="add_person_role_dialog" tabindex="-1" role="dialog" aria-labelledby="addPersonRoleDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("folder.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addPersonRoleDialog"><% $c->i18n->p("program.roles.add_title", "Add Role for ") |h %><span id="person_name_for_role"></span></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

	       <!-- form class="form-horizontal" >
	        <div class="form-group">
                <label class="col-sm-3 control-label">Username: </label>
                <div class="col-sm-9" >
                    <div id="add_person_role_person_select_div">
                    [LOADING...]
                    </div>
                </div>
	        </div -->
            <input type="hidden" id="sp_person_id" name="sp_person_id" value="" />
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p("program.roles.role_label", "Role: ") |h %></label>
                <div class="col-sm-9" >
                    <div id="add_person_role_role_select_div">
                    [LOADING...]
                    </div>
                </div>
	        </div>
	       </form><br/>
         
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" name="add_person_role_cancel_button" id="add_person_role_cancel_button" data-dismiss="modal"><% $c->i18n->p("folder.ui.close", "Close") |h %></button>
        <button type="button" class="btn btn-primary" name="add_person_role_submit_button" id="add_person_role_submit_button" title="<% $c->i18n->p("trial.repetitive.submit", "Submit") |h %>"><% $c->i18n->p("trial.repetitive.submit", "Submit") |h %></button>
      </div>
    </div>
  </div>
</div>
</div>  <!-- manage_user_roles -->

% if (! $is_curator) {
<% $c->i18n->p("program.roles.curator_note", "Note: Only curators can change user role assignments.") |h %>
% }

<script>

jQuery(document).ready(function() {

   jQuery('#manage_user_roles_table').DataTable( {
       ajax : '/ajax/roles/list'
   });

 
});


function delete_user_role(sp_person_role_id) {
    
    var yes = confirm((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.roles.confirm_delete", "Really delete this role association?") : "Really delete this role association?"));
    if (yes) { 
      $.ajax( {
        url: '/ajax/roles/delete/association/'+sp_person_role_id
      });
      jQuery('#manage_user_roles_table').DataTable().ajax.reload();					  
      alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.roles.deleted", "Association deleted.") : "Association deleted."));
    }
  }

function add_user_role(sp_person_id, person_name) {
	$('#add_person_role_dialog').modal("show");
        $('#sp_person_id').val(sp_person_id);
        $('#person_name_for_role').html(person_name);

        jQuery.ajax ( {
            url : '/ajax/people/people_and_roles',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response){
                jQuery("#working_modal").modal("hide");

                var sp_role_html = '<select class="form-control" id="add_person_role_role_select">';
                for (var i=0; i<response.sp_roles.length; i++) {
                    sp_role_html = sp_role_html + '<option value="'+response.sp_roles[i][1]+'">'+response.sp_roles[i][0]+'</option>';
                }
                jQuery('#add_person_role_role_select_div').empty().html(sp_role_html);
            },
            error: function(response) {
                jQuery("#working_modal").modal("hide");
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.roles.error.details", "An error occured: %{details}", {details: String(response)}) : 'An error occured: ' + response));
            }
        });
}



    jQuery('#add_person_role_submit_button').click( function(e) {

							  
    jQuery.ajax ( {
        url : '/ajax/people/add_person_role?sp_person_id='+jQuery("#sp_person_id").val()+'&sp_role_id='+jQuery("#add_person_role_role_select").val(),
        beforeSend: function() {
            jQuery("#working_modal").modal("show");
        },
        success: function(response){
            //console.log(response);
            jQuery("#working_modal").modal("hide");
            if (response.error) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.roles.error.response", "Error: %{error}", {error: String(response.error)}) : 'Error: ' + response.error));
            } else {
            jQuery('#manage_user_roles_table').DataTable().ajax.reload();
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.roles.added", "Role Added for User!") : "Role Added for User!"));
            }
        },
        error: function(response) {
            jQuery("#working_modal").modal("hide");
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.roles.error.details", "An error occured: %{details}", {details: String(response)}) : 'An error occured: ' + response));
        }
    });
});
	

</script>


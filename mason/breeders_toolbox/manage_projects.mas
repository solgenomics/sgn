
<%args>
$locations
$breeding_programs
$preferred_species
$editable_stock_props => {}
$editable_stock_props_definitions => {}
$timestamp
$management_factor_types => ()
$design_types => ()
</%args>


<& /page/page_title.mas, title=>encode_entities($c->i18n->p('trial.list.title', 'Manage Trials')) &>

<div class="container-fluid">

<&| /page/info_section.mas, title=>encode_entities($c->i18n->p('trial.list.section', 'Trials')), collapsible=>1, collapsed=>0, subtitle=>$trial_actions &>

  <& /breeders_toolbox/trialtreefolders.mas, locations=>$locations, breeding_programs=>$breeding_programs, preferred_species=>$preferred_species, editable_stock_props=>$editable_stock_props, editable_stock_props_definitions=>$editable_stock_props_definitions, timestamp=>$timestamp, management_factor_types => $management_factor_types, design_types => $design_types &>
  </&>
</div>

<& /breeders_toolbox/program/add_autogenerated_name_metadata_dialog.mas, programs=>$breeding_programs &>

<%init>
use HTML::Entities qw(encode_entities);
my $trial_actions = '<button class="btn btn-sm btn-info" style="margin:3px" name="update_trial_link">'
    . encode_entities($c->i18n->p('trial.list.update', 'Update Existing Trial(s)')) . '</button> '
    . '<button class="btn btn-sm btn-primary" style="margin:3px" name="upload_trial_link">'
    . encode_entities($c->i18n->p('trial.list.upload', 'Upload Existing Trial(s)')) . '</button> '
    . '<button class="btn btn-sm btn-primary" style="margin:3px" id="add_project_link">'
    . encode_entities($c->i18n->p('trial.list.design', 'Design New Trial')) . '</button>';
</%init>

<%args>
</%args>

<& /util/import_javascript.mas, classes => [ ] &>

<!--button class='btn btn-default' style='margin:3px' id='export_drone_imagery_events'>Export Imaging Events</button-->

<div class="modal fade" id="export_drone_imagery_dialog" name="export_drone_imagery_dialog" tabindex="-1" role="dialog" aria-labelledby="exportDroneImageryDialog">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("nirs.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="exportDroneImageryDialog"><% $c->i18n->p("drone.interface.export_aerial_imaging_event_s", "Export Aerial Imaging Event(s)") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <&| /util/workflow.mas, id=> "drone_imagery_export_workflow" &>
                <&| /util/workflow.mas:step, title=> $c->i18n->p("nirs.ui.intro", "Intro") &>
                    <& /page/page_title.mas, title=> HTML::Entities::encode_entities($c->i18n->p("drone.interface.this_workflow_will_guide_you_through_exporting_aerial_imaging_event_s_from_the", "This workflow will guide you through exporting aerial imaging event(s) from the database")) &>
                    <ul>
                        <li><% $c->i18n->p("drone.interface.exporting_imaging_events_is_important_for_transferring_data_across_imagebreed", "Exporting imaging events is important for transferring data across ImageBreed instances.") |h %></li>
                        <li><% $c->i18n->p("drone.interface.exporting_imaging_events_will_return_a_spreadsheet_file_defining_the_imaging_e", "Exporting imaging events will return a spreadsheet file defining the imaging events, a zipfile containing the orthophoto imges, and a zipfile containing the GeoJSON plot-polygon definitions.") |h %></li>
                        <li><% $c->i18n->p("drone.interface.phenotypic_values_will_not_be_exported_in_this_workflow_please_use_the_wizard", "Phenotypic values will not be exported in this workflow, please use the Wizard of the \"Download Image-Phenotype File\" to retrieve phenotypic values.") |h %></li>
                    </ul>
                    <br/>
                    <center>
                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;"><% $c->i18n->p("drone.interface.go_to_export_imaging_event_s", "Go to export imaging event(s)") |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $c->i18n->p("drone.interface.field_trial", "Field Trial") &>
                    <& /page/page_title.mas, title=> HTML::Entities::encode_entities($c->i18n->p("drone.interface.select_your_field_trial", "Select your field trial")) &>

                    <div class="form-horizontal">
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("cross.ui.field_trial", "Field Trial:") |h %> </label>
                            <div class="col-sm-9" >
                                <div id="export_drone_image_trial_select_div"></div>
                            </div>
                        </div>
                    </div>

                    <br/>
                    <center>
                    <button class="btn btn-primary" onclick="Workflow.complete(this); return false;"><% $c->i18n->p("global.workflow.next_step", "Go to Next Step") |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $c->i18n->p("drone.interface.drone_run", "Drone Run") &>
                    <& /page/page_title.mas, title=> HTML::Entities::encode_entities($c->i18n->p("drone.interface.create_a_new_drone_run", "Create a new drone run")) &>

                    <table class="table table-bordered table-hover" id="drone_image_export_drone_runs_table">
                        <thead>
                            <tr>
                                <th><% $c->i18n->p("global.select", "Select") |h %></th>
                                <th><% $c->i18n->p("drone.interface.imaging_event_name", "Imaging Event Name") |h %></th>
                                <th><% $c->i18n->p("drone.interface.imaging_event_type", "Imaging Event Type") |h %></th>
                                <th><% $c->i18n->p("drone.interface.imaging_event_description", "Imaging Event Description") |h %></th>
                                <th><% $c->i18n->p("drone.interface.imaging_event_date", "Imaging Event Date") |h %></th>
                                <th><% $c->i18n->p("drone.interface.drone_run_gdd", "Drone Run GDD") |h %></th>
                                <th><% $c->i18n->p("drone.interface.sensor", "Sensor") |h %></th>
                                <th><% $c->i18n->p("drone.interface.field_trial_name", "Field Trial Name") |h %></th>
                                <th><% $c->i18n->p("drone.interface.field_trial_description", "Field Trial Description") |h %></th>
                            </tr>
                        </thead>
                    </table>

                    <center>
                    <button class="btn btn-primary" id="drone_image_export_drone_run_continue"><% $c->i18n->p("global.workflow.next_step", "Go to Next Step") |h %></button>
                    </center>
                </&>
                <&| /util/workflow.mas:step, title=> $c->i18n->p("global.submit", "Submit") &>
                    <& /page/page_title.mas, title=> HTML::Entities::encode_entities($c->i18n->p("drone.interface.export_imaging_event_s", "Export Imaging Event(s)")) &>

                    <div id="export_drone_imagery_submit_div">
                    </div>

                    <center>
                    <button type="button" class="btn btn-info" name="export_drone_imagery_submit" id="export_drone_imagery_submit"><% $c->i18n->p("global.submit", "Submit") |h %></button>
                    </center>
                </&>

            </&>

            <div id="upload_drone_imagery_verify_status"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("nirs.ui.close", "Close") |h %></button>
      </div>
    </div>
  </div>
</div>

<script defer="defer">

jQuery(document).ready(function() {

    jQuery('#export_drone_imagery_events').on('click', function(){
        jQuery('#export_drone_imagery_dialog').modal('show');
    });

    get_select_box('trials', 'export_drone_image_trial_select_div', { 'name' : 'export_drone_run_field_trial_id', 'id' : 'export_drone_run_field_trial_id', 'empty':1, 'multiple':0 });

    var export_imaging_events_field_trial_id;
    jQuery(document).on('change', '#export_drone_run_field_trial_id', function() {
        export_imaging_events_field_trial_id = jQuery(this).val();
        jQuery('#drone_image_export_drone_runs_table').DataTable({
            destroy : true,
            ajax : '/api/drone_imagery/drone_runs?select_checkbox_name=export_drone_imagery_drone_run_select&field_trial_ids='+export_imaging_events_field_trial_id
        });
    });

    var export_imaging_events_drone_run_ids = [];
    jQuery('#drone_image_export_drone_run_continue').click(function(){
        export_imaging_events_drone_run_ids = [];
        jQuery('input[name="export_drone_imagery_drone_run_select"]:checked').each(function() {
            export_imaging_events_drone_run_ids.push(jQuery(this).val());
        });
        if (export_imaging_events_drone_run_ids.length < 1) {
            alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("drone.interface.please_select_at_least_one_imaging_event_ea7e46", "Please select at least one imaging event.") : "Please select at least one imaging event."));
            return false;
        }
        else {
            Workflow.complete('#drone_image_export_drone_run_continue');
            Workflow.focus('#drone_imagery_export_workflow', 3);
        }
        return false;
    });


    jQuery('#export_drone_imagery_submit').click(function(){
        jQuery.ajax({
            url : '/api/drone_imagery/export_drone_runs?drone_run_project_ids='+JSON.stringify(export_imaging_events_drone_run_ids)+'&field_trial_id='+export_imaging_events_field_trial_id,
            success: function(response){
                console.log(response);

                if (response.error) {
                    alert(response.error);
                    return false;
                }
                else {
                    var html = '<a href="' + response.imaging_events_spreadsheet + '">' + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("drone.interface.download_imaging_event_spreadsheet", "Download Imaging Event Spreadsheet") : "Download Imaging Event Spreadsheet")).html() + '</a><hr><a href="' + response.orthoimage_zipfile + '">' + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("drone.interface.download_orthoimage_zipfile", "Download Orthoimage Zipfile") : "Download Orthoimage Zipfile")).html() + '</a><hr><a href="' + response.geojson_zipfile + '">' + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("drone.interface.download_geojson_zipfile", "Download GeoJSON Zipfile") : "Download GeoJSON Zipfile")).html() + '</a>';
                    jQuery('#export_drone_imagery_submit_div').html(html);
                    return false;
                }
            },
            error: function(response){
                alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("drone.interface.error_exporting_imaging_events", "Error exporting imaging events!") : "Error exporting imaging events!"));
            }
        });
    });

});
</script>

<%once>
use HTML::Entities ();
</%once>

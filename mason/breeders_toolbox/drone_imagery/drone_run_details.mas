<%args>
$trial_id
$trial_name
$trial_description
$identifier_prefix
$drone_run_date => undef
</%args>

<div class="row">
    <div class="col-sm-12">

        <table class="table table-hover table-bordered" >

            <tr>
                <td><b><% $c->i18n->p("drone.interface.imaging_event_name", "Imaging Event Name") |h %></b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%   print "$trial_name";
% } else {
%   print "<span class='text-danger'>" . $c->i18n->p("drone.interface.no_imaging_event_name", "[No Imaging Event Name]") . "</span>";
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("drone.interface.imaging_event_date", "Imaging Event Date") |h %></b></td>
                <td>
                    <div id="drone_run_date">
% if ($drone_run_date) {
<a href="/breeders/trial/<% $trial_id %>?currentDate=<% $drone_run_date %>" ><% $drone_run_date %></a>
% } else {
%  print "<span class='text-danger'>" . $c->i18n->p("drone.interface.no_imaging_event_date", "[No Imaging Event Date]") . "</span>";
% }
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("nirs.manage.column_description", "Description") |h %></b></td>
                <td>
                    <div id="trial_description">
% if ($trial_description) {
%  print "$trial_description";
% } else {
%  print "<span class='text-danger'>" . $c->i18n->p("drone.interface.no_description", "[No Description]") . "</span>";
% }
                    </div>
                </td>
            </tr>

        </table>

    </div>
</div>

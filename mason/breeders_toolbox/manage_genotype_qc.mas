<ul>
      <p>
      <li><font size="2" color="green"><% $c->i18n->p('genotype.qc.upload_assay', ' Upload QC assay') |h %></font> </li>
      <li><font size="2" color="green"><% $c->i18n->p('genotype.qc.csv_only', 'Only CSV file format is supported ') |h %></font></li>
  </ul>
</div>
  <br/><br/><br/><br/>
  <center>
        <button class="btn btn-primary" name="upload_genotyping_data_link"><% $c->i18n->p('genotype.qc.upload_button', 'Upload Genotyping Data (VCF or Intertek Format)') |h %></button>
        <button class="btn btn-primary" name="upload_genotyping_data_qc_link"><% $c->i18n->p('genotype.qc.run_button', 'Run Genotype Quality Control') |h %></button>
    </center>
     
    
<& /breeders_toolbox/genotyping_trials/upload_genotyping_data_dialogs.mas, facilities => $facilities &>

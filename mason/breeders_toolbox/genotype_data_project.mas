<%once>
use HTML::Entities ();
</%once>


<%doc>

=head1 NAME

/breeders_toolbox/genotype_data_project.mas - a mason component to display a genotyping project detail page

=head1 AUTHOR


=cut

</%doc>

<%args>
$trial_id
$trial_name
$breeding_program_id
$breeding_program_name
$location_id
$location_name
$year => undef
$trial_type => undef
$planting_date => undef
$harvest_date => undef
$trial_description => undef
$user_can_modify => undef
$has_plant_entries => undef
$has_subplot_entries => undef
$has_tissue_sample_entries => undef
$hidap_enabled => undef
$folder_name => undef
$folder_id => undef
$plants_per_plot => undef
$has_expression_atlas => undef
$expression_atlas_url => undef
$site_project_name => undef
$trial_phenotype_files => undef
$sgn_session_id => undef
$user_name => undef
$design_name => undef
$phenotypes_fully_uploaded => undef
$identifier_prefix => 'SGN'
$genotyping_facility => undef
$genotype_data_type => undef
$trial_owner => undef
$has_plate => undef
$marker_names => undef
$marker_info_headers => undef
$assay_type => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial' , 'jstree/dist/jstree', 'CXGN.BreedersToolbox.HTMLSelect', 'moment_min', 'daterangepicker' ] &>

<br/>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("genotype.plate.genotyping_project", "Genotyping Project: ")).HTML::Entities::encode_entities($trial_name) &>

<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Genotyping Project Details</h4>", info_section_collapsed => 0, trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.genotyping_project_details", "Genotyping Project Details")) . "</h4>"), info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.view_basic_information_about_the_genotyping_project", 'View basic information about the genotyping project.')),buttons_html => ("<button class=\"btn btn-primary btn-sm\" id=\"edit_genotyping_project_details\" style=\"margin:3px\">" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.edit_genotyping_project_details", "Edit Genotyping Project Details")) . "</button>"), icon_class => "glyphicon glyphicon-dashboard", info_section_id => "genotyping_data_project_details", trial_name => $trial_name, breeding_program_name => $breeding_program_name, breeding_program_id => $breeding_program_id, location_name => $location_name, year => $year, trial_description => $trial_description, identifier_prefix => $identifier_prefix, genotyping_facility => $genotyping_facility, genotype_data_type => $genotype_data_type, trial_owner => $trial_owner &>

<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Genotyping Plates</h4>", trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("folder.detail.tab.genotyping_plates", "Genotyping Plates")) . "</h4>"), info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.view_information_about_genotyping_plates_in_this_project_or_move", 'View information about genotyping plates in this project or move genotyping plates to this project.')), buttons_html => ("<button class=\"btn btn-sm btn-primary\" style=\"margin:3px\" id=\"add_existing_genotyping_plate_link\">" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.move_genotyping_plate_s_to_this_project", "Move Genotyping Plate(s) to this Project")) . "</button>"), icon_class => "glyphicon glyphicon-th", info_section_id => "genotyping_project_plates" &>

<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Genotyping Protocols</h4>", trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("navigation.search.genotyping_protocols", "Genotyping Protocols")) . "</h4>"), info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.view_basic_information_about_the_genotyping_protocols_used_in_this", 'View basic information about the genotyping protocols used in this genotyping project.')), icon_class => "glyphicon glyphicon-cog", info_section_id => "genotyping_data_project_protocols" &>

% if ($genotype_data_type eq 'SSR') {
    <& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Genotype Data</h4>", trial_id => $trial_id, marker_names => $marker_names, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.genotype_data", "Genotype Data")) . "</h4>"), info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.view_and_download_genotyping_data_from_this_project", 'View and download genotyping data from this project.')),buttons_html => ("<button class=\"btn btn-sm btn-primary\" style=\"margin:3px\" id=\"download_project_ssr_data_link\">" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.download_ssr_data", "Download SSR Data")) . "</button>"), icon_class => "glyphicon glyphicon-save-file", info_section_id => "project_pcr_genotype_data" &>
% } elsif ($assay_type eq 'KASP') {
    <& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Genotyping Data</h4>", trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.genotyping_data", "Genotyping Data")) . "</h4>"), info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.view_and_download_genotyping_data", 'View and download genotyping data.')), icon_class => "glyphicon glyphicon-map-marker", buttons_html => ("<button class=\"btn btn-primary\" style=\"margin:3px\" id=\"project_genotype_data_download_all_vcf\">" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.download_all_genotype_data_vcf", "Download All Genotype Data VCF")) . "</button><button class=\"btn btn-primary\" style=\"margin:3px\" id=\"project_genotype_data_download_all_dosagematrix\">" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.download_all_genotype_data_dosage_matrix", "Download All Genotype Data Dosage Matrix")) . "</button><button class=\"btn btn-default\" style=\"margin:3px\" id=\"kasp_project_genotype_data_download_all_csv\">" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.download_all_genotype_data_csv", "Download All Genotype Data (CSV)")) . "</button>"), info_section_id => "genotyping_data_project_data" &>
% } else {
    <& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Genotyping Data</h4>", trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.genotyping_data", "Genotyping Data")) . "</h4>"), info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.view_and_download_genotyping_data", 'View and download genotyping data.')), icon_class => "glyphicon glyphicon-map-marker", buttons_html => ("<button class=\"btn btn-primary\" style=\"margin:3px\" id=\"project_genotype_data_download_all_vcf\">" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.download_all_genotype_data_vcf", "Download All Genotype Data VCF")) . "</button><button class=\"btn btn-primary\" style=\"margin:3px\" id=\"project_genotype_data_download_all_dosagematrix\">" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.download_all_genotype_data_dosage_matrix", "Download All Genotype Data Dosage Matrix")) . "</button>"), info_section_id => "genotyping_data_project_data" &>
% }

<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Archived Files</h4>", trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.archived_files", "Archived Files")) . "</h4>"), info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.download_archived_vcf_files_associated_with_this_genotyping_project", 'Download archived VCF files associated with this genotyping project.')), icon_class => "glyphicon glyphicon-hdd", info_section_id => "genotyping_data_archived_vcf" &>

% my $data_agreement_link = ("<button class=\"btn btn-sm btn-primary\" disabled style=\"margin:3px\">" . HTML::Entities::encode_entities($c->i18n->p("program.management_factor.data_agreement_action", "Add/edit data agreement")) . "</button>");
% if ($user_can_modify) { $data_agreement_link = ("<button class=\"btn btn-sm btn-primary\" style=\"margin:3px\" id=\"add_data_agreement\">" . HTML::Entities::encode_entities($c->i18n->p("program.management_factor.data_agreement_action", "Add/edit data agreement")) . "</button>"); }

<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Data Agreement License</h4>", trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("program.management_factor.data_agreement_title", "Data Agreement License")) . "</h4>"), info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("program.management_factor.data_agreement_help", 'View and edit the public data agreement on this experiment.')), icon_class => "glyphicon glyphicon-inbox", info_section_id => "trial_data_agreement_section", buttons_html => $data_agreement_link &>
<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Delete</h4>", info_section_collapsed => 1, trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("global.dataset_cxgn_dataset.delete", "Delete")) . "</h4>"), info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.delete_genotyping_project_genotyping_plates_and_or_genotyping_data_associated", 'Delete genotyping project, genotyping plates and/or genotyping data associated with this project.')), icon_class => "glyphicon glyphicon-trash", info_section_id => "genotyping_project_deletion_section" &>

<& /breeders_toolbox/add_data_agreement_dialogs.mas, trial_id => $trial_id &>
<& /breeders_toolbox/genotyping_data_project/add_existing_genotyping_plate_dialog.mas, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, trial_id => $trial_id, trial_name => $trial_name &>
<& /breeders_toolbox/genotyping_data_project/edit_genotyping_project_details_dialog.mas, breeding_program_id => $breeding_program_id, breeding_program_name => $breeding_program_name, trial_id => $trial_id, trial_name => $trial_name, trial_description => $trial_description, year => $year, genotyping_facility => $genotyping_facility, has_plate => $has_plate &>

<div id="trialIDDiv" class="trialIDDivClass" style="display:none;">
% print $trial_id;
</div>

<script defer="defer">

jQuery(document).ready(function () {

    trial_detail_page_setup_dialogs();

    jQuery('#edit_genotyping_project_details').click(function(){
        jQuery('#edit_genotyping_project_details_dialog').modal("show");
        edit_genotyping_project_details();
    });


});

</script>

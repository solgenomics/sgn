<%doc>

=head1 NAME

/image_analysis/image_analysis_run_project.mas - a mason component to display an image analysis run detail page

=head1 AUTHORS

=cut

</%doc>

<%args>
$run_project_id
$run_name
$service_name
$run_date
$trial_id
$trial_name
$analysis_info_json => '{}'
$overlay_image_id   => undef
$overlay_image_url  => undef
$source_image_id    => undef
$user_can_modify    => undef
</%args>

<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.2/css/dataTables.bootstrap4.min.css"/>
<script src="https://cdn.datatables.net/1.11.2/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.11.2/js/dataTables.bootstrap4.min.js"></script>

<link rel="stylesheet" type="text/css"
      href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css"/>


<br/>
<!-- ============================================================
     SECTION 1: Run Details  (styled like Trial Details)
============================================================ -->
  <div class="trial-header">
      <& /page/page_title.mas, info_section_collapsed => 0, title => "Image Analysis Run: " . $run_name &>
  </div>

<&| /page/info_section.mas,
    id          => "run_details",
    title       => "Run Details",
    collapsible => 1,
    collapsed   => 0,
    subtitle    => "View basic information about this image analysis run."
&>
    <& /breeders_toolbox/image_analysis_run_details.mas,
        run_project_id     => $run_project_id,
        run_name           => $run_name,
        service_name       => $service_name,
        run_date           => $run_date,
        trial_id           => $trial_id,
        trial_name         => $trial_name,
        analysis_info_json => $analysis_info_json,
        overlay_image_id   => $overlay_image_id,
        overlay_image_url  => $overlay_image_url,
        source_image_id    => $source_image_id
    &>
</&>

<&| /page/info_section.mas, title=>"Image Analysis Results", collapsible => 1, collapsed=>0 &>

    <!-- ============================================================
         SECTION 2: Object Results (collapsible) — mirrors image_analysis.mas
    ============================================================ -->
  <div class="well well-sm">
    <div class="panel panel-default">
      <div class="panel-body">
          <div class="form-group">
            <div id="object_results_loading"
                style="display:none;text-align:center;padding:20px;">
                <span class="glyphicon glyphicon-refresh glyphicon-spin" style="font-size:24px;"></span>
                <p>Loading...</p>
            </div>

            <table id="image_analysis_result_table"
                  class="table table-bordered table-hover table-condensed display"
                  style="width:100%">
                <thead>
                    <tr>
                        <th></th>
                        <th>Stock</th>
                        <th>Trait</th>
                        <th id="analyzed_header"># Analyzed Objects</th>
                        <th>Mean Value</th>
                    </tr>
                </thead>
            </table>
          </div>
        </div>
      </div>
    </div>

</&>

<!-- Hidden field for run project id -->
<div id="run_project_id_div" style="display:none;"><% $run_project_id %></div>

<script defer="defer">
jQuery(document).ready(function () {

    var run_project_id  = '<% $run_project_id %>';

    // -------------------------------------------------------
    // 1. Populate Run Details table from analysis_metadata
    //    (parsed out of analysis_info_json)
    // -------------------------------------------------------
    function safeText(v) {
        if (v === null || v === undefined || v === '') return null;
        return String(v);
    }

    function setCell(id, value) {
        var txt = safeText(value);
        if (txt === null) {
            jQuery('#' + id).html('<span class="text-muted">—</span>');
        } else {
            jQuery('#' + id).text(txt);
        }
    }

        function renderMetadata() {
        var raw = <% $analysis_info_json %>;
        var info;
        try {
            info = (typeof raw === 'string') ? JSON.parse(raw) : raw;
        } catch (e) {
            console.error('Failed to parse analysis_info_json:', e);
            return;
        }

        // analysis_metadata may be nested (createRunProject sends { analysis_metadata })
        var meta = info.analysis_metadata || info || {};

        setCell('meta_pipeline_name',    meta.pipeline_name);
        setCell('meta_pipeline_version', meta.pipeline_version);
        setCell('meta_job_id',           meta.job_id);
        setCell('meta_timestamp',        meta.run_timestamp || meta.timestamp);
        setCell('meta_input_filename',   meta.input_filename);
        setCell('meta_output_mode',      meta.output_mode);

        // QC json
        if (meta.qc_json) {
            try {
                var qc = (typeof meta.qc_json === 'string')
                    ? JSON.parse(meta.qc_json) : meta.qc_json;

                var lines = [];
                for (var key in qc) {
                    if (qc.hasOwnProperty(key)) {
                        lines.push(key + ': ' + qc[key]);
                    }
                }
                jQuery('#meta_qc_json').text(lines.join('\n'));
            } catch (e) {
                jQuery('#meta_qc_json').text(String(meta.qc_json));
            }
        } else {
            jQuery('#meta_qc_json').text('—');
        }

        // Traits emitted - render as a comma-separated list of trait 
        /*
        if (meta.traits_emitted_json) {
            try {
                var traits = (typeof meta.traits_emitted_json === 'string')
                    ? JSON.parse(meta.traits_emitted_json)
                    : meta.traits_emitted_json;

                if (Array.isArray(traits) && traits.length) {
                    // format is "Trait Name|IMGSTAT:0000006" - show the name part
                    var names = traits.map(function (t) {
                        return String(t).split('|')[0];
                    });
                    jQuery('#meta_traits_emitted').html(
                        names.map(function (n) {
                            return '<span class="label label-info" ' +
                                   'style="margin:2px;display:inline-block;">' +
                                   n + '</span>';
                        }).join(' ')
                    );
                } else {
                    jQuery('#meta_traits_emitted').html('<span class="text-muted">—</span>');
                }
            } catch (e) {
                jQuery('#meta_traits_emitted').text(String(meta.traits_emitted_json));
            }
        } else {
            jQuery('#meta_traits_emitted').html('<span class="text-muted">—</span>');
        }
        */
    }

    // -------------------------------------------------------
    // 2. Child-row formatter (mirrors format() in image_analysis.mas)
    //    Renders the per-object / per-image detail table.
    // -------------------------------------------------------
    function tissueSampleLink(image) {
        var name = image.tissue_sample_name;
        var id   = image.tissue_sample_id;   // tissue sample stock_id

        if (!name) {
            return '<span class="text-muted">—</span>';
        }
        if (id) {
            return '<a href="/stock/' + id + '/view">' + name + '</a>';
        }
        return name;
    }

    function format(d) {
        var detail_rows = '';
        var name_header = 'Object Name';

        (d.details || []).forEach(function (image) {
            var result = image.analyzed_link;
            var text;
            var name;

            if (result && String(result).startsWith('Error: ')) {
                text = result;
                name = image.object_name || image.image_name;
                name_header = image.object_name ? 'Object Name' : 'Image Name';
            } else if (Object.prototype.hasOwnProperty.call(image, 'object_name')) {
                text = '';
                name_header = 'Object Name';
                name = image.object_name;
            } else {
                text = result ? '<img src="' + result + '" width="100">' : '';
                name_header = 'Image Name';
                name = image.image_name;
            }

            detail_rows +=
                '<tr>' +
                    '<td>' + (name  != null ? name  : '') + '</td>' +
                    '<td>' + tissueSampleLink(image) + '</td>' +
                    '<td>' + (text  != null ? text  : '') + '</td>' +
                    '<td>' + (image.value != null ? image.value : '') + '</td>' +
                '</tr>';
        });

        return '<table class="table">' +
                   '<thead>' +
                       '<tr>' +
                           '<th scope="col">' + name_header + '</th>' +
                           '<th scope="col">Tissue Sample</th>' +
                           '<th scope="col">Analyzed Image</th>' +
                           '<th scope="col">Value</th>' +
                       '</tr>' +
                   '</thead>' +
                   '<tbody>' + detail_rows + '</tbody>' +
               '</table>';
    }

    // -------------------------------------------------------
    // 3. Load object results table for this run project
    //    Expects a backend endpoint that returns table_data in the
    //    same shape as image_analysis.mas: an array of rows with
    //    observationUnitName, observationVariableName, numberAnalyzed,
    //    value, and a details[] array (object_name/image_name,
    //    analyzed_link, value).
    // -------------------------------------------------------
    function loadObjectResults() {
        jQuery('#object_results_loading').show();

        jQuery.ajax({
            url: '/ajax/image_analysis/run_object_results',
            method: 'GET',
            data: { run_project_id: run_project_id },
            success: function (response) {
                jQuery('#object_results_loading').hide();

                if (response.error) {
                    console.error(response.error);
                    return;
                }

                var table_data = response.table_data || response.results || [];

                if (jQuery.fn.DataTable.isDataTable('#image_analysis_result_table')) {
                    jQuery('#image_analysis_result_table').DataTable().destroy();
                }

                var table = jQuery('#image_analysis_result_table').DataTable({
                    "destroy": true,
                    "data": table_data,
                    "dom": 'Bfrtip',
                    "buttons": ['copy', 'excel', 'csv', 'pdf'],
                    "columns": [
                        {
                            "className":      'details-control',
                            "orderable":      false,
                            "data":           null,
                            "defaultContent": '',
                            "render": function () {
                                return '<i class="fa fa-plus-square" aria-hidden="true"></i>';
                            },
                            "width": "15px"
                        },
                        { "data": "observationUnitName" },
                        { "data": "observationVariableName" },
                        { "data": "numberAnalyzed" },
                        { "data": "value" }
                    ],
                    "order": [[1, 'asc']]
                });

                // Expand / collapse detail rows (same behavior as image_analysis.mas)
                jQuery('#image_analysis_result_table tbody')
                    .off('click', 'td.details-control')
                    .on('click', 'td.details-control', function () {
                        var tr  = jQuery(this).closest('tr');
                        var tdi = tr.find("i.fa");
                        var row = table.row(tr);

                        if (row.child.isShown()) {
                            row.child.hide();
                            tr.removeClass('shown');
                            tdi.first().removeClass('fa-minus-square');
                            tdi.first().addClass('fa-plus-square');
                        } else {
                            row.child(format(row.data())).show();
                            tr.addClass('shown');
                            tdi.first().removeClass('fa-plus-square');
                            tdi.first().addClass('fa-minus-square');
                        }
                    });
            },
            error: function (xhr) {
                jQuery('#object_results_loading').hide();
                console.error('Failed to load object results:', xhr.responseText);
            }
        });
    }

    // -------------------------------------------------------
    // 4. Init
    // -------------------------------------------------------
    renderMetadata();
    loadObjectResults();

});
</script>
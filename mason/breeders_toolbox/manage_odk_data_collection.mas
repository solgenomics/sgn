<%init>
use HTML::Entities ();
# Translate whole sentences while keeping link markup outside language data.
my $odk_linked_text = sub {
    my ($text, $marker, $link) = @_;
    my $html = HTML::Entities::encode_entities($text, q{&<>"'});
    $html =~ s/\Q$marker\E/$link/g;
    return $html;
};
</%init>

<%args>
$odk_crossing_data_service_name => undef
$odk_crossing_data_service_url => undef
$odk_crossing_data_test_form_name => undef
$odk_phenotyping_data_service_name => undef
$odk_phenotyping_data_service_url => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jstree.dist.jstree', 'd3.d3Min', 'SGN.Scatterplot' ] &>

<& /util/import_css.mas, paths => ['/static/documents/inc/jstree_theme/jstree-bstheme-min.css'] &>


<style>
.sgn-odk-page { max-inline-size: 100%; overflow-wrap: anywhere; }
.sgn-odk-page .btn { max-inline-size: 100%; white-space: normal; overflow-wrap: anywhere; }
.sgn-odk-page .sub_infosectionhead { table-layout: fixed; inline-size: 100%; }
.sgn-odk-page .sub_infosectiontitle { white-space: normal; overflow-wrap: anywhere; }
.sgn-odk-page div.dataTables_wrapper div.dataTables_filter label,
.sgn-odk-page div.dataTables_wrapper div.dataTables_length label {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.25em;
    max-inline-size: 100%; white-space: normal; text-align: start;
}
.sgn-odk-page div.dataTables_wrapper div.dataTables_filter input {
    inline-size: 100%; max-inline-size: 100%; min-inline-size: 0; margin-inline-start: 0;
}
.sgn-odk-page div.dataTables_wrapper div.dataTables_length select { max-inline-size: 100%; }
.sgn-odk-page .dataTables_info { overflow-wrap: anywhere; text-align: start; }
.sgn-odk-page .dataTables_paginate .pagination { display: flex; flex-wrap: wrap; max-inline-size: 100%; }
.sgn-odk-page .dataTables_paginate .pagination > li { display: block; max-inline-size: 100%; min-inline-size: 0; }
.sgn-odk-page .dataTables_paginate .pagination > li > a {
    float: none; display: block; white-space: normal; overflow-wrap: anywhere; max-inline-size: 100%;
}
.sgn-odk-page .dataTables_scrollBody:focus { outline: 2px solid #337ab7; outline-offset: 2px; }
@media (max-width: 767px) {
    .sgn-odk-page .sub_infosectioncontent { margin-inline: 0; padding-inline: 0; }
}
/* Keep translated tree labels readable without widening the surrounding page. */
.sgn-odk-page #odk_cross_progress_tree_div { max-inline-size: 100%; overflow-x: auto; }
.sgn-odk-page #odk_cross_progress_tree_div .jstree-node { white-space: normal; min-inline-size: 0; background-image: none; }
.sgn-odk-page #odk_cross_progress_tree_div .jstree-anchor {
    box-sizing: border-box; max-inline-size: calc(100% - 30px);
    white-space: normal; overflow-wrap: anywhere; block-size: auto; min-block-size: 24px;
}
.sgn-odk-page #odk_cross_progress_tree_div .jstree-anchor:focus { outline: 2px solid #337ab7; outline-offset: -2px; }
</style>

<div class="sgn-odk-page">
<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('odk.ui.title', 'Manage ODK Data Collection'), q{&<>"'}) &>

<div class="container-fluid">

<div class="well">
<h4><% $c->i18n->p('odk.about.title', 'What is ODK?') |h %></h4>
<ul><li><% $c->i18n->p('odk.about.mobile', 'ODK is an application that allows mobile data collection using user defined forms on Android or IOS devices.') |h %> <% $c->i18n->p('odk.about.sync', 'Data collected on the device can be instantaneously synched to the ODK server.') |h %> <% $odk_linked_text->($c->i18n->p('odk.about.site', 'To find out more go to the %{site}.', {site => '__SGN_ODK_SITE__'}), '__SGN_ODK_SITE__', '<a href="https://opendatakit.org/">'.HTML::Entities::encode_entities($c->i18n->p('odk.about.site_label', 'ODK site'), q{&<>"'}).'</a>') %> <% $c->i18n->p('odk.about.services', 'Many services have developed web interfaces to better streamline the ODK experience.') |h %> <% $c->i18n->p('odk.about.services_help', 'These services assist in creating forms, deploying forms to your mobile application, and visualizing data uploaded back from the mobile device.') |h %> <% $odk_linked_text->($c->i18n->p('odk.about.partner', 'Currently we are working with %{service} as an ODK service.', {service => '__SGN_ODK_PARTNER__'}), '__SGN_ODK_PARTNER__', '<a href="https://ona.io/home/">ONA</a>') %></li></ul>
<h4><% $c->i18n->p('odk.about.actions', 'What do I do from this page?') |h %></h4>
<ul>
<li><% $c->i18n->p('odk.about.crossing', 'ONA is currently being used for collecting crossing information. This requires exporting a crossing plan from here to the ONA server. The crossing plan guides collection of cross information and this data is synched with ONA using ODK. From here, we run a script twice a day, which pulls data on ONA into our database.') |h %>
</li>
<!--
<li>SMAP is currently being used for collecting phenotype information. The user collects phenotypes using a form they previously created. The questions in the form map directly to terms in the ontology. As they collect data on the mobile device, the data is synched to SMAP. From here, we run a script twice a day, which pulls data on SMAP into our database.
</li>
-->
</ul>
</div>


<script>

var odkI18n = (window.SGN && window.SGN.i18n) || {
    p: function(context, source, vars) {
        return String(source).replace(/%\{([A-Za-z_][A-Za-z0-9_]*)\}/g, function(marker, name) {
            return vars && Object.prototype.hasOwnProperty.call(vars, name) ? String(vars[name]) : marker;
        });
    }
};
function odkHTML(value) {
    return String(value == null ? "" : value).replace(/[&<>"']/g, function(c) {
        return {"&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;"}[c];
    });
}

// Shared caches hold canonical text; only this disposable widget view is translated.
function odkTreeView(nodes) {
    var view = JSON.parse(JSON.stringify(nodes));
    function scalar(value) {
        return typeof value === 'string' || (typeof value === 'number' && isFinite(value));
    }
    function fields(value, names) {
        return value && typeof value === 'object' && !Array.isArray(value) && names.every(function(name) {
            return Object.prototype.hasOwnProperty.call(value, name) && scalar(value[name]);
        });
    }
    function text(node) {
        var meta = node.sgn_i18n;
        if (!meta || meta.version !== 1 || !fields(meta, ['kind']) || !fields(meta.vars, [])) return null;
        var vars = meta.vars;
        switch (meta.kind) {
        case 'wishlist_entry_no_crosses':
        case 'crossed_wishlist_entry':
        case 'possibly_crossed_wishlist_entry':
            if (!fields(vars, ['entry']) || !fields(meta.tooltip, ['female', 'plot', 'males'])) return null;
            var title = odkI18n.p('odk.tree.planned_parents', 'Planned Female Accession: %{female}. Planned Female Plot: %{plot}. Planned Male Accession(s): %{males}.', meta.tooltip);
            var label, order, css = '';
            if (meta.kind === 'wishlist_entry_no_crosses') {
                label = odkI18n.p('odk.tree.wishlist_entry_no_crosses', 'Wishlist Entry: %{entry} : No Crosses', vars);
                order = '2';
            } else if (meta.kind === 'crossed_wishlist_entry') {
                label = odkI18n.p('odk.tree.crossed_wishlist_entry', 'Crossed Wishlist Entry: %{entry}', vars);
                order = '0'; css = ' class="text-success"';
            } else {
                label = odkI18n.p('odk.tree.possibly_crossed_wishlist_entry', 'Possibly Crossed Wishlist Entry: %{entry}: Cross Performed But Not On This Wishlist Female Plot', vars);
                order = '1';
            }
            return '<span order-field="' + order + '" title="' + odkHTML(title) + '"' + css + '>' + odkHTML(label) + '</span>';
        case 'wishlist_female_accession':
            return fields(vars, ['name']) ? odkHTML(odkI18n.p('odk.tree.wishlist_female_accession', 'Wishlist Female Accession: %{name}', vars)) : null;
        case 'wishlist_female_plot':
            if (!fields(vars, ['name'])) return null;
            var plot = odkHTML(odkI18n.p('odk.tree.wishlist_female_plot', 'Wishlist Female Plot: %{name}', vars));
            if (Object.prototype.hasOwnProperty.call(meta, 'status')) {
                if (!meta.status || !fields(meta.status, []) ||
                    !(meta.status.attachment == null || scalar(meta.status.attachment)) ||
                    !(meta.status.value == null || scalar(meta.status.value))) return null;
                // Existing attachment HTML is opaque vendor output, never translation data.
                plot += ' : ' + String(meta.status.attachment == null ? '' : meta.status.attachment) + ' : ' +
                    odkHTML(odkI18n.p('odk.tree.plot_status', 'STATUS = %{status}', {status: meta.status.value == null ? '' : meta.status.value}));
            }
            return plot;
        case 'wishlist_male_accession':
            return fields(vars, ['name']) ? odkHTML(odkI18n.p('odk.tree.wishlist_male_accession', 'Wishlist Male Accession: %{name}', vars)) : null;
        case 'cross_name':
            return fields(vars, ['name']) ? odkHTML(odkI18n.p('odk.tree.cross_name', 'Cross Name: %{name}', vars)) : null;
        case 'no_crosses':
            return odkHTML(odkI18n.p('odk.tree.no_crosses', 'No Crosses'));
        case 'no_crosses_performed':
            return odkHTML(odkI18n.p('odk.tree.no_crosses_performed', 'No Crosses Performed'));
        default:
            return null;
        }
    }
    function visit(node) {
        if (!node || typeof node !== 'object' || Array.isArray(node)) return;
        if (typeof node.text === 'string') {
            var translated = text(node);
            if (translated !== null) {
                node.sgn_canonical_text = node.text;
                node.text = translated;
            }
        }
        if (Array.isArray(node.children)) node.children.forEach(visit);
    }
    if (Array.isArray(view)) view.forEach(visit);
    return view;
}

function odkLocaleHeaders(url) {
    try {
        var destination = new URL(url, window.location.href);
        if (destination.origin !== window.location.origin) return {};
        var locale = odkI18n.requestedLocale || document.documentElement.getAttribute("data-sgn-locale") || "en";
        return {"X-SGN-Locale": /^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$/.test(locale) ? locale : "en"};
    } catch (error) { return {}; }
}


// Per-table DataTables presentation; native macros stay canonical.
function odkTableLanguage() {
    return {
        sEmptyTable: odkHTML(odkI18n.p("odk.table.empty", "No data available in table")),
        sInfo: odkHTML(odkI18n.p("odk.table.info", "Showing %{start} to %{end} of %{total} entries", {start: '_START_', end: '_END_', total: '_TOTAL_'})),
        sInfoEmpty: odkHTML(odkI18n.p("odk.table.info_empty", "Showing 0 to 0 of 0 entries")),
        sInfoFiltered: odkHTML(odkI18n.p("odk.table.filtered", "(filtered from %{maximum} total entries)", {maximum: '_MAX_'})),
        sLengthMenu: odkHTML(odkI18n.p("odk.table.length", "Show %{menu} entries", {menu: '_MENU_'})),
        sLoadingRecords: odkHTML(odkI18n.p("odk.table.loading", "Loading...")),
        sProcessing: odkHTML(odkI18n.p("odk.table.processing", "Processing...")),
        sSearch: odkHTML(odkI18n.p("odk.table.search", "Search:")),
        sZeroRecords: odkHTML(odkI18n.p("odk.table.zero", "No matching records found")),
        oPaginate: {
            sFirst: odkHTML(odkI18n.p("odk.table.first", "First")),
            sLast: odkHTML(odkI18n.p("odk.table.last", "Last")),
            sNext: odkHTML(odkI18n.p("odk.table.next", "Next")),
            sPrevious: odkHTML(odkI18n.p("odk.table.previous", "Previous"))
        },
        oAria: {
            sSortAscending: odkI18n.p("odk.table.sort_ascending", ": activate to sort column ascending"),
            sSortDescending: odkI18n.p("odk.table.sort_descending", ": activate to sort column descending")
        }
    };
}

// The native scroll body keeps wide scientific data keyboard-reachable.
function odkTableRegion(selector, labelId) {
    var table = document.querySelector(selector);
    var wrapper = table && table.closest('.dataTables_wrapper');
    var region = wrapper && wrapper.querySelector('.dataTables_scrollBody');
    if (region) {
        region.setAttribute('role', 'region');
        region.setAttribute('tabindex', '0');
        region.setAttribute('aria-labelledby', labelId);
    }
}

jQuery(document).ready(function () {

    jQuery.ajax ( {
        url : '/ajax/odk/get_crossing_available_forms',
        headers: odkLocaleHeaders("/ajax/odk/get_crossing_available_forms"),
        beforeSend: function() {
            jQuery("#working_modal").modal("show");
        },
        success: function(response){
            console.log(response);
            jQuery("#working_modal").modal("hide");

            if (response.error){
                alert(response.error);
            }
            if (response.success){

                jQuery.ajax ({
                    url : '/ajax/odk/get_crossing_saved_ona_forms',
                    headers: odkLocaleHeaders("/ajax/odk/get_crossing_saved_ona_forms"),
                    success: function(response_forms){
                        console.log(response_forms);

                        if (response_forms.error){
                            alert(response.error);
                        }
                        if (response_forms.success){
                            var form_dropdown_select_html = '<select class="form-control" id="availabe_odk_crossing_forms">';
                            var allowed_forms = response_forms.odk_ona_forms;
                            allowed_forms.push('<% $c->config->{odk_crossing_data_test_form_name} %>');
                            var form_ids = [];
                            for(var i=0; i<response.forms.length; i++){
                                if (jQuery.inArray(response.forms[i].id_string, allowed_forms) != -1){
                                    form_dropdown_select_html = form_dropdown_select_html + '<option value="'+response.forms[i].id+'">'+response.forms[i].id_string+'</option>';
                                    form_ids.push(response.forms[i].id);
                                }
                            }
                            console.log(form_ids);
                            var first_form_id = form_ids[0];
                            form_dropdown_select_html = form_dropdown_select_html + '</select>';
                            jQuery('#import_odk_cross_data_available_forms').html(form_dropdown_select_html);

                            jQuery.ajax ({
                                url : '/ajax/odk/get_odk_cross_summary_cached?form_id='+first_form_id,
                                headers: odkLocaleHeaders("/ajax/odk/get_odk_cross_summary_cached"),
                                success: function(response){
                                    console.log(response);
                                    summary = response.summary;
                                    plot_data_fill = [];
                                    html = '<table id="odk_cross_info_status_table" class="table table-hover table-bordered"><thead><tr><th>' + odkHTML(odkI18n.p("odk.table.cross_information", "Cross Information")) + '</th><th>' + odkHTML(odkI18n.p("odk.table.seed_graphs", "Seeds Produced Graphs")) + '</th></tr></thead><tbody>';
                                    for (var top_level in summary) {
                                        if (summary.hasOwnProperty(top_level)) {
                                            for (var cross_name in summary[top_level]){
                                                if (summary[top_level].hasOwnProperty(cross_name)){
                                                    html = html + '<tr><td><h3>'+cross_name+'</h3>';
                                                    var cross = summary[top_level][cross_name];
                                                    //console.log(cross);
                                                    var plot_data = [];
                                                    for (var activity in cross){
                                                        if (cross.hasOwnProperty(activity)){
                                                            html = html + '<b>'+activity + ' ('+cross[activity].length+')</b>: <br/>';
                                                            for (var i=0; i<cross[activity].length; i++){
                                                                var action = cross[activity][i];
                                                                for (var attr in action){
                                                                    if (action.hasOwnProperty(attr)){
                                                                        html = html + '&nbsp;&nbsp;&nbsp;&nbsp;<small>'+attr + ': ' +action[attr]+"</small><br/>";
                                                                    }
                                                                }
                                                                html = html + '&nbsp;&nbsp;&nbsp;&nbsp;----</br>';

                                                                if (activity == 'seedExtraction'){
                                                                    var date = action['extraction_date'].replace('-','').replace('-','').replace('/','').replace('/','');
                                                                    var datum = { "type":activity, "label":"Total Seeds Extracted", "displayLabel":odkI18n.p("odk.plot.seeds_extracted", "Total Seeds Extracted"), "x_pos":parseInt(date), "y_pos":parseInt(action['total_seeds_extracted']) };
                                                                    plot_data.push(datum);
                                                                }
                                                                if (activity == 'embryoRescue'){
                                                                    var date = action['embryorescue_date'].replace('-','').replace('-','').replace('/','').replace('/','');
                                                                    var datum = { "type":activity, "label":"Good Seeds", "displayLabel":odkI18n.p("odk.plot.good_seeds", "Good Seeds"), "x_pos":parseInt(date), "y_pos":parseInt(action['good_seeds']) };
                                                                    plot_data.push(datum);
                                                                    var datum = { "type":activity, "label":"Bad Seeds", "displayLabel":odkI18n.p("odk.plot.bad_seeds", "Bad Seeds"), "x_pos":parseInt(date), "y_pos":parseInt(action['bad_seeds']) };
                                                                    plot_data.push(datum);
                                                                    var datum = { "type":activity, "label":"Embryo Rescued Seeds", "displayLabel":odkI18n.p("odk.plot.embryo_rescued", "Embryo Rescued Seeds"), "x_pos":parseInt(date), "y_pos":parseInt(action['embryorescue_seeds']) };
                                                                    plot_data.push(datum);
                                                                }
                                                                if (activity == 'screenhouse_humiditychamber'){
                                                                    var date = action['screenhse_transfer_date'].replace('-','').replace('-','').replace('/','').replace('/','');
                                                                    var datum = { "type":activity, "label":"Screenhouse Humidity Chamber", "displayLabel":odkI18n.p("odk.plot.humidity_chamber", "Screenhouse Humidity Chamber"), "x_pos":parseInt(date), "y_pos":1 };
                                                                    plot_data.push(datum);
                                                                }
                                                                if (activity == 'rooting'){
                                                                    var date = action['rooting_date'].replace('-','').replace('-','').replace('/','').replace('/','');
                                                                    var datum = { "type":activity, "label":"Rooting", "displayLabel":odkI18n.p("odk.plot.rooting", "Rooting"), "x_pos":parseInt(date), "y_pos":1 };
                                                                    plot_data.push(datum);
                                                                }
                                                                if (activity == 'hardening'){
                                                                    var date = action['hardening_date'].replace('-','').replace('-','').replace('/','').replace('/','');
                                                                    var datum = { "type":activity, "label":"Hardening", "displayLabel":odkI18n.p("odk.plot.hardening", "Hardening"), "x_pos":parseInt(date), "y_pos":1 };
                                                                    plot_data.push(datum);
                                                                }
                                                                if (activity == 'contamination'){
                                                                    var date = action['lab_contamination_date'].replace('-','').replace('-','').replace('/','').replace('/','');
                                                                    var datum = { "type":activity, "label":"Contamination", "displayLabel":odkI18n.p("odk.plot.contamination", "Contamination"), "x_pos":parseInt(date), "y_pos":1 };
                                                                    plot_data.push(datum);
                                                                }
                                                                if (activity == 'subculture'){
                                                                    var date = action['subculture_date'].replace('-','').replace('-','').replace('/','').replace('/','');
                                                                    var datum = { "type":activity, "label":"Subcultures Count", "displayLabel":odkI18n.p("odk.plot.subcultures", "Subcultures Count"), "x_pos":parseInt(date), "y_pos":parseInt(action['subcultures_count']) };
                                                                    plot_data.push(datum);
                                                                }
                                                                if (activity == 'germinating_after_2wks'){
                                                                    var date = action['germinating_2wks_date'].replace('-','').replace('-','').replace('/','').replace('/','');
                                                                    var datum = { "type":activity, "label":"Active Seeds 2weeks", "displayLabel":odkI18n.p("odk.plot.active_two_weeks", "Active Seeds 2weeks"), "x_pos":parseInt(date), "y_pos":parseInt(action['actively_2wks']) };
                                                                    plot_data.push(datum);
                                                                }
                                                                if (activity == 'germinating_after_8weeks'){
                                                                    var date = action['germinating_8wksdate'].replace('-','').replace('-','').replace('/','').replace('/','');
                                                                    var datum = { "type":activity, "label":"Active Seeds 8weeks", "displayLabel":odkI18n.p("odk.plot.active_eight_weeks", "Active Seeds 8weeks"), "x_pos":parseInt(date), "y_pos":parseInt(action['active_8weeks']) };
                                                                    plot_data.push(datum);
                                                                }
                                                            }
                                                        }
                                                    }
                                                    //console.log(plot_data);
                                                    cross_name_clean = cross_name.replace('/', '').replace('(', '').replace(')','');
                                                    var div_id = encodeURI(cross_name_clean)+'_plot_div';
                                                    plot_data_fill.push([plot_data, div_id]);
                                                    html = html + '</td><td><div id="'+div_id+'"></div></td></tr>';
                                                }
                                            }
                                        }
                                    }
                                    html = html + '</tbody></table>';
                                    jQuery('#odk_cross_progress_summary_div').html(html);
                                    for (var i=0; i<plot_data_fill.length; i++){
                                        if (plot_data_fill[i][0].length > 0){
                                            SGND3ScatterPlot(plot_data_fill[i][0], plot_data_fill[i][1], odkI18n.p("odk.plot.activity_date", "Date of Activity"));
                                        }
                                    }
                                    jQuery('#odk_cross_info_status_table').DataTable({
                                        language: odkTableLanguage(),
                                        scrollX: true,
                                        "order": [[ 0, "desc" ]]
                                    });
                                    odkTableRegion('#odk_cross_info_status_table', 'odk_cross_summary_title');

                                    var plant_status_html = '<table id="odk_cross_plant_status_table" class="table table-hover table-bordered"><thead><tr><th>' + odkHTML(odkI18n.p("odk.table.plot_name", "Plot Name")) + '</th><th>' + odkHTML(odkI18n.p("odk.table.date", "Date")) + '</th><th>' + odkHTML(odkI18n.p("odk.table.status", "Status")) + '</th></tr></thead><tbody>';
                                    var plant_status_summary = response.plant_status_summary;
                                    console.log(plant_status_summary);
                                    for (var plot_name in plant_status_summary){
                                        if (plant_status_summary.hasOwnProperty(plot_name)){
                                            var has_status = 0;
                                            for (var status_type in plant_status_summary[plot_name]){
                                                has_status = 1;
                                                if (plant_status_summary[plot_name].hasOwnProperty(status_type)){
                                                    var status = plant_status_summary[plot_name][status_type];
                                                    //console.log(status);
                                                    if (status_type == 'status'){
                                                        plant_status_html = plant_status_html + '<tr><td>' + plot_name + '</td><td>' + status['status_date'] + '</td><td><b>' + odkHTML(odkI18n.p("odk.status.status", "Status:")) + '</b><br/>' + odkHTML(odkI18n.p("odk.status.accession_name", "Accession Name: ")) + '' + status['status_accession_name'] + '<br/>' + odkHTML(odkI18n.p("odk.status.trial_name", "Trial Name: ")) + '' + status['status_trial_name'] + '<br/>' + odkHTML(odkI18n.p("odk.status.user", "User: ")) + '' + status['status_user'] + '<br/>' + odkHTML(odkI18n.p("odk.status.location", "Status Location: ")) + '' + status['status_location'] + '<br/>' + odkHTML(odkI18n.p("odk.status.status_text", "Status: ")) + '' + status['status_message'] + '<br/>' + odkHTML(odkI18n.p("odk.status.note", "Note: ")) + '' + status['status_note'] + '<br/>' + odkHTML(odkI18n.p("odk.status.image", "Image: ")) + '' + status['attachment_display_thumb'] + '<br/></td></tr>';
                                                    }
                                                    if (status_type == 'flowering'){
                                                        plant_status_html = plant_status_html + '<tr><td>' + plot_name + '</td><td>' + status['FieldActivities/Flowering/flowering_date'] + '</td><td><b>' + odkHTML(odkI18n.p("odk.status.flowering", "Flowering:")) + '</b><br/>' + odkHTML(odkI18n.p("odk.status.accession_name", "Accession Name: ")) + '' + status['FieldActivities/Flowering/flowerName'] + '<br/>' + odkHTML(odkI18n.p("odk.status.plant_sex", "Plant Sex: ")) + '' + status['FieldActivities/Flowering/plantSex'] + '<br/></td></tr>';
                                                    }
                                                }
                                            }
                                            if (has_status == 0){
                                                plant_status_html = plant_status_html+ '<tr><td>' + plot_name + '</td><td></td><td></td></tr>';
                                            }
                                        }
                                    }
                                    plant_status_html = plant_status_html + '</tbody></thead>';
                                    jQuery('#odk_cross_plant_status_progress_summary_div').html(plant_status_html);
                                    jQuery('#odk_cross_plant_status_table').DataTable({
                                        language: odkTableLanguage(),
                                        scrollX: true,
                                        "order": [[ 1, "desc" ]]
                                    });
                                    odkTableRegion('#odk_cross_plant_status_table', 'odk_cross_plant_status_summary_title');
                                },
                                error: function(response){
                                    alert(odkI18n.p("odk.client.summary_error", "Error retrieving available ODK cross summary"));
                                }
                            });

                            //Load ODK Cross Progress Tree
                            jQuery('#odk_cross_progress_tree_div').jstree({
                                "core": {
                                    'data' : {
                                        'url' : '/ajax/odk/get_odk_cross_progress_cached?form_id='+first_form_id,
                                        headers: odkLocaleHeaders("/ajax/odk/get_odk_cross_progress_cached"),
                                        dataFilter: function(raw) {
                                            return JSON.stringify(odkTreeView(JSON.parse(raw)));
                                        },
                                        'data' : function (node) {
                                            return { 'id' : node.id };
                                        }
                                    },
                                    'themes': { 'name': 'proton', 'responsive': true}
                                },
                                "search" : {
                                    "case_insensitive" : true,
                                },
                                "plugins" : ["html_data","search","sort"],
                            });

                            jQuery("#odk_cross_progress_tree_search").keyup(function() {
                                var v = jQuery("#odk_cross_progress_tree_search").val();
                                jQuery("#odk_cross_progress_tree_div").jstree(true).search(v);
                            });
                        }
                    },
                    error: function(response_forms){
                        alert(odkI18n.p("odk.client.saved_forms_error", "Error retrieving saved ODK ONA forms"));
                    }
                });

            }
        },
        error: function(response){
            jQuery("#working_modal").modal("hide");
            alert(odkI18n.p("odk.client.available_forms_error", "Error retrieving available ODK crossing forms"));
        }
    });

    jQuery.ajax ( {
        url : '/ajax/odk/get_crossing_data_cronjobs',
        headers: odkLocaleHeaders("/ajax/odk/get_crossing_data_cronjobs"),
        beforeSend: function() {
            jQuery("#working_modal").modal("show");
        },
        success: function(response){
            console.log(response);
            jQuery("#working_modal").modal("hide");

            if (response.error){
                alert(response.error);
            }
            if (response.success){
                var html = odkHTML(odkI18n.p("odk.ui.not_set", "Not Set"));
                if (response.entries[0] == '0-59/1 * * * * '){
                    html = '<input type="text" disabled value="' + odkHTML(odkI18n.p("odk.ui.once_minute", "Once per minute")) + '" class="form-control" />';
                }
                if (response.entries[0] == '1 0 * * * '){
                    html = '<input type="text" disabled value="' + odkHTML(odkI18n.p("odk.ui.once_daily", "Once per day at midnight")) + '" class="form-control" />';
                }
                if (response.entries[0] == '0 * * * * '){
                    html = '<input type="text" disabled value="' + odkHTML(odkI18n.p("odk.ui.once_hourly", "Once per hour")) + '" class="form-control" />';
                }
                if (response.entries[0] == '0 0,12 * * * '){
                    html = '<input type="text" disabled value="' + odkHTML(odkI18n.p("odk.ui.twice_daily", "Twice daily at midnight and noon")) + '" class="form-control" />';
                }
                jQuery('#scheduled_odk_cross_import_time').html(html);
            }
        },
        error: function(response){
            jQuery("#working_modal").modal("hide");
        }
    });

    jQuery('#import_odk_phenotype_data').click( function(){
        jQuery.ajax ( {
            url : '/ajax/odk/get_phenotyping_data?form_id='+jQuery('#availabe_odk_phenotyping_forms').val(),
            headers: odkLocaleHeaders("/ajax/odk/get_phenotyping_data"),
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response){
                //console.log(response);
                jQuery("#working_modal").modal("hide");

                if (response.error){
                    alert(response.error);
                }
                alert(odkI18n.p("odk.client.phenotyping_unavailable", "Not currently working."));
            },
            error: function(response){
                jQuery("#working_modal").modal("hide");
                alert(odkI18n.p("odk.client.phenotyping_error", "Error retrieving ODK phenotyping data."));
            }
        });
    });

    jQuery('#import_odk_cross_data').click( function(){
        jQuery.ajax ( {
            url : '/ajax/odk/get_crossing_data?form_id='+jQuery('#availabe_odk_crossing_forms').val(),
            headers: odkLocaleHeaders("/ajax/odk/get_crossing_data"),
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response){
                console.log(response);
                jQuery("#working_modal").modal("hide");

                if (response.error){
                    alert(response.error);
                }
                location.reload();
            },
            error: function(response){
                jQuery("#working_modal").modal("hide");
                alert(odkI18n.p("odk.client.crossing_error", "Error retrieving ODK crossing data."));
            }
        });
    });

    jQuery('#schedule_import_odk_cross_data').click( function(){
        jQuery.ajax ( {
            url : '/ajax/odk/schedule_get_crossing_data?form_id='+jQuery('#availabe_odk_crossing_forms').val()+'&timing='+jQuery('#schedule_import_odk_crossing_form_data').val(),
            headers: odkLocaleHeaders("/ajax/odk/schedule_get_crossing_data"),
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response){
                console.log(response);
                jQuery("#working_modal").modal("hide");

                if (response.error){
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery("#working_modal").modal("hide");
                alert(odkI18n.p("odk.client.schedule_error", "Error scheduling import of ODK crossing data."));
            }
        });
    });

});

</script>

<div class="modal fade" id="sources_to_existing_seedlots_info_dialog" name="sources_to_existing_seedlots_info_dialog" tabindex="-1" role="dialog" aria-labelledby="sourcesToExistingSeedlotsInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="sourcesToExistingSeedlotsInfoDialog">Upload Template Information For Accession/Cross to Existing Seedlot Transactions  </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b>Header:</b>
                    <br>
                    The first row (header) must contain the following:
                    <br />
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>from_source_name</td>
                                <td>to_seedlot_name</td>
                                <td>amount</td>
                                <td>weight_gram</td>
                                <td>operator_name</td>
                                <td>transaction_description</td>
                            </tr>
                        </tbody>
                    </table>
                    <b>Required fields:</b>
                    <ul>
                        <li><b>from_source_name:</b> Must be the same as the corresponding seedlot content.</li>
                        <li><b>to_seedlot_name:</b> Must exist in the database.</li>
                        <li>
                            <b>amount:</b> Number of seeds being added. Can be provided in conjunction with weight_gram. Must provide a value for amount or weight_gram or both.
                            <br/><b>AND/OR</b><br/>
                            <b>weight_gram:</b> Weight in grams of seedlot being added. Can be provided in conjunction with amount. Must provide a value for amount or weight_gram or both.
                        </li>
                        <li><b>operator_name:</b> Name of the person who oversaw the transaction process. Can be any name.</li>
                    </ul>
                    <b>Optional fields:</b>
                    <ul>
                        <li><b>transaction_description:</b> Information about why this transaction is processed.</li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Seedlot Transactions", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_accessions_crossses_to_seedlots_info_dialog" type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


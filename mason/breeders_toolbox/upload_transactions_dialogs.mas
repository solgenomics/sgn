hr.solid { border-top: 1px solid #bbb; }

</style>

<script>
// Optional language assets preserve the native workflow and raw data values.
var seedlotI18n = (window.SGN && window.SGN.i18n) || {
    p: function (context, source, variables) {
        return source.replace(/%\{([A-Za-z0-9_]+)\}/g, function (match, name) {
            return variables && Object.prototype.hasOwnProperty.call(variables, name) ? String(variables[name]) : match;
        });
    },
    np: function (context, one, many, count, variables) {
        return this.p(context, count === 1 ? one : many, variables);
    }
};
function seedlotHTML(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, function (character) {
        return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[character];
    });
}
// The locale is carried only by these source-traced, same-origin core routes.
function _sgnSeedlotLocaleHeaders(url) {
    try {
        var guardedURL = new URL(url, window.location.href);
        if (guardedURL.origin !== window.location.origin) return {};
        var admitted = /^\/ajax\/breeders\/(?:seedlots|seedlot\/[0-9]+(?:\/(?:edit|delete|transactions|transaction\/(?:add|[0-9]+(?:\/(?:edit|delete))?)))?|seedlot\/(?:discard|undo_discard)|seedlot-create|seedlot-upload|seedlot-inventory-upload|upload_transactions|add_transactions_using_list)\/?$/.test(guardedURL.pathname)
            || /^\/ajax\/seedlots\/(?:verify_delete_by_list|confirm_delete_by_list)$/.test(guardedURL.pathname)
            || /^\/ajax\/stock\/stock_related_seedlots\/[0-9]+$/.test(guardedURL.pathname)
            || /^\/ajax\/manage_accessions\/population_seedlots\/[0-9]+$/.test(guardedURL.pathname)
            || /^\/ajax\/accessions\/possible_seedlots$/.test(guardedURL.pathname)
            || /^\/ajax\/breeders\/program\/[0-9]+\/seedlots$/.test(guardedURL.pathname)
            || /^\/ajax\/breeders\/trial\/[0-9]+\/(?:seedlots_from_crossingtrial|seedlots|upload_used_seedlots)$/.test(guardedURL.pathname)
            || guardedURL.pathname === '/breeders/download_population_seedlots_action';
        if (!admitted) return {};
        var root = typeof document !== 'undefined' && document.documentElement;
        var runtime = window.SGN && window.SGN.i18n;
        var requested = root && typeof root.getAttribute === 'function' && root.getAttribute('data-sgn-locale');
        var locale = requested || (runtime && runtime.requestedLocale) || (root && root.lang) || (runtime && runtime.locale) || 'en';
        return {'X-SGN-Locale': typeof locale === 'string' && /^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$/.test(locale) ? locale : 'en'};
    } catch (error) {
        return {};
    }
}
function _sgnSeedlotLocaleURL(url) {
    try {
        var headers = _sgnSeedlotLocaleHeaders(url);
        if (!headers['X-SGN-Locale']) return url;
        var guardedURL = new URL(url, window.location.href);
        guardedURL.searchParams.set('lang', headers['X-SGN-Locale']);
        return guardedURL.pathname + guardedURL.search + guardedURL.hash;
    } catch (error) {
        return url;
    }
}


jQuery(document).ready(function(){

    jQuery("[name='transactions_upload_link']").click(function() {
        jQuery('#upload_transactions_dialog').modal("show");
        get_select_box('breeding_programs', 'new_seedlot_breeding_program_div', { 'name' : 'new_seedlot_breeding_program_id', 'id' : 'new_seedlot_breeding_program_id' });

    });

    jQuery("#new_seedlot_location").autocomplete({
       source: '/ajax/stock/geolocation_autocomplete',
    });

    jQuery("#transaction_type_option").change(function(){
        if (jQuery(this).val() == ""){
            jQuery("#seedlots_to_seedlots_section").hide();
            jQuery("#seedlots_to_new_seedlots_section").hide();
            jQuery("#seedlots_to_plots_section").hide();
            jQuery("#seedlots_to_unspecified_names_section").hide();
            jQuery("#submit_transactions_button_section").hide();
            jQuery("#sources_to_existing_seedlots_section").hide();
        }
        if (jQuery(this).val() == "seedlots_to_seedlots"){
            jQuery("#seedlots_to_seedlots_section").show();
            jQuery("#seedlots_to_new_seedlots_section").hide();
            jQuery("#seedlots_to_plots_section").hide();
            jQuery("#seedlots_to_unspecified_names_section").hide();
            jQuery("#sources_to_existing_seedlots_section").hide();
            jQuery("#submit_transactions_button_section").show();
        }
        if(jQuery(this).val() == "seedlots_to_new_seedlots"){
            jQuery("#seedlots_to_seedlots_section").hide();
            jQuery("#seedlots_to_new_seedlots_section").show();
            jQuery("#seedlots_to_plots_section").hide();
            jQuery("#seedlots_to_unspecified_names_section").hide();
            jQuery("#sources_to_existing_seedlots_section").hide();
            jQuery("#submit_transactions_button_section").show();
        }
        if (jQuery(this).val() == "seedlots_to_plots" ){
            jQuery("#seedlots_to_seedlots_section").hide();
            jQuery("#seedlots_to_new_seedlots_section").hide();
            jQuery("#seedlots_to_plots_section").show();
            jQuery("#seedlots_to_unspecified_names_section").hide();
            jQuery("#sources_to_existing_seedlots_section").hide();
            jQuery("#submit_transactions_button_section").show();
        }
        if (jQuery(this).val() == "seedlots_to_unspecified_names" ){
            jQuery("#seedlots_to_seedlots_section").hide();
            jQuery("#seedlots_to_new_seedlots_section").hide();
            jQuery("#seedlots_to_plots_section").hide();
            jQuery("#sources_to_existing_seedlots_section").hide();
            jQuery("#seedlots_to_unspecified_names_section").show();
            jQuery("#submit_transactions_button_section").show();
        }
        if (jQuery(this).val() == "sources_to_existing_seedlots" ){
            jQuery("#seedlots_to_seedlots_section").hide();
            jQuery("#seedlots_to_new_seedlots_section").hide();
            jQuery("#seedlots_to_plots_section").hide();
            jQuery("#seedlots_to_unspecified_names_section").hide();
            jQuery("#sources_to_existing_seedlots_section").show();
            jQuery("#submit_transactions_button_section").show();
        }
    });

    jQuery("#upload_transactions_submit").click(function() {
        upload_transactions_file();
    });

    jQuery("#seedlots_to_seedlots_format").click(function() {
        jQuery("#seedlots_to_seedlots_info_dialog").modal("show");
    });

    jQuery("#seedlots_to_new_seedlots_format").click(function() {
        jQuery("#seedlots_to_new_seedlots_info_dialog").modal("show");
    });

    jQuery("#seedlots_to_plots_format").click(function() {
        jQuery("#seedlots_to_plots_info_dialog").modal("show");
    });

    jQuery("#seedlots_to_unspecified_names_format").click(function() {
        jQuery("#seedlots_to_unspecified_names_info_dialog").modal("show");
    });

    jQuery("#sources_to_existing_seedlots_format").click(function() {
        jQuery("#sources_to_existing_seedlots_info_dialog").modal("show");
    });

    jQuery("[name='upload_transactions_dismiss_button']").click(function() {
        jQuery('#upload_transactions_dialog').modal('hide');
        jQuery('#transaction_type_option').val('');
        jQuery('#seedlots_to_seedlots_file').val('');
        jQuery('#seedlots_to_plots_file').val('');
        jQuery('#seedlots_to_new_seedlots_file').val('');
        jQuery('#seedlots_to_unspecified_names_file').val('');
        jQuery('#sources_to_existing_seedlots_file').val('');
        jQuery('#new_seedlot_location').val('');
        jQuery('#new_seedlot_organization_name').val('');
        location.reload();
    });

});

function upload_transactions_file() {

    var uploadSeedlotsToSeedlots = jQuery("#seedlots_to_seedlots_file").val();
    if (uploadSeedlotsToSeedlots === ''){
        var uploadSeedlotsToNewSeedlots = jQuery("#seedlots_to_new_seedlots_file").val();
        if (uploadSeedlotsToNewSeedlots === ''){
            var uploadSeedlotsToPlots = jQuery("#seedlots_to_plots_file").val();
            if (uploadSeedlotsToPlots === ''){
                var uploadSeedlotsToUnspecified = jQuery("#seedlots_to_unspecified_names_file").val();
                if (uploadSeedlotsToUnspecified === '') {
                    var uploadSourcesToExistingSeedlots = jQuery("#sources_to_existing_seedlots_file").val();
                    if (uploadSourcesToExistingSeedlots === '') {
                        alert(seedlotI18n.p("seedlots.ui.please_select_a_file", "Please select a file"));
                        return;
                    }
                }
            }
        }
    }

    if (uploadSeedlotsToNewSeedlots) {
        var breeding_program = jQuery("#new_seedlot_breeding_program_id").val();
        var location = jQuery("#new_seedlot_location").val();
        if (breeding_program === '') {
            alert(seedlotI18n.p("seedlots.ui.please_choose_a_breeding_program_for_new_seedlots", "Please choose a breeding program for new seedlots"));
            return;
        }
        if (location === '') {
            alert(seedlotI18n.p("seedlots.ui.please_give_a_location_for_new_seedlots", "Please give a location for new seedlots"));
            return;
        }
    }

    jQuery("#working_modal").modal("show");
    jQuery.ajax({
        url: _sgnSeedlotLocaleURL("/ajax/breeders/upload_transactions"),
        type: 'POST',
        data: new FormData(jQuery("#upload_transactions_form")[0]),
        processData: false,
        contentType: false,
        success: function(response) {
            jQuery("#working_modal").modal("hide");
            if (response.error_string) {
                jQuery("#upload_transactions_error_display tbody").html('');
                jQuery("#upload_transactions_error_display tbody").append(response.error_string);
                jQuery("#upload_transactions_error_display").modal("show");

                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                Workflow.focus("#transactions_upload_workflow", -1); //Go to success page
                Workflow.check_complete("#transactions_upload_workflow");
            }
        }
    });
}


</script>

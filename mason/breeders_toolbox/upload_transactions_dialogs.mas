<%args>

</%args>


<div class="modal fade" id="upload_transactions_dialog" name="upload_transactions_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadTransactionsDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="reset" class="close" id="upload_transactions_dismiss_button_1" name="upload_transactions_dismiss_button" aria-label="<% $c->i18n->p('seedlots.ui.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTransactionsDialog"><% $c->i18n->p('seedlots.ui.upload_transactions', 'Upload Transactions') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /util/workflow.mas, id=> "transactions_upload_workflow" &>
                        <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.intro', 'Intro')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.upload_seedlot_transactions', 'Upload Seedlot Transactions')) &>
                            <center><% $c->i18n->p('seedlots.ui.transaction_types_intro', 'You can upload %{count} different types of seedlot transactions. All of the transactions in each file have to be the same type.', {count => 4}) |h %></center>
                            <ul>
                                <li><% $c->i18n->p('seedlots.ui.transferring_seeds_from_existing_seedlot_to_another_existing_see', 'Transferring seeds from existing seedlot to another existing seedlot.') |h %></li>
                                <li><% $c->i18n->p('seedlots.ui.transferring_seeds_from_existing_seedlot_to_a_new_seedlot_a_new_', 'Transferring seeds from existing seedlot to a new seedlot. A new seedlot is created before adding new transaction.') |h %></li>
                                <li><% $c->i18n->p('seedlots.ui.removing_seeds_from_existing_seedlot_to_unspecified_seedlot_name', 'Removing seeds from existing seedlot to unspecified seedlot name or plot name') |h %></li>
                                <li><b><% $c->i18n->p('seedlots.ui.note_to_transfer_seeds_from_existing_seedlot_to_a_previously_sto', 'Note: To transfer seeds from existing seedlot to a previously stored plot, Please use Upload Seedlots Planted in Trial link in the Experimental Design section on the Trial Detail page.') |h %></b></li>
                                <li><% $c->i18n->p('seedlots.ui.add_sources_to_existing', 'Add additional seeds from accession or cross to existing seedlot') |h %></li>
                            </ul>
                            <br/><br/>
                            <center>
                                <button id="next_step_intro_button" class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p('seedlots.ui.go_to_next_step', 'Go to Next Step') |h %></button>
                            </center>
                        </&>
                        <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.upload_seedlot_transactions', 'Upload Seedlot Transactions')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.select_a_transaction_type_and_upload_your_file', 'Select a transaction type and upload your file')) &>
                            <br/>
                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_transactions_form" name="upload_transactions_form">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.transaction_type', 'Transaction Type:') |h %> </label>
                                    <div class="col-sm-9">
                                        <select class="form-control" id="transaction_type_option">
                                            <option value=""><% $c->i18n->p('seedlots.ui.select_a_transaction_type_that_you_want_to_upload', 'Select a transaction type that you want to upload') |h %></option>
                                            <option value="seedlots_to_seedlots"><% $c->i18n->p('seedlots.ui.from_existing_seedlots_to_other_existing_seedlots', 'From existing seedlots to other existing seedlots') |h %></option>
                                            <option value="seedlots_to_new_seedlots"><% $c->i18n->p('seedlots.ui.from_existing_seedlots_to_new_seedlots', 'From existing seedlots to new seedlots') |h %></option>
                                            <option value="seedlots_to_unspecified_names"><% $c->i18n->p('seedlots.ui.from_existing_seedlots_to_unpecified_seedlots_plots', 'From existing seedlots to unpecified seedlots/plots') |h %></option>
                                            <option value="sources_to_existing_seedlots"><% $c->i18n->p('seedlots.ui.sources_to_existing', 'From accessions or crosses to existing seedlots') |h %></option>
                                        </select>
                                    </div>
                                </div>
                                <div id="seedlots_to_seedlots_section" style="display:none">
                                    <br/>
                                    <hr class ="solid">
                                    <center>
                                        <h4><% $c->i18n->p('seedlots.ui.you_want_to_transfer_seeds_from_existing_seedlots_to_other_exist', 'You want to transfer seeds from existing seedlots to other existing seedlots') |h %></h4>
                                    </center>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.template_information', 'Template information')) &>
                                                    <p>
                                                        <b><% $c->i18n->p('seedlots.ui.file_format_information', 'File format information') |h %></b>
                                                        <br>
                                                        <a id="seedlots_to_seedlots_format"><% $c->i18n->p('seedlots.ui.spreadsheet_format', 'Spreadsheet format') |h %></a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label"><% $c->i18n->p('seedlots.ui.select_file', 'Select a File:') |h %> </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="seedlots_to_seedlots_file" id="seedlots_to_seedlots_file" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="seedlots_to_new_seedlots_section" style="display:none">
                                    <br/>
                                    <hr class ="solid">
                                    <center>
                                        <h4><b><% $c->i18n->p('seedlots.ui.please_provide_basic_information_about_the_new_seedlots_and_uplo', 'Please provide basic information about the new seedlots and upload your file') |h %></b></h4>
                                    </center>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label"><% $c->i18n->p('seedlots.ui.breeding_program.5983e34', 'Breeding Program:') |h %> </label>
                                            <div class="col-sm-8" >
                                                <div id="new_seedlot_breeding_program_div"></div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label"><% $c->i18n->p('seedlots.ui.location_of_seedlot_storage', 'Location of seedlot storage:') |h %> </label>
                                            <div class="col-sm-8" >
                                                <input class="form-control" name="new_seedlot_location" id="new_seedlot_location" placeholder="<% $c->i18n->p('seedlots.ui.required', 'Required') |h %>">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label"><% $c->i18n->p('seedlots.ui.organization_name', 'Organization Name:') |h %> </label>
                                            <div class="col-sm-8" >
                                                <input class="form-control" name="new_seedlot_organization_name" id="new_seedlot_organization_name" placeholder="<% $c->i18n->p('seedlots.ui.optional', 'Optional') |h %>">
                                            </div>
                                        </div>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.template_information', 'Template information')) &>
                                                    <p>
                                                        <b><% $c->i18n->p('seedlots.ui.file_format_information', 'File format information') |h %></b>
                                                        <br>
                                                        <a id="seedlots_to_new_seedlots_format"><% $c->i18n->p('seedlots.ui.spreadsheet_format', 'Spreadsheet format') |h %></a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label"><% $c->i18n->p('seedlots.ui.select_file', 'Select a File:') |h %> </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="seedlots_to_new_seedlots_file" id="seedlots_to_new_seedlots_file" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="seedlots_to_plots_section" style="display:none">
                                    <br/>
                                    <hr class ="solid">
                                    <center>
                                        <h4><% $c->i18n->p('seedlots.ui.you_want_to_use_seeds_from_existing_seedlots_for_plots', 'You want to use seeds from existing seedlots for plots') |h %></h4>
                                    </center>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.template_information', 'Template information')) &>
                                                    <p>
                                                        <b><% $c->i18n->p('seedlots.ui.file_format_information', 'File format information') |h %></b>
                                                        <br>
                                                        <a id="seedlots_to_plots_format"><% $c->i18n->p('seedlots.ui.spreadsheet_format', 'Spreadsheet format') |h %></a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label"><% $c->i18n->p('seedlots.ui.select_file', 'Select a File:') |h %> </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="seedlots_to_plots_file" id="seedlots_to_plots_file" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="seedlots_to_unspecified_names_section" style="display:none">
                                    <br/>
                                    <hr class ="solid">
                                    <center>
                                        <h4><% $c->i18n->p('seedlots.ui.you_want_to_remove_seeds_from_existing_seedlots_to_unspefified_s', 'You want to remove seeds from existing seedlots to unspecified seedlots/plots') |h %></h4>
                                    </center>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.template_information', 'Template information')) &>
                                                    <p>
                                                        <b><% $c->i18n->p('seedlots.ui.file_format_information', 'File format information') |h %></b>
                                                        <br>
                                                        <a id="seedlots_to_unspecified_names_format"><% $c->i18n->p('seedlots.ui.spreadsheet_format', 'Spreadsheet format') |h %></a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label"><% $c->i18n->p('seedlots.ui.select_file', 'Select a File:') |h %> </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="seedlots_to_unspecified_names_file" id="seedlots_to_unspecified_names_file" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div id="sources_to_existing_seedlots_section" style="display:none">
                                    <br/>
                                    <hr class ="solid">
                                    <center>
                                        <h4>You want to add more seeds from accessions/crosses to existing seedlots</h4>
                                    </center>
                                    <div class="well well-sm">
                                        <div class="row">
                                            <div class="col-sm-4">
                                                <&| /page/explanation.mas, title=>'Template information' &>
                                                    <p>
                                                        <b>File format information</b>
                                                        <br>
                                                        <a id="sources_to_existing_seedlots_format">Spreadsheet format</a>
                                                    </p>
                                                </&>
                                            </div>
                                            <div class="col-sm-8">
                                                <br/>
                                                <div class="panel panel-default">
                                                    <div class="panel-body">
                                                        <div class="form-group">
                                                            <label class="col-sm-6 control-label">Select a File: </label>
                                                            <div class="col-sm-6">
                                                                <input type="file" name="sources_to_existing_seedlots_file" id="sources_to_existing_seedlots_file" encoding="multipart/form-data" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                            <div id="submit_transactions_button_section" style="display:none">
                                <center>
                                    <button type="button" onclick="Workflow.complete(this, false);" class="btn btn-primary" name="upload_transactions_submit" id="upload_transactions_submit"><% $c->i18n->p('seedlots.ui.upload_file.3119218', 'Upload File') |h %></button>
                                </center>
                            </div>
                        </&>
                        <&| /util/workflow.mas:complete, title=> HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.complete', 'Complete')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.finished_your_transactions_are_now_in_the_database', 'Finished! Your transactions are now in the database')) &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                <% $c->i18n->p('seedlots.ui.the_transactions_file_was_uploaded_successfully', 'The transactions file was uploaded successfully') |h %>
                            </p>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="upload_transactions_dismiss_button_2" name="upload_transactions_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('seedlots.ui.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_transactions_error_display" name="upload_transactions_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadTransactionsErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('seedlots.ui.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadTransactionsErrorDialog"><% $c->i18n->p('seedlots.ui.upload_transactions_file_error', 'Upload Transactions File Error') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('seedlots.ui.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlots_to_seedlots_info_dialog" name="seedlots_to_seedlots_info_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlotsToseedlotsInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('seedlots.ui.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlotsToseedlotsInfoDialog"><% $c->i18n->p('seedlots.ui.upload_template_information_for_existing_seedlot_to_existing_see', 'Upload Template Information For Existing Seedlot to Existing Seedlot Transactions') |h %>  </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% $c->i18n->p('seedlots.ui.header', 'Header:') |h %></b>
                    <br>
                    <% $c->i18n->p('seedlots.ui.the_first_row_header_must_contain_the_following', 'The first row (header) must contain the following:') |h %>
                    <br />
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>from_seedlot_name</td>
                                <td>to_seedlot_name</td>
                                <td>amount</td>
                                <td>weight_gram</td>
                                <td>operator_name</td>
                                <td>transaction_description</td>
                            </tr>
                        </tbody>
                    </table>
                    <b><% $c->i18n->p('seedlots.ui.required_fields', 'Required fields:') |h %></b>
                    <ul>
                        <li><b>from_seedlot_name:</b> <% $c->i18n->p('seedlots.ui.must_exist_in_the_database_seeds_were_taken_from_this_seedlot', 'Must exist in the database. Seeds were taken from this seedlot.') |h %></li>
                        <li><b>to_seedlot_name:</b> <% $c->i18n->p('seedlots.ui.must_exist_in_the_database_seeds_were_added_to_this_seedlot', 'Must exist in the database. Seeds were added to this seedlot.') |h %></li>
                        <li>
                            <b>amount:</b> <% $c->i18n->p('seedlots.ui.number_of_seeds_being_transaferred_can_be_provided_in_conjunctio', 'Number of seeds being transaferred. Can be provided in conjunction with %{column_weight_g}. Must provide a value for %{column_amount} or %{column_weight_g} or both.', {column_weight_g => 'weight_gram', column_amount => 'amount'}) |h %>
                            <br/><b><% $c->i18n->p('seedlots.ui.and_or', 'AND/OR') |h %></b><br/>
                            <b>weight_gram:</b> <% $c->i18n->p('seedlots.ui.weight_in_grams_of_seedlot_being_transferred_can_be_provided_in_', 'Weight in grams of seedlot being transferred. Can be provided in conjunction with %{column_amount}. Must provide a value for %{column_amount} or %{column_weight_g} or both.', {column_weight_g => 'weight_gram', column_amount => 'amount'}) |h %>
                        </li>
                        <li><b>operator_name:</b> <% $c->i18n->p('seedlots.ui.name_of_the_person_who_oversaw_the_transaction_process_can_be_an', 'Name of the person who oversaw the transaction process. Can be any name.') |h %></li>
                    </ul>
                    <b><% $c->i18n->p('seedlots.ui.optional_fields', 'Optional fields:') |h %></b>
                    <ul>
                        <li><b>transaction_description:</b> <% $c->i18n->p('seedlots.ui.information_about_why_this_transaction_is_processed', 'Information about why this transaction is processed.') |h %></li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Seedlot Transactions", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_seedlots_to_seedlots_info_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('seedlots.ui.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlots_to_new_seedlots_info_dialog" name="seedlots_to_new_seedlots_info_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlotsToNewSeedlotsInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('seedlots.ui.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlotsToNewSeedlotsInfoDialog"><% $c->i18n->p('seedlots.ui.upload_template_information_for_existing_seedlot_to_new_seedlot_', 'Upload Template Information For Existing Seedlot to New Seedlot Transactions') |h %>  </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% $c->i18n->p('seedlots.ui.header', 'Header:') |h %></b>
                    <br>
                    <% $c->i18n->p('seedlots.ui.the_first_row_header_must_contain_the_following', 'The first row (header) must contain the following:') |h %>
                    <br />
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>from_seedlot_name</td>
                                <td>amount</td>
                                <td>weight_gram</td>
                                <td>operator_name</td>
                                <td>transaction_description</td>
                                <td>to_new_seedlot_name</td>
                                <td>new_seedlot_box_name</td>
                                <td>new_seedlot_description</td>
                                <td>new_seedlot_quality</td>
                            </tr>
                        </tbody>
                    </table>
                    <b><% $c->i18n->p('seedlots.ui.required_fields', 'Required fields:') |h %></b>
                    <ul>
                        <li><b>from_seedlot_name:</b> <% $c->i18n->p('seedlots.ui.must_exist_in_the_database_seeds_were_taken_from_this_seedlot', 'Must exist in the database. Seeds were taken from this seedlot.') |h %></li>
                        <li>
                            <b>amount:</b> <% $c->i18n->p('seedlots.ui.number_of_seeds_being_transaferred_can_be_provided_in_conjunctio', 'Number of seeds being transferred. Can be provided in conjunction with %{column_weight_g}. Must provide a value for %{column_amount} or %{column_weight_g} or both.', {column_weight_g => 'weight_gram', column_amount => 'amount'}) |h %>
                            <br/><b><% $c->i18n->p('seedlots.ui.and_or', 'AND/OR') |h %></b><br/>
                            <b>weight_gram:</b> <% $c->i18n->p('seedlots.ui.weight_in_grams_of_seedlot_being_transferred_can_be_provided_in_', 'Weight in grams of seedlot being transferred. Can be provided in conjunction with %{column_amount}. Must provide a value for %{column_amount} or %{column_weight_g} or both.', {column_weight_g => 'weight_gram', column_amount => 'amount'}) |h %>
                        </li>
                        <li><b>operator_name:</b> <% $c->i18n->p('seedlots.ui.name_of_the_person_who_oversaw_the_transaction_process_can_be_an', 'Name of the person who oversaw the transaction process. Can be any name.') |h %></li>
                        <li><b>to_new_seedlot_name:</b> <% $c->i18n->p('seedlots.ui.must_not_exist_in_the_database_new_seedlot_will_be_created_using', 'Must NOT exist in the database. New seedlot will be created using amount/weight of seeeds from existing seedlot.') |h %></li>
                        <li><b>new_seedlot_box_name:</b> <% $c->i18n->p('seedlots.ui.box_name_that_this_new_seedlot_is_stored_can_be_any_name', 'Box name that this new seedlot is stored. Can be any name.') |h %></li>
                    </ul>
                    <b><% $c->i18n->p('seedlots.ui.optional_fields', 'Optional fields:') |h %></b>
                    <ul>
                        <li><b>transaction_description:</b> <% $c->i18n->p('seedlots.ui.information_about_why_this_transaction_is_processed', 'Information about why this transaction is processed.') |h %></li>
                        <li><b>new_seedlot_description:</b> <% $c->i18n->p('seedlots.ui.information_about_this_new_seedlot', 'Information about this new seedlot.') |h %></li>
                        <li><b>new_seedlot_quality:</b> <% $c->i18n->p('seedlots.ui.status_or_condition_of_the_seedlot_for_example_ok_moldy_insect_d', 'Status or condition of the seedlot, for example "ok", "moldy", "insect damage" etc.') |h %></li>
                    </ul>

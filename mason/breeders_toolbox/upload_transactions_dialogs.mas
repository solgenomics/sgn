                <& /help/file_upload_type.mas, type => "Seedlot Transactions", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_seedlots_to_new_seedlots_info_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('seedlots.ui.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlots_to_plots_info_dialog" name="seedlots_to_plots_info_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlotsToPlotsInfoDialog">

<%doc>Accession Tracker</%doc>

<& /util/import_javascript.mas, classes => ['jquery', 'CXGN.BreedersToolbox.HTMLSelect'], entries => ['decision_meeting'] &>

<div class="well">
  <&| /page/info_section.mas, anchor_title => 'Accession — Decision Tracker',
     title=>HTML::Entities::encode_entities($c->i18n->p("decision.root.accession_decision_tracker", 'Accession — Decision Tracker')),
     is_subsection=>1, collapsible=>1, collapsed=>0,
     subtitle=>HTML::Entities::encode_entities($c->i18n->p("decision.root.track_decisions_per_accession_use_the_per_column_filters_below", 'Track decisions per accession. Use the per-column filters below the header.'))
  &>
    <div class="panel panel-default">
      <div class="panel-body">
        <div class="form-inline" style="margin-bottom:10px;">
          <!-- Breeding Program checkbox dropdown placeholder -->
          <div id="bp_filter_placeholder" class="btn-group" style="margin-left:12px;">
            <!-- JS will inject checkbox dropdown here -->
          </div>
        </div>
        <div class="table-responsive">
          <table id="decision_table" class="table table-striped table-bordered" width="100%">
            <thead>
              <tr>
                <th><% $c->i18n->p("global.index_logged_in_user.accession", "Accession") |h %></th>
                <th><% $c->i18n->p("global.index_logged_in_user.breeding_program", "Breeding Program") |h %></th>
                <th><% $c->i18n->p("decision.root.stage", "Stage") |h %></th>
                <th><% $c->i18n->p("accession.sequencing.table.year", "Year") |h %></th>
                <th><% $c->i18n->p("decision.root.decision", "Decision") |h %></th>
                <th><% $c->i18n->p("decision.root.new_stage", "New Stage") |h %></th>
                <th><% $c->i18n->p("accession.related_stock.header.female_parent", "Female Parent") |h %></th>
                <th><% $c->i18n->p("accession.related_stock.header.male_parent", "Male Parent") |h %></th>
                <th><% $c->i18n->p("cross.ui.notes", "Notes") |h %></th>
              </tr>
            </thead>
          </table>
        </div>

      </div>
    </div>
  </&>

  <&| /page/info_section.mas, anchor_title => 'Data Summary and Graphics',
       title=>HTML::Entities::encode_entities($c->i18n->p("decision.root.data_summary_and_graphics", 'Data Summary and Graphics')),
       is_subsection=>1, collapsible=>1, collapsed=>0,
       subtitle=>""
    &>
    <div class="panel panel-default">
      <div class="panel-body">
        <div class="form-inline" style="margin-bottom:10px;">
          <label for="dataset_select" class="control-label" style="margin-right:8px;"><% $c->i18n->p("decision.root.select_a_dataset", "Select a Dataset:") |h %></label>
          <span id="dataset_select" style="display:inline-block; min-width:240px;"></span>
        </div>
        <div class="panel-body">
          <div class="table-responsive">
            <table id="summary_table" class="table table-striped table-bordered" width="100%">
              <thead>
                <tr>
                  <th><% $c->i18n->p("global.index_logged_in_user.accession", "Accession") |h %></th>
                  <th><% $c->i18n->p("accession.stock.phenotype.header.trait", "Trait") |h %></th>
                  <th><% $c->i18n->p("accession.usage.header.min", "Min") |h %></th>
                  <th><% $c->i18n->p("accession.usage.header.max", "Max") |h %></th>
                  <th><% $c->i18n->p("accession.stock.phenotype.header.average", "Average") |h %></th>
                  <th><% $c->i18n->p("decision.root.std", "Std") |h %></th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </&>

</div>

<%once>
use HTML::Entities ();
</%once>

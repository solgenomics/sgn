<%doc>

=head1 NAME

/breeders_toolbox/decision_meeting/analysis_evidence_section.mas - analyses that support the decisions of a meeting

=head1 DESCRIPTION

Stored Analysis Pipeline analyses linked to the selected decision meeting
(meeting_json related_analyses) and, for a chosen analysis, the evidence per
accession: genotype values and ranks per trait, selection index, environmental
zones. Analyses are linked here or from the results page of an analysis
(/tools/script_factory/results/...). Code: js/source/entries/script_factory_meeting.js,
endpoints /ajax/script_factory/meetings* and /ajax/script_factory/decision_evidence.

=head1 AUTHOR

Chris Simoes <ccs263@cornell.edu>

=cut

</%doc>

<& /util/import_javascript.mas, entries => ['script_factory_meeting'] &>

<style>
.sfm-card { border: 1px solid #d9dee5; border-radius: 6px; padding: 8px 10px; margin: 0 8px 8px 0; display: inline-block; vertical-align: top; min-width: 260px; max-width: 420px; background: #fff; cursor: pointer; }
.sfm-card.on { border-color: #2b7a4b; box-shadow: 0 0 0 2px #e8f3ec; }
.sfm-card .sfm-card-title { font-weight: 600; }
.sfm-card .sfm-card-meta { font-size: 11px; color: #6b7280; }
.sfm-card .btn-xs { margin-top: 4px; }
.sfm-chip { display: inline-block; padding: 1px 7px; margin: 1px 2px; border-radius: 10px; background: #eef2ff; color: #3730a3; font-size: 11px; }
.sfm-sel { color: #1f5c38; font-weight: 600; }
.sfm-in { color: #2b7a4b; }
.sfm-muted { color: #6b7280; }
.sfm-rank { color: #6b7280; font-size: 11px; }
#sfm_table td, #sfm_table th { white-space: nowrap; }
.sfm-panel { border: 1px solid #d9dee5; border-radius: 6px; padding: 8px 10px; margin: 0 0 12px 0; background: #fafbfc; }
.sfm-list { max-height: 260px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 4px; background: #fff; }
.sfm-list label { display: block; font-weight: normal; margin: 0; padding: 4px 8px; border-bottom: 1px solid #f1f3f5; cursor: pointer; }
.sfm-list label:hover { background: #f5f8fb; }
.sfm-list input { margin-right: 6px; }
.sfm-late { color: #92400e; font-size: 11px; }
.sfm-locked { color: #6b7280; font-size: 11px; margin-left: 4px; }
</style>

<div class="well">
  <&| /page/info_section.mas,
       title => 'Analysis evidence',
       is_subsection => 1, collapsible => 1, collapsed => 0,
       subtitle => 'Stored Analysis Pipeline results that support the decisions of the selected meeting'
  &>
    <div class="panel panel-default">
      <div class="panel-body">
        <div id="sfm_status" class="sfm-muted">Select a meeting in the Meeting Tracker to see the analyses that support its decisions.</div>
        <div id="sfm_body" style="display:none">
          <div id="sfm_linked"></div>
          <div id="sfm_actions" style="display:none; margin: 4px 0 10px 0">
            <button class="btn btn-success btn-sm" id="sfm_add_toggle"><span class="glyphicon glyphicon-plus"></span> Add analyses</button>
            <button class="btn btn-default btn-sm" id="sfm_remove_toggle"><span class="glyphicon glyphicon-minus"></span> Remove analyses</button>
            <button class="btn btn-link btn-sm" id="sfm_history_toggle"><span class="glyphicon glyphicon-time"></span> History of changes</button>
          </div>
          <div id="sfm_add_row" class="sfm-panel" style="display:none">
            <div class="form-inline" style="margin-bottom:6px">
              <input type="text" class="form-control input-sm" id="sfm_add_filter" placeholder="Search by name, owner or date" style="min-width:280px" />
              <label class="checkbox-inline"><input type="checkbox" id="sfm_add_mine" /> Only my analyses</label>
              <button class="btn btn-default btn-xs" id="sfm_add_all" style="margin-left:8px">Check all shown</button>
              <button class="btn btn-default btn-xs" id="sfm_add_none">Uncheck all</button>
            </div>
            <div id="sfm_add_list" class="sfm-list"></div>
            <div style="margin-top:6px">
              <button class="btn btn-success btn-sm" id="sfm_add_btn" disabled><span class="glyphicon glyphicon-link"></span> Add checked analyses</button>
              <button class="btn btn-default btn-sm" id="sfm_add_cancel">Close</button>
              <small class="sfm-muted">Stored Analysis Pipeline analyses (yours and public ones). An analysis can also be added from its results page.</small>
            </div>
          </div>
          <div id="sfm_remove_row" class="sfm-panel" style="display:none">
            <div style="margin-bottom:6px">Check the analyses to remove from the evidence of this meeting (the analyses themselves are not changed).</div>
            <div id="sfm_remove_list" class="sfm-list"></div>
            <div style="margin-top:6px">
              <button class="btn btn-danger btn-sm" id="sfm_remove_btn" disabled><span class="glyphicon glyphicon-remove"></span> Remove checked analyses</button>
              <button class="btn btn-default btn-sm" id="sfm_remove_cancel">Close</button>
            </div>
          </div>
          <div id="sfm_history" class="sfm-panel" style="display:none"></div>
          <div id="sfm_evidence" style="display:none">
            <div id="sfm_summary" style="margin-bottom:8px"></div>
            <div class="form-inline" style="margin-bottom:6px">
              <label class="checkbox-inline"><input type="checkbox" id="sfm_only_meeting" checked /> Only accessions of this meeting</label>
              <label class="checkbox-inline"><input type="checkbox" id="sfm_only_selected" /> Only accessions selected by the index</label>
              <button class="btn btn-default btn-xs" id="sfm_csv" style="margin-left:12px"><span class="glyphicon glyphicon-download-alt"></span> CSV</button>
            </div>
            <div class="table-responsive"><table id="sfm_table" class="table table-striped table-bordered table-condensed" width="100%"></table></div>
          </div>
        </div>
      </div>
    </div>
  </&>
</div>

<script>
  jQuery(function() { window.jsMod['script_factory_meeting'].init(); });
</script>

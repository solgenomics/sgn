<%args>

$default_seedlot_material_type => undef

</%args>

<div class="modal fade" id="upload_seedlot_dialog" name="upload_seedlot_dialog" tabindex="-1" role="dialog" aria-labelledby="seedlot_upload_dialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" name="close_seedlots_upload" data-dismiss="modal" aria-label="<% $c->i18n->p('seedlots.ui.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="seedlot_upload_dialog"><% $c->i18n->p('seedlots.ui.upload_seedlots.b7849bd', 'Upload Seedlots') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "upload_seedlot_main_workflow" &>
                        <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.intro', 'Intro')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.what_are_seedlots', 'What are seedlots?')) &>
                            <ul>
                            <li><% $c->i18n->p('seedlots.ui.seedlots_represent_physical_plant_materials_in_packets_container', 'Seedlots represent physical plant materials in packets/containers.') |h %></li>
                            <li><% $c->i18n->p('seedlots.ui.plant_material_in_a_seedlot_can_be_seed_root_clone_plant_tissue_', 'Plant material in a seedlot can be seed, root, clone, plant, tissue culture or gametophype.') |h %></li>
                            <li><% $c->i18n->p('seedlots.ui.if_you_would_like_to_set_a_default_material_type_for_seedlots_pl', 'If you would like to set a default material type for seedlots, please contact us.') |h %></li>
                            <li><% $c->i18n->p('seedlots.ui.these_plant_materials_can_be_from_crosses_or_for_named_accession', 'These plant materials can be from crosses or for named accessions.') |h %></li>
                            <li><% $c->i18n->p('seedlots.ui.seedlots_can_have_a_specific_location_box_column_weight_gram_and', 'Seedlots can have a specific location, box, %{column_weight_gram}, and count.', {column_weight_gram => 'weight_gram'}) |h %></li>
                            <li><% $c->i18n->p('seedlots.ui.seedlots_can_belong_to_breeding_programs_and_organizations', 'Seedlots can belong to breeding programs and organizations.') |h %></li>
                            <li><% $c->i18n->p('seedlots.ui.seedlots_can_be_used_in_trials_e_g_they_were_planted_in_a_plot_a', 'Seedlots can be used in trials (e.g. they were planted in a plot) and they can be harvested from a plot or plant (e.g. a cross was performed and seeds were collected.)') |h %></li>
                            </ul>

                            <br/><br/>
                            <div style="text-align: center">
                                <button class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p('seedlots.ui.go_to_next_step', 'Go to Next Step') |h %></button>
                            </div>
                        </&>

                        <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.what_seedlots_do_you_have', 'What seedlots do you have?')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.seedlots_fall_into_two_categories', 'Seedlots fall into two categories')) &>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.select_one', 'Select One:') |h %> </label>
                                <div class="col-sm-9">
                                    <select class="form-control" id="upload_seedlots_type_select" name="upload_seedlots_type_select">
                                        <option value=""></option>
                                        <option data-desc="<% $c->i18n->p('seedlots.ui.if_you_have_seedlots_for_named_accessions_such_as_seed_that_was_', 'If you have seedlots for named accessions, such as seed that was ordered from a vendor, use this option. Use this option if the plant material was not harvested from a cross that is in the database.') |h %>" value="from_accession"><% $c->i18n->p('seedlots.ui.i_have_seedlots_for_named_accessions', 'I have seedlots for named accessions') |h %></option>
                                        <option data-desc="<% $c->i18n->p('seedlots.ui.if_you_have_seedlots_that_were_harvested_from_crosses_that_are_i', 'If you have seedlots that were harvested from crosses that are in the database, use this option.') |h %>" value="from_cross"><% $c->i18n->p('seedlots.ui.i_have_seedlots_harvested_from_crosses', 'I have seedlots harvested from crosses') |h %></option>
                                    </select>
                                </div>
                            </div>
                            <br/><br/>
                            <div id="upload_seedlots_types_description">
                            </div>
                            <br/>
                            <div style="text-align: center">
                                <button disabled id="seedlot_upload_type_select_button" class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p('seedlots.ui.go_to_next_step', 'Go to Next Step') |h %></button>
                            </div>
                        </&>

                        <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.file_format', 'File format')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.make_sure_your_file_matches_the_correct_file_format', 'Make sure your file matches the correct file format')) &>
                            <br/><br/>
                            <div style="text-align: center">
                                <div id="upload_seedlots_accessions_template_section" style="display:none">
                                    <button class="btn btn-info" name="guided_help_seedlot_upload_format_button"><% $c->i18n->p('seedlots.ui.information_about_file_format_for_uploading_seedlots_of_named_ac', 'Information about file format for uploading seedlots of named accessions') |h %></button><br/><br/>
                                </div>
                                <div id="upload_seedlots_crosses_template_section" style="display:none">
                                    <button class="btn btn-info" name="guided_help_seedlot_crosses_upload_format_button"><% $c->i18n->p('seedlots.ui.information_about_file_format_for_uploading_seedlots_harvested', 'Information about file format for uploading seedlots harvested') |h %></button><br/><br/>
                                </div>
                                <button class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p('seedlots.ui.once_you_think_your_file_matches_go_to_next_step', 'Once you think your file matches, go to Next Step') |h %></button>
                            </div>
                        </&>

                        <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.upload_seedlots.775875c', 'Upload seedlots')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.provide_basic_information_about_the_seedlots_and_upload_your_fil', 'Provide basic information about the seedlots and upload your file')) &>
                            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_seedlot_form" name="upload_seedlot_form">
%if ($default_seedlot_material_type) {
                                <div class="form-group">
                                    <label class="col-sm-3 control-label" ><% $c->i18n->p('seedlots.ui.material_type.21ab872', 'Material Type:') |h %> </label>
                                    <div class="col-sm-9">
                                        <input class="form-control" name="upload_seedlots_default_material_type" id="upload_seedlots_default_material_type" disabled value="<% $default_seedlot_material_type %>">
                                    </div>
                                </div>
% } else {
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.material_type.21ab872', 'Material Type:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <div id="upload_seedlot_material_type_div"></div>
                                    </div>
                                </div>
% }
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.breeding_program.5983e34', 'Breeding Program:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <div id="upload_seedlot_breeding_program_div"></div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.location_of_seedlot_storage', 'Location of seedlot storage:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" name="upload_seedlot_location" id="upload_seedlot_location" placeholder="<% $c->i18n->p('seedlots.ui.required', 'Required') |h %>">
                                    </div>
                                </div>
                                <!--
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Population Name: </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" name="upload_seedlot_population_name" id="upload_seedlot_population_name" placeholder="Optional">
                                    </div>
                                </div>
                                -->
                                <div class="form-group">
                                    <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.organization_name', 'Organization Name:') |h %> </label>
                                    <div class="col-sm-9" >
                                        <input class="form-control" name="upload_seedlot_organization_name" id="upload_seedlot_organization_name" placeholder="<% $c->i18n->p('seedlots.ui.optional', 'Optional') |h %>">
                                    </div>
                                </div>

                                <div id="upload_seedlots_accessions_section" style="display:none">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.upload_file.476d793', 'Upload File:') |h %> </label>
                                        <div class="col-sm-9" >
                                            <input type="file" name="seedlot_uploaded_file" id="seedlot_uploaded_file" encoding="multipart/form-data" />
                                        </div>
                                    </div>
                                </div>

                                <div id="upload_seedlots_harvested_section" style="display:none">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p('seedlots.ui.upload_file.476d793', 'Upload File:') |h %> </label>
                                        <div class="col-sm-9" >
                                            <input type="file" name="seedlot_harvested_uploaded_file" id="seedlot_harvested_uploaded_file" encoding="multipart/form-data" />
                                        </div>
                                    </div>
                                </div>

                            </form>
                            <div style="text-align: center">
                                <button type="button" class="btn btn-lg btn-primary" onclick="Workflow.complete(this, false);" name="upload_seedlot_button" ><% $c->i18n->p('seedlots.ui.upload_seedlots.b7849bd', 'Upload Seedlots') |h %></button><br/><br/>
                            </div>

                        </&>
                        <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.fix_errors_in_file', 'Fix errors in file')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.fix_all_errors_in_your_file', 'Fix all errors in your file')) &>

                            <div id="upload_seedlots_missing_accessions_or_crosses_div" style="display:none">
                                <div id="upload_seedlots_missing_accessions_div" style="display:none">
                                    <div class="well">
                                        <ul>
                                            <li><% $c->i18n->p('seedlots.ui.accessions_must_exist_in_the_database_prior_to_adding_seedlots_o', 'Accessions must exist in the database prior to adding seedlots of them. The reason for this is that an accession can be exist in many seedlots and therefore exists as a separate entity in the database. We also want to be careful about adding new accessions into the database because we do not want incorrectly duplicated data.') |h %></li>
                                            <li><% $c->i18n->p('seedlots.ui.when_adding_accessions_into_the_database_you_can_use_either_a_li', 'When adding accessions into the database, you can use either a list of accessions or an Excel file.') |h %></li>
                                        </ul>
                                    </div>

                                    <div id="upload_seedlots_add_missing_accessions_html">
                                    </div>

                                    <button class="btn btn-info" name="add_accessions_link"><% $c->i18n->p('seedlots.ui.add_your_accessions_to_the_database', 'Add your accessions to the database') |h %></button><br/><br/>
                                    <button class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p('seedlots.ui.once_all_your_accessions_are_in_the_database_click_here', 'Once all your accessions are in the database Click Here') |h %></button><br/><br/>
                                </div>
                                <div id="upload_seedlots_missing_crosses_div" style="display:none">
                                    <div class="well">
                                        <ul>
                                            <li><% $c->i18n->p('seedlots.ui.crosses_must_exist_in_the_database_before_adding_your_seed_lots_', 'Crosses must exist in the database before adding your seed lots. The reason for this is that a cross can produce many seed lots and so the cross must exists as a separate entity in the database. We also want to be careful about adding new crosses into the database because we do not want data to be incorrectly linked to duplicates.') |h %></li>
                                        </ul>
                                    </div>
                                    <ul>
                                    <li><% $c->i18n->p('seedlots.ui.when_adding_crosses_into_the_database_you_can_upload_an_excel_fi', 'When adding crosses into the database, you can upload an Excel file or you can add seedlots one at a time.') |h %><br/><br/>
                                        <ul>
                                        <li><button class="btn btn-info" name="upload_crosses_link"><% $c->i18n->p('seedlots.ui.upload_excel_file', 'Upload Excel file') |h %></button><br/><br/></li>
                                        <li><button class="btn btn-info" name="create_cross_link"><% $c->i18n->p('seedlots.ui.add_one_cross', 'Add One Cross') |h %></button></li>
                                        </ul>
                                    </li>
                                    </ul><br/>
                                    <div style="text-align: center">
                                        <button class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p('seedlots.ui.once_all_your_crosses_are_in_the_database_click_here', 'Once all your crosses are in the database Click Here') |h %></button><br/><br/>
                                    </div>
                                </div>
                            </div>
                            <div id="upload_seedlots_error_display" style="display:none">

                                <h3><% $c->i18n->p('seedlots.ui.seedlot_upload_error_messages', 'Seedlot Upload Error Messages') |h %></h3>
                                <div class="panel panel-danger">
                                    <div class="panel-body">
                                        <table>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div style="text-align: center">
                                <div id="upload_seedlots_no_error_messages_accessions_html">
                                </div>
                                <div name="upload_seedlots_completed_message">
                                </div>
                            </div>
                        </&>
                        <&| /util/workflow.mas:step, title=> HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.try_submitting_seedlots_again', 'Try submitting seedlots again')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.submit_your_seedlots_again_you_should_have_corrected_all_errors_', 'Submit your seedlots again. You should have corrected all errors by now, but if not please take a look at the errors in the red box below. You can continue to modify your file and then click Upload until it works.')) &>
                            <div style="text-align: center" id="seedlot_upload_show_repeat_upload_button">
                                <button type="button" class="btn btn-lg btn-primary" name="upload_seedlot_button" ><% $c->i18n->p('seedlots.ui.upload_seedlots.b7849bd', 'Upload Seedlots') |h %></button><br/><br/>
                            </div>
                            <div style="text-align: center" name="upload_seedlots_completed_message">
                            </div>

                            <div id="upload_seedlots_error_display_second_try" style="display:none">

                                <h3><% $c->i18n->p('seedlots.ui.there_exist_these_problems_in_your_file', 'There exist these problems in your file:') |h %></h3>
                                <div class="panel panel-danger">
                                    <div class="panel-body">
                                        <table>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </&>
                        <&| /util/workflow.mas:complete, title=> HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.complete', 'Complete')) &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('seedlots.ui.finished_your_seedlots_are_now_in_the_database', 'Finished! Your seedlots are now in the database')) &>
                            <p>
                                <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                                <% $c->i18n->p('seedlots.ui.the_seedlot_file_was_uploaded_successfully', 'The seedlot file was uploaded successfully') |h %>
                            </p>

                            <ul>
                                <li><% $c->i18n->p('seedlots.ui.you_may_want_to_proceed_to_the_seedlot_detail_page_s_for_the_see.d3eabe2', 'You may want to proceed to the seedlot detail page(s) for the seedlot(s) you just created.') |h %></li>
                                <li><% $c->i18n->p('seedlots.ui.you_can_print_barcodes_for_the_seedlots', 'You can print barcodes for the seedlots.') |h %></li>
                            </ul>
                            <br/>
                            <div style="text-align: center">
                                <button class="btn btn-primary" name="upload_seedlot_success_complete_button"><% $c->i18n->p('seedlots.ui.the_seedlots_were_saved_to_the_database_with_no_errors_congrats_', 'The seedlots were saved to the database with no errors! Congrats Click Here') |h %></button><br/><br/>
                            </div>
                        </&>
                    </&>

                </div>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_upload_dialog" name="close_seedlots_upload" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('seedlots.ui.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlot_upload_spreadsheet_info_dialog" name="seedlot_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSeedlotInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('seedlots.ui.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSeedlotInfoDialog"><% $c->i18n->p('seedlots.ui.upload_template_information_for_named_accessions', 'Upload Template Information For Named Accessions') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% $c->i18n->p('seedlots.ui.header', 'Header:') |h %></b>
                    <br>
                    <% $c->i18n->p('seedlots.ui.the_first_row_header_should_contain_the_following', 'The first row (header) should contain the following:') |h %>
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>seedlot_name</td>
                                <td>accession_name</td>
                                <td>operator_name</td>
                                <td>amount</td>
                                <td>weight_gram</td>
                                <td>description</td>
                                <td>box_name</td>
                                <td>quality</td>
                                <td>source</td>
                            </tr>
                        </tbody>
                    </table>

                    <b><% $c->i18n->p('seedlots.ui.required_fields', 'Required fields:') |h %></b>
                    <ul>
                    <li><% $c->i18n->p('seedlots.ui.column_seedlot_name_must_be_unique', '%{column_seedlot_name} (must be unique)', {column_seedlot_name => 'seedlot_name'}) |h %></li>
                    <li><% $c->i18n->p('seedlots.ui.column_accession_name_must_exist_in_the_database_the_column_acce', '%{column_accession_name} (must exist in the database. the %{column_accession_name} is the unique identifier for the named genotype)', {column_accession_name => 'accession_name'}) |h %></li>
                    <li><% $c->i18n->p('seedlots.ui.column_operator_name_the_name_of_the_person_who_oversaw_the_inve', '%{column_operator_name} (the name of the person who oversaw the inventory process. can be any name.)', {column_operator_name => 'operator_name'}) |h %></li>
                    <li>
                    <% $c->i18n->p('seedlots.ui.column_amount_number_of_materials_in_seedlot_can_be_provided_in_', '%{column_amount} (number of materials in seedlot. can be provided in conjunction with %{column_weight_gram}. must provide a value for %{column_amount} or %{column_weight_gram} or both.)', {column_weight_gram => 'weight_gram', column_amount => 'amount'}) |h %>
                    <br/><b><% $c->i18n->p('seedlots.ui.and_or', 'AND/OR') |h %></b><br/>
                    <% $c->i18n->p('seedlots.ui.column_weight_gram_weight_in_grams_of_seedlot_can_be_provided_in', '%{column_weight_gram} (weight in grams of seedlot. can be provided in conjunction with %{column_amount}. must provide a value for %{column_amount} or %{column_weight_gram} or both.)', {column_weight_gram => 'weight_gram', column_amount => 'amount'}) |h %>
                    </li>
                    <li><% $c->i18n->p('seedlots.ui.column_box_name_the_box_name_that_the_plant_material_is_located_', '%{column_box_name} (the box name that the plant material is located in. can be any name.)', {column_box_name => 'box_name'}) |h %></li>
                    </ul>

                    <b><% $c->i18n->p('seedlots.ui.optional_fields', 'Optional fields:') |h %></b>
                    <ul>
                      <li><% $c->i18n->p('seedlots.ui.column_description_information_about_why_this_seedlot_is_being_a', '%{column_description} (information about why this seedlot is being added)', {column_description => 'description'}) |h %></li>
                      <li><% $c->i18n->p('seedlots.ui.column_quality_status_of_the_seedlot_for_example_ok_moldy_insect', '%{column_quality} (status of the seedlot, for example "ok", "moldy", "insect damage" etc.', {column_quality => 'quality'}) |h %></li>
                      <li><% $c->i18n->p('seedlots.ui.column_source_an_alternate_source_such_as_a_plot_subplot_or_plan', '%{column_source} (an alternate source, such as a plot, subplot, or plant identifier from which the seed was collected)', {column_source => 'source'}) |h %></li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Seedlots", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('seedlots.ui.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seedlot_upload_spreadsheet_harvested_info_dialog" name="seedlot_upload_spreadsheet_harvested_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadSeedlotHarvestedInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('seedlots.ui.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadSeedlotHarvestedInfoDialog"><% $c->i18n->p('seedlots.ui.upload_template_information_for_harvested_seedlots', 'Upload Template Information For Harvested Seedlots') |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% $c->i18n->p('seedlots.ui.header', 'Header:') |h %></b>
                    <br>
                    <% $c->i18n->p('seedlots.ui.the_first_row_header_should_contain_the_following', 'The first row (header) should contain the following:') |h %>
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>seedlot_name</td>
                                <td>cross_unique_id</td>
                                <td>operator_name</td>
                                <td>amount</td>
                                <td>weight_gram</td>
                                <td>description</td>
                                <td>box_name</td>
                                <td>quality</td>
                            </tr>
                        </tbody>
                    </table>

                    <b><% $c->i18n->p('seedlots.ui.required_fields', 'Required fields:') |h %></b>
                    <ul>
                    <li><% $c->i18n->p('seedlots.ui.column_seedlot_name_must_be_unique', '%{column_seedlot_name} (must be unique)', {column_seedlot_name => 'seedlot_name'}) |h %></li>
                    <li><% $c->i18n->p('seedlots.ui.column_cross_unique_id_must_exist_in_the_database_a_column_cross', '%{column_cross_unique_id} (must exist in the database. a %{column_cross_unique_id} can represent a cross between accessions e.g. %{sample_cross}, but a cross can also represent a cross between specific plots in the field if you have this information)', {column_cross_unique_id => 'cross_unique_id', sample_cross => 'AxB'}) |h %></li>
                    <li><% $c->i18n->p('seedlots.ui.column_operator_name_the_name_of_the_person_who_oversaw_the_inve', '%{column_operator_name} (the name of the person who oversaw the inventory process. can be any name.)', {column_operator_name => 'operator_name'}) |h %></li>
                    <li>
                    <% $c->i18n->p('seedlots.ui.column_amount_number_of_materials_in_seedlot_can_be_provided_in_', '%{column_amount} (number of materials in seedlot. can be provided in conjunction with %{column_weight_gram}. must provide a value for %{column_amount} or %{column_weight_gram} or both.)', {column_weight_gram => 'weight_gram', column_amount => 'amount'}) |h %>
                    <br/><b><% $c->i18n->p('seedlots.ui.and_or', 'AND/OR') |h %></b><br/>
                    <% $c->i18n->p('seedlots.ui.column_weight_gram_weight_in_grams_of_seedlot_can_be_provided_in', '%{column_weight_gram} (weight in grams of seedlot. can be provided in conjunction with %{column_amount}. must provide a value for %{column_amount} or %{column_weight_gram} or both.)', {column_weight_gram => 'weight_gram', column_amount => 'amount'}) |h %>
                    </li>
                    <li><% $c->i18n->p('seedlots.ui.column_box_name_the_box_name_that_the_plant_material_is_located_', '%{column_box_name} (the box name that the plant material is located in. can be any name.)', {column_box_name => 'box_name'}) |h %></li>
                    </ul>

                    <b><% $c->i18n->p('seedlots.ui.optional_fields', 'Optional fields:') |h %></b>
                    <ul>
                      <li><% $c->i18n->p('seedlots.ui.column_description_information_about_why_this_seedlot_is_being_a', '%{column_description} (information about why this seedlot is being added)', {column_description => 'description'}) |h %></li>
                      <li><% $c->i18n->p('seedlots.ui.column_quality_brief_description_of_quality_e_g_ok_moldy_insect_', '%{column_quality} (brief description of quality, e.g., "ok", "moldy", "insect damage", etc)', {column_quality => 'quality'}) |h %></li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => "Seedlots", optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_seedlot_harvested_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('seedlots.ui.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>



<script>
// Optional language assets preserve the native workflow and raw data values.
var seedlotI18n = (window.SGN && window.SGN.i18n) || {
    p: function (context, source, variables) {
        return source.replace(/%\{([A-Za-z0-9_]+)\}/g, function (match, name) {
            return variables && Object.prototype.hasOwnProperty.call(variables, name) ? String(variables[name]) : match;
        });
    },
    np: function (context, one, many, count, variables) {
        return this.p(context, count === 1 ? one : many, variables);
    }
};
function seedlotHTML(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, function (character) {
        return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[character];
    });
}
// The locale is carried only by these source-traced, same-origin core routes.
function _sgnSeedlotLocaleHeaders(url) {
    try {
        var guardedURL = new URL(url, window.location.href);
        if (guardedURL.origin !== window.location.origin) return {};
        var admitted = /^\/ajax\/breeders\/(?:seedlots|seedlot\/[0-9]+(?:\/(?:edit|delete|transactions|transaction\/(?:add|[0-9]+(?:\/(?:edit|delete))?)))?|seedlot\/(?:discard|undo_discard)|seedlot-create|seedlot-upload|seedlot-inventory-upload|upload_transactions|add_transactions_using_list)\/?$/.test(guardedURL.pathname)
            || /^\/ajax\/seedlots\/(?:verify_delete_by_list|confirm_delete_by_list)$/.test(guardedURL.pathname)
            || /^\/ajax\/stock\/stock_related_seedlots\/[0-9]+$/.test(guardedURL.pathname)
            || /^\/ajax\/manage_accessions\/population_seedlots\/[0-9]+$/.test(guardedURL.pathname)
            || /^\/ajax\/accessions\/possible_seedlots$/.test(guardedURL.pathname)
            || /^\/ajax\/breeders\/program\/[0-9]+\/seedlots$/.test(guardedURL.pathname)
            || /^\/ajax\/breeders\/trial\/[0-9]+\/(?:seedlots_from_crossingtrial|seedlots|upload_used_seedlots)$/.test(guardedURL.pathname)
            || guardedURL.pathname === '/breeders/download_population_seedlots_action';
        if (!admitted) return {};
        var root = typeof document !== 'undefined' && document.documentElement;
        var runtime = window.SGN && window.SGN.i18n;
        var requested = root && typeof root.getAttribute === 'function' && root.getAttribute('data-sgn-locale');
        var locale = requested || (runtime && runtime.requestedLocale) || (root && root.lang) || (runtime && runtime.locale) || 'en';
        return {'X-SGN-Locale': typeof locale === 'string' && /^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$/.test(locale) ? locale : 'en'};
    } catch (error) {
        return {};
    }
}
function _sgnSeedlotLocaleURL(url) {
    try {
        var headers = _sgnSeedlotLocaleHeaders(url);
        if (!headers['X-SGN-Locale']) return url;
        var guardedURL = new URL(url, window.location.href);
        guardedURL.searchParams.set('lang', headers['X-SGN-Locale']);
        return guardedURL.pathname + guardedURL.search + guardedURL.hash;
    } catch (error) {
        return url;
    }
}

jQuery(document).ready(function(){

    jQuery("#upload_seedlot_location").autocomplete({
       source: '/ajax/stock/geolocation_autocomplete',
    });

    jQuery('#upload_seedlots_type_select').change(function(){
        if (jQuery(this).val() != ''){
            jQuery('#seedlot_upload_type_select_button').attr('disabled', false);
            jQuery('#upload_seedlots_types_description').html('<br/><div class="well"><p>'+seedlotHTML(jQuery(this).find("option:selected").data("desc"))+'</p></div>');
        } else {
            jQuery('#seedlot_upload_type_select_button').attr('disabled', true);
            jQuery('#upload_seedlots_types_description').html('');
        }

        if(jQuery(this).val() == 'from_accession'){
            jQuery('#upload_seedlots_accessions_template_section').show();
            jQuery('#upload_seedlots_crosses_template_section').hide();
            jQuery('#upload_seedlots_accessions_section').show();
            jQuery('#upload_seedlots_harvested_section').hide();
        }
        if(jQuery(this).val() == 'from_cross'){
            jQuery('#upload_seedlots_crosses_template_section').show();
            jQuery('#upload_seedlots_accessions_template_section').hide();
            jQuery('#upload_seedlots_accessions_section').hide();
            jQuery('#upload_seedlots_harvested_section').show();
        }
    });

    jQuery('[name="seedlot_bulk_upload"]').click( function() {
        jQuery('#upload_seedlot_dialog').modal('show');
        get_select_box('breeding_programs', 'upload_seedlot_breeding_program_div', { 'name' : 'upload_seedlot_breeding_program_id', 'id' : 'upload_seedlot_breeding_program_id' });
        get_select_box('material_types', 'upload_seedlot_material_type_div', { 'name' : 'upload_seedlot_material_type', 'id' : 'upload_seedlot_material_type' });
    });

    jQuery("[name='guided_help_seedlot_upload_format_button']").click( function () {
        jQuery("#seedlot_upload_spreadsheet_info_dialog" ).modal("show");
    });

    jQuery("[name='guided_help_seedlot_crosses_upload_format_button']").click( function () {
        jQuery("#seedlot_upload_spreadsheet_harvested_info_dialog" ).modal("show");
    });

    jQuery('[name="upload_seedlot_button"]').click(function () {
        upload_seedlot_button();
    });
    function upload_seedlot_button() {
        let material_type = "";
        const default_seedlot_material_type = "<%$default_seedlot_material_type%>";
        if (default_seedlot_material_type) {
            material_type = default_seedlot_material_type;
        } else {
            material_type = jQuery('#upload_seedlot_material_type').val();
        }
        if (material_type === '') {
            alert(seedlotI18n.p("seedlots.ui.please_select_a_material_type", "Please select a material type"));
            return;
        }

        var uploadSeedlotAccessionsFile = jQuery("#seedlot_uploaded_file").val();
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
        var location = jQuery("#upload_seedlot_location").val();
        var breeding_program = jQuery("#upload_seedlot_breeding_program_id").val();
        jQuery('#upload_seedlot_form').attr("action", _sgnSeedlotLocaleURL("/ajax/breeders/seedlot-upload"));
        if (breeding_program === '') {
            alert(seedlotI18n.p("seedlots.ui.please_choose_a_breeding_program", "Please choose a breeding program"));
            return;
        }
        if (location === '') {
            alert(seedlotI18n.p("seedlots.ui.please_give_a_location", "Please give a location"));
            return;
        }
        if (uploadSeedlotAccessionsFile === '' && uploadSeedlotsHarvestedFile == '') {
            alert(seedlotI18n.p("seedlots.ui.please_select_a_file", "Please select a file"));
            return;
        }
        jQuery("#upload_seedlot_form").submit();
    }

    jQuery('#upload_seedlot_form').iframePostForm({
        json: true,
        post: function () {
        var uploadSeedlotAccessionsFile = jQuery("#seedlot_uploaded_file").val();
        var uploadSeedlotsHarvestedFile = jQuery("#seedlot_harvested_uploaded_file").val();
            jQuery('#working_modal').modal("show");
            if (uploadSeedlotAccessionsFile === '' && uploadSeedlotsHarvestedFile == '') {
                jQuery('#working_modal').modal("hide");
                alert(seedlotI18n.p("seedlots.ui.no_file_selected", "No file selected"));
            }
        },
        complete: function (response) {
            console.log(response);
            jQuery('#working_modal').modal("hide");

            if (response.error) {
                alert(response.error);
                return;
            }
            else if (response.error_string) {

                if (response.missing_accessions || response.missing_crosses) {
                    jQuery('#upload_seedlots_missing_accessions_or_crosses_div').show();
                    if (response.missing_accessions){
                        jQuery('#upload_seedlots_missing_accessions_div').show();
                        var missing_accessions_html = "<div class='well well-sm'><h3>" + seedlotHTML(seedlotI18n.p("seedlots.ui.add_the_missing_accessions_to_a_list", "Add the missing accessions to a list")) + "</h3><textarea readonly id='upload_seedlots_missing_accessions' style='display:none'></textarea><div id='upload_seedlots_add_missing_accessions'></div></div><br/>";
                        jQuery("#upload_seedlots_add_missing_accessions_html").html(missing_accessions_html);

                        var missing_accessions_vals = '';
                        for(var i=0; i<response.missing_accessions.length; i++) {
                            missing_accessions_vals = missing_accessions_vals + response.missing_accessions[i] + '\n';
                        }
                        jQuery("#upload_seedlots_missing_accessions").val(missing_accessions_vals);
                        addToListMenu('upload_seedlots_add_missing_accessions', 'upload_seedlots_missing_accessions', {
                            selectText: true,
                            listType: 'accessions'
                        });
                    } else if (response.missing_crosses){
                        jQuery('#upload_seedlots_missing_crosses_div').show();
                    }
                } else {
                    jQuery('#upload_seedlots_missing_accessions_or_crosses_div').hide();
                    var no_missing_accessions_html = '<button class="btn btn-primary" onclick="Workflow.skip(this);">' + seedlotHTML(seedlotI18n.p("seedlots.ui.there_were_no_errors_regarding_missing_accessions_or_crosses_cli", "There were no errors regarding missing accessions or crosses Click Here")) + '</button><br/><br/>';
                    jQuery('#upload_seedlots_no_error_messages_accessions_html').html(no_missing_accessions_html);
                    Workflow.skip('#upload_seedlots_missing_accessions_or_crosses_div', false);
                }

                jQuery("#upload_seedlots_error_display").show();
                jQuery("#upload_seedlots_error_display tbody").html(response.error_string);
                jQuery("#upload_seedlots_error_display_second_try").show();
                jQuery("#upload_seedlots_error_display_second_try tbody").html(response.error_string);
            }
            if (response.missing_accessions || response.missing_crosses){
                Workflow.focus("#upload_seedlot_main_workflow", 4);
            } else if(response.error_string){
                Workflow.focus("#upload_seedlot_main_workflow", 5);
                jQuery("#upload_seedlots_error_display_second_try").show();
            }
            if (response.success) {
                jQuery("#upload_seedlots_error_display").hide();
                jQuery("#upload_seedlots_error_display_second_try").hide();
                jQuery('#seedlot_upload_show_repeat_upload_button').hide();
                jQuery('[name="upload_seedlots_completed_message"]').html('<button class="btn btn-primary" name="upload_seedlot_success_complete_button">' + seedlotHTML(seedlotI18n.p("seedlots.ui.the_seedlots_were_saved_to_the_database_with_no_errors_congrats_", "The seedlots were saved to the database with no errors! Congrats Click Here")) + '</button><br/><br/>');
                Workflow.skip('#upload_seedlots_missing_accessions_or_crosses_div', false);
                Workflow.skip('#upload_seedlots_error_display_second_try', false);
                Workflow.focus("#upload_seedlot_main_workflow", -1); //Go to success page
                Workflow.check_complete("#upload_seedlot_main_workflow");
            }

        }
    });

    jQuery(document).on('click', '[name="upload_seedlot_success_complete_button"]', function(){
        alert(seedlotI18n.p("seedlots.ui.seedlots_were_saved_in_the_database", "Seedlots were saved in the database"));
        jQuery('#upload_seedlot_dialog').modal('hide');
        //location.reload();
    });

    jQuery('[name="close_seedlots_upload"]').click(function () {
        jQuery('#upload_seedlots_type_select').val("");
        jQuery('#upload_seedlot_location').val("");
        jQuery('#upload_seedlot_organization_name').val("");
        jQuery('#seedlot_uploaded_file').val("");
        jQuery('#seedlot_harvested_uploaded_file').val("");
        location.reload();
    });


});
</script>

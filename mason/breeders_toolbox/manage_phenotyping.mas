
<%args>
$phenotype_files => undef
$deleted_phenotype_files => undef
$locations => undef
</%args>

<%once>
use HTML::Entities ();
</%once>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.Trial','CXGN.BreedersToolbox.FieldBook','CXGN.BreedersToolbox.UploadPhenotype', 'CXGN.BreedersToolbox.UploadImages', 'CXGN.BreederSearch', 'CXGN.Trial' ] &>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('phenotyping.manage.title', 'Manage Phenotypic Data')) &>

<div class="container-fluid sgn-phenotyping-page">

<!--button class="btn btn-info" onclick=location.href="/search/stocks">Phenotype Search</button><br /><br /-->

<& /fieldbook/create_fieldbook_dialog.mas &>
<& /fieldbook/create_trait_file_dialog.mas &>
<& /fieldbook/upload_phenotype_fieldbook.mas &>
<& /breeders_toolbox/upload_phenotype_spreadsheet.mas &>
<& /breeders_toolbox/upload_images.mas &>
<& /breeders_toolbox/trial/create_spreadsheet_dialog.mas &>

<div class="well">

<&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('phenotyping.manage.section.uploaded_files', 'Your Uploaded Files')), anchor_title=>'Your Uploaded Files', is_subsection=>1, subtitle=>'[<a id="upload_spreadsheet_phenotypes_link" >' . HTML::Entities::encode_entities($c->i18n->p('phenotyping.manage.action.upload_spreadsheet', 'Upload Phenotype Spreadsheet')) . '</a>] [<a id="upload_images_link" >' . HTML::Entities::encode_entities($c->i18n->p('phenotyping.manage.action.upload_images', 'Upload Images')) . '</a>] <br/> [<a name="create_spreadsheet_link" >' . HTML::Entities::encode_entities($c->i18n->p('phenotyping.manage.action.create_spreadsheet', 'Create Phenotype Spreadsheet')) . '</a>]' &>
  <br/>
  <& /breeders_toolbox/file_list.mas, files=>$phenotype_files, allow_delete=>1 &>

</&>

</div>
<div class="well">

<&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('phenotyping.manage.section.obsoleted_files', 'Your Obsoleted Files')), anchor_title=>'Your Obsoleted Files', subtitle=>HTML::Entities::encode_entities($c->i18n->p('phenotyping.manage.section.obsoleted_help', 'These files will not be shown anywhere else on the website')), is_subsection=>1 &>

  <& /breeders_toolbox/file_list.mas, files=>$deleted_phenotype_files, allow_delete=>0 &>

</&>

</div>

</div>

<script>

jQuery(document).ready(function() {

    var managePhenotypingI18n = (window.SGN && window.SGN.i18n) || {
        p: function(context, source) { return source; }
    };

    jQuery('.files_datatables').on('click', 'button[name=delete_pheno_file_link]', function() {
        var delete_phenotypes_file_id = jQuery(this).data('file_id');
        if (confirm(managePhenotypingI18n.p('phenotyping.manage.delete.confirm', 'Are you sure you want to delete all phenotype values related to this file from the database and make this file obsolete?'))){
            jQuery.ajax ( {
                url : '/ajax/breeders/phenotyping/delete/'+delete_phenotypes_file_id,
                beforeSend : function() {
                    jQuery('#working_modal').modal('show');
                },
                success: function(response){
                    jQuery('#working_modal').modal('hide');
                    alert(managePhenotypingI18n.p('phenotyping.manage.delete.success', 'Made phenotype file obsolete and deleted all related phenotype values in the database!'));
                    location.reload();
                },
                error: function(response){
                    jQuery('#working_modal').modal('hide');
                    alert(managePhenotypingI18n.p('phenotyping.manage.delete.failed', "Error deleting file and phenotypes!"));
                }
            });
        }
    });

});

</script>

<style>
/* Allow translated section titles and actions to wrap independently. */
.sgn-phenotyping-page > .well > table.sub_infosectionhead,
.sgn-phenotyping-page > .well > table.sub_infosectionhead > tbody {
    display: block;
}
.sgn-phenotyping-page > .well > table.sub_infosectionhead > tbody > tr {
    display: flex;
    flex-wrap: wrap;
    gap: .5em 1em;
}
.sgn-phenotyping-page > .well > table.sub_infosectionhead td.sub_infosectiontitle,
.sgn-phenotyping-page > .well > table.sub_infosectionhead td.sub_infosectionsubtitle {
    min-width: 0;
    width: auto;
    white-space: normal;
    overflow-wrap: anywhere;
    text-align: start;
}
.sgn-phenotyping-page > .well > table.sub_infosectionhead td.sub_infosectiontitle {
    flex: 1 1 14rem;
}
.sgn-phenotyping-page > .well > table.sub_infosectionhead td.sub_infosectionsubtitle {
    flex: 1 1 28rem;
}
</style>

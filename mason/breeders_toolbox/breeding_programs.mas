<%once>
use HTML::Entities ();
</%once>

<%args>
$breeding_programs
$user => undef
</%args>

<%perl>
my $curator_flag = 0;
if ($user && $user->check_roles("curator")) {
    $curator_flag = 1;
}
</%perl>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("program.programs.page_title", "Manage Breeding Programs")) &>

<div class="container-fluid">
<hr>

<table class="table table-condensed table-striped table-hover">
  <thead>
    <tr>

    <%perl>
      my $program_name_header = HTML::Entities::encode_entities($c->i18n->p("program.programs.header.name", "Name"));
      my $program_info_header = HTML::Entities::encode_entities($c->i18n->p("program.programs.header.info", "Info"));
      my $program_edit_header = HTML::Entities::encode_entities($c->i18n->p("program.programs.header.edit", "Edit"));
      my $program_delete_header = HTML::Entities::encode_entities($c->i18n->p("program.programs.header.delete", "Delete"));
      if ($curator_flag) { print "<th>$program_name_header</th><th>$program_info_header</th><th>$program_edit_header</th><th>$program_delete_header</th>"; }
        else { print "<th>$program_name_header</th><th>$program_info_header</th>"; }
    </%perl>

    </tr>
  </thead>
  <tbody>

    <%perl>
      foreach my $bp (@$breeding_programs) {

        print "<tr><td><b><a href=\"/breeders/program/$bp->[0]\" >$bp->[1]</a></b></td><td>$bp->[2]</td>";

  	if ($curator_flag) {
      my $edit_title = HTML::Entities::encode_entities($c->i18n->p("program.programs.edit_tooltip", "edit this breeding program"));
      my $delete_title = HTML::Entities::encode_entities($c->i18n->p("program.programs.delete_tooltip", "delete this breeding program"));
      print "<td><a title=\"$edit_title\" id=\"edit_breeding_program_link\_".$bp->[1]."\" href=\"javascript:edit_breeding_program($bp->[0],'$bp->[1]','$bp->[2]')\" ><span class=\"glyphicon glyphicon-pencil\"></span></a></td>";
	  print "<td><a title=\"$delete_title\" id=\"delete_breeding_program_link\_".$bp->[1]."\" href=\"javascript:delete_breeding_program($bp->[0],'$bp->[1]')\" ><font color=\"red\">X</font></a></td></tr>";
	} else {
	  print "</tr>";
	}
      }
    </%perl>

  </tbody>
</table>

<br/>
<button type="button" class="btn btn-primary" name="new_breeding_program_link" id="new_breeding_program_link"><% $c->i18n->p("program.programs.add_new", "Add New Program") |h %></button>

</div>

<!-- Modal Dialogs Below Here -->

<div class="modal fade" id="store_breeding_program_dialog" name="store_breeding_program_dialog" tabindex="-1" role="dialog" aria-labelledby="storeBreedingProgramDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("folder.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addBreedingProgramDialog"><% $c->i18n->p("program.programs.store_details", "Store Breeding Program Details") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
	  <form class="form-horizontal" role="form" name="store_breeding_program_form" id="store_breeding_program_form">
        <div class="form-group" id="store_breeding_program_id" style="display: none"></div>
	    <div class="form-group">
		<label class="col-sm-2 control-label"><% $c->i18n->p("program.programs.name_label", "Name: ") |h %></label>
      	      <div class="col-sm-10">
		<input class="form-control" name="store_breeding_program_name" id="store_breeding_program_name" type="text" />
              </div>
	    </div>
	    <div class="form-group">
		<label class="col-sm-2 control-label"><% $c->i18n->p("program.programs.description_label", "Description: ") |h %></label>
      	      <div class="col-sm-10">
		<input class="form-control" name="store_breeding_program_desc" id="store_breeding_program_desc" type="text" />
              </div>
	    </div>
	  </form>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("folder.ui.close", "Close") |h %></button>
        <button type="button" class="btn btn-primary" name="store_breeding_program_submit" id="store_breeding_program_submit"><% $c->i18n->p("program.programs.store_details", "Store Breeding Program Details") |h %></button>
      </div>
    </div>
  </div>
</div>


<script>

jQuery(document).ready(function() {

  $("button#new_breeding_program_link").click( function(event) {
      event.preventDefault();
      $("#store_breeding_program_dialog").modal("show");
  });

  $('#store_breeding_program_submit').click( function(event) {
      event.preventDefault();
      var id= jQuery('#store_breeding_program_id').val();
      var name = jQuery('#store_breeding_program_name').val();
      var desc = jQuery('#store_breeding_program_desc').val();
      name = name.trim();
      if ( (name === '') || (desc === '')) {
          alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.programs.validation.name_description", "Please enter a name and a description.") : "Please enter a name and a description."));
          return;
      }
      // console.log("Name is "+name+" and desc is: "+desc);
      $.ajax({
          type: 'POST',
          url: '/breeders/program/store',
          data: { 'id': id, 'name': name, 'desc': desc },
          beforeSend: function()  { jQuery('#working').dialog("open") },
          success: function(response) {
              if (response.error) { alert(response.error); }
              else {
                  alert(response.success);
              }
              jQuery('#working').dialog("close");
              location.reload();
          },
          error: function(response) {
              alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.programs.error.details", "An error occurred.%{details}", {details: String(response.responseText)}) : "An error occurred."+ response.responseText));
              jQuery('#working').dialog("close");
          }
      });
      $("#store_breeding_program_dialog").modal("hide");
  });


});

function edit_breeding_program(program_id, program_name, program_description) {
    jQuery('#store_breeding_program_id').val(program_id);
    jQuery('#store_breeding_program_name').val(program_name);
    jQuery('#store_breeding_program_desc').val(program_description);
    $("#store_breeding_program_dialog").modal("show");
}


function delete_breeding_program(program_id, program_name) {
   if (confirm((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.programs.confirm.delete", "Delete breeding program %{name}? The associated trials will not be deleted, but be listed under 'Other'", {name: String(program_name)}) : "Delete breeding program "+program_name+"? The associated trials will not be deleted, but be listed under 'Other'"))) {
      jQuery.ajax( {
        url: '/breeders/program/delete/'+program_id,
        error: function(response) {
        alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.programs.error.generic", "An error occurred.") : "An error occurred."));
      },
      success: function(response) {
        if (response.error) {
          alert(response.error);
        }
        else {
          location.reload();
        }
      }
    });
  }
}

</script>

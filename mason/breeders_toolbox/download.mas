      get_select_box("genotyping_protocol", "protocol_list");

      $('#genotype').click(function() {

      var accession_list_id = $('#genotype_accession_list_list_select').val();
      var protocol_list_id = $('#gtp_select').val();

      var accession_validation = 1;
      if (accession_list_id) {
  accession_validation = lo.validate(accession_list_id, 'accessions', true).then(
     function(r) {
         if (!( accession_list_id || protocol_list_id) ) {
             alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.you_need_to_select_a_list_of_accessions_and_a_protocol", "You need to select a list of accessions and a protocol !") : "You need to select a list of accessions and a protocol !"));
         }
         else if(r.valid != 1)  {
             alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.the_accession_list_could_not_be_validated_please_correct_the_list", "The accession list could not be validated. Please correct the list(s) and try again") : "The accession list could not be validated. Please correct the list(s) and try again"));
         }
  else  {


      //var ladda = Ladda.create(this);
      //ladda.start();
      //var token = new Date().getTime(); //use the current timestamp as the token name and value
      //manage_dl_with_cookie(token, ladda);
      //jQuery('#gbs_download_token').val(token);
      jQuery('#download_gbs').submit();
   }
  }, function(e) { alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.an_error_occurred", "An error occurred.") : "An error occurred.")); });
  }

  });
  });
</script>

<div class="well well-sm">
<form id="gbs_qc" action="/breeders/gbs_qc_action" method="POST">
<table class="table" cellpadding="10">
  <thead>
  <tr><td colspan="3"><h4><% $c->i18n->p("lists_datasets.download.genotyping_qc", "Genotyping QC") |h %></h4><p><% $c->i18n->p("lists_datasets.download.select_parameter", "Select parameter:") |h %></p></tr>
  <tr>
    <th>
      <% $c->i18n->p("lists_datasets.download.trials", "Trials") |h %>
    </th>
    <th>
      <% $c->i18n->p("lists_datasets.download.accessions", "Accessions") |h %>
    </th>
    <th>
      <% $c->i18n->p("lists_datasets.download.genotyping_protocol", "Genotyping Protocol") |h %>
    </th>
    <th>
      <% $c->i18n->p("lists_datasets.download.action", "Action") |h %>
    </th>
  </tr>
  </thead>
  <tbody>
  <tr>
    <td>
      <div id="trial_list3">
      </div>
    </td>
    <td>
      <div id="accession_list3">
      </div>
    </td>
    <td>
      <div id="protocol_list2">
      </div>
    </td>
    <td>
      <button class="btn btn-primary" type="button" id="genotype_qc"><% $c->i18n->p("lists_datasets.download.download", "Download") |h %></button>
      <input type="hidden" id="qc_download_token" name="qc_download_token"/>
    </td>
  </tr>
  </tbody>
  </table>
</form>
</div>

</div>

<script>
  $(document).ready(function() {

      var lo = new CXGN.List();

      $('#accession_list3').html(lo.listSelect('genotype_qc_accession_list', [ 'accessions' ], (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.select", "select") : "select"), undefined, undefined));
      $('#trial_list3').html(lo.listSelect('genotype_trial_list', [ 'trials' ], (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.select", "select") : "select"), undefined, undefined ));
      get_select_box("genotyping_protocol", "protocol_list2", {'id':'protocol_list2_select', 'name':'protocol_list2_select'});

      $('#genotype_qc').click(function() {

	$('#working').dialog( {
		height: 100,
		width:  300,
		modal: true,
		autoOpen: false,
		closeOnEscape: true,
		draggable: true,
		resizable: true,
		open: function() { $(this).closest('.ui-dialog').find('.ui-dialog-titlebar-close').hide(); },
		title: 'Downloading genotype...'
		});

      var lists = new Array();

      var accession_list_id = $('#genotype_qc_accession_list_list_select').val();
      var trial_list_id = $('#genotype_trial_list_list_select').val();


      if (! (accession_list_id || trial_list_id) ) {
        alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.you_need_to_select_an_accession_or_a_trial_or_both", "You need to select an accession or a trial, or both!") : "You need to select an accession or a trial, or both!"));
        return;
      }

      var lists = new Array();
      var types = new Array();

  if (accession_list_id) {
  lists.push(accession_list_id);
  types.push('accessions');
  }

  if(trial_list_id) {
  lists.push(trial_list_id);
  types.push('trials');
  }


      validateLists(lists, types).then(function(r) {
         console.log('validation results: '+JSON.stringify(r));
         var names_str = '';
         for (var n=0; n < r.invalid_lists.length; n++) {
            names_str += r.invalid_lists[n][1];
	 }
         if(names_str.length > 0) {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.some_lists_lists_are_not_valid_please_check", "Some lists (%{lists}) are not valid, please check.", {lists:String(names_str)}) : 'Some lists ('+names_str+') are not valid, please check.'));
            jQuery('#working_modal').modal('hide');
         }
         else {
           //      var ladda = Ladda.create(this);
//         ladda.start();
//         var token = new Date().getTime(); //use the current timestamp as the token name and value
//          manage_dl_with_cookie(token, ladda);
//          jQuery('#qc_download_token').val(token);
            jQuery('#gbs_qc').submit();

            jQuery('#working_modal').modal('hide');

        }

      });


    });

  });
</script>

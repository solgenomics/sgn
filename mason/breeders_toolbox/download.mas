<%init>
use HTML::Entities ();
</%init>
<%args>
$seedlot_maintenance_enabled => 0
$is_curator => 0
</%args>

<& /util/import_javascript.mas, classes => [ 'jqueryui', 'jquery.cookie', 'CXGN.BreederSearch', 'CXGN.List', 'CXGN.BreedersToolbox.HTMLSelect', 'spin_min', 'ladda_min' ] &>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("lists_datasets.download.download_using_lists", "Download Using Lists")) &>

<div class="container-fluid">

<div class="well">
<% $c->i18n->p("lists_datasets.download.choose_a_list_for_each_parameter_and_click_download", "Choose a list for each parameter and click \"Download\".") |h %>
</div>

<div class="well well-sm">
<h4><% $c->i18n->p("lists_datasets.download.download_phenotypes_using_lists", "Download Phenotypes Using Lists") |h %></h4><p><% $c->i18n->p("lists_datasets.download.select_parameters.edfe1a5", "Select Parameters:") |h %></p>
<form id="download_form" action="/breeders/download_action" method="POST" >
<table class="table table-bordered" >
  <thead>
  <tr>
    <th>
      <% $c->i18n->p("lists_datasets.download.accessions", "Accessions") |h %>
    </th>
    <th>
      <% $c->i18n->p("lists_datasets.download.trials", "Trials") |h %>
    </th>
    <th>
      <% $c->i18n->p("lists_datasets.download.traits", "Traits") |h %>
    </th>
    <th>
        <% $c->i18n->p("lists_datasets.download.options", "Options") |h %>
    </th>
    <th>
      <% $c->i18n->p("lists_datasets.download.action", "Action") |h %>
    </th>
  </tr>
  </thead>
  <tbody>
  <tr>
    <td>
      <div id="accession_list">
      </div>
    </td>
    <td>
      <div id="trial_list">
      </div>
    </td>
    <td>
      <div id="trait_list">
      </div>
   </td>
    <td>
    <b><% $c->i18n->p("lists_datasets.download.format.39442ac", "Format:") |h %></b><br/>
    <select class="form-control" id="format" name="format">
        <option value=".csv">CSV</option>
        <option value=".xlsx">XLSX</option>
        <option value="html">HTML</option>
    </select>
    <br/>
    <b><% $c->i18n->p("lists_datasets.download.data_level", "Data Level:") |h %></b><br/>
    <select class="form-control" id="phenotype_datalevel" name="phenotype_datalevel">
        <option value="all"><% $c->i18n->p("lists_datasets.download.all", "All") |h %></option>
        <option value="plot"><% $c->i18n->p("lists_datasets.download.plot", "Plot") |h %></option>
        <option value="plant"><% $c->i18n->p("lists_datasets.download.plant", "Plant") |h %></option>
    </select>
    <br/>
    <b><% $c->i18n->p("lists_datasets.download.timestamp", "Timestamp:") |h %></b><br/>
    <select class="form-control" id="timestamp" name="timestamp">
        <option value="0"><% $c->i18n->p("lists_datasets.download.no", "No") |h %></option>
        <option value="1"><% $c->i18n->p("lists_datasets.download.yes", "Yes") |h %></option>
    </select>
    <br/>
    <b><% $c->i18n->p("lists_datasets.download.exclude_phenotype_outliers", "Exclude Phenotype Outliers:") |h %></b><br/>
    <select class="form-control" id="exclude_phenotype_outlier" name="exclude_phenotype_outlier">
        <option value="0"><% $c->i18n->p("lists_datasets.download.no", "No") |h %></option>
        <option value="1"><% $c->i18n->p("lists_datasets.download.yes", "Yes") |h %></option>
    </select>
    <br/>
    <b><% $c->i18n->p("lists_datasets.download.include_intercrop_accessions", "Include Intercrop Accessions:") |h %></b><br/>
    <select class="form-control" id="intercrop" name="intercrop">
        <option value="0"><% $c->i18n->p("lists_datasets.download.no", "No") |h %></option>
        <option value="1"><% $c->i18n->p("lists_datasets.download.yes", "Yes") |h %></option>
    </select>
    <br/>
    <b><% $c->i18n->p("lists_datasets.download.include_accession_entry_numbers", "Include Accession Entry Numbers:") |h %></b><br/>
    <select class="form-control" id="entry_numbers" name="entry_numbers">
        <option value="0"><% $c->i18n->p("lists_datasets.download.no", "No") |h %></option>
        <option value="1"><% $c->i18n->p("lists_datasets.download.yes", "Yes") |h %></option>
    </select>
    <br/>
    <b><% $c->i18n->p("lists_datasets.download.include_parents", "Include Parents:") |h %></b><br/>
    <select class="form-control" id="pedigrees" name="pedigrees">
        <option value="0"><% $c->i18n->p("lists_datasets.download.no", "No") |h %></option>
        <option value="1"><% $c->i18n->p("lists_datasets.download.yes", "Yes") |h %></option>
    </select>
    </td>
    <td>
      <button class="btn btn-primary" type="button" id="phenotype"><% $c->i18n->p("lists_datasets.download.download", "Download") |h %></button>
      <input type="hidden" id="phenotype_download_token" name="phenotype_download_token"/>
    </td>
  </tr>
  </tbody>
  </table>
</form>
</div>

<div class="well well-sm">
<h4><% $c->i18n->p("lists_datasets.download.inspect_datasets", "Inspect Datasets") |h %></h4>
<table class="table table-bordered" >
  <thead>
  <tr>
    <th>
      <% $c->i18n->p("lists_datasets.download.datasets", "Datasets") |h %>
    </th>
  </tr>
  </thead>
  <tbody>
  <tr>
    <td>
      <div id="phenotype_download_dataset_list">
      </div>
    </td>
  </tr>
  </tbody>
  </table>
</div>

<div class="well well-sm">
<h4><% $c->i18n->p("lists_datasets.download.download_metadata", "Download Metadata") |h %></h4><p><% $c->i18n->p("lists_datasets.download.select_parameters.edfe1a5", "Select Parameters:") |h %></p>
<form id="download_metadata_form" action="/breeders/download_action" method="POST" >
<table class="table table-bordered" >
  <thead>
  <tr>
    <th>
      <% $c->i18n->p("lists_datasets.download.trials", "Trials") |h %>
    </th>
    <th>
        <% $c->i18n->p("lists_datasets.download.options", "Options") |h %>
    </th>
    <th>
      <% $c->i18n->p("lists_datasets.download.action", "Action") |h %>
    </th>
  </tr>
  </thead>
  <tbody>
  <tr>
    <td>
      <div id="trial_metadata_list">
      </div>
    </td>
    <td>
    <b><% $c->i18n->p("lists_datasets.download.format.39442ac", "Format:") |h %></b><br/>
    <select class="form-control" id="metadata_format" name="metadata_format">
        <option value=".xlsx">XLSX</option>
        <option value=".csv">CSV</option>
        <option value="html">HTML</option>
    </select>
    <br/>
    <div id="datalevel" style="display:none">
      <select class="form-control" id="metadata_datalevel" name="metadata_datalevel">
          <option value="metadata"><% $c->i18n->p("lists_datasets.download.metadata", "Metadata") |h %></option>
      </select>
    </div>
    </td>
    <td>
      <button class="btn btn-primary" type="button" id="metadata"><% $c->i18n->p("lists_datasets.download.download", "Download") |h %></button>
      <input type="hidden" id="metadata_download_token" name="metadata_download_token"/>
    </td>
  </tr>
  </tbody>
  </table>
</form>
</div>

<script>
$(document).ready(function() {

    var lo = new CXGN.List();

    $('#accession_list').html(lo.listSelect('accession_list', [ 'accessions' ], (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.select", "select") : "select"), undefined, undefined));
    $('#trial_list').html(lo.listSelect('trial_list', [ 'trials' ], (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.select", "select") : "select"), undefined, undefined ));
    $('#trait_list').html(lo.listSelect('trait_list', [ 'traits' ], (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.select", "select") : "select"), undefined, undefined  ));
    $('#trial_metadata_list').html(lo.listSelect('trial_metadata_list', ['trials'], (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.select", "select") : "select"), undefined, undefined));

    get_select_box('datasets', 'phenotype_download_dataset_list');

    $('#metadata').click(function() {
      var trial_list_id = $('#trial_metadata_list_list_select').val();
      var trial_validation = 1;
      if (trial_list_id) { trial_validation = lo.validate(trial_list_id, 'trials', true).then(
         function(r) {
            if (r.missing.length != 0) {
               alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.the_following_lists_did_not_pass_validation_lists_please_correct_", "The following lists did not pass validation: %{lists}. Please correct the list(s) and try again", {lists:String(r.missing.join(", "))}) : "The following lists did not pass validation: "+r.missing.join(", ")+". Please correct the list(s) and try again"));
            }
            else {


//      var ladda = Ladda.create(this);
//      ladda.start();
//      var token = new Date().getTime(); //use the current timestamp as the token name and value
//      manage_dl_with_cookie(token, ladda);
//      jQuery('#metadata_download_token').val(token);
               jQuery('#download_metadata_form').submit();
            }
        });
      } });

    $('#phenotype').click(function() {

      var accession_list_id = $('#accession_list_list_select').val();
      var trial_list_id = $('#trial_list_list_select').val();
      var trait_list_id = $('#trait_list_list_select').val();

      var lists = new Array();
      var types = new Array();

      if (accession_list_id) {
         lists.push(accession_list_id);
         types.push('accessions');
         //alert("ACC LIST ID = "+accession_list_id);
      }
      if (trial_list_id) {
          lists.push(trial_list_id);
          types.push('trials');
      }

      if (trait_list_id) {
          lists.push(trait_list_id);
          types.push('traits');
      }

      jQuery('#working_modal').modal('show');

      validateLists(lists, types).then(function(r) {
         console.log('validation results: '+JSON.stringify(r));
         var names_str = '';
         for (var n=0; n < r.invalid_lists.length; n++) {
            names_str += r.invalid_lists[n][1];
	 }
         if(names_str.length > 0) {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.some_lists_lists_are_not_valid_please_check", "Some lists (%{lists}) are not valid, please check.", {lists:String(names_str)}) : 'Some lists ('+names_str+') are not valid, please check.'));
            jQuery('#working_modal').modal('hide');
         }
         else {
            download_phenotypes(this);
            jQuery('#working_modal').modal('hide');

         }},

         function(e) { alert(e);     jQuery('#working_modal').modal('hide');
}
         );

      });




//alert("The following lists did not pass validation: "+problem_lists.join(", ")+". Please correct the list(s) and try again");
//	 return;
//


});


function download_phenotypes() {
    //alert("NOW DOWNLOADING!");
    //var ladda = Ladda.create(data);
     // ladda.start();
      var token = new Date().getTime(); //use the current timestamp as the token name and value
     // manage_dl_with_cookie(token, ladda);
      jQuery('#phenotype_download_token').val(token);
      jQuery('#download_form').submit();


}

</script>



<!-- DOWNLOAD ACCESSION PROPERTIES -->

<div class="well well-sm">
  <form id="download_accession_properties" action="/breeders/download_accession_properties_action" method="POST">
    <table class="table"  cellpadding="10">
      <thead>
        <tr><td colspan="2"><h4><% $c->i18n->p("lists_datasets.download.download_accession_properties", "Download Accession Properties") |h %></h4><p><% $c->i18n->p("lists_datasets.download.select_parameters.03fa00c", "Select parameters:") |h %></p></tr>
        <tr>
          <th><% $c->i18n->p("lists_datasets.download.accessions", "Accessions") |h %></th>
          <th><% $c->i18n->p("lists_datasets.download.format.fda5b99", "Format") |h %></th>
          <th><% $c->i18n->p("lists_datasets.download.action", "Action") |h %></th>
        </tr>
      </thead>
      <tbody>
      <tr>
        <td>
          <div id="accession_list5"></div>
        </td>
        <td>
          <select class="form-control" id="accession_properties_format" name="file_format">
              <option value=".xlsx">XLSX</option>
              <option value=".csv">CSV</option>
          </select>
        </td>
        <td>
          <button class="btn btn-primary" type="button" id="accession_properties_download"><% $c->i18n->p("lists_datasets.download.download", "Download") |h %></button>
          <input type="hidden" id="accession_properties_download_token" name="accession_properties_download_token"/>
        </td>
      </tr>
      </tbody>
  </table>
</form>
</div>


<script>
$(document).ready(function() {

    var lo = new CXGN.List();

    $('#accession_list5').html(lo.listSelect('accession_properties_accession_list', [ 'accessions' ], (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.select", "select") : "select"), undefined, undefined));

    $('#accession_properties_download').click(function() {

        var accession_list_id = $('#accession_properties_accession_list_list_select').val();
        if (!accession_list_id) {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.you_need_to_select_an_accession_list", "You need to select an accession list!") : "You need to select an accession list!"));
            return;
        }


        if (accession_list_id) {
              jQuery('#working_modal').modal('show');
              lo.validate(accession_list_id, 'accessions', true).then(
              function(r) {
                 if (r.valid != 1) {
                    alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.the_accession_list_did_not_pass_validation_please_correct_the_lis", "The accession list did not pass validation. Please correct the list and try again") : "The accession list did not pass validation. Please correct the list and try again"));
                    jQuery('#working_modal').modal('hide');
                 }
                 else {
                    //var ladda = Ladda.create(this);
                    //ladda.start();
                    //var token = new Date().getTime(); //use the current timestamp as the token name and value
                    //manage_dl_with_cookie(token, ladda);
                    //jQuery('#accession_properties_download_token').val(token);
                    jQuery('#download_accession_properties').submit();
                    jQuery('#working_modal').modal('hide');
                }
            });
        }
    });

});
</script>

<!-- END OF DOWNLOAD ACCESSION PROPERTIES -->





<!-- start of code for pedigree download -->

<div class="well well-sm">
<form id="download_pedigree" action="/breeders/download_pedigree_action" method="POST">
<table class="table"  cellpadding="10">
  <thead>
  <tr><td colspan="2"><h4><% $c->i18n->p("lists_datasets.download.download_pedigrees", "Download Pedigrees") |h %> </h4><p><% $c->i18n->p("lists_datasets.download.select_parameter", "Select parameter:") |h %></p></tr>
  <tr>
    <th>
      <% $c->i18n->p("lists_datasets.download.accessions", "Accessions") |h %>
    </th>
    <th>
      <% $c->i18n->p("lists_datasets.download.query", "Query") |h %>
    </th>
    <th>
      <% $c->i18n->p("lists_datasets.download.format.fda5b99", "Format") |h %>
    </th>
    <th>
      <% $c->i18n->p("lists_datasets.download.action", "Action") |h %>
    </th>
  </tr>
  </thead>
  <tbody>
  <tr>
    <td>
      <div id="accession_list4">
      </div>
    </td>
    <td>
      <div style="width: 175px">
        <p><strong><% $c->i18n->p("lists_datasets.download.depth", "Depth:") |h %></strong></p>
        <div class="radio">
          <label><input type="radio" id="ped_format_parents" name="ped_format" value="parents_only" checked><% $c->i18n->p("lists_datasets.download.only_one_generation", "Only One Generation") |h %></label>
        </div>
        <div class="radio">
          <label><input type="radio" id="ped_format_full" name="ped_format" value="full"><% $c->i18n->p("lists_datasets.download.all_generations", "All Generations") |h %></label>
        </div>
        <p><strong><% $c->i18n->p("lists_datasets.download.include", "Include:") |h %></strong></p>
        <div class="radio">
          <label><input type="radio" id="include_ancestors" name="ped_include" value="ancestors" checked><% $c->i18n->p("lists_datasets.download.only_ancestors", "Only Ancestors") |h %></label>
        </div>
        <div class="radio">
          <label><input type="radio" id="include_ancestors_descendants" name="ped_include" value="ancestors_descendants"><% $c->i18n->p("lists_datasets.download.ancestors_and_descendants", "Ancestors and Descendants") |h %></label>
        </div>
      </div>
    </td>
    <td>
      <select class="form-control" id="pedigree_file_format" name="file_format">
        <option value=".txt"><% $c->i18n->p("lists_datasets.download.plain_text", "Plain Text") |h %></option>
        <option value=".helium"><% $c->i18n->p("lists_datasets.download.helium_format", "Helium Format") |h %></option>
      </select>
    </td>
    <td>
      <button class="btn btn-primary" type="button" id="pedigree"><% $c->i18n->p("lists_datasets.download.download", "Download") |h %></button>
      <input type="hidden" id="pedigree_download_token" name="pedigree_download_token"/>
    </td>
  </tr>
  </tbody>
  </table>
</form>
</div>


<script>
$(document).ready(function() {

    var lo = new CXGN.List();

    $('#accession_list4').html(lo.listSelect('pedigree_accession_list', [ 'accessions' ], (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.select", "select") : "select"), undefined, undefined));

    $('#pedigree').click(function() {

        var accession_list_id = $('#pedigree_accession_list_list_select').val();
        if (!accession_list_id) {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.you_need_to_select_an_accession_list", "You need to select an accession list!") : "You need to select an accession list!"));
            return;
        }

        if (accession_list_id) {
           accession_validation = lo.validate(accession_list_id, 'accessions', true).then(
             function(r) {
                 if(r.valid != 1) {
                   alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.the_accession_list_did_not_pass_validation_please_correct_the_lis", "The accession list did not pass validation. Please correct the list and try again") : "The accession list did not pass validation. Please correct the list and try again"));
                 }
                 else {
                    //var ladda = Ladda.create(this);
                    //ladda.start();
                    //var token = new Date().getTime(); //use the current timestamp as the token name and value
                    //manage_dl_with_cookie(token, ladda);
                    //jQuery('#pedigree_download_token').val(token);
                    jQuery('#working_modal').modal('show');
                    var http = new XMLHttpRequest();
                    http.open('POST', '/breeders/download_pedigree_action', true);
                    http.setRequestHeader('Content-type', 'application/x-www-form-urlencoded');
                    http.onreadystatechange = () => {
                      if( http.readyState == 4 ) {
                        jQuery('#working_modal').modal('hide');
                        if ( http.status == 200) {
                          var blob = new Blob([http.response], { type : 'plain/text' });
                          var fileName = http.getResponseHeader("FileName");
                          var link = document.createElement('a');
                          link.href = window.URL.createObjectURL(blob);
                          link.download = fileName;
                          link.click();
                        }
                      }
                    }
                    http.send(jQuery("#download_pedigree").serialize());
                 }
             });
        } });
});

</script>

<!-- end of code for pedigree download -->

<!-- start of code for cross and family download -->

<div class="well well-sm">
    <form id="download_cross_family" action="/breeders/download_cross_family_of_progenies" method="POST">
        <table class="table"  cellpadding="10">
            <thead>
                <tr><td colspan="2"><h4><% $c->i18n->p("lists_datasets.download.download_crosses_and_families_of_progenies", "Download Crosses and Families of Progenies") |h %> </h4><p><% $c->i18n->p("lists_datasets.download.select_parameters.03fa00c", "Select parameters:") |h %></p></tr>
                <tr>
                    <th><% $c->i18n->p("lists_datasets.download.accessions", "Accessions") |h %></th>
                    <th><% $c->i18n->p("lists_datasets.download.format.fda5b99", "Format") |h %></th>
                    <th><% $c->i18n->p("lists_datasets.download.action", "Action") |h %></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <div id="progeny_list"></div>
                    </td>
                    <td>
                        <select class="form-control" id="cross_family_file_format" name="file_format">
                            <option value=".xlsx">XLSX</option>
                        </select>
                    </td>
                    <td>
                        <button class="btn btn-primary" type="button" id="cross_family"><% $c->i18n->p("lists_datasets.download.download", "Download") |h %></button>
                        <input type="hidden" id="progeny_list_id" name="list_id" />
                        <input type="hidden" id="cross_family_download_token" name="list_download_token" />
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
</div>


<script>
$(document).ready(function() {
    const lo = new CXGN.List();
    jQuery('#progeny_list').html(lo.listSelect('progeny_list', [ 'accessions' ], (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.select", "select") : "select"), undefined, undefined));
    jQuery('#cross_family').click(function() {
        const progeny_list_id = $('#progeny_list_list_select').val();
        if (!progeny_list_id) {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.you_need_to_select_an_accession_list", "You need to select an accession list!") : "You need to select an accession list!"));
            return;
        }
        else {
            lo.validate(progeny_list_id, 'accessions', true).then((r) => {
                if (r.missing.length > 0) {
                   alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.the_accession_list_did_not_pass_validation_please_correct_the_lis", "The accession list did not pass validation. Please correct the list and try again") : "The accession list did not pass validation. Please correct the list and try again"));
                }
                else {
                    jQuery("#progeny_list_id").val(seedlot_list_id);
                    jQuery('#download_cross_family').submit();
                }
            });
        }
    });
});

</script>

<!-- end of code for cross and family download -->


<!-- start of code for seedlot details download -->

<div class="well well-sm">
    <form id="download_seedlot_details" action="/list/download_details" method="POST">
        <table class="table"  cellpadding="10">
            <thead>
                <tr><td colspan="2"><h4><% $c->i18n->p("lists_datasets.download.download_seedlot_details", "Download Seedlot Details") |h %> </h4><p><% $c->i18n->p("lists_datasets.download.select_parameters.03fa00c", "Select parameters:") |h %></p></tr>
                <tr>
                    <th><% $c->i18n->p("lists_datasets.download.seedlots", "Seedlots") |h %></th>
                    <th><% $c->i18n->p("lists_datasets.download.format.fda5b99", "Format") |h %></th>
                    <th><% $c->i18n->p("lists_datasets.download.action", "Action") |h %></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <div id="seedlot_list"></div>
                    </td>
                    <td>
                        <select class="form-control" id="seedlot_file_format" name="file_format">
                            <option value=".txt"><% $c->i18n->p("lists_datasets.download.plain_text", "Plain Text") |h %></option>
                        </select>
                    </td>
                    <td>
                        <button class="btn btn-primary" type="button" id="seedlot"><% $c->i18n->p("lists_datasets.download.download", "Download") |h %></button>
                        <input type="hidden" id="seedlot_list_id" name="list_id" />
                        <input type="hidden" id="seedlot_download_token" name="list_download_token" />
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
</div>


<script>
$(document).ready(function() {
    var lo = new CXGN.List();
    $('#seedlot_list').html(lo.listSelect('seedlot_list', [ 'seedlots' ], (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.select", "select") : "select"), undefined, undefined));
    $('#seedlot').click(function() {
        var seedlot_list_id = $('#seedlot_list_list_select').val();
        if (!seedlot_list_id) {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.you_need_to_select_a_seedlot_list", "You need to select a seedlot list!") : "You need to select a seedlot list!"));
            return;
        }
        else {
            lo.validate(seedlot_list_id, 'seedlots', true).then((r) => {
                if (r.missing.length > 0) {
                   alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.the_seedlot_list_did_not_pass_validation_please_correct_the_list_", "The seedlot list did not pass validation. Please correct the list and try again") : "The seedlot list did not pass validation. Please correct the list and try again"));
                }
                else {
                    jQuery("#seedlot_list_id").val(seedlot_list_id);
                    jQuery('#download_seedlot_details').submit();
                }
            });
        }
    });
});

</script>

<!-- end of code for seedlot download -->



<!-- start of code for download seedlot matinenance events -->

% if ( $seedlot_maintenance_enabled ) {

<div class="well well-sm">
  <form id="download_seedlot_maintenance_events" action="/breeders/download_seedlot_maintenance_events_action" method="POST">
      <table class="table"  cellpadding="10">
        <thead>
          <tr><td colspan="2"><h4><% $c->i18n->p("lists_datasets.download.download_seedlot_maintenance_events", "Download Seedlot Maintenance Events") |h %></h4><p><% $c->i18n->p("lists_datasets.download.select_parameters.03fa00c", "Select parameters:") |h %></p></tr>
          <tr>
            <th><% $c->i18n->p("lists_datasets.download.seedlots", "Seedlots") |h %></th>
            <th><% $c->i18n->p("lists_datasets.download.format.fda5b99", "Format") |h %></th>
            <th><% $c->i18n->p("lists_datasets.download.action", "Action") |h %></th>
          </tr>
        </thead>
        <tbody>
        <tr>
          <td>
            <div id="seedlot_list1"></div>
          </td>
          <td>
            <select class="form-control" id="seedlot_maintenance_events_format" name="file_format">
                <option value=".xlsx">XLSX</option>
            </select>
          </td>
          <td>
            <button class="btn btn-primary" type="button" id="seedlot_maintenance_events_download"><% $c->i18n->p("lists_datasets.download.download", "Download") |h %></button>
            <input type="hidden" id="seedlot_maintenance_events_download_token" name="seedlot_maintenance_events_download_token"/>
          </td>
        </tr>
        </tbody>
    </table>
  </form>
</div>

<script>
$(document).ready(function() {

    var lo = new CXGN.List();

    $('#seedlot_list1').html(lo.listSelect('seedlot_maintenance_events_list', [ 'seedlots' ], (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.select", "select") : "select"), undefined, undefined));

    $('#seedlot_maintenance_events_download').click(function() {

        var seedlot_list_id = $('#seedlot_maintenance_events_list_list_select').val();
        if (!seedlot_list_id) {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.you_need_to_select_a_seedlot_list", "You need to select a seedlot list!") : "You need to select a seedlot list!"));
            return;
        }

        var seedlot_validation = 1;
        if (seedlot_list_id) {
            seedlot_validation = lo.validate(seedlot_list_id, 'seedlots', true);
        }

        if (seedlot_validation != 1) {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.the_seedlot_list_did_not_pass_validation_please_correct_the_list_", "The seedlot list did not pass validation. Please correct the list and try again") : "The seedlot list did not pass validation. Please correct the list and try again"));
            return;
        }

        var ladda = Ladda.create(this);
        ladda.start();
        var token = new Date().getTime(); //use the current timestamp as the token name and value
        manage_dl_with_cookie(token, ladda);
        jQuery('#seedlot_maintenance_events_download_token').val(token);
        jQuery('#download_seedlot_maintenance_events').submit();

    });
});

</script>

% }

<!-- end of code for seedlot maintenance event download -->



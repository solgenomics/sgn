<script>
jQuery(document).ready(function() {

    var lo = new CXGN.List();
    jQuery('#obsoleted_stock_list').html(lo.listSelect('obsoleted_stock_list', [ 'obsoleted_stocks' ], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("lists.selector.please_select", "Please select") : 'Please select'), undefined, undefined));

    jQuery('#obsolete_metadata_download').click(function() {
        var obsoleted_stock_list_id = jQuery('#obsoleted_stock_list_list_select').val();
        if (!obsoleted_stock_list_id) {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.please_select_an_obsoleted_stock_list", "Please select an obsoleted stock list!") : "Please select an obsoleted stock list!"));
            return;
        } else {
            lo.validate(obsoleted_stock_list_id, 'obsoleted_stocks', true).then((r) => {
                if (r.missing.length > 0) {
                   alert((window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.download_js.the_obsoleted_stock_list_did_not_pass_validation_please_correct_t", "The obsoleted stock list did not pass validation. Please correct the list and try again") : "The obsoleted stock list did not pass validation. Please correct the list and try again"));
                } else {
                    var token = new Date().getTime(); //use the current timestamp as the token name and value
                    jQuery('#obsolete_metadata_download_token').val(token);
                    jQuery('#download_obsolete_metadata_action').submit();
                }
            });
        }
    });

});

</script>

% }


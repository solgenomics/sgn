<%args>
$program_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>


<table id="program_cross_table" class="display">
    <thead>
        <tr>
            <th><% $c->i18n->p("cross.ui.cross_unique_id.923bfbc", "Cross Unique ID") |h %></th>
            <th><% $c->i18n->p("accession.related_stock.header.female_parent", "Female Parent") |h %></th>
            <th><% $c->i18n->p("accession.related_stock.header.male_parent", "Male Parent") |h %></th>
            <th><% $c->i18n->p("accession.related_stock.header.cross_type_upper", "Cross Type") |h %></th>
        </tr>
    </thead>
</table>

<script>

jQuery(document).ready(function () {

    jQuery('#program_cross_table').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/breeders/program/'+ <% $program_id %> + '/crosses',
    });

});


</script>

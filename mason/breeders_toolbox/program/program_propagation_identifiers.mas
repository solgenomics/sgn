<%args>
$program_id
</%args>

<table id="program_propagation_identifier_table" class="display">
    <thead>
        <tr>
            <th>Propagation Identifier</th>
            <th>Material</th>
            <th>Rootstock</th>
            <th>Propagation Group</th>
        </tr>
    </thead>
</table>

<script>

jQuery(document).ready(function () {

    jQuery('#program_propagation_identifier_table').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/breeders/program/'+ <% $program_id %> + '/propagation_identifiers',
    });

});


</script>

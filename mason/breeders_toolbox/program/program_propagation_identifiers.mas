<%args>
$program_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>


<table id="program_propagation_identifier_table" class="display">
    <thead>
        <tr>
            <th><% $c->i18n->p("seedlot.propagation_identifier.e403673", "Propagation Identifier") |h %></th>
            <th><% $c->i18n->p("seedlot.material", "Material") |h %></th>
            <th><% $c->i18n->p("seedlot.rootstock", "Rootstock") |h %></th>
            <th><% $c->i18n->p("seedlot.propagation_group", "Propagation Group") |h %></th>
        </tr>
    </thead>
</table>

<script>

jQuery(document).ready(function () {

    jQuery('#program_propagation_identifier_table').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/breeders/program/'+ <% $program_id %> + '/propagation_identifiers',
    });

});


</script>

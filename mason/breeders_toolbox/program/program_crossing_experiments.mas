<%args>
$program_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>


<table id="program_crossing_experiments" class="display">
    <thead>
        <tr>
            <th><% $c->i18n->p("cross.ui.crossing_experiment_name.c83dfee", "Crossing Experiment Name") |h %></th>
            <th><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></th>
        </tr>
    </thead>
</table>

<script>

jQuery(document).ready(function () {

    jQuery('#program_crossing_experiments').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/breeders/program/'+ <% $program_id %> + '/crossing_experiments',
    });

});

</script>

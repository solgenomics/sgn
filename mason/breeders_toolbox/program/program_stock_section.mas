<%once>
use HTML::Entities ();
</%once>
<%args>
$program_id
</%args>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <td>
                <a href="/breeders/accessions"><p><% $c->i18n->p("program.stock_section.manage_accessions", "Go To Manage Accessions") |h %></p></a>
            </td>
            <td>
                <a href="/breeders/seedlots"><p><% $c->i18n->p("program.stock_section.manage_seedlots", "Go To Manage Seedlots") |h %></p></a>
            </td>
        </div>
    </div>
    <&| /page/info_section.mas, id=>"program_accessions", title=>HTML::Entities::encode_entities($c->i18n->p("program.stock_section.accessions", "Accessions")), collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_accessions.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_crosses", title=>HTML::Entities::encode_entities($c->i18n->p("program.stock_section.crosses", "Crosses")), collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_crosses.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_seedlots", title=>HTML::Entities::encode_entities($c->i18n->p("program.stock_section.seedlots", "Seedlots")), collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_seedlots.mas, program_id => $program_id &>
    </&>
    <&| /page/info_section.mas, id=>"program_propagation_identifiers", title=>HTML::Entities::encode_entities($c->i18n->p("program.stock_section.propagation", "Propagation Identifiers")), collapsible=>1, collapsed=>1, hide_if_empty=>1 &>
        <& /breeders_toolbox/program/program_propagation_identifiers.mas, program_id => $program_id &>
    </&>
</div>

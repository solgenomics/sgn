<%once>
use HTML::Entities ();
</%once>
<%args>

$programs => undef
$program_id => undef
$program_name => undef

</%args>

<& /util/import_javascript.mas, classes => ['CXGN.TrialTreeFolders'] &>


<div class="modal fade" id="add_autogenerated_name_metadata_dialog" name="add_autogenerated_name_metadata_dialog" tabindex="-1" role="dialog" aria-labelledby="addAutogeneratedNameMetadataDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="reset" class="close" id="add_autogenerated_name_metadata_dismiss_button_1" name="add_autogenerated_name_metadata_dismiss_button" aria-label="<% $c->i18n->p("folder.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addAutogeneratedNameMetadataDialog"><% $c->i18n->p("program.autoname.title", "Add Autogenerated Name Metadata") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div>
                        <center>
                            <&| /page/explanation.mas, title=>'' &>
                                <p>
                                    <b><% $c->i18n->p("program.autoname.info_title", "Autogenerated Names") |h %></b>
                                    <br>
                                <a id="autogenerated_name_usage_info"><% $c->i18n->p("program.autoname.usage_link", "Usage Information") |h %></a>
                            </p>
                        </&>
                        </center>
                    </div>
                    <form class="form-horizontal" id="add_new_autogenerated_name_metadata_form" name="add_new_autogenerated_name_metadata_form">
% if ($programs) {
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("trial.create.program", "Breeding Program: ") |h %></label>
                            <div class="col-sm-8">
                                <select class="form-control" id="autogenerated_name_metadata_program" name="autogenerated_name_metadata_program">
                                    <option value=""><% $c->i18n->p("cross.ui.select_breeding_program", "Select Breeding Program") |h %></option>
<%perl>
foreach my $program (@$programs) {
if (@$program[3]) {
print "<option selected=\"selected\" value='".@$program[0]."'>".@$program[1]."</option>";
} else {
print "<option value='".@$program[0]."'>".@$program[1]."</option>";
}
}
</%perl>
                                </select>
                            </div>
                        </div>
% } elsif ($program_name) {
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("trial.create.program", "Breeding Program: ") |h %></label>
                            <div class="col-sm-8">
                                <select class="form-control" id="autogenerated_name_metadata_program" name="autogenerated_name_metadata_program">
                                    <option value="<%$program_id%>"><%$program_name%></option>
                                </select>
                            </div>
                        </div>
% }
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("program.autoname.format_name", "Format Name: ") |h %></label>
                            <div class="col-sm-8">
                                <input class="form-control" id="format_name" name="format_name" type="text" placeholder="<% $c->i18n->p("program.autoname.format_example", "For example: breedbase_transformants") |h %>"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("program.autoname.description", "Description: ") |h %></label>
                            <div class="col-sm-8">
                                <input class="form-control" id="autogenerated_name_metadata_description" name="autogenerated_name_metadata_description" type="text" placeholder="<% $c->i18n->p("program.autoname.optional", "Optional") |h %>" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("program.autoname.names_for", "Autogenerated Names for: ") |h %></label>
                            <div class="col-sm-8">
                                <select class="form-control" id="name_type">
                                    <option value=""><% $c->i18n->p("program.autoname.select_name_type", "Select a name type") |h %></option>
                                    <option value="transformant">transformant (accession)</option>
                                    <option value="plot"><% $c->i18n->p("program.autoname.plot_name", "plot name") |h %></option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("program.autoname.attribute_count", "How many attributes for basename: ") |h %></label>
                            <div class="col-sm-8">
                                <select class="form-control" id="number_of_attributes">
                                    <option value=""><% $c->i18n->p("program.autoname.select_number", "Select a number") |h %></option>
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                    <option value="5">5</option>
                                    <option value="6">6</option>
                                    <option value="7">7</option>
                                    <option value="8">8</option>
                                </select>
                            </div>
                        </div>
                        <div class="well" id="autogenerated_name_preview_box" style="display:none; margin-bottom:15px">
                            <p id="plot_template_naming_rules" style="display:none"><% $c->i18n->p("program.autoname.plot_template_rule", "Template must contain trial name and at least one of: plot number; accession name + replicate number; row number + column number") |h %><p>
                            <strong><% $c->i18n->p("program.autoname.preview", "Name preview:") |h %></strong> <span id="autogenerated_name_preview" style="font-family:monospace"></span><span id="autogenerated_name_preview_status"></span>
                            <div id="autogenerated_name_preview_missing" style="margin-top:5px; font-size:0.9em"></div>
                        </div>
                        <div id ="name_attributes_form_div">
                        </div>
                        <div id="last_serial_number_section" style="display:none">
                            <div class="form-group">
                                <label class="col-sm-4 control-label"><% $c->i18n->p("program.autoname.last_serial", "Last Serial Number: ") |h %></label>
                                <div class="col-sm-8">
                                    <input class="form-control" id="last_number" name="last_number" type="number" placeholder="<% $c->i18n->p("program.autoname.example_current", "For example: value 0. The next name would be BTI_1") |h %>"/>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_autogenerated_name_metadata_dismiss_button_2" name="add_autogenerated_name_metadata_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("folder.ui.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" id="new_autogenerated_name_metadata_submit"><% $c->i18n->p("trial.repetitive.submit", "Submit") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="add_autogenerated_name_metadata_message" name="add_autogenerated_name_metadata_message" tabindex="-1" role="dialog" aria-labelledby="addAutogeneratedNameMetadataMessage">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("folder.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addAutogeneratedNameMetadataMessage"><% $c->i18n->p("program.autoname.message_title", "Autogenerated Name Metadata") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        Autogenerated name format was stored successfully.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="add_autogenerated_name_format_close_button" id="add_autogenerated_name_format_close_button" data-dismiss="modal"><% $c->i18n->p("folder.ui.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="autogenerated_name_usage_info_dialog" name="autogenerated_name_usage_info_dialog" tabindex="-1" role="dialog" aria-labelledby="autogeneratedNameUsageInfoDialog">
    <div class="modal-dialog modal-xl " role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("folder.ui.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="autogeneratedNameUsageInfoDialog"><% $c->i18n->p("program.autoname.guide.title", "How to Use Autogenerated Name Feature") |h %></h4>
            </div>
            <div class="well well-lg">
                <div class="panel panel-default">
                    <div class="modal-body">
                        <div class="container-fluid">
                            <h4>
                                <% $c->i18n->p("program.autoname.guide.names_heading", "Autogenerated Names:") |h %>
                            </h4>
                            <li><% $c->i18n->p("program.autoname.guide.names_intro", "You can use the autogenerated name feature to automatically generate names based on your desired format followed by a serial number. Before you can use this feature, you need to store information about your naming format and other related metadata. Currently, only the transformation tool has this autogenerated name feature for generating transformant names. If you are interested in using this feature in other types of projects, please contact us.") |h %></li>
                            <li><% $c->i18n->p("program.autoname.guide.shared_formats", "Naming formats can be shared within the same breeding program. All stored formats are displayed in the Autogenerated Name Metadata section on the Breeding Program page.") |h %></li>
                            <br>
                            <h4>
                                <% $c->i18n->p("program.autoname.guide.metadata_heading", "Autogenerated Name Metadata:") |h %>
                            </h4>
                            <li><b><% $c->i18n->p("program.autoname.guide.label.program", "Breeding Program") |h %></b>: <% $c->i18n->p("program.autoname.guide.program", "Each breeding program can store different types of naming formats. You can choose which naming format you would like to use for each project.") |h %></li>
                            <li><b><% $c->i18n->p("program.autoname.guide.label.format", "Format Name") |h %></b>: <% $c->i18n->p("program.autoname.guide.format", "Format name must be globally unique. It is an identifier used for capturing all metadata related to each naming format.") |h %></li>
                            <li><b><% $c->i18n->p("program.autoname.guide.label.description", "Description") |h %></b>: <% $c->i18n->p("program.autoname.guide.description", "Description of this naming format.") |h %></li>
                            <li><b><% $c->i18n->p("program.autoname.guide.label.name_type", "Name Type") |h %></b>: <% $c->i18n->p("program.autoname.guide.name_type", "Name type is used to retrieve related information used as attributes in the naming format. For example, attributes for a transformant name can be breeding program, vector construct, plant material used in the transformation, transformation project, transformation ID, text field.") |h %></li>
                            <li><b><% $c->i18n->p("program.autoname.guide.label.attribute_count", "Number of Attributes") |h %></b>: <% $c->i18n->p("program.autoname.guide.attribute_count", "Indicating how many attributes you would like to include in a name. You can also include texts.") |h %></li>
                            <li><b><% $c->i18n->p("program.autoname.guide.label.basename", "Attributes for Basename") |h %></b>: <% $c->i18n->p("program.autoname.guide.basename", "You can specify attributes you would like to include in a basename, as well as the order of these attributes. If you would like to add text field in the basename, select \"text\", then specify the text field. Attributes are separated by an underscore.") |h %> <%perl>my $ui_basename_example = HTML::Entities::encode_entities($c->i18n->p("program.autoname.guide.basename_example", "For example, selecting 3 attributes, if you would like to include breeding program, vector construct, and a text field. The generated name would be %{example} and a %{serial_number}.", {example => "__SGN_B14_FORMAT__", serial_number => "__SGN_B14_SERIAL__"})); my $ui_serial_number_caption = HTML::Entities::encode_entities($c->i18n->p("program.autoname.guide.serial_number", "serial number")); $ui_basename_example =~ s/__SGN_B14_FORMAT__/<b>"breedingProgram_vectorConstruct_text"<\/b>/; $ui_basename_example =~ s/__SGN_B14_SERIAL__/'<b>'.$ui_serial_number_caption.'<\/b>'/e; print $ui_basename_example; </%perl></li>
                            <li><b><% $c->i18n->p("program.autoname.guide.label.last_serial", "Last Serial Number") |h %></b>: <% $c->i18n->p("program.autoname.guide.last_serial", "If you previously used this naming format before using the database. This input field allows you to continue using your naming format by indicating the last serial number that you used. If this is a new format, please indicates \"0\". The first name will have \"1\" as the first serial number. After you use the naming format to add new names in the database, the last serial number is automatically updated and stored as new metadata of that naming format.") |h %></li>
                            <br>
                            <h4>
                                <% $c->i18n->p("program.autoname.guide.project_heading", "Setting Up Naming Format for Each Project:") |h %>
                            </h4>
                            <li><% $c->i18n->p("program.autoname.guide.project_setup", "Once you store autogenerated name metadata for each format, you can set up specific naming format for each project") |h %></li>
                            <li><% $c->i18n->p("program.autoname.guide.project_link", "The link for setting up naming format is on each transformation project page") |h %></li>
                        </div>
                        <div class="modal-footer">
                            <button id="close_autogenerated_name_info_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("folder.ui.close", "Close") |h %></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>

function _sgnB14AutonameEscape(value) { return jQuery('<div>').text(value).html(); }

jQuery(document).ready(function(){

    jQuery("[name='add_autogenerated_name_metadata_link']").click(function(e) {
        e.preventDefault();
        jQuery("#add_autogenerated_name_metadata_dialog").modal("show");
    });

    jQuery('#autogenerated_name_usage_info').click(function(){
        jQuery('#autogenerated_name_usage_info_dialog').modal("show");
    });

    var name_type;

    jQuery("#name_type").change(function() {
        jQuery('#number_of_attributes').val('');
        let attribute_table = document.getElementById("name_attributes_table");
        if (attribute_table) {
            attribute_table.hidden = true;
        }

        name_type = jQuery('#name_type').val();
        if (name_type == 'transformant') {
            jQuery('#last_serial_number_section').modal("show");
            jQuery('#plot_template_naming_rules').css("display", "none");
        } else {
            jQuery('#last_serial_number_section').modal("hide");
            jQuery('#plot_template_naming_rules').css("display", "");
        }
    })

    jQuery("#number_of_attributes").change(function() {
        if (!name_type) {
            jQuery('#number_of_attributes').val('');
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.autoname.required_name_type_first", "Please select a name type first") : "Please select a name type first"));
            return;
        }

        number_of_attributes = jQuery('#number_of_attributes').val();
        if (number_of_attributes){
            name_attributes_form(name_type);
            document.getElementById("name_attributes_table").hidden = false;
        }
    })

    function name_attributes_form (name_type) {
        let number_of_attributes = parseInt(jQuery('#number_of_attributes').val());

        let html = '<table class="table table-bordered" id="name_attributes_table"><thead><tr><th>' + _sgnB14AutonameEscape(window.SGN && window.SGN.i18n ? window.SGN.i18n.p('program.autoname.attribute_order', 'Attribute Order') : 'Attribute Order') + '</th><th>' + _sgnB14AutonameEscape(window.SGN && window.SGN.i18n ? window.SGN.i18n.p('program.autoname.select_attribute', 'Select Attribute') : 'Select Attribute') + '</th></tr></thead><tbody>';
        for(let i=0; i<number_of_attributes; i++){
            let attribute_order = i+1;
            html = html + '<tr><td>' + attribute_order + '</td><td><div name="attribute_selects" id="attribute_select_' +i+ '"></div></td><td><span id="selected_attribute_'+ i +'_string" data-related="'+encodeURI(attribute_order)+'" ></span></td></tr>';
        };
        html = html + '</tbody></table>';

        jQuery('#name_attributes_form_div').html(html);

        let attribute_list = jQuery('#name_attributes_table')
            .find("div")
            .map(function() { return this.id; })
            .get();
        for(let i=0; i<attribute_list.length; i++){
            if (name_type == 'transformant') {
                get_select_box('transformant_related_attributes', attribute_list[i], {'name' : 'selected_attribute', 'id' : 'selected_attribute_'+i,  });
            } else if (name_type == 'plot') {
                get_select_box('plot_related_attributes', attribute_list[i], {'name' : 'selected_attribute', 'id' : 'selected_attribute_'+i,  });
            }
        };
    };

    function update_preview() {
        let parts = [];
        let selected_attributes = [];
        jQuery('select[name="selected_attribute"]').each(function() {
            let value = this.value;
            if (!value) return;
            if (value === 'text') {
                let text_val = jQuery('#' + this.id + '_string').find('input').val() || '';
                parts.push(text_val);
            } else {
                parts.push('{' + value + '}');
                selected_attributes.push(value);
            }
        });
        jQuery('#autogenerated_name_preview').text(parts.join('_'));
        jQuery('#autogenerated_name_preview_box').toggle(parts.length > 0);

        let status_html = '';
        let missing_html = '';

        if (parts.length > 0 && name_type === 'plot') {
            let has_trial_name     = selected_attributes.indexOf('trialName') !== -1;
            let has_accession_name = selected_attributes.indexOf('accessionName') !== -1;
            let has_rep_number     = selected_attributes.indexOf('repNumber') !== -1;
            let has_row_number     = selected_attributes.indexOf('rowNumber') !== -1;
            let has_col_number     = selected_attributes.indexOf('colNumber') !== -1;
            let has_plot_number    = selected_attributes.indexOf('plotNumber') !== -1;

            let combo1_valid = has_accession_name && has_rep_number;
            let combo2_valid = has_row_number && has_col_number;
            let combo3_valid = has_plot_number;
            let is_valid = has_trial_name && (combo1_valid || combo2_valid || combo3_valid);

            if (is_valid) {
                status_html = ' <span class="glyphicon glyphicon-ok" style="color:green" aria-label="' + _sgnB14AutonameEscape(window.SGN && window.SGN.i18n ? window.SGN.i18n.p('program.autoname.valid', 'valid') : 'valid') + '"></span>';
            } else {
                let missing = [];
                if (!has_trial_name) missing.push('trial name');

                if (!combo1_valid && !combo2_valid && !combo3_valid) {
                    if (has_accession_name && !has_rep_number) {
                        missing.push('replicate number');
                    } else if (!has_accession_name && has_rep_number) {
                        missing.push('accession name');
                    } else if (has_row_number && !has_col_number) {
                        missing.push('column number');
                    } else if (!has_row_number && has_col_number) {
                        missing.push('row number');
                    } else {
                        missing.push('at least one of: plot number; accession name + replicate number; row number + column number');
                    }
                }

                status_html = ' <span style="color:red">*</span>';
                missing_html = '<span style="color:red">' + _sgnB14AutonameEscape(window.SGN && window.SGN.i18n ? window.SGN.i18n.p('program.autoname.missing', 'Missing: ') : 'Missing: ') + missing.join(', ') + '</span>';
            }
        }

        jQuery('#autogenerated_name_preview_status').html(status_html);
        jQuery('#autogenerated_name_preview_missing').html(missing_html);
    }

    jQuery(document).on('change', "select[name='selected_attribute']", function() {
        let div_id = '#' + this.id;
        let attribute = jQuery(div_id).val();
        if (attribute == 'text') {
            attribute_string(div_id, div_id + '_string');
        } else {
            jQuery(div_id + '_string').html('');
        }
        update_preview();
    });

    jQuery(document).on('input', '#name_attributes_form_div input', function() {
        update_preview();
    });

    function attribute_string(div_id, select_id){
        let html = '<td><input class="form-control" placeholder="' + _sgnB14AutonameEscape(window.SGN && window.SGN.i18n ? window.SGN.i18n.p('program.autoname.text_placeholder', 'Please enter text string') : 'Please enter text string') + '"/></td>';
        jQuery(select_id).html(html);
    };

    jQuery('#new_autogenerated_name_metadata_submit').click(function(e){
        e.preventDefault();
        let name_attributes = [];

        jQuery('select[name="selected_attribute"]').each(function() {
            value = this.value;
            let text_string;
            if (value == 'text') {
                text_string = jQuery('#' + this.id + '_string').find('input').val() || '';
                name_attributes.push({'text':text_string});
            } else {
                name_attributes.push(value);
            }
        });

        let breeding_program = jQuery('#autogenerated_name_metadata_program').val();
        if (!breeding_program) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.autoname.required_program", "Breeding program is required") : "Breeding program is required"));
            return;
        }

        let format_name = jQuery('#format_name').val();
        if (!format_name) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.autoname.required_format", "Format name is required") : "Format name is required"));
            return;
        }

        let description = jQuery('#autogenerated_name_metadata_description').val();

        let name_type = jQuery('#name_type').val();
        if (!name_type) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.autoname.required_name_type", "Name type is required") : "Name type is required"));
            return;
        }

        let last_serial_number = jQuery('#last_number').val();
        if (name_type == 'transformant') {
            if (!last_serial_number) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.autoname.required_serial", "Last serial number is required") : "Last serial number is required"));
                return;
            }
        }

        jQuery.ajax({
            url: '/ajax/add_autogenerated_name_metadata',
            method: 'POST',
            data: {
                'breeding_program': breeding_program,
                'format_name': format_name,
                'description': description,
                'name_type': name_type,
                'last_serial_number': last_serial_number,
                'name_attributes': JSON.stringify(name_attributes),
            },
            dataType:'json',
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error) {
                    alert(response.error);
                } else {
                    var refresh_callback = jQuery('#add_autogenerated_name_metadata_dialog').data('refresh_callback');
                    if (refresh_callback) {
                        jQuery("#add_autogenerated_name_metadata_message").modal({backdrop: false});
                    } else {
                        jQuery("#add_autogenerated_name_metadata_message").modal("show");
                    }
                    jQuery('#add_autogenerated_name_metadata_dialog').modal("hide");

                    if (typeof refresh_callback === 'function') {
                        refresh_callback();
                    }
                }
            },
            error: function() {
                jQuery("#working_modal").modal("hide");
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("program.autoname.store_error", "An error occurred storing autogenerated name metadata.") : "An error occurred storing autogenerated name metadata."));
                jQuery('#add_autogenerated_name_metadata_dialog').modal("hide");
            },
        });

    });

    jQuery("[name='add_autogenerated_name_metadata_dismiss_button']").click(function() {
        jQuery('#add_autogenerated_name_metadata_dialog').modal('hide');
        jQuery('#autogenerated_name_metadata_program').val('');
        jQuery('#format_name').val('');
        jQuery('#autogenerated_name_metadata_description').val('');
        jQuery('#name_type').val('');
        jQuery('#last_number').val('');
        jQuery('#number_of_attributes').val('');
        if (!jQuery('#add_autogenerated_name_metadata_dialog').data('refresh_callback')) {
            jQuery(".modal-backdrop").remove();
            location.reload();
        }
    });

    jQuery("#add_autogenerated_name_format_close_button").click(function(){
        jQuery('#add_autogenerated_name_metadata_message').modal('hide');
        jQuery('#autogenerated_name_metadata_program').val('');
        jQuery('#format_name').val('');
        jQuery('#autogenerated_name_metadata_description').val('');
        jQuery('#name_type').val('');
        jQuery('#last_number').val('');
        jQuery('#number_of_attributes').val('');
        if (!jQuery('#add_autogenerated_name_metadata_dialog').data('refresh_callback')) {
            jQuery(".modal-backdrop").remove();
            location.reload();
        }
    });

});

</script>

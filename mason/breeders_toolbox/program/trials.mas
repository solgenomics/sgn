
<%args>
$program_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>


<table id="trial_summary_data_<% $program_id %>" class="display">
    <thead>
        <tr>
            <th><% $c->i18n->p('trial.card.program_trials.column.name', 'Trial name') |h %></th>
            <th><% $c->i18n->p('trial.card.program_trials.column.description', 'Description') |h %></th>
        </tr>
    </thead>
</table>

<script>

jQuery(document).ready(function () {

    jQuery('#trial_summary_data_<% $program_id %>').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/breeders/program/'+ <% $program_id %> + '/field_trials',
    });

});

</script>

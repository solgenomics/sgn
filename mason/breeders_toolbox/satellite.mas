<%doc>

=head1 NAME

/breeders_toolbox/satellite.mas - Satellite page (/breeders/satellite)

=head1 DESCRIPTION

Sentinel-2 (10 m, ~every 5 days) and Landsat 8/9 (30 m, ~every 8 days)
images, free, of the field of a research station or of a trial for a date range, in steps like the Script Factory
pipeline: 1 location, 2 field (trial plots from their GPS coordinates, or a
square around a point picked on the map), 3 dates (presets or the trial
season), satellites and view (true colour or NDVI), 4 images. Each date's cloud cover is
measured over the field itself; cloudy dates are hidden unless asked. Code:
js/source/entries/satellite.js (images read in the browser by
js/source/modules/cog_reader.js); endpoints /ajax/satellite/*.

=head1 AUTHOR

Chris Simoes

=cut

</%doc>

<& /util/import_javascript.mas, classes => ['jquery'], entries => ['satellite'] &>
<& /util/import_css.mas, paths => ['leaflet.css'] &>

<style>
.sat-app { --sat-accent: #2b7a4b; --sat-accent-soft: #e8f4ec; --sat-border: #dfe3e8; --sat-muted: #6b7280; --sat-bg: #f7f9fa; margin-bottom: 40px; }
.sat-app h3 { font-size: 18px; margin: 0 0 6px 0; font-weight: 600; }
.sat-app h4 { font-size: 15px; font-weight: 600; margin: 16px 0 8px; }
.sat-help { color: var(--sat-muted); font-size: 13px; }
.sat-muted { color: var(--sat-muted); }
.sat-small { font-size: 12px; }
.sat-hero { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 20px 24px; margin: 10px 0 18px; border-radius: 10px; background: linear-gradient(120deg, #1f5f3a 0%, #2b7a4b 55%, #4c9a6a 100%); color: #fff; }
.sat-hero h2 { margin: 0 0 6px; font-weight: 600; color: #fff; }
.sat-hero p { margin: 0; max-width: 720px; opacity: .92; }
.sat-badge { background: rgba(255,255,255,.15); border-radius: 16px; padding: 3px 12px; font-size: 13px; }
.sat-badge-label { text-transform: uppercase; font-size: 10px; letter-spacing: .08em; opacity: .8; margin-right: 6px; }
.sat-stepper { display: flex; list-style: none; padding: 0; margin: 0 0 18px; }
.sat-stepper li { flex: 1; position: relative; text-align: center; cursor: pointer; padding-top: 4px; color: var(--sat-muted); font-size: 13px; }
.sat-stepper li:before { content: ''; position: absolute; top: 19px; left: -50%; width: 100%; height: 3px; background: var(--sat-border); z-index: 0; }
.sat-stepper li:first-child:before { display: none; }
.sat-stepper li.done:before, .sat-stepper li.active:before { background: var(--sat-accent); }
.sat-step-num { position: relative; z-index: 1; display: block; margin: 0 auto 6px; width: 32px; height: 32px; line-height: 28px; border-radius: 50%; border: 2px solid var(--sat-border); background: #fff; font-weight: 600; }
.sat-stepper li.active .sat-step-num { background: var(--sat-accent); border-color: var(--sat-accent); color: #fff; box-shadow: 0 0 0 4px var(--sat-accent-soft); }
.sat-stepper li.done .sat-step-num { border-color: var(--sat-accent); color: var(--sat-accent); }
.sat-stepper li.active .sat-step-label { color: #111; font-weight: 600; }
.sat-stepper li.off { opacity: .5; cursor: not-allowed; }
.sat-card { background: #fff; border: 1px solid var(--sat-border); border-radius: 10px; padding: 18px 20px; margin-bottom: 16px; box-shadow: 0 1px 2px rgba(0,0,0,.03); }
.sat-card-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 6px; }
.sat-label { display: block; font-weight: 600; font-size: 13px; margin: 12px 0 4px; }
.sat-nav { display: flex; justify-content: space-between; margin: 6px 0 24px; }
.sat-loc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; max-height: 460px; overflow-y: auto; margin-top: 10px; padding: 2px; }
.sat-loc { display: block; border: 1px solid var(--sat-border); border-radius: 8px; padding: 8px 10px; cursor: pointer; color: #111827; text-decoration: none !important; }
.sat-loc:hover { border-color: var(--sat-accent); }
.sat-loc.on { border-color: var(--sat-accent); background: var(--sat-accent-soft); }
.sat-loc.dis { opacity: .55; }
.sat-loc small { display: block; color: var(--sat-muted); }
.sat-loc { position: relative; padding-left: 34px; }
.sat-loc-check { position: absolute; left: 9px; top: 9px; width: 17px; height: 17px; border: 2px solid #c3ccd5; border-radius: 4px; font-size: 12px; line-height: 13px; text-align: center; color: #fff; }
.sat-loc.on .sat-loc-check { background: var(--sat-accent); border-color: var(--sat-accent); }
.sat-selected { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 12px; min-height: 26px; }
.sat-chip { display: inline-flex; align-items: center; gap: 2px; background: var(--sat-accent-soft); border: 1px solid #b9d8c4; border-radius: 14px; padding: 1px 4px 1px 10px; font-size: 12.5px; }
.sat-chip-x { border: 0; background: none; font-size: 16px; line-height: 1; color: #4b5563; padding: 0 4px; cursor: pointer; }
.sat-chip-x:hover { color: #b91c1c; }
.sat-res-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 12px; }
.sat-site-tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 12px; }
.sat-site { border: 1px solid var(--sat-border); background: #fff; border-radius: 16px; padding: 4px 12px; font-size: 13px; cursor: pointer; }
.sat-site.on { background: var(--sat-accent); border-color: var(--sat-accent); color: #fff; }
.sat-site.bad span { color: #dc2626; font-weight: 700; }
.sat-site.on.bad span { color: #fecaca; }
.sat-draw { background: var(--sat-bg); border-radius: 8px; padding: 10px 14px; margin-top: 8px; font-size: 13px; }
.sat-draw-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
.sat-draw-active { margin-top: 6px; padding: 6px 10px; border-left: 3px solid #f97316; background: #fff7ed; border-radius: 4px; }
.sat-draw-save { margin-top: 6px; }
.sat-fields-table { margin: 0; background: transparent; }
.sat-fields-table td { vertical-align: middle !important; border-top: 0 !important; padding: 2px 6px 2px 0 !important; }
.sat-fields-table input { max-width: 260px; }
#sat_map.sat-drawing, #sat_map.sat-drawing .leaflet-interactive { cursor: crosshair !important; }
.sat-options { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin: 10px 0; }
.sat-option { position: relative; display: block; border: 2px solid var(--sat-border); border-radius: 10px; padding: 12px 14px 12px 38px; cursor: pointer; font-weight: normal; margin: 0; transition: border-color .15s, background .15s; }
.sat-option input { position: absolute; left: 14px; top: 15px; pointer-events: none; }   /* clicks go to the card (one handler keeps card and box in step) */
.sat-option:hover { border-color: #9cc9ac; }
.sat-option.on { border-color: var(--sat-accent); background: var(--sat-accent-soft); }
.sat-option.disabled { opacity: .55; cursor: not-allowed; }
.sat-option-title { display: block; font-weight: 600; margin-bottom: 3px; }
.sat-option-text { display: block; font-size: 12.5px; color: #4b5563; }
.sat-subopts { background: var(--sat-bg); border-radius: 8px; padding: 10px 14px; margin-top: 6px; }
.sat-segs { display: flex; gap: 4px; flex-wrap: wrap; }
.sat-seg { border: 1px solid var(--sat-border); background: #fff; border-radius: 16px; padding: 3px 11px; font-size: 12.5px; color: #374151; cursor: pointer; }
.sat-seg:hover { border-color: #9cc9ac; }
.sat-seg.on { background: var(--sat-accent); border-color: var(--sat-accent); color: #fff; }
.sat-seg[disabled] { opacity: .45; cursor: not-allowed; }
.sat-inline-row { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 16px; margin-top: 8px; }
.sat-switch { position: relative; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 600; margin: 0; }
.sat-switch input { display: none; }
.sat-slider { width: 40px; height: 22px; background: #cbd5e1; border-radius: 22px; position: relative; transition: background .2s; }
.sat-slider:after { content: ''; position: absolute; width: 18px; height: 18px; left: 2px; top: 2px; background: #fff; border-radius: 50%; transition: left .2s; }
.sat-switch input:checked + .sat-slider { background: var(--sat-accent); }
.sat-switch input:checked + .sat-slider:after { left: 20px; }
#sat_map { height: clamp(520px, 66vh, 860px); border-radius: 8px; border: 1px solid var(--sat-border); margin-top: 12px; }
.sat-map-full { position: fixed !important; top: 8px; left: 8px; right: 8px; bottom: 8px; width: auto !important; height: auto !important; margin: 0 !important; z-index: 2000; box-shadow: 0 0 0 9999px rgba(0,0,0,.45); }
.sat-full-btn { background: #fff; border: 2px solid rgba(0,0,0,.2); border-radius: 4px; padding: 4px 9px; font-size: 13px; font-weight: 600; cursor: pointer; color: #111827; }
.sat-full-btn:hover { background: #f3f4f6; }
.sat-summary { position: sticky; top: 70px; background: var(--sat-bg); border: 1px solid var(--sat-border); border-radius: 10px; padding: 14px 16px; }
.sat-summary h4 { margin-top: 0; }
.sat-flow { list-style: none; padding: 0; margin: 0; }
.sat-flow li { position: relative; padding: 0 0 14px 22px; font-size: 13px; }
.sat-flow li:before { content: ''; position: absolute; left: 5px; top: 5px; width: 9px; height: 9px; border-radius: 50%; background: var(--sat-accent); }
.sat-flow li:after { content: ''; position: absolute; left: 9px; top: 16px; bottom: 0; width: 1px; background: #c9d3dc; }
.sat-flow li:last-child:after { display: none; }
.sat-flow li.off:before { background: #cbd5e1; }
.sat-flow li.off { color: var(--sat-muted); }
.sat-flow b { display: block; }
.sat-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 12px; margin-bottom: 16px; }
.sat-stat { background: #fff; border: 1px solid var(--sat-border); border-radius: 10px; padding: 12px 14px; }
.sat-stat .v { font-size: 24px; font-weight: 600; color: var(--sat-accent); line-height: 1.1; }
.sat-stat .l { font-size: 12px; color: var(--sat-muted); text-transform: uppercase; letter-spacing: .04em; }
.sat-status { margin: 0 0 10px; font-size: 13px; color: #374151; min-height: 18px; }
.sat-progress { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 10px; margin: 2px 0 8px; padding: 8px 12px; background: var(--sat-accent-soft); border-radius: 8px; font-size: 13px; color: #1f3d2a; }
.sat-spin { width: 16px; height: 16px; flex: none; border: 2px solid #b9d8c4; border-top-color: var(--sat-accent); border-radius: 50%; animation: sat-spin .8s linear infinite; }
.sat-bar { flex: 1 1 160px; position: relative; height: 6px; background: #fff; border-radius: 3px; overflow: hidden; }
.sat-bar > div { height: 100%; width: 0; background: var(--sat-accent); border-radius: 3px; transition: width .3s; }
.sat-bar.indet > div { position: absolute; width: 30%; animation: sat-indet 1.2s ease-in-out infinite; }
#sat_progress_count { color: var(--sat-muted); font-variant-numeric: tabular-nums; }
#sat_elapsed { min-width: 64px; text-align: right; font-weight: 600; font-variant-numeric: tabular-nums; }
@keyframes sat-spin { to { transform: rotate(360deg); } }
@keyframes sat-indet { from { left: -30%; } to { left: 100%; } }
@media (prefers-reduced-motion: reduce) { .sat-spin, .sat-bar.indet > div { animation-duration: 3s; } }
.sat-timeline { position: relative; height: 34px; margin: 6px 0 14px; border-bottom: 1px solid var(--sat-border); }
.sat-tick { position: absolute; bottom: 0; width: 7px; margin-left: -3px; border-radius: 3px 3px 0 0; cursor: pointer; }
.sat-tick.ls { width: 3px; margin-left: -1px; border-radius: 2px 2px 0 0; }
.sat-sat { font-size: 11px; color: var(--sat-muted); }
.sat-sat.ls { color: #1d4ed8; }
.sat-tl-labels { display: flex; justify-content: space-between; font-size: 11px; color: var(--sat-muted); margin-top: -10px; margin-bottom: 4px; }
.sat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; }
.sat-tile { border: 1px solid var(--sat-border); border-radius: 8px; overflow: hidden; background: var(--sat-bg); cursor: pointer; }
.sat-tile:hover { border-color: var(--sat-accent); }
.sat-tile { position: relative; }
.sat-hide { position: absolute; top: 6px; right: 6px; z-index: 2; width: 26px; height: 26px; border-radius: 50%; border: 0; background: rgba(17,24,39,.65); color: #fff; font-size: 18px; line-height: 24px; padding: 0; cursor: pointer; opacity: .85; }
.sat-hide:hover, .sat-hide:focus { background: #b91c1c; opacity: 1; }
.sat-unhide { position: absolute; top: 6px; right: 6px; z-index: 2; }
.sat-tile.hid canvas { opacity: .35; }
.sat-tile.hid { border-style: dashed; }
.sat-tile canvas { display: block; width: 100%; aspect-ratio: 1 / 1; background: #e5e7eb; }
.sat-tile-cap { padding: 6px 8px; font-size: 12px; display: flex; justify-content: space-between; gap: 6px; }
.sat-tile-cap b { font-weight: 600; }
.sat-legend { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 12px; color: var(--sat-muted); margin: 4px 0 10px; }
.sat-ramp { width: 180px; height: 10px; border-radius: 3px; }
#sat_chart svg { width: 100%; height: 190px; display: block; }
#sat_model_map { height: clamp(560px, 70vh, 900px); border-radius: 8px; border: 1px solid var(--sat-border); margin-top: 10px; }
#sat_model_map.sat-drawing, #sat_model_map.sat-drawing .leaflet-interactive { cursor: crosshair !important; }
.sat-options.sat-checks .sat-option input { top: 14px; }
.sat-class-row { display: flex; align-items: center; gap: 8px; padding: 4px 0; flex-wrap: wrap; }
.sat-swatch { width: 18px; height: 18px; border-radius: 4px; border: 1px solid rgba(0,0,0,.15); flex: none; }
.sat-class-row input[type=text] { max-width: 200px; }
.sat-count { font-size: 12px; color: var(--sat-muted); min-width: 92px; }
.sat-count.bad { color: #b45309; font-weight: 600; }
.sat-mini-table { width: 100%; font-size: 12.5px; border-collapse: collapse; }
.sat-mini-table th { font-weight: 600; color: var(--sat-muted); text-align: left; padding: 4px 6px; border-bottom: 1px solid var(--sat-border); }
.sat-mini-table td { padding: 4px 6px; border-bottom: 1px solid #f0f2f4; vertical-align: middle; }
.sat-mini-table input { max-width: 120px; }
.sat-mini-table td.num, .sat-mini-table th.num { text-align: right; font-variant-numeric: tabular-nums; }
.sat-check-list { list-style: none; padding: 0; margin: 0; font-size: 13px; }
.sat-check-list li { padding: 2px 0 2px 22px; position: relative; }
.sat-check-list li:before { position: absolute; left: 2px; font-weight: 700; }
.sat-check-list li.ok:before { content: '\2713'; color: var(--sat-accent); }
.sat-check-list li.no:before { content: '\2715'; color: #dc2626; }
.sat-check-list li.no { color: #991b1b; }
.sat-result-map { position: relative; }
.sat-result-map canvas { width: 100%; height: auto; image-rendering: pixelated; border-radius: 6px; background: #1f2937; display: block; }
.sat-legend-row { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 8px 0; font-size: 12.5px; }
.sat-legend-row span { display: inline-flex; align-items: center; gap: 5px; }
.sat-cm td, .sat-cm th { text-align: center !important; }
.sat-cm td.diag { background: var(--sat-accent-soft); font-weight: 600; }
#sat_yield_plot svg { width: 100%; max-width: 420px; height: auto; display: block; }
.sat-adv-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 10px 18px; }
.sat-adv-grid label { font-weight: 600; font-size: 13px; margin: 0; }
.sat-adv-grid .sat-help { font-size: 12px; }
.sat-flash { animation: sat-flash 1.6s ease-out; border-radius: 8px; }
@keyframes sat-flash { 0%, 40% { box-shadow: 0 0 0 4px #fbbf24; } 100% { box-shadow: 0 0 0 0 transparent; } }
.sat-warn { background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 8px 12px; font-size: 13px; color: #92400e; margin-bottom: 12px; }
#sat_big canvas { width: 100%; height: auto; display: block; border-radius: 6px; background: #e5e7eb; }
.sat-big-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; }
</style>

<div class="container-fluid sat-app">
  <div class="sat-hero">
    <div>
      <h2>Satellite images</h2>
      <p>See the field of a research station or of a trial on any date range: free Sentinel-2 images (European Copernicus program, 10 m pixels, a new image about every 5 days since 2017) and Landsat 8/9 (USGS/NASA, 30 m pixels, about every 8 days since 2013). Clouds are measured over your field, not the whole image.</p>
    </div>
    <div><span class="sat-badge"><span class="sat-badge-label">Location</span><span id="sat_badge">none chosen</span></span></div>
  </div>

  <ol class="sat-stepper" id="sat_stepper">
    <li data-step="1"><span class="sat-step-num">1</span><span class="sat-step-label">Location</span></li>
    <li data-step="2"><span class="sat-step-num">2</span><span class="sat-step-label">Field</span></li>
    <li data-step="3"><span class="sat-step-num">3</span><span class="sat-step-label">Dates &amp; view</span></li>
    <li data-step="4"><span class="sat-step-num">4</span><span class="sat-step-label">Images</span></li>
    <li data-step="5"><span class="sat-step-num">5</span><span class="sat-step-label">Model</span></li>
    <li data-step="6"><span class="sat-step-num">6</span><span class="sat-step-label">Results</span></li>
  </ol>

  <div class="row">
    <div class="col-md-9">

      <div class="sat-pane" data-step="1">
        <div class="sat-card">
          <h3>Choose the locations</h3>
          <div class="sat-help">Breedbase locations: research stations, or farms of a production area. Choose one, or keep adding locations to analyse them together. A location needs latitude/longitude, or you can pick the field on the map in the next step.</div>
          <div class="sat-inline-row" style="margin-top:10px">
            <div class="sat-segs" id="sat_loc_types"></div>
            <input type="search" id="sat_loc_search" class="form-control input-sm" placeholder="Search by name, country, program or type" style="flex:1 1 240px;max-width:420px" />
          </div>
          <div id="sat_selected" class="sat-selected"></div>
          <div id="sat_locations" class="sat-loc-grid"><span class="sat-muted sat-small">Loading…</span></div>
        </div>
        <div class="sat-nav"><span></span><button class="btn btn-primary sat-next" data-to="2" disabled>Next: field &rarr;</button></div>
      </div>

      <div class="sat-pane" data-step="2" style="display:none">
        <div class="sat-card">
          <div class="sat-site-tabs" style="display:none"></div>
          <h3>Which field? <span class="sat-muted" style="font-weight:normal;font-size:14px" id="sat_field_loc"></span></h3>
          <div class="sat-help">A 10 m pixel (Sentinel-2) or 30 m pixel (Landsat) is larger than a breeding plot: the images show the trial area, not single plots.</div>
          <div class="sat-options" id="sat_field_mode">
            <label class="sat-option" data-v="trial"><input type="radio" name="sat_field_mode" value="trial" /><span class="sat-option-title">A trial</span><span class="sat-option-text">The trial's plots from their GPS coordinates; cloud is measured over the plots. The trial season fills the dates.</span></label>
            <label class="sat-option" data-v="fields"><input type="radio" name="sat_field_mode" value="fields" /><span class="sat-option-title">Farm fields</span><span class="sat-option-text">Draw the production fields of the farm on the map; they are saved with the farm for the next analyses.</span></label>
            <label class="sat-option" data-v="point"><input type="radio" name="sat_field_mode" value="point" /><span class="sat-option-title">Around a point</span><span class="sat-option-text">A square around the location, or around the point you click on the map.</span></label>
          </div>
          <div class="sat-subopts" id="sat_trial_box">
            <label class="sat-label" for="sat_trial" style="margin-top:0">Trial</label>
            <select id="sat_trial" class="form-control input-sm"></select>
          </div>
          <div class="sat-subopts" id="sat_size_box">
            <label class="sat-label" style="margin-top:0">Size of the square</label>
            <div class="sat-segs" id="sat_size"></div>
          </div>
          <div class="sat-draw" id="sat_draw_box" style="display:none"></div>
          <div id="sat_map"></div>
          <div class="sat-help" id="sat_map_hint" style="margin-top:6px"></div>
        </div>
        <div class="sat-nav"><button class="btn btn-default sat-next" data-to="1">&larr; Back</button><button class="btn btn-primary sat-next" data-to="3" id="sat_to3">Next: dates &rarr;</button></div>
      </div>

      <div class="sat-pane" data-step="3" style="display:none">
        <div class="sat-card">
          <h3>Dates</h3>
          <div class="sat-inline-row">
            <div><label class="sat-label" for="sat_start">Start</label><input type="date" id="sat_start" class="form-control input-sm" /></div>
            <div><label class="sat-label" for="sat_end">End</label><input type="date" id="sat_end" class="form-control input-sm" /></div>
            <div><label class="sat-label">Quick choice</label><div class="sat-segs" id="sat_presets"></div></div>
          </div>
          <h4>Satellites</h4>
          <div class="sat-options" id="sat_sources"><span class="sat-muted sat-small">Loading…</span></div>
          <h4>View</h4>
          <div class="sat-options" id="sat_view">
            <label class="sat-option" data-v="rgb"><input type="radio" name="sat_view" value="rgb" /><span class="sat-option-title">True colour</span><span class="sat-option-text">The field as the eye sees it: soil, canopy, harvest, flooding. About 1 MB per date (Landsat less).</span></label>
            <label class="sat-option" data-v="ndvi"><input type="radio" name="sat_view" value="ndvi" /><span class="sat-option-title">NDVI (vegetation)</span><span class="sat-option-text">Green canopy index from red and near-infrared, with a curve over time: emergence, canopy closure, senescence. About 2.7 MB per date (Landsat less).</span></label>
          </div>
          <div class="sat-inline-row">
            <label class="sat-switch"><input type="checkbox" id="sat_cloudy" /><span class="sat-slider"></span>Show cloudy dates too</label>
            <span class="sat-help">A date is clear when at least 80% of the field has no cloud or cloud shadow.</span>
          </div>
        </div>
        <div class="sat-nav"><button class="btn btn-default sat-next" data-to="2">&larr; Back</button><button class="btn btn-primary" id="sat_go">Show images &rarr;</button></div>
      </div>

      <div class="sat-pane" data-step="4" style="display:none">
        <div class="sat-site-tabs" style="display:none"></div>
        <div class="sat-stats" id="sat_stats"></div>
        <div class="sat-card">
          <div class="sat-card-head"><h3>Dates <span class="sat-muted" style="font-weight:normal;font-size:14px" id="sat_site_name"></span></h3><span class="sat-help">taller = clearer over the field · click a date to enlarge</span></div>
          <div class="sat-progress" id="sat_progress" style="display:none"><span class="sat-spin" aria-hidden="true"></span><span id="sat_progress_text" role="status"></span><span id="sat_progress_count"></span><div class="sat-bar"><div></div></div><span id="sat_elapsed" title="time since you clicked Show images"></span></div>
          <div class="sat-status" id="sat_status"></div>
          <div class="sat-timeline" id="sat_timeline"></div>
          <div class="sat-tl-labels" id="sat_tl_labels"></div>
        </div>
        <div class="sat-card" id="sat_ndvi_block" style="display:none">
          <h3>NDVI over time</h3>
          <div id="sat_chart"></div>
          <div class="sat-help" id="sat_chart_note"></div>
        </div>
        <div class="sat-card">
          <div class="sat-card-head"><h3>Images</h3>
            <span style="display:flex;gap:14px;flex-wrap:wrap"><span id="sat_hidden_box"></span><label class="sat-switch sat-small"><input type="checkbox" id="sat_cloudy4" /><span class="sat-slider"></span>Show cloudy dates</label></span>
          </div>
          <div class="sat-legend" id="sat_legend"></div>
          <div class="sat-grid" id="sat_grid"></div>
        </div>
        <div class="sat-nav"><button class="btn btn-default sat-next" data-to="3">&larr; Change dates or view</button><button class="btn btn-primary sat-next" data-to="5">Next: model &rarr;</button></div>
      </div>

      <div class="sat-pane" data-step="5" style="display:none">
        <div class="sat-card">
          <h3>What to compute</h3>
          <div class="sat-help">Computed on the server from the Sentinel-2 images (10 m) of the dates chosen in step 3, for every location. It runs in the background: you can leave the page and come back.</div>
          <div class="sat-options sat-checks" id="sat_models">
            <label class="sat-option" data-v="crop_map"><input type="checkbox" /><span class="sat-option-title">Crop / land-cover map</span><span class="sat-option-text">Classifies every pixel (crop, forest, pasture&hellip;) from the examples you draw; hectares per class, with its accuracy.</span></label>
            <label class="sat-option" data-v="yield"><input type="checkbox" /><span class="sat-option-title">Yield of the crop</span><span class="sat-option-text">Per field, from the season curve: in kg/ha when you have fields with a known yield, otherwise a relative index that ranks the fields; totals per farm.</span></label>
            <label class="sat-option" data-v="indices"><input type="checkbox" /><span class="sat-option-title">Save indices as traits</span><span class="sat-option-text" id="sat_indices_text">NDVI, NDRE and EVI of every plot on every clear date, stored as phenotypes of the trial.</span></label>
          </div>
        </div>

        <div class="sat-card" id="sat_crop_card">
          <h3>Crop</h3>
          <div class="sat-inline-row">
            <div><label class="sat-label" for="sat_crop">Crop</label><select id="sat_crop" class="form-control input-sm" style="min-width:220px"></select></div>
            <div id="sat_crop_other_box" style="display:none"><label class="sat-label" for="sat_crop_other">Name</label><input type="text" id="sat_crop_other" class="form-control input-sm" maxlength="60" /></div>
            <div id="sat_season_box"><label class="sat-label">Season of the crop to estimate</label>
              <div class="sat-inline-row" style="margin:0;gap:6px"><input type="date" id="sat_season_start" class="form-control input-sm" aria-label="Season start" /><span>to</span><input type="date" id="sat_season_end" class="form-control input-sm" aria-label="Season end" /></div>
            </div>
          </div>
          <div class="sat-help" id="sat_season_help" style="margin-top:6px">From sowing / transplanting to harvest of the fields to estimate. The map uses all the dates of step 3 (a whole year separates crops best).</div>
        </div>

        <div class="sat-card">
          <div class="sat-site-tabs" style="display:none"></div>
          <div class="sat-card-head"><h3>Draw on the map <span class="sat-muted" style="font-weight:normal;font-size:14px" id="sat_model_site"></span></h3></div>
          <div id="sat_classes_box">
            <div class="sat-options" id="sat_map_method" style="display:none">
              <label class="sat-option" data-v="standard"><input type="radio" name="sat_map_method" /><span class="sat-option-title">Maize standard: no drawing</span><span class="sat-option-text">Every pixel's season is compared with a stored maize curve (measured on a Breedbase maize trial). Finds maize and its sowing date. Proof of concept.</span></label>
              <label class="sat-option" data-v="examples"><input type="radio" name="sat_map_method" /><span class="sat-option-title">Draw examples (any crop)</span><span class="sat-option-text">You draw areas of each land cover; a random forest learns them. Works for any crop and any class.</span></label>
            </div>
            <div id="sat_standard_box" style="display:none"></div>
            <div id="sat_examples_box">
            <h4 style="margin-top:4px">Crop map: examples of each class</h4>
            <div class="sat-help">Draw a few areas of <b>every kind of land cover in the area</b> (fields of the crop, other crops, forest, pasture, bare soil, water, towns&hellip;), at least 2 areas per class, in more than one place if you can. A land cover without examples is forced into the nearest class; pixels unlike all examples are shown as <i>Uncertain</i>.</div>
            <div id="sat_step2_labels" style="margin:6px 0"></div>
            <div id="sat_classes"></div>
            <div class="sat-inline-row" style="margin-top:4px"><span class="sat-small sat-muted">Add a class:</span><span class="sat-segs" id="sat_class_presets"></span></div>
            </div>
          </div>
          <div id="sat_yield_box">
            <h4>Yield: do you know the yield of some fields?</h4>
            <div class="sat-options" id="sat_yield_mode">
              <label class="sat-option" data-v="calibrated"><input type="radio" name="sat_yield_mode" /><span class="sat-option-title">Yes: estimate in kg/ha</span><span class="sat-option-text">Calibrated on fields with a known harvested yield (Breedbase trials, or fields you draw and type the yield of). Needs at least <span class="sat-min-fields">8</span> of them.</span></label>
              <label class="sat-option" data-v="index"><input type="radio" name="sat_yield_mode" /><span class="sat-option-title">No: relative yield index</span><span class="sat-option-text">No calibration. Each field gets an index from its season curve, 100 = the average field: compares and ranks the fields, but gives no kg/ha.</span></label>
            </div>
            <div id="sat_ref_box" class="sat-subopts" style="display:none">
              <label class="sat-switch sat-small"><input type="checkbox" id="sat_ref_on" /><span class="sat-slider"></span>Turn the index into approximate kg/ha with the regional average yield (public statistics)</label>
              <div id="sat_ref_list" class="sat-small" style="margin-top:6px"></div>
            </div>
            <div id="sat_calib_box">
            <h4 id="sat_calib_anchor">Fields with a known yield (calibration)</h4>
            <div class="sat-help">Two ways, together or not: tick Breedbase trials of the crop below, and/or draw fields whose harvested yield you know and type it with its season.</div>
            <div class="sat-inline-row" style="margin-top:0">
              <div><label class="sat-label" for="sat_yield_trait">Yield trait (of the trials)</label><select id="sat_yield_trait" class="form-control input-sm" style="min-width:260px"></select></div>
              <div><label class="sat-label" for="sat_yield_unit">Unit</label><input type="text" id="sat_yield_unit" class="form-control input-sm" maxlength="40" placeholder="kg/ha" style="width:110px" /></div>
              <label class="sat-switch sat-small" style="margin-bottom:6px"><input type="checkbox" id="sat_yield_perha" /><span class="sat-slider"></span>per hectare (totals = yield &times; area)</label>
            </div>
            <div id="sat_calib_trials"></div>
            <div id="sat_calib_fields"></div>
            </div>
            <h4>Yield: fields to estimate</h4>
            <div id="sat_targets"></div>
          </div>
          <div class="sat-draw" id="sat_model_draw" style="display:none"></div>
          <div id="sat_model_map"></div>
          <div class="sat-help" id="sat_model_hint" style="margin-top:6px"></div>
        </div>

        <div class="sat-card">
          <div class="sat-card-head"><h3>Ready?</h3><button type="button" class="btn btn-default btn-sm" id="sat_adv_open">Advanced settings&hellip;</button></div>
          <ul class="sat-check-list" id="sat_ready"></ul>
          <div class="sat-small sat-muted" id="sat_adv_summary" style="margin-top:6px"></div>
        </div>
        <div class="sat-nav"><button class="btn btn-default sat-next" data-to="4">&larr; Images</button><button class="btn btn-primary" id="sat_run">Run the models &rarr;</button></div>
      </div>

      <div class="sat-pane" data-step="6" style="display:none">
        <div class="sat-card" id="sat_run_card">
          <div class="sat-card-head"><h3 id="sat_run_title">Results</h3><span class="sat-small sat-muted" id="sat_run_meta"></span></div>
          <div class="sat-progress" id="sat_run_progress" style="display:none"><span class="sat-spin" aria-hidden="true"></span><span id="sat_run_text" role="status"></span><div class="sat-bar indet"><div></div></div><span id="sat_run_elapsed"></span></div>
          <div id="sat_run_error"></div>
          <div id="sat_run_notes"></div>
        </div>
        <div id="sat_results" style="display:none">
          <div class="sat-res-tabs"></div>
          <div class="sat-stats" id="sat_res_stats"></div>
          <div class="sat-card" id="sat_res_map_card">
            <div class="sat-card-head"><h3>Crop / land-cover map <span class="sat-muted" style="font-weight:normal;font-size:14px" id="sat_res_site"></span></h3><a class="btn btn-default btn-xs" id="sat_res_tif">GeoTIFF</a></div>
            <div class="row">
              <div class="col-sm-7"><div class="sat-result-map"><canvas id="sat_res_canvas"></canvas></div><div class="sat-legend-row" id="sat_res_legend"></div></div>
              <div class="col-sm-5"><div id="sat_res_areas"></div><div id="sat_res_accuracy" style="margin-top:12px"></div></div>
            </div>
          </div>
          <div class="sat-card" id="sat_res_yield_card">
            <div class="sat-card-head"><h3>Yield</h3><a class="btn btn-default btn-xs" id="sat_res_csv">Fields (CSV)</a></div>
            <div id="sat_res_yield"></div>
          </div>
          <div class="sat-card" id="sat_res_indices_card">
            <div class="sat-card-head"><h3>Vegetation indices of the plots</h3><a class="btn btn-default btn-xs" id="sat_res_ind_csv">Indices (CSV)</a></div>
            <div id="sat_res_indices"></div>
          </div>
        </div>
        <div class="sat-nav"><button class="btn btn-default sat-next" data-to="5">&larr; Change the model</button><span></span></div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="sat-summary">
        <h4>Your choice</h4>
        <ul class="sat-flow" id="sat_flow"></ul>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="sat_adv_modal" tabindex="-1" role="dialog" aria-labelledby="sat_adv_title">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="sat_adv_title">Advanced settings</h4>
      </div>
      <div class="modal-body" id="sat_adv_body"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-link" id="sat_adv_reset">Back to defaults</button>
        <button type="button" class="btn btn-primary" data-dismiss="modal">Done</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="sat_big_modal" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="sat_big_title"></h4>
      </div>
      <div class="modal-body" id="sat_big">
        <canvas></canvas>
        <div class="sat-big-nav">
          <button class="btn btn-default btn-sm" id="sat_prev">&larr; Earlier</button>
          <span class="sat-small sat-muted" id="sat_big_info"></span>
          <span><button class="btn btn-default btn-sm" id="sat_big_hide"></button> <button class="btn btn-default btn-sm" id="sat_next">Later &rarr;</button></span>
        </div>
      </div>
    </div>
  </div>
</div>

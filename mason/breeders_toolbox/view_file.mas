
<%args>
$file_content => undef
$filename => undef
</%args>

<%perl>

sub n2a {
  my ($n) = @_;
  my @a;
  while ($n > 0) {
    unshift @a, ($n-1) % 26;
    $n = int(($n-1)/26); #Edited for failing corner case
  }
  join '', map chr(ord('A') + $_), @a;
}

</%perl>

<div class="sgn-file-viewer"><center>
<br/>
<h1><% $c->i18n->p('file_viewer.ui.title', 'File Viewer') |h %></h1>
<br/>
</center>

<div class="panel panel-info">
	<div class="panel-heading">
		<h3><% $c->i18n->p('file_viewer.ui.info', 'File Info') |h %></h3>
	</div>
	<div class="panel-body">
		<div class="table-responsive" tabindex="0" role="region" aria-label="<% $c->i18n->p('file_viewer.ui.info', 'File Info') |h %>"><table class="table">
		<thead>
		<tr>
		<th><% $c->i18n->p('file_viewer.ui.filename', 'Filename') |h %></th>
		<th><% $c->i18n->p('file_viewer.ui.type', 'File Type') |h %></th>
		<th><% $c->i18n->p('file_viewer.ui.sheets', 'Number of Sheets') |h %></th>
		<th><% $c->i18n->p('file_viewer.ui.parser', 'Parser') |h %></th>
		</tr>
		</thead>
		<tbody>
		<tr>
		<td><bdi dir="auto"><% $filename |h %></bdi></td>
		<td><bdi dir="auto"><% @$file_content[0]->[0]->{type} |h %></bdi></td>
		<td><bdi dir="ltr"><% @$file_content[0]->[0]->{sheets} |h %></bdi></td>
		<td><bdi dir="ltr"><% @$file_content[0]->[0]->{parser} |h %> (<% @$file_content[0]->[0]->{version} |h %>)</bdi></td>
		</tr>
		</tbody>
		</table></div>
	</div>
</div>

% my $num_sheets = @$file_content[0]->[0]->{sheets};

<div class="panel panel-info">
	<div class="panel-heading">
		<h3><% $c->i18n->p('file_viewer.ui.contents', 'File Contents') |h %></h3>
	</div>
	<div class="panel-body">

	<ul class="nav nav-tabs" role="tablist">

% for ( my $s=1; $s<=$num_sheets; $s++) {
	
% my $sheet_label = @$file_content[0]->[$s]->{label};
% $sheet_label =~ s/\s+//g;

% if ($s ==1 ){
		<li role="presentation" class="active"><a href="#<% $sheet_label |h %>" aria-controls="<% $sheet_label |h %>" role="tab" data-toggle="tab"><bdi dir="auto"><% $sheet_label |h %></bdi></a></li>
% } else {
		<li role="presentation"><a href="#<% $sheet_label |h %>" aria-controls="<% $sheet_label |h %>" role="tab" data-toggle="tab"><bdi dir="auto"><% $sheet_label |h %></bdi></a></li>
% }

% }

	</ul>

	<div class="tab-content">

% for (my $i=1; $i<=$num_sheets; $i++) {

% my $max_row = @$file_content[0]->[$i]->{maxrow};
% my $max_col = @$file_content[0]->[$i]->{maxcol};

% my $sheet_label = @$file_content[0]->[$i]->{label};
% $sheet_label =~ s/\s+//g;

% if ($i == 1) {
		<div role="tabpanel" class="tab-pane fade in active" id="<% $sheet_label |h %>">
% } else {
		<div role="tabpanel" class="tab-pane fade" id="<% $sheet_label |h %>">
% }

			<div class="table-responsive" dir="ltr" tabindex="0" role="region" aria-label="<% $c->i18n->p('file_viewer.ui.sheet_region', 'Worksheet data') |h %>"><table class="table table-hover table-bordered" dir="ltr">
				<thead>
				<tr>

% my $max_aa = n2a(@$file_content[0]->[$i]->{maxcol});
% foreach ('A'..$max_aa) {
				<th><bdi dir="auto"><% @$file_content[0]->[$i]->{$_.'1'} |h %></bdi></th>
% }
				</tr>
				</thead>
				<tbody>

% for (my $j=2; $j<=$max_row; $j++) {

				<tr>

% foreach ('A'..$max_aa) {
	
				<td><bdi dir="auto"><% @$file_content[0]->[$i]->{$_.$j} |h %></bdi></td>

% }
				</tr>

% }

				</tbody>
			</table></div>
		</div>
% }

	</div>

</div>
</div>





</div>
<style>
.sgn-file-viewer h1,
.sgn-file-viewer .panel-heading h3,
.sgn-file-viewer .nav-tabs > li > a { overflow-wrap: anywhere; }
.sgn-file-viewer .nav-tabs > li { max-width: 100%; }
.sgn-file-viewer > .panel > .panel-body > .table-responsive > table > thead th { text-align: start; }
</style>

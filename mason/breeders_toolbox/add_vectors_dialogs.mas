<%once>
use HTML::Entities ();
</%once>

<%args>
$preferred_species => ""
$editable_vector_props => {}
$editable_stock_props_definitions
</%args>

<%perl>
    my $user_role = '';
    if ($c->user) {
        $user_role = $c->user->get_object()->get_user_type();
    }
</%perl>

<div class="modal fade" id="add_vectors_dialog" name="add_vectors_dialog" tabindex="-1" role="dialog" aria-labelledby="addVectorsDialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addVectorsDialog"><% $c->i18n->p("transformation.root.add_vectors", "Add Vectors") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

            <div class="tab-content">

                <div id="with_file_tab" class="tab-pane fade in active">
                    <hr>
                    <&| /page/explanation.mas, title=>$c->i18n->p("accession.files.template_info", 'Template information') &>
                        <p>
                            <b><% $c->i18n->p("accessions.dialog.file_format", "File format information") |h %></b>
                            <br>
                            <a id="vectors_upload_spreadsheet_format_info"><% $c->i18n->p("accessions.dialog.spreadsheet_format", "Spreadsheet format") |h %></a>
                        </p>
                    </&>

                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_new_vectors_form" name="upload_new_vectors_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("cross.ui.upload_file.9798051", "Upload File:") |h %> </label>
                            <div class="col-sm-8" >
                                <input type="file" name="new_vectors_upload_file" id="new_vectors_upload_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("transformation.root.use_fuzzy_search", "Use Fuzzy Search:") |h %> </label>
                            <div class="col-sm-8">
% if ( $user_role eq 'curator' ) {
                                <input type="checkbox" id="fuzzy_check_upload_vectors" name="fuzzy_check_upload_vectors" checked></input>
% } else {
                                <input type="checkbox" id="fuzzy_check_upload_vectors" name="fuzzy_check_upload_vectors" checked disabled></input>
% }
                                <br/>
                                <small><% $c->i18n->p("transformation.root.note_use_the_fuzzy_search_to_match_similar_names_to", "Note: Use the fuzzy search to match similar names to prevent uploading of duplicate vectors. Fuzzy searching is much slower than regular search. Only a curator can disable the fuzzy search.") |h %></small>
                            </div>
                        </div>
                        <!--
                        <div class="form-group">
                            <label class="col-sm-4 control-label"> Auto generate uniquename</label><br>
                            <div class="col-sm-8">
                                <input type="checkbox" id="autogenerate_uniquename" name="autogenerate_uniquename">
                            </div>
                        </div>
                        -->
                    </form>
                    <br>
                    <& /help/file_upload_type.mas, type => $c->i18n->p("transformation.root.vectors", "Vectors"), optional_column => 1 &>
                </div>
            </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
        <button type="button" class="btn btn-primary" name="new_vectors_submit" id="new_vectors_submit"><% $c->i18n->p("accessions.common.continue", "Continue") |h %></button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="vectors_upload_spreadsheet_format_modal" name="vectors_upload_spreadsheet_format_modal" tabindex="-1" role="dialog" aria-labelledby="uploadVectorsInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadVectorsInfoDialog"><% $c->i18n->p("transformation.root.upload_vectors_template_information", "Upload Vectors Template Information") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <br /><br />
                    <b><% $c->i18n->p("accessions.template.header", "Header:") |h %></b>
                    <br>
                    <% $c->i18n->p("transformation.root.the_first_row_header_must_contain_the_uniquename_column_additional", "The first row (header) must contain the uniquename column. Additional information can be included by selecting optional column(s) (see below). :") |h %>
                    <br />

                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>uniquename </td>
%  foreach my $editable_stockprop (@$editable_vector_props) {
%                               print "<td>$editable_stockprop</td>";
% }
                            </tr>
                        </tbody>
                    </table>

                    <b><% $c->i18n->p("accessions.template.required", "Required Fields:") |h %></b>
                    <ul>
                    <li><% $c->i18n->p("transformation.root.uniquename_vector_name_must_be_unique", "uniquename (vector name must be unique)") |h %></li>
                    </ul>
                    <b><% $c->i18n->p("accessions.template.optional", "Optional Fields:") |h %></b>
                    <ul>
%  foreach my $editable_stockprop (@$editable_vector_props) {
%    if (exists($editable_stock_props_definitions->{$editable_stockprop})) {
%                   print "<li>$editable_stockprop (".$editable_stock_props_definitions->{$editable_stockprop}.")</li>";
%    } else {
%                   print ("<li>$editable_stockprop (" . HTML::Entities::encode_entities($c->i18n->p("transformation.root.no_definition_available", "no definition available")) . ")</li>");
%    }
%  }
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_trial_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="review_absent_dialog" name="review_absent_dialog" tabindex="-1" role="dialog" aria-labelledby="reviewAbsentDialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content ui-front">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="reviewAbsentDialog"><% $c->i18n->p("transformation.root.vectors_to_be_added", "Vectors to be Added") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
            <div id="add_vectors_using_list_inputs" style="display:none">
                <br><br>
                <label for="population_name_input"><% $c->i18n->p("transformation.root.population_name_for_added_vectors_optional", "Population name for added vectors (optional)") |h %></label>
                <input class="form-control" type="text" id="population_name_input"></input>
                <br><br>
                <label for="organization_name_input"><% $c->i18n->p("transformation.root.organization_name_for_added_vectors_optional", "Organization name for added vectors (optional)") |h %></label>
                <input class="form-control" type="text" id="organization_name_input"></input>
                <br><br>
                <b><% $c->i18n->p("transformation.root.the_following_vectors_are_new_and_will_be_added_to", "The following vectors are new and will be added to the database:") |h %></b>
                <div id="count_of_absent_vectors"></div>
                <br>
                <div id="view_absent"></div>
            </div>
            <div id="view_infoToAdd"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
	<button type="button" class="btn btn-primary" name="review_absent_vectors_submit" id="review_absent_vectors_submit"><% $c->i18n->p("transformation.root.add_vectors", "Add Vectors") |h %></button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="review_fuzzy_matches_dialog" name="review_fuzzy_matches_dialog" tabindex="-1" role="dialog" aria-labelledby="reviewFuzzyDialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="reviewFuzzyDialog"><% $c->i18n->p("accessions.review.fuzzy_title", "Fuzzy Matches") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
          <b><% $c->i18n->p("transformation.root.vectors_were_found_with_similar_names", "Vectors were found with similar names.") |h %></b>
  	  <br/><br/>
  	  <div id="view_fuzzy_matches"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" name="review_fuzzy_matches_download" id="review_fuzzy_matches_download"><% $c->i18n->p("accessions.review.fuzzy_download", "Download Fuzzy Matches") |h %></button>
        <button type="button" class="btn btn-primary" name="review_fuzzy_matches_continue" id="review_fuzzy_matches_continue" data-dismiss="modal"><% $c->i18n->p("accessions.review.fuzzy_continue", "Make Changes and Continue") |h %></button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="review_found_matches_dialog" name="review_found_matches_dialog" tabindex="-1" role="dialog" aria-labelledby="reviewFoundDialog" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="reviewFoundDialog"><% $c->i18n->p("transformation.root.found_vectors", "Found Vectors") |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
          <b><% $c->i18n->p("transformation.root.the_following_vectors_already_exist_in_the_database", "The following vectors already exist in the database:") |h %></b>
  	  <div id="count_of_found_vectors"></div>
  	  <br/>
  	  <div id="view_found_matches"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" name="review_found_matches_hide" id="review_found_matches_hide" data-dismiss="modal"><% $c->i18n->p("accessions.common.continue", "Continue") |h %></button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="add_vectors_saved_message_modal" name="add_vectors_saved_message_modal" tabindex="-1" role="dialog" aria-labelledby="addVectorsSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addVectorsSavedDialog"><% $c->i18n->p("transformation.root.vectors_saved", "Vectors Saved") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="add_vectors_saved_message"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_add_vectors_saved_message_modal" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<form id="add_vector_fuzzy_match_download" method="post" action="/ajax/accession_list/fuzzy_download" target="TheWindow">
    <input type="hidden" name="fuzzy_response" value="" />
</form>

<style>
.ui-autocomplete {
  max-height: 100px;
  overflow-y: auto;
  /* prevent horizontal scrollbar */
  overflow-x: hidden;
}

/* IE 6 doesn't support max-height
* we use height instead, but this forces the menu to always be this tall
*/
* html .ui-autocomplete {
  height: 100px;
}
</style>

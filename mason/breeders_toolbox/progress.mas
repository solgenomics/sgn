<%once>
use HTML::Entities ();
</%once>


<%args>

</%args>

<script src="https://cdn.jsdelivr.net/npm/vega@5"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-lite@5"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-embed@6"></script>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("analysis.interface.breeding_progress", "Breeding Progress")) &>

<& /util/import_javascript.mas, classes => [ 'CXGN.BreedersToolbox.HTMLSelect' ] &>
  
  <table class="table">
    <tr>
      <th width="100"><% $c->i18n->p("lists_datasets.pages.select_trait", "Select Trait") |h %></th>

    </tr>

    <tr>
      <td>
	<div id="trait_selector_div"><% $c->i18n->p("global.loading", "[loading...]") |h %></div>
      </td>


    </tr>
  </table>

  <button class="btn" id="display_stats_button"><% $c->i18n->p("analysis.interface.show_stats", "Show Stats") |h %></button>
  
  <table id="progress_stats_datatable">
  </table>
  <br />
  <button class="btn" id="display_graph_button"><% $c->i18n->p("analysis.interface.show_graph", "Show Graph") |h %></button>
  <div id="trait_averages_bargraph"></div>
  <script>
jQuery(window).ready(function () {
    get_select_box('traits', 'trait_selector_div', { 'name': 'trait_progress', 'id': 'trait_progress_select', 'empty': 1 });

});


jQuery('#display_stats_button').click(function () {
    var trait_id = jQuery('#trait_progress_select').val();
    jQuery('#progress_stats_datatable').DataTable({
        ajax: '/ajax/progress?trait_id=' + trait_id,
        destroy: true,
        columns: [
            { "title": jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.index_logged_in_user.year", "year") : "year")).html() },
            { "title": jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.average", "average") : "average")).html() },
            { "title": jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.std_dev", "std dev") : "std dev")).html() },
            { "title": jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.observations_count", "observations [count]") : "observations [count]")).html() }
        ]
    });
});

jQuery('#display_graph_button').click(function () {
    //alert('success!');
    var trait_id = jQuery('#trait_progress_select').val();
    jQuery.ajax({
        url: '/ajax/progress?trait_id=' + trait_id,
        success: function (r) {
            var years = [];
            var averages = [];
            var errorUp = [];
            var errorDown = [];
            for (var i = 0; i < r.data.length; i++) {
                years.push(r.data[i][0]);
                averages.push(r.data[i][1]);
                errorUp.push(r.data[i][1] / 1.0 + r.data[i][2] / 1.0); // im aware
                errorDown.push(r.data[i][1] / 1.0 - r.data[i][2] / 1.0);
            }
            var graphData = [];
            for (var i = 0; i < r.data.length; i++) {
                graphData.push({ "Year": years[i], "Average": averages[i], "mean + stddev": errorUp[i], "mean - stddev": errorDown[i] })
            }
            var v = {
                "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
                "width": 600,
                "height": 600,
                "padding": 5,
                "data": {
                    "values": graphData
                },
                "encoding": {
                    "x": {
                        //"bin": true,
                        "field": "Year",
                        "title": (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.trial_table.year", "Year") : "Year"),
                        "type": "ordinal",
                        "axis": { "labelAngle": 0 },
                    },
                },
                "layer": [
                    {
                        "mark": {
                            "type": "bar",
                            "fill": "#4C78A8",
                            "stroke": "black",
                        },
                        "encoding": {
                            "y": {
                                "field": "Average",
                        "title": (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.population_cgi.average", "Average") : "Average"),
                                "type": "quantitative",
                            },
                        },
                    },
                    {
                        "mark": { "type": "errorband" },
                        "encoding": {
                            "y": {
                                "field": "mean + stddev",
                                "type": "quantitative",
                                "scale": { "zero": false },
                                "title": jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.population_cgi.average", "Average") : "Average")).html()
                            },
                            "y2": { "field": "mean - stddev" },
                            "color": {"value": "navy"}
                        },
                    },

                ]
            }
            vegaEmbed("#trait_averages_bargraph", v);
        },

        error: function (e) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.cannot_show_graph", "cannot show graph") : 'cannot show graph'));

        }
    });
});
  </script>

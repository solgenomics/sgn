<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui', 'jquery.iframe-post-form', 'CXGN.BreedersToolbox.UploadPhenotype', 'CXGN.BreederSearch' ] &>

<style type="text/css">
#upload_phenotype_datacollector_verify_status .list-group-item {
    padding-inline-start: 15px;
    padding-inline-end: 3.5em;
    text-align: start;
    overflow-wrap: anywhere;
}
#upload_phenotype_datacollector_verify_status .list-group-item > .badge {
    float: none;
    position: absolute;
    inset-inline-end: 15px;
    inset-block-start: 10px;
}
@media (max-width: 767px) {
    #upload_datacollector_phenotypes_dialog .sgn-datacollector-file-row {
        display: block;
    }
    #upload_datacollector_phenotypes_dialog .sgn-datacollector-file-row > .col-sm-6 {
        float: none;
        inline-size: 100%;
        min-inline-size: 0;
    }
    #upload_datacollector_phenotypes_dialog .sgn-datacollector-file-row > label {
        margin-inline: 0;
        display: block;
        white-space: normal;
        overflow-wrap: anywhere;
        text-align: start;
    }
    #upload_datacollector_phenotypes_dialog .sgn-datacollector-file-row input[type="file"] {
        inline-size: 100%;
        min-inline-size: 0;
        max-inline-size: 100%;
    }
}
/* DataCollector dialogs only: keep long labels and example data reachable. */
.sgn-datacollector-modal .modal-header {
    position: relative;
    padding-inline-end: 3.5em;
}
.sgn-datacollector-modal .modal-header > .close {
    float: none;
    position: absolute;
    inset-inline-end: 15px;
    inset-block-start: 15px;
    margin: 0;
}
.sgn-datacollector-modal .modal-title,
.sgn-datacollector-modal .modal-body {
    overflow-wrap: anywhere;
}
.sgn-datacollector-modal .sgn-datacollector-form-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
}
.sgn-datacollector-modal .sgn-datacollector-form-row > .col-sm-6 {
    float: none;
    min-inline-size: 0;
}
.sgn-datacollector-modal .sgn-datacollector-form-row > label {
    margin-inline: 0;
    white-space: normal;
    overflow-wrap: anywhere;
    text-align: start;
}
.sgn-datacollector-modal .modal-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
}
.sgn-datacollector-modal .modal-footer::before,
.sgn-datacollector-modal .modal-footer::after {
    display: none;
}
.sgn-datacollector-modal .modal-footer > .btn {
    margin: 0;
    min-inline-size: 0;
    max-inline-size: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
}
.sgn-datacollector-modal .sgn-datacollector-help-trigger {
    padding: 0;
    max-inline-size: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
    text-align: start;
    vertical-align: baseline;
}
.sgn-datacollector-modal .sgn-datacollector-scientific-region {
    direction: ltr;
    min-inline-size: 0;
    max-inline-size: 100%;
    overflow-x: auto;
}
.sgn-datacollector-modal .sgn-datacollector-scientific-region > table {
    direction: ltr;
    white-space: nowrap;
    overflow-wrap: normal;
}
.sgn-datacollector-modal .sgn-datacollector-scientific-region:focus {
    outline: 2px solid #66afe9;
    outline-offset: 2px;
}
@media (max-width: 767px) {
    .sgn-datacollector-modal .sgn-datacollector-form-row {
        display: block;
    }
    .sgn-datacollector-modal .sgn-datacollector-form-row > .col-sm-6 {
        inline-size: 100%;
    }
    .sgn-datacollector-modal .sgn-datacollector-form-row > label {
        display: block;
    }
}
</style>

<div class="modal fade sgn-datacollector-modal" id="upload_datacollector_phenotypes_dialog" name="upload_datacollector_phenotypes_dialog" tabindex="-1" role="dialog" aria-labelledby="addDatacollectorPhenotypeDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('datacollector.ui.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="addDatacollectorPhenotypeDialog"><% $c->i18n->p('datacollector.ui.title', 'Upload Data Collector File') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
        
            <&| /page/explanation.mas, title=>$c->i18n->p('datacollector.ui.template_info', 'Template Information') &>
                <p>
                <b><% $c->i18n->p('datacollector.ui.format_info', 'File format information') |h %></b>
                <br>
                <button type="button" class="btn btn-link sgn-datacollector-help-trigger" id="phenotype_upload_datacollector_format_info" aria-controls="phenotype_upload_datacollector_info_dialog"><% $c->i18n->p('datacollector.ui.format', 'Datacollector Format') |h %></button>
                </p>
            </&>
        
            <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_datacollector_phenotype_file_form" name="upload_datacollector_phenotype_file_form">
                <div class="form-group sgn-datacollector-form-row">
                    <label class="col-sm-6 control-label"><% $c->i18n->p('datacollector.ui.timestamp_included', 'Timestamps Included: ') |h %></label>
                    <div class="col-sm-6" >
                        <input type="checkbox" id="upload_datacollector_phenotype_timestamp_checkbox" name="upload_datacollector_phenotype_timestamp_checkbox" />
                    </div>
                </div>
                <div class="form-group sgn-datacollector-form-row">
                    <label class="col-sm-6 control-label"><% $c->i18n->p('datacollector.ui.data_level', 'Data Level: ') |h %></label>
                    <div class="col-sm-6" >
                        <select class="form-control" id="upload_phenotype_datacollector_data_level">
                            <option value="plots"><% $c->i18n->p('datacollector.ui.plots', 'Plots') |h %></option>
                        </select>
                    </div>
                </div>
                <div class="form-group sgn-datacollector-file-row sgn-datacollector-form-row">
                    <label class="col-sm-6 control-label"><% $c->i18n->p('datacollector.ui.file', 'Data Collector File: ') |h %></label>
                    <div class="col-sm-6" >
                        <input type="file" id="upload_datacollector_phenotype_file_input" name="upload_datacollector_phenotype_file_input" encoding="multipart/form-data" />
                    </div>
                </div>

                <div id="upload_phenotype_datacollector_verify_status"></div>
            </form><br/>

        </div>
      </div>
      
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('datacollector.ui.close', 'Close') |h %></button>
        <button type="button" class="btn btn-info" name="upload_datacollector_phenotype_submit_verify" id="upload_datacollector_phenotype_submit_verify"><% $c->i18n->p('datacollector.ui.verify', 'Verify') |h %></button>
        <button disabled type="button" class="btn btn-primary" name="upload_datacollector_phenotype_submit_store" id="upload_datacollector_phenotype_submit_store" title="<% $c->i18n->p('datacollector.ui.verify_first', 'First Verify Your File') |h %>"><% $c->i18n->p('datacollector.ui.store', 'Store') |h %></button>
      </div>
      
    </div>
  </div>
</div>


<div class="modal fade sgn-datacollector-modal" id="phenotype_upload_datacollector_info_dialog" name="phenotype_upload_datacollector_info_dialog" tabindex="-1" role="dialog" aria-labelledby="datacollectorUploadInfoDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('datacollector.ui.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="datacollectorUploadInfoDialog"><% $c->i18n->p('datacollector.ui.template_info', 'Template Information') |h %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">
        
            <h4><% $c->i18n->p('datacollector.ui.excel_required', 'Must be in %{xls} or %{xlsx} excel file format', {xls => '.xls', xlsx => '.xlsx'}) |h %></h4>
            <p><% $c->i18n->p('datacollector.ui.no_text', '(tab-delimited text formats are NOT supported)') |h %></p>
            <hr>
            <h4 id="datacollector_sheet_header_description"><% $c->i18n->p('datacollector.ui.sheet_header', '%{sheet} Sheet Header: (%{number}th Sheet in Workbook)', {sheet => '"Field Book"', number => 8}) |h %></h4>
            <p><% $c->i18n->p('datacollector.ui.header_intro', 'The first row (header) should contain the following:') |h %></p>

            <div class="table-responsive sgn-datacollector-scientific-region" role="region" tabindex="0" dir="ltr" aria-labelledby="datacollector_sheet_header_description">
            <table class="table table-hover table-bordered" dir="ltr">
                <body>
                    <tr>
                        <td>plot_name</td>
                        <td>accession_name</td>
                        <td>plot_number</td>
                        <td>block_number</td>
                        <td>is_a_control</td>
                        <td>rep_number</td>
                        <td>trait name|trait id</td>
                    </tr>
                </body>
            </table>
            </div>

            <h4><% $c->i18n->p('datacollector.ui.required', 'Required fields:') |h %></h4>
            <ul>
                <li><% $c->i18n->p('datacollector.ui.plot_required', '%{column} (must exist in the database)', {column => 'plot_name'}) |h %></li>
                <li><% $c->i18n->p('datacollector.ui.trait_required', '%{column} (must exist in the trait ontology)', {column => 'trait name|trait id'}) |h %></li>
            </ul>

            <h4><% $c->i18n->p('datacollector.ui.notes', 'Notes') |h %></h4>
            <ul>
                <li><% $c->i18n->p('datacollector.ui.trait_example', 'For %{trait} in cassava, %{column} should be written as %{example}.', {trait => '"sprouting proportion"', column => '"trait name|trait id"', example => '"sprouting proportion|CO_334:0000008"'}) |h %></li>
                <li><% $c->i18n->p('datacollector.ui.ontology_note', 'If trait file was not generated from the database, consult the Trait Ontology to ensure you have the correct trait id.') |h %></li>
                <li><% $c->i18n->p('datacollector.ui.multiple_traits', 'Two or more traits can be uploaded at the same time.') |h %></li>
            </ul>

            <h4><% $c->i18n->p('datacollector.ui.timestamps', 'Timestamps:') |h %></h4>
            <ul>
                <li><% $c->i18n->p('datacollector.ui.timestamp_help', 'To include timestamp information for your measurements, click the checkbox "Includes Timestamps".') |h %></li>
                <li><% $c->i18n->p('datacollector.ui.timestamp_values', 'For timestamps, values should be recorded as %{with_timestamp}. For no timestamps, values should be recorded as %{without_timestamp}.', {with_timestamp => '"Value,Timestamp"', without_timestamp => '"Value"'}) |h %></li>
                <li><% $c->i18n->p('datacollector.ui.timestamp_format', 'Timestamp format must be %{negative} or %{positive}', {negative => 'YYYY-MM-DD HH:MM:SS-0000', positive => 'YYYY-MM-DD HH:MM:SS+0000'}) |h %></li><br/>
                <li><span id="datacollector_timestamp_example_description"><% $c->i18n->p('datacollector.ui.timestamp_example', 'Example with timestamps: ') |h %></span><br/><br/>
                <div class="table-responsive sgn-datacollector-scientific-region" role="region" tabindex="0" dir="ltr" aria-labelledby="datacollector_timestamp_example_description">
                <table class="table table-hover table-bordered" dir="ltr">
                    <thead>
                        <tr>
                            <th>plot_name</th>
                            <th>accession_name</th>
                            <th>plot_number</th>
                            <th>block_number</th>
                            <th>is_a_control</th>
                            <th>rep_number</th>
                            <th>sprouting proportion|CO_334:0000008</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Plot1</td>
                            <td>Germplasm1</td>
                            <td>2</td>
                            <td>1</td>
                            <td>0</td>
                            <td>1</td>
                            <td>20,2016-04-28 16:30:40-0500</td>
                        </tr>
                    </tbody>
                </table>
                </div>
                </li>
                <li><span id="datacollector_plain_example_description"><% $c->i18n->p('datacollector.ui.plain_example', 'Example without timestamps: ') |h %></span><br/><br/>
                <div class="table-responsive sgn-datacollector-scientific-region" role="region" tabindex="0" dir="ltr" aria-labelledby="datacollector_plain_example_description">
                <table class="table table-hover table-bordered" dir="ltr">
                    <thead>
                        <tr>
                            <th>plot_name</th>
                            <th>accession_name</th>
                            <th>plot_number</th>
                            <th>block_number</th>
                            <th>is_a_control</th>
                            <th>rep_number</th>
                            <th>sprouting proportion|CO_334:0000008</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Plot1</td>
                            <td>Germplasm1</td>
                            <td>2</td>
                            <td>1</td>
                            <td>0</td>
                            <td>1</td>
                            <td>20</td>
                        </tr>
                    </tbody>
                </table>
                </div>
                </li>
            </ul>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p('datacollector.ui.close', 'Close') |h %></button>
      </div>
    </div>
  </div>
</div>


<script defer="defer">

jQuery(document).ready(function() {

    jQuery('#upload_datacollector_phenotypes_link').click( function() {
        jQuery('#upload_datacollector_phenotypes_dialog').modal("show");
    });

    jQuery("#phenotype_upload_datacollector_format_info").click( function () { 
        jQuery("#phenotype_upload_datacollector_info_dialog" ).modal("show");
    });

    // Restore the still-open upload dialog after its nested help is closed.
    jQuery("#phenotype_upload_datacollector_info_dialog")
        .off("hidden.bs.modal.sgnDataCollector")
        .on("hidden.bs.modal.sgnDataCollector", function () {
            var parentModal = jQuery("#upload_datacollector_phenotypes_dialog");
            if (!parentModal.hasClass("in") || jQuery(".modal.in").not(parentModal).length) {
                return;
            }
            jQuery(document.body).addClass("modal-open");
            var controller = parentModal.data("bs.modal");
            if (controller && typeof controller.enforceFocus === "function") {
                controller.enforceFocus();
            }
            jQuery("#phenotype_upload_datacollector_format_info").trigger("focus");
        });

});

</script>

<%args>
</%args>

<& /util/import_javascript.mas, classes => ['CXGN.BreedersToolbox.Accessions'] &>


<div class="modal fade" id="manage_populations_add_population_dialog" name="manage_populations_add_population_dialog" tabindex="-1" role="dialog" aria-labelledby="addPopulationDialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" name="create_population_dismiss_button" id="create_population_dismiss_button_1" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addPopulationDialog"><% $c->i18n->p("accession.forms.create_a_population", "Create A Population") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" name="create_population_form" id="create_population_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("accession.forms.population_name", "Population Name:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" id="create_population_name" name="create_population_name" type="text" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("accession.forms.member_type", "Member Type:") |h %> </label>
                            <div class="col-sm-8">
                                <select class="form-control" id="member_type">
                                    <option value=""><% $c->i18n->p("accession.forms.select_a_member_type", "Select a member type") |h %></option>
                                    <option value="accessions"><% $c->i18n->p("accession.forms.accessions", "accessions") |h %></option>
                                    <option value="plots"><% $c->i18n->p("accession.forms.plots", "plots") |h %></option>
                                    <option value="plants"><% $c->i18n->p("accession.forms.plants", "plants") |h %></option>
                                </select>
                            </div>
                        </div>
                        <div id="population_accession_list" style="display:none">
                            <div class="form-group">
                                <label class="col-sm-4 control-label"><% $c->i18n->p("accession.forms.choose_a_list_of_accessions_to_add", "Choose a List of Accessions to Add:") |h %> </label>
                                <div class="col-sm-8" id="create_population_accession_list_div" name="create_population_accession_list_div">
                                </div>
                            </div>
                        </div>
                        <div id="population_plot_list" style="display:none">
                            <div class="form-group">
                                <label class="col-sm-4 control-label"><% $c->i18n->p("accession.forms.choose_a_list_of_plots_to_add", "Choose a List of Plots to Add:") |h %> </label>
                                <div class="col-sm-8" id="create_population_plot_list_div" name="create_population_plot_list_div">
                                </div>
                            </div>
                        </div>
                        <div id="population_plant_list" style="display:none">
                            <div class="form-group">
                                <label class="col-sm-4 control-label"><% $c->i18n->p("accession.forms.choose_a_list_of_plants_to_add", "Choose a List of Plants to Add:") |h %> </label>
                                <div class="col-sm-8" id="create_population_plant_list_div" name="create_population_plant_list_div">
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" name="create_population_dismiss_button" id="create_population_dismiss_button_2" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="create_population_submit" id="create_population_submit"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="manage_populations_add_members_dialog" name="manage_populations_add_members_dialog" tabindex="-1" role="dialog" aria-labelledby="addMembersToPopulationsDialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addMembersToPopulationsDialog"><% $c->i18n->p("accession.forms.add_members_to_population", "Add Members to Population") |h %> <div id="add_member_population_name"></div></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form" name="add_member_to_population_form" id="add_member_to_population_form">
                        <div class="form-group">
                            <label class="col-sm-6 control-label"><% $c->i18n->p("accession.forms.choose_a_list_of_members_to_add", "Choose a List of Members to Add:") |h %> </label>
                            <div class="col-sm-6" id="add_member_to_population_list_div" name="list_div">
                            </div>
                        </div>
                    </form>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="add_members_to_population_submit" id="add_members_to_population_submit"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="manage_populations_delete_dialog" name="manage_populations_delete_dialog" tabindex="-1" role="dialog" aria-labelledby="deletePopulationsDialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="deletePopulationsDialog"><% $c->i18n->p("accession.stock.population.delete", "Delete Population") |h %> <div id="delete_population_name"></div></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <form class="form-horizontal" role="form">
                        <div class="form-group">
                            <label class="col-sm-6 control-label"><% $c->i18n->p("accession.forms.are_you_sure", "Are You Sure?") |h %></label>
                        </div>
                    </form>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="delete_population_submit" id="delete_population_submit"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="create_population_saved_dialog_message" name="create_population_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="createPopulationSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="createPopulationSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_create_population_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    jQuery("#member_type").change(function() {

        if(jQuery(this).val() == ''){
            jQuery('#population_accession_list').hide();
            jQuery('#population_plot_list').hide();
            jQuery('#population_plant_list').hide();
        } else if(jQuery(this).val() == 'accessions'){
            document.getElementById("create_population_accession_list_div").innerHTML = list.listSelect("create_population_accession_list_div", [ 'accessions' ], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.create.list.choose", "select a list") : "select a list"), undefined, undefined);
            jQuery('#population_accession_list').show();
            jQuery('#population_plot_list').hide();
            jQuery('#population_plant_list').hide();
        } else if (jQuery(this).val() == 'plots'){
            document.getElementById("create_population_plot_list_div").innerHTML = list.listSelect("create_population_plot_list_div", [ 'plots' ], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.create.list.choose", "select a list") : "select a list"), undefined, undefined);
            jQuery('#population_accession_list').hide();
            jQuery('#population_plot_list').show();
            jQuery('#population_plant_list').hide();
        } else if (jQuery(this).val() == 'plants'){
            document.getElementById("create_population_plant_list_div").innerHTML = list.listSelect("create_population_plant_list_div", [ 'plants' ], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.create.list.choose", "select a list") : "select a list"), undefined, undefined);
            jQuery('#population_accession_list').hide();
            jQuery('#population_plot_list').hide();
            jQuery('#population_plant_list').show();
        }

    });

    jQuery("[name='create_population_dismiss_button']").click(function() {
        jQuery('#manage_populations_add_population_dialog').modal('hide');
        jQuery('#create_population_name').val('');
        jQuery('#member_type').val('');
        jQuery('#population_accession_list').hide();
        jQuery('#population_plot_list').hide();
        jQuery('#population_plant_list').hide();
    });


});

</script>


<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<h4><% $c->i18n->p('genotype.tissue.list.field_trials_with_tissue_samples', 'Field Trials With Tissue Samples') |h %></h4>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="tissue_sample_trial_search_results" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th><% $c->i18n->p('global.trial_table.name', 'Trial name') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.description', 'Description') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.breeding_program', 'Breeding program') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.folder', 'Folder') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.year', 'Year') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.location', 'Location') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.type', 'Trial type') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.design', 'Design') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.planting_date', 'Planting Date') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.harvest_date', 'Harvest Date') |h %></th>
                        <th><% $c->i18n->p('global.download', 'Download') |h %></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function () {

   var trial_table = jQuery('#tissue_sample_trial_search_results').DataTable( {
       'ajax': '/ajax/tissue_samples/field_trials',
       "scrollX": true
   });

});

</script>

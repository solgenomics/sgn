
<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<h4><% $c->i18n->p('genotype.tissue.list.sampling_trials', 'Sampling Trials') |h %></h4>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="tissue_sample_sampling_trial_search_results" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th><% $c->i18n->p('global.trial_table.name', 'Trial name') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.description', 'Description') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.breeding_program', 'Breeding program') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.folder', 'Folder') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.year', 'Year') |h %></th>
                        <th><% $c->i18n->p('global.trial_table.location', 'Location') |h %></th>
                        <th><% $c->i18n->p('genotype.sampling.list.sampling_facility', 'Sampling Facility') |h %></th>
                        <th><% $c->i18n->p('genotype.sampling.list.sample_type', 'Sample Type') |h %></th>
                        <th><% $c->i18n->p('global.download', 'Download') |h %></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function () {

   var geno_trial_table = jQuery('#tissue_sample_sampling_trial_search_results').DataTable( {
       'ajax': '/ajax/tissue_samples/sampling_trials',
   });

});

</script>

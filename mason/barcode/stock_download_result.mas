

<%args>
$error => undef
@found => ()
@not_found => ()
$file => ''
$filetype => ''
</%args>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("barcode.helper.download_barcodes", 'Download Barcodes')) &>

% if (!@not_found && !$error) {
  <% $c->i18n->p("barcode.helper.all_stocks_in_the_list_have_been_found_in_the", "All stocks in the list have been found in the database. Please click the link below to download the barcode label file.") |h %><br />
% }
% elsif ($error){
    <b><% $c->i18n->p("barcode.helper.download_plot_phenotyping_barcode", "Download Plot Phenotyping Barcode") |h %> </b>is <%$error%> For general barcode printing use <b><% $c->i18n->p("barcode.helper.download_stock_barcodes_section", "Download Stock Barcodes section.") |h %></b>
% }
% else {
  The following <% scalar(@not_found) %> stocks were not found in the database:<br />
%   foreach my $nf (@not_found) {
      <b><% $nf %></b>
%   }
    <br /><br />
%   if (@found > 0) {

    The other <% scalar(@found) %> barcodes can be downloaded from the link below.



%   }
%   else {
    <% $c->i18n->p("barcode.helper.no_stocks_were_found_please_verify_your_input_and_try", "No stocks were found. Please verify your input and try again.") |h %>
%   }


% }

% if (@found > 0) {
<br /><br />
<a target="_blank" href="<% $file %>" >Download <% $filetype %> file</a>
%}

<%once>
use HTML::Entities ();
</%once>

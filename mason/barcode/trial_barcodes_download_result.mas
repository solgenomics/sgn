

<%args>
$error => undef
$file => ''
$filetype => ''
</%args>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("barcode.helper.download_trial_barcodes", 'Download Trial Barcodes')) &>

% if (!$error) {
  <% $c->i18n->p("barcode.helper.success_please_click_the_link_below_to_download_the_barcode", "Success! Please click the link below to download the barcode label file.") |h %><br />
  <br /><br />
  <a target="_blank" href="<% $file %>" >Download <% $filetype %> file</a>
% }
% elsif ($error){
    <b><% $c->i18n->p("barcode.helper.download_barcode_error", "Download Barcode Error:") |h %></b> <%$error%>
% }

<%once>
use HTML::Entities ();
</%once>

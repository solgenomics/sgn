
<%args>
@locations
@projects
@available_cvterms
</%args>

<%perl>
use DateTime;
my $dt = DateTime->from_epoch( epoch=>time );
my $date = join "/", ($dt->year, $dt->month, $dt->day);
</%perl>

<form class="form-horizontal" role="form" method="GET" action="/barcode/multitool">
  <div class="form-group form-group-sm">
    <label class="col-sm-2 control-label"><% $c->i18n->p("seedlot_maintenance_table.ui.operator", "Operator:") |h %> </label>
    <div class="col-sm-10">
      <input type="text" class="form-control" id="operator" name="operator" />
    </div>
  </div>
  <div class="form-group form-group-sm">
    <label class="col-sm-2 control-label"><% $c->i18n->p("seedlot_maintenance_table.ui.date", "Date:") |h %> </label>
    <div class="col-sm-10">
      <input type="text" class="form-control" id="date" name="date" value="<% $date %>" placeholder="<% $c->i18n->p("barcode.mason.format_yyyy_mm_dd.8b5a42f", "Format: YYYY/MM/DD") |h %>" />
    </div>
  </div>
  <div class="form-group form-group-sm">
    <label class="col-sm-2 control-label"><% $c->i18n->p("seedlot_record.ui.location", "Location:") |h %> </label>
    <div class="col-sm-10">
      <& /page/html_select.mas, name=>'location', choices=>\@locations &>
      <br/>[<a href="/breeders/locations"><% $c->i18n->p("barcode.mason.add_new_location.5fd142a", "Add New Location") |h %></a>]
    </div>
  </div>
  <div class="form-group form-group-sm">
    <label class="col-sm-2 control-label"><% $c->i18n->p("barcode.mason.project", "Project:") |h %> </label>
    <div class="col-sm-10">
      <& /page/html_select.mas, name=>'project', choices=>\@projects &>
      <br/>[<a href="/breeders/trials"><% $c->i18n->p("barcode.mason.add_new_project.0a2a981", "Add New Project") |h %></a>]
    </div>
  </div>
  <div class="form-group form-group-sm">
    <label class="col-sm-2 control-label"><% $c->i18n->p("trial.card.deletion.traits", "Trait(s):") |h %> </label>
    <div class="col-sm-10">
      <select multiple class="form-control" id="cvterms" name="cvterms">
<%perl>
foreach my $t (@available_cvterms) {
   if ($t =~ /\#/) { next; }
   my ($cvterm, $version, $priority, $values, $description) = split /\t/, $t;
   if ($priority) {
     print qq { <option value="$cvterm">$description</option> };
   }
}
</%perl>
      </select>

    </div>
  </div>
  <button style="float:right" type="submit" class="btn btn-info btn-sm" type="submit" value="generate form"><% $c->i18n->p("barcode.mason.generate_form", "Generate Form") |h %></button>
</form>

<br/>


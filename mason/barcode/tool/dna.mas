
<h1><% $c->i18n->p("barcode.mason.cassavabase_dna_extraction_tool", "Cassavabase DNA extraction tool") |h %></h1>

<table>
<tr><th><% $c->i18n->p("barcode.mason.row", "ROW") |h %></th><th><% $c->i18n->p("barcode.mason.column", "COLUMN") |h %></th></tr>
<tr><td>
% foreach my $row ('A'..'H') { 
<& /barcode/tool/generate.mas, code=>$row &>
%}
</td><td>
% foreach my $col (1..12) { 
  <& /barcode/tool/generate.mas, code=>$col &>
%}
</td></tr></table>

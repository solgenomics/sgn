

<%args>
$operator
$date
$project
$location
@cvterms
</%args>


<%perl>
use Tie::UrlEncoder;

our %urlencode;
my $encoded_operator = $urlencode{$operator};
my $encoded_date     = $urlencode{$date};
my $size = "small";
</%perl>


<center>
<h1><% $c->i18n->p("barcode.mason.cassavabase_multi_barcode_sheet", "CASSAVABASE MULTI-BARCODE SHEET") |h %></h1>

<br />
<br />
<div class="boxbgcolor5">
<% $c->i18n->p("barcode.mason.scan_the_following_barcodes_once", "Scan the following barcodes once") |h %>
</div>

<table>
<tr><td><font size="4"><% $c->i18n->p("cross.ui.operator", "Operator") |h %></font></td>

<td><img src="/barcode/image/?code=O:<% $encoded_operator %>&size=<% $size %>" /></td></tr>

<tr><td><font size="4"><% $c->i18n->p("barcode.mason.today_s_date", "Today's Date") |h %></font></td>
<td><img src="/barcode/image/?code=D:<% $encoded_date %>&size=<% $size %>" /></td></tr>
<tr><td><font size="4"><% $c->i18n->p("global.search_wizard.project", "Project") |h %></font></td>

<td><img src="/barcode/image/?code=P:<% $project %>&size=<% $size %>" /></td></tr>
<tr><td><font size="4"><% $c->i18n->p("global.search.features.location", "Location") |h %></font></td>
<td><img src="/barcode/image/?code=L:<% $location %>&size=<% $size %>" /></td></tr>
</table>


<br /><br /><br /><br />


<div class="boxbgcolor5">
<% $c->i18n->p("barcode.mason.scan_the_barcode_for_the_plant_to_be_phenotyped_then", "Scan the barcode for the plant to be phenotyped, then scan the phenotype barcode, then enter the number on the keypad") |h %>
</div>


<table border="0" cellpadding="20">
<%perl>

foreach my $t (@cvterms) { 
     my $definition = $t->{cvterm_definition};
     $definition =~ s/(.{40})/$1\<br \\\>/g; 
     print qq { <tr><td><img src="/barcode/image/?code=$t->{cvterm}&size=$size" /></td><td>$definition</td></tr> };

}

</%perl>
</table>
</center>



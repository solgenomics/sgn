
<%args>
$operator
$date
$project
$location
$size => 'large'
</%args>

<%perl>
use Tie::UrlEncoder;

our %urlencode;
my $encoded_operator = $urlencode{$operator};
my $encoded_date     = $urlencode{$date};

</%perl>

<center>
<h1><% $c->i18n->p("barcode.mason.cassavabase_metadata_barcode_sheet", "CASSAVABASE METADATA BARCODE SHEET") |h %></h1>
<font size="7"><% $c->i18n->p("cross.ui.operator", "Operator") |h %></font><br />

<img src="/barcode/image/?code=O:<% $encoded_operator %>&size=<% $size %>" />

<br />
<br />

<font size="7"><% $c->i18n->p("barcode.mason.today_s_date", "Today's Date") |h %></font>
<br />
<img src="/barcode/image/?code=D:<% $encoded_date %>&size=<% $size %>" />

<br />
<br />

<font size="7"><% $c->i18n->p("global.search_wizard.project", "Project") |h %></font>
<br />
<img src="/barcode/image/?code=P:<% $project %>&size=<% $size %>" />

<br />
<br />

<font size="7"><% $c->i18n->p("global.search.features.location", "Location") |h %></font>
<br />
<img src="/barcode/image/?code=L:<% $location %>&size=<% $size %>" />


</center>

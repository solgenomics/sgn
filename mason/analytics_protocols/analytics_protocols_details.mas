<%once>
use HTML::Entities ();
</%once>
<%init>
my $summary_text=sub {HTML::Entities::encode_entities(defined($_[0]) ? "$_[0]":'')};
</%init>
<%args>
$analytics_protocol_id
$analytics_protocol_name
$analytics_protocol_description
$analytics_protocol_type_id

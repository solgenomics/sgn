<%once>
use HTML::Entities ();
</%once>


<%args>
</%args>

<%doc>

=head1 NAME

/mason/analytics_protocols/index.mas - show user-specific analytics in the system

=head1 DESCRIPTION

Displays a page with a table of all the analytics run by the currently logged in user.

=head1 AUTHOR

=cut

</%doc>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ], entries => [] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("analysis.interface.your_analytics_protocols", "Your Analytics Protocols")) &>

<button class='btn btn-success' style='margin:3px;float:right' id='drone_imagery_analytics_link'><% $c->i18n->p("analysis.interface.drone_imagery_analytics", "Drone Imagery Analytics") |h %></button><br />
<hr>

<& /breeders_toolbox/drone_imagery/drone_imagery_analytics.mas &>

<div class="well">
    <table class="table table-bordered table-hover" id="analytics_protocols_by_user_table">
        <thead>
            <tr>
                <th><% $c->i18n->p("analysis.interface.analytics_protocol_name", "Analytics Protocol Name") |h %></th>
                <th><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></th>
                <th><% $c->i18n->p("global.search.features.type.f65b938", "Type") |h %></th>
                <th><% $c->i18n->p("cross.forms.create_date", "Create Date") |h %></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<script>
jQuery(document).ready(function(){
    jQuery('#analytics_protocols_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analytics_protocols/by_user' }
    });
});
</script>

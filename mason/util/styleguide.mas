    <th><% $c->i18n->p('styleguide.demo.trial_table.trial_type', 'Trial type') |h %></th>
    <th><% $c->i18n->p('styleguide.demo.trial_table.design', 'Design') |h %></th>
    <th><% $c->i18n->p('styleguide.demo.trial_table.planting_date', 'Planting Date') |h %></th>

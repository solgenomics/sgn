<h3><% $c->i18n->p('styleguide.section.example_workflow', 'An Example Workflow Explaining Workflows') |h %></h3>

<&| /util/workflow.mas , id=> "my_workflow"&>

  <&| /util/workflow.mas:step, title=>"workflow.mas" &>
    <p><% styleguide_fixed_markup($c->i18n->p('styleguide.workflow.add_workflow', 'Add a workflow using the %{component} mason component', { component => '__SGN_WORKFLOW_COMPONENT__' }), { '__SGN_WORKFLOW_COMPONENT__' => '<code>/util/workflow.mas</code>' }) |n %></p>
    <p><pre><%text>&lt;&amp;| /util/workflow.mas, id=> "my_workflow" &amp;&gt;...&lt;/&amp;&gt;</%text></pre></p>
    <button type="button" class="btn btn-default" onclick="Workflow.complete(this);"><% $c->i18n->p('styleguide.workflow.next', 'Next') |h %></button>
  </&>
  
  <&| /util/workflow.mas:step, title=>HTML::Entities::encode_entities($c->i18n->p('styleguide.workflow.step.adding', 'Adding Steps')) &>
    <p><% styleguide_fixed_markup($c->i18n->p('styleguide.workflow.add_steps', 'Add steps to the workflow using the %{step_method} mason method.', { step_method => '__SGN_STEP_METHOD__' }), { '__SGN_STEP_METHOD__' => '<code>/util/workflow.mas:step</code>' }) |n %></p>
    <p>
<pre><%text>&lt;&amp;| /util/workflow.mas, id=&gt; "my_workflow" &amp;&gt;
    &lt;&amp;| /util/workflow.mas:step, title=&gt; "Step A" &amp;&gt;...&lt;/&amp;&gt;
    &lt;&amp;| /util/workflow.mas:step, title=&gt; "Another Step" &amp;&gt;...&lt;/&amp;&gt;
    ...
&lt;/&amp;&gt;</%text></pre>
    </p>
    <button type="button" class="btn btn-default" onclick="Workflow.complete(this);"><% $c->i18n->p('styleguide.workflow.next', 'Next') |h %></button>
  </&>
  
  <&| /util/workflow.mas:step, title=>HTML::Entities::encode_entities($c->i18n->p('styleguide.workflow.step.completing', 'Completing Steps')) &>
  <p>
    <% styleguide_fixed_markup($c->i18n->p('styleguide.workflow.complete_help', 'Use the %{complete_method} JavaScript function to complete a step. %{element} should be any DOM element within the step you would like to complete.', { complete_method => '__SGN_COMPLETE_METHOD__', element => '__SGN_ELEMENT__' }), { '__SGN_COMPLETE_METHOD__' => '<code>Workflow.complete(Element)</code>', '__SGN_ELEMENT__' => '<code>Element</code>' }) |n %>
  </p>
  <p>
<pre><%text>&lt;&amp;| /util/workflow.mas, id=&gt; "my_workflow"&amp;&gt;
  &lt;&amp;| /util/workflow.mas:step, title=&gt;"workflow.mas" &amp;&gt;
    ...
    &lt;button type="button" onclick="Workflow.complete(this);"&gt;Next&lt;/button&gt;
  &lt;/&amp;&gt;
  ...
&lt;/&amp;&gt;</%text></pre>
  </p>
  <button type="button" class="btn btn-default" onclick="Workflow.complete(this);"><% $c->i18n->p('styleguide.workflow.next', 'Next') |h %></button>
  </&>
  
  <&| /util/workflow.mas:step, title=>HTML::Entities::encode_entities($c->i18n->p('styleguide.workflow.step.skipping', 'Skipping Steps')) &>
  <p>
    <% styleguide_fixed_markup($c->i18n->p('styleguide.workflow.skip_help', 'Skipping works like completing but marks the step as incomplete. Use %{skip_method} just like you would %{complete_method}.', { skip_method => '__SGN_SKIP_METHOD__', complete_method => '__SGN_COMPLETE_METHOD__' }), { '__SGN_SKIP_METHOD__' => '<code>Workflow.skip(Element)</code>', '__SGN_COMPLETE_METHOD__' => '<code>Workflow.complete(Element)</code>' }) |n %>
  </p>
  <p>
<pre><%text>&lt;&amp;| /util/workflow.mas, id=&gt; "my_workflow"&amp;&gt;
  &lt;&amp;| /util/workflow.mas:step, title=&gt;"workflow.mas" &amp;&gt;
    ...
    &lt;button type="button" onclick="Workflow.skip(this);"&gt;Skip&lt;/button&gt;
  &lt;/&amp;&gt;
  ...
&lt;/&amp;&gt;</%text></pre>
  </p>
  <button type="button" class="btn btn-default" onclick="Workflow.skip(this);"><% $c->i18n->p('styleguide.workflow.skip_button', 'Skip this Step') |h %></button>
  </&>
  
  <&| /util/workflow.mas:step, title=>HTML::Entities::encode_entities($c->i18n->p('styleguide.workflow.step.pending', 'Pending Steps')) &>
  <p>
    <% styleguide_fixed_markup($c->i18n->p('styleguide.workflow.pending_help', 'Sometimes a step needs time to complete, such as uploads. You can mark a step as pending using %{pending_method}. You can later fully complete the step using %{complete_method}.', { pending_method => '__SGN_PENDING_METHOD__', complete_method => '__SGN_COMPLETE_METHOD__' }), { '__SGN_PENDING_METHOD__' => '<code>Workflow.pending(Element)</code>', '__SGN_COMPLETE_METHOD__' => '<code>Workflow.complete(Element)</code>' }) |n %>
  </p>
  <p>
<pre><%text>&lt;&amp;| /util/workflow.mas, id=&gt; "my_workflow"&amp;&gt;
  &lt;&amp;| /util/workflow.mas:step, title=&gt;"workflow.mas" &amp;&gt;
    ...
    &lt;button type="button" onclick="Workflow.pending(this);"&gt;Wait&lt;/button&gt;
    &lt;button type="button" onclick="Workflow.complete(this,false);"&gt;Complete&lt;/button&gt;
  &lt;/&amp;&gt;
  ...
&lt;/&amp;&gt;</%text></pre>
  </p>
  <button id="to_complete" type="button" class="btn btn-primary" onclick="Workflow.pending(this);"><% $c->i18n->p('styleguide.workflow.wait_continue', 'Wait and Continue') |h %></button>
  </&>
  
  <&| /util/workflow.mas:step, title=>HTML::Entities::encode_entities($c->i18n->p('styleguide.workflow.step.endscreens', 'Endscreens')) &>
  <p>
    <% styleguide_fixed_markup($c->i18n->p('styleguide.workflow.endscreens_help', 'After the final step is completed, an endscreen will be shown. To set the content of the endscreen, use the %{complete_method} mason method. You can also optionally set a special endscreen which is shown instead while there are pending steps using %{pending_method}.', { complete_method => '__SGN_COMPLETE_METHOD__', pending_method => '__SGN_PENDING_METHOD__' }), { '__SGN_COMPLETE_METHOD__' => '<code>/util/workflow.mas:complete</code>', '__SGN_PENDING_METHOD__' => '<code>/util/workflow.mas:pending</code>' }) |n %>
  </p>
  <p>
<pre><%text>&lt;&amp;| /util/workflow.mas, id=&gt; "my_workflow"&amp;&gt;
  ...
  &lt;&amp;| /util/workflow.mas:complete &amp;&gt; ... &lt;/&amp;&gt;
  &lt;&amp;| /util/workflow.mas:pending &amp;&gt; ... &lt;/&amp;&gt;
&lt;/&amp;&gt;</%text></pre>
  </p>
  <button type="button" class="btn btn-default" onclick="Workflow.complete(this);"><% $c->i18n->p('styleguide.workflow.go_to_endscreen', 'Go to endscreen') |h %></button>
  </&>
  
  <&| /util/workflow.mas:pending &>
    <h2><% $c->i18n->p('styleguide.workflow.pending_message', 'There is still a pending step. Complete it to see the final endscreen.') |h %></h2>
    <button type="button" class="btn btn-default" onclick="Workflow.complete(document.querySelector('#to_complete'),false);"><% $c->i18n->p('styleguide.workflow.complete_pending', 'Complete Pending Step') |h %></button>
  </&>
  <&| /util/workflow.mas:complete &>
    <h1><% $c->i18n->p('styleguide.workflow.congratulations', "Congratulations, you've made it through the workflow!") |h %></h1>
    <h4><% $c->i18n->p('styleguide.workflow.tips_heading', 'Here are some other tips and tricks:') |h %></h4>
    <p><% styleguide_fixed_markup($c->i18n->p('styleguide.workflow.focus_help', 'To set the currently visible step of the workflow use %{focus_code}', { focus_code => '__SGN_FOCUS_CODE__' }), { '__SGN_FOCUS_CODE__' => '<code>Workflow.focus(wf,step_index);</code>' }) |n %></p>
    <pre>var wf = document.querySelector("#my_workflow");
Workflow.focus(wf,step_index);</pre>
    <p>
      <% styleguide_fixed_markup($c->i18n->p('styleguide.workflow.focus_behavior', 'By default, %{complete_method}, %{skip_method}, and %{pending_method} also change the focus to the next step. Sometimes, you need to set a step to complete without changing the focus. To do this, pass %{false_value} as the second argument.', { complete_method => '__SGN_COMPLETE_METHOD__', skip_method => '__SGN_SKIP_METHOD__', pending_method => '__SGN_PENDING_METHOD__', false_value => '__SGN_FALSE__' }), { '__SGN_COMPLETE_METHOD__' => '<code>Workflow.complete(...)</code>', '__SGN_SKIP_METHOD__' => '<code>Workflow.skip(...)</code>', '__SGN_PENDING_METHOD__' => '<code>Workflow.pending(...)</code>', '__SGN_FALSE__' => '<code>false</code>' }) |n %>
    </p>
    <pre>Workflow.complete(Element,false);
Workflow.skip(Element,false);
Workflow.pending(Element,false);</pre>
  </&>
</&>

<hr>

<h3><% $c->i18n->p('styleguide.section.vega_graphs', 'Vega(-lite) Graphs') |h %></h3>

<p>
    <% styleguide_fixed_markup($c->i18n->p('styleguide.vega.intro', 'Using %{vega_lite_link} is an easy and quick way to make graphs in the db. Simply include vega-lite:', { vega_lite_link => '__SGN_VEGA_LITE_LINK__' }), { '__SGN_VEGA_LITE_LINK__' => '<a href="https://vega.github.io/vega-lite/">vega-lite</a>' }) |n %>
    <pre><%text><& /util/import_javascript.mas, classes => [qw[ vega.vega3 vega.vega-lite2 vega.vega-embed3 vega.vega-defaults ]] &></%text></pre>
    set up a div:
<pre><%text>&lt;div id="vis"&gt;&lt;/div&gt;</%text></pre>
    <% styleguide_fixed_markup($c->i18n->p('styleguide.vega.run', 'and then run vega-lite (you can also use a %{vega_link} graph spec):', { vega_link => '__SGN_VEGA_LINK__' }), { '__SGN_VEGA_LINK__' => '<a href="https://vega.github.io/vega/">vega</a>' }) |n %>
<pre><%text>&lt;script type="text/javascript"&gt;
    var yourVlSpec = {
      "$schema": "https://vega.github.io/schema/vega-lite/v2.0.json",
      "description": "A simple bar chart with embedded data.",
      "data": {
        "values": [
          {"a": "A","b": 28}, {"a": "B","b": 55}, {"a": "C","b": 43},
          {"a": "D","b": 91}, {"a": "E","b": 81}, {"a": "F","b": 53},
          {"a": "G","b": 19}, {"a": "H","b": 87}, {"a": "I","b": 52}
        ]
      },
      "mark": "bar",
      "encoding": {
        "x": {"field": "a", "type": "ordinal"},
        "y": {"field": "b", "type": "quantitative"}
      }
    }
    vegaEmbed("#vis", yourVlSpec, window.VEGA_DEFAULTS);
  &lt;/script&gt;</%text></pre>
</p>
<% $c->i18n->p('styleguide.vega.to_create', 'to create:') |h %>
<& /util/import_javascript.mas, classes => [qw[ vega.vega3 vega.vega-lite2 vega.vega-embed3 vega.vega-defaults ]] &>
<div>
  <div id="vis"></div>
</div>
<script type="text/javascript">
    var yourVlSpec = {
      "$schema": "https://vega.github.io/schema/vega-lite/v2.0.json",
      "description": "A simple bar chart with embedded data.",
      "data": {
        "values": [
          {"a": "A","b": 28}, {"a": "B","b": 55}, {"a": "C","b": 43},
          {"a": "D","b": 91}, {"a": "E","b": 81}, {"a": "F","b": 53},
          {"a": "G","b": 19}, {"a": "H","b": 87}, {"a": "I","b": 52}
        ]
      },
      "mark": "bar",
      "encoding": {
        "x": {"field": "a", "type": "ordinal"},
        "y": {"field": "b", "type": "quantitative"}
      }
    }
    vegaEmbed("#vis", yourVlSpec, window.VEGA_DEFAULTS);
</script>

<hr>

<h3><% $c->i18n->p('styleguide.section.trial_search_datatable', 'Field Trials Search Datatable') |h %></h3>
<p><% $c->i18n->p('styleguide.caption.source', 'Source:') |h %></p>
<pre>
    &lt;div class="well"&gt;
    &lt;table id="trial_search_results" width="100%" class="table table-hover table-striped"&gt;
    &lt;thead&gt;
      &lt;tr&gt;
        &lt;th&gt;Trial name&lt;/th&gt;
        &lt;th&gt;Description&lt;/th&gt;
        &lt;th&gt;Breeding program&lt;/th&gt;
        &lt;th&gt;Folder&lt;/th&gt;
        &lt;th&gt;Year&lt;/th&gt;
        &lt;th&gt;Location&lt;/th&gt;
        &lt;th&gt;Trial type&lt;/th&gt;
        &lt;th&gt;Design&lt;/th&gt;
        &lt;th&gt;Planting Date&lt;/th&gt;
        &lt;th&gt;Harvest Date&lt;/th&gt;
        &lt;th&gt;Download&lt;/th&gt;
    &lt;/tr&gt;
    &lt;/thead&gt;
    &lt;/table&gt;
    &lt;/div&gt;
    &lt;script type="text/javascript"&gt;
    var trial_table = jQuery('#trial_search_results').DataTable( {
        'ajax': {
            'url':'/ajax/search/trials',
            'data': function(d) {
                d.select_checkbox_name = 'create_tissue_sample_select_trial';
            }
        }
    });
    &lt;/script&gt;
</pre>

<p><% $c->i18n->p('styleguide.caption.creates', 'Creates:') |h %></p>
<div class="well">
<table id="styleguide_trial_search_results" width="100%" class="table table-hover table-striped">

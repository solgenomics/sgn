
<%doc>

=head1 NAME

/markers/kfg.mas - a Mason component displaying information about kfg (known function genes) markers

=head1 DESCRIPTION

takes the parameter $marker - a CXGN::Marker object.

=head1 AUTHOR

Lukas Mueller <lam87@cornell.edu>

=cut

</%doc>

<%args>
$marker
</%args>

<%perl>
use SGN::I18N ();



  # prints a link to the gene page if this marker maps to a gene 
  # (KFG = Known Function Gene)

  my @loci = $marker->associated_loci();

my $html = '';
foreach my $l (@loci) {
  my ($locus_id, $locus_name) = ($l->[0], $l->[1]);

    $html .= (SGN::I18N::translate($c->i18n, "marker.detail.locus_association_sentence", "This marker is associated with the %{locus_name} locus.", {locus_name => qq|<a href="/phenome/locus_display.pl?locus_id=$locus_id">$locus_name</a>|}) . "<br /><br />");
  }

  


</%perl>

<% $html %>

<%once>
use HTML::Entities ();
</%once>
<%doc>

=head1 NAME

/markers/cos.mas - a Mason component displaying information about cos markers

=head1 DESCRIPTION

parameters 

=over 5

=item *

$marker - a CXGN::Marker object.

=back

=head1 AUTHOR

Lukas Mueller <lam87@cornell.edu>

=cut

</%doc>

<%args>
$marker
</%args>

<%perl>
use SGN::I18N ();


#   my $cos_query = q{SELECT c.cos_marker_id, c.marker_id, c.cos_id, c.at_match, 
# 	    c.at_position, c.bac_id, c.best_gb_prot_hit, c.at_evalue, 
# 	    c.at_identities, c.mips_cat, c.description, c.comment, 
# 	    c.gbprot_evalue, c.gbprot_identities, s.trace_name 
# 	    FROM cos_markers AS c LEFT JOIN seqread AS s ON 
# 	    c.est_read_id=s.read_id WHERE c.marker_id = ?};

#   my $cos_sth = $dbh->prepare($cos_query);
#   $cos_sth->execute($marker_id);
#   my $r = $cos_sth->fetchrow_hashref();

  my $r = $marker->cos_data();

  unless($r->{cos_marker_id}) { return''; }

  my $at_page='http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?cmd=Retrieve&amp;db=Nucleotide&amp;dopt=GenBank&amp;list_uids=';
  my $map_link='/search/markers/markerinfo.pl?marker_id=';
  my $est_read_page='/search/est.pl?request_from=0&amp;request_type=automatic&amp;search=Search&amp;request_id=';
  my $cos_page='/search/markers/markerinfo.pl?marker_id=';
  my $at_match=$r->{at_match};
  my $bac_id=$r->{bac_id};
  my $trace_name=$r->{trace_name};
  my $at_posn=$r->{at_position};
  if($trace_name) {
    $trace_name="<a href=\"$est_read_page$trace_name\">$trace_name</a>"
  }
  else {
    $trace_name=("<span class=\"ghosted\">" . SGN::I18N::translate($c->i18n, "marker.detail.cos.none", "None", undef, {entities => '<>&'}) . "</span>");
  }

  my $orth = (qq~<b>~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.arabidopsis_identities", "Arabidopsis identities: ", undef, {entities => '<>&'}) . qq~</b>$r->{at_identities}<br />
~);
  ;

my $basic = (qq~<b><a href="/documents/markers/role_categories.txt">~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.mips_category", "MIPS Category", undef, {entities => '<>&'}) . qq~</a>: </b>$r->{mips_cat}<br />
<b>~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.tomato_est_read", "Tomato EST read:", undef, {entities => '<>&'}) . qq~</b> $trace_name<br />
<b>~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.arabidopsis_best_bac_match", "Arabidopsis best BAC match:", undef, {entities => '<>&'}) . qq~</b> <a href="$at_page$bac_id">$at_match</a><br />
<b>~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.arabidopsis_position", "Arabidopsis position:", undef, {entities => '<>&'}) . qq~</b> $at_posn<br />
~);

  my $genbank = (qq~<b>~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.best_genbank_protein_hit", "Best GenBank protein hit: ", undef, {entities => '<>&'}) . qq~</b><a href="http://www.ncbi.nlm.nih.gov/entrez/query.fcgi?db=Protein&amp;cmd=search&amp;term=$r->{best_gb_prot_hit}">$r->{best_gb_prot_hit}</a><br />
<b>~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.evalue", "Evalue: ", undef, {entities => '<>&'}) . qq~</b>$r->{gbprot_evalue}<br />
<b>~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.identities", "Identities: ", undef, {entities => '<>&'}) . qq~</b>$r->{gbprot_identities}<br />
<b>~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.description", "Description: ", undef, {entities => '<>&'}) . qq~</b>$r->{description}<br />
<b>~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.comment", "Comment: ", undef, {entities => '<>&'}) . qq~</b>$r->{comment}<br />
~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.more_information", "More information about COS markers can be found on the ", undef, {entities => '<>&'}) . qq~<a href="/markers/cos_markers.pl">~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.cos_markers_link", "COS markers", undef, {entities => '<>&'}) . (qq~</a>~ . SGN::I18N::translate($c->i18n, "marker.detail.cos.page_suffix", " page.") . "\n"));
  ;

### print  CXGN::Page::FormattingHelpers::blue_section_html('COS information', $basic.$orth.$genbank);

</%perl>


<&| /page/info_section.mas, anchor_title => 'COS information', title=>HTML::Entities::encode_entities($c->i18n->p("marker.detail.cos_information", 'COS information')) &> <% $basic.$orth.$genbank %> </&>





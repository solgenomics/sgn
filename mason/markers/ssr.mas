
<%doc>

=head1 NAME

/markers/ssr.mas - a Mason component displaying information about ssr markers

=head1 DESCRIPTION

parameters 

=over 5

=item *

$marker - a CXGN::Marker object.

=back

=head1 AUTHOR

Lukas Mueller <lam87@cornell.edu>

Based on old SGN code.

=cut

</%doc>

<%args>
$marker
</%args>

<%perl>
use SGN::I18N ();


  if (!$marker->ssr_data()) { return; }

my $marker_id = $marker->marker_id();

my $html = "";
#my $query = 'SELECT repeat_motif, reapeat_nr FROM ssr_repeats WHERE marker_id='.$marker_id;
#my $repeats = $dbh->selectall_arrayref($query);
my $contig_page='/search/unigene.pl?type=legacy&';
my $est_page='/search/est.pl?request_type=automatic&amp;request_from=1&amp;request_id=';
my $ssr_page='/search/markers/markerinfo.pl?marker_id=';
#my @ssr_list;

my ($ssr_id, $ssr_name, $est_trace, $start_primer, $end_primer, $pcr_length, $ann_high, $ann_low) = $marker->ssr_data();
    
    

  $ann_high ||= "n/a";
  $ann_low ||= "n/a";
  # Get the repeat motifs.
#  my @repeat_motifs=();
#  my @repeat_numbers=();

   $html.=("<br /><b>" . SGN::I18N::translate($c->i18n, "marker.detail.ssr_annealing_temperatures", "Annealing temperatures:", undef, {entities => '<>&'}) . "</b> <b>" . SGN::I18N::translate($c->i18n, "marker.detail.low", "Low:", undef, {entities => '<>&'}) . "</b> ") . $ann_low . (" <b>" . SGN::I18N::translate($c->i18n, "marker.detail.high", "High:", undef, {entities => '<>&'}) . "</b> ") . $ann_high;

my @motifs = $marker->ssr_motif_info($ssr_id);
foreach my $m (@motifs) { 
  my ($motif, $r_nr)  = ($m->[0], $m->[1]);
  
  $html.=("<br /><b>" . SGN::I18N::translate($c->i18n, "marker.detail.repeat_motif", "Repeat motif:", undef, {entities => '<>&'}) . "</b> <span class=\"sequence\">$motif</span>&nbsp;&nbsp;&nbsp;<b>" . SGN::I18N::translate($c->i18n, "marker.detail.repeat_number", "Repeat number:", undef, {entities => '<>&'}) . "</b> $r_nr");
}
$html.=("<br /><b>" . SGN::I18N::translate($c->i18n, "marker.detail.ssr_forward_primer", "Forward primer:", undef, {entities => '<>&'}) . "</b> <span class=\"sequence\">$start_primer</span>");
$html.=("<br /><b>" . SGN::I18N::translate($c->i18n, "marker.detail.ssr_reverse_primer", "Reverse primer:", undef, {entities => '<>&'}) . "</b> <span class=\"sequence\">$end_primer</span>");
$html.=("<br /><b>" . SGN::I18N::translate($c->i18n, "marker.detail.predicted_size", "Predicted size:", undef, {entities => '<>&'}) . "</b> $pcr_length");

if($html) {
  $html =  CXGN::Page::FormattingHelpers::info_section_html(title=>SGN::I18N::translate($c->i18n, "marker.detail.ssr_info", "SSR info", undef, {entities => '<>&'}), anchor_title => "SSR info",contents=>$html)
}
else {
  $html = '';
}


</%perl>

<% $html %>

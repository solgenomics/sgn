
<%doc>

=head1 NAME

/markers/overgo.mas - a Mason component displaying information about comments on markers stored in the database

=head1 DESCRIPTION

parameters 

=over 5

=item *

$marker - a CXGN::Marker object.

=back

=head1 AUTHOR

Lukas Mueller <lam87@cornell.edu>

=cut

</%doc>

<%args>
$marker
</%args>

<%perl>
use SGN::I18N ();

my $comments=$marker->comments();
if($comments) {
  return CXGN::Page::FormattingHelpers::info_section_html(title => SGN::I18N::translate($c->i18n, "marker.detail.comments", "Comments", undef, {entities => '<>&'}), anchor_title => "Comments", contents => newlines_to_brs($comments));
}
else {
  return'';
}

</%perl>

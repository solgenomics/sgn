<%args>
  $marker
  $image_location
  $image_size
</%args>
<%init>
use SGN::I18N ();


my $marker_id   = $marker->marker_id;
my $marker_name = $marker->name_that_marker();
my $width_attribute = $image_size eq 'full' ? '': 'width="740"' ;

</%init>

<& /page/page_title.mas, title => HTML::Entities::encode_entities(SGN::I18N::translate($c->i18n, "marker.detail.rflp_image_page_title", "RFLP image for marker %{marker_name}", {marker_name => ("" . $marker_name)})) &>

<a href="/search/markers/markerinfo.pl?marker_id=<% $marker_id %>"><% SGN::I18N::translate($c->i18n, "marker.detail.return_to_marker_info", "Return to %{marker_name} info page", {marker_name => ("" . $marker_name)}) %></a>&nbsp;&nbsp;&nbsp;

% #if we are constraining the size of the image (small image view)
% if( $width_attribute ) {

    <b><% $c->i18n->p("barcode.mason.size", "Size:") |h %></b>&nbsp;&nbsp;&nbsp;<% $c->i18n->p("marker.detail.small", "Small") |h %>&nbsp;&nbsp;&nbsp;<a href="?marker_id=<% $marker_id %>&amp;size=full"><% $c->i18n->p("marker.detail.full", "Full") |h %></a><br /><br />

% } else { #else we are not constraining the size of the image (large image view)
    <b><% $c->i18n->p("barcode.mason.size", "Size:") |h %></b>&nbsp;&nbsp;&nbsp;<a href="?marker_id=<% $marker_id %>&amp;size=small"><% $c->i18n->p("marker.detail.small", "Small") |h %></a>&nbsp;&nbsp;&nbsp;<% $c->i18n->p("marker.detail.full", "Full") |h %>&nbsp;&nbsp;<br /><br />

% }

<img src="<% $image_location %>" border="0" <% $width_attribute %> />

<%once>
use HTML::Entities ();
</%once>

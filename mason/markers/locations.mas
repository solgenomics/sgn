<%once>
use HTML::Entities ();
</%once><%doc>

=head1 NAME

/markers/locations.mas - a Mason component displaying information about map locations of markers

=head1 DESCRIPTION

parameters 

=over 5

=item *

$marker - a CXGN::Marker object.


=back

=head1 AUTHOR

Lukas Mueller <lam87@cornell.edu>

=cut

</%doc>

<%args>
$marker
</%args>

<%perl>
use SGN::I18N ();

use CXGN::Cview::MapFactory;
use CXGN::Cview::ChrMarkerImage;

my $locations_html = '';
my $marker_name    = $marker->get_name();
my @displayed_locs;
my @displayed_pcr;

#if we have some experiments, and they are an arrayref, and there is at least one location in them
my $experiments = $marker->current_mapping_experiments() || [];

if (    $experiments
    and @{$experiments}
    and grep { $_->{location} } @{$experiments} )
{
    my $count = 1;
    for my $experiment ( @{$experiments} ) {

#make sure we have a location before we go about showing location data--some experiments do not have locations
        if ( my $loc = $experiment->{location} ) {

#make sure we haven't displayed a location entry with the same location ID already
            unless ( grep { $_ == $loc->location_id() } @displayed_locs ) {
                push( @displayed_locs, $loc->location_id() );
                if ( $count > 1 ) {
                    $locations_html .= '<br />';
                }
                $locations_html .=
'<table width="100%" cellspacing="0" cellpadding="0" border="0"><tr>';

                #make a section detailing the location
                my $protocol = '';
                my $pcr      = $experiment->{pcr_experiment};
                my $rflp     = $experiment->{rflp_experiment};
                $protocol = $experiment->{protocol};
                unless ($protocol) {
                    if ($pcr) {
                        $protocol = 'PCR';
                    }
                    elsif ($rflp) {
                        $protocol = 'RFLP';
                    }
                    else {
                        $protocol = ('<span class="ghosted">' . SGN::I18N::translate($c->i18n, "marker.detail.pcr_unknown", "Unknown", undef, {entities => '<>&'}) . '</span>');
                    }
                }

                #make a link to the map this marker can be found on
                my $map_version_id = $loc->map_version_id();
                my $lg_name        = $loc->lg_name();
                my $position       = $loc->position();
                my $subscript      = $loc->subscript();
                $subscript ||= '';
                my $map_url = '';
                my $map_id  = '';

                my $dbh         = $marker->{dbh};
                my $map_factory = CXGN::Cview::MapFactory->new($dbh);
                my $map =
                  $map_factory->create( { map_version_id => $map_version_id } );
		if (!$map) {
		  print "map_version_id = $map_version_id could not be instantiated\n"; 
		  next;
		}
                my $map_name = $map->get_short_name();
                if ($map_version_id) {
                    $map_id = $map->get_id();

                    if (    $map_id
                        and $map_name
                        and defined($lg_name)
                        and defined($position) )
                    {
                        $map_url =
"<a href=\"/cview/view_chromosome.pl?map_version_id=$map_version_id&amp;chr_nr=$lg_name&amp;cM=$position&amp;hilite=$marker_name$subscript&amp;zoom=1\">$map_name</a>";
                    }
                }
                else {
                    $map_url =
                      ('<span class="ghosted">' . SGN::I18N::translate($c->i18n, "marker.detail.map_not_available", "Map data not available", undef, {entities => '<>&'}) . '</span>');
                }
                my $multicol = 1;
                my $width    = "300px";
                if ( $subscript and $multicol > 1 ) { $multicol++; }
                my @locations = (
                    '__title' =>
("<b>" . SGN::I18N::translate($c->i18n, "marker.detail.map_label_colon", "Map:", undef, {entities => '<>&'}) . "</b> $map_url&nbsp;&nbsp;&nbsp;"),
                    '__tableattrs' => "width=\"$width\"",
                    '__multicol'   => $multicol,
		    SGN::I18N::translate($c->i18n, "marker.detail.map_version", "Map version", undef, {entities => '<>&'})  => $map_version_id.(" (" . SGN::I18N::translate($c->i18n, "marker.detail.location_label", "location: ", undef, {entities => '<>&'})).$loc->location_id().")",
		    'Chromosome'   => $loc->lg_name(),
                    SGN::I18N::translate($c->i18n, "marker.detail.position_padded", "Position    ", undef, {entities => '<>&'}) => sprintf( '%.2f', $loc->position() )." ".$map->get_units(),
                    SGN::I18N::translate($c->i18n, "marker.detail.confidence", "Confidence", undef, {entities => '<>&'})   => $loc->confidence(),
                    'Protocol'     => $protocol
                );
                if ($subscript) {
                    push( @locations, ( SGN::I18N::translate($c->i18n, "marker.detail.subscript", "Subscript", undef, {entities => '<>&'}) => $subscript ) );
                }
                $locations_html .= '<td width = "25%">';
                $locations_html .=
                  CXGN::Page::FormattingHelpers::info_table_html(@locations);
                $locations_html .= '</td>';
                $locations_html .= '<td align="center">';
                ####$map_factory = CXGN::Cview::MapFactory->new($dbh);
#######	my $map=$map_factory->create({map_version_id=>$map_version_id});
#######	my $map_version_id=$map->get_id();

                my $hilite_name = $marker_name;
                if ($subscript) {
                    $hilite_name .= $subscript;
                }
                my $chromosome = CXGN::Cview::ChrMarkerImage->new(
                     "", 240, 150, $dbh, $lg_name, $map, $hilite_name,
                     $c->get_conf("basepath"),  $c->get_conf('tempfiles_subdir')."/cview",
                 );
                my ( $image_path, $image_url ) =
                  $chromosome->get_image_filename();
                my $chr_link =
qq|<img src="$image_url" usemap="#map$count" border="0" alt="" />|;
                $chr_link .= $chromosome->get_image_map("map$count");
                $chr_link .= '<br />' . $map_name;
                $count++;
                $locations_html .= '<br />';
                $locations_html .= $chr_link;
                $locations_html .= '</td></tr></table>';


#if we have a pcr experiment that was used to map this marker to this location, make a section for this experiment's data
                if ( $pcr
		     and !grep { $_ == $pcr->pcr_experiment_id() }
		     @displayed_pcr )
		  {
                    $locations_html .=
		      '<table width="100%" cellspacing="0" cellpadding="0" border="0"><tr>';
                    my $pcr_bands    = $pcr->pcr_bands_hash_of_strings();

		    my %pcr_bands_by_name = ();
		    my $sth = $dbh->prepare("SELECT organism.species || ' ' ||  stock.name FROM public.stock JOIN public.organism USING(organism_id) WHERE stock_id=?");

		    foreach my $p (keys %$pcr_bands) { 

		      $sth->execute($p);
		      $pcr_bands_by_name{($sth->fetchrow_array)} = $pcr_bands->{$p};
		    }


                    my $digest_bands = $pcr->pcr_digest_bands_hash_of_strings();

		    my %pcr_digest_bands_by_name = ();
		    foreach my $p (keys %$digest_bands) { 
		      $sth->execute($p);
		      $pcr_digest_bands_by_name{($sth->fetchrow_array)} = $digest_bands->{$p};
		    }


                    my $pcr_bands_html =
                      CXGN::Page::FormattingHelpers::info_table_html(
								     __border => 0,
								     __sub    => 1,

								     %pcr_bands_by_name,
								    );
                    my $digest_bands_html =
                      CXGN::Page::FormattingHelpers::info_table_html(
								     __border => 0,
								     __sub    => 1,
								     %pcr_digest_bands_by_name,
								    );
                    my $mg = '';
                    if ( $pcr->mg_conc() ) {
		      $mg = $pcr->mg_conc() . 'mM';
                    }
                    my $temp = '';
                    if ( $pcr->temp() ) {
                        $temp = $pcr->temp() . '&deg;C';
                    }
                    $locations_html .= '<td>';
                    my $fwd = $pcr->fwd_primer()
                      || ('<span class="ghosted">' . SGN::I18N::translate($c->i18n, "marker.detail.pcr_unknown", "Unknown", undef, {entities => '<>&'}) . '</span>');
                    my $rev = $pcr->rev_primer()
                      || ('<span class="ghosted">' . SGN::I18N::translate($c->i18n, "marker.detail.pcr_unknown", "Unknown", undef, {entities => '<>&'}) . '</span>');
                    my $enz = $pcr->enzyme()  || SGN::I18N::translate($c->i18n, "marker.detail.pcr_unknown_enzyme", "unknown enzyme", undef, {entities => '<>&'}) ;
		    my $additional_enzymes = $pcr->additional_enzymes();
                    my $dcaps = $pcr->dcaps_primer();
                    $temp ||= ('<span class="ghosted">' . SGN::I18N::translate($c->i18n, "marker.detail.pcr_unknown", "Unknown", undef, {entities => '<>&'}) . '</span>');
                    $mg   ||= ('<span class="ghosted">' . SGN::I18N::translate($c->i18n, "marker.detail.pcr_unknown", "Unknown", undef, {entities => '<>&'}) . '</span>');
                    my $digest_title = SGN::I18N::translate($c->i18n, "marker.detail.digested_band_sizes", "Digested band sizes (using %{enzyme})", {enzyme => ("" . $enz)});

                    unless ($digest_bands_html) {
                        $digest_title      = '&nbsp;';
                        $digest_bands_html = '&nbsp;';
                    }

                    ### TODO ###
                    my ( $dcaps_left, $dcaps_right );

                    if ($dcaps) {
                      $dcaps_left  = SGN::I18N::translate($c->i18n, "marker.detail.dcaps_primer_direction", "dCAPS primer (5'-3')", undef, {entities => '<>&'});
                      $dcaps_right = "<span class=\"sequence\">$dcaps</span>";
                    }
                    ###########
                    my $pcr_seq = $pcr->get_sequences;

                    my ($aspe, $aspe_primers);
                    $aspe_primers = join ('<BR>' ,  @{ $pcr_seq->{ASPE_primer} }  ) if  $pcr_seq->{ASPE_primer}  ;
                    if ($aspe_primers) {
                      $aspe = SGN::I18N::translate($c->i18n, "marker.detail.aspe_primers_direction", "ASPE primers (5'-3')", undef, {entities => '<>&'});
                      $aspe_primers = "<span class=\"snp\">$aspe_primers</span>"
                    }
                    my ($snp, $snp_nuc);
                    $snp_nuc = join ('<BR>' ,  @{ $pcr_seq->{SNP} }  ) if  $pcr_seq->{SNP}  ;
                    if ($snp_nuc) {
                      $snp = SGN::I18N::translate($c->i18n, "marker.detail.snp_nucleotide", "SNP nucleotide", undef, {entities => '<>&'});
                      $snp_nuc = "<span class=\"snp\">$snp_nuc</span>"
                    }
                    my ($three_prime, $seq3);
                    $seq3 = join ('<BR>' ,  @{ $pcr_seq->{three_prime_flanking_region} }  ) if  $pcr_seq->{three_prime_flanking_region}  ;
                    if ($seq3) {
                      $three_prime = SGN::I18N::translate($c->i18n, "marker.detail.three_prime_flanking_region", "3' flanking region", undef, {entities => '<>&'});
                      $seq3 = "<span class=\"assay\">$seq3</span>"
                    }
                    my ($five_prime, $seq5);
                    $seq5 = join ('<BR>' ,  @{ $pcr_seq->{five_prime_flanking_region} }  ) if  $pcr_seq->{five_prime_flanking_region}  ;
                    if ($seq5) {
                      $five_prime = SGN::I18N::translate($c->i18n, "marker.detail.five_prime_flanking_region", "5' flanking region", undef, {entities => '<>&'});
                      $seq5 = "<span class=\"assay\">$seq5</span>"
                    }
                    my ($indel, $indel_seq);
                    $indel_seq = join ('<BR>' ,  @{ $pcr_seq->{indel} }  ) if  $pcr_seq->{indel}  ;
                    if ($indel_seq) {
                      $indel = SGN::I18N::translate($c->i18n, "marker.detail.indel", "Indel", undef, {entities => '<>&'});
                      $indel_seq = "<span class=\"indel\">$indel_seq</span>"
                    }
		    $locations_html .= '<br />';
                    $locations_html .=
                      CXGN::Page::FormattingHelpers::info_table_html(
                        '__title' =>
(SGN::I18N::translate($c->i18n, "marker.detail.pcr_data", "PCR data", undef, {entities => '<>&'}) . "&nbsp;&nbsp;&nbsp;<span class=\"tinytype\">" . SGN::I18N::translate($c->i18n, "marker.detail.pcr_data_exp_id", "Exp. ID", undef, {entities => '<>&'}) . " ")
                          . $pcr->pcr_experiment_id()
                          . "</span>",
                        SGN::I18N::translate($c->i18n, "marker.detail.forward_primer_direction", "Forward primer (5'-3')", undef, {entities => '<>&'}) =>
                          "<span class=\"sequence\">$fwd</span>",
                        SGN::I18N::translate($c->i18n, "marker.detail.reverse_primer_direction", "Reverse primer (5'-3')", undef, {entities => '<>&'}) =>
                          "<span class=\"sequence\">$rev</span>",
                        $dcaps_left                     => $dcaps_right,
                       SGN::I18N::translate($c->i18n, "marker.detail.accessions_product_sizes", "Accessions and product sizes", undef, {entities => '<>&'})  => $pcr_bands_html,
                        $digest_title                   => $digest_bands_html,
			SGN::I18N::translate($c->i18n, "marker.detail.enzymes", "Enzymes", undef, {entities => '<>&'})                       => $additional_enzymes,
                        SGN::I18N::translate($c->i18n, "marker.detail.approximate_temperature", "Approximate temperature", undef, {entities => '<>&'})       => $temp,
                        SGN::I18N::translate($c->i18n, "marker.detail.mg_concentration", "Mg<sup>+2</sup> concentration") => $mg,
                        '__multicol'                    => 3,
                        '__tableattrs'                  => "width=\"100%\"",
                      ) if ($protocol ne 'SNP');
                    my ($snpdb_format, $snpdb);
                    if ($snp_nuc) {
                      $snpdb = SGN::I18N::translate($c->i18n, "marker.detail.snpdb_format", "SNPdb format", undef, {entities => '<>&'});
                      my @fives = @{ $pcr_seq->{five_prime_flanking_region} } ;
                      my @threes = @{ $pcr_seq->{three_prime_flanking_region} } ;
                      my @snps  =  @{ $pcr_seq->{SNP} };
                      for my $i ( 0 .. (scalar( @snps ) -1 ) ) {
                        my $snp_string =  $snps[$i] ;
                        my $formatted = "[" . substr($snp_string, 0, 1) . "/" . substr($snp_string, -1) ."]";
                        my $five_p = $fives[$i];
                        my $three_p = $threes[$i];
                        $snpdb_format .= $five_p . $formatted ."<BR />" .  $three_p . "<BR />";
                      }
                    }
                    $locations_html .=
                      CXGN::Page::FormattingHelpers::info_table_html(
                        '__title' =>
"Assay data&nbsp;&nbsp;<span class=\"tinytype\"></span>",
                       $five_prime       => $seq5,
                       $three_prime       => $seq3,
                       $snpdb => $snpdb_format,
                       $aspe  => $aspe_primers,
                       $snp   => $snp_nuc,
                       $indel => $indel_seq,
                       '__multicol'    => 2,
                      '__tableattrs'   => "width=\"100%\"",
                      ) if $aspe || $indel || ($protocol eq "SNP");
                    $locations_html .= '</td></tr></table>';
                    push( @displayed_pcr, $pcr->pcr_experiment_id() )
                  }
            }
        }
    }
}

</%perl>

<&| /page/info_section.mas, anchor_title => 'Mapped locations', title=>HTML::Entities::encode_entities($c->i18n->p("marker.detail.mapped_locations", 'Mapped locations')), collapsible=>1, collapsed=>0 &>
  <% $locations_html %>
</&>

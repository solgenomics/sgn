<%args>
    $markers => undef
</%args>

<%init>
use SGN::I18N ();

    if ( !$markers ) {
        print ("<p><strong>" . SGN::I18N::translate($c->i18n, "marker.detail.error_label", "ERROR:", undef, {entities => '<>&'}) . " </strong>" . SGN::I18N::translate($c->i18n, "marker.detail.error_missing_variant_markers", "Missing variant markers!", undef, {entities => '<>&'}) . "</p>");
    }
</%init>

<table class="table table-striped">
    <thead>
        <tr>
            <th><% $c->i18n->p("genotype.marker.marker", "Marker") |h %></th>
            <th><% $c->i18n->p("global.search_wizard.protocol", "Protocol") |h %></th>
            <th><% $c->i18n->p("cross.species", "Species") |h %></th>
            <th><% $c->i18n->p("marker.detail.reference", "Reference") |h %></th>
            <th><% $c->i18n->p("global.search_wizard.chromosome", "Chromosome") |h %></th>
            <th><% $c->i18n->p("marker.detail.position", "Position") |h %></th>
            <th>Ref</th>
            <th>Alt</th>
        </tr>
    </thead>
    <tbody>
% foreach my $marker (@$markers) {
        <tr>
            <td><strong><% $marker->{'marker_name'} %></strong></td>
            <td>
                <a href="/breeders_toolbox/protocol/<% $marker->{'nd_protocol_id'} %>">
                    <% $marker->{'nd_protocol_name'} %>
                </a>
            </td>
            <td><% $marker->{'species_name'} %></td>
            <td><% $marker->{'reference_genome_name'} %></td>
            <td><% $marker->{'chrom'} %></td>
            <td><% $marker->{'pos'} %></td>
            <td><% $marker->{'ref'} %></td>
            <td><% $marker->{'alt'} %></td>
        </tr>    
% }
    </tbody>
  </table>
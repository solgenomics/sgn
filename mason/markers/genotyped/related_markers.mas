<%args>
    $variant_name => undef
    $schema => undef
</%args>

<%init>
    if ( !$variant_name ) {
        print "<p><strong>ERROR: </strong>Missing variant name!</p>";
    }

    my $msearch = CXGN::Marker::SearchMatView->new(bcs_schema => $schema);
    my $related_variants = $msearch->related_variants($variant_name);
    my $related_mapped_markers = $msearch->related_mapped_markers($variant_name);
    my $related_count = scalar(keys %$related_variants) + scalar(@$related_mapped_markers);
</%init>

<&| /page/info_section.mas, title=>'Related Markers', collapsible=>1, collapsed=>$related_count < 1 &>

<p><strong>Related Genotyped Markers:</strong> These genotyped markers share either the same <em>name</em> as one or more markers at this variant or 
are located at the same <em>position</em> but have different allele values</p>

<div id="related-variants">
% if ( scalar(keys %$related_variants) > 0 ) {
    <table class='table table-striped'>
        <thead>
            <tr><th>Marker</th><th>Protocol</th><th>Species</th><th>Reference</th><th>Chromosome</th><th>Position</th><th>Ref</th><th>Alt</th></tr>
        </thead>
        <tbody>
% foreach my $key (keys %$related_variants) {
% foreach my $marker (@{$related_variants->{$key}}) {
            <tr>
                <td><strong><a href='/variant/<% $variant_name %>/details'><% $marker->{marker_name} %></a></strong></td>
                <td><a href='/breeders_toolbox/protocol/<% $m->{nd_protocol_id} %>'><% $marker->{nd_protocol_name} %></a></td>
                <td><% $marker->{species_name} %></td>
                <td><% $marker->{reference_genome_name} %></td>
                <td><% $marker->{chrom} %></td>
                <td><% $marker->{pos} %></td>
                <td><% $marker->{ref} %></td>
                <td><% $marker->{alt} %></td>
            </tr>
% }
% }
        </tbody>
    </table>
% } else {
    <em>No related genotyed markers found</em><br /><br />
% }
</div>

<p><strong>Related Mapped Markers:</strong> These mapped markers have the same name as a marker at this variant</p>
<div id="related-mapped-markers">
% if (scalar @$related_mapped_markers > 0 ) {
    <table class='table table-striped'>
        <thead>
            <tr><th>Marker</th><th>Protocol</th><th>Species</th><th>Map</th><th>Chromosome</th><th>Position</th></tr>
        </thead>
        <tbody>
% foreach my $mm (@$related_mapped_markers) {
            <tr>
                <td><strong><a href='/search/markers/markerinfo.pl?marker_id=<% $mm->{marker_id} %>'><% $mm->{marker_name} %></a></strong></td>
                <td><% $mm->{protocol} %></td>
                <td><% $mm->{species_name} %></td>
                <td><% $mm->{map_name} %></td>
                <td><% $mm->{lg_name} %></td>
                <td><% $mm->{position} %> <% $mm->{map_units} %></td>
            </tr>
% }
        </tbody>
    </table>
% } else {
    <em>No related mapped markers found</em><br />
% }
</div>

</&>
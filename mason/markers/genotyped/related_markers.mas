<%args>
    $variant_name => undef
</%args>

<%init>
use SGN::I18N ();

    if ( !$variant_name ) {
        print ("<p><strong>" . SGN::I18N::translate($c->i18n, "marker.detail.error_label", "ERROR:", undef, {entities => '<>&'}) . " </strong>" . SGN::I18N::translate($c->i18n, "marker.detail.error_missing_variant_name", "Missing variant name!", undef, {entities => '<>&'}) . "</p>");
    }
</%init>

<p><strong><% $c->i18n->p("marker.detail.related_genotyped_markers", "Related Genotyped Markers:") |h %></strong> <% $c->i18n->p("marker.detail.these_genotyped_markers_share_either_the_same", "These genotyped markers share either the same") |h %> <em><% $c->i18n->p("seedlot_maintenance_table.ui.property_name", "name") |h %></em> <% $c->i18n->p("marker.detail.as_one_or_more_markers_at_this_variant_or_are", "as one or more markers at this variant or \nare located at the same") |h %> <em><% $c->i18n->p("marker.detail.position_5a4524", "position") |h %></em> <% $c->i18n->p("marker.detail.but_have_different_allele_values", "but have different allele values") |h %></p>
<div id="related-variants">
    <em><% $c->i18n->p("global.dataset_publish.loading", "Loading...") |h %></em><br /><br />
</div>

<p><strong><% $c->i18n->p("marker.detail.related_mapped_markers", "Related Mapped Markers:") |h %></strong> <% $c->i18n->p("marker.detail.these_mapped_markers_have_the_same_name_as_a_marker", "These mapped markers have the same name as a marker at this variant") |h %></p>
<div id="related-mapped-markers">
    <em><% $c->i18n->p("global.dataset_publish.loading", "Loading...") |h %></em><br />
</div>


<script type="text/javascript">
jQuery(document).ready(function() {
    getRelatedVariants();
    getRelatedMappedMarkers();
});

/**
 * Get the variants / genotyped markers related to the current variant
 */
function getRelatedVariants() {
    jQuery.ajax({
        type: 'GET',
        url: '/ajax/markers/genotyped/related_variants',
        data: { variant_name: "<% $variant_name %>" },
        success: function(response) {
            let html = "";
            if ( response && response.related_variants && !jQuery.isEmptyObject(response.related_variants) ) {
                html += "<table class='table table-striped'>";
                html += ("<thead><tr><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.marker.marker", "Marker") : "Marker")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search_wizard.protocol", "Protocol") : "Protocol")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.species", "Species") : "Species")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("marker.detail.reference", "Reference") : "Reference")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search_wizard.chromosome", "Chromosome") : "Chromosome")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("marker.detail.position", "Position") : "Position")).html() + "</th><th>Ref</th><th>Alt</th></tr></thead>");
                html += "<tbody>";
                for ( let variant_name in response.related_variants ) {
                    if ( response.related_variants.hasOwnProperty(variant_name) ) {
                        let ms = response.related_variants[variant_name];
                        for ( let i = 0; i < ms.length; i++ ) {
                            html += "<tr>";
                            html += "<td><strong><a href='/variant/" + variant_name + "/details'>" + ms[i].marker_name + "</a></strong></td>";
                            html += "<td><a href='/breeders_toolbox/protocol/" + ms[i].nd_protocol_id + "'>" + ms[i].nd_protocol_name + "</a></td>";
                            html += "<td>" + ms[i].species_name + "</td><td>" + ms[i].reference_genome_name + "</td>";
                            html += "<td>" + ms[i].chrom + "</td><td>" + ms[i].pos + "</td><td>" + ms[i].ref + "</td><td>" + ms[i].alt + "</td>";
                            html += "</tr>";
                        }
                    }
                }
                html += "</tbody>";
                html += "</table>";
            }
            else {
                html += ("<em>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("marker.detail.no_related_genotyed_markers_found", "No related genotyed markers found") : "No related genotyed markers found")).html() + "</em><br /><br />");
            }
            jQuery("#related-variants").html(html);
        },
        error: function(response) {
            console.log("Could not get related variants");
        }
    });
}

/**
 * Get the mapped markers related to the current variant
 */
function getRelatedMappedMarkers() {
    jQuery.ajax({
        type: 'GET',
        url: '/ajax/markers/genotyped/related_mapped_markers',
        data: { variant_name: "<% $variant_name %>" },
        success: function(response) {
            let html = "";
            if ( response && response.related_mapped_markers && response.related_mapped_markers.length > 0 ) {
                html += "<table class='table table-striped'>";
                html += ("<thead><tr><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.marker.marker", "Marker") : "Marker")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search_wizard.protocol", "Protocol") : "Protocol")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.species", "Species") : "Species")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("marker.detail.map", "Map") : "Map")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search_wizard.chromosome", "Chromosome") : "Chromosome")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("marker.detail.position", "Position") : "Position")).html() + "</th></tr></thead>");
                html += "<tbody>";
                let ms = response.related_mapped_markers;
                for ( let i = 0; i < ms.length; i++ ) {
                    html += "<tr>";
                    html += "<td><strong><a href='/search/markers/markerinfo.pl?marker_id=" + ms[i].marker_id + "'>" + ms[i].marker_name + "</a></strong></td>";
                    html += "<td>" + ms[i].protocol + "</td><td>" + ms[i].species_name + "</td><td>" + ms[i].map_name + "</td>";
                    html += "<td>" + ms[i].lg_name + "</td><td>" + ms[i].position + " " + ms[i].map_units + "</td>";
                    html += "</tr>";
                }
            }
            else {
                html += ("<em>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("marker.detail.no_related_mapped_markers_found", "No related mapped markers found") : "No related mapped markers found")).html() + "</em><br />");
            }
            jQuery("#related-mapped-markers").html(html);
        },
        error: function(response) {
            console.log("Could not get related mapped markers");
        }
    });
}
</script>
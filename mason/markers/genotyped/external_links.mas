<%doc>
    Call this page when using an arrayref of marker hashes, where each hash has a key of marker_name
</%doc>

<%args>
    $markers => undef
    $schema => undef
</%args>

<%init>
    my @marker_names = ();
    foreach my $marker (@$markers) {
        push(@marker_names, $marker->{marker_name});
    }
    my @unique_marker_names = do { my %seen; grep { !$seen{$_}++ } @marker_names };

    my $propinfo = CXGN::Genotype::Protocol::snp_refs($schema, \@unique_marker_names);

    my @metadata_references = ();
    foreach my $marker (@$markers) {
        my $protocol_id = $marker->{nd_protocol_id};
        my $marker_name = $marker->{marker_name};

        my $protocol = CXGN::Genotype::Protocol->new({
            bcs_schema => $schema,
            nd_protocol_id => $protocol_id
        });
        my $marker_metadata = $protocol->get_marker_metadata($marker_name);

        foreach my $mn (keys %$marker_metadata) {
            if ( exists $marker_metadata->{$mn}->{references} ) {
                foreach my $ref (@{$marker_metadata->{$mn}->{references}}) {
                    $ref->{marker_name} = $mn;
                    push @metadata_references, $ref;
                }
            }
        }
    }

    my $link_count = scalar(@$propinfo) + scalar(@metadata_references);
</%init>

<&| /page/info_section.mas, title=>'External Links', collapsible=>1, collapsed=>$link_count < 1 &>

<style>
    #external-links-list {
        list-style-type: none;
    }
</style>


<div id="external-links">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Marker</th>
                <th>External Link</th>
            </tr>
        </thead>
        <tbody id="external-links-table">
% if ( $link_count > 0 ) {

% foreach my $prop (@$propinfo) {
            <tr>
                <td><% $prop->{marker_name} %></td>
                <td>
                    <a href="<% $prop->{url} %><% $prop->{xref_name} %>" target="_new">
                        <% $prop->{type_name} %>:<% $prop->{xref_name} %>
                    </a>
                </td>
            </tr>
% }

% foreach my $ref ( @metadata_references ) {
        <tr>
            <td><% $ref->{'marker_name'} %></td>
            <td>
                <a href='<% $ref->{url} %>' target='_new'>
                    <% $ref->{db_name} %>:<% $ref->{dbxref_accession} %>
% if ( defined $ref->{cvterm_name} ) {
                    <% ' (' . $ref->{cvterm_name} . ')' %>
% }
                </a>
            </td>
        </tr>
% }

% } else {
    <tr><td colspan=2><p><em>No external links found</em></p></td></tr>
% }
        </tbody>
    </table>
</div>

</&>
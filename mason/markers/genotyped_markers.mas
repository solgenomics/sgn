<%once>
use HTML::Entities ();
</%once><%doc>

=head1 NAME

/markers/genotyped_markers.mas - a Mason component displaying genotyped markers that share the same marker name

=head1 DESCRIPTION

parameters 

=over 5

=item *

$marker_id - the id of the mapped marker

=back

=head1 AUTHOR

David Waring <djw64@cornell.edu>

=cut

</%doc>

<%args>
    $marker_id => undef
</%args>

<%init>
use SGN::I18N ();

    if ( !defined $marker_id ) {
        print ("<p><strong>" . SGN::I18N::translate($c->i18n, "marker.detail.error_label", "ERROR:", undef, {entities => '<>&'}) . "</strong> " . SGN::I18N::translate($c->i18n, "marker.detail.error_marker_id_undefined", "Marker id is not defined!", undef, {entities => '<>&'}) . "</p>");
    }
</%init>

<&| /page/info_section.mas, anchor_title => 'Related Markers', title=>HTML::Entities::encode_entities($c->i18n->p("marker.detail.related_markers", 'Related Markers')), collapsible=>1, collapsed=>0 &>
    <p><strong><% $c->i18n->p("marker.detail.related_genotyped_markers", "Related Genotyped Markers:") |h %></strong> <% $c->i18n->p("marker.detail.these_markers_have_been_genotyped_and_share_a_name_with", "These markers have been genotyped and share a name with this marker") |h %></p>
    <div id="related-genotyped-markers">
        <em><% $c->i18n->p("global.dataset_publish.loading", "Loading...") |h %></em>
    </div>
</&>


<script type="text/javascript">
jQuery(document).ready(function() {
    getRelatedGenotypeMarkers();
});


/**
 * Get the genotyped markers related to the current mapped markers
 */
function getRelatedGenotypeMarkers() {
    jQuery.ajax({
        type: 'GET',
        url: '/ajax/markers/mapped/related_variants',
        data: { marker_id: "<% $marker_id %>" },
        success: function(response) {
            let html = "";
            if ( response && response.related_variants ) {
                html += "<table class='table table-striped'>";
                html += ("<thead><tr><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.marker.marker", "Marker") : "Marker")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search_wizard.protocol", "Protocol") : "Protocol")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.species", "Species") : "Species")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("marker.detail.reference", "Reference") : "Reference")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search_wizard.chromosome", "Chromosome") : "Chromosome")).html() + "</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("marker.detail.position", "Position") : "Position")).html() + "</th><th>Ref</th><th>Alt</th></tr></thead>");
                html += "<tbody>";
                for ( let variant_name in response.related_variants ) {
                    if ( response.related_variants.hasOwnProperty(variant_name) ) {
                        let ms = response.related_variants[variant_name];
                        for ( let i = 0; i < ms.length; i++ ) {
                            html += "<tr>";
                            html += "<td><strong><a href='/variant/" + variant_name + "/details'>" + ms[i].marker_name + "</a></strong></td>";
                            html += "<td><a href='/breeders_toolbox/protocol/" + ms[i].nd_protocol_id + "'>" + ms[i].nd_protocol_name + "</a></td>";
                            html += "<td>" + ms[i].species_name + "</td><td>" + ms[i].reference_genome_name + "</td>";
                            html += "<td>" + ms[i].chrom + "</td><td>" + ms[i].pos + "</td><td>" + ms[i].ref + "</td><td>" + ms[i].alt + "</td>";
                            html += "</tr>";
                        }
                    }
                }
                html += "</tbody>";
                html += "</table>";
            }
            else {
                html += ("<em>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("marker.detail.no_related_genotyped_markers_found", "No related genotyped markers found") : "No related genotyped markers found")).html() + "</em>");
            }
            jQuery("#related-genotyped-markers").html(html);
        },
        error: function(response) {
            console.log("Could not get related genotyped markers");
        }
    });
}
</script>

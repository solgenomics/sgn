<%init>
use Path::Class;
</%init>
% my $message = $c->i18n->p('global.logout_message.success', 'You have successfully logged out. Thanks for using %{project_name}!', {project_name => $c->config->{project_name}});
<!-- <div class="devbar"> -->
<div class="devbar_tmp">
   <span style="color: #922; font-weight: bold"> </span>
   <!-- system message active -->
   <% $message |h %>
</div>

  <style>
    .devbar_tmp {
      width: 100%;
      padding: 5px;
      margin: 0px 0 0px 0px;
      text-align: center;
      background-color: #eef;
      border-bottom: 2px solid #905;
    }
  </style>

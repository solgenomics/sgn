
<%args>

$schema
$static_content_path
$username
$role
$first_name
$last_name
$sp_person_id
$timestamp
$phenotype_files => undef
$breeding_programs => undef
$locations => undef
$preferred_species => undef
$editable_stock_props => {}

</%args>

<%init>
use HTML::Entities ();
</%init>

<div style="text-align: center">

<h3><% $c->i18n->p('global.index_logged_in_user.welcome', 'Welcome back %{first_name}!', {first_name => $first_name}) |h %></h3>

<% $c->i18n->p('global.index_logged_in_user.status', 'Your status is currently "%{role}".', {role => $role}) |h %>

<!-- table id="manage_user_role_table" class="table table-bordered" width="100%" >
<thead>
<tr><th>User</th><th>Your currently assigned roles</th></tr>

</thead>
<tbody>
</tbody>
</table -->

% if ($role ne "user") {

<&|  /page/info_section.mas, title => "<b><font size=\"3\">" . HTML::Entities::encode_entities($c->i18n->p('global.index_logged_in_user.continue_title', 'Continue where you left off')) . "</font></b>", collapsible => 1, collapsed => 1 &>

<h4><% $c->i18n->p('global.index_logged_in_user.continue_heading', 'Continue where you left off:') |h %></h4>
<% $c->i18n->p('global.index_logged_in_user.interval', 'Interval:') |h %>&nbsp;

<select id="interval">
    <option value="day"><% $c->i18n->p('global.index_logged_in_user.day', 'day') |h %></option>
    <option value="week"><% $c->i18n->p('global.index_logged_in_user.week', 'week') |h %></option>
    <option value="month"><% $c->i18n->p('global.index_logged_in_user.month', 'month') |h %></option>
    <option value="year"><% $c->i18n->p('global.index_logged_in_user.year', 'year') |h %></option>
</select>

<br /><br />
<h4><% $c->i18n->p('global.index_logged_in_user.created_trials', '10 most recently created trials:') |h %></h4>

<table id="recently_created_trial_table" style="width:100%" >
<thead>
<tr><th><% $c->i18n->p('global.index_logged_in_user.trial', 'Trial') |h %></th><th><% $c->i18n->p('global.index_logged_in_user.trial_type', 'Trial Type') |h %></th><th><% $c->i18n->p('global.index_logged_in_user.breeding_program', 'Breeding Program') |h %></th><th><% $c->i18n->p('global.index_logged_in_user.create_date', 'Create date') |h %></th></tr>
</thead>
</table>

<br /><br />
<h4><% $c->i18n->p('global.index_logged_in_user.modified_trials', '10 most recently modified trials:') |h %></h4>

<table id="recently_modified_trial_table" style="width:100%">
<thead>
<tr><th><% $c->i18n->p('global.index_logged_in_user.trial', 'Trial') |h %></th><th><% $c->i18n->p('global.index_logged_in_user.trial_type', 'Trial Type') |h %></th><th><% $c->i18n->p('global.index_logged_in_user.breeding_program', 'Breeding Program') |h %></th><th><% $c->i18n->p('global.index_logged_in_user.last_phenotype_added', 'Last phenotype added') |h %></th></tr>
</thead>
</table>

<br /><br />
<h4><% $c->i18n->p('global.index_logged_in_user.added_accessions', '10 most recently added accessions:') |h %></h4>

<table id="recently_added_accessions_table" style="width:100%">
<thead>
<tr><th><% $c->i18n->p('global.index_logged_in_user.accession', 'Accession') |h %></th><th><% $c->i18n->p('global.index_logged_in_user.create_date', 'Create date') |h %></th></tr>
</thead>
</table>



</&>

%} # -- if ($role ne...

</div>

<script>
    var interval = jQuery('#interval').val()	

    update_tables(interval);

    jQuery('#interval').change( function() {
        interval = jQuery('#interval').val();
	update_tables(interval);
	});

    function update_tables(interval) { 
        jQuery('#recently_created_trial_table').DataTable({
	    'destroy': true,
    	    'columns' : [{ width: '300px' }, { width: '200px'}, { width: '100px'}, null],	
            'ajax':'/ajax/breeders/recent_trials/'+interval,
            'order': [[ 3, 'desc']],
	    'paging': false,
	    'searching': false,
	    'bInfo': false
        });

        jQuery('#recently_modified_trial_table').DataTable({
	    'destroy' : true,
            'columns': [{ width: '300px' }, { width: '200px'}, { width: '100px'}, null],
            'ajax':'/ajax/breeders/recently_modified_trials/'+interval,
    	    'paging': false,
	    'searching': false,
	    'bInfo' : false
        });

        jQuery('#recently_added_accessions_table').DataTable({
	    'destroy' : true,
            'ajax':'/ajax/breeders/recently_added_accessions/'+interval,
    	    'paging': false,
	    'searching' : false,
	    'bInfo': false,
    	    'columns': [{ width: '680px'}, null ],	
        });

//   jQuery('#manage_user_role_table').DataTable( {
//       ajax : '/ajax/roles/list/<% $sp_person_id %>',
//       searching: false,
//       paging: false,
//   });

}

</script>


<& /index.mas, schema => $schema, timestamp => $timestamp, static_content_path=> $static_content_path, phenotype_files => $phenotype_files, breeding_programs => $breeding_programs, locations => $locations, preferred_species => $preferred_species, editable_stock_props => $editable_stock_props &>

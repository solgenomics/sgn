<%args>
$trial_id
$trial_name
$breeding_program_name
$logged_in_name
$date

</%args>

<div class="modal fade" id="add_propagation_group_id_dialog" name="add_propagation_group_id_dialog" tabindex="-1" role="dialog" aria-labelledby="addPropagationGroupIdDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="addPropagationGroupIdDialog"><% $c->i18n->p("seedlot.add_new_propagation_group_id", "Add New Propagation Group ID") |h %></h4>
            </div>
            <div class="modal-body" id = "propagation_group_id_dialog">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" id="add_new_propagation_group_id_form" name="add_new_propagation_group_id_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlot.propagation_project", "Propagation Project:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" name="propagation_project" id="propagation_project" disabled value="<% $trial_name %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlot.propagation_group_identifier.7f632c8", "Propagation Group Identifier:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" type="text" id="new_propagation_group_identifier" name="new_propagation_group_identifier" placeholder="<% $c->i18n->p("seedlot.must_be_unique_in_the_database", "Must be unique in the database") |h %>">
                            </div>
                        </div>
                        <div class="form-group" id = "get_propagation_accession_name">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("trial.fieldmap_js.tooltip.accession_name", "Accession Name:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" type="text" id="propagation_accession_name" name="propagation_accession_name" placeholder="<% $c->i18n->p("seedlot.must_be_in_the_database", "Must be in the database") |h %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlots.ui.material_type.21ab872", "Material Type:") |h %> </label>
                            <div class="col-sm-8">
                                <select class="form-control" id="propagation_material_type">
                                    <option value=""><% $c->i18n->p("seedlot.please_select_a_type", "Please select a type") |h %></option>
                                    <option value="budwood"><% $c->i18n->p("seedlot.budwood", "budwood") |h %></option>
                                    <option value="stem"><% $c->i18n->p("seedlot.stem", "stem") |h %></option>
                                    <option value="shoot"><% $c->i18n->p("seedlot.shoot", "shoot") |h %></option>
                                    <option value="root"><% $c->i18n->p("seedlots.select.material.root", "root") |h %></option>
                                    <option value="corm"><% $c->i18n->p("seedlot.corm", "corm") |h %></option>
                                    <option value="plant"><% $c->i18n->p("seedlots.select.material.plant", "plant") |h %></option>
                                    <option value="seed"><% $c->i18n->p("seedlots.select.material.seed", "seed") |h %></option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlot.source_type.e05cc87", "Source Type:") |h %> </label>
                            <div class="col-sm-8">
                                <select class="form-control" id="propagation_material_source_type">
                                    <option value=""><% $c->i18n->p("seedlot.please_select_a_type_optional", "Please select a type (optional)") |h %></option>
                                    <option value="plot"><% $c->i18n->p("stock_search.type.plot", "plot") |h %></option>
                                    <option value="subplot"><% $c->i18n->p("seedlot.subplot", "subplot") |h %></option>
                                    <option value="plant"><% $c->i18n->p("seedlots.select.material.plant", "plant") |h %></option>
                                    <option value="seedlot"><% $c->i18n->p("stock_search.type.seedlot", "seedlot") |h %></option>
                                    <option value="new"><% $c->i18n->p("seedlot.new", "new") |h %></option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group" id = "get_propagation_source_name">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlot.source_name", "Source Name:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" type="text" id="propagation_source_name" name="propagation_source_name" placeholder="<% $c->i18n->p("seedlot.optional_source_name_must_be_in_the_database", "optional (source name must be in the database)") |h %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlot.sub_location.dd235cd", "Sub-Location:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" type="text" id="propagation_sub_location" name="propagation_sub_location" placeholder="<% $c->i18n->p("seedlot.optional", "optional") |h %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlot.date_yyyy_mm_dd", "Date (YYYY-MM-DD):") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" name="propagation_date" id="propagation_date" value="<%$date%>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlot.purpose.fa07902", "Purpose:") |h %> </label>
                            <div class="col-sm-8">
                                <select class="form-control" id="propagation_purpose">
                                    <option value=""><% $c->i18n->p("seedlot.please_select_optional", "Please select (optional)") |h %></option>
                                    <option value="replicate"><% $c->i18n->p("seedlot.replicate", "replicate") |h %></option>
                                    <option value="backup"><% $c->i18n->p("seedlot.backup", "backup") |h %></option>
                                    <option value="replacement"><% $c->i18n->p("seedlot.replacement", "replacement") |h %></option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("global.dataset_publish.description", "Description:") |h %></label>
                            <div class="col-sm-8">
                                <textarea class="form-control" id="propagation_description" name="propagation_description" ></textarea>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlot_maintenance_table.ui.operator", "Operator:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" type="text" id="propagation_operator" name="propagation_operator" value="<%$logged_in_name%>" >
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="reset" id="close_add_propagation_group_id_dialog" name="close_add_propagation_group_id_dialog" class="btn btn-default" ><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                    <button id="submit_new_propagation_group_id" type="button" class="btn btn-primary" ><% $c->i18n->p("global.search_wizard.add", "Add") |h %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="add_propagation_group_id_saved_dialog_message" name="add_propagation_group_id_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="addPropagationGroupIdSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addPropagationGroupIdSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("seedlot.the_propagation_group_identifier_was_saved_successfully", "The propagation group identifier was saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_propagation_group_id_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>
jQuery(document).ready(function(){

    jQuery('#submit_new_propagation_group_id').click( function() {
        const propagation_group_identifier = jQuery('#new_propagation_group_identifier').val();
        const purpose = jQuery('#propagation_purpose').val();
        const accession_name = jQuery('#propagation_accession_name').val();
        const material_type = jQuery('#propagation_material_type').val();
        const material_source_type = jQuery('#propagation_material_source_type').val();
        const source_name = jQuery('#propagation_source_name').val();
        const sub_location = jQuery('#propagation_sub_location').val();
        const date = jQuery('#propagation_date').val();
        const description = jQuery('#propagation_description').val();
        const operator_name = jQuery('#propagation_operator').val();
        const breeding_program_name =  "<%$breeding_program_name%>";
        const propagation_project_id = "<%$trial_id%>";

        if (propagation_group_identifier == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.please_provide_a_propagation_group_identifier", "Please provide a propagation group identifier") : "Please provide a propagation group identifier"));
            return;
        }
        if (accession_name == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.please_provide_accession_name", "Please provide accession name") : "Please provide accession name"));
            return;
        }
        if (material_type == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.please_provide_material_type", "Please provide material type") : "Please provide material type"));
            return;
        }
        if (date == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.please_provide_date", "Please provide date") : "Please provide date"));
            return;
        }
        if (description == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.soil_upload.description_required", "Please provide description") : "Please provide description"));
            return;
        }
        if (operator_name == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.please_provide_operator_name", "Please provide operator name") : "Please provide operator name"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/propagation/add_propagation_group_identifier',
            dataType: "json",
            type: 'POST',
            data : {
                'propagation_project_id': propagation_project_id,
                'breeding_program_name': breeding_program_name,
                'propagation_group_identifier': propagation_group_identifier,
                'purpose': purpose,
                'accession_name': accession_name,
                'material_type': material_type,
                'material_source_type': material_source_type,
                'source_name': source_name,
                'sub_location': sub_location,
                'date': date,
                'description': description,
                'operator_name': operator_name
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#add_propagation_group_id_dialog').modal('hide');
                    jQuery('#add_propagation_group_id_saved_dialog_message').modal("show");
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.an_error_occurred_adding_propagation_group_identifier", "An error occurred adding propagation group identifier") : 'An error occurred adding propagation group identifier'));
            }
        });
    });


    jQuery("#close_add_propagation_group_id_dialog").click(function() {
        jQuery("#add_propagation_group_id_dialog").modal('hide');
    });


    jQuery("#dismiss_propagation_group_id_saved_dialog").click(function() {
        jQuery("#add_propagation_group_id_saved_dialog_message").modal('hide');
        location.reload();
    });


});

</script>

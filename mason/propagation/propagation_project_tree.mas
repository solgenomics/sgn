<%args>
$user_id => undef
@programs => ()
@locations => ()
@roles => ()
</%args>

<%perl>
    use HTML::Entities ();
    # Catalogs contain plain prose; only the original component owns markup.
    my $propagation_help_html = sub {
        my ($message, $slots, $fallback) = @_;
        my %present;
        $present{$1}++ while $message =~ /%\{([A-Za-z_][A-Za-z0-9_]*)\}/g;
        if ((grep { !exists $slots->{$_} } keys %present)
                || (grep { !exists $present{$_} } keys %$slots)) {
            $message = $fallback;
        }
        my $html = '';
        for my $piece (split(/(%\{[A-Za-z_][A-Za-z0-9_]*\})/, $message, -1)) {
            if ($piece =~ /\A%\{([A-Za-z_][A-Za-z0-9_]*)\}\z/ && exists $slots->{$1}) {
                $html .= $slots->{$1};
            } else {
                $html .= HTML::Entities::encode_entities($piece);
            }
        }
        return $html;
    };
    my $propagation_details_help = $propagation_help_html->(
        $c->i18n->p('propagation_landing.ui.open_details', 'Double click%{line_break}propagation project (%{project_icon}) or folder (%{folder_icon})%{line_break}to view detail page.', {line_break => '%{line_break}', project_icon => '%{project_icon}', folder_icon => '%{folder_icon}'}),
        {line_break => '<br />', project_icon => '&nbsp;<span class="glyphicon glyphicon-tree-conifer text-success"></span>&nbsp;', folder_icon => '&nbsp;<span class="glyphicon glyphicon-folder-open text-danger"></span>&nbsp;'},
        'Double click%{line_break}propagation project (%{project_icon}) or folder (%{folder_icon})%{line_break}to view detail page.'
    );
    my $propagation_programs_help = $propagation_help_html->(
        $c->i18n->p('propagation_landing.ui.programs_help', 'Breeding programs (%{program_icon})', {program_icon => '%{program_icon}'}),
        {program_icon => '&nbsp;<span class="glyphicon glyphicon-briefcase text-info"></span>&nbsp;'},
        'Breeding programs (%{program_icon})'
    );
</%perl>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'jstree.dist.jstree', 'CXGN.TrialTreeFolders'] &>

<& /util/import_css.mas, paths => ['/static/documents/inc/jstree_theme/jstree-bstheme-min.css'] &>

<& /propagation/add_propagation_project.mas, user_id=>$user_id, programs=>\@programs, locations=>\@locations, roles=>\@roles &>

<& /breeders_toolbox/folder/folder_set.mas, project_type=>'propagation_project' &>
<& /breeders_toolbox/folder/folder_new.mas, project_type=>'propagation_project' &>
<& /breeders_toolbox/folder/folder_move.mas, project_type=>'propagation_project' &>
<& /breeders_toolbox/folder/folders_edit.mas, folder_tree_type => 'Propagation', folder_tree_identifier => 'propagation_projects_list', folder_tree_refresh_name => 'refresh_propagation_project_jstree_html' &>

<table class="table table-bordered">
    <thead>
        <tr>
            <th><% $c->i18n->p('propagation_landing.ui.information', 'Information') |h %></th>
            <th><% $c->i18n->p('propagation_landing.ui.tree_heading', 'Breeding Programs -- Folders -- Propagation Projects') |h %>&nbsp;&nbsp;&nbsp;&nbsp;<button class="btn btn-sm btn-default" id="refresh_propagation_project_jstree_html_trialtree_button" name="refresh_propagation_project_jstree_html"><% $c->i18n->p('propagation_landing.ui.refresh', 'Refresh') |h %></button></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                <h4><% $c->i18n->p('propagation_landing.ui.search', 'Search') |h %></h4>
                <input type="text" class="form-control input-sm" id="propagation_tree_search" placeholder="<% $c->i18n->p('propagation_landing.ui.search', 'Search') |h %>" />
                <hr>

                <h5><i><% $propagation_details_help %></i></h5>
                <h5><i><% $propagation_programs_help %></i></h5>
                <hr>
                <h4><% $c->i18n->p('propagation_landing.ui.folders', 'Folders') |h %></h4>
                <button class="btn btn-sm btn-default" id="new_folder_dialog_link"><% $c->i18n->p('propagation_landing.ui.new_folder', 'Create new folder') |h %></button><br/><br/>
                <button class="btn btn-sm btn-default" id="open_folder_dialog_link"><% $c->i18n->p('propagation_landing.ui.move_projects', 'Move propagation project(s) to folder') |h %></button><br/><br/>
                <button class="btn btn-sm btn-default" id="move_folder_dialog_link"><% $c->i18n->p('propagation_landing.ui.move_folder', 'Move folder') |h %></button>
                <div id="folder_edit_options" style="display:none">
                    <hr>
                    <h5><i><% $c->i18n->p('propagation_landing.ui.multi_select', 'Select multiple folders by holding \'Ctrl\'.') |h %></i></h5>
                    <button class="btn btn-primary" id="edit_folders_button" title="<% $c->i18n->p('propagation_landing.ui.edit_title', 'First Select Folder(s) to Edit') |h %>"><% $c->i18n->p('propagation_landing.ui.edit_folders', 'Edit Folder(s)') |h %></button>
                    <br/>
                </div>

                <!--<button id="delete" disabled="disabled" >Delete</button -->
                <br />
            </td>
            <td>
                <div id="propagation_projects_list" ><% $c->i18n->p('propagation_landing.ui.loading', '[loading...]') |h %></div>
            </td>
        </tr>
    </tbody>
</table>


<script>

const propagationTreeI18n = window.SGN && window.SGN.i18n || {
    p: function(context, text) { return String(text); }
};

jQuery.noConflict();

jQuery(document).ready(function($) {

    jQuery('#add_propagation_project_link').click(function() {
        var lo = new CXGN.List();
        get_select_box('years', 'propagation_project_year', {'id':'propagation_project_year_select', 'name':'propagation_project_year_select', 'auto_generate':1});
        jQuery("#add_propagation_project_dialog").modal("show");
    });

    jQuery.ajax( {
        url: '/ajax/breeders/get_trials_with_folders_cached?type=propagation',
        success: function(response) {
            var html = '<ul>'+response.html+'</ul>';

            jQuery('#propagation_projects_list').html(html);
            jQuery('#propagation_projects_list').jstree( {
                "core": { 'themes': { 'name': 'proton', 'responsive': true}},
                "valid_children" : [ "folder", "trial", "breeding_program" ],
                "types" : {
                    "breeding_program" : {
                        "icon": 'glyphicon glyphicon-briefcase text-info',
                    },
                    "folder" : {
                        "icon": 'glyphicon glyphicon-folder-open text-danger',
                    },
                    "propagation" : {
                        "icon": 'glyphicon glyphicon-tree-conifer text-success',
                    }
                },
                "search" : {
                    "case_insensitive" : true,
                 },
                "plugins" : ["html_data","types","search"],
            });
        },
        error: function(response) {
            alert(propagationTreeI18n.p('propagation_landing.ui.load_error', 'An error occurred while loading the propagation project data.'));
          }
    });

    jQuery("#propagation_tree_search").keyup(function() {
        var v = jQuery("#propagation_tree_search").val();
        jQuery("#propagation_projects_list").jstree(true).search(v);
    });

    jQuery('#propagation_projects_list').on("changed.jstree", function (e, data) {
        if ($('#propagation_projects_list').jstree('is_leaf', data.node) && data.node.data.jstree.type == 'folder') {
            jQuery("#folder_edit_options").show();
        }
        else {
            jQuery("#folder_edit_options").hide();
        }
    });

    jQuery("#propagation_projects_list").delegate("li", "dblclick", function(event){
        var node = $("#propagation_projects_list").jstree("get_node", this);
        //console.log(node);
        if (node.id.substr(0,1) !== 'j') {
            if (node.type == 'folder') {
                window.open('/folder/'+node.id);
                event.stopPropagation();
            } else if (node.type == 'propagation') {
                window.open('/breeders_toolbox/trial/'+node.id);
                event.stopPropagation();
            }
        }
    });

});

</script>

<style>
#add_propagation_project_link,
#new_folder_dialog_link,
#open_folder_dialog_link,
#move_folder_dialog_link,
#edit_folders_button,
#refresh_propagation_project_jstree_html_trialtree_button {
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
}
</style>

<style>
#add_propagation_project_link {
    min-width: 16em;
}
</style>

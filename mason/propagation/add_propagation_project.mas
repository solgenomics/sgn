<%args>
$programs
$locations
</%args>


<& /util/import_javascript.mas, classes => ['CXGN.TrialTreeFolders'] &>

<div class="modal fade" id="add_propagation_project_dialog" name="add_propagation_project_dialog" tabindex="-1" role="dialog" aria-labelledby="addPropagationProjectDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header">
                <button type="reset" class="close" id="add_propagation_project_dismiss_button_1" name="add_propagation_project_dismiss_button" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <center><h4 class="modal-title" id="addPropagationProjectDialog"><% $c->i18n->p("seedlot.add_new_propagation_project", "Add New Propagation Project") |h %></h4></center>
            </div>
            <div class="modal-body">
                <div class="container-fluid">

                    <&| /util/workflow.mas, id=> "add_propagation_project_workflow" &>
                        <&| /util/workflow.mas:step, title=> $c->i18n->p("cross.ui.intro", "Intro") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("seedlot.what_are_propagation_projects", "What are Propagation Projects?")) &>
                            <p><% $c->i18n->p("seedlot.propagation_project_page_acts_as_a_centralized_page_for_different", "Propagation Project page acts as a centralized page for different propagation processes .") |h %></p>
                            <ul>
                                <li><% $c->i18n->p("seedlot.each_project_page_may_be_used_to_group_propagation_processes", "Each project page may be used to group propagation processes having the same propagation type, objective or done in the same year.") |h %></li>
                                <li><% $c->i18n->p("seedlot.metadata_for_each_propagation_process_e_g_accession_name_material", "Metadata for each propagation process (e.g., accession name, material type, date, operator) is linked to a globally unique") |h %> <b><% $c->i18n->p("seedlot.propagation_group_identifier.dc30c92", "Propagation Group Identifier") |h %></b>.</li>
                                <li><% $c->i18n->p("seedlot.within_each_propagation_group_the_progress_of_each_plant_produced", "Within each Propagation Group, the progress of each plant produced is tracked by a globally unique") |h %> <b><% $c->i18n->p("seedlot.propagation_identifier.e403673", "Propagation Identifier") |h %></b>.</li>
                            </ul>
                            <hr>
                            <center>
                                <button id="next_step_add_new_propagation_project" class="btn btn-primary" onclick="Workflow.complete(this);"><% $c->i18n->p("cross.ui.go_to_next_step", "Go to Next Step") |h %></button>
                            </center>
                        </&>

                        <form class="form-horizontal" role="form" name="add_propagation_project_form" id="add_propagation_project_form">
                            <&| /util/workflow.mas:step, title=> $c->i18n->p("seedlot.add_a_propagation_project", "Add a propagation project") &>
                                <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("seedlot.enter_basic_information_about_the_propagation_project", "Enter basic information about the propagation project")) &>
                                    <br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-lable"><% $c->i18n->p("seedlot.project_name", "Project Name:") |h %> </label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="text" id="propagation_project_name" name="propagation_project_name"  />
                                        </div>
                                    </div><br/>

                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p("seedlot.propagation_type.53e3cdf", "Propagation Type:") |h %> </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="propagation_type" name="propagation_type">
                                                <option value="Macropropagation"><% $c->i18n->p("seedlot.macropropagation", "Macropropagation") |h %></option>
                                                <!--
                                                <option value="">Select a Type</option>
                                                <option value="Micropropagation">Micropropagation</option>
                                                -->
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p("cross.ui.breeding_program.2c9b17e", "Breeding Program:") |h %> </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="propagation_project_program" name="propagation_project_program">
                                                <option value=""><% $c->i18n->p("cross.ui.select_breeding_program", "Select Breeding Program") |h %></option>
<%perl>
foreach my $program (@$programs) {
    if (@$program[3]) {
        print "<option selected=\"selected\" value='".@$program[0]."'>".@$program[1]."</option>";
    } else {
        print "<option value='".@$program[0]."'>".@$program[1]."</option>";
    }
}
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p("seedlot_record.ui.location", "Location:") |h %> </label>
                                        <div class="col-sm-9">
                                            <select class="form-control" id="propagation_project_location" name="propagation_project_location">
                                                <option value=""><% $c->i18n->p("cross.ui.select_location", "Select Location") |h %></option>
<%perl>
    foreach my $location_hashref (@$locations) {
        my $properties = $location_hashref->{'properties'};
        my $program = $properties->{'Program'};
        my $name = $properties->{'Name'};
        print "<option value=\"$name\" data-program=\"$program\">".$name."</option>";
    }
</%perl>
                                            </select>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p("cross.ui.year.c9410fe", "Year:") |h %></label>
                                        <div class="col-sm-9">
                                            <div id="propagation_project_year" name="propagation_project_year" ></div>
                                        </div>
                                    </div><br/>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p("global.dataset_publish.description", "Description:") |h %></label>
                                        <div class="col-sm-9">
                                            <textarea class="form-control" id="propagation_project_description" name="propagation_project_description" ></textarea>
                                        </div>
                                    </div>
                                <br/>
                                <br/>
                                <br/>
                                <center>
                                    <button type="button" class="btn btn-primary" onclick="Workflow.complete(this, false);" name="add_propagation_project_submit" id="add_propagation_project_submit"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
                                </center>
                            </&>
                        </form>

                        <&| /util/workflow.mas:complete, title=> $c->i18n->p("cross.ui.complete", "Complete") &>
                            <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("seedlot.finished_your_propagation_project_is_now_in_the_database", "Finished! Your propagation project is now in the database")) &>
                            <ul>
                                <li><% $c->i18n->p("seedlot.please_click_on_refresh_button_to_view_your_newly_created", "Please click on 'Refresh' button to view your newly created project on the manage page.") |h %></li>
                            </ul>
                            <br/>
                        </&>
                    </&><!-- End of workflow -->
                </div>
            </div>
            <div class="modal-footer">
                <button id="add_propagation_project_dismiss_button_2" name="add_propagation_project_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function(){

    var selectedProgram = jQuery('#propagation_project_program option:selected').text()

    filter_options(selectedProgram, 'program', 'propagation_project_location');

    jQuery('#propagation_project_program').change(function() {
        filter_options(jQuery('#propagation_project_program option:selected').text(), 'program', 'propagation_project_location');
    });

    jQuery("[name='add_propagation_project_dismiss_button']").click(function() {
        jQuery('#add_propagation_project_dialog').modal('hide');
        jQuery('#propagation_project_name').val('');
        jQuery('#propagation_project_program').val('');
        jQuery('#propagation_project_location').val('');
        jQuery('#propagation_project_year').val('');
        jQuery('#propagation_project_description').val('');
        jQuery('#propagation_type').val('');
    });

    jQuery('#add_propagation_project_submit').click(function() {
        var propagation_project_name = jQuery("#propagation_project_name").val();
        if (!propagation_project_name) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.project_name_is_required", "Project name is required") : "Project name is required"));
            return;
        }

        var propagation_type = jQuery("#propagation_type").val();
        if (!propagation_type) {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.propagation_type_is_required", "Propagation Type is required") : "Propagation Type is required"));
            return;
        }

        var selectedProgram = jQuery("#propagation_project_program").val();
        if (!selectedProgram) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.breeding_program_is_required", "Breeding program is required") : "Breeding program is required"));
            return;
        }

        var propagation_project_location = jQuery("#propagation_project_location").val();
        if (!propagation_project_location) {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlots.ui.location_is_required", "Location is required") : "Location is required"));
            return;
        }

        var year = jQuery("#propagation_project_year_select").val();
        if (!year) {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.project.validation.year_required", "Year is required") : "Year is required"));
            return;
        }

        var project_description = jQuery('textarea#propagation_project_description').val();
        if (!project_description) {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("genotype.project.validation.description_required", "Description is required") : "Description is required"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/propagation/add_propagation_project',
            dataType: "json",
            type: 'POST',
            data:{
                'project_name': propagation_project_name,
                'propagation_type': propagation_type,
                'project_program_id': selectedProgram,
                'project_location': propagation_project_location,
                'year': year,
                'project_description': project_description,
            },
            beforeSend: function() {
                jQuery("#working_modal").modal("show");
            },
            error: function(response) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.files.files.error", "An error occurred!") : "An error occurred!") + JSON.stringify(response));
                return;
            },
            parseerror: function(response) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.a_parse_error_occurred", "A parse error occurred!") : "A parse error occurred!") + response);
                return;
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.error) {
                    alert(response.error);
                }
                if (response.success == 1) {
                    Workflow.focus("#add_propagation_project_workflow", -1); //Go to success page
                    Workflow.check_complete("#add_propagation_project_workflow");
                }
            },

        });

    });

});

</script>

<%once>
use HTML::Entities ();
</%once>

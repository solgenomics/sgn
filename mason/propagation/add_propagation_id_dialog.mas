<%args>
$propagation_group_id
$propagation_group_name
$accession_stock_id

</%args>

<div class="modal fade" id="add_propagation_id_dialog" name="add_propagation_id_dialog" tabindex="-1" role="dialog" aria-labelledby="addPropagationIdDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="addPropagationIdDialog"><% $c->i18n->p("seedlot.add_new_propagation_id", "Add New Propagation ID") |h %></h4>
            </div>
            <div class="modal-body" id = "propagation_id_dialog">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" id="add_new_propagation_id_form" name="add_new_propagation_id_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlot.group_id", "Group ID:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" name="propagation_group_id" id="propagation_group_id" disabled value="<% $propagation_group_name %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlot.propagation_identifier.03149e2", "Propagation Identifier:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" type="text" id="new_propagation_identifier" name="new_propagation_identifier" placeholder="<% $c->i18n->p("seedlot.must_not_exist_in_the_database", "Must not exist in the database.") |h %>">
                            </div>
                        </div>
                        <div class="form-group" id = "get_propagation_rootstock_name">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("seedlot.rootstock_name", "Rootstock Name:") |h %> </label>
                            <div class="col-sm-8" >
                                <input class="form-control" type="text" id="propagation_rootstock_name" name="propagation_rootstock_name" placeholder="<% $c->i18n->p("seedlot.must_exist_in_the_database", "Must exist in the database") |h %>">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="add_propagation_id_dismiss_button" name="add_propagation_id_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                    <button id="submit_new_propagation_id" type="button" class="btn btn-primary" ><% $c->i18n->p("global.search_wizard.add", "Add") |h %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="add_propagation_id_saved_dialog_message" name="add_propagation_id_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="addPropagationIdSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addPropagationIdSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("seedlot.the_propagation_identifier_was_saved_successfully", "The propagation identifier was saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_propagation_id_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>
jQuery(document).ready(function(){

    jQuery('#submit_new_propagation_id').click( function() {
        const propagation_identifier = jQuery('#new_propagation_identifier').val();
        const rootstock_name = jQuery('#propagation_rootstock_name').val();
        const propagation_group_stock_id = "<%$propagation_group_id%>";

        if (propagation_identifier == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.please_provide_a_propagation_identifier", "Please provide a propagation identifier") : "Please provide a propagation identifier"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/propagation/add_propagation_identifier',
            dataType: "json",
            type: 'POST',
            data : {
                'propagation_identifier': propagation_identifier,
                'rootstock_name': rootstock_name,
                'propagation_group_stock_id': propagation_group_stock_id,
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#add_propagation_id_dialog').modal('hide');
                    jQuery('#add_propagation_id_saved_dialog_message').modal("show");
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.an_error_occurred_adding_propagation_identifier", "An error occurred adding propagation identifier") : 'An error occurred adding propagation identifier'));
            }
        });
    });

    jQuery("#add_propagation_id_dismiss_button").click(function() {
        jQuery("#add_propagation_id_dialog").modal('hide');
        jQuery('#new_propagation_identifier').val('');
        jQuery('#propagation_rootstock_name').val('');
    });

    jQuery("#dismiss_propagation_id_saved_dialog").click(function() {
        jQuery("#add_propagation_id_saved_dialog_message").modal('hide');
        jQuery('#new_propagation_identifier').val('');
        jQuery('#propagation_rootstock_name').val('');
        location.reload();
    });

});

</script>

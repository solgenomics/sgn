<%once>
use HTML::Entities ();
</%once>

<%args>
$trial_id
$trial_name
$breeding_program_name
$breeding_program_id
$location_name
$country_name
$year
$trial_description
$folder_name
$folder_id
$identifier_prefix
$trial_owner
$propagation_type
$logged_in_name
$date
</%args>

<div class="row">
    <div class="col-sm-12">
        <table class="table table-hover table-bordered" >
            <tr>
                <td><b><% $c->i18n->p("seedlot.propagation_project_name.c312e9a", "Propagation Project Name") |h %></b></td>
                <td>
                    <div id="trial_name">
% if ($trial_name) {
%     print "$trial_name";
% } else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("seedlot.no_propagation_project_name", "[No Propagation Project Name]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("seedlot.propagation_type.d8586b1", "Propagation Type") |h %></b></td>
                <td>
                    <div id="propagation_type">
% if ($propagation_type) {
%     print "$propagation_type";
% } else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("seedlot.no_propagation_type", "[No Propagation Type]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("global.index_logged_in_user.breeding_program", "Breeding Program") |h %> </b></td>
                <td>
                    <span id="breeding_program">
% if ($breeding_program_name) {
                 <a href="/breeders/program/<% $breeding_program_id %>"><% $breeding_program_name %></a>
% }
% else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_breeding_program", "[No Breeding Program]")) . "</span>");
% }
                    </span>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("global.search.features.location", "Location") |h %></b></td>
                <td>
                    <div id="trial_location">
% if ($location_name) {
%     print "$location_name ( $country_name )";
% } else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_location", "[No Location]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("accession.sequencing.table.year", "Year") |h %></b></td>
                <td>
                    <div id="trial_year">
% if ($year) {
%    print "$year";
% } else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_year", "[No Year]")) . "</span>");
% }
                    </div>
                </td>
            </tr>

            <tr><td><b><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></b></td>
                <td>
% if ($trial_description) {
%     print "<div id='trial_description' style='white-space: pre-wrap;'>$trial_description</div>";
% } else {
%     print ("<div id='trial_description'><span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.no_description", "[No Description]")) . "</span></div>");
% }
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("cross.ui.folder", "Folder") |h %></b></td>
                <td>
                    <span id="trial_folder_div"><a href="/folder/<% $folder_id %>"><% $folder_name %></a></span>
                    <br/><br/>
                    <button class="btn btn-sm btn-default" style="margin:3px" id="new_folder_dialog_link"><% $c->i18n->p("cross.ui.new_folder", "New Folder") |h %></button> <button class="btn btn-sm btn-default" style="margin:3px" id="open_folder_dialog_link"><% $c->i18n->p("cross.ui.change_folder", "Change Folder") |h %></button>
                </td>
            </tr>

            <tr>
                <td><b><% $c->i18n->p("cross.ui.created_by", "Created by") |h %></b></td>
                <td>
                    <div id="trial_owner">
% if ($trial_owner) {
%     print "$trial_owner";
% } else {
%     print ("<span class='text-danger'>" . HTML::Entities::encode_entities($c->i18n->p("cross.ui.n_a", "[N/A]")) . "</span>");
% }
                    </div>
                </td>
            </tr>
        </table>

    </div>
</div>
</br>
<button class="btn btn-sm btn-default" style="margin:3px" id="add_new_propagation_group_id_link"><% $c->i18n->p("seedlot.add_new_propagation_group_id", "Add New Propagation Group ID") |h %></button><button class="btn btn-sm btn-primary" style="margin:3px" id="upload_propagation_group_ids_link"><% $c->i18n->p("seedlot.upload_new_propagation_group_ids", "Upload New Propagation Group IDs") |h %></button>
<br>
<button class="btn btn-sm btn-primary" style="margin:3px" id="upload_propagation_ids_link"><% $c->i18n->p("seedlot.upload_new_propagation_ids", "Upload New Propagation IDs") |h %></button><button class="btn btn-sm btn-primary" style="margin:3px" id="upload_propagation_id_status_link"><% $c->i18n->p("seedlot.upload_propagation_id_status", "Upload Propagation ID Status") |h %></button>

<& /propagation/add_propagation_group_id_dialog.mas, trial_id => $trial_id, trial_name => $trial_name, breeding_program_name => $breeding_program_name, date => $date, logged_in_name => $logged_in_name&>
<& /propagation/upload_propagation_group_ids_dialog.mas, trial_id => $trial_id, trial_name => $trial_name&>
<& /propagation/upload_propagation_ids_dialog.mas, trial_id => $trial_id, trial_name => $trial_name&>
<& /propagation/upload_propagation_id_status_dialog.mas&>

<script>

jQuery(document).ready(function($) {
    jQuery('#add_new_propagation_group_id_link').click(function() {

        jQuery("#propagation_accession_name").autocomplete({
            source: '/ajax/stock/only_accession_autocomplete',
            appendTo : propagation_group_id_dialog
        });

        jQuery("#propagation_material_source_type").change(function() {
            let source_type = jQuery('#propagation_material_source_type').val();
            if (source_type === 'Seedlot') {
                jQuery("#propagation_source_name").autocomplete({
                    source: '/ajax/stock/seedlot_name_autocomplete',
                    appendTo : propagation_group_id_dialog
                });
            }

            if (source_type === 'Plot') {
                jQuery("#propagation_source_name").autocomplete({
                    source: '/ajax/stock/plot_autocomplete',
                    appendTo : propagation_group_id_dialog
                });
            }

            if (source_type === 'Plant') {
                jQuery("#propagation_source_name").autocomplete({
                    source: '/ajax/stock/plant_autocomplete',
                    appendTo : propagation_group_id_dialog
                });
            }

            if (source_type === 'Tissue Sample') {
                jQuery("#propagation_source_name").autocomplete({
                    source: '/ajax/stock/tissue_sample_autocomplete',
                    appendTo : propagation_group_id_dialog
                });
            }

        });

        jQuery("#rootstock_accession_name").autocomplete({
            source: '/ajax/stock/only_accession_autocomplete',
            appendTo : propagation_group_id_dialog
        });

        jQuery("#add_propagation_group_id_dialog").modal("show");

    });

});

</script>

<%once>
use HTML::Entities ();
</%once>

<%doc>

=head1 NAME

/propagation/propagation_project.mas - a mason component to display a propagation project page

=head1

=cut

</%doc>


<%args>
$trial_id
$trial_name
$breeding_program_id
$breeding_program_name
$location_id
$location_name
$country_name
$year => undef
$trial_type => undef
$trial_description => undef
$folder_name => undef
$folder_id => undef
$locations_by_program_json
$trial_owner => undef
$propagation_type
$date
$logged_in_name
</%args>


<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'CXGN.Trial', 'jstree/dist/jstree', 'CXGN.BreedersToolbox.HTMLSelect', 'moment_min', 'daterangepicker'] &>

<br/>


<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("seedlot.details_for", "Details for ")).HTML::Entities::encode_entities($trial_name) &>

<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Propagation Project Details</h4>", info_section_collapsed => 0, trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("seedlot.propagation_project_details", "Propagation Project Details")) . "</h4>"), info_section_subtitle => $c->i18n->p("seedlot.view_and_edit_basic_information_about_the_project", 'View and edit basic information about the project.'), buttons_html => ("<button class=\"btn btn-primary btn-sm\" id=\"edit_propagation_project_details\" style=\"margin:3px\">" . HTML::Entities::encode_entities($c->i18n->p("seedlot.edit_project_details", "Edit Project Details")) . "</button>"), icon_class => "glyphicon glyphicon-dashboard", info_section_id => "propagation_project_details", trial_name => $trial_name, breeding_program_name => $breeding_program_name, breeding_program_id => $breeding_program_id, location_name => $location_name, country_name => $country_name, year => $year, trial_description => $trial_description, folder_name => $folder_name, folder_id => $folder_id, trial_owner => $trial_owner, propagation_type => $propagation_type, date => $date, logged_in_name => $logged_in_name &>
<& /page/detail_page_2_col_section.mas, info_section_anchor_title => "<h4 style='display:inline'>Propagation Group IDs</h4>", info_section_collapsed => 0, trial_id => $trial_id, info_section_title => ("<h4 style='display:inline'>" . HTML::Entities::encode_entities($c->i18n->p("seedlot.propagation_group_ids", "Propagation Group IDs")) . "</h4>"), info_section_subtitle => $c->i18n->p("seedlot.view_information_about_propagation_details_in_this_project", 'View information about propagation details in this project.'), icon_class => "glyphicon glyphicon-list-alt", info_section_id => "propagation_group_ids_in_project_section" &>


<div id="trialIDDiv" class="trialIDDivClass" style="display:none;">
% print $trial_id;
</div>

<& /breeders_toolbox/folder/folder_set.mas, project_type => 'propagation_project', breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name, trial_id => $trial_id, trial_name =>$trial_name &>
<& /breeders_toolbox/folder/folder_new.mas, project_type => 'propagation_project', breeding_program_id => $breeding_program_id, breeding_program_name =>$breeding_program_name &>
<& /propagation/edit_propagation_project_details_dialog.mas, trial_name => $trial_name, breeding_program_id => $breeding_program_id, location_id => $location_id, year => $year, trial_description => $trial_description &>

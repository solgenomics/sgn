<%args>

</%args>

<div class="modal fade" id="upload_propagation_ids_dialog" name="upload_propagation_ids_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPropagationIDsDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="reset" class="close" id="upload_propagation_ids_dismiss_button_2" name="upload_propagation_ids_dismiss_button" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPropagationIDsDialog"><% $c->i18n->p("seedlot.upload_propagation_ids", "Upload Propagation IDs") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>$c->i18n->p("cross.ui.template_information.bf8c643", 'Template Information') &>
                        <p>
                            <b><% $c->i18n->p("accessions.dialog.file_format", "File format information") |h %></b>
                            <br>
                            <a id="propagation_ids_upload_spreadsheet_format_info"><% $c->i18n->p("cross.ui.spreadsheet_format.f1285ec", "Spreadsheet Format") |h %></a>
                        </p>
                    </&>
                    <form method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_propagation_ids_form" name="upload_propagation_ids_form">
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("cross.ui.upload_file.9798051", "Upload File:") |h %> </label>
                            <div class="col-sm-9" >
                                <input type="file" name="propagation_ids_file" id="propagation_ids_file" encoding="multipart/form-data" />
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="upload_propagation_ids_dismiss_button_1" name="upload_propagation_ids_dismiss_button" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="upload_propagation_ids_submit" id="upload_propagation_ids_submit"><% $c->i18n->p("global.dataset_publish.action.upload", "Upload") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="propagation_ids_saved_dialog_message" name="propagation_ids_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="propagationIdsSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="propagationIdsSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("seedlot.the_propagation_ids_were_saved_successfully", "The propagation ids were saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_propagation_ids_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_propagation_ids_error_display" name="upload_propagation_ids_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadPropagationIdsErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPropagationIdsErrorDialog"><% $c->i18n->p("seedlot.upload_propagation_identifiers_error", "Upload Propagation Identifiers Error") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="propagation_id_upload_spreadsheet_info_dialog" name="propagation_id_upload_spreadsheet_info_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadPropagationIDInfoDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadPropagationIDInfoDialog"><% $c->i18n->p("seedlot.upload_template_information_for_propagation_identifiers", "Upload Template Information For Propagation Identifiers") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% $c->i18n->p("accessions.template.header", "Header:") |h %></b>
                    <br>
                    <% $c->i18n->p("seedlot.the_first_row_header_must_contain_the", "The first row (header) must contain the") |h %> <b>propagation_group_identifier</b>, <b>propagation_identifier</b>, <b>status_type</b>, <b>status_date</b>, <b>status_updated_by</b><% $c->i18n->p("seedlot.additional_information_can_be_included_by_selecting_optional_column_s", ". Additional information can be included by selecting optional column(s) (see below):") |h %>
                    <br/>
                    <br>
                    <table class="table table-hover table-bordered table-condensed" >
                        <thead></thead>
                        <tbody>
                            <tr>
                                <td>propagation_group_identifier</td>
                                <td>propagation_identifier</td>
                                <td>status_type</td>
                                <td>status_date</td>
                                <td>status_updated_by</td>
                                <td>rootstock</td>
                                <td>status_notes</td>
                                <td>inventory_identifier</td>
                            </tr>
                        </tbody>
                    </table>

                    <b><% $c->i18n->p("cross.ui.required_fields", "Required fields:") |h %></b>
                    <ul>
                        <li><% $c->i18n->p("seedlot.propagation_group_identifier_must_exist_in_the_database", "propagation_group_identifier (must exist in the database)") |h %></li>
                        <li><% $c->i18n->p("seedlot.propagation_identifier_must_not_exist_in_the_database", "propagation_identifier (must not exist in the database)") |h %></li>
                        <li><% $c->i18n->p("seedlot.status_type_must_be_one_of_the_following_in_progress", "status_type (must be one of the following:'in progress', 'inventoried', 'distributed', 'planted in trial', 'dead', 'disposed')") |h %></li>
                        <li><% $c->i18n->p("seedlot.status_date_must_be_in_the", "status_date (must be in the") |h %> <b>YYYY-MM-DD</b> <% $c->i18n->p("seedlot.format", "format)") |h %></li>
                        <li><% $c->i18n->p("seedlot.status_updated_by_person_name", "status_updated_by (person name)") |h %></li>
                    </ul>

                    <b><% $c->i18n->p("seedlots.ui.optional_fields", "Optional fields:") |h %></b>
                    <ul>
                        <li><% $c->i18n->p("seedlot.rootstock_rootstock_accession_must_exist_in_the_database", "rootstock (rootstock accession must exist in the database)") |h %></li>
                        <li>status_notes</li>
                        <li><% $c->i18n->p("seedlot.inventory_identifier_must_not_exist_in_the_database_and_must", "inventory_identifier (must not exist in the database and must be globally unique. If any propagation_identifier has Inventoried status type, the propagation identifier and the derived inventory identifier can be uploaded at the same time)") |h %></li>
                    </ul>
                </div>
                <& /help/file_upload_type.mas, type => $c->i18n->p("program.stock_section.propagation", "Propagation Identifiers"), optional_column => 1 &>
            </div>
            <div class="modal-footer">
                <button id="close_propagation_id_info_upload_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function(){

    jQuery('#upload_propagation_ids_link').click(function() {
        jQuery("#upload_propagation_ids_dialog").modal("show");
    });

    jQuery('#upload_propagation_ids_spreadsheet_format_info').click(function(){
        jQuery("#propagation_ids_upload_spreadsheet_info_dialog").modal("show");
    });

    jQuery("#upload_propagation_ids_submit").click(function(){
        upload_propagation_ids();
    });

    function upload_propagation_ids() {
        var uploadFile = jQuery("#propagation_ids_file").val();
        if (uploadFile === '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.manage_file_share_dump.select_file", "Please select a file") : "Please select a file"));
            return;
        }

        jQuery("#working_modal").modal("show");
        jQuery.ajax({
            url: "/ajax/propagation/upload_propagation_identifiers",
            type: 'POST',
            data: new FormData(jQuery("#upload_propagation_ids_form")[0]),
            processData: false,
            contentType: false,
            success: function(response) {
                jQuery("#working_modal").modal("hide");
                if (response.error_string) {
                    jQuery("#upload_propagation_ids_error_display tbody").html('');
                    jQuery("#upload_propagation_ids_error_display tbody").append(response.error_string);
                    jQuery("#upload_propagation_ids_error_display").modal("show");
                    return;
                }
                if (response.error) {
                    alert(response.error);
                    return;
                }
                if (response.success) {
                    jQuery("#upload_propagation_ids_dialog").modal("hide");
                    jQuery('#propagation_ids_saved_dialog_message').modal("show");
                }
            }
        });
    };

    jQuery("#dismiss_propagation_ids_saved_dialog").click(function(){
        location.reload();
    });

    jQuery('#propagation_ids_upload_spreadsheet_format_info').click(function() {
        jQuery("#propagation_id_upload_spreadsheet_info_dialog").modal("show");
    });

    jQuery("[name='upload_propagation_ids_dismiss_button']").click(function() {
        jQuery('#upload_propagation_ids_dialog').modal('hide');
        jQuery('#propagation_ids_file').val('');
    });

});

</script>

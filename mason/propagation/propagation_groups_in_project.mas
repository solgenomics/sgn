<%args>
$trial_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'CXGN.List', 'jquery.iframe-post-form' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<div style="overflow:scroll">
    <table class="table table-hover table-bordered" id="propagation_groups_in_project_table">
        <thead>
            <tr>
                <th><% $c->i18n->p("seedlot.propagation_group_id", "Propagation Group ID") |h %></th>
                <th><% $c->i18n->p("global.index_logged_in_user.accession", "Accession") |h %></th>
                <th><% $c->i18n->p("seedlot.variety", "Variety") |h %></th>
                <th><% $c->i18n->p("seedlot_split.ui.material_type", "Material Type") |h %></th>
                <th><% $c->i18n->p("seedlot.source_type.9399840", "Source Type") |h %></th>
                <th><% $c->i18n->p("accession.forms.source_name", "Source Name") |h %></th>
                <th><% $c->i18n->p("global.file_dump_share_files.date", "Date") |h %></th>
                <th><% $c->i18n->p("seedlot.sub_location.6ef459e", "Sub-Location") |h %></th>
                <th><% $c->i18n->p("seedlot.purpose.608fe34", "Purpose") |h %></th>
                <th><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></th>
                <th><% $c->i18n->p("cross.ui.operator", "Operator") |h %></th>
                <th><% $c->i18n->p("seedlot.number_of_propagation_ids", "Number of Propagation IDs") |h %></th>
            </tr>
        </thead>
    </table>
</div>


<script>

jQuery(document).ready(function(){
    var project_id = "<% $trial_id %>";
    var propagation_group_table = jQuery('#propagation_groups_in_project_table').DataTable({
        'ajax': '/ajax/propagation/propagation_groups_in_project/'+project_id,
        'autoWidth': false,

    });

});

</script>

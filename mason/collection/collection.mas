<%args>
$collection_type => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'jstree.dist.jstree' ] &>
<& /util/import_css.mas, paths => ['/static/documents/inc/jstree_theme/jstree-bstheme-min.css'] &>
<& /collection/message_modal.mas &>

<& /page/page_title.mas, title => "Collection Search" &>

<&| /page/info_section.mas, title=>"Browse Collections by Breeding Program",  collapsible => 1, collapsed=>0, subtitle => "Collections grouped by breeding program, then project. Double click a collection to open it."&>
    <& /collection/collections_tree.mas, collection_type => $collection_type, instance_id => 'collections_tree_main' &>
</&>

<&| /page/info_section.mas, title=>"Collection Search Criteria",  collapsible => 1, collapsed=>0, subtitle => "Search collections by name, description, creator, or associated project."&>

    <div id="collection_search_form" class="well well-sm">
        <div class="form-horizontal" >
            <div class="form-group">
                <label class="col-sm-6 control-label">Collection name: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="collection_name" name="collection_name" placeholder="e.g. Field Photos 2026" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Collection description: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="collection_description" name="collection_description" placeholder="e.g. Gels from June extraction" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Creator: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="collection_creator" name="collection_creator" placeholder="e.g. JaneDoe" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Contains image (name or filename): </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="collection_image_name" name="collection_image_name" placeholder="e.g. gel_03.jpg" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Contains file (name or comment): </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="collection_file_name" name="collection_file_name" placeholder="e.g. phenotype_2026.xls" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Associated project: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="collection_project_name" name="collection_project_name" placeholder="e.g. DroneProject 01/01/2019" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">&nbsp;</label>
                <div class="col-sm-6" >
                    <label style="font-weight:normal;">
                        <input type="checkbox" id="collection_mine_only" /> Show only my collections
                    </label>
                </div>
            </div>
        </div>

        <center>
        <button class="btn btn-primary" id="collection_search_submit" >Search</button>
        <button class="btn btn-default" id="new_folder_button" >New Collection</button>
        </center>
    </div>
</&>


<&| /page/info_section.mas, title=>"Collections",  collapsible => 1, collapsed=>0 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table id="collections_search_results" class="table table-hover table-striped">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Owner</th>
                    <th>Associated Project</th>
                    <th>Images</th>
                    <th>Files</th>
                    <th>Created</th>
                    <th></th>
                </tr>
                </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, title=>"Files",  collapsible => 1, collapsed=>0, subtitle => "Search files and add them to a file collection."&>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">

                <div class="row">
                    <div class="col-sm-8">
                        <div class="form-horizontal">
                            <div class="form-group">
                                <label class="col-sm-4 control-label">File name or comment: </label>
                                <div class="col-sm-8">
                                    <input class="form-control" type="text" id="file_search_term" placeholder="e.g. phenotype_2026.xls" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">File type: </label>
                                <div class="col-sm-8">
                                    <input class="form-control" type="text" id="file_search_type" placeholder="e.g. trial_additional_file_upload" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Uploader: </label>
                                <div class="col-sm-8">
                                    <input class="form-control" type="text" id="file_search_uploader" placeholder="e.g. JaneDoe" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <center>
                            <button class="btn btn-primary" id="file_search_submit">Search Files</button>
                        </center>
                    </div>
                </div>

                <div id="file_add_to_collection_bar" style="margin:10px 0; display:none;">
                    <button class="btn btn-success btn-sm" id="file_add_selected_to_collection_button">
                        <span class="glyphicon glyphicon-plus"></span>
                        Add Selected Files to Collection (<span id="file_selected_count">0</span>)
                    </button>
                    <button class="btn btn-default btn-sm" id="file_clear_selection_button" style="margin-left:6px;">
                        Clear Selection
                    </button>
                </div>

                <table id="files_search_results" class="table table-hover table-striped" style="width:100%;">
                    <thead>
                      <tr>
                        <th><input type="checkbox" id="file_select_all" /></th>
                        <th>File Name</th>
                        <th>Type</th>
                        <th>Comment</th>
                        <th>Uploader</th>
                        <th>Added</th>
                      </tr>
                    </thead>
                </table>

                <hr/>
                <h4 style="margin-top:0;">File collections by breeding program</h4>
                <& /collection/collections_tree.mas, collection_type => 'file', instance_id => 'collections_tree_files' &>

            </div>
        </div>
    </div>
</&>

<& /collection/add_files_to_collection_modal.mas &>
<& /collection/create_collection_modal.mas, default_type => ($collection_type || 'image') &>

<script>

var collections_table;

jQuery(document).ready(function () {

    _load_collection_search_results();

    jQuery("#collection_creator").autocomplete({
        source: '/ajax/people/autocomplete'
    });

    jQuery("#collection_project_name").autocomplete({
        source: '/ajax/trials/trial_autocomplete'
    });

    jQuery("#file_search_uploader").autocomplete({
        source: '/ajax/people/autocomplete'
    });

    jQuery('#collection_search_submit').click( function() {
        _load_collection_search_results();
    });

    jQuery('#collection_search_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            e.preventDefault();
            jQuery('#collection_search_submit').click();
        }
    });

    jQuery('#collection_mine_only').change( function() {
        _load_collection_search_results();
    });

    jQuery('#new_folder_button').click( function() {
        window.create_collection_dialog_open('<% $collection_type || "image" %>');
    });

    jQuery('#collections_search_results').on('click', '.delete-collection-btn', function () {
        var id = jQuery(this).data('collection-id');
        window.collection_confirm('Delete this folder? Its contents are not deleted.', function () {
            jQuery.ajax({
                url: '/ajax/collection/delete',
                type: 'POST',
                data: { collection_id: id },
                success: function (r) {
                    if (r.error) { window.collection_notify_error(r.error); return; }
                    collections_table.ajax.reload(null, false);
                },
                error: function () { window.collection_notify_error('An error occurred deleting the folder.'); }
            });
        });
    });

    //  file search
    // Mirrors the manage_images add-selected-to-collection flow: select
    // files in the table, then add them to a collection via the picker.

    var file_selected_ids = new Set();
    var file_selected_labels = {};

    function file_update_selection_bar() {
        var count = file_selected_ids.size;
        jQuery('#file_selected_count').text(count);
        jQuery('#file_add_to_collection_bar').toggle(count > 0);
    }

    jQuery('#file_search_submit').click(function () {
        _load_file_search_results();
    });

    jQuery('#file_search_term').keypress(function (e) {
        var code = e.keyCode || e.which;
        if (code === 13) {
            e.preventDefault();
            jQuery('#file_search_submit').click();
        }
    });

    jQuery('#files_search_results').on('draw.dt', function () {
        jQuery('input[name="file_select"]').each(function () {
            var id = parseInt(jQuery(this).val(), 10);
            jQuery(this).prop('checked', file_selected_ids.has(id));
        });
        var visible = jQuery('input[name="file_select"]');
        var all_checked = visible.length > 0 && visible.filter(':checked').length === visible.length;
        jQuery('#file_select_all').prop('checked', all_checked);
    });

    jQuery('#files_search_results').on('change', 'input[name="file_select"]', function () {
        var id = parseInt(jQuery(this).val(), 10);
        var name_text = jQuery(this).closest('tr').find('td').eq(1).text().trim();
        if (jQuery(this).is(':checked')) {
            file_selected_ids.add(id);
            file_selected_labels[id] = name_text;
        } else {
            file_selected_ids.delete(id);
            jQuery('#file_select_all').prop('checked', false);
        }
        file_update_selection_bar();
    });

    jQuery('#file_select_all').change(function () {
        var checked = jQuery(this).is(':checked');
        jQuery('input[name="file_select"]').each(function () {
            var id = parseInt(jQuery(this).val(), 10);
            var name_text = jQuery(this).closest('tr').find('td').eq(1).text().trim();
            jQuery(this).prop('checked', checked);
            if (checked) {
                file_selected_ids.add(id);
                file_selected_labels[id] = name_text;
            } else {
                file_selected_ids.delete(id);
            }
        });
        file_update_selection_bar();
    });

    jQuery('#file_clear_selection_button').click(function () {
        file_selected_ids.clear();
        file_selected_labels = {};
        jQuery('input[name="file_select"]').prop('checked', false);
        jQuery('#file_select_all').prop('checked', false);
        file_update_selection_bar();
    });

    jQuery('#file_add_selected_to_collection_button').click(function () {
        if (!file_selected_ids.size) { return; }
        jQuery('#files_add_to_collection_dialog').modal('show');
    });

    // Fired by add_files_to_collection_modal.mas after a successful add.
    jQuery(document).on('files_add_to_collection:items_added', function () {
        file_selected_ids.clear();
        file_selected_labels = {};
        jQuery('input[name="file_select"]').prop('checked', false);
        jQuery('#file_select_all').prop('checked', false);
        file_update_selection_bar();
        _load_file_search_results();
    });

});

var collections_table;
var files_table;

function _load_collection_search_results() {
    collections_table = jQuery('#collections_search_results').DataTable({
        'destroy' : true,
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'autoWidth': false,
        'lengthMenu': [10,20,50,100,1000,5000],
        'ajax': { 'url':  '/ajax/search/collections',
            'type': 'POST',
            'data': function(d) {
              d.name = jQuery('#collection_name').val();
              d.description = jQuery('#collection_description').val();
              d.image_name = jQuery('#collection_image_name').val();
              d.file_name = jQuery('#collection_file_name').val();
              d.creator_username = jQuery('#collection_creator').val();
              d.project_name = jQuery('#collection_project_name').val();
              d.mine_only = jQuery('#collection_mine_only').is(':checked') ? 1 : 0;
% if ($collection_type) {
              d.collection_type = '<% $collection_type %>';
% }
            }
        },
        'columns': [
            { 'data': 'name', 'render': function (name, type, row) {
                return '<a href="/collection/' + row.collection_id + '">' + name + '</a>';
            } },
            { 'data': 'description', 'defaultContent': '<span class="text-muted">&mdash;</span>' },
            { 'data': 'username', 'defaultContent': '<span class="text-muted">&mdash;</span>' },
            { 'data': 'projects', 'render': function (projects) {
                if (!projects || !projects.length) { return '<span class="text-muted">&mdash;</span>'; }
                return projects.map(function (p) {
                    return '<a href="/breeders/trial/' + p.project_id + '">' + p.name + '</a>';
                }).join(', ');
            } },
            { 'data': 'image_count' },
            { 'data': 'file_count' },
            { 'data': 'create_date' },
            { 'data': null, 'render': function (data, type, row) {
                return row.user_can_modify
                    ? '<button class="btn btn-danger btn-xs delete-collection-btn" data-collection-id="' + row.collection_id + '">Delete</button>'
                    : '';
            } }
        ]
    });
}

// Server-side checkbox column (html_select_box) like the image search;
// rows are [checkbox, name, type, comment, uploader, added].
function _load_file_search_results() {
    files_table = jQuery('#files_search_results').DataTable({
        'destroy'   : true,
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'autoWidth' : false,
        'scrollX'   : true,
        'lengthMenu': [10,20,50,100,1000,5000],
        'ajax': { 'url':  '/ajax/search/files',
            'type': 'POST',
            'data': function(d) {
              d.file_name = jQuery('#file_search_term').val();
              d.file_type = jQuery('#file_search_type').val();
              d.file_uploader = jQuery('#file_search_uploader').val();
              d.html_select_box = 'file_select';
            }
        },
        'columns': [
            { 'data': 0, 'orderable': false, 'searchable': false },
            { 'data': 1 },
            { 'data': 2 },
            { 'data': 3 },
            { 'data': 4 },
            { 'data': 5 }
        ]
    });
}

</script>
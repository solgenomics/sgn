<%args>
$collection_type => undef
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'jstree.dist.jstree' ] &>
<& /util/import_css.mas, paths => ['/static/documents/inc/jstree_theme/jstree-bstheme-min.css'] &>

<& /page/page_title.mas, title => "Collection Search" &>

<&| /page/info_section.mas, title=>"Collection Search Criteria",  collapsible => 1, collapsed=>0, subtitle => "Search collections by name, description, creator, or associated project."&>

    <div id="collection_search_form" class="well well-sm">
        <div class="form-horizontal" >
            <div class="form-group">
                <label class="col-sm-6 control-label">Collection name: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="collection_name" name="collection_name" placeholder="e.g. Field Photos 2026" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Collection description: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="collection_description" name="collection_description" placeholder="e.g. Gels from June extraction" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Creator: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="collection_creator" name="collection_creator" placeholder="e.g. JaneDoe" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Contains image (name or filename): </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="collection_image_name" name="collection_image_name" placeholder="e.g. gel_03.jpg" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Associated project: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="collection_project_name" name="collection_project_name" placeholder="e.g. DroneProject 01/01/2019" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">&nbsp;</label>
                <div class="col-sm-6" >
                    <label style="font-weight:normal;">
                        <input type="checkbox" id="collection_mine_only" /> Show only my collections
                    </label>
                </div>
            </div>
        </div>

        <center>
        <button class="btn btn-primary" id="collection_search_submit" >Search</button>
        <button class="btn btn-default" id="new_folder_button" >New Collection</button>
        </center>
    </div>
</&>

<&| /page/info_section.mas, title=>"Browse Collections by Breeding Program",  collapsible => 1, collapsed=>0, subtitle => "Collections grouped by breeding program, then project. Double click a collection to open it."&>
    <div class="well well-sm">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th style="width:30%;">Search</th>
                    <th>Breeding Programs -- Projects -- Collections
                        &nbsp;&nbsp;&nbsp;&nbsp;
                        <button class="btn btn-sm btn-default" id="collections_tree_refresh_button">Refresh</button>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <input type="text" class="form-control input-sm" id="collections_tree_search" placeholder="Search" />
                        <hr>
                        <h5><i>Double click a collection (&nbsp;<span class="glyphicon glyphicon-picture text-success"></span>&nbsp;)
                            to view its detail page.</i></h5>
                        <h5><i>Breeding programs (&nbsp;<span class="glyphicon glyphicon-briefcase text-info"></span>&nbsp;),
                            projects (&nbsp;<span class="glyphicon glyphicon-folder-open text-danger"></span>&nbsp;)</i></h5>
                        <h5><i>Files (&nbsp;<span class="glyphicon glyphicon-file text-muted"></span>&nbsp;)</i></h5>
                    </td>
                    <td>
                        <div id="collections_tree_loading" class="text-muted" style="padding:10px;">
                            <span class="glyphicon glyphicon-refresh"></span> Loading collections&hellip;
                        </div>
                        <div id="collections_tree" >[loading...]</div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</&>

<&| /page/info_section.mas, title=>"Collections",  collapsible => 1, collapsed=>0 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table id="collections_search_results" class="table table-hover table-striped">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Owner</th>
                    <th>Associated Project</th>
                    <th>Images</th>
                    <th>Files</th>
                    <th>Created</th>
                    <th></th>
                </tr>
                </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<div class="modal fade" id="create_collection_dialog" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header"><h4 class="modal-title">New Collection</h4></div>
      <div class="modal-body">
        <div class="form-group">
          <label>Collection name</label>
          <input type="text" class="form-control" id="new_collection_name">
        </div>
        <div class="form-group">
          <label>Collection type</label>
          <select class="form-control" id="new_collection_type">
            <option value="image">Image</option>
            <option value="file">File</option>
          </select>
        </div>
        <div class="form-group">
          <label>Breeding program</label>
          <select class="form-control" id="new_collection_breeding_program">
            <option value="">No program</option>
          </select>
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea class="form-control" id="new_collection_description" rows="2"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="create_collection_submit">Create</button>
      </div>
    </div>
  </div>
</div>

<script>

var collections_table;

jQuery(document).ready(function () {

    _load_collection_search_results();

    jQuery("#collection_creator").autocomplete({
        source: '/ajax/people/autocomplete'
    });

    jQuery("#collection_project_name").autocomplete({
        source: '/ajax/trials/trial_autocomplete'
    });

    // Breeding program dropdown for the create dialog.
    jQuery.ajax({
        url: '/ajax/html/select/breeding_programs',
        data: { id: 'new_collection_breeding_program', name: 'breeding_program', empty: '' },
        success: function (response) {
            var options = '<option value="">No program</option>' + response.select;
            // Drop the helper's "Please select a program" entry, if present.
            options = options.replace(/<option value="">Please select a program<\/option>/, '');
            jQuery('#new_collection_breeding_program').html(options);
        }
    });

    jQuery('#collection_search_submit').click( function() {
        _load_collection_search_results();
    });

    jQuery('#collection_search_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            e.preventDefault();
            jQuery('#collection_search_submit').click();
        }
    });

    jQuery('#collection_mine_only').change( function() {
        _load_collection_search_results();
    });

    jQuery('#new_folder_button').click( function() {
        jQuery('#new_collection_name').val('');
        jQuery('#new_collection_description').val('');
        jQuery('#new_collection_type').val('<% $collection_type || "image" %>');
        jQuery('#create_collection_dialog').modal('show');
    });

    jQuery('#create_collection_submit').click( function() {
        var name = jQuery('#new_collection_name').val();
        if (!name || !name.trim()) {
            alert('Please enter a folder name.');
            return;
        }
        var data = {
            name:        name,
            description: jQuery('#new_collection_description').val(),
            collection_type: jQuery('#new_collection_type').val()
        };
        var bp_id = jQuery('#new_collection_breeding_program').val();
        if (bp_id) { data.breeding_program_id = bp_id; }
        jQuery.ajax({
            url: '/ajax/collection/create',
            type: 'POST',
            data: data,
            success: function (response) {
                if (response.error) { alert(response.error); return; }
                jQuery('#create_collection_dialog').modal('hide');
                window.location.href = '/collection/' + response.collection_id;
            },
            error: function () { alert('An error occurred creating the folder.'); }
        });
    });

    jQuery('#collections_search_results').on('click', '.delete-collection-btn', function () {
        var id = jQuery(this).data('collection-id');
        if (!confirm('Delete this folder? Its contents are not deleted.')) { return; }
        jQuery.ajax({
            url: '/ajax/collection/delete',
            type: 'POST',
            data: { collection_id: id },
            success: function (r) {
                if (r.error) { alert(r.error); return; }
                collections_table.ajax.reload(null, false);
            },
            error: function () { alert('An error occurred deleting the folder.'); }
        });
    });

});

function _load_collection_search_results() {
    collections_table = jQuery('#collections_search_results').DataTable({
        'destroy' : true,
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'autoWidth': false,
        'lengthMenu': [10,20,50,100,1000,5000],
        'ajax': { 'url':  '/ajax/search/collections',
            'type': 'POST',
            'data': function(d) {
              d.name = jQuery('#collection_name').val();
              d.description = jQuery('#collection_description').val();
              d.image_name = jQuery('#collection_image_name').val();
              d.creator_username = jQuery('#collection_creator').val();
              d.project_name = jQuery('#collection_project_name').val();
              d.mine_only = jQuery('#collection_mine_only').is(':checked') ? 1 : 0;
% if ($collection_type) {
              d.collection_type = '<% $collection_type %>';
% }
            }
        },
        'columns': [
            { 'data': 'name', 'render': function (name, type, row) {
                return '<a href="/collection/' + row.collection_id + '">' + name + '</a>';
            } },
            { 'data': 'description', 'defaultContent': '<span class="text-muted">&mdash;</span>' },
            { 'data': 'username', 'defaultContent': '<span class="text-muted">&mdash;</span>' },
            { 'data': 'projects', 'render': function (projects) {
                if (!projects || !projects.length) { return '<span class="text-muted">&mdash;</span>'; }
                return projects.map(function (p) {
                    return '<a href="/breeders/trial/' + p.project_id + '">' + p.name + '</a>';
                }).join(', ');
            } },
            { 'data': 'image_count' },
            { 'data': 'file_count' },
            { 'data': 'create_date' },
            { 'data': null, 'render': function (data, type, row) {
                return row.user_can_modify
                    ? '<button class="btn btn-danger btn-xs delete-collection-btn" data-collection-id="' + row.collection_id + '">Delete</button>'
                    : '';
            } }
        ]
    });
}

// --------------------------------------------------- collections tree view

function collections_tree_collection_icon(c) {
    if (c.collection_type === 'image') { return 'glyphicon glyphicon-picture text-success'; }
    if (c.collection_type === 'file')  { return 'glyphicon glyphicon-file text-muted'; }
    return 'glyphicon glyphicon-th-large text-primary';
}

function collections_tree_collection_li(c) {
    return '<li data-jstree=\'{"type":"collection"}\' id="collection_' + c.collection_id + '">' +
        '<a href="/collection/' + c.collection_id + '">' +
        '<span class="' + collections_tree_collection_icon(c) + '"></span> ' +
        c.name + ' <span class="text-muted" style="font-size:11px;">(' + (c.image_count || 0) + ')</span></a>';
}

function collections_tree_project_li(p) {
    var html = '<li data-jstree=\'{"type":"project"}\' id="project_' + p.project_id + '">' +
        '<a href="/breeders/trial/' + p.project_id + '">' + p.name + '</a><ul>';
    (p.collections || []).forEach(function (c) { html += collections_tree_collection_li(c); html += '</li>'; });
    html += '</ul></li>';
    return html;
}

function collections_tree_program_li(p) {
    var html = '<li data-jstree=\'{"type":"breeding_program"}\' id="bp_' + p.program_id + '">' +
        '<a href="/breeders/program/' + p.program_id + '">' + p.program_name + '</a><ul>';
    p.collections.forEach(function (c) { html += collections_tree_collection_li(c); html += '</li>'; });
    (p.projects || []).forEach(function (proj) { html += collections_tree_project_li(proj); });
    html += '</ul></li>';
    return html;
}

function _render_collections_tree(groups) {
    var html = '<ul>';
    (groups.programs || []).forEach(function (p) { html += collections_tree_program_li(p); });
    (groups.no_program || []).forEach(function (p) { html += collections_tree_project_li(p); });
    (groups.standalone || []).forEach(function (c) { html += collections_tree_collection_li(c); html += '</li>'; });
    html += '</ul>';

    if (jQuery('#collections_tree').data('jstree_ready')) {
        jQuery('#collections_tree').jstree('destroy');
        jQuery('#collections_tree').removeData('jstree_ready');
    }
    jQuery('#collections_tree').html(html);

    jQuery('#collections_tree').jstree({
        "core": { 'themes': { 'name': 'proton', 'responsive': true } },
        "types": {
            "collection":      { "icon": 'glyphicon glyphicon-picture text-success' },
            "project":         { "icon": 'glyphicon glyphicon-folder-open text-danger' },
            "breeding_program": { "icon": 'glyphicon glyphicon-briefcase text-info' }
        },
        "search": { "case_insensitive": true },
        "plugins": ["html_data", "types", "search"]
    });
    jQuery('#collections_tree').data('jstree_ready', true);
    jQuery('#collections_tree').jstree('open_all');
}

function _load_collections_tree(refresh) {
    jQuery('#collections_tree_loading').show();
    jQuery('#collections_tree').hide();

    var data = {};
    if (refresh) { data.refresh = 1; }
% if ($collection_type) {
    data.collection_type = '<% $collection_type %>';
% }

    jQuery.ajax({
        url: '/ajax/search/collections/tree',
        type: 'GET',
        data: data,
        success: function (groups) {
            jQuery('#collections_tree_loading').hide();
            jQuery('#collections_tree').show();
            if (groups && groups.error) { alert(groups.error); return; }
            _render_collections_tree(groups);
        },
        error: function () {
            jQuery('#collections_tree_loading').hide();
            jQuery('#collections_tree').show();
            jQuery('#collections_tree').text('Could not load the collections tree.');
        }
    });
}

jQuery(function () {
    // Tree nodes only reveal their links via jstree's anchor handling; the
    // refresh button forces a server-side rebuild.
    jQuery('#collections_tree_refresh_button').click(function () {
        _load_collections_tree(true);
    });

    jQuery('#collections_tree_search').keyup(function () {
        var v = jQuery('#collections_tree_search').val();
        if (jQuery('#collections_tree').data('jstree_ready')) {
            jQuery('#collections_tree').jstree(true).search(v);
        }
    });

    jQuery('#collections_tree').on('dblclick', 'a', function (e) {
        e.preventDefault();
        window.location.href = jQuery(this).attr('href');
    });

    _load_collections_tree(false);
});

</script>
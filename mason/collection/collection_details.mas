<%args>
$collection_id
$collection_name
$description     => undef
$owner_username  => undef
$user_can_modify => 0
</%args>

<& /util/import_javascript.mas, classes => ['jquery', 'jquery.dataTables'] &>

<& /page/page_title.mas, title => "Image Folder: " . $collection_name &>

<&| /page/info_section.mas, title => "Folder Details", collapsible => 1, collapsed => 0 &>
  <table class="table table-bordered table-condensed">
    <tr>
      <td style="width:25%;"><b>Name</b></td>
      <td><span id="collection_name_display"><% $collection_name | h %></span></td>
    </tr>
    <tr>
      <td><b>Description</b></td>
      <td><span id="collection_description_display"><% ($description || '—') | h %></span></td>
    </tr>
    <tr>
      <td><b>Created by</b></td>
      <td><% ($owner_username || '—') | h %></td>
    </tr>
  </table>

% if ($user_can_modify) {
  <button class="btn btn-default btn-sm" id="rename_collection_button">Rename folder</button>
  <button class="btn btn-danger btn-sm" id="delete_collection_button">Delete folder</button>
% }
</&>

<&| /page/info_section.mas, title => "Images in this Folder", collapsible => 1, collapsed => 0 &>

% if ($user_can_modify) {
  <div style="margin-bottom:10px;">
    <button class="btn btn-danger btn-sm" id="remove_selected_button">
      Remove selected images from folder
    </button>
  </div>
% }

% if ($user_can_modify) {
<button class="btn btn-primary btn-sm" id="open_add_images_modal_button">
  <span class="glyphicon glyphicon-plus"></span> Add Images
</button>
% }

  <table id="collection_images_table" class="table table-hover table-condensed" style="width:100%">
    <thead>
      <tr>
% if ($user_can_modify) {
        <th></th>
% }
        <th>Image</th><th>Filename</th><th>Description</th>
        <th>Submitter</th><th>Associations</th><th>Accession</th>
        <th>Observations</th><th>Tags</th>
      </tr>
    </thead>
  </table>
</&>

<div class="modal fade" id="add_images_to_collection_dialog" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title">Add Images to Folder</h4>
      </div>
      <div class="modal-body">

        <div class="form-inline" style="margin-bottom:10px;">
          <input type="text" class="form-control" id="add_images_search_box"
                 placeholder="Search by filename or description..."
                 style="width:320px;">
          <button class="btn btn-default" id="add_images_search_button">Search</button>
        </div>

        <div style="margin-bottom:8px;">
          <span class="text-muted">
            <span id="add_images_selected_count">0</span> image(s) selected
          </span>
          <button class="btn btn-link btn-xs" id="add_images_clear_selection_button">
            clear selection
          </button>
        </div>

        <table id="add_images_search_table"
               class="table table-hover table-condensed" style="width:100%">
          <thead>
            <tr>
              <th></th>
              <th>Image</th>
              <th>Filename</th>
              <th>Description</th>
              <th>Submitter</th>
            </tr>
          </thead>
        </table>

      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="add_images_submit_button">
          Add Selected
        </button>
      </div>
    </div>
  </div>
</div>

<div id="collection_id_div" style="display:none;"><% $collection_id %></div>

<script>
jQuery(document).ready(function () {

    var collection_id  = jQuery('#collection_id_div').text();
    var can_modify     = <% $user_can_modify ? 1 : 0 %>;

    var ajax_data = { collection_id_list: collection_id };
    if (can_modify) {
        ajax_data.html_select_box = 'collection_image_select';
    }
    console.log("ajax data:", ajax_data);

    var table = jQuery('#collection_images_table').DataTable({
        'ajax': {
            'url':  '/ajax/search/images',
            'type': 'POST',
            'data': ajax_data,
            'dataSrc': function(json) {
                (json.data || []).forEach(function(row) {
                    var imgElement = jQuery(row[1]).find('img');
                    imgElement.attr('width', '140');
                    var anchorElement = jQuery(row[1]);
                    anchorElement.html(imgElement.prop('outerHTML'));
                    row[1] = anchorElement.prop('outerHTML');
                });
                return json.data;
            }
        },
        'searching':  false,
        'serverSide': true,
        'searching': true,
        'processing': true,
        'lengthMenu': [20, 50, 100],
        'ordering':   false
    }).on('draw', function () {
        jQuery('.image_search_group').colorbox({ rel: 'image_search_group' });
    });

    function selectedImageIds() {
        var ids = [];
        jQuery('input[name="collection_image_select"]:checked').each(function () {
            ids.push(jQuery(this).val());
        });
        return ids;
    }

    jQuery('#remove_selected_button').click(function () {
        var ids = selectedImageIds();
        if (!ids.length) {
            alert('Please select at least one image to remove.');
            return;
        }
        if (!confirm('Remove ' + ids.length + ' image(s) from this folder? '
                   + 'The images themselves are not deleted.')) {
            return;
        }
        jQuery.ajax({
            url:  '/ajax/collection/remove_items',
            type: 'POST',
            data: {
                collection_id:  collection_id,
                item_type: 'image',
                item_ids_json: JSON.stringify(ids)
            },
            success: function (response) {
                if (response.error) { alert(response.error); return; }
                table.ajax.reload();
            },
            error: function () { alert('An error occurred removing the images.'); }
        });
    });

    jQuery('#rename_collection_button').click(function () {
        var current  = jQuery('#collection_name_display').text();
        var new_name = prompt('New folder name:', current);
        if (new_name === null) { return; }

        jQuery.ajax({
            url:  '/ajax/image_collection/rename',
            type: 'POST',
            data: { collection_id: collection_id, name: new_name },
            success: function (response) {
                if (response.error) { alert(response.error); return; }
                location.reload();
            },
            error: function () { alert('An error occurred renaming the folder.'); }
        });
    });

    jQuery('#delete_collection_button').click(function () {
        if (!confirm('Delete this folder? The images in it are not deleted.')) { return; }
        jQuery.ajax({
            url:  '/ajax/image_collection/delete',
            type: 'POST',
            data: { collection_id: collection_id },
            success: function (response) {
                if (response.error) { alert(response.error); return; }
                window.location.href = '/image/collections';
            },
            error: function () { alert('An error occurred deleting the folder.'); }
        });
    });

    var collection_id = <% $collection_id %>;
    var picked_image_ids = new Set();
    var add_images_table = null;

    function esc(s) {
        return jQuery('<div>').text(s == null ? '' : s).html();
    }

    function updateSelectedCount() {
        jQuery('#add_images_selected_count').text(picked_image_ids.size);
    }

    function initAddImagesTable() {
        if (add_images_table) { return; }

        add_images_table = jQuery('#add_images_search_table').DataTable({
            'ajax': {
                'url': '/ajax/search/images',
                'type': 'POST',
                'data': function (d) {
                    d.html_select_box = 'add_images_select';
                    d.image_description_filename_composite =
                        jQuery('#add_images_search_box').val();
                }
            },
            'serverSide': true,
            'processing': true,
            'searching': false,
            'lengthMenu': [10, 25, 50],
            'ordering': false,
            'columns': [
                { 'data': 0, 'orderable': false },   // checkbox column from html_select_box
                { 'data': 1 },                        // colorbox thumbnail
                { 'data': 2 },                        // filename link
                { 'data': 3 },                        // description
                { 'data': 4 }                         // submitter
            ]
        });

        // Re-apply checked state after every redraw: serverSide rebuilds the
        // tbody on each page turn / search, so checked boxes from a prior
        // page are gone from the DOM even though picked_image_ids still
        // remembers them.
        add_images_table.on('draw', function () {
            jQuery('input[name="add_images_select"]').each(function () {
                var id = parseInt(jQuery(this).val(), 10);
                jQuery(this).prop('checked', picked_image_ids.has(id));
            });
        });
    }

    jQuery('#open_add_images_modal_button').click(function () {
        picked_image_ids.clear();
        updateSelectedCount();
        jQuery('#add_images_search_box').val('');
        jQuery('#add_images_to_collection_dialog').modal('show');

        initAddImagesTable();
        add_images_table.ajax.reload();
    });

    jQuery('#add_images_search_button').click(function () {
        add_images_table.ajax.reload();
    });
    jQuery('#add_images_search_box').on('keypress', function (e) {
        if (e.which === 13) { add_images_table.ajax.reload(); }
    });

    jQuery('#add_images_search_table').on('change', 'input[name="add_images_select"]', function () {
        var id = parseInt(jQuery(this).val(), 10);
        if (jQuery(this).is(':checked')) {
            picked_image_ids.add(id);
        } else {
            picked_image_ids.delete(id);
        }
        updateSelectedCount();
    });

    jQuery('#add_images_clear_selection_button').click(function () {
        picked_image_ids.clear();
        jQuery('input[name="add_images_select"]').prop('checked', false);
        updateSelectedCount();
    });

    jQuery('#add_images_submit_button').click(function () {
        if (!picked_image_ids.size) {
            alert('Please select at least one image.');
            return;
        }

        jQuery.ajax({
            url: '/ajax/collection/add_items',
            type: 'POST',
            data: {
                collection_id: collection_id,
                item_type: 'image',
                item_ids_json: JSON.stringify(Array.from(picked_image_ids))
            },
            success: function (response) {
                if (response.error) { alert(response.error); return; }

                jQuery('#add_images_to_collection_dialog').modal('hide');

                // Refresh the folder's own image grid (from collection_images_table
                // earlier in this file) and any visible counts.
                if (jQuery.fn.DataTable.isDataTable('#collection_images_table')) {
                    jQuery('#collection_images_table').DataTable().ajax.reload(null, false);
                }
                jQuery(document).trigger('collection:contents_changed', [collection_id]);
            },
            error: function () {
                alert('An error occurred adding images to this folder.');
            }
        });
    });
});
</script>
<%doc>

=head1 NAME

/collection/create_collection_modal.mas - shared "New Collection" dialog

=head1 USAGE

  <& /collection/create_collection_modal.mas &>
  <& /collection/create_collection_modal.mas, default_type => 'file' &>

Open from any button on the page with:

  window.create_collection_dialog_open();            // uses default_type
  window.create_collection_dialog_open('file');      // preset type

The dialog offers name, type (Image/File), breeding program (optional), and
description; on success it navigates to the new collection's detail page.

Requires jQuery; includes /collection/message_modal.mas itself (guarded, so
double inclusion is harmless).

=head1 AUTHORS

=cut

</%doc>

<& /collection/message_modal.mas &>

<%args>
$default_type => 'image'
</%args>

<div class="modal fade" id="create_collection_dialog" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">&times;</button>
        <h4 class="modal-title">New Collection</h4>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label>Collection name</label>
          <input type="text" class="form-control" id="new_collection_name">
        </div>
        <div class="form-group">
          <label>Collection type</label>
          <select class="form-control" id="new_collection_type">
            <option value="image">Image</option>
            <option value="file">File</option>
          </select>
        </div>
        <div class="form-group">
          <label>Breeding program</label>
          <select class="form-control" id="new_collection_breeding_program">
            <option value="">No program</option>
          </select>
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea class="form-control" id="new_collection_description" rows="2"></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="create_collection_submit">Create</button>
      </div>
    </div>
  </div>
</div>

<script>
jQuery(document).ready(function () {

    window.create_collection_dialog_open = function (type) {
        jQuery('#new_collection_name').val('');
        jQuery('#new_collection_description').val('');
        jQuery('#new_collection_type').val(type || '<% $default_type %>');
        jQuery('#create_collection_dialog').modal('show');
    };

    // Breeding program dropdown for the create dialog.
    jQuery.ajax({
        url: '/ajax/html/select/breeding_programs',
        data: { id: 'new_collection_breeding_program', name: 'breeding_program', empty: '' },
        success: function (response) {
            var options = '<option value="">No program</option>' + response.select;
            // Drop the helper's "Please select a program" entry, if present.
            options = options.replace(/<option value="">Please select a program<\/option>/, '');
            jQuery('#new_collection_breeding_program').html(options);
            // The plain "No program" option must stay the default selection.
            jQuery('#new_collection_breeding_program').val('');
        }
    });

    jQuery('#create_collection_submit').click( function() {
        var name = jQuery('#new_collection_name').val();
        if (!name || !name.trim()) {
            window.collection_notify_error('Please enter a folder name.');
            return;
        }
        var data = {
            name:        name,
            description: jQuery('#new_collection_description').val(),
            collection_type: jQuery('#new_collection_type').val()
        };
        var bp_id = jQuery('#new_collection_breeding_program').val();
        if (bp_id) { data.breeding_program_id = bp_id; }
        jQuery.ajax({
            url: '/ajax/collection/create',
            type: 'POST',
            data: data,
            success: function (response) {
                if (response.error) { window.collection_notify_error(response.error); return; }
                jQuery('#create_collection_dialog').modal('hide');
                window.location.href = '/collection/' + response.collection_id;
            },
            error: function () { window.collection_notify_error('An error occurred creating the collection.'); }
        });
    });

});
</script>
<%args>
$stock_id
$type_name
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<div class="panel panel-default">
	<div class="panel-body panel-body-sm">
		<b> <% $c->i18n->p("accession.stock.trials.title", "Trials") |h %> </b>
		<br/> <br/>
		<table class="table table-hover table-bordered" id="trial_summary_data">
			<thead>
			  <tr>
				<th><% $c->i18n->p("accession.stock.trials.header.name", "Trial name") |h %></th>
				<th><% $c->i18n->p("accession.stock.trials.header.location", "Location") |h %></th>
				<th><% $c->i18n->p("accession.stock.trials.header.details", "Details") |h %></th>
			  </tr>
			</thead>
		</table>
	</div>
</div>

% if ($type_name eq "accession") {
<div class="panel panel-default">
	<div class="panel-body panel-body-sm">
		<b> <% $c->i18n->p("accession.stock.trials.analyses", "Stored Analyses") |h %> </b>
		<br/> <br/>
		<table class="table table-hover table-bordered" id="analysis_usage_data">
			<thead>
				<tr>
					<th><% $c->i18n->p("accession.stock.trials.analyses_header.name", "Name") |h %></th>
				</tr>
			</thead>
		</table>
	</div>
</div>
% }

<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<script>

    jQuery(document).ready(function () {
        jQuery('#stock_trials_section_onswitch').click(function(){
            jQuery('#trial_summary_data').DataTable( {
                'destroy': true,
                'ajax': '/stock/'+ <% $stock_id %> + '/datatables/trials',
            });
% if ($type_name eq "accession") {
			jQuery('#analysis_usage_data').DataTable( {
                'destroy': true,
                'ajax': '/stock/'+ <% $stock_id %> + '/datatables/stored_analyses',
            });
% }
        });
    });

</script>
<%doc>

=head1 NAME

stock/barcode/confirm_store.mas - a mason component for displaying message after attempting to store stock phenotyping data.

=AUTHOR

Naama Menda <nm249@cornell.edu>

=cut

</%doc>

<%args>

$error => undef
$data => undef # formatted data to be printed on confirmation page
$feedback_email => undef
$message => undef

</%args>

<%perl>

</%perl>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.store_uploaded_barcode_data", "Store uploaded barcode data")) &>
<&| /page/info_section.mas, anchor_title => "Upload status", title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.upload_status", "Upload status")) &>
    <h4><div> <% $error %> </div></h4>
    <div> <% $message %></div>
  </form>
</&>

<%once>
use HTML::Entities ();
</%once>

<%once>
use HTML::Entities ();
</%once>
<%doc>

=head1 NAME

/stock/index.mas - a page for displaying stock details (e.g. accession, population, etc.)

=head1 DESCRIPTION

parameters:

=over 1

=item $stockref

a hashref with all the parameters needed for printing the stock page!

 $stockref->{stock_id}
 $stockref->{stock}
 $stockref->{schema}
 $stockref->{uniquename}
 $stockref->{curator}  (boolean)
 $stockref->{submitter} (boolean)
 $stockref->{is_owner} (boolean)
 $stockref->{props} (hash of arrayrefs of stockprops. Keys = prop name, value = prop value)
 $stockref->{has_pedigree} (boolean)
 $stockref->{has_descendants} (boolean)
 locus_add_uri
 locus_autocomplete_uri => '/ajax/locus/autocomplete/'
 cvterm_add_uri
 cvterm_autocomplete_uri => '/ajax/cvterm/autocomplete/'
 barcode_tempdir
 barcode_tempuri
 organism_autocomplete_uri => '/ajax/organism/autocomplete/'

=back

=head1 AUTHOR

Naama Menda <nm249@cornell.edu>

=cut

</%doc>

<%args>
$stock_row
$stockref => undef
$locus_add_uri => ''
$locus_autocomplete_uri => undef
$cvterm_add_uri => ''
$cvterm_autocomplete_uri => undef
$barcode_tempdir => undef
$barcode_tempuri => undef
$identifier_prefix => 'SGN'
$organism_autocomplete_uri => '/ajax/organism/autocomplete/'
$image => undef
$image_url => undef
</%args>


<%perl>

use Bio::Chado::Schema;
use CXGN::Chado::Stock;
use CXGN::Page::FormattingHelpers qw / html_optional_show info_table_html /;
use CXGN::People::Person;
use CXGN::Chado::Publication;
use CXGN::Cview::Map::SGN::Genotype;
use CXGN::Cview::MapOverviews;
use SGN::Image;
my $ui_add_synonym = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.add_synonym", "Add Synonym"));
my $ui_add_info = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.add_info", "Add Additional Info"));
my $ui_login_add = HTML::Entities::encode_entities($c->i18n->p("accession.stock.tooltip.login_add", "Login to add info"));
my $ui_download_all_phenotypes = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.download_all_phenotypes", "Download All Phenotypes"));
my $ui_download_phenotypes = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.download_phenotypes", "Download Phenotypes"));
my $ui_associate_publication = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.associate_publication", "Associate publication"));
my $ui_add_ontology = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.add_ontology", "Add ontology annotations"));
my $ui_add_phenotype = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.add_phenotype", "[Add phenotype]"));
my $ui_direct_plot = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.direct_phenotyping", "Direct plot phenotyping"));
my $ui_upload_qpcr = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.upload_qpcr", "Upload qPCR Data"));
my $ui_add_family_members = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.add_family_members", "Add Family Members"));
my $ui_add_sequencing = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.add_sequencing", "Add sequencing info"));
my $ui_add_parent = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.add_parent", "Add parent"));
my $ui_remove_parent = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.remove_parent", "Remove parent"));
my $ui_add_image = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.add_image", "Add new image"));
my $ui_compare_images = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.compare_images", "Compare Images"));
my $ui_add_released_variety = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.add_released_variety", "Add released variety name"));
my $ui_login_locus = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.login_locus", "[log-in to associate new locus]"));
my $ui_new_qtl = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.new_qtl", "New QTL population"));
my $ui_stock_search = HTML::Entities::encode_entities($c->i18n->p("accession.stock.action.stock_search", "Back to stock search"));

my $trial_stock_type => undef;
my $stock = $stockref->{stock};
my $stock_id = $stockref->{stock_id};
my $action = $stockref->{action} || 'view';
my $person_id = $stockref->{person_id};
my $curator = $stockref->{curator};
my $submitter = $stockref->{submitter};
my $sequencer = $stockref->{sequencer};
my $pubs = $stockref->{pubs};
my $has_pedigree = $stockref->{has_pedigree};
my $has_descendants = $stockref->{has_descendants};
my $trait_ontology_db_name = $stockref->{trait_ontology_db_name};
my $editable_stock_props_string = $stockref->{editable_stock_props};
my $schema = $stockref->{schema};
my $dbh = $stockref->{dbh};
my $is_obsolete = $stockref->{is_obsolete};
my $is_a_transgenic_line = $stockref->{is_a_transgenic_line};
my $derived_accession_relationship = $stockref->{derived_accession_relationship};
my $related_stock_link = $stockref->{related_stock_link};
my $original_stock_link = $stockref->{original_stock_link};
my $vector_related_genes = $stockref->{vector_related_genes};
my $vector_analyzed_tissue_types = $stockref->{vector_analyzed_tissue_types};
my $number_of_insertions = $stockref->{number_of_insertions};
my $is_a_parent = $stockref->{is_a_parent};
my $family_type_string = $stockref->{family_type_string};
my $family_type = $stockref->{family_type};

my @editable_stock_props = split "," , $editable_stock_props_string;


my ($type_name, $uniquename);
my $type = $stock_row ? $stock_row->type : undef;
$type_name  = $type->name() if $type;
$uniquename = $stock->get_uniquename if $type;

my @editable_vector_props;

if($type_name eq 'vector_construct'){
  my $editable_vector_props_string = $stockref->{editable_vector_props};
  @editable_vector_props = split "," , $editable_vector_props_string;
}

#################
my $is_owner = $stockref->{is_owner};

my $this_page = "/stock/$stock_id/view";

my $image_ids =  $stockref->{image_ids} || [] ;
my $related_image_ids =  $stockref->{related_image_ids} || [] ;
my $stockprops = $stockref->{props};

my @valid_image_ids;
foreach my $image (@$image_ids) {
    my $image_id = $image->[0];
    my $image_obj = SGN::Image->new($schema->storage->dbh, $image_id, $c);
    if ($image_obj->get_md5sum()) {
        push(@valid_image_ids, $image)
    }
}
$image_ids = \@valid_image_ids;

#my $pedigree= ['pedigree', 'male parent', 'female parent'];
# get pedigree of stock
#my $stock_pedigree = $stockref->{stock_pedigree};
#my $stock_descendants = $stockref->{stock_descendants};

my $allele_div = "stock_alleles";
my $new_locus_link = !$person_id ? qq|<a href="/user/login">$ui_login_locus</a> | : '' ;

#owner
my $owners = $stockref->{editor_info};
my $owner_ids = $stockref->{owners};
my $owners_html = '';
my %unique_owners;
foreach my $o_id (@$owner_ids) {
    $unique_owners{$o_id}++;
}
my @owner_ids = keys %unique_owners;
foreach my $o_id (@owner_ids){
  my $person = CXGN::People::Person->new($dbh, $o_id);
  my $first_name = $person->get_first_name;
  my $last_name = $person->get_last_name;
  $owners_html .= qq|<a href="/solpeople/personal-info.pl?sp_person_id=$o_id">$first_name $last_name</a> |;
}

my $ui_header_editor = HTML::Entities::encode_entities($c->i18n->p("accession.stock.editor_table.editor", "Editor"));
my $ui_header_timestamp = HTML::Entities::encode_entities($c->i18n->p("accession.stock.editor_table.timestamp", "Timestamp"));
my $ui_header_modification_note = HTML::Entities::encode_entities($c->i18n->p("accession.stock.editor_table.modification_note", "Modification Note"));
my $ui_header_obsolete_note = HTML::Entities::encode_entities($c->i18n->p("accession.stock.editor_table.obsolete_note", "Obsolete Note"));
my $editor_link_table;
if ($is_obsolete) {
    $editor_link_table = "<table class='table table-bordered'><thead><tr><th>$ui_header_editor</th><th>$ui_header_timestamp</th><th>$ui_header_modification_note</th><th>$ui_header_obsolete_note</th></tr></thead><tbody>";
    foreach my $o_id (@$owners) {
        my $person = CXGN::People::Person->new($dbh, $o_id->[0]);
        my $first_name = $person->get_first_name;
        my $last_name = $person->get_last_name;
        $editor_link_table .= qq|<tr><td><a href="/solpeople/personal-info.pl?sp_person_id=$o_id->[0]">$first_name $last_name</a></td><td>$o_id->[1]</td><td>$o_id->[2]</td><td>$o_id->[3]</td></tr>|;
    }
} else {
    $editor_link_table = "<table class='table table-bordered'><thead><tr><th>$ui_header_editor</th><th>$ui_header_timestamp</th><th>$ui_header_modification_note</th></tr></thead><tbody>";
    foreach my $o_id (@$owners) {
        my $person = CXGN::People::Person->new($dbh, $o_id->[0]);
        my $first_name = $person->get_first_name;
        my $last_name = $person->get_last_name;
        $editor_link_table .= qq|<tr><td><a href="/solpeople/personal-info.pl?sp_person_id=$o_id->[0]">$first_name $last_name</a></td><td>$o_id->[1]</td><td>$o_id->[2]</td></tr>|;
    }
}

$editor_link_table .= "</tbody></table>";
$editor_link_table = "<br/>".$owners_html."<br/><br/>".$editor_link_table;

#phenotypes measured directly on this stock
my $direct_phenotypes = $stockref->{direct_phenotypes} || undef;

# get all phenotypes of subjects
my $members_phenotypes = $stockref->{members_phenotypes};
my $p_download_link = '<a class="btn btn-sm btn-default" style="margin:3px" target="_blank" href = "/breeders/trials/phenotype/download?format=csv&timestamp=1&dataLevel=all&'.$type_name.'_list=['.$stock_id.']&search_type=complete&">' . $ui_download_all_phenotypes . '</a>';

############################
my $map_html = $stockref->{map_html};
my $map;
if ($stock_id) {
  $map = CXGN::Cview::Map::SGN::Genotype->new($dbh, $stock_id);
  if ($map->get_chromosome_count > 1 ) {
    my $overview = CXGN::Cview::MapOverviews::Generic->new($map,
                                                           {
                                                            dbh=> $dbh,
                                                            basepath => $stockref->{cview_basepath},
                                                            tempfiles_subdir => $stockref->{cview_tmp_dir } });
    if ($overview) {
      $overview->render_map();
      $map_html .= $overview->get_image_html();
    }
  }
}
#########################################
my $has_qtl_data = $stockref->{has_qtl_data};


my $new_pub_link = $curator || $submitter || $sequencer  ?   qq|<a class="btn btn-sm btn-default" style="margin:3px" href="/chado/add_publication.pl?type=stock&amp;type_id=$stock_id&amp;refering_page=$this_page&amp;action=new">$ui_associate_publication</a>| : qq|<span class=\"btn btn-sm btn-default ghosted\" style="margin:3px" disabled>$ui_associate_publication</span>| ;

## EUSOL, tgrc (stock_dbxref)
my $dbxrefs = $stockref->{dbxrefs};
my %source_dbs;
foreach my $db_name ( keys %$dbxrefs ) {
  foreach my $dbxref ( @{ $dbxrefs->{$db_name} } ) {
    my $url = $dbxref->db->urlprefix . $dbxref->db->url;
    $url .= $dbxref->accession if $url ;
    $source_dbs{$url} = $db_name . ": " . $dbxref->accession if $url;
  }
}

my $ontology_subtitle = $curator || $submitter || $sequencer  ?
  qq|<a class="btn btn-sm btn-default" style="margin:3px" href="javascript:Tools.toggleContent('associate_cvterm_form', 'stock_ontology')">$ui_add_ontology</a> | :
  qq |<span class = "btn btn-default btn-sm ghosted" style="margin:3px" disabled>$ui_add_ontology</span> |;

my $add_phenotype_link =  $curator || $submitter || $sequencer  ? qq| <a href="javascript:Tools.toggleContent('add_phenotype_form', 'stock_phenotype')" >$ui_add_phenotype</a> | :   qq |<span class = "ghosted"> $ui_add_phenotype</span> |;

my $edit_privs = $curator || $submitter || $sequencer;

my $jbrowse_path = $c->config->{jbrowse_path};
my @path_parts = split('/', $jbrowse_path);
my $basepath = $path_parts[1];
my $test_url = "/" . $basepath . "/jbrowse.conf";
my $jbrowse_url = $jbrowse_path . "%2Faccessions%2F" . $stock_id . "&tracks=DNA%2CGene%20exons%2C" . $uniquename . "_2015_V6_imputed&highlight=";


my $released_variety_link = '<button class="btn btn-default btn-sm" style="margin:3px" id="released_variety_link" disabled>' . $ui_add_released_variety . '</button>';

if ($person_id && ($submitter || $curator || $sequencer)) { $released_variety_link = qq | <button class="btn btn-default btn-sm" style="margin:3px" id="released_variety_link" >$ui_add_released_variety</button> |; }

</%perl>

<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<& /util/import_javascript.mas,
   classes => ["bootstrap_min", "d3.d3v4Min", "jquery", "jqueryui", "jquery.dataTables-buttons-min", "thickbox", "CXGN.Page.FormattingHelpers", "jquery.cookie", "CXGN.Stock", "jquery.dataTables" ],
  entries => ["sequenced_accessions"  ]
&>

<script language="javascript">
function jqueryStuff() {
   jQuery(function() {
     jQuery("#species_name").autocomplete({
        source: '/organism/autocomplete'
     });
  });
}
</script>

<div class="details-header">
    <& /page/page_title.mas, title=> join( ': ', grep $_, ucfirst($type_name), $uniquename ) || HTML::Entities::encode_entities($c->i18n->p("accession.stock.page.new_stock", "Create a new stock")) &>
</div>

<&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.details", "Stock details")) , collapsible=>1, collapsed=>0, subtitle => "<button class='btn btn-sm btn-default' style='margin:3px' name='stock_new_qtl_link'>$ui_new_qtl</button> <button class='btn btn-sm btn-default' style='margin:3px' name='stock_go_to_stock_search'>$ui_stock_search</button>"  &>

    <div class="panel panel-default">
        <div class="panel-body">

            <div class="row">
                <div class="col-sm-6">

                    <& /page/form.mas,
                        object_type=>'stock',
                        object_id=>"$stock_id",
                        form_name=> 'stock_form',
                        server_side_script => '/phenome/stock/stock_ajax_form.pl',
                        form_div_name=>'stock_details',
                        js_object_name=> 'stockForm',
                        page_url => "/stock/$stock_id/view/" ,
                        #alternate_new_button => '<a class="btn btn-sm btn-default" href ="/stock/0/new">New</a>'
                        alternate_new_button => '',,
                        alternate_ghosted_new_button => '',
                        alternate_delete_button => '',
                        alternate_ghosted_delete_button => ''
                    &>


                </div>
                <%perl>
                if ($type_name eq 'accession') {
                </%perl>
                <div class="col-sm-6">
                    <div style="position: relative;">
                        <button class="btn btn-default btn-small" id="toggle_qr_code" style="position: absolute; right: 10px; top: 10px; z-index: 10;"><% $c->i18n->p("accession.stock.action.show_qr", "Show QR Code") |h %></button>
                    </div>
                </div>

                <div id ="qr_code_display" style="display: none; text-align: center; margin-top: 40px;">
                    <div style="text-align: center;">
                    <& /util/barcode.mas, identifier => "$identifier_prefix"."$stock_id", text=> "$identifier_prefix stock $stock_id ($uniquename)", format=>"stock_qrcode" &>
                    </div>
                </div>

                <div class="col-sm-6">
                    <br /><br />
                    <div style="display: flex; justify-content: center; align-items; height: 100%; margin-top: 20px;">
                        <%perl>
                        use SGN::Image;
                        my $schema = $stockref->{schema};
                        my $stock_id = $stockref->{stock_id};

                        my $display_image_cvterm_id = SGN::Model::Cvterm->get_cvterm_row($schema, 'selected_display_image', 'stock_property')->cvterm_id();
                        my $stockprop = $schema->resultset('Stock::Stockprop')->find({ stock_id => $stock_id, type_id => $display_image_cvterm_id });

                        if ($stockprop) {
                            my $image_id = $stockprop->value;
                            my $image = SGN::Image->new($schema->storage->dbh, $image_id, $c);
                            $image_url = $image->get_image_url('small');
                        } else {
                            my $image_id = $stockref->{image_ids}->[0]->[0];
                            my $image = SGN::Image->new($schema->storage->dbh, $image_id, $c);
                            $image_url = $image->get_image_url('small');
                        }

                        my $no_img_url = '/data/images/image_files/XX/XX/XX/XX/XXXXXXXXXXXXXXXXXXXXXXXX/small';
                        my $no_img_url_test = '/data/images/image_files_test/XX/XX/XX/XX/XXXXXXXXXXXXXXXXXXXXXXXX/small';

                        if (index($image_url, $no_img_url) != -1 || index($image_url, $no_img_url_test) != -1) {
                        </%perl>
                        <p><% $c->i18n->p("accession.stock.image.none", "No accession image to display") |h %></p>
                        <%perl>
                            } else {
                        </%perl>
                        <img src="<% $image_url %>" class="img-responsive" style="max-width: 100%; height: auto;" />
                        <%perl>
                            }
                        </%perl>

                    </div>
                    <br /><br />
                </div>
            <%perl>
            } else {
            </%perl>
                <div class="col-sm-6">
                    <br /><br />
                    <& /util/barcode.mas, identifier => "$identifier_prefix"."$stock_id", text=> "$identifier_prefix stock $stock_id ($uniquename)", format=>"stock_qrcode"  &>
                    <br /><br />
                </div>
                <%perl>
                }
                </%perl>
            </div>

	    <div class="row">
              <div class="col-sm-6">
		<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.released_variety", "Released variety name")), subtitle=>$released_variety_link, is_subsection => 1 &>
		  <& /stock/stockprops.mas,
		     stock_id  =>$stock_id,
		    form_div_id => 'released_variety_link',
		    props      => ['released_variety_name'],
		    div_name   => 'released_variety_name',
		    edit_privs => $edit_privs,
		    subset     => ['released_variety_name'],
		    editable   => ['released_variety_name']  &>
                 </&>
	      </div>
              </div>
              <div class="row">
                <div class="col-sm-6">
	        </div>
	      </div>
          </div>
       </div>
</&>

<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.navigator", "Navigator")) , collapsible=> 1, collapsed=>0 &>

% if ($type_name eq 'population') {
    <& /page/detail_page_2_col_section.mas, stock_id => $stock_id, stock_uniquename => $uniquename, type_name => $type_name,  info_section_title => '<h4 style="display:inline">' . HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.members", "Members")) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.members_help", "View members in this population .")), icon_class => "glyphicon glyphicon-list-alt", info_section_id => "population_members_section", info_section_collapsed => 0 &>
    <& /page/detail_page_2_col_section.mas, stock_id => $stock_id, type_name => $type_name,  info_section_title => '<h4 style="display:inline">' . HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.seedlot_info", "Seedlot Info")) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.seedlot_info_help", "View seedlot information of each member in this population .")), icon_class => "glyphicon glyphicon-retweet", info_section_id => "population_seedlot_info_section", info_section_collapsed => 1 &>
% }

% my $subtitle = $edit_privs ? '<button class="btn btn-sm btn-primary" style="margin:3px" id="stock_add_synonym" >' . $ui_add_synonym . '</button>' : '<button disabled class="btn btn-sm btn-primary" style="margin:3px" title="' . $ui_login_add . '">' . $ui_add_synonym . '</button>';
% my $props_subtitle = $edit_privs ? '<button class="btn btn-sm btn-primary" style="margin:3px" id="stock_add_props" >' . $ui_add_info . '</button>' : '<button disabled class="btn btn-sm btn-primary" style="margin:3px" title="' . $ui_login_add . '">' . $ui_add_info . '</button>';

% if ($type_name eq 'plot' || $type_name eq 'plant' || $type_name eq 'subplot' || $type_name eq 'tissue_sample') {
    <& /page/detail_page_2_col_section.mas, stock_id => $stock_id, info_section_title => '<h4 style="display:inline">' . HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.experiment_usage", "Experiment Usage")) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.experiment_usage_help", "View experiments that this stock has been used in.")), icon_class => "glyphicon glyphicon-leaf", info_section_id => "stock_trials_section" &>
    <& /page/detail_page_2_col_section.mas, stock_id => $stock_id, info_section_title => '<h4 style="display:inline">' . HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.related_stocks", "Related Stocks")) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.related_stocks_help", "View any accession, plot, plant, and/or tissue_sample that are linked to this stock.")), icon_class => "glyphicon glyphicon-retweet", info_section_id => "stock_related_stock_section", stock_uniquename => $uniquename, type_name => $type_name &>
%   my $trait_assayed_buttons = $type_name eq 'plot' ? "<button class='btn btn-sm btn-primary' style='margin:3px' id='stock_download_phenotypes_button'>$ui_download_phenotypes</button> $p_download_link <a class='btn btn-sm btn-default' style='margin:3px' target='_blank' href = '/breeders/plot_phenotyping?stock_id=$stock_id'>$ui_direct_plot</a>" : "<button class='btn btn-sm btn-primary' style='margin:3px' id='stock_download_phenotypes_button'>$ui_download_phenotypes</button> $p_download_link";
    <& /page/detail_page_2_col_section.mas, stock_id => $stock_id, info_section_title => '<h4 style="display:inline">' . HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.traits_assayed", "Traits Assayed")) . '</h4>', info_section_subtitle => HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.traits_help", "View and download phenotypic data for this stock.")), icon_class => "glyphicon glyphicon-equalizer", info_section_id => "stock_traits_section", buttons_html => $trait_assayed_buttons &>
% }

%if ($type_name eq 'family_name') {

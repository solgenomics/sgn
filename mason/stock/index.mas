% my $m_rs = $members_phenotypes->{$key};
<&| /page/info_section.mas,
     title         => HTML::Entities::encode_entities($c->i18n->p("accession.stock.section.member_phenotypes", "Member phenotypes")),
     subtitle      => $key,
     is_subsection => 1,
     collapsible   => 1,
 &>

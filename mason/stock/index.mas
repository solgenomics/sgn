<div id="stock_trials_info_popup">
    <table id="stock_trials_info_table" >
        <thead>
            <tr><th><% $c->i18n->p("accession.stock.phenotype.header.trait", "Trait") |h %></th><th><% $c->i18n->p("accession.stock.phenotype.header.average", "Average") |h %></th><th><% $c->i18n->p("accession.stock.phenotype.header.stddev", "Std dev") |h %></th><th><% $c->i18n->p("accession.stock.phenotype.header.count", "Count") |h %></th></tr>
        </thead>
    </table>
</div>

<& /transformation/obsolete_stock_dialog.mas &>

<script>
    jQuery(document).ready(function() {

        const header = document.querySelector('.details-header');

        window.addEventListener('scroll', () => {
            if (window.scrollY > 20) {
            header.classList.add('is-stuck');
            } else {
            header.classList.remove('is-stuck');
            }
        });

        stock_detail_page_init_dialogs();

        jQuery('[name="stock_new_qtl_link"]').click(function(){
            window.location.href = '/phenome/qtl_form.pl';
        });

        jQuery('[name="stock_go_to_stock_search"]').click(function(){
            window.location.href = '/search/stocks/';
        });

        jQuery('#remove_parent_link').click( function() {
            jQuery('#remove_parent_dialog').dialog("open");
            get_remove_parents_list(<% $stock_id %>);
        });

        jQuery.ajax({
            url: "<% $test_url %>",
            success: function(response) {
                if ( response.indexOf("Accession_<%$stock_id%>") > -1 ) {  // if dataset is found, create and display link
                    jQuery('#jbrowse_check').replaceWith('<a id="jbrowse_link" href="<% $jbrowse_url %>">' + jQuery('<span>').text(window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.stock.jbrowse.tracks", "View the tracks for this accession in JBrowse") : 'View the tracks for this accession in JBrowse').html() + '</a>');
                }
                else { // if not found, display message that dataset doesn't exist
                    jQuery('#jbrowse_check').html(" <i>" + jQuery('<span>').text(window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.stock.jbrowse.no_data", "This accession does not have any data in Jbrowse.") : 'This accession does not have any data in Jbrowse.').html() + "</i>");
                }
            },
            error: function() {
                jQuery('#jbrowse_check').html(" <i>" + jQuery('<span>').text(window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.stock.jbrowse.not_configured", "Jbrowse has not been set up for this database.") : 'Jbrowse has not been set up for this database.').html() + "</i>");
            }
        });

        jQuery('#toggle_qr_code').click(function() {
            var qrCodeDisplay = jQuery('#qr_code_display');
            var buttonText = jQuery(this).text();

            qrCodeDisplay.toggle();
            if (qrCodeDisplay.is(':visible')) {
                jQuery(this).text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p('accession.stock.action.hide_qr', 'Hide QR Code') : 'Hide QR Code'));
            } else {
                jQuery(this).text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p('accession.stock.action.show_qr', 'Show QR Code') : 'Show QR Code'));
            }
        });


  });



</script>

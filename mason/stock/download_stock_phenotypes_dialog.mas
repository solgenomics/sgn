
<%args>
$stock_id
$stock_type
$stock_name => undef
</%args>

<%once>
use HTML::Entities ();
    my $default_repeat_measurements = $c->get_conf('pheno_download_default_repeat_measurements');
    my $default_include_timestamps = $c->get_conf('pheno_download_default_include_timestamps');
    my $default_include_intercrop_accessions = $c->get_conf('pheno_download_default_include_intercrop_accessions');
    my $default_include_entry_numbers = $c->get_conf('pheno_download_default_include_entry_numbers');
    my $default_include_trait_synonyms = $c->get_conf('pheno_download_default_include_trait_synonyms');
    my $default_supress_outliers = $c->get_conf('exclude_phenotype_outliers');
    my $default_include_pedigree_parents = $c->get_conf('pheno_download_default_include_pedigree_parents');
</%once>


<div class="modal fade" id="download_stock_phenotypes_dialog" name="download_stock_phenotypes_dialog" tabindex="-1" role="dialog" aria-labelledby="downloadStockPhenotypesDialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="downloadStockPhenotypesDialog">Download Phenotypes for <% $stock_name %></h4>
      </div>
      <div class="modal-body">
        <div class="container-fluid">

	       <form class="form-horizontal" role="form" method="post" >
	        <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p("lists_datasets.download.format.39442ac", "Format:") |h %> </label>
                <div class="col-sm-9" >
                    <select class="form-control" id="download_stock_phenotypes_format">
                        <option value="csv">CSV</option>
                        <option value="xlsx">Excel (xlsx)</option>
                    </select>
                </div>
	        </div>
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p("lists_datasets.download.data_level", "Data Level:") |h %> </label>
                <div class="col-sm-9" >
                    <select class="form-control" id="download_stock_phenotypes_level_option">
                        <option value="all"><% $c->i18n->p("global.search_wizard.all_levels", "All") |h %></option>
                        <option value="plot"><% $c->i18n->p("global.graphical_filtering.plots", "Plots") |h %></option>
                        <option value="plant"><% $c->i18n->p("global.graphical_filtering.plants", "Plants") |h %></option>
                    </select>
                </div>
            </div>

<&| /page/info_section.mas, anchor_title => "Additional Search Options", title=>HTML::Entities::encode_entities($c->i18n->p("phenotype.root.additional_search_options", "Additional Search Options")),  collapsible => 1, collapsed=>1 &>

            <div class="row form-group">
                <label class="col-sm-8 control-label"><% $c->i18n->p("phenotype.root.for_repeated_measurements_return_the", "For repeated measurements, return the:") |h %> </label>
                <div class="col-sm-4">
                    <select class="form-control" id="download_stock_phenotypes_repetitive_measurements_option">
                        <option value="first"><% $c->i18n->p("global.search_wizard.first_value", "First value") |h %></option>
                        <option value="last"><% $c->i18n->p("global.search_wizard.last_value", "Last value") |h %></option>
                        <option value="average"><% $c->i18n->p("global.search_wizard.averaged_value", "Averaged value") |h %></option>
                        <option value="sum"><% $c->i18n->p("global.search_wizard.sum_values", "Sum values") |h %></option>
                        <option value="all_values_single_line"><% $c->i18n->p("global.search_wizard.all_values_single_line", "All Values Single Line") |h %></option>
                        <option value="all_values_multiple_line"><% $c->i18n->p("global.search_wizard.all_values_multiple_line", "All Values Multiple Line") |h %></option>
                    </select>
                </div>
            </div>

            <div class="row form-group">
                <label class="col-sm-8 control-label"><% $c->i18n->p("phenotype.root.include_timestamps", "Include Timestamps:") |h %> </label>
                <div class="col-sm-4" >
                    <select class="form-control" id="download_stock_phenotypes_timestamp_option">
                        <option value="0"><% $c->i18n->p("global.search_wizard.no", "No") |h %></option>
                        <option value="1"><% $c->i18n->p("global.search_wizard.yes", "Yes") |h %></option>
                    </select>
                </div>
            </div>

            <div class="row form-group">
                <label class="col-sm-8 control-label"><% $c->i18n->p("lists_datasets.download.include_intercrop_accessions", "Include Intercrop Accessions:") |h %> </label>
                <div class="col-sm-4" >
                    <select class="form-control" id="download_stock_phenotypes_intercrop_accessions_option">
                        <option value="0"><% $c->i18n->p("global.search_wizard.no", "No") |h %></option>
                        <option value="1"><% $c->i18n->p("global.search_wizard.yes", "Yes") |h %></option>
                    </select>
                </div>
            </div>

            <div class="row form-group">
                <label class="col-sm-8 control-label"><% $c->i18n->p("phenotype.root.include_entry_numbers", "Include Entry Numbers:") |h %> </label>
                <div class="col-sm-4" >
                    <select class="form-control" id="download_stock_phenotypes_entry_numbers_option">
                        <option value="0"><% $c->i18n->p("global.search_wizard.no", "No") |h %></option>
                        <option value="1"><% $c->i18n->p("global.search_wizard.yes", "Yes") |h %></option>
                    </select>
                </div>
            </div>

            <div class="row form-group">
                <label class="col-sm-8 control-label"><% $c->i18n->p("phenotype.root.include_trait_synonyms", "Include Trait Synonyms:") |h %> </label>
                <div class="col-sm-4" >
                    <select class="form-control" id="download_stock_phenotypes_trait_synonyms_option">
                        <option value="0"><% $c->i18n->p("global.search_wizard.no", "No") |h %></option>
                        <option value="1"><% $c->i18n->p("global.search_wizard.yes", "Yes") |h %></option>
                    </select>
                </div>
            </div>

            <div class="row form-group">
                <label class="col-sm-8 control-label"><% $c->i18n->p("phenotype.root.suppress_user_defined_phenotype_outliers", "Suppress User Defined Phenotype Outliers:") |h %> </label>
                <div class="col-sm-4" >
                    <select class="form-control" id="download_stock_phenotypes_exclude_outliers">
                        <option value="0"><% $c->i18n->p("global.search_wizard.no", "No") |h %></option>
                        <option value="1"><% $c->i18n->p("global.search_wizard.yes", "Yes") |h %></option>
                    </select>
                </div>
            </div>

            <div class="row form-group">
                <label class="col-sm-8 control-label"><% $c->i18n->p("lists_datasets.download.include_parents", "Include Parents:") |h %> </label>
                <div class="col-sm-4" >
                    <select class="form-control" id="download_stock_phenotypes_pedigrees_option">
                        <option value="0"><% $c->i18n->p("global.search_wizard.no", "No") |h %></option>
                        <option value="1"><% $c->i18n->p("global.search_wizard.yes", "Yes") |h %></option>
                    </select>
                </div>
            </div>

            <div class="row form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.traits", "Traits:") |h %></label>
                <div class="col-sm-9" >
                    <div id="download_stock_phenotypes_traits">
                    </div>
                </div>
            </div>
           <div class="row form-group">
              <div class="col-sm-3"></div>
              <div class="col-sm-9">
                <div id="download_stock_phenotypes_select_all" class="btn btn-sm btn-primary" style="margin:3px"><% $c->i18n->p("phenotype.root.select_all_traits", "Select all traits") |h %></div>
                <div id="download_stock_phenotypes_select_reset" class="btn btn-sm btn-default" style="margin:3px"><% $c->i18n->p("phenotype.root.unselect_all_traits", "Unselect all traits") |h %></div>
              </div>
           </div>
</&>
        </form><br/>

        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" name="download_stock_phenotypes_cancel_button" id="download_stock_phenotypes_cancel_button" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
        <button type="button" class="btn btn-primary" name="download_stock_phenotypes_submit_button" id="download_stock_phenotypes_submit_button" title="<% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %>"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
      </div>
    </div>
  </div>
</div>

<script>

jQuery(document).ready(function() {
  setDefaultOptions();

  jQuery('#stock_download_phenotypes_button').click( function () {
    jQuery('#download_stock_phenotypes_dialog').modal("show");
    data_level_change_traits();
  });

  jQuery(document).on('change', "#download_stock_phenotypes_level_option", function() {
    data_level_change_traits();
  });

  jQuery(document).on('click', "#download_stock_phenotypes_select_all", function() {
    var trait_collection = document.getElementById('download_stock_phenotypes_traits_select').options;
    for (var index = 0; index < trait_collection.length; index += 1) {
      trait_collection[index].selected = true;
    };
  });

  jQuery(document).on('click', "#download_stock_phenotypes_select_reset", function() {
    var trait_collection = document.getElementById('download_stock_phenotypes_traits_select').options;
    for (var index = 0; index < trait_collection.length; index += 1) {
      trait_collection[index].selected = false;
    };
  });

  jQuery('#download_stock_phenotypes_submit_button').click( function () {
    var stock_type = "<% $stock_type %>";
    var stock_id = ["<% $stock_id %>"];
    var format = jQuery("#download_stock_phenotypes_format").val();
    var repetitive_measurements = jQuery("#download_stock_phenotypes_repetitive_measurements_option").val();
    var timestamp = jQuery("#download_stock_phenotypes_timestamp_option").val();
    var intercrop = jQuery("#download_stock_phenotypes_intercrop_accessions_option").val();
    var entry_numbers = jQuery("#download_stock_phenotypes_entry_numbers_option").val();
    var trait_synonyms = jQuery("#download_stock_phenotypes_trait_synonyms_option").val();
    var pedigrees = jQuery("#download_stock_phenotypes_pedigrees_option").val();
    var traits = jQuery("#download_stock_phenotypes_traits_select").val();
    if (! Array.isArray(traits) ) {
       traits = [ traits ];
    }

    var datalevel = jQuery("#download_stock_phenotypes_level_option").val();
    var exclude_phenotype_outlier = jQuery("#download_stock_phenotypes_exclude_outliers").val();
    window.open("/breeders/trials/phenotype/download?"+stock_type+"_list="+JSON.stringify(stock_id)+"&dataLevel="+datalevel+"&format="+format+"&timestamp="+timestamp+"&trait_list="+JSON.stringify(traits)+"&exclude_phenotype_outlier="+exclude_phenotype_outlier+"&repetitive_measurements="+repetitive_measurements+"&intercrop="+intercrop+"&entry_numbers="+entry_numbers+"&trait_synonyms="+trait_synonyms+"&include_pedigree_parents="+pedigrees);
  });

});

function setDefaultOptions() {
    var default_repeat_measurements = "<% $default_repeat_measurements %>";
    var default_include_timestamps = <% $default_include_timestamps %>;
    var default_include_intercrop_accessions = <% $default_include_intercrop_accessions %>;
    var default_include_entry_numbers = <% $default_include_entry_numbers %>;
    var default_include_trait_synonyms = <% $default_include_trait_synonyms %>;
    var default_supress_outliers = <% $default_supress_outliers %>;
    var default_include_pedigree_parents = <% $default_include_pedigree_parents %>;

    jQuery("#download_stock_phenotypes_repetitive_measurements_option").val(default_repeat_measurements);
    jQuery("#download_stock_phenotypes_timestamp_option").val(default_include_timestamps);
    jQuery("#download_stock_phenotypes_intercrop_accessions_option").val(default_include_intercrop_accessions);
    jQuery("#download_stock_phenotypes_entry_numbers_option").val(default_include_entry_numbers);
    jQuery("#download_stock_phenotypes_trait_synonyms_option").val(default_include_trait_synonyms);
    jQuery("#download_stock_phenotypes_exclude_outliers").val(default_supress_outliers);
    jQuery("#download_stock_phenotypes_pedigrees_option").val(default_include_pedigree_parents);
}

function data_level_change_traits() {
    var stock_type = "<% $stock_type %>";
    get_select_box(
        'traits',
        'download_stock_phenotypes_traits',
        { 'name' : 'download_stock_phenotypes_traits_select',
        'id' : 'download_stock_phenotypes_traits_select',
        'stock_id':<% $stock_id %>,
        'stock_type': stock_type ,
        'multiple': true,
        'full_dropdown':true}
        );
}
</script>

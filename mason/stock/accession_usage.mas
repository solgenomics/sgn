<%once>
use HTML::Entities ();
</%once>
<%args>


</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("accession.usage.title", "Accession Usage")) &>

<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p("accession.usage.trials", "Accession Usage for Trials")), collapsible=>1, collapsed=>1 &>

<table id="accession_usage_trials" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th><% $c->i18n->p("accession.usage.header.accession_name", "Accession Name") |h %></th>
    <th><% $c->i18n->p("accession.usage.header.trial_count", "Number of Trials") |h %></th>
    <th><% $c->i18n->p("accession.usage.header.plot_count", "Total Number of Plots") |h %></th>
  </tr>
</thead>
</table>

</&>

<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p("accession.usage.female", "Accession Usage as Female Parent")), collapsible=>1, collapsed=>1 &>

<table id="accession_usage_female" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th><% $c->i18n->p("accession.usage.header.accession_name", "Accession Name") |h %></th>
    <th><% $c->i18n->p("accession.usage.header.progenies", "Number of Progenies") |h %></th>
  </tr>
</thead>
</table>
<a href="/search/download_parents_and_numbers_of_progenies?parent_type=female_parent" class="btn btn-sm btn-default"><% $c->i18n->p("accession.usage.download", "Download") |h %></a>

</&>

<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p("accession.usage.male", "Accession Usage as Male Parent")), collapsible=>1, collapsed=>1 &>

<table id="accession_usage_male" width="100%" class="table table-hover table-striped">
<thead>
  <tr>
    <th><% $c->i18n->p("accession.usage.header.accession_name", "Accession Name") |h %></th>
    <th><% $c->i18n->p("accession.usage.header.progenies", "Number of Progenies") |h %></th>
  </tr>
</thead>
</table>
<a href="/search/download_parents_and_numbers_of_progenies?parent_type=male_parent" class="btn btn-sm btn-default"><% $c->i18n->p("accession.usage.download", "Download") |h %></a>

</&>

<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p("accession.usage.phenotype", "Accession Phenotype Performance")), collapsible=>1, collapsed=>0 &>

<div class="well">
    <div class="panel panel-default">
        <div class="panel-body">

            <table id="accession_usage_phenotypes" class='table table-bordered table-hover'>
                <thead>
                    <tr>
                        <th><% $c->i18n->p("accession.usage.header.accession", "Accession") |h %></th>
                        <th><% $c->i18n->p("accession.usage.header.variable", "Observation Variable") |h %></th>
                        <th><% $c->i18n->p("accession.usage.header.mean", "Mean") |h %></th>
                        <th><% $c->i18n->p("accession.usage.header.min", "Min") |h %></th>
                        <th><% $c->i18n->p("accession.usage.header.max", "Max") |h %></th>
                        <th><% $c->i18n->p("accession.usage.header.stddev", "Std Dev") |h %></th>
                        <th><% $c->i18n->p("accession.usage.header.cv", "CV") |h %></th>
                        <th><% $c->i18n->p("accession.usage.header.count", "Count") |h %></th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

</&>

<script>

jQuery(document).ready(function(){

  jQuery('#accession_usage_trials').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_trials'
  });


  jQuery('#accession_usage_female').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_female'
  });


  jQuery('#accession_usage_male').DataTable({

     'ordering' : false,
     'ajax':'ajax/accession_usage_male'
  });

  var stock_table = jQuery('#accession_usage_phenotypes').DataTable({
      'destroy' : true,
      'searching' : false,
      'ordering'  : false,
      'processing': true,
      'serverSide': true,
      'lengthMenu': [10,20,50,100,1000,5000],
      'ajax': { 'url':  '/ajax/accession_usage_phenotypes?display=plots_accession' }
  });

});

</script>

<%args>
$stock_id
$map_html => undef
</%args>

% print $map_html;

<table class="table table-hover table-bordered" id="stock_direct_genotypes_datatable">
    <thead>
        <tr>
            <th><% $c->i18n->p("folder.detail.genotyping_project_name", "Genotyping Project Name") |h %></th>
            <th><% $c->i18n->p("genotype.marker.genotyping_project_description", "Genotyping Project Description") |h %></th>
            <th><% $c->i18n->p("genotype.plate.protocol_name", "Protocol Name") |h %></th>
            <th><% $c->i18n->p("genotype.marker.genotype_description", "Genotype Description") |h %></th>
            <th><% $c->i18n->p("global.download", "Download") |h %></th>
        </tr>
    </thead>
</table>

<script>

jQuery(document).ready(function () {

    jQuery('#stock_genotypes_section_onswitch').one("click", function() {
        var stock_genotypes_table = jQuery('#stock_direct_genotypes_datatable').DataTable({
            'destroy' : true,
            'searching' : false,
            'ordering'  : false,
            'processing': true,
            'serverSide': true,
            "scrollX": true,
            'ajax': '/stock/<% $stock_id %>/datatables/genotype_data'
        });
    });

});

</script>

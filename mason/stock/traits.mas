
<%args>
$stock_id
</%args>

<!-- & /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] & -->

<table class="table table-hover table-bordered" id="traitlist_summary_data" >
<thead>
  <tr>
    <th><% $c->i18n->p("phenotype.root.trait_id", "Trait ID") |h %></th>
    <th><% $c->i18n->p("phenotype.root.trait_name.4f3e5b7", "Trait name") |h %></th>
    <th><% $c->i18n->p("phenotype.root.average_value", "Average Value") |h %></th>
    <th><% $c->i18n->p("phenotype.root.standard_deviation", "Standard deviation") |h %></th>
    <th><% $c->i18n->p("accession.stock.phenotype.header.count", "Count") |h %></th>
  </tr>
</thead>

</table>

<!-- link rel="stylesheet" type="text/css" href="/documents/inc/datatables/jquery.dataTables.css" -->

<script>

    jQuery(document).ready(function () {
        jQuery('#stock_traits_section_onswitch').click(function(){
            jQuery('#traitlist_summary_data').DataTable( {
                'destroy':true,
                'ajax': '/stock/'+ <% $stock_id %> + '/datatables/traitlist',
            });
        });
    });

</script>

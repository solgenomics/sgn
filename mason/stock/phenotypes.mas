
<%args>
$stock_id
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<table id="phenotype_summary_data" class="display">
<thead>
  <tr>
    <th><% $c->i18n->p("global.index_logged_in_user.trial", "Trial") |h %></th>
    <th><% $c->i18n->p("phenotype.root.trait_code", "Trait code") |h %></th>
    <th><% $c->i18n->p("accession.stock.phenotype.header.trait", "Trait") |h %></th>
    <th><% $c->i18n->p("seedlot_maintenance_table.ui.value_header", "Value") |h %></th>
  </tr>
</thead>

</table>

<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<script>

  jQuery(document).ready(function () {
  
    jQuery('#phenotype_summary_data').DataTable( { 
      'ajax': '/stock/'+ <% $stock_id %> + '/datatables/traits',
    });
  });


  
</script>

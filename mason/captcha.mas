<%args>
    $config
    $goto_url => '/'
</%args>

<%init>
use HTML::Entities ();
</%init>

<%perl>
    if ( !defined $config ) {
        $m->comp("/generic_message.mas", message => HTML::Entities::encode_entities($c->i18n->p('global.captcha.disabled', 'Captcha has not been enabled on this server')));
        $m->abort();
    }
</%perl>

<noscript>
    <div id="sgn-captcha-nojs" style="max-width: 400px; margin: 15px auto; text-align: center;">
        <p>
            <strong><% $c->i18n->p('global.captcha.verification_failed', 'Verification Failed') |h %></strong>
            <br />
            <% $c->i18n->p('global.captcha.javascript_required', 'Javascript is required for bot detection...') |h %>
        </p>
    </div>
</noscript>

<div id="sgn-captcha" data-goto-url="<% $goto_url |h %>" style="display: none; max-width: 400px; min-height: 250px; margin: 15px auto; text-align: center;">
    <p id="sgn-captcha-status"><% $c->i18n->p('global.captcha.verifying', 'Verifying your request...') |h %></p>
    <progress id="sgn-captcha-loader" max="100" value="0"></progress>
</div>


<script type="module">
    import "https://cdn.jsdelivr.net/npm/cap-widget@0.1.56";
    const container = document.getElementById("sgn-captcha");
    const status = document.getElementById("sgn-captcha-status");
    const loader = document.getElementById("sgn-captcha-loader");
    const gotoUrl = container.dataset.gotoUrl;
    const escapeHtml = (value) => {
        const element = document.createElement("span");
        element.textContent = String(value);
        return element.innerHTML;
    };

    // reset the display
    container.style.display = "block";
    loader.style.display = "inline-block";
    loader.setAttribute("value", 0);

    // Initiate the captcha solve routine
    const cap = new Cap({ apiEndpoint: "<% $config->{server} %>/<% $config->{client_id} %>" });
    cap.solve();

    // When the captcha has been solved...
    // verify the token that has been returned
    // if the token is valid, redirect to the original URL
    cap.addEventListener("solve", (e) => {
        status.innerHTML = `<strong>${escapeHtml(window.SGN && SGN.i18n ? SGN.i18n.p('global.captcha.saving', 'Saving verification token...') : 'Saving verification token...')}</strong>`;
        loader.removeAttribute("value");

        // Use fetch() rather than jQuery.ajax() here: this page is the gate shown
        // before the rest of the site (and its jQuery bundle) is known to have loaded
        // successfully, so the verification flow must not depend on jQuery.
        fetch('/ajax/captcha', {
            method: 'POST',
            body: new URLSearchParams({ token: e.detail.token })
        })
            .then((r) => r.json())
            .then((response) => {
                if ( response?.error || response?.success !== 1 ) {
                    status.innerHTML = `<strong>${escapeHtml(window.SGN && SGN.i18n ? SGN.i18n.p('global.captcha.could_not_save', 'Could not save verification token') : 'Could not save verification token')}</strong><br />${escapeHtml(response.error)}`;
                    loader.style.display = "none";
                }
                else {
                    const savedMessage = window.SGN && SGN.i18n ? SGN.i18n.p('global.captcha.saved', 'Saved verification token!') : 'Saved verification token!';
                    const redirectMarker = '__SGN_CAPTCHA_REDIRECT__';
                    const redirectNotice = window.SGN && SGN.i18n ? SGN.i18n.p('global.captcha.redirect_notice', 'You should now be redirected to %{link}', {link: redirectMarker}) : `You should now be redirected to ${redirectMarker}`;
                    const redirectParts = redirectNotice.split(redirectMarker);
                    const redirectLink = document.createElement('a');
                    redirectLink.href = gotoUrl;
                    redirectLink.textContent = gotoUrl;
                    status.innerHTML = `<strong>${escapeHtml(savedMessage)}</strong><br />${escapeHtml(redirectParts[0])}`;
                    status.appendChild(redirectLink);
                    status.appendChild(document.createTextNode(redirectParts.slice(1).join(redirectMarker)));
                    loader.style.display = "none";
                    const url = new URL(gotoUrl, `${window.location.protocol}//${window.location.host}`);
                    if ( !url.searchParams.has("captcha") ) {
                        url.searchParams.append("captcha", "passed");
                        url.searchParams.delete("captcha-token");
                        window.location = url.pathname + url.search;
                    }
                }
            })
            .catch(() => {
                status.innerHTML = `<strong>${escapeHtml(window.SGN && SGN.i18n ? SGN.i18n.p('global.captcha.could_not_save', 'Could not save verification token') : 'Could not save verification token')}</strong>`;
                loader.style.display = "none";
            });
    });

    // Update the progress of the captcha solve routine...
    cap.addEventListener("progress", (e) => {
        status.innerHTML = `<strong>${escapeHtml(window.SGN && SGN.i18n ? SGN.i18n.p('global.captcha.verifying', 'Verifying your request...') : 'Verifying your request...')}</strong>`;
        loader.value = e.detail.progress;
    });

    // The captcha solve has failed...
    cap.addEventListener("error", (e) => {
        status.innerHTML = `<strong>${escapeHtml(window.SGN && SGN.i18n ? SGN.i18n.p('global.captcha.could_not_verify', 'Could not verify the token') : 'Could not verify the token')}</strong><br />${escapeHtml(e.detail.message)}`;
        loader.style.display = "none";
    });
</script>
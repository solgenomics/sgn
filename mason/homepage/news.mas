
<%perl>

use strict;

use File::Spec;
use CXGN::Tools::File;

my $file = File::Spec->catfile($c->get_conf('homepage_files_dir'), 'news.txt');

my $contents = $c->i18n->p('global.news.unavailable', 'News is not available at the moment.') . "<br /><br />";

eval {
  $contents = CXGN::Tools::File::get_sections($file);
};


</%perl>


        <li><a href="/sequencing/sol100.pl">SOL100 genomes</a></li>
      </div>
    </ul>
  </li>
    
    <li class="Pathways"><a href="http://solcyc.solgenomics.net/"><img src="/img/soliconmenu/Pathways.png" alt="<% $c->i18n->p('global.iconmenu.pathways', 'Pathways') |h %>" title="<% $c->i18n->p('global.iconmenu.click_solcyc', 'Click to access SolCyc') |h %>" /></a>

	</li>
    
  <li class="GenomesSequences"><a href="/genomes"><img src="/img/soliconmenu/GenomesSequences.png" alt="<% $c->i18n->p('global.iconmenu.genomes_sequences', 'Genomes and Sequences') |h %>" title="<% $c->i18n->p('global.iconmenu.genomes_sequences', 'Genomes and Sequences') |h %>" /></a>
    <ul>
      <div class="submenu GenomesSequencesSubMenu">
        <li><a href="/organism/Solanum_lycopersicum/genome">Tomato Genome Project</a></li>

		    <li><a href="/cview/help/map_submission"><% $c->i18n->p('global.iconmenu.submit_map_information', 'Submit map information to SGN') |h %></a></li>
		  </div>
		</ul>
	</li>

	<li class="Genes"><a href="/search/direct_search.pl?search=loci" style="background: none"><img src="/img/soliconmenu/Genes.png" title="<% $c->i18n->p('global.iconmenu.genes', 'Genes') |h %>" /></a>
	  <ul>
            <div class="submenu GenesSubMenu"  >
              <li><a href="/search/direct_search.pl?search=loci"><% $c->i18n->p('global.iconmenu.search_loci', 'Search loci') |h %></a></li>
              <li><a href="/search/direct_search.pl?search=unigene"><% $c->i18n->p('global.iconmenu.search_unigenes', 'Search unigenes') |h %></a></li>
              <li><a href="/search/direct_search.pl?search=template"><% $c->i18n->p('global.iconmenu.expression', 'Expression') |h %></a></li>
              <li><a href="/organism/Solanum_lycopersicum/genome"><% $c->i18n->p('global.iconmenu.search_browse_crop_genome', 'Search/browse %{crop} genome', {crop => 'tomato'}) |h %></a></li>
	      <li><a href="/phenome/"><% $c->i18n->p('global.iconmenu.become_locus_editor', 'Become an SGN locus editor') |h %></a></li>
	      </div>
	      
	  </ul>



	<li class="Phenotypes"><a href="/search/direct_search.pl?search=phenotypes" style="background: none"><img src="/img/soliconmenu/Phenotypes.png" alt="<% $c->i18n->p('global.iconmenu.phenotypes_qtls', 'Phenotypes and QTLs') |h %>" title="<% $c->i18n->p('global.iconmenu.phenotypes_qtls', 'Phenotypes and QTLs') |h %>" /></a>
	  <ul>
	    <div class="submenu PhenotypesSubMenu">
              <li><a href="/search/direct_search.pl?search=phenotypes"><% $c->i18n->p('global.iconmenu.search_phenotypes', 'Search phenotypes') |h %></a></li>

              <li><a href="/qtl/"><% $c->i18n->p('global.iconmenu.analyze_qtls', 'Analyze QTLs') |h %></a></li>
              <li><a href="/tools/onto/"><% $c->i18n->p('global.iconmenu.ontology_browser', 'Ontology browser') |h %></a></li>
	      <li><a href="">&nbsp;</a></li>
	      <li><a href="/phenome/"><% $c->i18n->p('global.iconmenu.submit_phenotype_data', 'Submit phenotype data') |h %></a></li>
            </div>
          </ul>

	</li>
    
    <li class="BreedersToolBox"><a href="/breeders/"><img src="/img/soliconmenu/BreedersToolBox.png" alt="<% $c->i18n->p('global.iconmenu.breeders_toolbox', 'Breeders Toolbox') |h %>" title="<% $c->i18n->p('global.iconmenu.click_breeders_toolbox', 'Click to access the Breeder\'s toolbox') |h %>" /></a>

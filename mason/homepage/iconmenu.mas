

<%doc>

=head1 NAME

/homepage/iconmenu.mas - a graphical way to present information on SGN

=head1 DESCRIPTION

Displays an icon-based menu of top level option. Mousing over the
icons pops up menus with further links to guide the users to useful
pages.

=head1 AUTHORS

 Camilo Rosero
 Lukas Mueller (integration into SGN, some changes to the menus)

 June 9, 2010

=cut


</%doc>

<style type="text/css">
    @import url("/css/icon_nav.css");

    #icon_nav {
        width: 720px;
        height: 480px;
        margin-top: -20px;
        margin-left: -20px;
    }

    .MapsMarkers {
            position: relative; 
    	top: 80px;
    	left: 50px;
    }

    .MapsMarkersSubMenu {
            position: relative;
    	left: 190px;
    	top: -160px;
    	width: 220px;
            height: 100px;
    }

    .MapsMarkersSubMenu a {
     /* padding-left: 15px; */
    }

    .Genes {
    	position: relative;
        top: 40px; 
    	left: 120px;
    }

    .GenesSubMenu {
    	width: 227px;
    	height: 100px;
    	position: relative;
    	top: -120px;
    	left: 100px;
    }

    .GenesSubMenu a {
    /* padding-left: 15px; */
     }

    .Phenotypes {
    	position: relative; 
    	top: 80px;
    	left: 100px;
    }

    .PhenotypesSubMenu {
    	width: 227px;
    	height: 100px; 
    	position: relative;
    	top: -110px;
    	left: 115px;
    }


    .BreedersToolBox {
    	position: relative; 
    	top: 140px;
    	left: -360px;
        z-index: 1;
    }

    .BreedersToolBoxSubMenu {
    	width: 227px;
    	height: 341px;
    	padding-top: 15px;
    	position: relative;
    	top: -100px;
    	left: 115px;
    }

    .GenomesSequences {
    	position: relative; 
    	top: 40px;
    	left: 260px;
    }

    .GenomesSequencesSubMenu {
    	width: 227px;
    	height: 90px;
    	padding-top: 15px;
    	position: relative;
    	top: -110px;
    	left: 200px;
    }

    .Pathways {
    	position: relative; 
    	top: -10px;
    	left: 310px;
    }

    .PathwaysSubMenu {
    	width: 227px;
    	height: 341px;
    	position: relative;
    	top: -110px;
    	left: 115px;
    }

    .Divider { 
            line-height:4px;
            font-size: 4px;
    }

</style>

<div id="icon_nav">
<ul>
	<li class="MapsMarkers"><a href="/cview/" ><img src="/img/soliconmenu/MapsMarkers.png" title="<% $c->i18n->p('global.iconmenu.maps_markers', 'Maps and Markers') |h %>" /></a>

   		<ul>
        	  <div class="submenu MapsMarkersSubMenu">
		    <li><a href="/cview/index.pl"><% $c->i18n->p('global.iconmenu.available_maps', 'Available maps') |h %></a></li>

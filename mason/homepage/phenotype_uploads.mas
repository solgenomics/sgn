<%args>
$phenotype_files => undef
</%args>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="panel panel-default">
                <div class="panel-heading"><% $c->i18n->p("phenotype.phenotype_files_uploaded", "Phenotype Files Uploaded") |h %></div>
                    <div class="panel-body">
                        <table class="table table-bordered" id="homepage_phenotype_uploads" alt="">
                            <thead>
                                <tr><th><% $c->i18n->p("global.search.images.filename", "Filename") |h %></th><th><% $c->i18n->p("accession.files.files.header.date", "Date Uploaded") |h %></th><th><% $c->i18n->p("accession.files.files.header.uploader", "Uploaded By") |h %></th><th><% $c->i18n->p("file_viewer.ui.type", "File Type") |h %></th><th><% $c->i18n->p("global.file_dump_share_files.options", "Options") |h %></th><th><% $c->i18n->p("global.index_logged_in_user.trial", "Trial") |h %></th></tr>
                            </thead>
                            <tbody>
% foreach my $f (@$phenotype_files) {
                                <tr>
                                    <td><% $f->{metadata}->[4] %></td>
                                    <td><% $f->{metadata}->[1] %></td>
                                    <td><a href="/solpeople/profile/<% $f->{metadata}->[2] %>"><% $f->{metadata}->[3] %></a></td>
                                    <td><% $f->{metadata}->[6] %></td>
                                    <td><a href="/breeders/phenotyping/view/<% $f->{metadata}->[0] %>"><% $c->i18n->p("global.dataset_cxgn_dataset.view", "View") |h %></a> | <a href="/breeders/phenotyping/download/<% $f->{metadata}->[0] %>"><% $c->i18n->p("global.est.download", "Download") |h %></a></td>
                                    <td>
% foreach my $p (keys %{$f->{project_ids}}) {
                                        <a href='/breeders/trial/<% $p %>'><% $f->{project_ids}->{$p} %></a>&nbsp;&nbsp;
% }
                                    </td>
                                </tr>
% }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready(function() {
    jQuery('#homepage_phenotype_uploads').DataTable({
        "ordering": false,
    });
});
</script>

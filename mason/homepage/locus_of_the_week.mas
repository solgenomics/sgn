
<%perl>

use strict;
use HTML::Entities ();
use File::Spec;
use CXGN::Tools::File;

my $loci = HTML::Entities::encode_entities($c->i18n->p('global.locus_of_the_week.unavailable', 'The locus of the week is currently unavailable.')) . " <br /><br /> ";

eval { 
  $loci = CXGN::Tools::File::get_sections(File::Spec->catfile($c->get_conf("homepage_files_dir"), "loci.txt"));

};
</%perl>


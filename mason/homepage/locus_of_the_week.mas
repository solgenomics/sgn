<h4><% $c->i18n->p('global.locus_of_the_week.heading', 'Featured Locus') |h %></h4>
<% $loci %>
<button class="btn btn-info btn-sm" onclick='location.href="/oldloci.pl"'><% $c->i18n->p('global.locus_of_the_week.previous', 'See previous...') |h %></button>    <button class="btn btn-primary btn-sm" onclick=location.href="/search/direct_search.pl?search=loci"><% $c->i18n->p('global.locus_of_the_week.search', 'Search other loci...') |h %></button>

<%doc>

=head1 NAME 

publication_of_the_week.mas - a mason module to display an html section with news, read from a file.

=head1 DESCRIPTION

The module does not require any parameters. If the file read does not succeed, an error message is displayed.

=head1 AUTHOR

Lukas Mueller <lam87@cornell.edu>

=cut

</%doc>

<%perl>

use strict;
use HTML::Entities ();
use File::Spec;
use CXGN::Tools::File;

my $publication = HTML::Entities::encode_entities($c->i18n->p('global.tomato_genome_release.unavailable', 'The %{crop} genome release information is currently unavailable.', {crop => 'tomato'})) . "<br /><br />";

eval {

 $publication = CXGN::Tools::File::read_commented_file(File::Spec->catfile($c->get_conf('homepage_files_dir'), "tomato_genome_release.txt"));

};

if ($@) { print "ERROR $@\n"; }

</%perl>

<div class="boxbgcolor1" style="margin:0px;">
<div class="boxheading"><% $c->i18n->p('global.tomato_genome_release.heading', 'Current %{crop} Genome version %{genome_version} and Annotation %{annotation_version}', {crop => 'Tomato', genome_version => 'SL3.0', annotation_version => 'ITAG3.10'}) |h %> <font color="red">       [ <% $c->i18n->p('global.tomato_genome_release.new', 'New') |h %> ]</font>  </div>

<div class="boxcontent"><% $publication %>

</div>
</div>

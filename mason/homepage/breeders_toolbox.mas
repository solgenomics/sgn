
<%doc>

Displays a small section about the breeders toolbox. 

Does not require any parameters.

</%doc>

<%init>
use HTML::Entities ();
</%init>

<div class="boxbgcolor5" style="margin-bottom:2px" >
<div class="boxheading"><% $c->i18n->p('global.breeders_toolbox.heading', "SGN Breeder's Toolbox") |h %></div>
<div class="boxcontent">
<table cellpadding="0" cellspacing="0"><tr><td width="60" >
<a href="/breeders/"><img src="/documents/img/tomato_breeders_toolbox.jpg" width="50" border ="0" /></a><br />
<br />
</td><td>
% my $toolbox_token = '__SGN_BREEDERS_TOOLBOX_LINK__';
% my $toolbox_sentence = $c->i18n->p('global.breeders_toolbox.access', 'Access the SGN %{toolbox_link}', {toolbox_link => $toolbox_token});
% $toolbox_sentence = HTML::Entities::encode_entities($toolbox_sentence);
% $toolbox_sentence =~ s/\Q$toolbox_token\E/<a href="\/breeders\/">Breeder's Toolbox.<\/a>/;
<b><% $toolbox_sentence |n %></b>
</td></tr>
</table>

</div>
</div>

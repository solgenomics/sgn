

<%doc>

Mason module that displays div of potato genome status information, based on the contents of a file.
Takes no arguments.

</%doc>

<%perl>

use File::Spec;
use HTML::Entities ();

my $file;
my $html = HTML::Entities::encode_entities($c->i18n->p('global.potato_genome_info.unavailable', '(%{crop} genome information currently not available)', {crop => 'Potato'}));

eval { $file = File::Spec->catfile($c->get_conf('homepage_files_dir'), 'potato_genome_info.txt');
$html = $m->file($file);
};

</%perl>

<% $html %>

<%init>
use HTML::Entities ();
</%init>

<%perl>
my $announcement_link_token = '__SGN_ANNOUNCEMENT_LINK__';
my $tgc_link_token = '__SGN_TGC_LINK__';
my $announcement = $c->i18n->p('global.announcements.body', 'The 2014 Report of the %{tgc_name} (TGC) will likely be published at the end of October. There is time for researchers to submit reports on their tomato related research. Reports can include some interesting preliminary results and will not preclude later publishing in a refereed journal. You may also have some information that would be of interest to the research community but do not have time etc. to do follow up work for a refereed paper. Please submit reports to me at %{email_link}. For more information on the TGC see %{tgc_link}.', {tgc_name => 'Tomato Genetics Cooperative', email_link => $announcement_link_token, tgc_link => $tgc_link_token});
$announcement = HTML::Entities::encode_entities($announcement);
$announcement =~ s/\Q$announcement_link_token\E/<a href="mailto:jwsc\@ufl.edu">jwsc\@ufl.edu<\/a>/;
$announcement =~ s/\Q$tgc_link_token\E/<a href="http:\/\/tgc.ifas.ufl.edu">http:\/\/tgc.ifas.ufl.edu<\/a>/;
</%perl>

<div class="boxbgcolor5">
<h4><% $c->i18n->p('global.announcements.heading', 'A message from the TGC') |h %></h4>
<% $announcement |n %>
<br /><br />
-Jay Scott<br />
<% $c->i18n->p('global.announcements.signature_role', 'Managing Editor %{organization}', {organization => 'Tomato Genetics Cooperative'}) |h %>
</div>
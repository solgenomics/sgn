<%perl>

use strict;
use CXGN::Tools::File;

my $documents_folder = $c->get_conf('homepage_files_dir');

my $OTHER_LINKS = $c->i18n->p('global.other_links.unavailable', 'Other links are currently not available.');


eval { 
  $OTHER_LINKS=CXGN::Tools::File::read_commented_file("$documents_folder/other_links.txt");
};

  
print $OTHER_LINKS;

</%perl>

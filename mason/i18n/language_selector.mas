<%doc>
Language selector for the navigation bar. It is shown only when
i18n_enabled is set and lists the languages that have installed translations.
The choice is saved in a cookie by SGN::Controller::I18N.
</%doc>
% if ($c->config->{i18n_enabled}) {
<form action="/i18n/language" method="post" class="form-inline" style="padding: 7px; margin: 0; white-space: nowrap">
  <label for="sgn-language"><% $c->i18n->p('language.select', 'Language') |h %></label>
  <select id="sgn-language" name="locale" class="form-control input-sm">
% for my $choice ($c->i18n_locale_choices) {
% my $locale = $choice->{locale};
    <option value="<% $locale |h %>"<% lc($locale) eq lc($c->i18n->requested_locale) ? ' selected="selected"' : '' %> lang="<% $locale |h %>" dir="auto"><% $choice->{name} |h %></option>
% }
  </select>
  <input type="hidden" name="return_to" value="<% $c->req->uri->path_query |h %>" />
  <button class="btn btn-default btn-sm" type="submit"><% $c->i18n->p('language.apply', 'Apply') |h %></button>
</form>
<script>
(function () {
    // Keep the #fragment too, which the server never sees.
    var select = document.getElementById('sgn-language');
    if (!select) return;
    if (window.SGN && SGN.I18N && SGN.I18N.keepSelectorLanguage) SGN.I18N.keepSelectorLanguage(select, window);
    select.form.addEventListener('submit', function () {
        this.elements.return_to.value = window.location.pathname + window.location.search + window.location.hash;
    });
}());
</script>
% }

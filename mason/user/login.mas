
<%args>
   $goto_url
</%args>

<%init>
    use HTML::Entities ();
</%init>

<style>
.textlabel {
  width: 200px;
  white-space: nowrap;
  max-width: 150px;
  overflow: hidden;
  text-overflow: ellipsis;
  float:left;     
}

.input { 
  width: 200px;
  white-space:nowrap;
}

.form-control { 
  width: 300px;
}

</style>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('auth.login.title', 'Login')) &>

<div id="login_page" data-goto-url="<% $goto_url |h %>">
<center>
<a href="javascript:history.back();"><button class="btn btn-primary"><% $c->i18n->p('auth.login.go_back', 'Go back') |h %></button></a>
</center>
</div>

<script>

  jQuery(document).ready( function() {  
    
    jQuery('#goto_url').val(document.getElementById('login_page').getAttribute('data-goto-url'));


    jQuery('#site_login_dialog').modal('show'); 

  });
 
</script>

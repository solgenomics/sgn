<%args>
</%args>

<div id="brapi_auth_home_div">

    <div class="row">
    <div class="col-sm-6">
    <h4><% $c->i18n->p("integrations.auth.login_heading", "Login") |h %></h4>
    <input name="brapi_auth_login_username" id="brapi_auth_login_username" class="form-control" type="text" placeholder="<% $c->i18n->p("integrations.auth.username_placeholder", "Your Username") |h %>" />
    <input name="brapi_auth_login_password" id="brapi_auth_login_password" class="form-control" type="password" placeholder="<% $c->i18n->p("integrations.auth.password_placeholder", "Password") |h %>" />
    <button class="btn btn-primary" name="brapi_auth_login_submit" id="brapi_auth_login_submit"><% $c->i18n->p("integrations.auth.login_button", "Login") |h %></button>
    </div>
    <div class="col-sm-6">
    <h4><% $c->i18n->p("integrations.auth.logout_heading", "Logout") |h %></h4>
    <button class="btn btn-danger" name="brapi_auth_logout_submit" id="brapi_auth_logout_submit"><% $c->i18n->p("integrations.auth.logout_button", "Logout") |h %></button>
    </div>
    </div>

</div>

<script>

jQuery(document).ready(function() {
    jQuery("#brapi_auth_login_submit").click(function() {
        jQuery.ajax( {
          'url': jQuery('#brapi_home_url_select').val()+'/brapi/v1/token',
          'method': 'POST',
          'data': { 
            'grant_type' : 'password',
            'username' :  jQuery("#brapi_auth_login_username").val(),
            'password' : jQuery("#brapi_auth_login_password").val()
          },
          'success': function(response) {
            console.log(response);
            //jQuery("#brapi_auth_home_div").empty().html("Successfully logged in!"+response);
            alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("integrations.auth.login_success", "Successfully logged in!") : "Successfully logged in!")+response.userDisplayName + response.expires_in);
            //location.reload();
          },
          error: function(response) {
            alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("integrations.auth.error", "An error occurred") : "An error occurred"));
          }
        });
    });
    
    jQuery("#brapi_auth_logout_submit").click(function() {
        jQuery.ajax( {
          'url': jQuery('#brapi_home_url_select').val()+'/brapi/v1/token',
          'method': 'DELETE',
          'success': function(response) {
            console.log(response);
            alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("integrations.auth.logout_success", "Successfully logged out!") : "Successfully logged out!"));
            //location.reload();
          },
          error: function(response) {
            alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("integrations.auth.error", "An error occurred") : "An error occurred"));
          }
        });
    });
});

</script>
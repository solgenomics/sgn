<%init>
use HTML::Entities ();
</%init>

<%args>
$mode => ''
$debug => ''
</%args>

<%perl>
my %modes = ( clone_search => 0,  microarray=>1,  unigene=>2, bac=>3, bac_end=>4, genes=>5, feature=>6, converter=>7, ftp=>8, );
if (!$mode) { $mode="clone_search";}
if (!exists($modes{$mode})) { $mode = "clone_search"; }
</%perl>

<& /util/import_javascript.mas, classes => [ 'jqueryui' ] &>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("lists_datasets.bulk.bulk_download", "Bulk Download")) &>

<script>
  jQuery(function() {

    jQuery( "#tabs" ).tabs({
      //show: { effect: 'blind', duration: 800},
      active: <% $modes{$mode} %>,
      beforeLoad: function( event, ui ) {
        ui.jqXHR.fail(function() {
          ui.panel.text(
            (window.SGN && SGN.i18n ? SGN.i18n.p("lists_datasets.bulk.tab_load_failed", "Couldn't load this tab. We'll try to fix this as soon as possible. If this wouldn't be a demo.") : "Couldn't load this tab. We'll try to fix this as soon as possible. If this wouldn't be a demo.") );
        });
      }

  });
  });
</script>


<div id="tabs">
  <ul>
    <li><a href="/tools/bulk/tabs/clone_tab"><% $c->i18n->p("lists_datasets.bulk.clones", "Clones") |h %></a></li>
    <li><a href="/tools/bulk/tabs/array_tab"><% $c->i18n->p("lists_datasets.bulk.arrays", "Arrays") |h %></a></li>
    <li><a href="/tools/bulk/tabs/unigene_tab"><% $c->i18n->p("lists_datasets.bulk.unigenes", "Unigenes") |h %></a></li>
    <li><a href="/tools/bulk/tabs/bac_tab"><% $c->i18n->p("lists_datasets.bulk.bacs", "BACs") |h %></a></li>
    <li><a href="/tools/bulk/tabs/bac_end_tab"><% $c->i18n->p("lists_datasets.bulk.bac_ends", "BAC ends") |h %></a></li>
    <li><a href="/tools/bulk/tabs/gene_tab"><% $c->i18n->p("lists_datasets.bulk.genes", "Genes") |h %></a></li>
    <li><a href="/tools/bulk/tabs/feature_tab"><% $c->i18n->p("lists_datasets.bulk.features", "Features") |h %></a></li>
    <li><a href="/tools/bulk/tabs/converter_tab"><% $c->i18n->p("lists_datasets.bulk.converter", "Converter") |h %></a></li>
    <li><a href="/tools/bulk/tabs/ftp_tab">FTP</a></li>
  </ul>
</div>
</div>

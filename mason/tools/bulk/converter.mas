<%init>
use HTML::Entities ();
</%init>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("lists_datasets.bulk.bulk_converter", "Bulk Converter")) &>

<% $c->i18n->p("lists_datasets.bulk.paste_the_identifiers_you_would_like_to_convert", "Paste the identifiers you would like to convert") |h %>


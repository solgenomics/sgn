<%args>
    $db_name
</%args>

<div style="text-align: center; margin: 2em 0">
   <h2 style="margin-bottom: 1em"><% $c->i18n->p("transformation.root.design_new_experimental_treatments", "Design new experimental treatments") |h %></h2>
   <h4><% $c->i18n->p("transformation.root.experimental_treatments_are_applied_to_the_stocks_of_a_trial", "Experimental treatments are applied to the stocks of a trial. Subplots, plants, and tissue samples inherit treatments from their parent stocks.") |h %></h4>

   <h4> <% $c->i18n->p("phenotype.root.check_the", "Check the") |h %> <a href='/search/treatments'><% $c->i18n->p("transformation.root.treatment_search_page", "treatment search page") |h %></a> <% $c->i18n->p("transformation.root.to_see_if_your_treatment_has_already_been_made_before", "to see if your treatment has already been made before designing new treatments.") |h %></h4>

    <br>

   <div class="container-fluid">
        <form class="form-horizontal" role="form" method="post" id="new_treatment_design_form" name="new_treatment_design_form">
        <div class="form-group">
                <label class="col-sm-3 control-label"> <% $c->i18n->p("transformation.root.new_treatment_name", "New treatment name:") |h %> </label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_name" name="new_treatment_name" type="text" placeholder="<% $c->i18n->p("phenotype.root.pipes_will_be_removed_from_name", "Pipes (|)  will be removed from name.") |h %>"/>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.definition.17f9df6", "Definition:") |h %></label>
                <div class="col-sm-9">
                    <textarea style="width:70%;" class="form-control" id="new_treatment_definition" name="new_treatment_definition" placeholder="<% $c->i18n->p("phenotype.root.make_it_descriptive_be_sure_to_describe_category_meanings_if", "Make it descriptive. Be sure to describe category meanings if using categorical data.") |h %>"></textarea>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.treatment_format", "Treatment format:") |h %></label>
                <div class="col-sm-9">
                    <select style="width:70%;" class="form-control" id="new_treatment_format_select" name="new_treatment_format_select" type="select">
                        <option value="numeric" selected><% $c->i18n->p("phenotype.root.numeric", "Numeric") |h %></option>
                        <option value="categorical"><% $c->i18n->p("phenotype.root.categorical", "Categorical") |h %></option>
                        <option value="percent"><% $c->i18n->p("phenotype.root.percent", "Percent") |h %></option>
                        <option value="boolean"><% $c->i18n->p("phenotype.root.boolean", "Boolean") |h %></option>
                        <option value="date"><% $c->i18n->p("global.file_dump_share_files.date", "Date") |h %></option>
                        <option value="text"><% $c->i18n->p("lists_datasets.bulk.text", "Text") |h %></option>
                        <option value="counter"><% $c->i18n->p("phenotype.root.counter", "Counter") |h %></option>
                        <option value="ontology"><% $c->i18n->p("phenotype.root.ontology_parent_to_child_terms", "Ontology (parent to child terms)") |h %></option>
                    </select>
                </div>
            </div>
            <div class="form-group" id="new_treatment_repeat_select_container">
                <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.application_type", "Application type:") |h %></label>
                <div class="col-sm-9">
                    <select style="width:70%;" class="form-control" id="new_treatment_repeat_select" name="new_treatment_repeat_select" type="select">
                        <option value="single" selected><% $c->i18n->p("transformation.root.single_application", "Single application") |h %></option>
                        <option value="multiple"><% $c->i18n->p("transformation.root.repeated_application", "Repeated application") |h %></option>
                        <option value="time_series"><% $c->i18n->p("phenotype.root.time_series", "Time series") |h %></option>
                    </select>
                </div>
            </div>
            <div class="form-group" id="new_treatment_default_value_container">
                <label class="col-sm-3 control-label" id="new_treatment_default_value_label"><% $c->i18n->p("phenotype.root.default_value", "Default value:") |h %></label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_default_value" name="new_treatment_default_value" type="text" placeholder="<% $c->i18n->p("phenotype.root.optional", "(Optional)") |h %>"/>
                </div>
            </div>
            <div class="form-group" id="new_treatment_minimum_value_container">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.minimum_value", "Minimum value:") |h %></label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_min_value" name="new_treatment_min_value" type="text" placeholder="<% $c->i18n->p("phenotype.root.optional", "(Optional)") |h %>"/>
                </div>
            </div>
            <div class="form-group" id="new_treatment_maximum_value_container">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.maximum_value", "Maximum value:") |h %></label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_max_value" name="new_treatment_max_value" type="text" placeholder="<% $c->i18n->p("phenotype.root.optional", "(Optional)") |h %>"/>
                </div>
            </div>
            <div class="form-group" id="new_treatment_add_categories_container" style="display:none;">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.add_categories", "Add categories:") |h %></label>
                <div class="col-sm-9">
                    <table style="width:70%;">
                        <tr>
                            <td><input class="form-control" id="new_treatment_add_category" name="new_treatment_add_category" type="text" placeholder="<% $c->i18n->p("phenotype.root.optional_no_special_characters", "Optional. No special characters.") |h %>"/></td>
                            <td style="width:25%"><input  class="form-control" id="new_treatment_category_ordinal" name="new_treatment_category_ordinal" type="number" placeholder="<% $c->i18n->p("phenotype.root.ordinate", "Ordinate") |h %>"></td>
                            <td><button id="new_treatment_add_category_btn" class="btn btn-small btn-success">+</button></td>
                        </tr>
                    </table>
                    <table id="new_treatment_categories" style="width:30%;">
                    </table>
                    <button id="new_treatment_remove_category_btn" class="btn btn-small btn-danger" style="display:none;float:left;"><span class="glyphicon glyphicon-trash"></span></button>
                </div>
            </div>
            <div class="form-group" id="chain_parent_term_container">
                <label class="col-sm-3 control-label" id="chain_parent_term"><span class="glyphicon glyphicon-question-sign" style="color:blue;font-size:18px" title="<% $c->i18n->p("transformation.root.should_not_be_a_variable_term_will_be_the_treatment", "Should not be a variable term.\nWill be the treatment root term by default if none are added.") |h %>"></span>&nbsp;<% $c->i18n->p("phenotype.root.chain_to_existing_term_s", "Chain to existing term(s):") |h %></label>
                <div class="col-sm-9">
                    <table style="width:70%;">
                        <tr>
                            <td><input class="form-control" id="new_treatment_parent_term" name="new_treatment_parent_term" type="text" placeholder="<% $c->i18n->p("transformation.root.full_name_as_in_legacy_experiment_treatment_experiment_treatment", "Full name, as in 'Legacy experiment treatment|EXPERIMENT_TREATMENT:0000001'") |h %>"/></td>
                            <td><button id="new_treatment_add_parent_btn" class="btn btn-small btn-success">+</button></td>
                        </tr>
                    </table>
                    <ul id="new_treatment_parents" style="text-align:left;width:70%;padding-left:1em;list-style-type:disc;"></ul>
                    <button id="new_treatment_remove_parent_btn" class="btn btn-small btn-danger" style="display:none;float:left;"><span class="glyphicon glyphicon-trash"></span></button>
                </div>
            </div>
        </form>
        <button class="btn btn-primary" id="new_treatment_submit_btn"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
    </div>
</div>

<button id="download_ontology_btn" class="btn btn-primary"><% $c->i18n->p("transformation.root.download_treatment_ontology", "Download Treatment Ontology") |h %></button>
&nbsp;&nbsp;&nbsp;&nbsp;
<select id="treatment_cvtermpath_rebuild_select" class="form-control" style="display:inline-block;width:auto;vertical-align:middle;margin-left:2em;">
    <option value=""><% $c->i18n->p("treatment.select_ontology", "Select an ontology...") |h %></option>
</select>
<button id="treatment_rebuild_cvtermpath_btn" class="btn btn-primary btn-sm"><% $c->i18n->p("treatment.rebuild_paths", "Rebuild cvterm paths") |h %></button>
<br>
<br>
% 
% my $root_nodes = $db_name =~ s/,/ /gr; # should just be EXPERIMENT_TREATMENT
% 
<&| /page/info_section.mas, anchor_title => "Treatment terms", title=>HTML::Entities::encode_entities($c->i18n->p("transformation.root.treatment_terms", "Treatment terms")), collapsible=>1 &>
    <& /ontology/browser.mas, root_nodes=>$root_nodes, expand=>0 &>
</&>

<script>
    jQuery(document).ready(function () {

        jQuery('#new_treatment_submit_btn').on('click', function () {

            jQuery('#working_modal').modal("show");

            let name = jQuery('#new_treatment_name').val();
            let definition = jQuery('#new_treatment_definition').val();
            let format = jQuery('#new_treatment_format_select').val();
            let default_value = jQuery('#new_treatment_default_value').val();
            let minimum = jQuery('#new_treatment_min_value').val();
            let maximum = jQuery('#new_treatment_max_value').val();
            let repeat_type = jQuery('#new_treatment_repeat_select').val();
            let categories = JSON.parse(html_table_to_json(jQuery('#new_treatment_categories').html()));
            let cat_list = [];
            let cat_details_list = [];
            Object.keys(categories).sort().forEach(key => {
                cat_list.push( key );
                cat_details_list.push(categories[key]);
            });
            categories = cat_list.join('/');
            let category_details = cat_details_list.join('/');
            let parent_terms = [];
            jQuery('#new_treatment_parents li').each(function() {
                parent_terms.push(jQuery(this).text());
            });
            let parent_terms_json = JSON.stringify(parent_terms);

            jQuery.ajax({
                url: '/ajax/treatment/create',
                data : {
                    definition : definition,
                    name : name,
                    format : format,
                    default_value : default_value,
                    minimum : minimum,
                    maximum : maximum,
                    categories : categories,
                    category_details : category_details,
                    parent_terms : parent_terms_json,
                    repeat_type : repeat_type,
                    parent_dbs : "<% $db_name %>"
                },
                success: function(response) { 
                    jQuery('#working_modal').modal("hide");
                    if (response.error) {
                        alert(response.error);
                    } else {
                        alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.new_treatment_saved", "New treatment saved.") : "New treatment saved."));
                        window.location.reload();
                    }
                },
                error: function(response) { 
                    jQuery('#working_modal').modal("hide");
                    console.log(response);
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.root.an_error_occurred_check_console", "An error occurred, check console.") : "An error occurred, check console."));
                }
            });
        });

        jQuery('#new_treatment_parent_term').autocomplete({
            source : '/ajax/cvterm/autocompleteslim' + "?db_names=<% $db_name %>"
        });

        jQuery('#new_treatment_add_parent_btn').on('click', function(e) {
            e.preventDefault();
            let parent_term = jQuery('#new_treatment_parent_term').val().trim();
            if (parent_term) {
                jQuery('<li>').text(parent_term).appendTo('#new_treatment_parents');
                jQuery('#new_treatment_remove_parent_btn').show();
                jQuery('#new_treatment_parent_term').val('');
            }
        });

        jQuery('#new_treatment_remove_parent_btn').on('click', function(e) {
            e.preventDefault();
            jQuery('#new_treatment_parents li:last').remove();
            if (jQuery('#new_treatment_parents li').length === 0) {
                jQuery('#new_treatment_remove_parent_btn').hide();
            }
        });

        jQuery('#new_treatment_format_select').on('change', function () {
            let treatment_type = jQuery(this).val();
            if (treatment_type === 'numeric') {
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.root.default_value", "Default value:") : "Default value:"));
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'categorical') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').show();
                jQuery('#new_treatment_default_value_label').html((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.root.default_category", "Default category:") : "Default category:"));
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'ontology') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_container').hide();
                jQuery('#new_treatment_repeat_select_container').hide();
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
            } else if (treatment_type === 'percent') { 
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.root.default_value", "Default value:") : "Default value:"));
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('0');
                jQuery('#new_treatment_max_value').val('100');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'counter') {
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.root.default_value", "Default value:") : "Default value:"));
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('0');
                jQuery('#new_treatment_max_value').val('');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'boolean') {
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.root.default_value", "Default value:") : "Default value:"));
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('0');
                jQuery('#new_treatment_max_value').val('1');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'date') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_repeat_select_container').show();
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
            } else if (treatment_type === 'text') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_repeat_select_container').show();
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
            }
        });

        jQuery('#new_treatment_add_category_btn').on('click',function(e) {
            e.preventDefault();
            let new_category = jQuery('#new_treatment_add_category').val();
            let new_ordinal = jQuery('#new_treatment_category_ordinal').val();

            if (! new_ordinal) {
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.root.assign_an_ordinal_value_to_the_new_category", "Assign an ordinal value to the new category.") : "Assign an ordinal value to the new category."));
                return;
            }

            if (new_category.includes('/') || new_category.includes('=')){
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.root.no_special_characters", "No special characters.") : "No special characters."));
                return;
            }

            if (new_category !== null && new_category !== "" && new_category.trim() !== "" ) {
                let table_str = jQuery('#new_treatment_categories').html();
                let table_elems = [];
                if (table_str && table_str.trim() !== "") {
                    table_elems = JSON.parse(html_table_to_json(table_str));
                }
                table_elems[new_ordinal] = new_category;
                table_str = json_to_html_table(table_elems);
                jQuery('#new_treatment_categories').html(table_str);
                if (Object.keys(table_elems).length > 0) {
                    jQuery('#new_treatment_remove_category_btn').css('display', '');
                }
            }
            jQuery('#new_treatment_add_category').val('');
            jQuery('#new_treatment_category_ordinal').val('');
        });

        jQuery('#new_treatment_remove_category_btn').on('click',function(e) {
            e.preventDefault();
            let table_str = jQuery('#new_treatment_categories').html();
            let table_elems = JSON.parse(html_table_to_json(table_str));
            let max_key = Math.max( ... Object.keys(table_elems).map(Number));
            delete table_elems[max_key];
            if (Object.keys(table_elems).length == 0) {
                jQuery('#new_treatment_remove_category_btn').css('display', 'none');
            }
            table_str = json_to_html_table(table_elems);
            jQuery('#new_treatment_categories').html(table_str);
        });

        let ontology_db_names = "<% $db_name %>".split(",");
        ontology_db_names.forEach(function (db_name) {
            db_name = db_name.trim();
            if (db_name) {
                jQuery('#treatment_cvtermpath_rebuild_select').append(
                    jQuery('<option>', { value : db_name, text : db_name })
                );
            }
        });

        jQuery('#treatment_rebuild_cvtermpath_btn').click(function() {

            let db_name = jQuery('#treatment_cvtermpath_rebuild_select').val();

            if (!db_name || db_name == null || db_name == "") {
                alert("Please select a CV before rebuilding its cvterm paths.");
                return;
            }

            jQuery('#working_modal').modal("show");

            jQuery.ajax({
                url: '/ajax/onto/make_cvtermpath/' + db_name,
                method: 'GET',
                success: function(response) {
                    jQuery('#working_modal').modal("hide");
                    if (response.error) {
                        alert(response.error);
                        return;
                    }
                    alert(response.success);
                },
                error: function(xhr, status, error) {
                    jQuery('#working_modal').modal("hide");
                    alert("An error occurred starting the cvterm path rebuild: " + error);
                }
            });
        });

        jQuery('#download_ontology_btn').click(function() {

            jQuery('#working_modal').modal("show");

            fetch("/ajax/onto/download_obo/<% $db_name %>")
                .then(response => response.blob())
                .then(blob => {
                    jQuery('#working_modal').modal("hide");
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = "<% $db_name %>.txt";
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                })
                .catch(error => {
                    jQuery('#working_modal').modal("hide");
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.subplots.error_prefix", "An error occurred: ") : "An error occurred: ") + error);
                    console.error('Download failed:', error)
                });
        });

        jQuery("[title='ontology browser input form']").hide();

        function html_table_to_json(html_str) {
            let list = html_str.replace(/^<tr>|<\/?table>|<tr>|^\s+|<td>|<\/td>|<\/tr>$|\s+$/g,'').split("</tr>").filter(str => str.trim() !== '');
            let object = Object.fromEntries(list.map(cat => {
                    const [key, value] = cat.split("=").map(s => s.trim());
                    return [key, value];
                })
            );
            return JSON.stringify(object);
        }

        function json_to_html_table(json) {
            let html_arr = [];
            Object.keys(json).sort().forEach(key => {
                html_arr.push( key + " = " + json[key]);
            });
            return "<tr><td>"+html_arr.join("</td></tr><tr><td>")+"</td></tr>";
        }
    });
</script>

<%once>
use HTML::Entities ();
</%once>

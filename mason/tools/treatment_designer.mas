<%args>
    $db_name
</%args>

<div style="text-align: center; margin: 2em 0">
   <h2 style="margin-bottom: 1em">Design new experimental treatments</h2>
   <h4>Experimental treatments are applied to the stocks of a trial. Subplots, plants, and tissue samples inherit treatments from their parent stocks.</h4>

   <h4> Check the <a href='/search/treatments'>treatment search page</a> to see if your treatment has already been made before designing new treatments.</h4>

    <br>

   <div class="container-fluid">
        <ul class="nav nav-pills nav-justified" id="new_treatment_term_type_tabs" style="width:70%;margin:0 auto 2em auto;">
            <li class="active"><a data-toggle="pill" href="#new_treatment_variable_term_pane">New Treatment Variable</a></li>
            <li><a data-toggle="pill" href="#new_treatment_ontology_term_pane">New Ontology (Grouping) Term</a></li>
        </ul>
        <form class="form-horizontal" role="form" method="post" id="new_treatment_design_form" name="new_treatment_design_form" autocomplete="off">
        <div class="form-group">
                <label class="col-sm-3 control-label"> New treatment name: </label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_name" name="new_treatment_name" type="text" placeholder="Pipes (|)  will be removed from name."/>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label">Definition:</label>
                <div class="col-sm-9">
                    <textarea style="width:70%;" class="form-control" id="new_treatment_definition" name="new_treatment_definition" placeholder="Make it descriptive. Be sure to describe category meanings if using categorical data."></textarea>
                </div>
            </div>
            <div class="tab-content">
                <div id="new_treatment_variable_term_pane" class="tab-pane active">
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Treatment format:</label>
                        <div class="col-sm-9">
                            <select style="width:70%;" class="form-control" id="new_treatment_format_select" name="new_treatment_format_select" type="select">
                                <option value="numeric" selected>Numeric</option>
                                <option value="categorical">Categorical</option>
                                <option value="percent">Percent</option>
                                <option value="boolean">Boolean</option>
                                <option value="date">Date</option>
                                <option value="text">Text</option>
                                <option value="counter">Counter</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div id="new_treatment_ontology_term_pane" class="tab-pane"></div>
            </div>
            <div class="form-group" id="new_treatment_repeat_select_container">
                <label class="col-sm-3 control-label">Application type:</label>
                <div class="col-sm-9">
                    <select style="width:70%;" class="form-control" id="new_treatment_repeat_select" name="new_treatment_repeat_select" type="select">
                        <option value="single" selected>Single application</option>
                        <option value="multiple">Repeated application</option>
                        <option value="time_series">Time series</option>
                    </select>
                </div>
            </div>
            <div class="form-group" id="new_treatment_default_value_container">
                <label class="col-sm-3 control-label" id="new_treatment_default_value_label">Default value:</label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_default_value" name="new_treatment_default_value" type="text" placeholder="(Optional)"/>
                </div>
            </div>
            <div class="form-group" id="new_treatment_minimum_value_container">
                <label class="col-sm-3 control-label">Minimum value:</label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_min_value" name="new_treatment_min_value" type="text" placeholder="(Optional)"/>
                </div>
            </div>
            <div class="form-group" id="new_treatment_maximum_value_container">
                <label class="col-sm-3 control-label">Maximum value:</label>
                <div class="col-sm-9">
                    <input style="width:70%;" class="form-control" id="new_treatment_max_value" name="new_treatment_max_value" type="text" placeholder="(Optional)"/>
                </div>
            </div>
            <div class="form-group" id="new_treatment_add_categories_container" style="display:none;">
                <label class="col-sm-3 control-label">Add categories:</label>
                <div class="col-sm-9">
                    <table style="width:70%;">
                        <tr>
                            <td><input class="form-control" id="new_treatment_add_category" name="new_treatment_add_category" type="text" placeholder="Optional. No special characters."/></td>
                            <td style="width:25%"><input  class="form-control" id="new_treatment_category_ordinal" name="new_treatment_category_ordinal" type="number" placeholder="Ordinate"></td>
                            <td><button id="new_treatment_add_category_btn" class="btn btn-small btn-success">+</button></td>
                        </tr>
                    </table>
                    <table id="new_treatment_categories" style="width:30%;">
                    </table>
                    <em id="new_treatment_category_none" style="display:block;">None added</em>
                    <button id="new_treatment_remove_category_btn" class="btn btn-small btn-danger" style="display:none;float:left;"><span class="glyphicon glyphicon-trash"></span></button>
                </div>
            </div>
            <div class="form-group" id="chain_parent_term_container">
                <label class="col-sm-3 control-label" id="chain_parent_term"><span class="glyphicon glyphicon-question-sign" style="color:blue;font-size:18px" title="Should not be a variable term.
Will be the treatment root term by default if none are added."></span>&nbsp;Chain to existing term(s):</label>
                <div class="col-sm-9">
                    <table style="width:70%;">
                        <tr>
                            <td><input class="form-control" id="new_treatment_parent_term" name="new_treatment_parent_term" type="text" placeholder="Full name, as in 'Legacy experiment treatment|EXPERIMENT_TREATMENT:0000001'"/></td>
                            <td><button id="new_treatment_add_parent_btn" class="btn btn-small btn-success">+</button></td>
                        </tr>
                    </table>
                    <ul id="new_treatment_parents" style="text-align:left;width:70%;padding-left:1em;list-style-type:disc;"></ul>
                    <em id="new_treatment_parent_none" style="display:block;">None added</em>
                    <button id="new_treatment_remove_parent_btn" class="btn btn-small btn-danger" style="display:none;float:left;"><span class="glyphicon glyphicon-trash"></span></button>
                </div>
            </div>
            <div class="form-group" id="new_treatment_synonyms_container">
                <label class="col-sm-3 control-label"><span class="glyphicon glyphicon-question-sign" style="color:blue;font-size:18px" title="Alternate names for the new term. Synonyms must not already exist in the database."></span>&nbsp;Add synonyms:</label>
                <div class="col-sm-9">
                    <table style="width:70%;">
                        <tr>
                            <td><input class="form-control" id="new_treatment_synonym" name="new_treatment_synonym" type="text" placeholder="Optional. Pipes (|) will be removed."/></td>
                            <td><button id="new_treatment_add_synonym_btn" class="btn btn-small btn-success">+</button></td>
                        </tr>
                    </table>
                    <ul id="new_treatment_synonyms" style="text-align:left;width:70%;padding-left:1em;list-style-type:disc;"></ul>
                    <em id="new_treatment_synonym_none" style="display:block;">None added</em>
                    <button id="new_treatment_remove_synonym_btn" class="btn btn-small btn-danger" style="display:none;float:left;"><span class="glyphicon glyphicon-trash"></span></button>
                </div>
            </div>
        </form>
        <button class="btn btn-primary" id="new_treatment_submit_btn">Submit</button>
    </div>
</div>

<button id="download_ontology_btn" class="btn btn-primary">Download Treatment Ontology</button>
&nbsp;&nbsp;&nbsp;&nbsp;
<br>
<br>
% 
% my $root_nodes = $db_name =~ s/,/ /gr; # should just be EXPERIMENT_TREATMENT
% 
<&| /page/info_section.mas, title=>"Treatment terms", collapsible=>1 &>
    <& /ontology/browser.mas, root_nodes=>$root_nodes, db_name => $db_name, expand=>1 &>
</&>

<script>
    jQuery(document).ready(function () {

        jQuery('#new_treatment_submit_btn').on('click', function (e) {

            let pending_parent_term = jQuery('#new_treatment_parent_term').val().trim();
            if (pending_parent_term && jQuery('#new_treatment_parents li').length === 0) {
                e.preventDefault();
                alert("Did you finish entering parent terms? You entered " + pending_parent_term + ", but did not add it to the list of parents.");
                return;
            }

            jQuery('#working_modal').modal("show");

            let name = jQuery('#new_treatment_name').val();
            let definition = jQuery('#new_treatment_definition').val();
            let format = get_new_treatment_format();
            let default_value = jQuery('#new_treatment_default_value').val();
            let minimum = jQuery('#new_treatment_min_value').val();
            let maximum = jQuery('#new_treatment_max_value').val();
            let repeat_type = jQuery('#new_treatment_repeat_select').val();
            let categories = JSON.parse(html_table_to_json(jQuery('#new_treatment_categories').html()));
            let cat_list = [];
            let cat_details_list = [];
            Object.keys(categories).sort().forEach(key => {
                cat_list.push( key );
                cat_details_list.push(categories[key]);
            });
            categories = cat_list.join('/');
            let category_details = cat_details_list.join('/');
            let parent_terms = [];
            jQuery('#new_treatment_parents li').each(function() {
                parent_terms.push(jQuery(this).text());
            });
            let parent_terms_json = JSON.stringify(parent_terms);
            let synonyms = [];
            if (format !== 'ontology') {
                jQuery('#new_treatment_synonyms li').each(function() {
                    synonyms.push(jQuery(this).text());
                });
            }
            let synonyms_json = JSON.stringify(synonyms);

            jQuery.ajax({
                url: '/ajax/treatment/create',
                data : {
                    definition : definition,
                    name : name,
                    format : format,
                    default_value : default_value,
                    minimum : minimum,
                    maximum : maximum,
                    categories : categories,
                    category_details : category_details,
                    parent_terms : parent_terms_json,
                    synonyms : synonyms_json,
                    repeat_type : repeat_type,
                    parent_dbs : "<% $db_name %>"
                },
                success: function(response) { 
                    jQuery('#working_modal').modal("hide");
                    if (response.error && response.term_stored) {
                        alert(response.error);
                        window.location.reload();
                    } else if (response.error) {
                        alert(response.error);
                    } else {
                        alert("New treatment saved.");
                        window.location.reload();
                    }
                },
                error: function(response) { 
                    jQuery('#working_modal').modal("hide");
                    console.log(response);
                    alert("An error occurred, check console.");
                }
            });
        });

        jQuery('#new_treatment_parent_term').autocomplete({
            source : '/ajax/cvterm/autocompleteslim' + "?db_names=<% $db_name %>"
        });

        jQuery('#new_treatment_add_parent_btn').on('click', function(e) {
            e.preventDefault();
            let parent_term = jQuery('#new_treatment_parent_term').val().trim();
            if (parent_term) {
                jQuery('<li>').text(parent_term).appendTo('#new_treatment_parents');
                jQuery('#new_treatment_remove_parent_btn').show();
                jQuery('#new_treatment_parent_none').hide();
                jQuery('#new_treatment_parent_term').val('');
            }
        });

        jQuery('#new_treatment_add_synonym_btn').on('click', function(e) {
            e.preventDefault();
            let synonym = jQuery('#new_treatment_synonym').val().trim();
            if (synonym) {
                jQuery('<li>').text(synonym).appendTo('#new_treatment_synonyms');
                jQuery('#new_treatment_remove_synonym_btn').show();
                jQuery('#new_treatment_synonym_none').hide();
                jQuery('#new_treatment_synonym').val('');
            }
        });

        jQuery('#new_treatment_remove_synonym_btn').on('click', function(e) {
            e.preventDefault();
            jQuery('#new_treatment_synonyms li:last').remove();
            if (jQuery('#new_treatment_synonyms li').length === 0) {
                jQuery('#new_treatment_remove_synonym_btn').hide();
                jQuery('#new_treatment_synonym_none').show();
            }
        });

        jQuery('#new_treatment_remove_parent_btn').on('click', function(e) {
            e.preventDefault();
            jQuery('#new_treatment_parents li:last').remove();
            if (jQuery('#new_treatment_parents li').length === 0) {
                jQuery('#new_treatment_remove_parent_btn').hide();
                jQuery('#new_treatment_parent_none').show();
            }
        });

        function get_new_treatment_format() {
            if (jQuery('#new_treatment_ontology_term_pane').hasClass('active')) {
                return 'ontology';
            }
            return jQuery('#new_treatment_format_select').val();
        }

        // Prototype.js (loaded by the ontology browser) adds Element#hide, which jQuery calls natively
        // when Bootstrap triggers 'hide.bs.tab' on the outgoing pill, hiding it. Shadow it on the pills.
        jQuery('#new_treatment_term_type_tabs a[data-toggle="pill"]').each(function () {
            this.hide = null;
        });

        jQuery('#new_treatment_term_type_tabs a[data-toggle="pill"]').on('shown.bs.tab', function () {
            update_new_treatment_form();
        });

        jQuery('#new_treatment_format_select').on('change', function () {
            update_new_treatment_form();
        });

        function update_new_treatment_form() {
            let treatment_type = get_new_treatment_format();
            jQuery('#new_treatment_synonyms_container').toggle(treatment_type !== 'ontology');
            if (treatment_type === 'numeric') {
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html("Default value:");
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'categorical') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').show();
                jQuery('#new_treatment_default_value_label').html("Default category:");
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'ontology') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_container').hide();
                jQuery('#new_treatment_repeat_select_container').hide();
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
            } else if (treatment_type === 'percent') { 
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html("Default value:");
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('0');
                jQuery('#new_treatment_max_value').val('100');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'counter') {
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html("Default value:");
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('0');
                jQuery('#new_treatment_max_value').val('');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'boolean') {
                jQuery('#new_treatment_minimum_value_container').show();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_maximum_value_container').show();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_label').html("Default value:");
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('0');
                jQuery('#new_treatment_max_value').val('1');
                jQuery('#new_treatment_repeat_select_container').show();
            } else if (treatment_type === 'date') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_repeat_select_container').show();
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
            } else if (treatment_type === 'text') {
                jQuery('#new_treatment_minimum_value_container').hide();
                jQuery('#new_treatment_maximum_value_container').hide();
                jQuery('#new_treatment_add_categories_container').hide();
                jQuery('#new_treatment_default_value_container').show();
                jQuery('#new_treatment_repeat_select_container').show();
                jQuery('#new_treatment_default_value').val('');
                jQuery('#new_treatment_min_value').val('');
                jQuery('#new_treatment_max_value').val('');
            }
        }

        jQuery('#new_treatment_add_category_btn').on('click',function(e) {
            e.preventDefault();
            let new_category = jQuery('#new_treatment_add_category').val();
            let new_ordinal = jQuery('#new_treatment_category_ordinal').val();

            if (! new_ordinal) {
                alert("Assign an ordinal value to the new category.");
                return;
            }

            if (new_category.includes('/') || new_category.includes('=')){
                alert("No special characters.");
                return;
            }

            if (new_category !== null && new_category !== "" && new_category.trim() !== "" ) {
                let table_str = jQuery('#new_treatment_categories').html();
                let table_elems = [];
                if (table_str && table_str.trim() !== "") {
                    table_elems = JSON.parse(html_table_to_json(table_str));
                }
                table_elems[new_ordinal] = new_category;
                table_str = json_to_html_table(table_elems);
                jQuery('#new_treatment_categories').html(table_str);
                if (Object.keys(table_elems).length > 0) {
                    jQuery('#new_treatment_remove_category_btn').css('display', '');
                    jQuery('#new_treatment_category_none').hide();
                }
            }
            jQuery('#new_treatment_add_category').val('');
            jQuery('#new_treatment_category_ordinal').val('');
        });

        jQuery('#new_treatment_remove_category_btn').on('click',function(e) {
            e.preventDefault();
            let table_str = jQuery('#new_treatment_categories').html();
            let table_elems = JSON.parse(html_table_to_json(table_str));
            let max_key = Math.max( ... Object.keys(table_elems).map(Number));
            delete table_elems[max_key];
            if (Object.keys(table_elems).length == 0) {
                jQuery('#new_treatment_remove_category_btn').css('display', 'none');
                jQuery('#new_treatment_category_none').show();
            }
            table_str = json_to_html_table(table_elems);
            jQuery('#new_treatment_categories').html(table_str);
        });

        let ontology_db_names = "<% $db_name %>".split(",");
        ontology_db_names.forEach(function (db_name) {
            db_name = db_name.trim();
            if (db_name) {
                jQuery('#treatment_cvtermpath_rebuild_select').append(
                    jQuery('<option>', { value : db_name, text : db_name })
                );
            }
        });

        jQuery('#treatment_rebuild_cvtermpath_btn').click(function() {

            let db_name = jQuery('#treatment_cvtermpath_rebuild_select').val();

            if (!db_name || db_name == null || db_name == "") {
                alert("Please select a CV before rebuilding its cvterm paths.");
                return;
            }

            jQuery('#working_modal').modal("show");

            jQuery.ajax({
                url: '/ajax/onto/make_cvtermpath/' + db_name,
                method: 'GET',
                success: function(response) {
                    jQuery('#working_modal').modal("hide");
                    if (response.error) {
                        alert(response.error);
                        return;
                    }
                    alert(response.success);
                },
                error: function(xhr, status, error) {
                    jQuery('#working_modal').modal("hide");
                    alert("An error occurred starting the cvterm path rebuild: " + error);
                }
            });
        });

        jQuery('#download_ontology_btn').click(function() {

            jQuery('#working_modal').modal("show");

            fetch("/ajax/onto/download_obo/<% $db_name %>")
                .then(response => response.blob())
                .then(blob => {
                    jQuery('#working_modal').modal("hide");
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = "<% $db_name %>.txt";
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    window.URL.revokeObjectURL(url);
                })
                .catch(error => {
                    jQuery('#working_modal').modal("hide");
                    alert("An error occurred: " + error);
                    console.error('Download failed:', error)
                });
        });

        // jQuery("[title='ontology browser input form']").hide();

        function html_table_to_json(html_str) {
            let list = html_str.replace(/^<tr>|<\/?table>|<tr>|^\s+|<td>|<\/td>|<\/tr>$|\s+$/g,'').split("</tr>").filter(str => str.trim() !== '');
            let object = Object.fromEntries(list.map(cat => {
                    const [key, value] = cat.split("=").map(s => s.trim());
                    return [key, value];
                })
            );
            return JSON.stringify(object);
        }

        function json_to_html_table(json) {
            let html_arr = [];
            Object.keys(json).sort().forEach(key => {
                html_arr.push( key + " = " + json[key]);
            });
            return "<tr><td>"+html_arr.join("</td></tr><tr><td>")+"</td></tr>";
        }
    });
</script>
  use JSON::Any;
  
</%perl>


<& '/util/import_javascript.mas', classes => ['jquery', 'jqueryui', 'CXGN.Login', 'd3.d3v4Min.js', 'CXGN.BreedersToolbox.HTMLSelect'] &>

<script src="https://cdn.jsdelivr.net/npm/vega@4"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-lite@2"></script>
<script src="https://cdn.jsdelivr.net/npm/vega-embed@4"></script>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("navigation.analyze.heritability", "Heritability")) &>


<&| /page/info_section.mas, anchor_title => "Select Input Data", id=>"input_dataset_section", title=>HTML::Entities::encode_entities($c->i18n->p("analysis.interface.select_input_data", "Select Input Data")), collapsible=>1, collapsed=>0, subtitle=>("<a class=\"btn btn-link pull-right\" href=\"/help/heritability\" target=\"_blank\">" . HTML::Entities::encode_entities($c->i18n->p("global.search.datasets.help", "Help")) . " <span class=\"glyphicon glyphicon-question-sign\"></span></a>") &>
  <input type="hidden" name="outformat" value="0" />


  <div class="form-group form-inline">
    <label for="dataset_select"><% $c->i18n->p("analysis.interface.available_datasets", "Available Datasets:") |h %> </label><div id="dataset_select"></div>
    <br>

    <button class="btn btn-primary" id="selectDataset" type="submit" name="selectDataset" value="selectDataset"><% $c->i18n->p("analysis.interface.select_dataset", "Select Dataset") |h %></button>
    <br>
    <br>

    </div>


      <div class="form-group form-inline">
        <label class="blast_select_label" for="pheno_select"><% $c->i18n->p("analysis.interface.available_nbsptraits", "Available&nbspTraits:") %>&nbsp; </label>
      <& /page/html_select.mas, name=>'pheno_select', id=>'pheno_select', params=>"class\=\"form-control input-sm blast_select_box\"", choices=>"" &>
      <button class="btn btn-primary" id="preview_trait_histogram_btn" type="submit" name="preview_trait_histogram_btn" value="preview_trait_histogram_btn"><% $c->i18n->p("analysis.interface.view_trait_histogram", "View Trait Histogram") |h %></button>
      <img id="loading-spinner" src="/img/wheel.gif" alt="loading" style="visibility: hidden;">
      <br>
      <input type="checkbox" id="dataset_trait_outliers" />
      <label><% $c->i18n->p("analysis.interface.exclude_dataset_outliers", "Exclude dataset outliers") |h %> &nbsp; </label><% '          ' %>
      <br>
      <br>
      <br>
      <center>
        <div id="trait_histogram_plot">
        </div>
      </center>
    

    <br>


    <!--    <label class="blast_select_label" for="geno_select">Genotypes &nbsp; </label>
        <& /page/html_select.mas, name=>'geno_select', id=>'geno_select', params=>"class\=\"form-control input-sm blast_select_box\"", choices=>"" &> -->
        <br>

        </div>

            <div style="text-align: center">
              <button class="btn btn-primary" id="runH2" type="submit" name="runH2" value="runH2"><% $c->i18n->p("analysis.interface.run_heritability", "Run Heritability") |h %></button>
            </div>
            <br />

    <div id="tempfile" style="display:none" >
    </div>





</&>



<&| /page/info_section.mas, anchor_title => "Instructions", title=>HTML::Entities::encode_entities($c->i18n->p("trial.fieldmap.instructions", "Instructions")), collapsible=>1, collapsed=>1, subtitle=>("<a id=\"download_table\" class=\"download_tag\" target=\"_blank\" href=\"javascript:download_table();\" title=\"" . HTML::Entities::encode_entities($c->i18n->p("analysis.interface.download_results_in_tabular_format", "Download results in tabular format")) . "\">" . HTML::Entities::encode_entities(HTML::Entities::decode_entities($c->i18n->p("analysis.interface.table_8675", "Table&#8675;"))) . "</a>&nbsp;&nbsp;<a id=\"download_basic\" class=\"download_tag\" target=\"_blank\" href=\"javascript:download();\" title=\"" . HTML::Entities::encode_entities($c->i18n->p("analysis.interface.download_results_in_basic_format", "Download results in basic format")) . "\">" . HTML::Entities::encode_entities(HTML::Entities::decode_entities($c->i18n->p("analysis.interface.basic_8675", "Basic&#8675;"))) . "</a>") &>



  <center>
    <div id="sgn_blast_graph" style="display:none">
        <div id="myCanvas">
          <% $c->i18n->p("analysis.interface.your_browser_does_not_support_the_html5_canvas", "Your browser does not support the HTML5 canvas") |h %>
        </div>
    </div>
  </center>
  <br>
  <h5><b><% $c->i18n->p("analysis.interface.dataset", "Dataset:") |h %></b></h5>
  <h5><% $c->i18n->p("analysis.interface.1_the_dataset_must_contain_trails_and_numerical_traits_inclusion", "1. The dataset must contain trails and numerical traits. Inclusion of accession, plots, locations, and years is optional.") |h %></h5>
  <h5><% $c->i18n->p("analysis.interface.2_the_model_will_adapt_to_your_dataset_for_instance", "2. The model will adapt to your dataset. For instance, if the dataset has more than one location, then the model will take the interaction among locations and accessions.") |h %></h5>
  <h5><% $c->i18n->p("analysis.interface.3_traits_with_more_than_60_of_missing_data_are", "3. Traits with more than 60% of missing data are removed from the analysis.") |h %></h5>
  <h5><% $c->i18n->p("analysis.interface.4_outliers_can_be_removed_by_accessing_the", "4. Outliers can be removed by accessing the") |h %> <a href="/search/datasets" target="_blank"> <% $c->i18n->p("analysis.interface.datasets_tab", "Datasets tab") |h %> </a>. </h5>
  <h5><% $c->i18n->p("analysis.interface.5_selecting_the_exclude_dataset_outliers_heritability_is_calculated_using", "5. Selecting the 'Exclude dataset outliers', heritability is calculated using filtered data.") |h %></h5>


</&>


<&| /page/info_section.mas, anchor_title => "Output", title=>HTML::Entities::encode_entities($c->i18n->p("genotype.comparison.step.output", "Output")), collapsible=>1, collapsed=>0, subtitle=>("<a id=\"download_table\" class=\"download_tag\" target=\"_blank\" href=\"javascript:download_table();\" title=\"" . HTML::Entities::encode_entities($c->i18n->p("analysis.interface.download_results_in_tabular_format", "Download results in tabular format")) . "\">" . HTML::Entities::encode_entities(HTML::Entities::decode_entities($c->i18n->p("analysis.interface.table_8675", "Table&#8675;"))) . "</a>&nbsp;&nbsp;<a id=\"download_basic\" class=\"download_tag\" target=\"_blank\" href=\"javascript:download();\" title=\"" . HTML::Entities::encode_entities($c->i18n->p("analysis.interface.download_results_in_basic_format", "Download results in basic format")) . "\">" . HTML::Entities::encode_entities(HTML::Entities::decode_entities($c->i18n->p("analysis.interface.basic_8675", "Basic&#8675;"))) . "</a>") &>



  <center>
    <div id="sgn_blast_graph" style="display:none">
        <div id="myCanvas">
          <% $c->i18n->p("analysis.interface.your_browser_does_not_support_the_html5_canvas", "Your browser does not support the HTML5 canvas") |h %>
        </div>
    </div>
  </center>
  <br>
  <center>
    <div id="heritability_output"></div>
    <br>
    <button class="btn btn-primary" id="download-button"><% $c->i18n->p("analysis.interface.download_csv", "Download CSV") |h %></button>
  </center>
  <div id="Overview_output"></div>
  <div id="Coverage_output"></div>
  <div id="Table_output" style="min-width:900px;"></div>
  <div id="Bioperl_output"></div>
  <div id="Basic_output"></div>

</&>
<script>


var require_login = "<%  $c->get_conf('brapi_require_login') %>";
if (require_login === '1'){
    auth_token = "<%  CXGN::Login->new($c->dbc->dbh)->get_login_cookie() %>";
    if (!auth_token){ alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.login_required_to_display_heritability", "Login required to display heritability") : "Login required to display heritability")); }
}

var check_outliers = "<% $c->get_conf('exclude_phenotype_outliers') || 0 %>";

if (parseInt(check_outliers) === 1) {
    document.getElementById('dataset_trait_outliers').checked = true;
}

jQuery(document).ready(function() {
  if (isLoggedIn()) {
    get_select_box("datasets", "dataset_select", {"checkbox_name":"dataset_select_checkbox", "analysis_type":"Heritability", "show_compatibility":"yes"});
  }
  else {
    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.you_must_be_logged_in_to_use_heritability", "You must be logged in to use Heritability") : 'You must be logged in to use Heritability'));
  }
  $('#pheno_select').attr("disabled",true).html('');
  jQuery('#dataset_select').click(function() {
    $('#pheno_select').attr("disabled",true).html('');
    $('#trait_histogram_plot').html('');
    $('#heritability_output').empty();
  });

  jQuery('#selectDataset').click(function() {
    var dataset_id = get_dataset_id();    
    if (!dataset_id) {
      return;
    }

    dataset_trait_outliers = $('#dataset_trait_outliers').is(':checked') ? 1 : 0;
    document.getElementById("preview_trait_histogram_btn").disabled = true;  
    document.getElementById("loading-spinner").style.visibility = 'visible'; 
    $.ajax({
      url: '/ajax/heritability/shared_phenotypes',      
      data: {
        'dataset_id': dataset_id,
        'dataset_trait_outliers': dataset_trait_outliers,
        },
      success: function(response) {
        if (response.error) {
          $('#dataset_select').val('ERROR');            
          document.getElementById("loading-spinner").style.visibility = 'hidden';  
        }
        else {	        
	        var option_html = '<option selected="selected" value=""> </option>';
	        for (var i = 0; i < response.options.length; i++) {
	          option_html += '<option value="'+response.options[i][1]+'">'+(response.options[i][1])+'</option>';
	        }
	        $('#pheno_select').attr("disabled",false).html(option_html);
          jQuery('#tempfile').html(response.tempfile);
          document.getElementById("preview_trait_histogram_btn").disabled = false;
          document.getElementById("loading-spinner").style.visibility = 'hidden';
	      }

      },
      error: function(response) {
        alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.an_error_occurred_the_service_may_temporarily_be_unavailable_ponto", "An error occurred, the service may temporarily be unavailable, ponto 1 selectDataset ") : "An error occurred, the service may temporarily be unavailable, ponto 1 selectDataset "));
        document.getElementById("preview_trait_histogram_btn").disabled = false;
        document.getElementById("loading-spinner").style.visibility = 'hidden';
      }
    });
  });

  jQuery('#preview_trait_histogram_btn').on('click', function() {
    if (!jQuery('#pheno_select').val()) {
      alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.please_select_a_dataset_and_trait", "Please select a dataset and trait.") : "Please select a dataset and trait."))
    } else {
      //alert("Inside trait preview");
      var tempfile = jQuery('#tempfile').html();
      var trait = jQuery('#pheno_select').val();
      //alert(trait);
      jQuery.ajax( {
          url: '/ajax/heritability/getdata',
          data: { 'file' : tempfile },
          success: function(r)  {
          //alert("data grabbed "+JSON.stringify(r.data));
          var v = {
              "$schema": "https://vega.github.io/schema/vega-lite/v2.json",
              "width": 200,
              "height": 100,
              "padding": 5,
              "data": { 'values': r.data },
              "mark": "bar",
              "encoding": {
              "x": {
                "bin": true,
                "field": trait,
                "type": "quantitative"
              },
              "y": {
                "aggregate": "count",
                "type": "quantitative"
              }
             }
            };
            vegaEmbed("#trait_histogram_plot", v);
          },
        error: function(e) { alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.error", "error!") : 'error!')); }
      });
    };
  });

  jQuery('#dataset_trait_outliers').on('click', function() {
    var dataset_id = get_dataset_id();
    if (!dataset_id) {
      return;
    }  
    var  dataset_trait_outliers = $('#dataset_trait_outliers').is(':checked') ? 1 : 0;
    document.getElementById("preview_trait_histogram_btn").disabled = true;  
    document.getElementById("loading-spinner").style.visibility = 'visible';    
    $.ajax({
      url: '/ajax/heritability/shared_phenotypes',
      data: {
        'dataset_id': dataset_id,
        'dataset_trait_outliers': dataset_trait_outliers,
      },            
      success: function(response) {
        if (response.error) {
          $('#dataset_select').val('ERROR');          
          alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.an_error_occurred_the_is_some_problem_with_data", "An error occurred, the is some problem with data") : "An error occurred, the is some problem with data"));
          document.getElementById("loading-spinner").style.visibility = 'hidden';
        }
        else {	        
          jQuery('#tempfile').html(response.tempfile);
          document.getElementById("preview_trait_histogram_btn").disabled = false;
          document.getElementById("loading-spinner").style.visibility = 'hidden'; 
	      }
      },
      error: function(response) {
        alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.an_error_occurred_the_service_may_temporarily_be_unavailable", "An error occurred, the service may temporarily be unavailable") : "An error occurred, the service may temporarily be unavailable"));
        document.getElementById("preview_trait_histogram_btn").disabled = false; 
        document.getElementById("loading-spinner").style.visibility = 'hidden';
      }
    });

  });


  jQuery('#runH2').click( function () {
    if (!jQuery('#pheno_select').val()) {
      alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.please_select_a_dataset_and_trait", "Please select a dataset and trait.") : "Please select a dataset and trait."));
      $('#heritability_output').empty();      
    } else {
      $('#heritability_output').empty();

      if ($('#pheno_select').val() != ""){
        var dataset_id = get_dataset_id();
        console.log("dataset_id", dataset_id);
        var trait_id = $('#pheno_select').val();

        console.log("trait_id", trait_id);
        var dataset_trait_outliers = $('#dataset_trait_outliers').is(':checked') ? 1 : 0;

        $.ajax({
          url: '/ajax/heritability/generate_results',
          data: {
            'dataset_id': dataset_id, 
            'trait_id': trait_id,
            'dataset_trait_outliers': dataset_trait_outliers,            
            },
          beforeSend: function() {
            jQuery("#working_modal").modal("show");
          },

          timeout: 30000000,
          success: function(response) {
            jQuery("#working_modal").modal("hide");
            
			if (response.error) {
              alert(response.error);
            }          

			$.getJSON(response.h2Table, function(data){
				var parsedData = JSON.parse(data);
				var traitValue = '';
				var varG = '';
				var varE = '';
				var varRes = '';
				var herit = ''; 

				var table = '<table>';
				table += ("<thead><tr><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.population_cgi.trait", "Trait") : "Trait")).html() + "</th><th>Vg</th><th>Ve</th><th>Vres</th><th>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("navigation.analyze.heritability", "Heritability") : "Heritability")).html() + "</th></tr></thead>");
				table += '<tbody>';

				for (var i = 0; i < parsedData.length; i++) {
					traitValue = parsedData[i].trait;
					varG = parsedData[i].Vg;
					varE = parsedData[i].Ve;
					varRes = parsedData[i].Vres;
					herit = parsedData[i].Hert;

					// Create a row for each data point
					table += '<tr>';
					table += '<td>' + traitValue + '</td>';
					table += '<td>' + varG + '</td>';
					table += '<td>' + varE + '</td>';
					table += '<td>' + varRes + '</td>';
					table += '<td>' + herit + '</td>';
					table += '</tr>';
				}
				$('#heritability_output').append(table);
                
                $('#download-button').click(function() {
					var csvContent = "data:text/csv;charset=utf-8,";

					// Add table headers to CSV content
					csvContent += "Trait,Vg,Ve,Vres,Heritability\n";

					// Add table data to CSV content
					for (var i = 0; i < parsedData.length; i++) {
						var row = parsedData[i];
						csvContent += row.trait + "," + row.Vg + "," + row.Ve + "," + row.Vres + "," + row.Hert + "\n";
					}

					// Create a data URI for the CSV content
					var encodedUri = encodeURI(csvContent);

					// Create a download link
					var link = document.createElement("a");
					link.setAttribute("href", encodedUri);
					link.setAttribute("download", "heritability_data.csv");
					link.innerHTML = (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.download_csv", "Download CSV") : "Download CSV");

					// Trigger the click event to download the file
					link.click();
                });

			}).fail(function(){
				console.log("An error has occurred.");
				});                                           
		  },
          error: function(xhr, status, error) {
            var err = eval("(" + xhr.responseText + ")");
            alert(err.Message);
          }
        });
      }
    };
  });

function get_dataset_id() {
      var selected_datasets = [];
      jQuery('input[name="dataset_select_checkbox"]:checked').each(function() {
          selected_datasets.push(jQuery(this).val());
      });
      if (selected_datasets.length < 1){
          alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.please_select_at_least_one_dataset", "Please select at least one dataset!") : 'Please select at least one dataset!'));
          return false;
      } else if (selected_datasets.length > 1){
          alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("analysis.interface.please_select_only_one_dataset", "Please select only one dataset!") : 'Please select only one dataset!'));
          return false;
      } else {
    var dataset_id=selected_datasets[0];
    return dataset_id;
    }
  }
});


</script>

<!-- STYLE -->
<style>

h1 {
  display:none;
}

.seq_map {
	color: #777777;
	width: 700px;
	position:relative;
	overflow: auto;
	align: left;
}

.blast_select_box {
  width:300px;
  margin-right:10px;
}

.blast_select_label {
  width:100px;
  margin-right:10px;
  line-height: 32px;
}

.ui-dialog {
	position:relative;
}

#region_square {
	position:absolute;
	vertical-align:middle;
}
.help_dialog {
	color:blue;
	cursor:pointer
}
#desc_dialog {
	overflow: auto;
	position: relative;
}
.help_box {
	background-color:#EEEEFE;
	border-color:#AAA;
	border-width:2px;
	border-style:solid;
	border-radius:5px;
	padding-left: 10px;
	padding-right: 10px;
}

#sequence {
  min-height: 80px;
  max-height: 300px;
  max-width: 98%;
}

.download_tag {
  display:none;
}

/* BLAST canvas Graph */

.width-1000 {
  width: 1000px;
  text-align: center;
}

#sgn_blast_graph {
  overflow:hidden;
}

table {
    border-collapse: collapse;
    width: 100%;
}

table, th, td {
    border: 1px solid black;
}

th, td {
    padding: 8px;
    text-align: left;
}

th {
    background-color: #f2f2f2;
}


#myCanvas {
  height:450px;
  width:1020px;
  overflow:scroll;
  overflow-x: hidden;
}


</style>

.sf-review-alt h4 { font-size: 15px; }
.sf-review-compare th, .sf-review-compare td { text-align: center; }
.sf-review-compare td:first-child, .sf-review-compare th:first-child { text-align: left; }
.sf-agree-hi { color: #2b7a4b; font-weight: 600; }

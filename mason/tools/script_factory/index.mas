.sf-review-list p { margin: 4px 0 0; font-size: 13px; }
.sf-review-tag { margin-left: 8px; font-size: 11px; color: #4a7fa5; background: #e3eef6; border-radius: 10px; padding: 1px 8px; }
.sf-review-note .sf-review-tag { color: #6b7280; background: #ececea; }

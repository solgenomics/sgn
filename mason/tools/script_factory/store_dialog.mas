<%doc>

=head1 NAME

/tools/script_factory/store_dialog.mas - "Store analysis" form of the Script Factory, shared by the
builder page and the results dashboard (logic in js/source/modules/script_factory_store.js)

=cut

</%doc>

<div class="modal fade" id="sf_store_modal" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title"><span class="glyphicon glyphicon-floppy-disk"></span> Store the analysis in Breedbase</h4>
      </div>
      <div class="modal-body">
        <p class="help-block">Everything is filled in from this run; change anything you like. The genotype values become an analysis (visible under Manage &gt; Analyses) and the script is kept as its model, so the analysis can be traced and repeated.</p>
        <form class="form-horizontal" onsubmit="return false;">
          <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label" for="sf_store_name">Analysis name</label>
            <div class="col-sm-9"><input class="form-control" id="sf_store_name" type="text" /></div>
          </div>
          <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label" for="sf_store_description">Description</label>
            <div class="col-sm-9"><textarea class="form-control" id="sf_store_description" rows="3"></textarea></div>
          </div>
          <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label" for="sf_store_program">Breeding program</label>
            <div class="col-sm-5"><select class="form-control" id="sf_store_program"><option value="">loading...</option></select></div>
            <label class="col-sm-1 control-label" for="sf_store_year">Year</label>
            <div class="col-sm-3"><input class="form-control" id="sf_store_year" type="number" min="1900" max="2999" /></div>
          </div>
          <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label" for="sf_store_public">Script (model)</label>
            <div class="col-sm-9"><select class="form-control" id="sf_store_public">
              <option value="yes">Public: other users can see how the values were computed</option>
              <option value="no">Private</option>
            </select></div>
          </div>
        </form>
        <div id="sf_store_summary"></div>
        <div id="sf_store_message"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="sf_store_submit"><span class="glyphicon glyphicon-floppy-disk"></span> Save</button>
      </div>
    </div>
  </div>
</div>


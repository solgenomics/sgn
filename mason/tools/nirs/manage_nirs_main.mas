<%args>
$nirs_files => undef
$deleted_nirs_files => undef
$all_nirs_files => undef
$all_deleted_nirs_files => undef
$locations => undef
$sampling_facilities => ()
$sample_tissue_types => ()
</%args>

<& /tools/high_dimensional_phenotypes/upload_high_dim_spreadsheet_dialogs.mas &>
<& /tools/high_dimensional_phenotypes/download_high_dim_phenotypes_dialogs.mas &>
<& /tools/high_dimensional_phenotypes/download_high_dim_phenotypes_relationship_matrix_dialogs.mas &>
<& /tools/nirs/nirs_analysis_train_dialogs.mas &>
<& /tools/nirs/nirs_analysis_predict_dialogs.mas &>
<& /tools/nirs/nirs_analysis_plot_spectra_dialogs.mas &>
<& /breeders_toolbox/sampling_trials/create_sampling_trials_dialogs.mas, sampling_facilities=>$sampling_facilities, sample_tissue_types=>$sample_tissue_types &>

<div class="well">
<&| /page/info_section.mas, anchor_title => "Uploaded NIRS Data", title=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.uploaded_nirs_data", "Uploaded NIRS Data")), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.view_and_manage_uploaded_nirs_data_files", "View and manage uploaded NIRS data files")) &>

    <&| /page/info_section.mas, anchor_title => "Your Uploaded NIRS Data", title=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.your_uploaded_nirs_data", "Your Uploaded NIRS Data")), is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, anchor_title => "Your Obsoleted NIRS Data", title=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.your_obsoleted_nirs_data", "Your Obsoleted NIRS Data")), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.these_are_deleted_nirs_files", "These are deleted NIRS files")) &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$deleted_nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, anchor_title => "All Uploaded NIRS Data", title=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.all_uploaded_nirs_data", "All Uploaded NIRS Data")), is_subsection=>1, collapsible=>1, collapsed=>1 &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$all_nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, anchor_title => "All Obsoleted NIRS Data", title=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.all_obsoleted_nirs_data", "All Obsoleted NIRS Data")), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.these_are_deleted_nirs_files", "These are deleted NIRS files")) &>
        <div class="panel panel-default">
            <div class="panel-body">
                <& /breeders_toolbox/file_list.mas, files=>$all_deleted_nirs_files, allow_delete=>0 &>
            </div>
        </div>
    </&>
</&>
</div>

<div class="well">
<&| /page/info_section.mas, anchor_title => "NIRS Analyses", title=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.nirs_analyses", "NIRS Analyses")), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.view_and_manage_your_nirs_analyses", "View and manage your NIRS analyses")) &>
    <div class="panel panel-default">
        <div class="panel-body">
            <table class="table table-bordered table-hover" id="analyses_by_user_table">
              <thead>
              <tr>
                <th>
                  <% $c->i18n->p("nirs.manage.column_analysis_name", "Analysis Name") |h %>
                </th>
                <th>
                  <% $c->i18n->p("nirs.manage.column_description", "Description") |h %>
                </th>
                <th>
                  <% $c->i18n->p("nirs.manage.column_model_type", "Model Type") |h %>
                </th>
                <th>
                  <% $c->i18n->p("nirs.ui.protocol", "Protocol") |h %>
                </th>
                <th>
                  <% $c->i18n->p("nirs.manage.column_application", "Application") |h %>
                </th>
                <th>
                  <% $c->i18n->p("nirs.manage.column_language", "Language") |h %>
                </th>
              </tr>
              </thead>
              <tbody>
              </tbody>
            </table>
        </div>
    </div>
</&>
</div>


<div class="well">
<&| /page/info_section.mas, anchor_title => "Trained NIRS Models", title=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.trained_nirs_models", "Trained NIRS Models")), is_subsection=>1, collapsible=>1, collapsed=>1, subtitle=>HTML::Entities::encode_entities($c->i18n->p("nirs.ui.view_and_manage_your_nirs_models", "View and manage your NIRS models")) &>
    <div class="panel panel-default">
        <div class="panel-body">
            <table class="table table-bordered table-hover" id="models_by_user_table">
              <thead>
              <tr>
                <th>
                  <% $c->i18n->p("nirs.manage.column_model_name", "Model Name") |h %>
                </th>
                <th>
                  <% $c->i18n->p("nirs.manage.column_description", "Description") |h %>
                </th>
                <th>
                  <% $c->i18n->p("nirs.manage.column_model_type", "Model Type") |h %>
                </th>
                <th>
                  <% $c->i18n->p("nirs.manage.column_protocol", "Protocol") |h %>
                </th>
                <th>
                  <% $c->i18n->p("nirs.manage.column_application", "Application") |h %>
                </th>
                <th>
                  <% $c->i18n->p("nirs.manage.column_language", "Language") |h %>
                </th>
              </tr>
              </thead>
              <tbody>
              </tbody>
            </table>
        </div>
    </div>
</&>
</div>

<script>
jQuery(document).ready(function(){
    jQuery('#analyses_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/by_user?analysis_model_type=waves_nirs_spectral_predictions' }
    });

    jQuery('#models_by_user_table').DataTable({
        'ajax': { 'url': '/ajax/analyses/models/by_user?analysis_model_type=waves_nirs_spectral_predictions' }
    });
});
</script>

<%once>
use HTML::Entities ();
</%once>

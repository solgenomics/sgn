<%args>
</%args>

<%init>
my $is_curator = ($c->user && $c->user->check_roles('curator')) ? 1 : 0;
</%init>

<& /util/import_javascript.mas, classes => ['jquery'], entries => ['variety_sheet'] &>
<& /tools/variety_sheet/sheet_css.mas &>

<& /page/page_title.mas, title => "Variety Profiles" &>

% if ($is_curator) {
<p><a class="btn btn-primary" href="/tools/variety_sheet"><span class="glyphicon glyphicon-plus"></span> New variety profile</a></p>
% }
<div id="variety_sheet_list"><span class="text-muted">Loading…</span></div>

<script>
  jQuery(function () { window.jsMod['variety_sheet'].initList('#variety_sheet_list'); });
</script>

<%doc>
Styles for variety profiles: the profile itself (.vs-sheet, shared by the editor
preview and the profile page), the editor (.vs-editor) and print layout.
</%doc>
<style>
.vs-sheet { --vs-accent: #1f5f3f; --vs-ink: #1d2327; --vs-muted: #5f6b73; --vs-line: #dfe3e6; --vs-good: #1e7b45; --vs-bad: #b4541a;
  background: #fff; color: var(--vs-ink); font-family: Georgia, "Times New Roman", serif; font-size: 14px; line-height: 1.5;
  max-width: 900px; margin: 0 auto; padding: 32px 40px; box-shadow: 0 1px 6px rgba(0,0,0,.12); border-radius: 2px; }
.vs-sheet h1, .vs-sheet h2, .vs-sheet h3, .vs-tiles, .vs-table, .vs-chart, .vs-sub, .vs-dev, .vs-stamp, .vs-foot, .vs-chars { font-family: "Helvetica Neue", Arial, sans-serif; }
.vs-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; border-bottom: 3px solid var(--vs-accent); padding-bottom: 12px; margin-bottom: 16px; }
.vs-head h1 { margin: 0; font-size: 40px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; color: var(--vs-accent); line-height: 1.05; }
.vs-tagline { font-size: 17px; font-style: italic; margin-top: 4px; }
.vs-sub { color: var(--vs-muted); font-size: 12.5px; margin-top: 6px; }
.vs-dev { text-align: right; font-size: 12px; color: var(--vs-muted); max-width: 40%; }
.vs-dev span { display: block; text-transform: uppercase; letter-spacing: .08em; font-size: 10px; }
.vs-tiles { display: flex; gap: 10px; margin: 0 0 18px; flex-wrap: wrap; }
.vs-tile { flex: 1 1 110px; border: 1px solid var(--vs-line); border-top: 3px solid var(--vs-accent); padding: 8px 10px; border-radius: 3px; }
.vs-tile b { display: block; font-size: 26px; line-height: 1.1; color: var(--vs-accent); }
.vs-tile span { font-size: 11.5px; color: var(--vs-muted); }
.vs-tile.vs-good b { color: var(--vs-good); } .vs-tile.vs-bad b { color: var(--vs-bad); }
.vs-sec { margin: 0 0 14px; break-inside: avoid; }
.vs-sec h2 { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--vs-accent); margin: 0 0 4px; }
.vs-sec p { margin: 0 0 6px; text-align: justify; }
.vs-table { width: 100%; border-collapse: collapse; font-size: 12.5px; margin: 4px 0; }
.vs-table th { text-align: left; border-bottom: 2px solid var(--vs-accent); padding: 4px 6px; font-weight: 600; vertical-align: bottom; }
.vs-table td { border-bottom: 1px solid var(--vs-line); padding: 4px 6px; vertical-align: top; }
.vs-table td b { font-size: 14px; }
.vs-small { font-size: 11px; color: var(--vs-muted); }
.vs-unit { color: var(--vs-muted); font-size: 11px; }
.vs-up { color: var(--vs-good) !important; } .vs-down { color: var(--vs-bad) !important; }
.vs-table sup { font-size: 9px; margin-left: 1px; }
.vs-foot { font-size: 10.5px; color: var(--vs-muted); margin-top: 3px; }
.vs-note { font-size: 11px; color: var(--vs-muted); }
.vs-rating { display: inline-block; padding: 1px 7px; border-radius: 10px; font-size: 11px; font-weight: 600; background: #eef0f1; }
.vs-r-resistant, .vs-r-tolerant { background: #d8efe0; color: #155d33; }
.vs-r-moderately-resistant { background: #e7f4d9; color: #3d6a16; }
.vs-r-intermediate { background: #f6efd2; color: #6d5a0d; }
.vs-r-moderately-susceptible { background: #fbe3cf; color: #8a4512; }
.vs-r-susceptible { background: #f8d6d2; color: #8f2318; }
.vs-sheet .bb-gauge-title { color: var(--vs-ink); } /* gauges: js/source/modules/gauge.js */
.vs-chars { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 24px; margin: 0; font-size: 13px; }
.vs-chars div { display: flex; border-bottom: 1px dotted var(--vs-line); padding: 3px 0; }
.vs-chars dt { font-weight: 600; min-width: 42%; } .vs-chars dd { margin: 0; }
.vs-charts { display: flex; gap: 16px; flex-wrap: wrap; margin-top: 8px; }
.vs-fig { flex: 1 1 300px; margin: 0; }
.vs-fig figcaption { font-size: 10.5px; color: var(--vs-muted); font-family: Arial, sans-serif; }
.vs-chart { width: 100%; height: auto; font-family: Arial, sans-serif; }
.vs-ct { font-size: 11px; font-weight: 700; fill: var(--vs-ink); }
.vs-cl { font-size: 10.5px; fill: var(--vs-ink); } .vs-cv { font-size: 9.5px; fill: var(--vs-muted); }
.vs-bar { fill: #9aa5ad; } .vs-bar-good { fill: var(--vs-good); } .vs-bar-bad { fill: var(--vs-bad); }
.vs-bar-var { fill: var(--vs-accent); } .vs-bar-chk { fill: #b9c1c7; }
.vs-ref { stroke: var(--vs-ink); stroke-width: 1; stroke-dasharray: 3 2; } .vs-grid { stroke: var(--vs-line); stroke-width: 1; }
.vs-photos { display: grid; gap: 6px; }
.vs-photos figure { margin: 0; background: #111; position: relative; overflow: hidden; aspect-ratio: 4 / 3; }
.vs-photos img { width: 100%; height: 100%; object-fit: cover; display: block; }
.vs-photos figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 3px 7px; font: 11px Arial, sans-serif; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.65)); }
.vs-map { height: 260px; border: 1px solid var(--vs-line); border-radius: 3px; background: #eef2f4; }
.vs-map-ph { height: 100%; display: flex; align-items: center; justify-content: center; color: var(--vs-muted); font: 12px Arial, sans-serif; }
.vs-footer { border-top: 2px solid var(--vs-accent); margin-top: 16px; padding-top: 8px; font-size: 12px; }
.vs-footer p { margin: 0 0 4px; }
.vs-foot-cols { display: flex; gap: 24px; } .vs-foot-cols > div { flex: 1; }
.vs-footer h3 { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; margin: 0 0 2px; color: var(--vs-accent); }
.vs-stamp { font-size: 9.5px; color: var(--vs-muted); margin-top: 6px; }
@media (max-width: 700px) {
  .vs-sheet { padding: 18px 16px; } .vs-head { flex-direction: column; align-items: flex-start; } .vs-dev { text-align: left; max-width: none; }
  .vs-head h1 { font-size: 30px; } .vs-chars { grid-template-columns: 1fr; } .vs-photos { grid-template-columns: repeat(2, 1fr) !important; }
  .vs-foot-cols { flex-direction: column; gap: 6px; } .vs-table { display: block; overflow-x: auto; }
}

/* editor: built on the shared app kit (/util/app_layout.mas, static/css/breedbase_app.css) */
.vs-editor .bb-stepper li.off { cursor: not-allowed; }
.vs-panel { min-height: 300px; }
.vs-step-head { margin-bottom: 4px; }
.vs-step-badge { display: inline-block; width: 26px; height: 26px; line-height: 26px; text-align: center; border-radius: 50%; background: var(--bb-accent); color: #fff; font-size: 13px; margin-right: 4px; vertical-align: 1px; }
.vs-panel h3 { font-size: 18px; }
.vs-panel > .bb-help:first-of-type { margin-bottom: 14px; }
.vs-panel .panel { border-color: var(--bb-border); border-radius: 10px; box-shadow: none; overflow: hidden; }
.vs-panel .panel-heading { background: var(--bb-bg); border-color: var(--bb-border); }
.vs-panel .well { background: var(--bb-accent-soft); border: 1px solid #cfe6d7; border-radius: 8px; box-shadow: none; color: #1f3d2b; }
.vs-panel .well .glyphicon { color: var(--bb-accent); }
.vs-panel .table > thead > tr > th { background: var(--bb-bg); font-size: 12px; color: #374151; border-bottom: 1px solid var(--bb-border); }
.vs-panel .label-success { background: var(--bb-accent); }
.vs-nav { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin: 6px 0 32px; }
.vs-nav-right { display: inline-flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.vs-save-state { font-size: 12px; color: var(--bb-muted); }
.vs-side { padding: 12px; }
.vs-side-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-bottom: 8px; }
.vs-side-head h4 { margin: 0; font-size: 14px; } .vs-side-head h4 .glyphicon { color: var(--bb-accent); }
.vs-side-name { font-size: 12px; color: var(--bb-muted); text-transform: uppercase; letter-spacing: .05em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.vs-preview-wrap { max-height: calc(100vh - 150px); overflow: auto; background: #e9ecee; padding: 10px; border-radius: 8px; }
.vs-preview .vs-sheet { zoom: .62; }
.vs-empty { padding: 40px; text-align: center; }
.vs-acc-search { margin-bottom: 14px; max-width: 560px; }
.vs-acc-card { border: 1px solid var(--bb-border); border-radius: 10px; padding: 14px 16px; margin: 12px 0 4px; background: #fff; }
.vs-acc-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
.vs-acc-head h4 { margin: 0; font-size: 17px; } .vs-acc-head h4 .glyphicon { color: var(--bb-accent); }
.vs-acc-card .bb-stats { grid-template-columns: repeat(4, 1fr); }
.vs-kv th { width: 130px; color: var(--bb-muted); font-weight: 600; }
.vs-pick-filters { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.6fr; gap: 8px; margin-bottom: 6px; }
@media (max-width: 900px) { .vs-pick-filters { grid-template-columns: 1fr 1fr; } }
.vs-pick-checks { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 12.5px; margin-bottom: 8px; }
.vs-pick-checks label { font-weight: normal; margin: 0; } .vs-pick-checks input { margin: 0 4px 0 0; vertical-align: -1px; }
.vs-pick-chip { display: flex; align-items: center; gap: 6px; height: 30px; padding: 0 10px; border: 1px solid var(--bb-accent); background: var(--bb-accent-soft); border-radius: 15px; font-size: 12.5px; color: var(--bb-accent-dark); overflow: hidden; white-space: nowrap; }
.vs-pick-chip .glyphicon { color: var(--bb-accent); } .vs-pick-chip a { color: var(--bb-accent); text-decoration: none; }
.vs-pick-meet-x { margin-left: auto; font-size: 16px; line-height: 1; }
.vs-pick-meeting { color: inherit; text-decoration: underline dotted; } .vs-pick-meeting:hover { color: var(--bb-accent); }
.vs-pick-row { cursor: pointer; } .vs-pick-row:focus { outline: 2px solid var(--bb-accent-hover); outline-offset: -2px; }
.vs-pick-foot { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 8px; font-size: 12.5px; }
.vs-pager { display: inline-flex; gap: 3px; align-items: center; }
.vs-pg { min-width: 28px; height: 26px; padding: 0 7px; border: 1px solid var(--bb-border); border-radius: 6px; background: #fff; font-size: 12px; color: #374151; }
.vs-pg:hover:not([disabled]) { border-color: var(--bb-accent); color: var(--bb-accent); }
.vs-pg.on { background: var(--bb-accent); border-color: var(--bb-accent); color: #fff; font-weight: 700; } .vs-pg[disabled] { opacity: .4; }
.vs-pick-list { border: 1px solid var(--bb-border); border-radius: 10px; overflow: hidden; }
.vs-pick-row { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-bottom: 1px solid var(--bb-border); color: var(--bb-ink); text-decoration: none !important; box-shadow: inset 3px 0 0 transparent; }
.vs-pick-row:last-child { border-bottom: 0; }
.vs-pick-row.bb-row-advance { box-shadow: inset 3px 0 0 var(--bb-advance); } .vs-pick-row.bb-row-jump { box-shadow: inset 3px 0 0 var(--bb-jump); }
.vs-pick-row:hover { filter: brightness(.97); color: var(--bb-ink); }
.vs-pick-row.on { outline: 2px solid var(--bb-accent); outline-offset: -2px; }
.vs-pick-main { flex: 1; min-width: 0; } .vs-pick-main b { display: block; overflow: hidden; text-overflow: ellipsis; }
.vs-pick-main small { color: var(--bb-muted); }
.vs-stage-flow { white-space: nowrap; font-size: 12px; color: var(--bb-muted); }
.vs-chip { display: inline-block; border-radius: 10px; padding: 0 8px; font-size: 11px; font-weight: 600; white-space: nowrap; }
.vs-chip-none { background: #f3f4f6; color: var(--bb-muted); } .vs-chip-draft { background: #fef3c7; color: #92400e; } .vs-chip-pub { background: var(--bb-accent-soft); color: var(--bb-accent); }
.vs-pick-go { width: 74px; text-align: right; font-size: 12px; font-weight: 600; color: var(--bb-accent); white-space: nowrap; }
@media (max-width: 700px) { .vs-stage-flow, .vs-pick-row .vs-chip { display: none; } .vs-acc-card .bb-stats { grid-template-columns: repeat(2, 1fr); } }
.vs-name-check { margin-top: 5px; min-height: 20px; }
.vs-choice.disabled { opacity: .55; cursor: not-allowed; }
.vs-check-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 6px; margin-bottom: 8px; }
/* checkbox | name + tags (wraps) | star: the star keeps its own column, never pushed out of the box */
.vs-check { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; gap: 4px 8px; border: 2px solid var(--bb-border); border-radius: 8px; padding: 6px 8px; font-weight: normal; margin: 0; cursor: pointer; min-width: 0; }
.vs-check input { margin: 3px 0 0; }
.vs-check:hover { border-color: var(--bb-accent-hover); }
.vs-check.on { border-color: var(--bb-accent); background: var(--bb-accent-soft); }
.vs-check.main { box-shadow: 0 0 0 2px #e0a800 inset; }
.vs-check-body { min-width: 0; }
.vs-check-name { display: block; font-weight: 600; overflow-wrap: anywhere; line-height: 1.3; }
.vs-check-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 3px 6px; margin-top: 3px; }
.vs-tag { display: inline-block; border-radius: 8px; padding: 0 6px; font-size: 10.5px; font-weight: 600; white-space: nowrap; }
.vs-tag-ctl { background: #e0f2fe; color: #075985; } .vs-tag-rel { background: var(--bb-accent-soft); color: var(--bb-accent); border: 1px solid #b9dcc6; }
.vs-check-n { color: var(--bb-muted); font-size: 11px; white-space: nowrap; }
.vs-check .vs-star, .vs-check .vs-star:focus { line-height: 1; padding: 0 2px; color: #9ca3af; } .vs-check .vs-star:hover, .vs-check .vs-star.on { color: #e0a800; }
.vs-check-legend { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 11.5px; color: #4b5563; background: var(--bb-bg); border: 1px solid var(--bb-border); border-radius: 8px; padding: 6px 10px; margin: 0 0 8px; }
.vs-check-legend input { margin: 0 2px 0 0; vertical-align: -2px; } .vs-check-legend .vs-star { font-size: 14px; }
.vs-star { font-size: 18px; color: #bbb; text-decoration: none !important; } .vs-star.on { color: #e0a800; }
.vs-add-check { max-width: 380px; }
.vs-trait-table-wrap { max-height: 380px; overflow: auto; border: 1px solid var(--bb-border); border-radius: 8px; }
.vs-trait-table-wrap .table { margin: 0; }
.vs-trait-table tr:not(.on) td { color: #888; } .vs-trait-table thead th, .vs-trait-table-wrap thead th { position: sticky; top: 0; background: var(--bb-bg); z-index: 1; }
.vs-t-name { font-family: monospace; font-size: 12px; word-break: break-all; max-width: 180px; } .vs-t-unit { width: 80px; }
.vs-t-move a { text-decoration: none; color: #888; }
.vs-view-pick { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-bottom: 10px; font-size: 13px; }
.vs-view-pick > span { font-weight: 600; margin-right: 4px; }
.vs-view-pick label { margin: 0; font-weight: normal; border: 1px solid var(--bb-border); border-radius: 16px; padding: 3px 11px; cursor: pointer; background: #fff; }
.vs-view-pick label.on { border-color: var(--bb-accent); background: var(--bb-accent-soft); color: var(--bb-accent); font-weight: 600; }
.vs-view-pick input { margin: 0 4px 0 0; vertical-align: -1px; }
.vs-layout > div { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; } .vs-layout select { width: auto; } .vs-layout span { font-size: 13px; }
.vs-pg-pick { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
@media (max-width: 700px) { .vs-pg-pick { grid-template-columns: 1fr; } }
.vs-pg-slot { display: flex; align-items: center; gap: 6px; }
.vs-pg-n { flex: none; width: 22px; height: 22px; line-height: 22px; border-radius: 50%; background: var(--bb-accent); color: #fff; text-align: center; font-size: 12px; font-weight: 700; }
.vs-pg-range { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 8px; font-size: 13px; }
.vs-pg-range input { width: 80px; } .vs-pg-range .bb-help { flex-basis: 100%; font-size: 12px; }
.vs-compute-bar { margin: 14px 0; }
.vs-results { background: var(--bb-bg); border: 1px solid var(--bb-border); border-radius: 8px; padding: 10px; font-family: Arial, sans-serif; }
.vs-rating-table td { vertical-align: middle !important; } .vs-pad { padding: 8px 0; }
.vs-char-row { margin-bottom: 5px; } .vs-char-row a { font-size: 18px; text-decoration: none; }
.vs-thumbs { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 6px; }
.vs-thumb { position: relative; display: block; aspect-ratio: 1; overflow: hidden; border-radius: 8px; border: 3px solid transparent; background: #222; }
.vs-thumb img { width: 100%; height: 100%; object-fit: cover; }
.vs-thumb span { position: absolute; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.55); color: #fff; font-size: 10px; padding: 1px 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.vs-thumb.on { border-color: var(--bb-accent); } .vs-thumb.on:after { content: "\2713"; position: absolute; top: 3px; right: 6px; color: #fff; background: var(--bb-accent); border-radius: 50%; width: 20px; height: 20px; text-align: center; line-height: 20px; }
.vs-sel-photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
.vs-sel img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; display: block; margin-bottom: 3px; }
.vs-sel-btns { display: flex; gap: 10px; justify-content: center; } .vs-sel-btns a { text-decoration: none; }
.vs-img-f.b { font-weight: 700; text-decoration: underline; }
.vs-accents { display: flex; gap: 6px; align-items: center; } .vs-accent { width: 24px; height: 24px; border-radius: 50%; display: inline-block; border: 2px solid #fff; box-shadow: 0 0 0 1px #ccc; }
.vs-accent.on { box-shadow: 0 0 0 2px #333; } .vs-accents input[type=color] { width: 32px; height: 26px; padding: 0; border: none; background: none; }
.vs-publish-bar { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin: 6px 0 18px; padding: 10px 12px; background: var(--bb-bg); border: 1px solid var(--bb-border); border-radius: 8px; }
.vs-full-preview { background: #e9ecee; padding: 20px 10px; border-radius: 8px; }
.vs-spin { animation: vs-spin 1s linear infinite; } @keyframes vs-spin { to { transform: rotate(360deg); } }
.vs-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
.vs-card { display: block; background: #fff; border: 1px solid var(--bb-border, #dfe3e8); border-top: 4px solid var(--bb-accent, #2b7a4b); border-radius: 10px; padding: 12px 14px; color: inherit; text-decoration: none !important; box-shadow: 0 1px 2px rgba(0,0,0,.03); }
.vs-card:hover { box-shadow: 0 4px 12px rgba(0,0,0,.08); border-color: var(--bb-accent-hover, #9cc9ac); } .vs-card b { display: block; font-size: 18px; text-transform: uppercase; color: var(--bb-accent, #2b7a4b); }
.vs-card span { display: block; color: #555; } .vs-card small { color: #999; }
.vs-card.vs-card-draft { border-top-color: #d97706; }
/* build the profile from the data + edit each part (step 6) */
.vs-build-cta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 10px 0 8px; padding: 12px 14px; background: var(--bb-accent-soft); border: 1px solid #cfe6d7; border-radius: 10px; }
.vs-build-cta .bb-help { flex: 1 1 260px; margin: 0; }
.vs-build { border: 1px solid var(--bb-border); border-radius: 10px; padding: 14px 16px; margin: 12px 0; background: #fff; }
.vs-build h4 { margin: 0 0 8px; } .vs-build h4 .glyphicon { color: var(--bb-accent); }
.vs-build ol { list-style: none; padding: 0; margin: 0; } .vs-build li { padding: 3px 0; color: var(--bb-muted); }
.vs-build li.on { color: var(--bb-ink); font-weight: 600; } .vs-build li.done { color: var(--bb-accent); } .vs-build li .glyphicon { width: 18px; }
.vs-built { border: 1px solid #cfe6d7; background: var(--bb-accent-soft); border-radius: 10px; padding: 10px 14px; margin: 0 0 14px; font-size: 13px; }
.vs-built-head { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; } .vs-built-head .glyphicon-flash { color: var(--bb-accent); }
.vs-built-body { margin-top: 8px; } .vs-built-body ul { margin: 0 0 8px; padding-left: 20px; } .vs-built-body p { margin: 4px 0; }
.vs-editable .vs-ed-sec { position: relative; border-radius: 4px; outline: 1px dashed transparent; outline-offset: 4px; }
.vs-editable .vs-ed-sec:hover { outline-color: #9cc9ac; }
.vs-ed-btn { border: 1px solid #b9d8c4; background: #fff; color: #2b7a4b; border-radius: 12px; font: 600 11px Arial, sans-serif; padding: 1px 8px; margin-left: 8px; vertical-align: 3px; letter-spacing: 0; text-transform: none; cursor: pointer; }
.vs-ed-btn:hover { background: #2b7a4b; color: #fff; }
.vs-head h1 .vs-ed-btn { vertical-align: 10px; }
.vs-ed-empty { color: #b45309; font-style: italic; font-size: 12.5px; }
.vs-ed-box { margin: 6px 0 4px; font-family: Arial, sans-serif; } .vs-ed-box textarea { font-size: 13px; }
.vs-ed-bar { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-top: 6px; } .vs-ed-bar .bb-muted { font-size: 11px; margin-left: auto; }
.vs-ed-hidden { display: none !important; }
@media print { .vs-ed-btn, .vs-ed-blank, .vs-ed-box, .vs-built { display: none !important; } .vs-editable .vs-ed-sec { outline: none; } }
.vs-view-bar { max-width: 900px; margin: 0 auto 12px; display: flex; gap: 8px; justify-content: flex-end; }

/* printing (preparePrint in variety_sheet.js): a copy of the profile in #vs-print-host, compact
   layout .vs-print-layout, scaled with zoom to fit one A4 / Letter page; the page itself is not printed */
#vs-print-host { position: absolute; left: -20000px; top: 0; background: #fff; }
.vs-print-layout { box-shadow: none !important; max-width: none !important; margin: 0 !important; padding: 0 !important; border-radius: 0;
  font-size: 10.5px; line-height: 1.35; column-count: 2; column-gap: 16px; column-fill: balance; }
.vs-print-layout * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
.vs-print-layout .vs-head, .vs-print-layout .vs-tiles, .vs-print-layout .vs-sec[data-sec="performance"], .vs-print-layout .vs-sec[data-sec="disease"],
.vs-print-layout .vs-photos-sec, .vs-print-layout .vs-footer { column-span: all; }
.vs-print-layout .vs-head { padding-bottom: 6px; margin-bottom: 8px; } .vs-print-layout .vs-head h1 { font-size: 28px; }
.vs-print-layout .vs-tagline { font-size: 12.5px; margin-top: 2px; } .vs-print-layout .vs-sub { margin-top: 3px; font-size: 10px; }
.vs-print-layout .vs-tiles { gap: 6px; margin-bottom: 8px; } .vs-print-layout .vs-tile { padding: 4px 8px; } .vs-print-layout .vs-tile b { font-size: 18px; } .vs-print-layout .vs-tile span { font-size: 9.5px; }
.vs-print-layout .vs-sec { margin: 0 0 8px; break-inside: avoid; } .vs-print-layout .vs-sec h2 { font-size: 10.5px; margin: 0 0 2px; }
.vs-print-layout .vs-sec p { margin: 0 0 3px; }
.vs-print-layout .vs-chars { grid-template-columns: 1fr; font-size: 9.5px; } .vs-print-layout .vs-chars div { padding: 1px 0; }
.vs-print-layout .vs-table { font-size: 9px; } .vs-print-layout .vs-table th, .vs-print-layout .vs-table td { padding: 2px 4px; } .vs-print-layout .vs-table td b { font-size: 10.5px; }
.vs-print-layout .vs-foot, .vs-print-layout .vs-note { font-size: 8px; }
.vs-print-layout .bb-gauges { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 2px 10px; margin: 2px 0; }
.vs-print-layout .bb-gauge-svg { max-width: 145px; } .vs-print-layout .bb-gauge-title { font-size: 9.5px; }
.vs-print-layout .bb-gauge-read, .vs-print-layout .bb-gauge-legend, .vs-print-layout .bb-gauge-note { font-size: 8px; }
.vs-print-layout .vs-charts { flex-wrap: nowrap; gap: 12px; margin-top: 4px; } .vs-print-layout .vs-fig { flex: 1 1 0; min-width: 0; }
.vs-print-layout .vs-chart { max-height: 160px; }
.vs-print-layout .vs-photos { grid-template-columns: repeat(4, 1fr) !important; gap: 4px; }
.vs-print-layout .vs-footer { margin-top: 6px; padding-top: 4px; font-size: 9px; } .vs-print-layout .vs-stamp { font-size: 8px; }
@media print {
  body > *:not(#vs-print-host) { display: none !important; }
  #vs-print-host { position: static; left: auto; }
  html, body { background: #fff !important; margin: 0 !important; padding: 0 !important; }
}
</style>
<style>
.vs-photos figure.vs-missing { display: none; }
.vs-thumb.vs-img-missing, .vs-sel.vs-img-missing img { background: #f3e3e0; }
.vs-thumb.vs-img-missing:before, .vs-sel.vs-img-missing:before { content: "image file missing on the server"; position: absolute; top: 30%; left: 0; right: 0; text-align: center; font-size: 11px; color: #8f2318; padding: 0 4px; }
.vs-sel { position: relative; }
</style>

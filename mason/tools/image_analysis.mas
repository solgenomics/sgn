
<%args>
%services
</%args>

<script src="/js/source/legacy/CXGN/BreedersToolbox/UploadImages.js"></script>

% use JSON::Any;

<& /util/import_javascript.mas,
  classes => ['jquery.dataTables-buttons-min',
      'jquery.iframe-post-form',
      'jszip-min', 'pdfmake.pdfmake-min',
      'pdfmake.vfs_fonts',
      'buttons.bootstrap-min',
      'buttons.html5-min',
      'jquery',
      'jquery.cookie',
      'thickbox',
      'CXGN.BreedersToolbox.HTMLSelect',
      'd3.d3v4Min'
  ]
&>

<style>
td.details-control {
    text-align:center;
    color:forestgreen;
    cursor: pointer;
}
tr.shown td.details-control {
    text-align:center;
    color:red;
}

.bar {
  fill: steelblue;
  shape-rendering: crispEdges;
}
</style>

<link rel="stylesheet" type="text/css" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" />

<& /page/page_title.mas, title=>"Image Analysis" &>
<hr>

<div class="well well-sm">
    <center>
    <button class="btn btn-primary" id="upload_images_link">Upload New Images</button>
    </center>
</div>
<& /breeders_toolbox/upload_images.mas &>
<& /breeders_toolbox/trial/create_spreadsheet_dialog.mas &>

<&| /page/info_section.mas, title=>"Image Search Criteria",  collapsible => 1, collapsed=>0, subtitle => "All images may not have names, descriptions, or tags associated with them."&>

    <div id="image_search_form" class="well well-sm">
        <div class="form-horizontal" >
            <div class="form-group">
                <label class="col-sm-3 control-label">Select a Field Trial: </label>
                <div class="col-sm-9" >
                    <div id ="image_analysis_trial_select">
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Image descriptors (name, description, or filename): </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_description_filename_composite" name="image_description_filename_composite" placeholder="e.g. MyImageName" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Submitter: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_submitter" name="image_submitter" placeholder="e.g. JaneDoe" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Image tag: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_tag" name="image_tag" placeholder="e.g. ImageTagName" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Associated stock: </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_stock_uniquename" name="image_stock_uniquename" placeholder="e.g. FieldPlot100" />
                </div>
            </div>
        </div>

        <center>
        <button class="btn btn-primary" id="image_search_submit" >Search</button>
        </center>
    </div>
</&>

<&| /page/info_section.mas, title=>"Image Search Results",  collapsible => 1, collapsed=>0 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table id="image_analysis_image_search_results" class="table table-hover table-striped">
                <thead>
                  <tr>
                    <th>Select</th>
                    <th>Image Thumbnail</th>
                    <th>Filename</th>
                    <th>Description</th>
                    <th>Submitter</th>
                    <th>Associations</th>
                    <th>Observations</th>
                    <th>Tags</th>
                </tr>
                </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, title=>"Image Analysis", collapsible => 1, collapsed=>0 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <div class="form-group">
                    <label class="col-sm-6 control-label">Image Analysis Service: </label>
                    <div class="col-sm-6" >
                        <select class="form-control" id="image_analysis_service_select" name="image_analysis_service_select">
                            <option value="">Select An Analysis Service:</option>

% foreach my $s (keys %services) {
 		            <option value="<% $s %>"><% $services{$s}->{description} %></option>
% }

                            <!-- option value="necrosis">Necrosis(Makerere AIR Lab)</option>
                            <option value="largest_contour_percent">Necrosis Largest Contour Mask Percent</option>
                            <option value="count_contours">Count Contours</option>
                            <option value="count_sift">SIFT Feature Count</option>
                            <option value="whitefly_count">Whitefly Count (Makerere AIR Lab)</option  -->
                        </select>
                    </div>
                </div>
                <br/>
                <div class="form-group" id="image_analysis_trait_group" style="display: none;">
                    <label class="col-sm-6 control-label">Trait to be Analyzed: </label>
                    <div class="col-sm-6" >
                        <select class="form-control" id="image_analysis_trait_select" name="image_analysis_service_select"></select>
                    </div>
                </div>
                <br/><br/><br/>

                <hr>
                <center>
                <button class="btn btn-primary" id="image_analysis_submit" disabled>Submit for Analysis</button>
                </center>
                <hr>

                <div id="analysis_image_result">
                    <a id="analysis_image_link" href="#" target="_blank">
                        <img id="analysis_image" src="" style="max-width:500px; width:100%; height:auto; display:block; margin:0 auto;"/>
                    </a>
                </div>
                <br/>

                <div id="image_analysis_result" style="display: none;">
                    <table class="display" style="width:100%" id="image_analysis_result_table">
                        <thead>
                           <tr>
                               <th></th>
                               <th>Stock</th>
                               <th>Trait</th>
                               <th id="analyzed_header"></th>
                               <th>Mean Value</th>
                           </tr>
                       </thead>
                       <caption class="well well-sm" style="caption-side: bottom;margin-top: 10px;">
                        <center> Analysis Service Details: <a id="model_metrics_link"  style="cursor: pointer;">Model Metrics</a> </center>
                       </caption>
                    </table>
                    <hr>
                    <center><button class="btn btn-primary" id="image_analysis_save_results">Save Results</button></center>
                </div>
            </div>
        </div>
    </div>

    <br/><br/>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <div class="form-group">
                    <div class="col-sm-9">
                    <label class="col-sm-6 control-label">Image Analysis Usage </label>
                    </div>
                    <div class="col-sm-3" >
                        <label class="control-label">Date Range: </label>
                        <select class="form-control" id="usage_range_select" name="usage_range_select">
                            <option value="all">All Dates</option>
                            <option value="year">Latest Year</option>
                            <option value="month">Latest Month</option>
                            <option value="week">Latest Week</option>
                        </select>
                    </div>
                </div>
                <br/>
                <div class="form-group" id="image_analysis_usage">
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modelMetricsDialog" tabindex="-1" role="dialog" aria-labelledby="modelMetricsDialog" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="modelMetricsDialogTitle">Model Metrics</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body" id="modelMetricsDialogBody">
              <table class="display" style="width:100%" id="metrics_table">
              </table>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="runNameModal" tabindex="-1" role="dialog" aria-labelledby="runNameModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="runNameModalTitle">Name Image Analysis Run</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p class="text-muted" style="font-size:12px;">
                        All analyzed images below will be saved together as a single analysis run.
                    </p>

                    <div class="form-group">
                        <label for="run_name_input" style="font-size:12px;">Run name</label>
                        <input type="text" class="form-control" id="run_name_input" placeholder="e.g. Plot 101 leaf area analysis" />
                    </div>

                    <label style="font-size:12px;">Images included (<span id="run_image_count">0</span>)</label>
                    <div id="run_image_list" style="max-height:260px;overflow-y:auto;border:1px solid #eee;"></div>

                    <div id="run_name_error" class="text-danger" style="display:none;margin-top:6px;"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="run_name_confirm">Save Results</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="saveResultModal" tabindex="-1" role="dialog" aria-labelledby="saveResultModal" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="saveResultModalTitle">Image Analysis Save Status</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>
          <div class="modal-body" id="saveResultModalBody">
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>

    <div id="plantCreationWarning" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">

        <div class="modal-header">
            <button type="button" class="close" data-dismiss="modal">&times;</button>
        </div>

        <div class="modal-body">
            <p>The image you submitted for analysis is associated with a plot. If you save these results a new plant will be created for this plot.</p>
        </div>

        <div class="modal-footer">
            <button class="btn btn-default" data-dismiss="modal">Cancel</button>
            <button class="btn btn-primary" id="save_results_continue">Continue</button>
        </div>

        </div>
    </div>
    </div>
</&>

<&| /page/info_section.mas, title=>"Image Analysis Run Search Criteria", collapsible => 1, collapsed=>0, subtitle => "Search saved image analysis runs." &>

    <div id="run_search_form" class="well well-sm">
        <div class="form-horizontal">
            <div class="form-group">
                <label class="col-sm-6 control-label">Run name: </label>
                <div class="col-sm-6">
                    <input class="form-control" type="text" id="run_search_run_name"
                           name="run_search_run_name" placeholder="e.g. Seed size March 2025" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Source image filename: </label>
                <div class="col-sm-6">
                    <input class="form-control" type="text" id="run_search_image_filename"
                           name="run_search_image_filename" placeholder="e.g. 42200_branching" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Source stock name: </label>
                <div class="col-sm-6">
                    <input class="form-control" type="text" id="run_search_stock_name"
                           name="run_search_stock_name" placeholder="e.g. FieldPlot100" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label">Pipeline name: </label>
                <div class="col-sm-6">
                    <input class="form-control" type="text" id="run_search_pipeline_name"
                           name="run_search_pipeline_name" placeholder="e.g. seed_size_shape" />
                </div>
            </div>
        </div>

        <center>
            <button class="btn btn-primary" id="run_search_submit">Search</button>
        </center>
    </div>
</&>

<&| /page/info_section.mas, title=>"Image Analysis Run Search Results", collapsible => 1, collapsed=>0 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table id="image_analysis_run_search_results" class="table table-hover table-striped" style="width:100%">
                    <thead>
                        <tr>
                            <th>Run Name</th>
                            <th>Source Image Filename</th>
                            <th>Source Stock</th>
                            <th>Pipeline Name</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<script>

var service_traits = {
    'necrosis': {
        "CBSDpct|CO_334:0002078" : "Cassava",
    },
    'largest_contour_percent': {},
    'count_contours': {},
    'count_sift': {},
    'whitefly_count': {},
}

jQuery(document).ready(function(){

    jQuery('#model_metrics_link').click( function() {
        jQuery('#modelMetricsDialog').modal("show");
    });

    get_select_box('trials', 'image_analysis_trial_select', { 'name' : 'html_image_analysis_trial_select', 'id' : 'html_image_analysis_trial_select', 'multiple':0, 'size':10, 'trial_name_values':1 });

    _load_image_search_results();

    var date_range = jQuery('#usage_range_select').val();
    _load_analysis_activity_graph(date_range);

    jQuery('#image_search_submit').click(function(){
        if (jQuery('#html_image_analysis_trial_select').val() == '') {
            alert("Please select a Field Trial first!");
            return false;
        }
        _load_image_search_results();
    });

    _load_run_search_results();

    jQuery('#run_search_submit').click(function () {
        jQuery('#image_analysis_run_search_results').DataTable().ajax.reload();
    });

    jQuery('#run_search_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            jQuery('#run_search_submit').click();
        }
    });

    jQuery("#image_submitter").autocomplete({
        source: '/ajax/people/autocomplete'
    });

    jQuery('#image_search_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            jQuery('#image_search_submit').click();
        }
    });

    jQuery('#image_analysis_image_search_results').on( 'draw.dt', function () {
        jQuery('a.image_search_group').colorbox();
    });$

    jQuery('#image_analysis_service_select').change(function() {
        var service = jQuery('#image_analysis_service_select').val();
	    var service_defs = JSON.parse('<% JSON::encode_json(\%services) %>');
        jQuery('#image_analysis_trait_select').html('<option value="">Select A Trait</option>');
        jQuery('#image_analysis_trait_select').html('<option value=""></option>');
        console.log("service:", service);
        if (service && service !== "multi-trait") {
            jQuery('#working_modal').modal('show');
            // add crop and service specific trait options
            var all_traits = service_defs[service].service_traits;
            var trait_names = Object.keys(all_traits);
            // console.log("trait names", trait_names);
            var options =  [];

            jQuery.ajax({
                url: '/brapi/v2/commoncropnames/',
                method: 'GET',
                success: function(response) {
                    // console.log("Retrieved crop names and they are: "+response.result.data);
//                    var supportedcrops = response.result.data;
//                    supportedcrops.forEach(function(crop) {
//		        alert("CROP = "+crop);
                        trait_names.forEach(function(name) {
//                            if (all_traits[name] == crop) {
                                // console.log("Id is "+id);
                                options.push('<option value="'+ name +'">'+ name +'</option>');
//                              console.log("options: ", options);
//                            }
//                        });
			});
                    jQuery('#image_analysis_trait_select').append(options);
                    jQuery('#image_analysis_trait_group').show();
                    jQuery('#working_modal').modal('hide');
                },
                error: function(response) {
                    console.log("error retrieving crop names: "+response);
                    // just add all traits regardless of crop
                    trait_names.forEach(function(name) {
                        // console.log("Id is "+id);
                        options.push('<option value="'+ name +'">'+ name +'</option>');

                    });
                    jQuery('#image_analysis_trait_select').append(options);
                    jQuery('#image_analysis_trait_group').show();
                    jQuery('#working_modal').modal('hide');
                    jQuery('#analyzed_header'),text('# Analyzed Images');
                }
            });
        }
        else if (service === "multi-trait") {
            jQuery('#image_analysis_trait_group').hide();
            jQuery('#image_analysis_submit').prop('disabled', false);
            jQuery('#analyzed_header').text('# Analyzed Objects');
        }
        else {
            // hide trait select
            jQuery('#image_analysis_trait_group').hide();
        }
    });

    jQuery('#image_analysis_trait_select').change(function() {
        if (jQuery('#image_analysis_trait_select').val()) {
            jQuery('#image_analysis_submit').prop('disabled', false);
        }
        else {
            jQuery('#image_analysis_submit').prop('disabled', true);
        }
    });

    const selected_image_ids = [];
    let submit_results;
    let is_multi_trait;
    let analysis_metadata;
    let output_image_overlays;

    jQuery('#image_analysis_submit').click(function(){
        jQuery('input[name="image_analysis_select"]').each(function() {
            if (this.checked){
                selected_image_ids.push(this.value);
            }
        });

        if (selected_image_ids.length < 1) {
            alert('Please select at least one image first!');
            return false;
        }

        var results = [];
        var progress_modal = jQuery('#progress_modal');
        var progress_bar = jQuery('#progress_bar');
        var image_total = selected_image_ids.length;
        var images_finished = 0;
        var current_progress = 0;
        progress_modal.modal('show');
        jQuery('#progress_msg').text('Submitting images for analysis');

        var deferred_calls = selected_image_ids.map(function(image_id, index) {
            jQuery('#progress_msg').text('Submitting image '+index+' out of '+image_total+' images');
            current_progress += (1 / image_total) * 10;
            progress_bar.css("width", current_progress + "%")
            .attr("aria-valuenow", current_progress)
            .text(Math.round(current_progress) + "%");

            var call = jQuery.ajax({
                url: '/ajax/image_analysis/submit',
                method: 'POST',
                data: {
                    'selected_image_ids': image_id,
                    'service': jQuery('#image_analysis_service_select').val(),
                    'trait': jQuery('#image_analysis_trait_select').val(),
                },
                dataType:'json',
                success: function(response) {
                    images_finished++;
                    console.log("submit response", response);
                    jQuery('#progress_msg').text('Responses received for '+images_finished+' out of '+image_total+' images');
                    current_progress += (1 / image_total) * 90;
                    progress_bar.css("width", current_progress + "%")
                    .attr("aria-valuenow", current_progress)
                    .text(Math.round(current_progress) + "%");
                    response.results.map(function(item) {
                        if (item.result.error) {
                            progress_modal.find('.modal-footer').append(
                                '<ul class="list-group"><li class="list-group-item list-group-item-danger"><span class="badge"><span class="glyphicon glyphicon-remove"></span></span>Error analyzing image number '+index+': '+item.result.error+'</li></ul>'
                            );
                        }
                        else {
                        }
                        results.push(item);
                    });
                },
                error: function(response) {
                    images_finished++;
                    // console.log(response);
                    jQuery('#progress_msg').text('Finished analyzing '+images_finished+' out of '+image_total+' images');
                    current_progress += (1 / image_total) * 90
                    progress_modal.find('.modal-footer').append(
                        '<ul class="list-group"><li class="list-group-item list-group-item-danger"><span class="badge"><span class="glyphicon glyphicon-remove"></span></span>Error analyzing image number '+index+': '+response+'</li></ul>'
                    );
                }
            });
            return call;
        });

        jQuery('#progress_msg').text('All '+image_total+' images submitted, waiting for responses.');

        jQuery.when.apply(jQuery, deferred_calls).then(function() {
            console.log("Results are:");
            console.log(results);
            var first = results[0];
            submit_results = first;
            // console.log("stock type:", first.stock_type_name);

            //if (first.stock_type_name === "plot") {
            //    jQuery('#my_dialog_modal').modal('show');
                //alert("The image you submitted for analysis is associated with a plot. If you save these results a new plant will be created for this plot.")
            //}


            let metricsData = Object.entries(first.result.analysis_info)
                .filter(([key, value]) => key != null && value != null)
                .map(([key, value]) => ({
                    metric: key,
                    value: typeof value === 'object' ? JSON.stringify(value) : String(value)
                }));

            if (metricsData.length > 0) {
                jQuery('#metrics_table').DataTable({
                    "data": metricsData,
                    "columns": [
                        { "data": "metric" },
                        { "data": "value" },
                    ]
                });
            }

            if (results.length > 0) {
                jQuery.ajax({
                    url: '/ajax/image_analysis/group',
                    method: 'POST',
                    data: { 'result': JSON.stringify(results) },
                    success: function(response) {
                        console.log("Grouped Results are:");
                        console.log(response);
                        current_progress = 100;
                        progress_bar.css("width", current_progress + "%")
                        .attr("aria-valuenow", current_progress)
                        .text(Math.round(current_progress) + "%");
                        jQuery('#progress_msg').text('Building results table.');

                        is_multi_trait = response.results.multi_trait_analysis;
                        analysis_metadata = response.results.analysis_metadata;
                        output_image_overlays = response.results.output_image_overlays;
                        let overlayUrls = Object.values(output_image_overlays);

                        if (overlayUrls.length === 1) {
                            jQuery('#analysis_image').attr('src', overlayUrls[0]);
                            jQuery('#analysis_image_link').attr('href', overlayUrls[0]);
                            jQuery('#analysis_image_result').show();
                        }

                        jQuery('#image_analysis_result').show();

                        var table = jQuery('#image_analysis_result_table').DataTable( {
                            "destroy" : true,
                            "data": response.results.table_data,
                            "dom": 'Bfrtip',
                            "buttons":  [
                                'copy', 'excel', 'csv', 'pdf'
                            ],
                            "columns": [
                                {
                                    "className":      'details-control',
                                    "orderable":      false,
                                    "data":           null,
                                    "defaultContent": '',
                                    "render": function () {
                                         return '<i class="fa fa-plus-square" aria-hidden="true"></i>';
                                     },
                                     width:"15px"
                                },
                                { "data": "observationUnitName" },
                                { "data": "observationVariableName" },
                                { "data": "numberAnalyzed" },
                                { "data": "value" }
                            ],
                            "order": [[1, 'asc']]
                        } );

                        // Add event listener for opening and closing details
                        jQuery('#image_analysis_result_table tbody').on('click', 'td.details-control', function () {
                            var tr = jQuery(this).closest('tr');
                            var tdi = tr.find("i.fa");
                            var row = table.row( tr );

                            if ( row.child.isShown() ) {
                                // This row is already open - close it
                                row.child.hide();
                                tr.removeClass('shown');
                                tdi.first().removeClass('fa-minus-square');
                                tdi.first().addClass('fa-plus-square');
                            }
                            else {
                                // Open this row
                                row.child( format(row.data()) ).show();
                                tr.addClass('shown');
                                tdi.first().removeClass('fa-plus-square');
                                tdi.first().addClass('fa-minus-square');
                            }
                        } );

                        setTimeout(function(){
                            progress_modal.find('.modal-footer').html('');
                            progress_modal.modal('hide');
                        }, 1000);

                    },
                    error: function(response) {
                        // jQuery('#working_modal').modal('hide');
                        progress_modal.modal('hide');
                        console.log('Error: '+response);
                        // jQuery('#'+image_id).text('Error analyzing image number '+index+'. '+response);
                        alert("An error occurred while displaying image analysis results.");
                    }
                });
            }
            else {
                progress_modal.find('.modal-footer').html('');
                progress_modal.modal('hide');
                alert("No usable results returned from the service, aborting analysis.");                 // alert("No usable results returned from the service, aborting analysis.");
            }
        });
    });

    jQuery('#image_analysis_save_results').click(function(){
        console.log("submit results", submit_results);
        if (submit_results.stock_type_name === "plot") {
            jQuery('#plantCreationWarning').modal('show');
        } else {
            enterRunName();
        }
    });

    jQuery('#save_results_continue').click(function() {
        jQuery('#plantCreationWarning').modal('hide');
        enterRunName();
    });

    function enterRunName() {
        jQuery('#run_name_error').hide().text('');
        jQuery('#run_name_input').val('');

        let partition = partitionTableDataByImage();
        window.save_partition = partition;

        let $list = jQuery('#run_image_list').empty();
        jQuery('#run_image_count').text(partition.order.length);

        partition.order.forEach(function(image_id) {
            var rows    = partition.groups[image_id];
            var label   = rows[0].source_image_filename || ('Image ' + image_id);
            var overlay = (window.overlays_by_image && window.overlays_by_image[image_id]) || '';

            $list.append(
                '<div class="run-image-item" ' +
                    'data-image-id="' + jQuery('<div>').text(image_id).html() + '" ' +
                    'style="display:flex;align-items:center;border-bottom:1px solid #eee;padding:8px;">' +
                    '<div style="flex:0 0 90px;">' +
                        (overlay ? '<img src="' + overlay + '" style="max-height:60px;max-width:80px;">' : '') +
                    '</div>' +
                    '<div style="flex:1;font-size:12px;">' +
                        jQuery('<div>').text(label).html() +
                        '<span class="text-muted"> &mdash; ' + rows.length +
                        (rows.length === 1 ? ' result' : ' results') + '</span>' +
                    '</div>' +
                '</div>'
            );
        });

        jQuery('#runNameModal').modal('show');
        setTimeout(function () { jQuery('#run_name_input').focus(); }, 300);
    }

    function partitionTableDataByImage(rows) {
        var all_rows = rows || jQuery('#image_analysis_result_table').DataTable().rows().data().toArray();

        var groups  = {};   // source_image_id -> [rows]
        var order   = [];   // preserve first-seen order
        var unknown = [];   // rows with no usable source_image_id

        all_rows.forEach(function(row) {
            var raw = row.source_image_id;
            if (raw == null || raw === '' || !String(raw).match(/^\d+$/)) {
                unknown.push(row);
                return;
            }
            var img = String(raw);
            if (!groups[img]) { groups[img] = []; order.push(img); }
            groups[img].push(row);
        });

        return { groups: groups, order: order, unknown: unknown };
    }
    
    jQuery('#run_name_confirm').click(function () {
        jQuery('#run_name_error').hide().text('');

        var runName = jQuery.trim(jQuery('#run_name_input').val());
        if (!runName) {
            showRunNameError('Please enter a name for this run.');
            return;
        }

        var partition = window.save_partition;
        if (!partition || !partition.order.length) {
            showRunNameError('No analysis results found to save.');
            return;
        }

        var images = partition.order.map(function(image_id) {
            var rows = partition.groups[image_id];
            return {
                source_image_id:  image_id,
                source_stock_id:  rows[0].source_stock_id,
                overlay_image_id: (window.overlay_ids_by_image && window.overlay_ids_by_image[image_id]) || null,
                tissue_samples:   rows.map(function(r) { return { stock_id: r.stock_id }; })
            };
        });

        var $btn = jQuery('#run_name_confirm').prop('disabled', true).text('Checking...');

        jQuery.ajax({
            url: '/ajax/image_analysis/check_run_name',
            method: 'GET',
            data: { run_name: runName }
        }).then(function(resp) {
            $btn.prop('disabled', false).text('Save Results');

            if (resp && resp.exists) {
                showRunNameError('The name "' + runName + '" already exists. Please choose a different name.');
                return;
            }

            jQuery('#runNameModal').modal('hide');
            saveSingleRun(runName);
        }, function () {
            $btn.prop('disabled', false).text('Save Results');
            showRunNameError('Could not verify the name. Please try again.');
        });
    });

    function showRunNameError(msg) {
        jQuery('#run_name_error').text(msg).show();
    }

    function saveSingleRun(runName) {
        var partition = window.save_partition;
        if (!partition || !partition.order.length) {
            showSaveError('No analysis results found to save.');
            return;
        }

        jQuery('#working_modal').modal('show');

        var chain    = jQuery.Deferred().resolve().promise();
        var images   = [];
        var failures = [];

        // Sequential: saveResults writes to the shared #upload_images_file_input node.
        partition.order.forEach(function(image_id) {
            chain = chain.then(function() {
                return saveResults(partition.groups[image_id], image_id).then(
                    function(descriptor) { images.push(descriptor); },
                    function(err) { failures.push({ image_id: image_id, err: extractError(err) }); }
                );
            });
        });

        chain.always(function() {
            if (!images.length) {
                jQuery('#working_modal').modal('hide');
                showSaveError('No images could be saved. ' + failures.map(function(f) {
                    return 'Image ' + f.image_id + ': ' + f.err;
                }).join('; '));
                return;
            }

            createRunProject(images, runName, analysis_metadata)
                .done(function(resp) {
                    jQuery('#working_modal').modal('hide');
                    if (!resp || resp.error) {
                        showSaveError((resp && resp.error) || 'Unknown error creating the run.');
                        return;
                    }
                    showRunSaveSummary(resp, runName, images.length, failures);
                })
                .fail(function(xhr) {
                    jQuery('#working_modal').modal('hide');
                    showSaveError(extractError(xhr));
                });
        });
    }

    function extractError(xhr) {
        if (!xhr) return 'Unknown error';
        if (xhr.responseJSON && xhr.responseJSON.error) return xhr.responseJSON.error;
        if (xhr.status === 0)   return 'Network error — request did not reach the server.';
        if (xhr.status === 504) return 'Server timed out. The run may still exist — check before retrying.';
        return xhr.responseText || ('HTTP ' + xhr.status);
    }

    function showRunSaveSummary(resp, runName, okCount, failures) {
        var runId = resp && resp.run_project_id;
        var name  = (resp && resp.run_name) || runName;
        var nameHtml = runId
            ? '<a href="/image_analysis/run/' + runId + '">' + jQuery('<div>').text(name).html() + '</a>'
            : jQuery('<div>').text(name).html();

        var html = '<ul class="list-group">' +
            '<li class="list-group-item list-group-item-success">' +
                '<span class="badge"><span class="glyphicon glyphicon-ok"></span></span>' +
                'Saved run: ' + nameHtml +
                ' <span class="text-muted">(' + okCount + (okCount === 1 ? ' image' : ' images') + ')</span>' +
            '</li>';

        (failures || []).forEach(function(f) {
            html += '<li class="list-group-item list-group-item-warning">' +
                        '<span class="badge"><span class="glyphicon glyphicon-warning-sign"></span></span>' +
                        'Image ' + jQuery('<div>').text(f.image_id).html() + ' was not saved: ' +
                        jQuery('<div>').text(f.err).html() +
                    '</li>';
        });

        html += '</ul>';
        jQuery('#saveResultModalBody').html(html);
        jQuery('#saveResultModal').modal('show');
    }

    function saveAllRuns(entries) {
        jQuery('#working_modal').modal('show');

        var chain = jQuery.Deferred().resolve(); 
        var summaries = [];

        entries.forEach(function(e) {
            chain = chain.then(function() {
                return saveResults(e.rows, e.runName).then(
                    function(resp) { summaries.push({ ok: true,  name: e.runName, resp: resp }); },
                    function(xhr)  { summaries.push({ ok: false, name: e.runName, err: xhr && (xhr.responseText || xhr) }); }
                );
            });
        });

        chain.always(function() {
            jQuery('#working_modal').modal('hide');
            showAllSaveSummaries(summaries);   // combined success/error list
        });
    }

    function showAllSaveSummaries(summaries) {
        var html = '<ul class="list-group">';
        summaries.forEach(function(s) {
            if (s.ok && s.resp && !s.resp.error) {
                var runId   = s.resp.run_project_id;
                var runName = s.resp.run_name || s.name;
                var nameHtml = runId
                    ? '<a href="/image_analysis/run/' + runId + '">' + jQuery('<div>').text(runName).html() + '</a>'
                    : jQuery('<div>').text(runName).html();
                html += '<li class="list-group-item list-group-item-success">' +
                            '<span class="badge"><span class="glyphicon glyphicon-ok"></span></span>' +
                            'Saved run: ' + nameHtml + '</li>';
            } else {
                var msg = (s.resp && s.resp.error) ? s.resp.error : (s.err || 'Unknown error');
                html += '<li class="list-group-item list-group-item-danger">' +
                            '<span class="badge"><span class="glyphicon glyphicon-remove"></span></span>' +
                            'Failed to save "' + jQuery('<div>').text(s.name).html() + '": ' +
                            jQuery('<div>').text(msg).html() + '</li>';
            }
        });
        html += '</ul>';
        jQuery('#saveResultModalBody').html(html);
        jQuery('#saveResultModal').modal('show');
    }

    function getThumbFromRows(rows) {
        var d = rows[0].details && rows[0].details[0];
        var orig = (d && d.original_link) || rows[0].original_link;
        if (!orig) return '';
        return orig.replace(/\/[^\/]+$/, '/small.jpg');
    }

    function saveResults(table_data, imageId) {
        let done = jQuery.Deferred();
        console.log("processing image:", imageId, "rows:", table_data.length);
        //console.log("saving run for image:", table_data[0].source_image_id, "->", runName);

        //let this_image_id = table_data[0].source_image_id;
        /*
        var table_data = jQuery('#image_analysis_result_table').DataTable().rows().data().toArray();
        console.log("table data:", table_data);
        */
        let dt = new DataTransfer();

        jQuery('#working_modal').modal('show');
        let plantData = [
            {
                additionalInfo: {
                    observationUnitParent: table_data[0].observationUnitDbId
                },
                observationUnitName: table_data[0].observationUnitName + "_" + imageId +  "_plant",
                studyDbId: table_data[0].studyDbId, // trial ID
                germplasmDbId: table_data[0].germplasmDbId,
                observationUnitPosition: {
                    observationLevel: {
                        levelName: "plant",
                        levelCode: table_data[0].observationUnitDbId,
                        levelOrder: 4
                    },
                    positionCoordinateX: null,
                    positionCoordinateY: null,
                    observationLevelRelationships: [],
                    geoCoordinates: null
                }
            }
        ];

        let tissueSamplesData = [];
        let tissueSampleMap = {};
        let existingCreatedSamples = [];

        let plantId = table_data[0].observationUnitDbId;
        
        if (jQuery('#image_analysis_service_select option:selected').text() === "Citrus Image Multi Analysis" || jQuery('#image_analysis_service_select option:selected').text() === "Image Multi Object Multi Trait Analysis") {
            if (submit_results.stock_type_name === "plot") { //shold this be !== "plant"?
                jQuery.ajax({
                    type: 'GET',
                    contentType: 'application/json',
                    url: `/brapi/v2/observationunits?observationUnitName=${encodeURIComponent(plantData[0].observationUnitName)}`,
                    headers: { "Authorization": "Bearer "+jQuery.cookie("sgn_session_id") },
                    success: function(response) {
                        if (response.result.data.length > 0) {
                            plantId = response.result.data[0].observationUnitDbId;
                        } else {
                            jQuery.ajax({
                                type: 'POST',
                                contentType: 'application/json',
                                url: '/brapi/v2/observationunits',
                                headers: { "Authorization": "Bearer "+jQuery.cookie("sgn_session_id") },
                                data: JSON.stringify(plantData),
                                beforeSend: function() {
                                    jQuery('#working_modal').modal('show');
                                },
                                success: function(response) {
                                    if (response.result.data.length > 0) {
                                        plantId = response.result.data[0].observationUnitDbId;
                                    }                                
                                },
                                error: function(response) {
                                    jQuery('#working_modal').modal('hide');
                                    jQuery('#saveResultModalBody').html('<ul class="list-group"><li class="list-group-item list-group-item-danger"><span class="badge"><span class="glyphicon glyphicon-remove"></span></span>Error while creating a new plant. Deets: '+response.responseText+'</li></ul>');
                                    jQuery('#saveResultModal').modal('show');
                                }
                            });
                        }                        
                    },
                    error: function(response) {
                        jQuery('#working_modal').modal('hide');
                        jQuery('#saveResultModalBody').html('<ul class="list-group"><li class="list-group-item list-group-item-danger"><span class="badge"><span class="glyphicon glyphicon-remove"></span></span>Error while trying to save the analysis results. Deets: '+response.responseText+'</li></ul>');
                        jQuery('#saveResultModal').modal('show');
                    }
                })
            } 

            const fileData = {};
            let imageFiles;
            let imageData;
            const samples = {};
            let plotId = table_data[0].observationUnitDbId;
            let studyDbId = table_data[0].studyDbId;
            let germplasmName = plantData[0].observationUnitName;
            let accessionId = table_data[0].germplasmDbId;
            let sampleName;
            var seen_trait_ids = {};
            var trait_ids = [];

            table_data.forEach(row => {
                var trait_id = row.observationVariableDbId;
                if (trait_id != null && !seen_trait_ids[trait_id]) {
                    seen_trait_ids[trait_id] = true;
                    trait_ids.push(trait_id);
                }
                row.details.forEach((detail, i) => {
                    const key = detail.object_name || detail.image_name;

                    if (!samples[key]) {
                        let sampleNumber = parseInt(detail.sample_num);
                        if (is_multi_trait == 1) {
                            sampleName = germplasmName + '_' + 'sample' + sampleNumber;
                        } else {
                            sampleName = detail.trait_id + '_' + germplasmName + '_' + 'sample' + sampleNumber;
                        }

                        samples[key] = {
                            sampleName: sampleName,
                            trait_values: {},
                            analyzed_link: detail.analyzed_link,
                            studyDbId: row.studyDbId,
                            accessionId: table_data[0].germplasmDbId
                        };
                    }
                    samples[key].trait_values[row.observationVariableDbId] = detail.value;
                });
            });

            Object.values(samples).forEach((sample, index) => {
                const sampleName = sample.sampleName;
                const proxyUrl = "/get_image_file?url=" + encodeURIComponent(sample.analyzed_link);

                // fetch image
                if (jQuery('#image_analysis_service_select option:selected').text() !== "Image Multi Object Multi Trait Analysis") {
                    console.log("test multi image");
                    fetch(proxyUrl)
                    .then(response => {
                        if (!response.ok) throw new Error("Failed to fetch " + proxyUrl);
                        return response.blob();
                    })
                    .then(blob => {
                        let filename = sampleName + ".png";
                        let file = new File([blob], filename, { type: blob.type || "image/png" });
                        dt.items.add(file);

                        document.getElementById('upload_images_file_input').files = dt.files;
                        imageFiles = document.getElementById('upload_images_file_input').files;

                        fileData[file.name] = {
                            imageFileName: file.name,
                            imageFileSize: file.size,
                            mimeType: file.type
                        };
                    })
                    .catch(err => console.error(err));
                }
                
                
                // create tissue sample
                tissueSamplesData.push({
                    additionalInfo: {
                        observationUnitParent: plantId
                    },
                    observationUnitName: sampleName,
                    studyDbId: sample.studyDbId,
                    germplasmDbId: sample.accessionId,
                    observationUnitPosition: {
                        observationLevel: {
                            levelName: "tissue_sample",
                            levelCode: "tissue_sample_test" + (index + 1),
                            levelOrder: 4
                        },
                        observationLevelRelationships: [
                            {
                                levelName: "plant",
                                observationUnitDbId: plantId,
                                levelOrder: 4
                            }
                        ],
                        positionCoordinateX: null,
                        positionCoordinateY: null,
                        geoCoordinates: null
                    }
                });

                // store ALL trait values per sample
                tissueSampleMap[sampleName] = sample.trait_values;
            });
            console.log("tissueSamplesData1", tissueSamplesData);

            // Add observations to existing samples if analysis has been run on current image before
            if (table_data[0].image_analyzed == 1) {
                console.log("tissueSamplesData:", tissueSamplesData);
                getOrCreateSamples(tissueSamplesData).then(sampleData => {
                    console.log("sampleData", sampleData);
                    console.log("tissueSampleMap", tissueSampleMap);
                    const observationData = [];

                    Object.entries(sampleData).forEach(([sampleId, sampleName]) => {
                        const sampleValues = tissueSampleMap[sampleName];
                        console.log("sampleValues:", sampleValues);

                        if (!sampleValues) return; // safety check

                        Object.entries(sampleValues).forEach(([traitId, value]) => {
                            console.log("traitId:", traitId);
                            observationData.push({
                                collector: table_data[0].collector,
                                observationUnitDbId: sampleId,
                                observationVariableDbId: traitId,
                                observationTimeStamp: table_data[0].observationTimeStamp,
                                value: value
                            });
                        });
                    });

                    console.log("observation json", JSON.stringify(observationData));

                    jQuery.ajax({
                        type: 'POST',
                        contentType: 'application/json',
                        url: '/brapi/v2/observations',
                        headers: { "Authorization": "Bearer " + jQuery.cookie("sgn_session_id") },
                        data: JSON.stringify(observationData),
                        success: function (obsResponse) {
                            console.log("obsResponse raw:", obsResponse);
                            console.log("obsResponse type:", typeof obsResponse);
                            var tissue_sample_ids = Object.keys(sampleData);
                            console.log("tissue_sample_ids test:", tissue_sample_ids);
                            done.resolve(buildImageDescriptor(table_data, imageId, tissue_sample_ids, trait_ids));
                        },
                        error: function (err) {
                            console.error("Error saving observations", err.responseText);
                            done.reject(err);
                        }
                    });
                });
            } else {
                jQuery.ajax({
                    type: 'POST',
                    contentType: 'application/json',
                    url: '/brapi/v2/observationunits',
                    headers: { "Authorization": "Bearer "+jQuery.cookie("sgn_session_id") },
                    data: JSON.stringify(tissueSamplesData),
                    success: function(response) {
                        const observationUnitDbIdsMap = {};
                        response.result.data.forEach(unit => {
                            observationUnitDbIdsMap[unit.observationUnitName] = unit.observationUnitDbId;
                        });


                        imageData = Object.values(fileData).map(file => {
                            const sampleName = file.imageFileName.replace(/\.[^/.]+$/, "");
                            file.observationUnitDbId = observationUnitDbIdsMap[sampleName];
                            return file;
                        });

                        const observationData = [];

                        response.result.data.forEach(unit => {
                            const sampleValues = tissueSampleMap[unit.observationUnitName];

                            if (!sampleValues) return;
                            Object.entries(sampleValues).forEach(([traitId, value]) => {
                                observationData.push({
                                    collector: table_data[0].collector,
                                    observationUnitDbId: unit.observationUnitDbId,
                                    observationVariableDbId: traitId,
                                    observationTimeStamp: table_data[0].observationTimeStamp,
                                    value: value
                                });
                            })
                            
                        })
                        console.log("observationdata 2:", observationData);
                        var unitResponseData = response.result.data;

                        jQuery.ajax({
                            type: 'POST',
                            contentType: 'application/json',
                            url: '/brapi/v2/observations',
                            headers: { "Authorization": "Bearer "+jQuery.cookie("sgn_session_id") },
                            data: JSON.stringify(observationData),
                            success: function(obsResponse) {
                                let promise = (imageFiles && imageFiles.length) ? loadAllImages(imageFiles, imageData) : Promise.resolve();
                                promise.then(function(uploadStatus) {
                                    console.log("Upload completed!");
                                    var tissue_sample_ids = unitResponseData.map(function(unit) {
                                        return unit.observationUnitDbId;
                                    });
                                    done.resolve(buildImageDescriptor(table_data, imageId, tissue_sample_ids, trait_ids));                               
                                }, 
                                function(err) {
                                    done.reject(err);
                                });
                            },
                            error: function(response) {
                                jQuery('#working_modal').modal('hide');
                                jQuery('#saveResultModalBody').html('<ul class="list-group"><li class="list-group-item list-group-item-danger"><span class="badge"><span class="glyphicon glyphicon-remove"></span></span>Error while trying to save the analysis results. Deets: '+response.responseText+'</li></ul>');
                                jQuery('#saveResultModal').modal('show');
                            }
                        })
                    },
                    error: function(response) {
                        jQuery('#working_modal').modal('hide');
                        jQuery('#saveResultModalBody').html('<ul class="list-group"><li class="list-group-item list-group-item-danger"><span class="badge"><span class="glyphicon glyphicon-remove"></span></span>Error while trying to save the analysis results. Deets: '+response.responseText+'</li></ul>');
                        jQuery('#saveResultModal').modal('show');
                    }
                });
            }
        } else if (jQuery('#image_analysis_service_select option:selected').text() === "Citrus Image Analysis") {
            table_data[0].observationUnitDbId = plantId;
            jQuery.ajax({
            url: '/brapi/v2/observations/',
            method: 'POST',
            headers: { "Authorization": "Bearer "+jQuery.cookie("sgn_session_id") },
            data: JSON.stringify(table_data),
            contentType: "application/json; charset=utf-8",
            beforeSend: function() {
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                // console.log(response);
                var tissue_sample_ids = [table_data[0].observationUnitDbId];
                done.resolve(buildImageDescriptor(table_data, imageId, tissue_sample_ids, trait_ids));
            },  
            error: function(response) {
                // console.log(response);
                jQuery('#working_modal').modal('hide');
                jQuery('#saveResultModalBody').html('<ul class="list-group"><li class="list-group-item list-group-item-danger"><span class="badge"><span class="glyphicon glyphicon-remove"></span></span>Error while trying to save the analysis results. Deets: '+response.responseText+'</li></ul>');
                jQuery('#saveResultModal').modal('show');
            }
        });
        }
        return done.promise();
        
    }

});

function getOrCreateSamples(sampleData) {
    const existingSamples = {};
    const requests = sampleData.map(sample => {
        return new Promise((resolve, reject) => {
            jQuery.ajax({
                url: `/brapi/v2/observationunits?observationUnitName=${encodeURIComponent(sample.observationUnitName)}`,
                method: 'GET',
                headers: { "Authorization": "Bearer " + jQuery.cookie("sgn_session_id") },
                success: function (response) {
                    if (response.result.data.length > 0) {
                        existingSamples[response.result.data[0].observationUnitDbId] = response.result.data[0].observationUnitName;
                        resolve();
                    } else {
                        jQuery.ajax({
                            type: 'POST',
                            url: '/brapi/v2/observationunits',
                            headers: { "Authorization": "Bearer " + jQuery.cookie("sgn_session_id") },
                            contentType: 'application/json',
                            data: JSON.stringify([sample]),
                            success: function (sampleResp) {
                                existingSamples[sampleResp.result.data[0].observationUnitDbId] =
                                    sampleResp.result.data[0].observationUnitName;
                                resolve();
                            },
                            error: reject
                        });
                    }
                },
                error: reject
            });
        });
    });

    return Promise.all(requests).then(() => existingSamples);
}

function buildImageDescriptor(table_data, imageId, tissue_sample_ids, trait_ids) {
    var row = table_data[0];
    return {
        source_image_id:  parseInt(imageId, 10),
        source_stock_id:  parseInt(row.observationUnitDbId, 10),
        trial_id:         parseInt(row.studyDbId, 10),
        overlay_image_id: resolveOverlayImageId(row),
        tissue_samples:   dedupeStockIds(tissue_sample_ids),
        trait_ids:        trait_ids || []
    };
}

function dedupeStockIds(ids) {
    var seen = {}, out = [];
    (ids || []).forEach(function(id) {
        var n = parseInt(id, 10);
        if (isNaN(n) || seen[n]) return;
        seen[n] = true;
        out.push({ stock_id: n, result_image_id: null });
    });
    return out;
}

function createRunProject(images, runName, analysis_metadata) {
    console.log("create run project triggered with", images.length, "images");

    if (!images.length) {
        return rejectWith('No saved images to attach to this run.');
    }
    var bad = images.filter(function(i) {
        return !i.source_image_id || !i.source_stock_id || !i.trial_id;
    });
    if (bad.length) {
        return rejectWith('Incomplete image data for source_image_id(s): ' +
            bad.map(function(i) { return i.source_image_id || '(none)'; }).join(', '));
    }

    // Union trait ids across every image in the run.
    var seen = {}, trait_ids = [];
    images.forEach(function(img) {
        (img.trait_ids || []).forEach(function(t) {
            if (t != null && !seen[t]) { seen[t] = true; trait_ids.push(t); }
        });
    });

    var payload = images.map(function(i) {
        return {
            source_image_id:  i.source_image_id,
            source_stock_id:  i.source_stock_id,
            trial_id:         i.trial_id,
            overlay_image_id: i.overlay_image_id,
            tissue_samples:   i.tissue_samples
        };
    });

    var run_date = new Date().toISOString().slice(0,19).replace('T',' ');
    console.log("createRunProject images_json:", JSON.stringify(payload));
    console.log("run NAME:", runName);

    return jQuery.ajax({
        type : 'POST',
        url  : '/ajax/image_analysis/create_run_project',
        data : {
            run_name          : runName,
            service_name      : jQuery('#image_analysis_service_select option:selected').text(),
            run_date          : run_date,
            images_json       : JSON.stringify(payload),
            trait_ids         : JSON.stringify(trait_ids),
            analysis_info_json: JSON.stringify({ analysis_metadata: analysis_metadata })
        }
    });
}

function rejectWith(msg) {
    console.error("createRunProject:", msg);
    return jQuery.Deferred().reject({ responseJSON: { error: msg } }).promise();
}

function resolveOverlayImageId(row) {
    var id = row.overlay_image_id;
    if (id != null && String(id).match(/^\d+$/)) return parseInt(id, 10);
    return null;
}

function showSaveSuccess(resp) {
    if (resp && resp.error) {
        showSaveError(resp.error);
        return;
    }

    var runName = (resp && resp.run_name) ? resp.run_name : '';
    var runId   = (resp && resp.run_project_id) ? resp.run_project_id : null;

    var nameHtml;
    if (runId) {
        nameHtml = '<a href="/image_analysis/run/' + runId + '">' +
                    jQuery('<div>').text(runName).html() +   
                    '</a>';
    } else {
        nameHtml = jQuery('<div>').text(runName).html();
    }

    jQuery('#saveResultModalBody').html(
        '<ul class="list-group">' +
            '<li class="list-group-item list-group-item-success">' +
                '<span class="badge"><span class="glyphicon glyphicon-ok"></span></span>' +
                'New analysis run saved: ' + nameHtml +
            '</li>' +
        '</ul>'
    );
    jQuery('#saveResultModal').modal('show');
}

function showSaveError(msg) {
    jQuery('#saveResultModalBody').html(
        '<ul class="list-group">' +
            '<li class="list-group-item list-group-item-danger">' +
                '<span class="badge"><span class="glyphicon glyphicon-remove"></span></span>' +
                'Error while trying to save the analysis results.' +
                (msg ? ' Deets: ' + jQuery('<div>').text(msg).html() : '') +
            '</li>' +
        '</ul>'
    );
    jQuery('#saveResultModal').modal('show');
}

function _load_image_search_results() {
    images_table = jQuery('#image_analysis_image_search_results').DataTable({
        'destroy' : true,
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'scrollX': true,
        'lengthMenu': [10,20,50,100,1000,5000],
        'ajax': { 'url':  '/ajax/search/images',
            'method': 'POST',
            'data': function(d) {
              d.html_select_box = "image_analysis_select";
              d.image_description_filename_composite = jQuery('#image_description_filename_composite').val();
              d.image_person = jQuery('#image_submitter').val();
              d.image_tag = jQuery('#image_tag').val();
              d.image_stock_uniquename = jQuery('#image_stock_uniquename').val();
              d.image_project_name = jQuery('#html_image_analysis_trial_select').val();
            }
        }
    });
}

function _load_run_search_results() {
    jQuery('#image_analysis_run_search_results').DataTable({
        'destroy'    : true,
        'searching'  : false,
        'ordering'   : false,
        'processing' : true,
        'serverSide' : true,
        'scrollX'    : true,
        'lengthMenu' : [10, 20, 50, 100, 1000],
        'ajax': {
            'url': '/ajax/image_analysis/search_runs',
            'method': 'POST',
            'data': function (d) {
                d.run_name       = jQuery('#run_search_run_name').val();
                d.image_filename = jQuery('#run_search_image_filename').val();
                d.stock_name     = jQuery('#run_search_stock_name').val();
                d.pipeline_name  = jQuery('#run_search_pipeline_name').val();
            }
        }
    });
}

function _load_analysis_activity_graph(date_range) {

    d3.json('/ajax/image_analysis/activity', function(error, response) {

        if (response.activity) {
            var activity = JSON.parse(response.activity);
            // console.log("Activity array is: ");
            // console.log(activity);

            // Iterate through each data point and parse date strings into dates
            var parseTime = d3.timeParse("%Y-%m-%d");
            var data = [];

            jQuery.each(activity, function (index, element) {
                data.push({
                    'date': parseTime(element.date)
                })
            });

            // Set canvas margins
            var margin = {top: 20, right: 50, bottom: 30, left: 50};
            var width = 800 - margin.left - margin.right;
            var height = 500 - margin.top - margin.bottom;

            // Create svg object
            var svg = d3.select('#image_analysis_usage').append('svg')
                .attr('width', width + margin.left + margin.right)
                .attr('height', height + margin.top + margin.bottom)
                .append('g')
                .attr('transform', `translate(${margin.left}, ${margin.top})`);

            // Set x (timeseries) and y (linear) scales
            var xScale = d3.scaleTime().range([0, width]);
            var yScale = d3.scaleLinear().range([height, 0]);

           var dayExtent = d3.extent(data, function (d) { return d.date; });

           console.log("day extent is "+dayExtent);

           // Create one bin per day, use an offset to include the first and last days
           var dayBins = d3.timeDays(d3.timeDay.offset(dayExtent[0],-1),
                                     d3.timeDay.offset(dayExtent[1], 1));

           var x = d3.scaleTime()
               .domain(dayExtent)
               .rangeRound([0, width]);

           // Scale the range of the data in the y domain
           var y = d3.scaleLinear()
                      .range([height, 0]);

           var xAxis = d3.axisBottom(x)
                          .tickArguments([d3.timeDay.every(1)])
                          .tickFormat(d3.timeFormat('%d-%b'))
                          .ticks(10);

           // Set the parameters for the histogram
           var histogram = d3.histogram()
                              .value(function(d) { return d.date; })
                              .domain(x.domain())
                              .thresholds(x.ticks(dayBins.length));


           // Group the data for the bars
           var bins = histogram(data);

           y.domain([0, d3.max(bins, function(d) { return d.length; })]);

           var hist = svg.selectAll("rect")
                .data(bins)
                .enter().append("rect")
                .attr("class", "bar")
                .attr("x", 1)
                .attr("transform", function(d) {
                   return "translate(" + x(d.x0) + "," + y(d.length) + ")";
                })
                .attr("width", function(d) {
                   return x(d.x1) - x(d.x0) -1 ;
                })
                .attr("height", function(d) {
                   return height - y(d.length);
                });

           // Add the x axis
           svg.append("g")
                .attr("transform", "translate(0," + height + ")")
                .call(xAxis)

           // Add the y axis
           svg.append("g")
                // .call(d3.axisLeft(y).ticks(d3.max(bins, function(d) { return d.length; })))
                .call(d3.axisLeft(y).ticks(15))
                .append("text")
                .attr("fill", "#000")
                .attr("transform", "rotate(-90)")
                .attr("y", 0 - margin.left)
                .attr("x",0 - (height / 2))
                .attr("dy", "1em")
                .style("text-anchor", "middle")
                .text("Number of Images Analyzed");
        } else {
            document.getElementById('image_analysis_usage').innerHTML += '<center>No image analysis usage data found.</center>';
        }

    });
}

function format ( d ) {
    var detail_rows = '';
    d.details.forEach(function (image, index) {
        var result = image.analyzed_link;
        var text;
        if (result.startsWith("Error: ")) {
            text = result;
        } else if (Object.hasOwn(image, 'object_name')) {
            text = '';
            name_header = "Object Name";
            name = image.object_name;
        } else {
            text = '<img src="'+result+'" width="100">';
            name_header = "Image Name";
            name = image.image_name;
        }
        detail_rows +=
        `<tr>
          <td>`+name+`</td>
          <td>`+text+`</td>
          <td>`+image.value+`</td>
        </tr>`
    });

    return `<table class="table">
                <thead>
                    <tr>
                    <th scope="col">` + name_header + `</th>
                    <th scope="col">Analyzed Image</th>
                    <th scope="col">Value</th>
                    </tr>
                </thead>
                <tbody>` + detail_rows + `</tbody>
            </table>`;

}

</script>

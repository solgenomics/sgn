<%args>
$identifier_id
$identifier_name
$material_id
$material_name
$updated_status_type
$program_name
$stock_type_page
</%args>

<%perl>

my $display_label;
my $display_name;
if ($stock_type_page eq 'tracking_id') {
    $display_label = $c->i18n->p("transformation.root.tracking_id", "Tracking ID");
    $display_name = $identifier_name;
} elsif ($stock_type_page eq 'transformation_id') {
    $display_label = $c->i18n->p("transformation.transformation_id.6f39808", "Transformation ID");
    $display_name = $material_name;
}
</%perl>


<div class="modal fade" id="update_status_dialog" name="_dialog" tabindex="-1" role="dialog" aria-labelledby="updateStatusDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updateStatusDialog"><% $c->i18n->p("transformation.root.mark_this_experiment_as_completed_or_terminated", "Mark this experiment as completed or terminated") |h %> </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" id="update_status_form" name="update_status_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $display_label %>: </label>
                            <div class="col-sm-8" >
                                <input class="form-control" name="tracking_identifier_name" id="tracking_identifier_name" disabled value="<% $display_name %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("transformation.root.status_type", "Status Type:") |h %> </label>
                            <div class="col-sm-8">
                                <select class="form-control" id="status_type">
                                    <option value=""><% $c->i18n->p("transformation.root.select_a_status_type", "Select a status type") |h %></option>
                                    <option value="completed"><% $c->i18n->p("transformation.root.completed", "completed") |h %></option>
                                    <option value="terminated"><% $c->i18n->p("transformation.root.terminated", "terminated") |h %></option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("transformation.root.comments", "Comments:") |h %> </label>
                            <div class="col-sm-8" >
                                <textarea class="form-control" id="comments_for_updating" name="comments_for_updating" placeholder="<% $c->i18n->p("accession.stock.optional", "Optional") |h %>"></textarea>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="update_status_submit" id="update_status_submit"><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="updated_saved_dialog_message" name="updated_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="updatedSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updatedSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("transformation.root.the_status_of_this_experiment_has_been_updated", "The status of this experiment has been updated.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_updated_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="reverse_status_dialog_message" name="reverse_status_dialog_message" tabindex="-1" role="dialog" aria-labelledby="reverseStatusDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="reverseStatusDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("transformation.root.this_experiment_has_been_restored", "This experiment has been restored.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_reverse_status_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>
jQuery(document).ready(function(){

    var identifier_id = "<% $identifier_id %>";
    var material_id = "<% $material_id %>";
    var program_name = "<% $program_name %>";

    jQuery("[name='update_status_link']").click(function() {
        jQuery('#update_status_dialog').modal('show');
    });

    jQuery('#update_status_submit').click(function() {

        var status_type = jQuery('#status_type').val();
        var comments = jQuery('#comments_for_updating').val();

        if ((identifier_id === '') && (material_id === '')) {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.error_retrieving_source_info", "Error retrieving source info") : "Error retrieving source info"));
            return;
        }

        if (status_type === '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.please_select_a_status_type", "Please select a status type") : "Please select a status type"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/tracking_activity/update_status',
            type: 'POST',
            dataType: "json",
            data : {
                'identifier_id': identifier_id,
                'status_type': status_type,
                'material_id': material_id,
                'comments': comments,
                'program_name': program_name,
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#update_status_dialog').modal('hide');
                    jQuery('#updated_saved_dialog_message').modal("show");
                }
                if (response.error_string) {
                    alert(response.error_string);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.an_error_occurred_updating_status", "An error occurred updating status") : 'An error occurred updating status'));
            }
        });
    });

    jQuery("#dismiss_updated_saved_dialog").click( function() {
        jQuery('#updated_saved_dialog_message').modal('hide');
        location.reload();
    });

    jQuery("[name='reverse_status_link']").click(function() {
        var updated_status_type = "<% $updated_status_type %>";
        var confirmation = confirm(((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.are_you_sure_you_want_to_reverse_status_of_this", "Are you sure you want to reverse status of this ") : "Are you sure you want to reverse status of this ") + "<% $display_label %>" + "?"));
        if (confirmation) {
            jQuery.ajax({
                url: '/ajax/tracking_activity/reverse_status',
                type: 'POST',
                dataType: "json",
                data : {
                    'identifier_id' : identifier_id,
                    'updated_status_type' : updated_status_type,
                    'material_id' : material_id,
                    'program_name' : program_name,
                },
                beforeSend: function(response){
                    jQuery('#working_modal').modal('show');
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        jQuery('#reverse_status_dialog_message').modal("show");
                    }
                    if (response.error_string) {
                        alert(response.error_string);
                    }
                },
                error: function(response){
                    jQuery('#working_modal').modal('hide');
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlots.ui.an_error_occurred_processing_your_request", "An error occurred processing your request") : 'An error occurred processing your request'));
                }
            });
        }
    });

    jQuery("#dismiss_reverse_status_dialog").click( function() {
        jQuery('#reverse_status_dialog_message').modal('hide');
        location.reload();
    });


});

</script>

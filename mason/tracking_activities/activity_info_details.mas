
<%args>
$identifier_name
$identifier_id
$program_name
$user_id => undef
$identifier_prefix => ''
$type_select_options => undef
$activity_headers
$timestamp => undef
$date => undef
$material_name
$material_id
$material_type
$updated_status_type => undef
$updated_status_string => undef
$status_display => undef
$user_role
$project_id
$activity_type
$stock_type_page
$source_info => undef
$can_obsolete => undef
$vector_id => undef

</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery/dataTables', 'CXGN.BreedersToolbox.HTMLSelect.js', 'CXGN.List', 'flatpickr_min' ] &>

% use utf8;
% my @column_headers = @$activity_headers;
% my @activity_types = @$type_select_options;

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("transformation.root.tracking_activities_of_name", "Tracking Activities of '%{name}'", {name => "" . $identifier_name})) &>

<& /util/import_javascript.mas, classes => ['jquery','jquery.dataTables'] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

% if ($updated_status_type) {
    <div class="modal-header" style="text-align: center">
        <h4 class="modal-title" ><%$status_display%></h4>
        <h4><%$updated_status_string%></h4>
    </div>
% }

<td>
    <a href='/breeders/trial/<%$project_id%>'><p><% $c->i18n->p("transformation.root.go_to_project_page", "Go to Project Page") |h %></p></a>
</td>

<&| /page/info_section.mas, anchor_title => 'Record', title => HTML::Entities::encode_entities($c->i18n->p("seedlot_overdue.ui.record", 'Record')), collapsible => 1, collapsed => 0, subtitle => '' &>
    <div class="well ">
        <form class="form-horizontal" >
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.material", "Material:") |h %> </label>
                <div class="col-sm-5">
                    <input class="form-control" id="material_info" name="material_info" type="text" disabled value="<%$material_name%>">
                </div>
            </div>
% if (!$updated_status_type) {
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.input_type", "Input Type:") |h %> </label>
                <div class="col-sm-5">
% if ($type_select_options) {
                    <select id="type_select">
                        <option value=""><% $c->i18n->p("seedlot.please_select_a_type", "Please select a type") |h %></option>
% foreach my $type(@$type_select_options){
                        <option value="<%$type->[0]%>"><%$type->[1]%></option>
% }
                    </select>
% }
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.input", "Input:") |h %> </label>
                <div class="col-sm-5">
                    <input class="form-control" id="selected_type_input" name="selected_type_input" type="text" value="">
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label"><% $c->i18n->p("seedlots.ui.notes", "Notes:") |h %></label>
                <div class="col-sm-5">
                    <textarea class="form-control" id="selected_type_notes" name="selected_type_notes" ></textarea>
                </div>
            </div>
            <div class="form-group" style="display:none">
                <label class="col-sm-3 control-label"><% $c->i18n->p("lists_datasets.download.timestamp", "Timestamp:") |h %> </label>
                <div class="col-sm-5">
                    <input class="form-control" id="record_timestamp" name="record_timestamp" type="text" disabled value="<%$timestamp%>">
                </div>
            </div>
            <center>
                <button id="activity_info_submit" name="activity_info_submit" class="btn btn-primary"><% $c->i18n->p("account.quick_create.save", "Save") |h %></button>
            </center>
% }
        </form>
    </div>
</&>

<&| /page/info_section.mas, anchor_title => 'Summary', title => HTML::Entities::encode_entities($c->i18n->p("global.family.summary", 'Summary')), collapsible => 1, collapsed => 0, subtitle => '' &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "activity_summary_table" class="table table-hover table-striped">
                        <thead>
                            <tr>
% foreach my $header(@column_headers){
                                <th><%$header%></th>
%}
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

<&| /page/info_section.mas, anchor_title => 'Activity Details', title => HTML::Entities::encode_entities($c->i18n->p("transformation.root.activity_details", 'Activity Details')), collapsible => 1, collapsed => 0, subtitle => '' &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "activity_info_table" class="table table-hover table-striped">
                        <thead>
                            <tr>
% foreach my $header(@column_headers){
                                <th><%$header%></th>
%}
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</&>

<div class="modal fade" id="info_saved_dialog_message" name="info_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="infoSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="infoSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("transformation.root.new_information_was_saved", "New information was saved.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_info_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>

% if ($material_type eq 'transformation') {
    <& /transformation/transformants_section.mas, transformation_id => $material_id, program_name => $program_name, can_obsolete => $can_obsolete, vector_id => $vector_id &>
    <& /transformation/obsoleted_transformants_section.mas, transformation_id => $material_id &>
% }


<&| /page/info_section.mas, anchor_title => "Update Status", title=>HTML::Entities::encode_entities($c->i18n->p("seedlot.update_status", "Update Status")),  collapsible => 1, collapsed=>1 &>
% if ($user_role eq "curator" ) {
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <button class="btn btn-sm btn-default" style="margin:3px" id ="update_status_usage_link_tracking_page" name = "update_status_usage_link"><% $c->i18n->p("cross.ui.usage_help", "Usage Help") |h %> <span class="glyphicon glyphicon-question-sign"></span></button>
% if ($updated_status_type) {
                <button class="btn btn-sm btn-primary" style="margin:3px" id="reverse_status_link_tracking_page" name="reverse_status_link"><% $c->i18n->p("transformation.reverse_status", "Reverse Status") |h %></button>
% } else {
                <button class="btn btn-sm btn-primary" style="margin:3px" id="update_status_link_tracking_page" name="update_status_link"><% $c->i18n->p("seedlot.update_status", "Update Status") |h %></button>
% }
            </div>
        </div>
    </div>
% } else {
    <% $c->i18n->p("transformation.you_need_to_be_logged_in_or_you_do_not", "You need to be logged in or you do not have sufficient privileges to update status of this tracking identifier.") |h %>
% }
</&>

<& /tracking_activities/update_status_dialog.mas, identifier_name => $identifier_name, identifier_id => $identifier_id, material_id => $material_id, material_name => $material_name, updated_status_type => $updated_status_type, program_name => $program_name, stock_type_page => $stock_type_page &>
<& /tracking_activities/update_status_usage_info_dialog.mas &>

<script>

jQuery(document).ready( function() {

    var identifier_id = "<%$identifier_id%>";
    var date = "<%$date%>";

    jQuery('#activity_info_table').DataTable({
        'autoWidth': false,
        'searching' : false,
        'ajax': '/ajax/tracking_activity/details/'+identifier_id,
    });

    jQuery('#activity_summary_table').DataTable({
        'autoWidth': false,
        'searching' : false,
        'dom': 'rtip',
        'ordering': false,
        'paging': false,
        'info': false,
        'ajax': '/ajax/tracking_activity/summary/'+identifier_id,
    });

    jQuery('#type_select').change(function() {
        jQuery('#selected_type_input').val('');
        var input_type = jQuery('#type_select').val();
        if (input_type.indexOf('date') != -1) {
            flatpickr('#selected_type_input', {
                allowInput: true,
                dateFormat: "Y-m-d",
                defaultDate: "today"
            });
        }
    });

    jQuery('#activity_info_submit').click( function(e) {
        e.preventDefault();
        var selected_type = jQuery('#type_select').val();
        var input = jQuery('#selected_type_input').val();
        var record_timestamp = jQuery('#record_timestamp').val();
        var notes = jQuery('#selected_type_notes').val();

        if (selected_type == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.please_select_a_type", "Please select a type") : "Please select a type"));
            return;
        }
        if (input == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.please_provide_an_input", "Please provide an input") : "Please provide an input"));
            return;
        }

        new jQuery.ajax({
            url: '/ajax/tracking_activity/save',
            dataType: "json",
            type: 'POST',
            data : {
                'tracking_identifier_name' : "<%$identifier_name%>",
                'tracking_identifier_id' : "<%$identifier_id%>",
                'selected_type': selected_type,
                'input': input,
                'record_timestamp': record_timestamp,
                'notes': notes,
                'activity_type': "<%$activity_type%>",
                'program_name': "<%$program_name%>",
                'source_info': '<%$source_info%>'
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#info_saved_dialog_message').modal("show");
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.an_error_occurred_saving_new_information", "An error occurred saving new information") : 'An error occurred saving new information'));
            }
        });
    });

    jQuery("#dismiss_info_saved_dialog").click(function(){
        jQuery('#type_select').val('');
        jQuery('#selected_type_input').val('');
        jQuery('#selected_type_notes').val('');
        location.reload();
    });

});

</script>

<%once>
use HTML::Entities ();
</%once>

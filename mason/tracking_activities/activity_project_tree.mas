<%args>
$user_id => undef
$programs
$locations
$roles
</%args>


<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'jstree.dist.jstree', 'CXGN.TrialTreeFolders'] &>

<& /util/import_css.mas, paths => ['/static/documents/inc/jstree_theme/jstree-bstheme-min.css'] &>

<& /tracking_activities/add_new_activity_project.mas, user_id=>$user_id, locations=>$locations, programs=>$programs, roles=>$roles &>
<& /breeders_toolbox/folder/folder_set.mas, project_type=>'activity_record' &>
<& /breeders_toolbox/folder/folder_new.mas, project_type=>'activity_record' &>
<& /breeders_toolbox/folder/folder_move.mas, project_type=>'activity_record' &>
<& /breeders_toolbox/folder/folders_edit.mas, folder_tree_type => 'Tracking Activities', folder_tree_identifier => 'activities_list', folder_tree_refresh_name => 'refresh_activity_jstree_html' &>

<table class="table table-bordered">
    <thead>
        <tr>
            <th><% $c->i18n->p("cross.ui.information", "Information") |h %></th>
            <th><% $c->i18n->p("transformation.root.breeding_programs_folders_tracking_activities", "Breeding Programs -- Folders -- Tracking Activities") |h %>&nbsp;&nbsp;&nbsp;&nbsp;<button class="btn btn-sm btn-default" id="refresh_activity_jstree_html_trialtree_button" name="refresh_activity_jstree_html"><% $c->i18n->p("cross.ui.refresh", "Refresh") |h %></button></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                <h4><% $c->i18n->p("global.search.advanced_search.search", "Search") |h %></h4>
                <input type="text" class="form-control input-sm" id="activity_tree_search" placeholder="<% $c->i18n->p("global.search.advanced_search.search", "Search") |h %>" />
                <hr>

                <h5><i><% $c->i18n->p("cross.ui.double_click", "Double click") |h %><br /><% $c->i18n->p("transformation.root.project", "project (") |h %>&nbsp;<span class="glyphicon glyphicon-list-alt text-success"></span>&nbsp;<% $c->i18n->p("transformation.or_folder", ") or folder (") |h %>&nbsp;<span class="glyphicon glyphicon-folder-open text-danger"></span>&nbsp;)<br/><% $c->i18n->p("cross.ui.to_view_detail_page", "to view detail page.") |h %></i></h5>
                <h5><i><% $c->i18n->p("transformation.breeding_programs", "Breeding programs (") |h %>&nbsp;<span class="glyphicon glyphicon-briefcase text-info"></span>&nbsp;)</i></h5>
                <hr>

                <h4><% $c->i18n->p("cross.ui.folders", "Folders") |h %></h4>
                <button class="btn btn-sm btn-default" id="new_folder_dialog_link"><% $c->i18n->p("cross.ui.create_new_folder", "Create new folder") |h %></button><br/><br/>
                <button class="btn btn-sm btn-default" id="open_folder_dialog_link"><% $c->i18n->p("transformation.root.move_tracking_project_s_to_folder", "Move tracking project(s) to folder") |h %></button><br/><br/>
                <button class="btn btn-sm btn-default" id="move_folder_dialog_link"><% $c->i18n->p("cross.ui.move_folder", "Move folder") |h %></button>

                <div id="folder_edit_options" style="display:none">
                    <hr>
                    <h5><i><% $c->i18n->p("cross.ui.select_multiple_folders_by_holding_ctrl", "Select multiple folders by holding 'Ctrl'.") |h %></i></h5>
                    <button class="btn btn-primary" id="edit_folders_button" title="<% $c->i18n->p("cross.ui.first_select_folder_s_to_edit", "First Select Folder(s) to Edit") |h %>"><% $c->i18n->p("cross.ui.edit_folder_s", "Edit Folder(s)") |h %></button>
                    <br/>
                </div>

                <!--<button id="delete" disabled="disabled" >Delete</button -->
                <br />
            </td>
            <td>
                <div id="activities_list" ><% $c->i18n->p("global.page.form.loading", "[loading...]") |h %></div>
            </td>
        </tr>
    </tbody>
</table>


<script>

jQuery.noConflict();

jQuery(document).ready(function($) {

    jQuery('#create_activity_project_link').click(function() {
        var lo = new CXGN.List();
        get_select_box('years', 'activity_project_year', {'id':'activity_project_year_select', 'name':'activity_project_year_select', 'auto_generate':1});
        jQuery("#create_activity_project_dialog").modal("show");
    });


    jQuery.ajax( {
      url: '/ajax/breeders/get_trials_with_folders_cached?type=activity',
      success: function(response) {
        var html = '<ul>'+response.html+'</ul>';

        jQuery('#activities_list').html(html);
        //console.log(html);
        jQuery('#activities_list').jstree( {
            "core": { 'themes': { 'name': 'proton', 'responsive': true}},
            "valid_children" : [ "folder", "trial", "breeding_program" ],
            "types" : {
                "breeding_program" : {
                    "icon": 'glyphicon glyphicon-briefcase text-info',
                },
                "folder" : {
                    "icon": 'glyphicon glyphicon-folder-open text-danger',
                },
                "activity" : {
                    "icon": 'glyphicon glyphicon-list-alt text-success',
                }
            },
            "search" : {
                 "case_insensitive" : true,
             },
          "plugins" : ["html_data","types","search"],

        });

      },
      error: function(response) {
        alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.ui.an_error_occurred_while_loading_the_trial_data", "An error occurred while loading the trial data.") : "An error occurred while loading the trial data."));
      }
  });

    jQuery("#activity_tree_search").keyup(function() {
        var v = jQuery("#activity_tree_search").val();
        jQuery("#activities_list").jstree(true).search(v);
    });

    jQuery('#activities_list').on("changed.jstree", function (e, data) {
        //console.log(data);
        if ($('#trial_list').jstree('is_leaf', data.node) && data.node.data.jstree.type == 'folder') {
            jQuery("#folder_edit_options").show();
        }
        else {
            jQuery("#folder_edit_options").hide();
        }
    });

    jQuery("#activities_list").delegate("li", "dblclick", function(event){
        var node = $("#activities_list").jstree("get_node", this);
        //console.log(node);
        if (node.id.substr(0,1) !== 'j') {
            if (node.type == 'folder') {
                window.open('/folder/'+node.id);
                event.stopPropagation();
            } else if (node.type == 'activity') {
                window.open('/breeders_toolbox/trial/'+node.id);
                event.stopPropagation();
            }
        }
    });

});

</script>

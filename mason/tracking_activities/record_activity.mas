<%args>

$identifier_id => undef
$activity_select => undef
$type_select_options => undef
$timestamp => undef
$date => undef
$activity_headers => undef
$material_stock_id => undef
$material_name => undef
$material_type => undef
$project_id => undef
$activity_type => undef
$program_name => undef
$source_info => undef
$can_obsolete => undef
$vector_id => undef

</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery/dataTables', 'CXGN.BreedersToolbox.HTMLSelect.js', 'CXGN.List', 'flatpickr_min'] &>

<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("transformation.root.record_activity", "Record Activity")) &>

<div class="well ">
    <center><label class="col-sm-12 control-label"><% $c->i18n->p("transformation.root.please_scan_a_tracking_identifier_barcode", "Please scan a tracking identifier barcode") |h %></label></center>
    <br/>
    <form class="form-horizontal" >
    <br/>
        <div class="form-group">
            <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.identifier_name", "Identifier Name:") |h %> </label>
            <div class="col-sm-5">
                <input class="form-control" id="record_page_identifier_name_input" name="record_page_identifier_name_input" type="text" value="">
            </div>
            <div class="col-sm-2">
                <button id="identifier_name_barcode" class="btn btn-block btn-default"><span class="glyphicon glyphicon-qrcode"></span> <% $c->i18n->p("transformation.root.scan_barcode", "Scan Barcode") |h %></button>
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.material_name", "Material Name:") |h %> </label>
            <div class="col-sm-5" >
                <input class="form-control" name="record_page_material_name" id="record_page_material_name" disabled value="<% $material_name %>">
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.input_type", "Input Type:") |h %> </label>
            <div class="col-sm-5">
% if ($type_select_options) {
                <select id="record_page_type_select">
                    <option value=""><% $c->i18n->p("seedlot.please_select_a_type", "Please select a type") |h %></option>
% foreach my $type(@$type_select_options){
                    <option value="<%$type->[0]%>"><%$type->[1]%></option>
% }
                </select>
% }
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.input", "Input:") |h %> </label>
            <div class="col-sm-5">
                <input class="form-control" id="record_page_info_input" name="record_page_info_input" type="text" value="">
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-3 control-label"><% $c->i18n->p("seedlots.ui.notes", "Notes:") |h %></label>
            <div class="col-sm-5">
                <textarea class="form-control" id="record_page_notes" name="record_page_notes" ></textarea>
            </div>
        </div>
        <div class="form-group" style="display:none">
            <label class="col-sm-3 control-label"><% $c->i18n->p("lists_datasets.download.timestamp", "Timestamp:") |h %> </label>
            <div class="col-sm-5">
                <input class="form-control" id="record_timestamp_record_page" name="record_timestamp_record_page" type="text" disabled value="<%$timestamp%>">
            </div>
        </div>
        <center>
            <button id="record_page_activity_info_submit" name="record_page_activity_info_submit" class="btn btn-primary"><% $c->i18n->p("account.quick_create.save", "Save") |h %></button>
        </center>
    </form>
</div>


% if ($identifier_id) {
    <td>
        <a href='/breeders/trial/<%$project_id%>'><p><% $c->i18n->p("transformation.root.go_to_project_page", "Go to Project Page") |h %></p></a>
    </td>

    <&| /page/info_section.mas, anchor_title => 'Summary', title => HTML::Entities::encode_entities($c->i18n->p("global.family.summary", 'Summary')), collapsible => 1, collapsed => 0, subtitle => '' &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "record_page_activity_info_table" class="table table-hover table-striped">
                            <thead>
                                <tr>
% foreach my $header(@$activity_headers){
                                    <th><%$header%></th>
%}
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, anchor_title => 'Activity Details', title => HTML::Entities::encode_entities($c->i18n->p("transformation.root.activity_details", 'Activity Details')), collapsible => 1, collapsed => 0, subtitle => '' &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "record_page_activity_details_table" class="table table-hover table-striped">
                            <thead>
                                <tr>
% foreach my $header(@$activity_headers){
                                    <th><%$header%></th>
%}
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

% if ($identifier_id && ($material_type eq 'transformation')) {
    <& /transformation/transformants_section.mas, transformation_id => $material_stock_id, program_name => $program_name, can_obsolete => $can_obsolete, vector_id => $vector_id &>
    <& /transformation/obsoleted_transformants_section.mas, transformation_id => $material_stock_id &>
% }

<div class="modal fade" id="record_page_saved_dialog_message" name="record_page_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="recordPageSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="recordPageSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("transformation.root.new_information_was_saved", "New information was saved.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="record_page_dismiss_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

$(window).ready( function() {

    const identifier_id = "<%$identifier_id%>";

    if (identifier_id) {
        jQuery('#record_page_activity_info_table').DataTable({
            'autoWidth': false,
            'searching' : false,
            'dom': 'rtip',
            'ordering': false,
            'paging': false,
            'info': false,
            'ajax': '/ajax/tracking_activity/summary/'+identifier_id,
        });

        jQuery('#record_page_activity_details_table').DataTable({
            'autoWidth': false,
            'searching' : false,
            'ajax': '/ajax/tracking_activity/details/'+identifier_id,
        });

    }

    parseArgs();
    jQuery('#identifier_name_barcode').click(scanBarcode);

    function scanBarcode() {
        window.location = "/barcode/read?return=/activity/record&param=identifier_name";
        return false;
    }

    function parseArgs() {
        const urlSearchParams = new URLSearchParams(window.location.search);
        if ( urlSearchParams.has('identifier_name') ) {
            let identifier_name = decodeURIComponent(urlSearchParams.get('identifier_name'));
            jQuery('input[name="record_page_identifier_name_input"]').val(identifier_name);
        }
    }

    jQuery('#record_page_type_select').change(function() {
        jQuery('#record_page_info_input').val('');
        let input_type = jQuery('#record_page_type_select').val();
        if (input_type.indexOf('date') != -1) {
            flatpickr('#record_page_info_input', {
                allowInput: true,
                dateFormat: "Y-m-d",
                defaultDate: "today"
            });
        }
    });

    jQuery('#record_page_activity_info_submit').click( function(e) {
        e.preventDefault();

        var identifier_name = jQuery('#record_page_identifier_name_input').val();
        var selected_type = jQuery('#record_page_type_select').val();
        var input = jQuery('#record_page_info_input').val();
        var record_timestamp = jQuery('#record_timestamp_record_page').val();
        var notes = jQuery('#record_page_notes').val();
        var activity_type = "<%$activity_type%>";
        var program_name = "<%$program_name%>";

        if (identifier_name == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.please_scan_an_identifier_name_barcode", "Please scan an identifier name barcode") : "Please scan an identifier name barcode"));
            return;
        }

        if (selected_type == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.please_select_a_type", "Please select a type") : "Please select a type"));
            return;
        }
        if (input == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.please_provide_an_input", "Please provide an input") : "Please provide an input"));
            return;
        }

        new jQuery.ajax({
            url: '/ajax/tracking_activity/save',
            dataType: "json",
            type: 'POST',
            data : {
                'tracking_identifier_name': identifier_name,
                'tracking_identifier_id': identifier_id,
                'selected_type': selected_type,
                'input': input,
                'record_timestamp': record_timestamp,
                'notes': notes,
                'activity_type': activity_type,
                'program_name': program_name,
                'source_info': '<%$source_info%>'
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#record_page_saved_dialog_message').modal("show");
                }
                if (response.error) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.an_error_occurred_saving_new_information", "An error occurred saving new information") : 'An error occurred saving new information'));
            }
        });
    });

    jQuery("#record_page_dismiss_saved_dialog").click(function(){
        jQuery('input[name="record_page_identifier_name_input"]').val('');
        jQuery('#record_page_type_select').val('');
        jQuery('#record_page_info_input').val('');
        jQuery('#record_page_notes').val('');
        location.reload();
    });

});

</script>

<%once>
use HTML::Entities ();
</%once>

<%once>
use HTML::Entities ();
</%once>

<%args>

$pop
$guideline
$referer
$userid
$heatmap_file => ''
$corre_table_file => ''
$traits_list
$trait_acronym_pairs
$owner_page
$show_data
$phenotype_download
$genotype_download
$corre_download
$acronym_download
$genetic_map

</%args>

<%perl>

my $title = $pop->get_name();
my $submit_new = (qq | <a href="/qtl/form">| . HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.submit_qtl_population", "Submit QTL population")) . qq |</a> |);

</%perl>

<& /page/page_title.mas, 
   title => $title
&>

<&| /page/info_section.mas, anchor_title => "Population summary",
  collapsible => 1, 
  collapsed   => 0, 
  title       => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.population_summary", "Population summary")),
  subtitle    => $submit_new
  &>
 
  <& summary.mas,
     pop        => $pop,
     owner_page => $owner_page,
  &>

</&>

% if ($show_data) 
%{
  <&| /page/info_section.mas, anchor_title => "Set statistical parameters",
    collapsible => 1, 
    collapsed   => 0, 
    title       => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.set_statistical_parameters", "Set statistical parameters"))
  &>   
  <& stat_tools.mas, 
    pop_id     => $pop->get_population_id(), 
    guideline  => $guideline, 
    referer    => $referer, 
    userid     => $userid
 &>
 </&>

 <& traits_list.mas, 
   traits_list => $traits_list 
 &>

 <& correlation.mas, 
   pop                 => $pop, 
   trait_acronym_pairs => $trait_acronym_pairs
 &>

<& genetic_map.mas, 
   genetic_map => $genetic_map
&>

<& download.mas, 
   phenotype_download => $phenotype_download,
   genotype_download  => $genotype_download,
   corre_download     => $corre_download,
   acronym_download   => $acronym_download,
&>

<&| /page/info_section.mas, anchor_title => "Trait acronyms",
    collapsible => 1, 
    collapsed   => 1, 
    title       => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.trait_acronyms", "Trait acronyms"))
  &>   
 
  <& /page/columnar_table.mas,
     headings     => [("" . HTML::Entities::encode_entities($c->i18n->p("phenotype.root.trait_name.4f3e5b7", "Trait name")) . ""), ("" . HTML::Entities::encode_entities($c->i18n->p("accession.population_cgi.acronym", "Acronym")) . "")],
     data         => $trait_acronym_pairs,
     __alt_freq   => 2,
     __alt_width  => 1,
     __alt_offset => 3,
     __align      => 'l'
    &>

</&>

%}
% else
%{
 <& data_access.mas, 
    pop        => $pop, 
    owner_page => $owner_page
 &>
%}

<%once>
use HTML::Entities ();
</%once>

<%doc>

=head1 NAME 
qtl/population/stat_form.mas - a mason component for displaying qtl population symmary data.

=AUTHOR
Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$pop
$owner_page

</%args>


<table>
  <tr>
    <td>
      <& /page/columnar_table.mas,
         data         => [[HTML::Entities::encode_entities($c->i18n->p("global.library_search.name", "Name")), $pop->get_name],
                          [HTML::Entities::encode_entities($c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description")), $pop->get_description],
                          [HTML::Entities::encode_entities($c->i18n->p("global.search.datasets.owner", "Owner")), $owner_page],
                         ],
         __alt_freq   => 0,
         __align      => "l",
         __tableattrs => 'style="padding: 1px 225px 1px 1px"',   
        &>
    </td>    
    <td>
      <& /page/columnar_table.mas,        
         data       => [[HTML::Entities::encode_entities($c->i18n->p("accession.population_cgi.lines", "No. of lines")), scalar $pop->get_individuals],
                        [HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.no_of_traits", "No. of traits")), scalar $pop->get_cvterms],
                       ],
        __alt_freq  => 1,
        __align     => "l",
       __tableattrs => 'style="padding: 1px"',    
        &>
    </td>
  </tr>
</table>
    

 



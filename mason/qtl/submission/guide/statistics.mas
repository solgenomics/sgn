<%doc>

=head1 NAME 

statistics.mas - a display for qtl data submission guidelines - statistics section.

=AUTHOR

Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<&| /page/info_section.mas, 
   title      => HTML::Entities::encode_entities($c->i18n->p("help.qtl.statistics_heading", "Step 5: Statistical parameters")),
  collapsible => 1,
  collapsed   => 1
, anchor_title => "Step 5: Statistical parameters" &>


<% $c->i18n->p("help.qtl.statistics_intro", "The qtl analysis uses R/QTL package and implements an interval mapping with the following parameters. ") |h %><br/>

<ul>
  <li>
    <strong><% $c->i18n->p("help.qtl.statistics.model", "QTL model:") |h %></strong><% $c->i18n->p("help.qtl.statistics.model_text", " Select the one dimension single QTL genome scan") |h %>&nbsp;<% $c->i18n->p("help.qtl.statistics.model_development", " (the two-dimension two genome QTL scan is under development)") |h %>
  </li>
  <li>
    <strong><% $c->i18n->p("help.qtl.statistics.mapping_method", "QTL mapping method:") |h %></strong><% $c->i18n->p("help.qtl.statistics.mapping_select", " You can select") |h %>&nbsp; 'Single Marker Analysis'&nbsp;<% $c->i18n->p("help.qtl.statistics.or", " or ") |h %>'Maximum Likelihood'<% $c->i18n->p("help.qtl.statistics.mapping_standard", " for standard interval mapping or for an approximation of it ") |h %>'Haley-Knot Regression'<% $c->i18n->p("help.qtl.statistics.or", " or ") |h %>'Multiple Imputation'.<% $c->i18n->p("help.qtl.statistics.mapping_imputation_intro", " Use ") |h %>'Multiple Imputation'<% $c->i18n->p("help.qtl.statistics.mapping_imputation_tail", " only if you want to estimate the QTL genotype based on random imputation.") |h %>
  </li>
  <li>
    <strong><% $c->i18n->p("help.qtl.statistics.probability_method", "QTL genotype probability method:") |h %></strong><% $c->i18n->p("help.qtl.statistics.probability_text", " Select 'Calculate' if you want the QTL genotype to be estimated based the observed marker data. This method must be selected if you selected 'Maximum Likelihood' or 'Haley-Knot Regression'. If you selected 'Multiple Imputation' then choose the 'Simulate' method.") |h %>
  </li>
  <li>
    <strong><% $c->i18n->p("help.qtl.statistics.significance", "Genotype probability significance level:") |h %></strong><% $c->i18n->p("help.qtl.statistics.significance_text", " select the genotyping error rate you want to allow.") |h %>
  </li>
  <li>
    <strong><% $c->i18n->p("help.qtl.statistics.scan_size", "Genome scan size (cM):") |h %></strong><% $c->i18n->p("help.qtl.statistics.scan_size_text", " select the genome size (interval) you want the QTL genotype probabilities to be calculated.") |h %>
  </li>
  <li>
    <strong><% $c->i18n->p("help.qtl.statistics.imputations", "No. of imputations:") |h %></strong><% $c->i18n->p("help.qtl.statistics.imputations_text", " applicable only for 'Multiple Imputation' mapping method and 'Simulate' QTL genotype probability method.") |h %>
  </li>
  <li>
    <strong><% $c->i18n->p("help.qtl.statistics.permutations", "No. of permutations and significance level:") |h %></strong><% $c->i18n->p("help.qtl.statistics.permutations_text", " select the number of permutations to perform and the error rate for the calculation of the LOD threshold.") |h %>
  </li>
</ul>

</&>

<%once>
use HTML::Entities ();
</%once>

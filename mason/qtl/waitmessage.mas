</%doc> 
 
<div id    ="waitmsg" 
       style ="display:none; 
              color:#f87431; 
              font-weight: bold; 
              font-style:italic; 
              background-color:#fff;
              width:200px;
              word-wrap:break-word;
              ">   
    <pre><% $c->i18n->p("analysis.qtl.ui.solqtl_is_running_please_wait_this_may_take_a_few", "solQTL is running ..... \n                Please wait ..... \n                       This may take \n                            a few minutes.\n    ") |h %></pre>
  </div>      

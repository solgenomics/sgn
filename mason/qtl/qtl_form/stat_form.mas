<%once>
use HTML::Entities ();
</%once>

<%doc>

=head1 NAME 
qtl/qtl_form/stat_form.mas - a mason component for a QTL stat parameters 
submission

=AUTHOR
Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$pop_id
$guide
$referer

</%args>

<%perl>

use CXGN::Page::FormattingHelpers qw | tooltipped_text |;

my $no_draws = tooltipped_text($c->i18n->p("analysis.qtl.ui.no_of_imputations", "No. of imputations:"), $c->i18n->p("analysis.qtl.ui.required_only_if_the_simulate_method_is_selected_for_the", "required only if the \n                                Simulate method is selected for the \n                                calculation of QTL genotype probability \n                                method and Multiple Imputation"));
my $permu_level = tooltipped_text($c->i18n->p("analysis.qtl.ui.significance_level_of_permutation_test", "Significance level of permutation test:"),
                                  $c->i18n->p("analysis.qtl.ui.required_only_if_permutation_analysis_lod_threshold_is_run", "required only if permutation analysis \n                                  (LOD threshold) is run"));
my $genome_scan = tooltipped_text($c->i18n->p("analysis.qtl.ui.genome_scan_size_cm", "Genome scan size (cM):"), $c->i18n->p("analysis.qtl.ui.not_required_for_marker_regression", "not required for \n                                   Marker Regression"));
my $qtl_prob = tooltipped_text($c->i18n->p("analysis.qtl.ui.qtl_genotype_probablity_method", "QTL genotype probability method:"),
                               $c->i18n->p("analysis.qtl.ui.not_required_for_marker_regression_55357a", "not required for Marker Regression"));

</%perl>


% if ( $referer =~ /qtl\/form\/stat_form/) 
%{
<& /page/page_title.mas, 
   title => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.step_5_submit_statistical_parameters", "Step 5: Submit Statistical Parameters"))
&>
<& /page/info_section.mas, anchor_title => "Statistical Parameters",
   title => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.statistical_parameters_2710f5", "Statistical Parameters")),
   subtitle => $guide 
&> 
%}

  <form action="/phenome/qtl_load.pl" method="POST" enctype="MULTIPART/FORM-DATA">  
    <table cellspacing=20>
      <tr>
        <td><% $c->i18n->p("analysis.qtl.ui.qtl_model", "QTL model:") |h %><% ' ' %>
        </td>
	<td>
          <select name="stat_qtl_model">
	    <option>
            <option>Single-QTL Scan	    
          </select>
	</td>
        <td><% $c->i18n->p("analysis.qtl.ui.qtl_mapping_method", "QTL mapping method:") |h %></td>
	<td>
          <select name="stat_qtl_method">	         
	    <option>
            <option>Marker Regression
            <option>Maximum Likelihood 
	    <option>Haley-Knott Regression
            <option>Multiple Imputation
	  </select>
	</td>
      </tr>
      <tr>
        <td><% $qtl_prob %>
        </td>
        <td>
          <select name="stat_prob_method">
            <option>
	    <option>Calculate
            <option>Simulate
	  </select>
	</td>
        <td><% $c->i18n->p("analysis.qtl.ui.qtl_genotype_probability_significance_level", "QTL genotype probability significance level:") |h %>
        </td>
        <td>
          <select name="stat_prob_level">
	    <option>
            <option>0.001
            <option>0.05
	    <option>0.1		    
	  </select>	
        </td>
      </tr>
      <tr>
        <td><% $genome_scan %>
        </td>
        <td>
          <select name="stat_step_size">
            <option>
	    <option>zero
	    <option>1
            <option>2.5
	    <option>5
	    <option>10
	  </select>
	</td>    
        <td><% $no_draws %>
        </td>
	<td>
          <select name="stat_no_draws">
	    <option>
	    <option>5
            <option>10
	    <option>15
	    <option>20
	  </select>	
        </td>       
      </tr>
      <tr>
        <td><% $c->i18n->p("analysis.qtl.ui.no_of_permutations", "No. of permutations:") |h %>
        </td>
        <td>
          <select name="stat_permu_test">
	    <option>
            <option>None
            <option>100
	    <option>1000		    
	  </select>
        </td>
        <td><% $permu_level %>
        </td>
        <td> 
          <select name="stat_permu_level">
	    <option>
            <option>0.05
            <option>0.001
	    <option>0.1		    
	  </select>
        </td>
      </tr>
      <tr>      
        <td> 
          <input type="hidden" name="type" value="stat_form">
        </td>  
        <td> 
          <input type="hidden" name="pop_id" value = <% $pop_id %> >
        </td>
      </tr>
      <tr>      
        <td>
        </td>
        <td>
          <input type="submit" value="<% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %>"><% ' ' %>
        </td>
        <td>
        </td> 
        <td> 
          <input type="reset"  value="<% $c->i18n->p("auth.registration.reset", "Reset") |h %>">
        </td>      
      </tr>
    </table>
  </form>


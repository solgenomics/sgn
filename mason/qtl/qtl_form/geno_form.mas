<%once>
use HTML::Entities ();
</%once>

<%doc>

=head1 NAME 
qtl/qtl_form/geno_form.mas - a mason component for a genotype data file submission

=AUTHOR
Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$pop_id
$guide

</%args>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.step_4_submit_genotype_data", "Step 4: Submit Genotype Data")) &>
<&| /page/info_section.mas, anchor_title => "Genotype Dataset", title => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.genotype_dataset", "Genotype Dataset")), subtitle => $guide &>

<form action="/phenome/qtl_load.pl" method="POST" enctype="MULTIPART/FORM-DATA">         
     <table cellspacing=20>
      <tr>
        <td> <% $c->i18n->p("analysis.qtl.ui.genotype_dataset_a98c9c", "Genotype Dataset:") |h %> </td>
	<td> <input type="file" name="geno_file" size=40>
	<td> <input type="hidden" name="type" value="geno_form"> </td>
	<td> <input type="hidden" name="pop_id" value=<% $pop_id %> > </td>  
	<td> <input type="submit" value="<% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %>"> </td>
     </tr>  
    </table>
</form>
</&>

<%once>
use HTML::Entities ();
</%once>

<%doc>

=head1 NAME 
qtl/qtl_form/trait_form.mas - a mason component for a traits file submission

=AUTHOR
Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$pop_id
$guide

</%args>
<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.step_2_submit_trait_data", "Step 2: Submit Trait Data")) &>
<&| /page/info_section.mas, anchor_title => "Trait Dataset", title => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.trait_dataset", "Trait Dataset")), subtitle => $guide  &>
<form action="/phenome/qtl_load.pl" method="POST" enctype="MULTIPART/FORM-DATA">         
     <table cellspacing=20>
     <tr>
       <td><% $c->i18n->p("analysis.qtl.ui.trait_dataset_11aa15", "Trait dataset:") |h %></td>
       <td><input type="file" name="trait_file" size=40>
       <td> <input type="hidden" name="type" value="trait_form"></td>
       <td> <input type="hidden" name="pop_id" value = <% $pop_id %> ></td>
       <td><input type="submit" value="<% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %>"> </td>
     </tr>            
     </table>
     </form>
</&>

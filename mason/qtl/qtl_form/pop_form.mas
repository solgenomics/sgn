<%once>
use HTML::Entities ();
</%once>

<%doc>

=head1 NAME 
qtl/qtl_form/pop_form.mas - a mason component for the qtl pop detail webform

=AUTHOR
Isaak Y Tecle (iyt2@cornell.edu)

=cut

</%doc>

<%args>

$guide

</%args>

<%perl>

use CXGN::Phenome::Qtl::Tools;
use CXGN::Page::FormattingHelpers qw | tooltipped_text |;

my $organism = (qq | <a href="javascript:Qtl.toggleAssociateTaxon()">| . HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.select_organism", "[Select Organism]")) . qq |</a> |);
my $required = qq | <font color="red"><sup>*</sup></font>|;
my $qtltools = CXGN::Phenome::Qtl::Tools->new();
   
my %cross_types =  $qtltools->cross_types();
my $cross_options;
foreach my $key (keys %cross_types) {    
	$cross_options .= qq |<option value="$key">$cross_types{$key} |;	     
    }

my $parent_m = tooltipped_text($c->i18n->p("analysis.qtl.ui.male_parent", "Male parent"), ($c->i18n->p("analysis.qtl.ui.format_eg", "format eg.") . " Solanum lycopersicum cv moneymaker"));
my $parent_f = tooltipped_text($c->i18n->p("analysis.qtl.ui.female_parent", "Female parent"), ($c->i18n->p("analysis.qtl.ui.format_eg", "format eg.") . " Solanum lycopersicum cv micro tom"));

</%perl>

<& /util/import_javascript.mas, classes => [ "CXGN.Phenome.Qtl" ] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.step_1_submit_qtl_population_details", "Step 1: Submit QTL Population Details")) &>
<&| /page/info_section.mas, title => $organism, subtitle => $guide &> 
<& organism_form.mas &>
</&>

<&| /page/info_section.mas, anchor_title => "Population Details",
  title => HTML::Entities::encode_entities($c->i18n->p("accession.population_cgi.details", "Population Details")),
&>
<% $required %> <span><i><% $c->i18n->p("analysis.qtl.ui.must_be_filled", "must be filled.") |h %></i><br/><br/></span>
<form action="/phenome/qtl_load.pl" method="POST" enctype="MULTIPART/FORM-DATA">        
     <table>
     <tr>
       <td><% $c->i18n->p("accession.related_stock.header.cross_type", "Cross type") |h %><% $required %></td>
	 <td> <select name="pop_type">
	          <% $cross_options %>
             </select>
         </td>
     </tr>
     <tr>
	<td><% $c->i18n->p("phenotype.population_name", "Population name") |h %><% $required %></td>
	<td><input type="text" name="pop_name" size=42></td>    
     </tr>
     <tr>
         <td><% $c->i18n->p("phenotype.population_description", "Population description") |h %><% $required %></td>
         <td><textarea name="pop_desc" rows = 5 cols=44></textarea></td>
     </tr>  
     <tr>
	<td><% $parent_f%><%$required %> </td>
	<td><input type="text" name="pop_female_parent" size=24></td>
	<td><% $parent_m %><% $required %> </td> 
	<td><input type="text" name="pop_male_parent" size=24></td> 
     </tr>
     <tr>
	<td><% $c->i18n->p("analysis.qtl.ui.recurrent_parent", "Recurrent parent") |h %></td>
	<td><input type="text" name="pop_recurrent_parent" size=24></td>
	<td><% $c->i18n->p("analysis.qtl.ui.donor_parent", "Donor parent") |h %></td>
	<td><input type="text" name="pop_donor_parent" size=24></td> 	 	 
     </tr> 
     <tr>
      <td><% $c->i18n->p("analysis.qtl.ui.do_you_want_to_make_the_data_public", "Do you want to make the data public?") |h %></td>
      <td><input type="radio" name="pop_is_public" value="true" checked /><% $c->i18n->p("global.search_wizard.yes", "Yes") |h %></td><% '      ' %>
      <td><input type="radio" name="pop_is_public" value="false" /><% $c->i18n->p("global.search_wizard.no", "No") |h %></td><% ' ' %>
     </tr> 
     <tr>
       <td>&nbsp;</td><td>&nbsp;</td>
       <td><input type="hidden" name="type" value="pop_form"></td>
       <td><input type="submit" value="<% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %>"></td><% '      ' %>
     </tr>
     </table>
     </form>

</&>

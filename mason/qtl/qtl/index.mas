<%once>
use HTML::Entities ();
</%once>

<%doc>

=head1 NAME 
index.mas - a mason component for a qtl detail page
=AUTHOR
Isaak Y Tecle (iyt2@cornell.edu)
=cut

</%doc>

<%args>

$qtl_image
$pop_name
$trait_name
$cmv_link
$markers
$marker_link
$genetic_map
$legend
$download
$comment

</%args>

<%perl>

$qtl_image = (qq |<img src="$qtl_image" width=320 height=320 alt="| . HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.qtl_for", "QTL for ")) . qq |$trait_name"> |);

</%perl>



<& /page/page_title.mas, 
   title => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.qtl_for_trait_in_population", "QTL for %{trait} in %{population}", {trait => "" . ($trait_name // ""), population => "" . ($pop_name // "")}))
&>
<&| /page/info_section.mas, anchor_title => "QTL map for $trait_name",
    title => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.qtl_map_for_trait", "QTL map for %{trait}", {trait => "" . ($trait_name // "")}))
&>
  <table cellpadding=20>
    <tr>
       <td>
          <%$qtl_image%>
       </td>
       <td>
	 <& /page/columnar_table.mas, 
	    headings=>["", ""], 
	    data=>$legend,  
	    __alt_freq   =>2, 
            __alt_width  => 1, 
	    __alt_offset => 3, 
            __align=> 'l'
        &>
     </td>
   </tr>
  </table>
</&>

<&| /page/info_section.mas, anchor_title => "QTL 95% Confidence Interval",
    collapsible => 1, 
    collapsed   => 1, 
    title       => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.qtl_95_confidence_interval", "QTL 95% Confidence Interval"))
&>  

<& /page/columnar_table.mas,
     headings    => [HTML::Entities::encode_entities($c->i18n->p("genotype.marker.marker", "Marker")), (" " . HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.position_cm", "Position (cM)")) . ""), "LOD", ("" . HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.remark", "Remark")) . "")],
    data         => $marker_link,
    __alt_freq   => 2,
    __alt_width  => 1,
    __alt_offset => 3,
    __align      => 'l'
    &>
</&>

<&| /page/info_section.mas, anchor_title => "QTL markers' genetic positions and Comparative Map Viewer",
    collapsible => 1, 
    collapsed   => 1, 
    title       => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.qtl_markers_genetic_positions_and_comparative_map_viewer", "QTL markers' genetic positions and Comparative Map Viewer"))
 &>

<% $cmv_link %>

</&>
<& genome_positions.mas,
   markers => $markers 
&>
<&| /page/info_section.mas, anchor_title => "Browse QTL region",
    collapsible => 1, 
    collapsed   => 1, 
    title       => HTML::Entities::encode_entities($c->i18n->p("analysis.qtl.ui.browse_qtl_region", "Browse QTL region"))
&>

<% $download %>

</&>


<& /qtl/population/genetic_map.mas, 
   genetic_map => $genetic_map
&>

<% $comment %>

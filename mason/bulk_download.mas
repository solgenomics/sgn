<%args>
    $content => ''
    $sha1
    $bulk_js_menu
    $bulk_download_stats
    $bulk_download_success
</%args>
<% $bulk_js_menu %>
<h1><% $c->i18n->p("lists_datasets.bulk.feature_download_summary", "Feature Download Summary") |h %></h1>

% if($bulk_download_success) {
    <% $c->i18n->p("lists_datasets.bulk.your_query_was_successful", "Your query was successful.") |h %><br>
<div id="bulk_download_stats">
<% $bulk_download_stats %>
</div>
<% $c->i18n->p("lists_datasets.bulk.download_as", "Download as") |h %> <a href="/bulk/feature/download/<% $sha1 %>.fasta">Fasta</a>
% } else {
    <% $c->i18n->p("lists_datasets.bulk.your_query_did_not_contain_any_valid_identifiers_please_try_again", "Your query did not contain any valid identifiers. Please try again.") |h %>
% }

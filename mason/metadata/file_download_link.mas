<%args>
  $file
</%args>
% my $stat = $file->stat;
% if( $stat ) {
<a href="/metadata/file/<% $file->file_id |u %>/download">
   <% $file->basename |h %> (<% Number::Bytes::Human::format_bytes( $stat->size ) %>b)
</a>
% } else {
<span class="ghosted" style="cursor: pointer" title="<% $c->i18n->p('metadata.file.unavailable_title', 'file temporarily unavailable') |h %>"><% $file->basename |h %> <% $c->i18n->p('metadata.file.unavailable_caption', '(temporarily unavailable)') |h %></span>\
%}
<%once>
  use Number::Bytes::Human;
</%once>

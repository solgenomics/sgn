
<%args>
$image_id
$size => "large"
$dbh
</%args>

<%perl>

  my $url = "";
  eval { 
    my $image = SGN::Image->new( $dbh, $image_id );
    $url = $image->get_image_url($size);
};
if ($@) { 
    print $c->i18n->p("community.image.sorry_could_not_get_image_image_id", "Sorry. Could not get image # %{image_id}\n", { image_id => $image_id });
}
</%perl>

<img src="<% $url %>" />




   
    

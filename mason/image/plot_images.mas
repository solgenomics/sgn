
<%args>
$trial_id
$stockref => undef
</%args>

<style>
#plot_images_results {
    width: 100% !important;
}
</style>

<& /util/import_javascript.mas, classes => [ 'jquery', 'thickbox', 'jquery.dataTables' ] &>


<div class="well well-sm table-responsive">
    <h4 style="margin-top:0;">Image collections for this trial</h4>
    <div id="trial_collections_loading" class="text-muted" style="padding:5px;">
        <span class="glyphicon glyphicon-refresh"></span> Loading collections&hellip;
    </div>
    <div id="trial_collections_empty" class="text-muted" style="display:none; padding:5px;">
        No collections contain images from this trial yet. To add images to a
        collection, select them in <a href="/search/images">image search</a> and use
        <b>Add selected to collection</b>.
    </div>
    <table class="table table-hover table-condensed" id="trial_collections_table"
           style="width:100%; display:none;">
        <thead>
          <tr>
            <th>Collection</th>
            <th>Type</th>
            <th>Owner</th>
            <th>Trial Images</th>
            <th>Created</th>
          </tr>
        </thead>
        <tbody></tbody>
    </table>
    <hr/>
</div>

<div class="well well-sm table-responsive">
    <table id="plot_images_results" class="table table-hover table-striped">
    <thead>
        <tr>
        <th>Image</th>
        <th>File Name/Details</th>
        <th>Description</th>
        <th>Submitter</th>
        <th>Associations</th>
        <th>Accession Name</th>
    </tr>
    </thead>
    </table>
</div>
            

<script>

<%perl>
my $dbh = $stockref->{dbh};
</%perl>

var trial_id = '<% $trial_id %>';
var stockNames = [];

jQuery(document).ready( function() {

    jQuery('#image_download_button').click(function () {
        jQuery.ajax({
            url: '/breeders/download_images',
            type: 'POST',
            data: {'trial_id': trial_id},
            success: function(data) {
                var a = document.createElement('a');
                var url = window.URL.createObjectURL(data);
                a.href = url;
                a.download = 'trial_' + trial_id + '_images.tar.gz';
                document.body.append(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);
            },
            xhrFields: {
                responseType: 'blob'
            },
            error: function(xhr, status, error) {
                console.error("Error:", error);
            }
        });
    });

    jQuery('#trial_images_section_onswitch').click(function() {
        getStocksWithImages();
        loadTrialCollections();
    });

    jQuery('#plot_images_results').on( 'draw.dt', function () {
        jQuery('a.image_search_group').colorbox();
    });
});

function loadTrialCollections() {
    jQuery('#trial_collections_loading').show();
    jQuery('#trial_collections_table').hide();
    jQuery('#trial_collections_empty').hide();

    jQuery.ajax({
        method: 'GET',
        url: '/ajax/collection/for_trial',
        data: { trial_id: trial_id, collection_type: 'image' },
        success: function (response) {
            jQuery('#trial_collections_loading').hide();

            if (response && response.error) {
                jQuery('#trial_collections_empty').text(response.error).show();
                return;
            }

            var collections = (response && response.collections) || [];
            if (!collections.length) {
                jQuery('#trial_collections_empty').show();
                return;
            }

            var $tb = jQuery('#trial_collections_table tbody').empty();
            collections.forEach(function (c) {
                $tb.append(
                    '<tr>' +
                      '<td><a href="/collection/' + esc(c.collection_id) + '">' + esc(c.name) + '</a></td>' +
                      '<td>' + (c.collection_type ? esc(c.collection_type) : '') + '</td>' +
                      '<td>' + (c.username ? esc(c.username) : '') + '</td>' +
                      '<td>' + esc(c.n_trial_images) + '</td>' +
                      '<td>' + (c.create_date ? esc(c.create_date) : '') + '</td>' +
                    '</tr>'
                );
            });
            jQuery('#trial_collections_table').show();
        },
        error: function () {
            jQuery('#trial_collections_loading').hide();
            jQuery('#trial_collections_empty')
                .text('Could not load collections.').show();
        }
    });
}

function esc(s) {
    return jQuery('<div>').text(s == null ? '' : s).html();
}

function getStocksWithImages() {
    jQuery.ajax({
        method: 'GET',
        url: '/ajax/stock/get_stocks_with_images',
        data: {
            'trial_id': trial_id
        },
        beforeSend: function() {
            jQuery("#working_modal").modal("show");
        },
        success: function(response) {
            jQuery("#working_modal").modal("hide");
            var data = response.data;
            if (data.length > 0) {
                stockNames.push(data);
            } else {
                stockNames.push("*");
            }
            _load_stock_image_results();
        },
        error: function(response) {
            alert('Error fetching stock names');
        }
    });
}

function _load_stock_image_results() {
    var stockNamesString = stockNames.join(',');

    stock_images_table = jQuery('#plot_images_results').DataTable({
        'destroy' : true,
        'searching' : true,
        'ordering' : true,
        'processing' : true,
        //'serverSide': true,
        'scrollX': true,
        'lengthMenu': [10,20,50,100,1000,5000],
        'ajax': { 'url': '/ajax/search/images',
            'type': 'POST',
            'data': function(d) {
                d.image_stock_uniquename = stockNamesString;
            },
            'dataSrc': function(json) {
                json.data.forEach(function(row) {
                    var imgElement = jQuery(row[0]).find('img');
                    imgElement.attr('width', '140');
                    var anchorElement = jQuery(row[0]);
                    anchorElement.html(imgElement.prop('outerHTML'));
                    row[0] = anchorElement.prop('outerHTML');
                });
                return json.data;
            }
        },
        'columns': [
            { 'title': 'Image', 
              'data': 0, },
            { 'title': 'File Name/Details', 'data': 1 },
            { 'title': 'Description', 'data': 2 },
            { 'title': 'Submitter', 'data': 3 },
            { 'title': 'Associations', 'data': 4 },
            { 'title': 'Accession Name', 'data': 5 },
        ],
        columnDefs: [
            { "targets": [1,3,4], "type": 'html' },
            { targets: [0], searchable: false }
        ]
    }).on('draw', function() {
        jQuery(".image_search_group").colorbox({rel:'image_search_group'});
    });
}


</script>
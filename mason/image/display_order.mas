
<%args>
$image_id
$type
$id
$display_order
</%args>

<center>
<h4><% $c->i18n->p("community.image.change_display_order_for_image", "Change display order for image") |h %></h4>


<% $c->i18n->p("community.image.display_order", "Display order:") |h %> <input id="display_order" value="<% $display_order %>" >

<br />
<button id="submit_display_order"><% $c->i18n->p("community.image.change", "change") |h %></button>

<script>
  jQuery(window).ready( function() {
  
  
     jQuery('#submit_display_order').click( function() { 
        var display_order = jQuery('#display_order').val();
        jQuery.ajax( { 
           url: '/ajax/image/<% $image_id %>/<% $type %>/<% $id %>/display_order/'+display_order,
           error: function(e) { alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.image.an_error_occurred", "an error occurred") : "an error occurred")); },
           success: function(r) {
             if (r.error) { alert(r.error); return; }
             alert((window.SGN && window.SGN.i18n ? SGN.i18n.p("community.image.successfully_changed_display_order", "Successfully changed display_order") : "Successfully changed display_order"));
           }
        });
     });
  });

</script>


<%args>
@projects => undef
$programs => undef
@file_metadata => ()
$user_id => undef
@layout_files => undef
@trait_files => undef
@phenotype_files => undef
@removed_phenotype_files => undef
@roles => ()
$fieldbook_config_qrcode_url => ""
$project_name => ""
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jqueryui', 'jquery.iframe-post-form','CXGN.List','CXGN.BreedersToolbox.FieldBook', 'CXGN.BreedersToolbox.HTMLSelect'] &>

<%perl>
    use HTML::Entities ();
</%perl>

  <& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p('fieldbook.ui.title', 'Field Book Tools')) &>

    <&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p('fieldbook.brapi.title', 'BrAPI setup')), anchor_title => "BrAPI setup", subtitle => HTML::Entities::encode_entities($c->i18n->p('fieldbook.brapi.subtitle', 'Scan the QRCode with Field Book to configure the app for this database for BrAPI access')) &>

      <div class="container-fluid" style="text-align:center">
	<table>
	  <tr><td width="400" align="center" >
	      <div id="configure_fieldbook_qrcode_div">
		<img src="<% $fieldbook_config_qrcode_url %>" /><br />
		<% $project_name %>
	      </div>
	    </td><td width="60">&nbsp;</td>
	    <td width="400">
	      <div>
	
		<p><% $c->i18n->p('fieldbook.brapi.intro', 'To connect Field Book to this database via BrAPI, from within the Field Book app:') |h %></p>
		<ol>
		  <li><% $c->i18n->p('fieldbook.brapi.settings', 'Go to the Field Book %{settings}', { settings => 'Settings' }) |h %></li>
		  <li><% $c->i18n->p('fieldbook.brapi.open', 'Open the %{brapi} settings', { brapi => 'BrAPI' }) |h %></li>
		  <li><% $c->i18n->p('fieldbook.brapi.enable', 'Make sure %{enable} is checked', { enable => 'Enable BrAPI' }) |h %></li>
		  <li><% $c->i18n->p('fieldbook.brapi.scan_barcode', 'Tap the %{action} option in the toolbar', { action => 'scan barcode' }) |h %> <img style="width: 30px" src="data:image/png;base64," /></li>
		  <li><% $c->i18n->p('fieldbook.brapi.import_settings', 'Choose the %{action} action', { action => 'Import new settings' }) |h %></li>
		  <li><% $c->i18n->p('fieldbook.brapi.scan_code', 'Scan the QR code to the left') |h %></li>
		  <li><% $c->i18n->p('fieldbook.brapi.login', 'This should then direct you to login to the database with your username and password') |h %></li>
		  <li><% $c->i18n->p('fieldbook.brapi.authorize', 'Select %{action} to allow Field Book to use your account', { action => 'Authorize Access' }) |h %></li>
		  <li><% $c->i18n->p('fieldbook.brapi.sources', 'Check to use this database as the default %{import_source} and %{export_source}', { import_source => 'Import Source', export_source => 'Export Source' }) |h %></li>
		</ol>
	      </div>
	</td></tr></table>
      </div>
      
      
  </&>
  
  <div class="container-fluid">
    
    <&| /page/explanation.mas, title=>HTML::Entities::encode_entities($c->i18n->p('fieldbook.layout.title', 'Field Layout Files')), anchor_title=>'Field Layout Files', collapsible=>1, collapsed=>0, &>
      <p>
	<% $c->i18n->p('fieldbook.layout.description', 'Field Book is an app for collecting phenotypic data on field research plots using an android tablet computer.') |h %>
	<br/><br/>
	<a href="https://play.google.com/store/apps/details?id=com.fieldbook.tracker"><% $c->i18n->p('fieldbook.layout.software', 'Field Book Software') |h %></a>
	<br/><br/>
	<% $c->i18n->p('fieldbook.layout.create_files', 'To use Field Book you need a Field Layout File and a Trait File; both can be created on this page.') |h %> <br/><% $c->i18n->p('fieldbook.layout.move_files', 'Once you have created and downloaded your Field Layout and Trait files, move them onto your mobile device into the Field Book directories (generally %{layout_path} for your Field Layout Files and %{trait_path} for your trait files.)', { layout_path => '/fieldbook/import_field/', trait_path => '/fieldbook/traits/' }) |h %>
	<br/><br/>
	<% $c->i18n->p('fieldbook.layout.units', 'By using Field Book with the Field Layout and Trait Files created here, you can be sure that your traits are properly defined and your experimental units, whether they are plots or plants or tissue samples, are also properly defined.') |h %>
      </p>
</&>

</div>

<& /fieldbook/create_fieldbook_dialog.mas &>
  
  <&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('fieldbook.layout.title', 'Field Layout Files')), anchor_title=>'Field Layout Files', empty_message=>'', collapsible=>1, collapsed=>0, subtitle=>'[<a name="create_fieldbook_link">' . HTML::Entities::encode_entities($c->i18n->p('fieldbook.ui.new', 'New')) . '</a>]' &>
    <%perl>
    #my @breeding_programs = @{$programs};
    #foreach my $prog (@breeding_programs) {
    #  print @$prog[0].@$prog[1]."</br>";
    #}
    foreach my $file (@file_metadata) {
    my @trial_array = @{$file};
    my $file_name = $trial_array[1];
    my $trial_layout_download = '[<a href="/fieldbook/trial_download/'.$trial_array[2].'">' . HTML::Entities::encode_entities($c->i18n->p('fieldbook.ui.download_file', 'Download File')) . '</a>]  |   [<a id="delete_fieldbook_layout_link" href="/fieldbook/delete_file/'.$trial_array[2].'">' . HTML::Entities::encode_entities($c->i18n->p('fieldbook.ui.delete_file', 'Delete File')) . '</a>]';
    print $trial_array[1]."$trial_layout_download<br>";
    #print $trial_array[2]."</br>";
    }
</%perl>
</&>

<& /fieldbook/create_trait_file_dialog.mas &>
  
<div id="fieldbook-trait-files-section">
<&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('fieldbook.ui.trait_files', 'Trait Files')), anchor_title=>'Trait Files', empty_message=>'', collapsible=>1, collapsed=>0, subtitle=>'[<a id="create_new_trait_file_link">' . HTML::Entities::encode_entities($c->i18n->p('fieldbook.ui.new', 'New')) . '</a>]' &>
  <%perl>
  foreach my $trait_ref (@trait_files) {
    my @trait_array = @{$trait_ref};
    my $trait_file_name = $trait_array[0];
    my $trait_file_download = '[<a href="/fieldbook/trait_file_download/'.$trait_array[1].'">' . HTML::Entities::encode_entities($c->i18n->p('fieldbook.ui.download_file', 'Download File')) . '</a>] |   [<a id="delete_trait_file_link" href="/fieldbook/delete_file/'.$trait_array[1].'">' . HTML::Entities::encode_entities($c->i18n->p('fieldbook.ui.delete_file', 'Delete File')) . '</a>]';
    print $trait_array[0]."$trait_file_download<br>";
    #print $trial_array[4]."</br>";
  }
  </%perl>
</&>
</div>

<&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('fieldbook.files.uploaded', 'Uploaded Phenotype Files')), anchor_title=>'Uploaded Phenotype Files', collapsible=>1, collapsed=>0, subtitle=>'[<a id="upload_fieldbook_phenotypes_link">' . HTML::Entities::encode_entities($c->i18n->p('fieldbook.files.upload', 'Upload')) . '</a>]' &>
  <%perl>
  if (scalar(@phenotype_files)>0) {
    my $filename_caption = HTML::Entities::encode_entities($c->i18n->p('fieldbook.files.filename', 'Filename'));
    my $delete_caption = HTML::Entities::encode_entities($c->i18n->p('fieldbook.files.delete', 'Delete'));
    print qq { <br/><div class="well well-sm"><table class="table fieldbook_phenotype_datatables"><thead><tr><th>$filename_caption</th><th>$delete_caption</th></tr></thead><tbody> };

    foreach my $phenotype_ref (@phenotype_files) {
      my @phenotype_array = @{$phenotype_ref};
      my $phenotype_file_name = $phenotype_array[0];
      #my $phenotype_file_download = '[<a href="/fieldbook/trait_file_download/'.$trait_array[1].'">Download</a>]';
      #print $phenotype_array[0]."$trait_file_download<br>";
      print qq { <tr><td>$phenotype_array[0]</td><td><a href="javascript:remove_phenotype_data($phenotype_array[1])"><b>X</b></a></td></tr> };
    }

    print qq { </tbody></table></div> };
  }
  </%perl>

</&>

<& /fieldbook/upload_phenotype_fieldbook.mas &>

<&| /page/info_section.mas, title=>HTML::Entities::encode_entities($c->i18n->p('fieldbook.files.removed', 'Removed Phenotype Files')), anchor_title=>'Removed Phenotype Files', collapsible=>1, collapsed=>1 &>
  <%perl>
  foreach my $phenotype_ref (@removed_phenotype_files) {
    my @phenotype_array = @{$phenotype_ref};
    my $phenotype_file_name = $phenotype_array[0];
    #my $phenotype_file_download = '[<a href="/fieldbook/trait_file_download/'.$trait_array[1].'">Download</a>]';
    #print $phenotype_array[0]."$trait_file_download<br>";
    my $reupload_caption = HTML::Entities::encode_entities($c->i18n->p('fieldbook.files.reupload', 're-upload'));
    print qq { $phenotype_array[0]  <button disabled="1" id="re-upload" >$reupload_caption</button><br /> };
  }
  </%perl>
</&>

</div>


<script>

var fieldBookPageI18n = window.SGN && window.SGN.i18n || {
    p: function(context, text, vars) {
        return String(text).replace(/%\{([A-Za-z_][A-Za-z0-9_]*)\}/g, function(token, name) {
            return vars && Object.prototype.hasOwnProperty.call(vars, name) ? String(vars[name]) : token;
        });
    }
};

jQuery(document).ready(function() {
    jQuery('.fieldbook_phenotype_datatables').DataTable({
        language: fieldBookTableLanguage(),
        drawCallback: fieldBookTableAria
    });
} );

  function remove_phenotype_data(file_id) {
    var yes = confirm(fieldBookPageI18n.p('fieldbook.files.remove_confirm', 'Do you really want to remove all data associated with this file (id=%{file_id})', {file_id: file_id}));
    jQuery.ajax( {
      beforeSend: function() { jQuery('#working_modal').modal("show"); },
      url: '/breeders/trial/delete/file/'+file_id,
      success: function(response) {
         jQuery('#working_modal').modal("hide");
         if (response.error) {
           alert(response.error);
         }
         else {
            alert(fieldBookPageI18n.p('fieldbook.files.remove_success', 'SUCCESS!'));
            location.reload();
         }
      },
      error: function(response) {
         jQuery('#working_modal').modal("hide");
         alert(fieldBookPageI18n.p('fieldbook.files.remove_error', 'An error occurred!'));
      }
    });
  }
</script>

<style>
#fieldbook-trait-files-section {
    min-width: 0;
    overflow-wrap: anywhere;
}
#fieldbook-trait-files-section .infosectionhead,
#fieldbook-trait-files-section .infosectionhead_empty {
    table-layout: fixed;
    margin-left: 0;
    margin-right: 0;
    width: 100%;
}
#fieldbook-trait-files-section .infosectiontitle,
#fieldbook-trait-files-section .infosectiontitle_empty {
    width: 65%;
}
#fieldbook-trait-files-section .infosectionsubtitle,
#fieldbook-trait-files-section .infosectionsubtitle_empty {
    width: 35%;
    white-space: normal;
    overflow-wrap: anywhere;
}
#fieldbook-trait-files-section .infosection_emptymessage {
    width: 0;
    padding: 0;
}
</style>

<%args>
$item_id
$item_name
$species
$variety
$material_type
$item_type
$category
$additional_info
$material_source
$breeding_program
$availability => undef
$program_id
$contact_person_username
$item_prop_id
</%args>

<div class="modal fade" id="edit_catalog_details_dialog" tabindex="-1" role="dialog" aria-labelledby="editCatalogDetailsDialog">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content ui-front">
            <div class="modal-header text-center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="editCatalogDetailsDialog"><% $c->i18n->p("barcode.helper.edit_catalog_item_details", "Edit Catalog Item Details") |h %></h4>
            </div>
            <div class="modal-body" id="catalog_details_edit_body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data">
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="edit_item_name"><% $c->i18n->p("barcode.helper.item_name.b8d89d2", "Item Name:") |h %> </label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input class="form-control col-sm-8" id="edit_item_name" type="text" value="<%$item_name%>" disabled/>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="edit_item_type"><% $c->i18n->p("barcode.helper.item_type.3f5084e", "Item Type:") |h %> </label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input class="form-control col-sm-8" id="edit_item_type" type="text" value="<%$item_type%>" disabled/>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="edit_item_species"><% $c->i18n->p("barcode.helper.species", "Species:") |h %> </label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input class="form-control col-sm-8" id="edit_item_species" type="text" value="<%$species%>" disabled/>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="edit_item_variety"><% $c->i18n->p("barcode.helper.variety", "Variety:") |h %> </label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input class="form-control col-sm-8" id="edit_item_variety" type="text" value="<%$variety%>" disabled/>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="edit_material_type"><% $c->i18n->p("seedlots.ui.material_type.21ab872", "Material Type:") |h %> </label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input class="form-control col-sm-8" id="edit_material_type" type="text" value="<%$material_type%>" disabled/>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="edit_item_category"><% $c->i18n->p("barcode.helper.item_category", "Item Category:") |h %> </label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <select class="form-control" id="edit_item_category" value="<%$category%>">
                                        <option value="released variety"><% $c->i18n->p("barcode.helper.released_variety", "released variety") |h %></option>
                                        <option value="pathogen assay "><% $c->i18n->p("barcode.helper.pathogen_assay", "pathogen assay") |h %></option>
                                        <option value="control"><% $c->i18n->p("barcode.helper.control", "control") |h %></option>
                                        <option value="transgenic line"><% $c->i18n->p("barcode.helper.transgenic_line", "transgenic line") |h %></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="edit_item_material_source"><% $c->i18n->p("barcode.helper.material_source.765771b", "Material Source:") |h %> </label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input class="form-control col-sm-8" id="edit_item_material_source" type="text" value="<%$material_source%>" />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="edit_item_additional_info"><% $c->i18n->p("barcode.helper.additional_info.fc45f9a", "Additional Info:") |h %> </label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input class="form-control col-sm-8" id="edit_item_additional_info" type="text" value="<%$additional_info%>" />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="edit_item_breeding_program"><% $c->i18n->p("cross.ui.breeding_program.2c9b17e", "Breeding Program:") |h %> </label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <select class="form-control" id="edit_item_breeding_program" value="<%$program_id%>"></select>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="edit_availability"><% $c->i18n->p("barcode.helper.availability.00afffb", "Availability:") |h %> </label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <select class="form-control" id="edit_availability" value="<%$availability%>">
                                        <option value="available"><% $c->i18n->p("barcode.helper.available", "available") |h %></option>
                                        <option value="unavailable"><% $c->i18n->p("barcode.helper.unavailable", "unavailable") |h %></option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <!--
                        <div class="form-group">
                            <label class="col-sm-3 control-label" for="edit_contact_person">Contact Person Username: </label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <input class="form-control col-sm-8" id="edit_contact_person" type="text" value="<%$contact_person_username%>" />
                                </div>
                            </div>
                        </div>
                        -->
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal" id="edit_item_details_cancel_button"><% $c->i18n->p("auth.legacy.cancel", "Cancel") |h %></button>
                <button type="button" class="btn btn-primary" id="save_item_details"><% $c->i18n->p("trial.details.save", "Save Changes") |h %></button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="edit_catalog_saved_dialog_message" name="edit_catalog_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="editCatalogSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="editCatalogSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("barcode.helper.the_catalog_info_was_saved_successfully", "The catalog info was saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_edit_item_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready( function() {

    var item_prop_id = <% $item_prop_id %>;

    jQuery("#edit_catalog_item_link").click( function() {

        jQuery('#edit_catalog_details_dialog').modal('show');

        var default_bp = document.getElementById("edit_item_breeding_program").getAttribute("value");
        get_select_box('breeding_programs', 'edit_item_breeding_program', { 'default' : default_bp });

        var default_type = document.getElementById("edit_item_type").getAttribute("value");
        jQuery('#edit_item_type option[value="'+default_type+'"]').prop("selected", true);

        var default_category = document.getElementById("edit_item_category").getAttribute("value");
        jQuery('#edit_item_category option[value="'+default_category+'"]').prop("selected", true);

        var default_material_type = document.getElementById("edit_material_type").getAttribute("value");
        jQuery('#edit_material_type option[value="'+default_material_type+'"]').prop("selected", true);

        var default_availability = document.getElementById("edit_availability").getAttribute("value");
        jQuery('#edit_availability option[value="'+default_availability+'"]').prop("selected", true);

    });

    jQuery('#save_item_details').click( function() {
        var item_name = jQuery('#edit_item_name').val();
        var item_type = jQuery('#edit_item_type').val();
        var species = jQuery('#edit_item_species').val();
        var variety = jQuery('#edit_item_variety').val();
        var material_type = jQuery('#edit_material_type').val();
        var category = jQuery('#edit_item_category').val();
        var additional_info = jQuery('#edit_item_additional_info').val();
        var material_source = jQuery('#edit_item_material_source').val();
        var breeding_program = jQuery('#edit_item_breeding_program').val();
        var availability = jQuery('#edit_availability').val();
        var contact_person = jQuery('#edit_contact_person').val();
        jQuery.ajax({
            url: '/ajax/catalog/add_item',
            dataType: "json",
            type: 'POST',
            data : {
                'name': item_name,
                'type': item_type,
                'species': species,
                'variety': variety,
                'material_type': material_type,
                'category': category,
                'additional_info': additional_info,
                'material_source': material_source,
                'breeding_program_id': breeding_program,
                'contact_person': contact_person,
                'item_prop_id': item_prop_id,
                'availability': availability
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#edit_catalog_details_dialog').modal('hide');
                    jQuery('#edit_catalog_saved_dialog_message').modal("show");
                }
                if (response.error_string) {
                    alert(response.error_string);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.an_error_occurred_adding_item", "An error occurred adding item") : 'An error occurred adding item'));
            }
        });
    });

    jQuery("#dismiss_edit_item_saved_dialog").click(function(){
        location.reload();
    });

});

</script>

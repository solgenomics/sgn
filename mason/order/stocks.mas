<%args>

$role => "stock_orderer"
$check_vendor_role => undef
$tracking_order_activity => undef
$user_id

</%args>


<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery/dataTables', 'CXGN.BreedersToolbox.HTMLSelect.js', 'CXGN.List' ] &>

% if ($check_vendor_role == 1) {
    <&| /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.manage_orders_for_vendor", "Manage Orders for Vendor")) &>
    </&>
% } else {
    <&| /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.your_orders", "Your Orders")) &>
    </&>
%}

<td>
    <a href="/catalog/view"><p><% $c->i18n->p("barcode.helper.go_to_catalog_page", "Go to Catalog Page") |h %></p></a>
</td>

<br/>
% if ($check_vendor_role == 1) {
    <&| /page/info_section.mas, anchor_title => 'Manage Current Orders', title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.manage_current_orders", 'Manage Current Orders')), collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "vendor_current_orders" class="table table-hover table-striped">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>

    <&| /page/info_section.mas, anchor_title => 'Completed Orders', title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.completed_orders", 'Completed Orders')), collapsible=>1, collapsed=>1 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "vendor_completed_orders" class="table table-hover table-striped">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

% if ($check_vendor_role != 1) {
    <&| /page/info_section.mas, anchor_title => 'Your Current Orders', title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.your_current_orders", 'Your Current Orders')), collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "user_current_orders" class="table table-hover table-striped">
                            <thead>
                                <tr>
                                    <th><% $c->i18n->p("barcode.helper.order_number.f1d1cc6", "Order Number") |h %></th>
                                    <th><% $c->i18n->p("barcode.helper.submitted_date", "Submitted Date") |h %></th>
                                    <th><% $c->i18n->p("barcode.helper.order_details", "Order Details") |h %></th>
                                    <th><% $c->i18n->p("global.dataset_publish.status.heading", "Status") |h %></th>
                                    <th><% $c->i18n->p("barcode.helper.send_order_to", "Send Order to") |h %></th>
                                    <th><% $c->i18n->p("accession.stock.section.comments", "Comments") |h %></th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>

    <&| /page/info_section.mas, anchor_title => 'Your Completed Orders', title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.your_completed_orders", 'Your Completed Orders')), collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "user_completed_orders" class="table table-hover table-striped">
                            <thead>
                                <tr>
                                    <th><% $c->i18n->p("barcode.helper.order_number.f1d1cc6", "Order Number") |h %></th>
                                    <th><% $c->i18n->p("barcode.helper.submitted_date", "Submitted Date") |h %></th>
                                    <th><% $c->i18n->p("barcode.helper.order_details", "Order Details") |h %></th>
                                    <th><% $c->i18n->p("global.dataset_publish.status.heading", "Status") |h %></th>
                                    <th><% $c->i18n->p("barcode.helper.completed_date", "Completed Date") |h %></th>
                                    <th><% $c->i18n->p("barcode.helper.processed_by", "Processed by") |h %></th>
                                    <th><% $c->i18n->p("accession.stock.section.comments", "Comments") |h %></th>
                                </tr>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

<div class="modal fade" id="update_order_dialog" name="update_order_dialog" tabindex="-1" role="dialog" aria-labelledby="updateOrderDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updateOrderDialog"><% $c->i18n->p("barcode.helper.update_order", "Update Order") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="update_order_div">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button id="update_order_button" type="button" class="btn btn-primary" ><% $c->i18n->p("lists.render.update", "Update") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="update_saved_dialog" name="update_saved_dialog" tabindex="-1" role="dialog" aria-labelledby="updateSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="updateSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("barcode.helper.the_order_has_been_updated", "The order has been updated.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_update_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="re_open_order_dialog" name="re_open_order_dialog" tabindex="-1" role="dialog" aria-labelledby="reOpenOrderDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="reOpenOrderDialog"><% $c->i18n->p("barcode.helper.re_open_order", "Re-Open Order") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="re_open_order_div">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button id="re_open_order_button" type="button" class="btn btn-primary" ><% $c->i18n->p("barcode.helper.re_open", "Re-Open") |h %></button>
            </div>
        </div>
    </div>
</div>

% if (($check_vendor_role == 1) && $tracking_order_activity) {
    <&| /page/info_section.mas, anchor_title => 'Tracking Order Progress', title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.tracking_order_progress", 'Tracking Order Progress')), collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <!--
                    <button id="download_active_item_file_button" class="btn btn-primary">Download Item File</button>
                    <button id="download_ontology_file_button" class="btn btn-primary">Download Data Collection Ontologies</button>
                    -->
                    <button id="generate_active_item_barcode_button" class="btn btn-primary"><% $c->i18n->p("barcode.helper.generate_item_barcodes", "Generate Item Barcodes") |h %></button>
                    <a href="/activity/record" class="btn btn-default"><% $c->i18n->p("transformation.root.go_to_record_page", "Go to Record Page") |h %></a>
                </div>
                <div class = "panel-body">

                <div style="overflow:scroll">
                    <table class="table table-hover table-bordered" id="order_progress_table">
                        <thead>
                            <tr>
                                <th><% $c->i18n->p("barcode.helper.order_number.f1d1cc6", "Order Number") |h %></th>
                                <th><% $c->i18n->p("barcode.helper.order_details", "Order Details") |h %></th>
                                <th><% $c->i18n->p("transformation.root.tracking_id", "Tracking ID") |h %></th>
                                <th><% $c->i18n->p("seedlot.material", "Material") |h %></th>
% my $activity_types = $c->config->{tracking_activities_header};
% my @column_header = split ',',$activity_types;
% foreach my $column_header(@column_header){
                                <th><%$column_header%></th>
%}
                            </tr>
                        </thead>
                    </table>
                </div>
                </div>
            </div>
        </div>
    </&>
% }

<& /order/create_item_file_dialog.mas&>
<& /order/create_ontology_file_dialog.mas &>
<& /order/generate_identifier_barcode_dialog.mas, identifier => "", user_id => $user_id &>

<script>

$(window).ready( function() {

    jQuery('#user_current_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/current',
    });

    jQuery('#user_completed_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/completed',
    });

    jQuery('#vendor_current_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/vendor_current_orders',
        columns: [
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.order_number.f1d1cc6", "Order Number") : "Order Number")).html(), "data": null, "render": function ( data, type, row ) { return "<a href='/order/details/view/"+row.order_id+"'>"+row.order_id+"</a>"; } },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.ordered_by.826ddab", "Ordered by") : "Ordered by")).html(), "data": "order_from_name" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.submitted_date", "Submitted Date") : "Submitted Date")).html(), "data": "create_date" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.order_details", "Order Details") : "Order Details")).html(), "data": "order_details" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_publish.status.heading", "Status") : "Status")).html(), "data": "order_status" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.stock.section.comments", "Comments") : "Comments")).html(), "data": "contact_person_comments" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("lists.render.update", "Update") : "Update")).html(), "data": "null", "render": function ( data, type, row ) { return "<a onclick='updateOrder(\""+row.order_id+"\", \""+row.order_from_name+("\")' >" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("lists.render.update", "Update") : "Update")).html() + "</a>"); } },
        ]
    });

    jQuery('#vendor_completed_orders').DataTable( {
        'autoWidth': false,
        'ajax': '/ajax/order/vendor_completed_orders',
        columns: [
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.order_number.f1d1cc6", "Order Number") : "Order Number")).html(), "data": null, "render": function ( data, type, row ) { return "<a href='/order/details/view/"+row.order_id+"'>"+row.order_id+"</a>"; } },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.ordered_by.826ddab", "Ordered by") : "Ordered by")).html(), "data": "order_from_name" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.submitted_date", "Submitted Date") : "Submitted Date")).html(), "data": "create_date" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.order_details", "Order Details") : "Order Details")).html(), "data": "order_details" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_publish.status.heading", "Status") : "Status")).html(), "data": "order_status" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.completion_date", "Completion Date") : "Completion Date")).html(), "data": "completion_date" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.stock.section.comments", "Comments") : "Comments")).html(), "data": "contact_person_comments" },
            { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("lists.render.update", "Update") : "Update")).html(), "data": "null", "render": function ( data, type, row ) { return "<a onclick='reOpenOrder(\""+row.order_id+"\", \""+row.order_from_name+("\")' >" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.re_open", "Re-Open") : "Re-Open")).html() + "</a>"); } },
        ]
    });

    jQuery('#update_order_button').click( function() {
        var order_id = jQuery('#update_order_id').val();
        var new_order_status = jQuery('#update_order_status').val();
        if (!new_order_status) {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("trial.status_dialog.sentinel", "Please select a status") : "Please select a status"));
            return;
        }
        var contact_person_comments = jQuery('#contact_person_comments').val();

        jQuery.ajax({
            url: '/ajax/order/update',
            dataType: "json",
            type: 'POST',
            data : {
                'order_id' : order_id,
                'new_status': new_order_status,
                'contact_person_comments': contact_person_comments
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#update_saved_dialog').modal('show');
                    jQuery('#update_order_dialog').modal('hide');
                }
                if (response.error_string) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.an_error_occurred_updating_the_order", "An error occurred updating the order") : 'An error occurred updating the order'));
            }
        });
    });

    jQuery("#dismiss_update_saved_dialog").click(function(){
        location.reload();
    });

    jQuery('#re_open_order_button').click( function() {
        var order_id = jQuery('#re_open_order_id').val();
        var re_open_status = jQuery('#re_open_status').val();
        var re_open_comments = jQuery('#re_open_comments').val();
        if (!re_open_comments) {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.please_add_comments_for_re_opening_the_order", "Please add comments for re-opening the order") : "Please add comments for re-opening the order"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/order/update',
            dataType: "json",
            type: 'POST',
            data : {
                'order_id' : order_id,
                'new_status': re_open_status,
                'contact_person_comments': re_open_comments
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#update_saved_dialog').modal('show');
                    jQuery('#re_open_order_dialog').modal('hide');
                }
                if (response.error_string) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.an_error_occurred_updating_the_order", "An error occurred updating the order") : 'An error occurred updating the order'));
            }
        });
    });

    jQuery('#order_progress_table').DataTable({
        'autoWidth': false,
        'ajax': '/ajax/order/progress',
    });

});

function updateOrder(order_id, order_from_name){
    var html = '';
    html += ("<form class=\"form-horizontal\"><div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.order_number.a252e43", "Order Number:") : "Order Number:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"update_order_id\" name=\"update_order_id\" value=\"")+order_id+'" disabled></div></div>';
    html += ("<div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.ordered_by.5a36b09", "Ordered by:") : "Ordered by:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"ordered_by_name\" name=\"ordered_by_name\" value=\"")+order_from_name+'" disabled></div></div>';
    html += ("<div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.est.status", "Status:") : "Status:")).html() + " </label><div class=\"col-sm-9\" ><select class=\"form-control\" id=\"update_order_status\" name=\"update_order_status\"><option disabled value=\"\" selected hidden>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.select_a_status", "Select a status") : "Select a status")).html() + "</option>");
    html += '<option value='+"being_processed"+'>'+"being_processed"+'</option>';
    html += '<option value='+"shipped"+'>'+"shipped"+'</option>';
    html += '<option value='+"completed"+'>'+"completed"+'</option>';
    html += '<option value='+"cancelled"+'>'+"cancelled"+'</option>';
    html += '</select></div></div>';
    html += ("<div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.comments", "Comments:") : "Comments:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"contact_person_comments\" placeholder=\"" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.stock.optional", "Optional") : "Optional")).html() + "\"></div></div></form>")

    jQuery('#update_order_div').html(html);
    jQuery('#update_order_dialog').modal('show');

}

function reOpenOrder(order_id, order_from_name){
    var re_open = "re-opened"
    var html = '';
    html += ("<form class=\"form-horizontal\"><div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.order_number.a252e43", "Order Number:") : "Order Number:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"re_open_order_id\" name=\"re_open_order_id\" value=\"")+order_id+'" disabled></div></div>';
    html += ("<div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.ordered_by.5a36b09", "Ordered by:") : "Ordered by:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"re_open_ordered_by\" name=\"re_open_ordered_by\" value=\"")+order_from_name+'" disabled></div></div>';
    html += ("<div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.est.status", "Status:") : "Status:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"re_open_status\" name=\"re_open_status\" value=\"")+re_open+'" disabled></div></div>';
    html += ("<div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.comments", "Comments:") : "Comments:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"re_open_comments\" placeholder=\"" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot_split.ui.required", "Required") : "Required")).html() + "\"></div></div></form>")

    jQuery('#re_open_order_div').html(html);
    jQuery('#re_open_order_dialog').modal('show');

}


</script>

<%once>
use HTML::Entities ();
</%once>

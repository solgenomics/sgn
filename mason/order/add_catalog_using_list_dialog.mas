<%args>
$timestamp => localtime()
</%args>

<div class="modal fade" id="add_catalog_using_list_dialog" name="add_catalog_using_list_dialog" tabindex="-1" role="dialog" aria-labelledby="addCatalogUsingListDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="addCatalogUsingListDialog"><% $c->i18n->p("barcode.helper.add_new_catalog_items_using_list", "Add New Catalog Items Using List") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" id="add_new_catalog_using_list_form" name="add_new_catalog_using_list_form">
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("barcode.helper.list_type", "List Type:") |h %> </label>
                            <div class="col-sm-9">
                                <select class="form-control" id="catalog_list_type">
                                    <option value=""><% $c->i18n->p("barcode.helper.select_a_list_type", "Select a list type") |h %></option>
                                    <option value="accessions"><% $c->i18n->p("accession.forms.accessions", "accessions") |h %></option>
                                    <option value="seedlots"><% $c->i18n->p("barcode.helper.seedlots", "seedlots") |h %></option>
                                    <option value="vector_constructs">vector_constructs</option>
                                    <option value="populations"><% $c->i18n->p("barcode.helper.populations", "populations") |h %></option>
                                </select>
                            </div>
                        </div>
                        <div id="catalog_info_section" style="display:none">
                            <div class="form-group" id="catalog_list_section" >
                                <label class="col-sm-3 control-label"><% $c->i18n->p("barcode.helper.select_a_list", "Select a List:") |h %></label>
                                <div class="col-sm-9" id="select_catalog_list" name="select_catalog_list"></div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% $c->i18n->p("barcode.helper.category.8a9c378", "Category:") |h %> </label>
                                <div class="col-sm-9">
                                    <select class="form-control" id="list_category">
                                        <option value=""><% $c->i18n->p("barcode.helper.please_select_a_category", "Please select a category") |h %></option>
                                        <option value="released variety"><% $c->i18n->p("barcode.helper.released_variety", "released variety") |h %></option>
                                        <option value="pathogen assay "><% $c->i18n->p("barcode.helper.pathogen_assay", "pathogen assay") |h %></option>
                                        <option value="control"><% $c->i18n->p("barcode.helper.control", "control") |h %></option>
                                        <option value="transgenic line"><% $c->i18n->p("barcode.helper.transgenic_line", "transgenic line") |h %></option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% $c->i18n->p("barcode.helper.additional_info.fc45f9a", "Additional Info:") |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="list_additional_info" placeholder="<% $c->i18n->p("seedlot.optional", "optional") |h %>">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% $c->i18n->p("barcode.helper.material_source.765771b", "Material Source:") |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="list_material_source" placeholder="<% $c->i18n->p("seedlot.optional", "optional") |h %>">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% $c->i18n->p("cross.ui.breeding_program.2c9b17e", "Breeding Program:") |h %> </label>
                                <div class="col-sm-9" >
                                    <div id="list_item_breeding_program_div"></div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-3 control-label"><% $c->i18n->p("barcode.helper.contact_person_username.25d672d", "Contact Person Username:") |h %> </label>
                                <div class="col-sm-9" >
                                    <input class="form-control" id="list_contact_person_name" placeholder="<% $c->i18n->p("barcode.helper.please_provide_contact_person_username", "Please provide contact person username") |h %>">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="reset" id="close_catalog_list_dialog" name="close_catalog_list_dialog" class="btn btn-default" ><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                    <button id="submit_catalog_using_list" type="button" class="btn btn-primary" ><% $c->i18n->p("global.search_wizard.add", "Add") |h %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="add_item_list_saved_dialog_message" name="add_item_list_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="addItemListSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addItemListSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("barcode.helper.the_catalog_items_were_saved_successfully", "The catalog items were saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_list_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>
jQuery(document).ready(function(){

    jQuery("#add_catalog_using_list_button").click( function() {

        jQuery('#add_catalog_using_list_dialog').modal('show');
    });

    jQuery(document).on('change', '#catalog_list_type', function () {
        var list = new CXGN.List();
        var list_type = jQuery('#catalog_list_type').val();
        jQuery("#catalog_info_section").show();
        document.getElementById("select_catalog_list").innerHTML = list.listSelect("select_catalog_list", [ list_type ], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlots.ui.please_select_a_list", "Please select a list") : 'Please select a list'),'', undefined);
        get_select_box('breeding_programs', 'list_item_breeding_program_div', { 'name' : 'list_breeding_program_id', 'id' : 'list_breeding_program_id', 'empty': 1 });
    });

    jQuery('#submit_catalog_using_list').click( function() {
        var catalog_list_type = jQuery('#catalog_list_type').val();
        var catalog_list = jQuery('#select_catalog_list_list_select').val();
        var category = jQuery('#list_category').val();
        var additional_info = jQuery('#list_additional_info').val();
        var material_source = jQuery('#list_material_source').val();
        var breeding_program = jQuery('#list_breeding_program_id').val();
        var contact_person = jQuery('#list_contact_person_name').val();
        if (catalog_list_type == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.please_select_a_list_type", "Please select a list type") : "Please select a list type"));
            return;
        }

        if (catalog_list == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlots.ui.please_select_a_list", "Please select a list") : "Please select a list"));
            return;
        }
        if (category == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.please_select_a_category", "Please select a category") : "Please select a category"));
            return;
        }
        if (breeding_program == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("locations.select.program", "Please select a program") : "Please select a program"));
            return;
        }
        if (contact_person == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.please_provide_contact_username", "Please provide contact username") : "Please provide contact username"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/catalog/add_item_list',
            dataType: "json",
            type: 'POST',
            data : {
                'list_type': catalog_list_type,
                'catalog_list' : catalog_list,
                'category': category,
                'additional_info': additional_info,
                'material_source': material_source,
                'breeding_program_id': breeding_program,
                'contact_person': contact_person,
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#add_catalog_using_list_dialog').modal('hide');
                    jQuery('#add_item_list_saved_dialog_message').modal("show");
                }
                if (response.error_string) {
                    alert(response.error_string);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.an_error_occurred_adding_item", "An error occurred adding item") : 'An error occurred adding item'));
            }
        });
    });

    jQuery("#close_catalog_list_dialog").click(function() {
        jQuery("#add_catalog_using_list_dialog").modal('hide');
        location.reload();
    });

    jQuery("#dismiss_list_saved_dialog").click(function(){
        location.reload();
    });

});

</script>

<%args>

$check_vendor_role
$ordering_service_name => undef
$additional_order_info => undef
$ordering_type => undef
$order_properties => undef
$order_properties_dialog => undef
$catalog_stock_type => undef
$catalog_stock_property => undef

</%args>

<& /util/import_javascript.mas, classes => [ 'jquery.iframe-post-form', 'jquery', 'jquery.dataTables', 'CXGN.List'] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.order_form_and_catalog", "Order Form and Catalog")) &>

% if ($catalog_stock_property eq 'transgenic') {
    <& /order/catalog_transgenic_lines.mas, order_properties_dialog => $order_properties_dialog, order_properties => $order_properties &>
% }

% if (($check_vendor_role == 1) && (!$catalog_stock_type)) {
    <&| /page/info_section.mas, anchor_title => 'Manage Catalog', title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.manage_catalog", 'Manage Catalog')), collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <button id ="manage_catalog_usage_info_button" class="btn btn-default" ><% $c->i18n->p("cross.ui.usage_help", "Usage Help") |h %> <span class="glyphicon glyphicon-question-sign"></span></button>
                    <button id="add_catalog_item_button" class="btn btn-primary"><% $c->i18n->p("barcode.helper.add_single_item", "Add Single Item") |h %></button>
                    <button id="add_catalog_using_list_button" class="btn btn-primary"><% $c->i18n->p("barcode.helper.add_multiple_items_using_list.4c17a9f", "Add Multiple Items Using List") |h %></button>
                    <button id="upload_catalog_items_button" class="btn btn-primary"><% $c->i18n->p("barcode.helper.upload_multiple_items", "Upload Multiple Items") |h %></button>
                </div>
            </div>
        </div>
    </&>
% }

% if (($check_vendor_role == 1) && (!$catalog_stock_type)) {
<&| /page/info_section.mas, anchor_title => 'Catalog Items', title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.catalog_items", 'Catalog Items')), collapsible=>1, collapsed=>0 &>
    <div class = "well well-sm">
        <div class = "panel panel-default">
            <div class = "panel-body">
                <div style="overflow:scroll">
                    <table id = "catalog_items_table" class="table table-hover table-striped">
                    </table>
                </div>
            </div>
        </div>
% if ($ordering_type ne 'single_step') {
        <div class="panel panel-default">
            <div class="panel-body">
                <button id="your_cart_button" type="button" class="btn btn-primary btn-sm">
                    <span class="glyphicon glyphicon-shopping-cart"></span> <% $c->i18n->p("barcode.helper.your_cart", "Your Cart") |h %>
                </button>
            </div>
        </div>
%}
        <td>
            <a href="/order/stocks/view"><p><% $c->i18n->p("barcode.helper.go_to_manage_order_page", "Go to Manage Order Page") |h %></p></a>
        </td>
    </div>
</&>
% }

<div class="modal fade" id="cart_item_dialog" name="cart_item_dialog" tabindex="-1" role="dialog" aria-labelledby="cartItemDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align:center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="cartItemDialog"><% $c->i18n->p("barcode.helper.your_cart", "Your Cart") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="cart_items_div">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_cart_item_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button id="submit_order" type="button" class="btn btn-primary" ><% $c->i18n->p("barcode.helper.submit_order", "Submit Order") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cart_message_dialog" name="cart_message_dialog" tabindex="-1" role="dialog" aria-labelledby="cartMessageDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align:center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="cartMessageDialog"><% $c->i18n->p("barcode.helper.your_cart", "Your Cart") |h %></h4>
            </div>
            <div class="modal-body" style="text-align:center">
                <div class="container-fluid">
                    <p>
                        <% $c->i18n->p("barcode.helper.you_do_not_have_any_item_in_your_cart", "You do not have any item in your cart") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_cart_message_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="order_response_dialog" name="order_response_dialog" tabindex="-1" role="dialog" aria-labelledby="orderResponseDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="orderResponseDialog"><% $c->i18n->p("barcode.helper.your_order", "Your Order") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="ordering_response_div"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_order_response_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="add_item_detail_dialog" name="add_item_detail_dialog" tabindex="-1" role="dialog" aria-labelledby="addItemDetailDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addItemDetailDialog"><% $c->i18n->p("barcode.helper.add_item_details", "Add Item Details") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="add_item_detail_div">
                    </div>
                </div>
            </div>
% if ($ordering_type eq 'single_step') {
            <div class="modal-footer">
                <button id="close_submit_item_detail_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button id="single_step_submission_button" type="button" class="btn btn-primary" ><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
            </div>
%} else {
            <div class="modal-footer">
                <button id="close_add_item_detail_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button id="add_item_button" type="button" class="btn btn-primary" ><% $c->i18n->p("barcode.helper.add_item", "Add Item") |h %></button>
            </div>
%}
        </div>
    </div>
</div>

<& /order/upload_catalog_items_dialog.mas, ordering_type => $ordering_type&>
<& /order/add_catalog_item_dialog.mas, ordering_type => $ordering_type &>
<& /order/add_catalog_using_list_dialog.mas, ordering_type => $ordering_type &>
<& /order/manage_catalog_usage_info.mas &>


<script>

jQuery(document).ready( function() {

    var ordering_service_name = "<% $ordering_service_name %>";
    var additional_order_info = "<% $additional_order_info %>";
    var ordering_type = "<% $ordering_type %>";
    var order_properties = "<% $order_properties %>";
    var property_keys = order_properties.split(",");
    var order_properties_dialog = "<% $order_properties_dialog %>";
    var property_dialog_keys = order_properties_dialog.split(",");

    if (ordering_type == 'single_step') {
        jQuery('#catalog_items_table').DataTable( {
            'autoWidth': false,
            'order': false,
            'search':'applied',
            'ajax': '/ajax/catalog/items',
            columns: [
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.library_search.name", "Name") : "Name")).html(), "data": null, "render": function ( data, type, row ) { return "<a href='/catalog/item_details/"+row.item_id+"'>"+row.item_name+"</a>"; } },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search.features.type.f65b938", "Type") : "Type")).html(), "data": "item_type" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot_split.ui.material_type", "Material Type") : "Material Type")).html(), "data": "material_type" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.species", "Species") : "Species")).html(), "data": "species" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.variety", "Variety") : "Variety")).html(), "data": "variety" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.category.df1f580", "Category") : "Category")).html(), "data": "category" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.stock.section.additional_info", "Additional Info") : "Additional Info")).html(), "data": "additional_info" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.material_source.43ceb28", "Material Source") : "Material Source")).html(), "data": "material_source" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("locations.table.program", "Program") : "Program")).html(), "data": "breeding_program" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.availability.797abcb", "Availability") : "Availability")).html(), "data": "availability"},
                { title: " ", "data": "null", "render": function ( data, type, row ) {
                    if (row.availability == 'available') {
                        return "<a onclick='addToCart(\""+row.item_name+"\", \""+additional_order_info+"\", \""+ordering_service_name+"\", \""+ordering_type+"\", \""+order_properties_dialog+("\")'>" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.request", "Request") : "Request")).html() + "</a>");
                    } else {
                        return ' '
                    }
                }},
            ],
        });
    } else {
            jQuery('#catalog_items_table').DataTable( {
            'autoWidth': false,
            'order': false,
            'search':'applied',
            'ajax': '/ajax/catalog/items',
            columns: [
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.library_search.name", "Name") : "Name")).html(), "data": null, "render": function ( data, type, row ) { return "<a href='/catalog/item_details/"+row.item_id+"'>"+row.item_name+"</a>"; } },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search.features.type.f65b938", "Type") : "Type")).html(), "data": "item_type" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot_split.ui.material_type", "Material Type") : "Material Type")).html(), "data": "material_type" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.species", "Species") : "Species")).html(), "data": "species" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot.variety", "Variety") : "Variety")).html(), "data": "variety" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.category.df1f580", "Category") : "Category")).html(), "data": "category" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("accession.stock.section.additional_info", "Additional Info") : "Additional Info")).html(), "data": "additional_info" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.material_source.43ceb28", "Material Source") : "Material Source")).html(), "data": "material_source" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("locations.table.program", "Program") : "Program")).html(), "data": "breeding_program" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.availability.797abcb", "Availability") : "Availability")).html(), "data": "availability"},
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.add_to_cart", "Add to Cart") : "Add to Cart")).html(), "data": "null", "render": function ( data, type, row ) {
                    if (row.availability == 'available') {
                        return "<a onclick='addToCart(\""+row.item_name+"\", \""+additional_order_info+"\", \""+ordering_service_name+"\", \""+ordering_type+"\", \""+order_properties_dialog+"\" )'><span class='glyphicon glyphicon-shopping-cart'></span></a>";
                    } else {
                        return ' '
                    }
                }},
            ],
        });
    }

    var lo = new CXGN.List();
    var list_id;
    var myCart = lo.availableLists('catalog_items')
    if (myCart.length > 0) {
        list_id = myCart[0][0];
    }

    jQuery('#your_cart_button').click(function(){
        if (!list_id) {
            jQuery('#cart_message_dialog').modal('show');
        } else {
            jQuery('#cart_item_dialog').modal('show');
            showListItems('cart_items', list_id);
        }
    });

    jQuery('#add_item_button').click(function(){
        var order_details = {};
        var item_name = jQuery('#item_name').val();
        order_details['Item Name'] = item_name;
        for(var i=0; i<property_keys.length; i++){
            var each_value = jQuery('#'+ i +'').val();
            order_details[property_keys[i]] = each_value;
        }

        var item_string = JSON.stringify(order_details);

        var lo = new CXGN.List();

        var myCart = lo.availableLists('catalog_items')
        if (myCart.length > 0) {
            var list_id = myCart[0][0];
            var itemAdded = lo.addToList(list_id, item_string);
        } else if (myCart.length == 0) {
            var list_id = lo.newList('your_cart');
            var itemAdded = lo.addToList(list_id, item_string);
            lo.setListType(list_id, 'catalog_items');
        } else {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.error_retrieving_your_cart", "Error retrieving your cart") : 'Error retrieving your cart'))
        }
        if (itemAdded) {
            jQuery('#add_item_detail_dialog').modal('hide');
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.saved", "Saved ") : "Saved ") + item_name + " in your cart");
            location.reload();
        }

    });


    jQuery('#submit_order').click( function() {

        jQuery.ajax({
            url: '/ajax/order/submit',
            dataType: "json",
            type: 'POST',
            data : {
                'list_id' : list_id,
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success) {
                    jQuery.ajax( {
                        url: '/list/delete',
                        async: false,
                        data: { 'list_id': list_id }
                    });

                    jQuery('#ordering_response_div').html(response.success);

                    jQuery('#order_response_dialog').modal('show');
                    jQuery('#cart_item_dialog').modal('hide');
                }
                if (response.error_string) {
                    alert(response.error_string);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.an_error_occurred_saving_your_order", "An error occurred saving your order") : 'An error occurred saving your order'));
            }

        });
    });

    jQuery("#dismiss_order_response_dialog").click(function(){
        location.reload();
    });

    jQuery('#single_step_submission_button').click(function(){
        var order_details = {};
        var item_name = jQuery('#item_name').val();
        for(var i=0; i<property_keys.length; i++){
            var each_value = jQuery('#'+ i +'').val();
            order_details[property_keys[i]] = each_value;
        }

        jQuery.ajax({
            url: '/ajax/order/single_step_submission',
            dataType: "json",
            type: 'POST',
            data : {
                'item_name' : item_name,
                'order_details': JSON.stringify(order_details),
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success) {
                    jQuery('#ordering_response_div').html(response.success);

                    jQuery('#order_response_dialog').modal('show');
                    jQuery('#add_item_detail_dialog').modal('hide');
                }
                if (response.error_string) {
                    alert(response.error_string);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.an_error_occurred_saving_your_request", "An error occurred saving your request") : 'An error occurred saving your request'));
            }
        });
    });


});

function addToCart(item_name, additional_order_info, ordering_service_name, ordering_type, order_properties_dialog ){
    var additional_info = additional_order_info.split(",");
    var properties = order_properties_dialog.split(",");
    var html = '';

    html = html + ("<form class=\"form-horizontal\"><div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.item_name.b8d89d2", "Item Name:") : "Item Name:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"item_name\" name=\"item_name\" value=\"")+item_name+'" disabled></div><br><br>';
    for(var i=0; i<properties.length; i++){
        var each_property_info = properties[i].split(":");
        if (each_property_info.length == 1 && (properties[i].includes("Date"))) {
            html = html + '<label class="col-sm-3 control-label">'+ properties[i] +'</label><div class="col-sm-9" ><input class="form-control" id= '+ i +' name= '+ i +(" placeholder=\"" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("decision.root.yyyy_mm_dd", "YYYY-MM-DD") : "YYYY-MM-DD")).html() + "\"></div><br><br>");
        } else if (each_property_info.length == 1) {
            html = html + '<label class="col-sm-3 control-label">'+ properties[i] +'</label><div class="col-sm-9" ><input class="form-control" id= '+ i +' name= '+ i +' placeholder=""></div><br><br>';
        } else {
            html = html + '<label class="col-sm-3 control-label">'+ each_property_info[0] +'</label><div class="col-sm-9" ><select class="form-control" id= '+ i +' name= '+ i +'> ';
            for (var j=1; j<each_property_info.length; j++) {
                html = html + "<option value='"+each_property_info[j]+"'>" + each_property_info[j] + "</option>";
            }
            html = html + "</select></div><br><br>";
        }
    }
    html = html + '</div></div></form>';

    jQuery('#add_item_detail_div').html(html);
    jQuery('#add_item_detail_dialog').modal('show');

}


</script>

<%once>
use HTML::Entities ();
</%once>

<%args>

</%args>


<div class="modal fade" id="upload_catalog_items_dialog" name="upload_catalog_items_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadCatalogItemsDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCatalogItemsDialog"><% $c->i18n->p("barcode.helper.upload_catalog_items", "Upload Catalog Items") |h %> </h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <&| /page/explanation.mas, title=>$c->i18n->p("cross.ui.template_information.bf8c643", 'Template Information') &>
                        <p>
                            <b><% $c->i18n->p("cross.forms.file_format_information", "File Format Information") |h %></b>
                            <br>
                            <a id="upload_catalog_items_format"><% $c->i18n->p("cross.ui.spreadsheet_format.f1285ec", "Spreadsheet Format") |h %></a>
                            <br>
                        </p>
                    </&>
                    <form class="form-horizontal" role="form" method="post" enctype="multipart/form-data" encoding="multipart/form-data" id="upload_catalog_items_form" name="upload_catalog_items_form">
                        <div class="form-group">
                            <label class="col-sm-4 control-label"><% $c->i18n->p("cross.forms.upload_file_xls_or_xlsx", "Upload File (.xls or .xlsx):") |h %> </label>
                                <div class="col-sm-8">
                                    <input type="file" name="catalog_items_upload_file" id="catalog_items_upload_file" encoding="multipart/form-data" />
                                </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button type="button" class="btn btn-primary" name="upload_catalog_items_submit" id="upload_catalog_items_submit"><% $c->i18n->p("cross.ui.upload_file.3ee3b0b", "Upload File") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_catalog_items_error_display" name="upload_catalog_items_error_display" tabindex="-1" role="dialog" aria-labelledby="uploadCatalogItemsErrorDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCatalogItemsErrorDialog"><% $c->i18n->p("barcode.helper.upload_catalog_items_file_error", "Upload Catalog Items File Error") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <table>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="catalog_items_saved_dialog_message" name="catalog_items_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="catalogItemsSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="catalogItemsSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("barcode.helper.the_catalog_items_were_saved_successfully", "The catalog items were saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_catalog_items_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="upload_catalog_items_format_dialog" name="upload_catalog_items_format_dialog" tabindex="-1" role="dialog" aria-labelledby="uploadCatalogItemsFormatDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="uploadCatalogItemsFormatDialog"><% $c->i18n->p("cross.ui.template_information.bf8c643", "Template Information") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <b><% $c->i18n->p("barcode.helper.catalog_items_may_be_uploaded_in_an_excel_file_xls", "Catalog Items may be uploaded in an Excel file (.xls or .xlsx)") |h %></b>
                    <br>
                    <b><% $c->i18n->p("accessions.template.header", "Header:") |h %></b>
                    <br>
                    <% $c->i18n->p("seedlots.ui.the_first_row_header_must_contain_the_following", "The first row (header) must contain the following:") |h %>
                    <br>
                    <table class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>item_name</td>
                                <td>category</td>
                                <td>additional_info</td>
                                <td>material_source</td>
                                <td>breeding_program</td>
                                <td>contact_person_username</td>
                            </tr>
                        </tbody>
                    </table>
                    <b><% $c->i18n->p("cross.ui.required_columns", "Required columns:") |h %></b>
                    <ul>
                        <li><b><% $c->i18n->p("barcode.helper.item_name.50dd400", "item_name:") |h %></b><% $c->i18n->p("barcode.helper.item_name_must_be_in_the_database_can_be_accession", "Item name must be in the database, can be accession, seedlot, population or vector_construct stock type") |h %></li>
                        <li><b><% $c->i18n->p("barcode.helper.category.2776699", "category:") |h %></b><% $c->i18n->p("barcode.helper.must_be_one_of_the_following_released_variety_pathogen_assay", "Must be one of the following (released variety, pathogen assay, control, transgenic line). This field can be customized, please contact us.") |h %> </li>
                        <li><b><% $c->i18n->p("barcode.helper.additional_info.289c4cd", "additional_info:") |h %></b> <% $c->i18n->p("barcode.helper.required_in_the_header_but_value_may_be_left_blank", "Required in the header, but value may be left blank.") |h %></li>
                        <li><b><% $c->i18n->p("barcode.helper.material_source.8471806", "material_source:") |h %></b> <% $c->i18n->p("barcode.helper.required_in_the_header_but_value_may_be_left_blank", "Required in the header, but value may be left blank.") |h %></li>
                        <li><b><% $c->i18n->p("barcode.helper.breeding_program", "breeding_program:") |h %></b><% $c->i18n->p("barcode.helper.breeding_program_must_be_in_the_database", "Breeding program must be in the database.") |h %></li>
                        <li><b><% $c->i18n->p("barcode.helper.contact_person_username.7f37aab", "contact_person_username:") |h %></b><% $c->i18n->p("barcode.helper.please_indicate_contact_person_of_each_item_contact_person_username", "Please indicate contact person of each item. Contact person username must be in the database") |h %></li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready( function() {

    jQuery("#upload_catalog_items_button").click(function(){

        jQuery("#upload_catalog_items_format").click(function(){
            jQuery("#upload_catalog_items_format_dialog").modal("show");
        });

        jQuery("#upload_catalog_items_dialog").modal("show");
    });


    jQuery("#upload_catalog_items_submit").click(function(){
        var uploadFile = jQuery("#catalog_items_upload_file").val();
        jQuery('#upload_catalog_items_form').attr("action", "/ajax/catalog/upload_items");
        if (uploadFile === ''){
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.manage_file_share_dump.select_file", "Please select a file") : "Please select a file"));
            return;
        }
        jQuery("#upload_catalog_items_form").submit();
        jQuery("#upload_catalog_items_dialog").modal("hide");
    });

    jQuery("#upload_catalog_items_form").iframePostForm({
        json: true,
        post: function(){
            jQuery("#working_modal").modal("show");
        },
        complete: function(response){
            jQuery("#working_modal").modal("hide");
            if (response.error_string){
                jQuery("#upload_catalog_items_error_display tbody").html('');
                jQuery("#upload_catalog_items_error_display tbody").append(response.error_string);
                jQuery("#upload_catalog_items_error_display").modal("show");
                return;
            }
            if (response.error) {
                alert(response.error);
                return;
            }
            if (response.success) {
                jQuery('#catalog_items_saved_dialog_message').modal("show");
            }
        }
    });

    jQuery("#dismiss_catalog_items_saved_dialog").click(function(){
        location.reload();
    });

});


</script>

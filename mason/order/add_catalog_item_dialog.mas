<%args>
$timestamp => localtime()
$ordering_type => undef
</%args>

<div class="modal fade" id="add_catalog_item_dialog" name="add_catalog_item_dialog" tabindex="-1" role="dialog" aria-labelledby="addCatalogItemDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="addCatalogItemDialog"><% $c->i18n->p("barcode.helper.add_new_catalog_item", "Add New Catalog Item") |h %></h4>
            </div>
            <div class="modal-body" id = "catalog_dialog">
                <div class="container-fluid">
                    <form class="form-horizontal" role="form" method="post" id="add_new_catalog_item_form" name="add_new_catalog_form">
                        <div class="form-group" id = "get_item_name">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("barcode.helper.item_name.b8d89d2", "Item Name:") |h %> </label>
                            <div class="col-sm-9" >
                                <input class="form-control" type="text" id="item_name" name="item_name" placeholder="<% $c->i18n->p("barcode.helper.item_name_must_be_in_the_database", "Item name must be in the database") |h %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("barcode.helper.category.8a9c378", "Category:") |h %> </label>
                            <div class="col-sm-9">
                                <select class="form-control" id="item_category">
                                    <option value=""><% $c->i18n->p("barcode.helper.please_select_a_category", "Please select a category") |h %></option>
                                    <option value="released variety"><% $c->i18n->p("barcode.helper.released_variety", "released variety") |h %></option>
                                    <option value="pathogen assay "><% $c->i18n->p("barcode.helper.pathogen_assay", "pathogen assay") |h %></option>
                                    <option value="control"><% $c->i18n->p("barcode.helper.control", "control") |h %></option>
                                    <option value="transgenic line"><% $c->i18n->p("barcode.helper.transgenic_line", "transgenic line") |h %></option>
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("barcode.helper.additional_info.fc45f9a", "Additional Info:") |h %> </label>
                            <div class="col-sm-9" >
                                <input class="form-control" id="item_additional_info" placeholder="<% $c->i18n->p("seedlot.optional", "optional") |h %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("barcode.helper.material_source.765771b", "Material Source:") |h %> </label>
                            <div class="col-sm-9" >
                                <input class="form-control" id="item_material_source" placeholder="<% $c->i18n->p("seedlot.optional", "optional") |h %>">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("cross.ui.breeding_program.2c9b17e", "Breeding Program:") |h %> </label>
                            <div class="col-sm-9" >
                                <div id="item_breeding_program_div"></div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label"><% $c->i18n->p("barcode.helper.contact_person_username.25d672d", "Contact Person Username:") |h %> </label>
                            <div class="col-sm-9" >
                                <input class="form-control" id="contact_person_name" placeholder="<% $c->i18n->p("barcode.helper.please_provide_contact_person_username", "Please provide contact person username") |h %>">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="reset" id="close_add_item_dialog" name="close_add_item_dialog" class="btn btn-default" ><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                    <button id="submit_catalog_item" type="button" class="btn btn-primary" ><% $c->i18n->p("global.search_wizard.add", "Add") |h %></button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="add_item_saved_dialog_message" name="add_item_saved_dialog_message" tabindex="-1" role="dialog" aria-labelledby="addItemSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addItemSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("barcode.helper.the_catalog_item_was_saved_successfully", "The catalog item was saved successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_item_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>
jQuery(document).ready(function(){

    jQuery("#add_catalog_item_button").click( function() {

        jQuery("#item_name").autocomplete({
            source: '/ajax/stock/accession_or_seedlot_or_population_or_vector_construct_autocomplete',
            appendTo : catalog_dialog
        });

        jQuery('#add_catalog_item_dialog').modal('show');
        get_select_box('breeding_programs', 'item_breeding_program_div', { 'name' : 'item_breeding_program_id', 'id' : 'item_breeding_program_id', 'empty': 1 });

    });

    jQuery('#submit_catalog_item').click( function() {
        var name = jQuery('#item_name').val();
        var category = jQuery('#item_category').val();
        var additional_info = jQuery('#item_additional_info').val();
        var material_source = jQuery('#item_material_source').val();
        var breeding_program = jQuery('#item_breeding_program_id').val();
        var contact_person = jQuery('#contact_person_name').val();

        if (name == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlots.ui.please_provide_a_name", "Please provide a name") : "Please provide a name"));
            return;
        }
        if (category == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.please_select_a_category", "Please select a category") : "Please select a category"));
            return;
        }
        if (breeding_program == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("locations.select.program", "Please select a program") : "Please select a program"));
            return;
        }
        if (contact_person == '') {
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.please_provide_contact_username", "Please provide contact username") : "Please provide contact username"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/catalog/add_item',
            dataType: "json",
            type: 'POST',
            data : {
                'name' : name,
                'category': category,
                'additional_info': additional_info,
                'material_source': material_source,
                'breeding_program_id': breeding_program,
                'contact_person': contact_person,
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#add_catalog_item_dialog').modal('hide');
                    jQuery('#add_item_saved_dialog_message').modal("show");
                }
                if (response.error_string) {
                    alert(response.error_string);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.an_error_occurred_adding_item", "An error occurred adding item") : 'An error occurred adding item'));
            }
        });
    });

    jQuery("#close_add_item_dialog").click(function() {
        jQuery("#add_catalog_item_dialog").modal('hide');
        location.reload();
    });

    jQuery("#dismiss_item_saved_dialog").click(function(){
        location.reload();
    });

});

</script>

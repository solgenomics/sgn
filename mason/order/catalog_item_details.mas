<%args>
$item_id
$item_name
$species
$variety
$item_type
$category
$material_source
$material_type
$additional_info
$breeding_program
$program_id
$availability => undef
$contact_person_username
$item_prop_id
$check_vendor_role
$image => undef
$selected_image_id => undef
$main_page
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables'] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>

<& /page/page_title.mas, title => "Catalog Item Details for: $item_name" &>

<&| /page/info_section.mas, anchor_title => "Details", title=>HTML::Entities::encode_entities($c->i18n->p("accession.stock.trials.header.details", "Details")),  collapsible => 1, collapsed=>0 &>

    <div class="panel panel-default">
        <div class="panel-body">
            <div class="row">
                <div class="col-sm-6">
                    <table class="table table-bordered table-hover">
                        <tr><td><b><% $c->i18n->p("barcode.helper.item_type.a4a4ccf", "Item Type") |h %></b></td><td><% $item_type %> </td></tr>
                        <tr><td><b><% $c->i18n->p("cross.species", "Species") |h %></b></td><td><% $species %> </td></tr>
                        <tr><td><b><% $c->i18n->p("seedlot.variety", "Variety") |h %></b></td><td><% $variety %> </td></tr>
                        <tr><td><b><% $c->i18n->p("seedlot_split.ui.material_type", "Material Type") |h %></b></td><td><% $material_type %> </td></tr>
                        <tr><td><b><% $c->i18n->p("barcode.helper.category.df1f580", "Category") |h %></b></td><td><% $category %></td></tr>
                        <tr><td><b><% $c->i18n->p("accession.stock.section.additional_info", "Additional Info") |h %></b></td><td><% $additional_info %></td></tr>
                        <tr><td><b><% $c->i18n->p("barcode.helper.material_source.43ceb28", "Material Source") |h %></b><td><% $material_source %></td></tr>
                        <tr><td><b><% $c->i18n->p("global.index_logged_in_user.breeding_program", "Breeding Program") |h %></b></td><td><% $breeding_program %></td></tr>
                        <tr><td><b><% $c->i18n->p("barcode.helper.availability.797abcb", "Availability") |h %></b></td><td><% $availability %></td></tr>
                        <tr><td><b><% $c->i18n->p("barcode.helper.contact_person_username.2319253", "Contact Person Username") |h %></b></td><td><% $contact_person_username %></td></tr>
                        <tr><td><b><% $c->i18n->p("barcode.helper.main_detail_page", "Main Detail Page") |h %></b></td><td><% $main_page %></td></tr>
                    </table>
                </div>
                <div class="col-sm-6">
                    <br /><br />
% if ($selected_image_id) {
                    <% $image %>
% }
                    <br /><br />
                </div>
            </div>
            <td><a href="/catalog/view"><p><% $c->i18n->p("barcode.helper.go_to_catalog_page", "Go to Catalog Page") |h %></p></a></td>
        </div>
    </div>
</&>

% if ($check_vendor_role == 1) {
    <&| /page/info_section.mas, anchor_title => 'Edit or Remove Catalog Item', title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.edit_or_remove_catalog_item", 'Edit or Remove Catalog Item')), collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class="panel panel-default">
                <div class="panel-body">
                    <button id="edit_catalog_item_link" class="btn btn-primary btn-sm"><% $c->i18n->p("barcode.helper.edit_catalog_item", "Edit Catalog Item") |h %></button>
                    <!--
                    <button id="delete_catalog_item_button" class="btn btn-primary btn-sm">Delete Catalog Item</button>
                    -->
                </div>
            </div>
        </div>
    </&>
    <&| /page/info_section.mas, anchor_title => 'Add or Remove Image', title => HTML::Entities::encode_entities($c->i18n->p("barcode.helper.add_or_remove_image", 'Add or Remove Image')), collapsible=>1, collapsed=>0 &>
        <div class = "well well-sm">
            <div class = "panel panel-default">
                <div class = "panel-body">
                    <div style="overflow:scroll">
                        <table id = "catalog_item_images_table" class="table table-hover table-striped">
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </&>
% }

<div class="modal fade" id="delete_item_success_dialog" name="order_saved_dialog" tabindex="-1" role="dialog" aria-labelledby="deleteItemSuccessDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="deleteItemSuccessDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("barcode.helper.the_catalog_item_was_delete", "The catalog item was delete.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_deleted_message_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="add_image_message_dialog" name="add_image_message_dialog" tabindex="-1" role="dialog" aria-labelledby="addImageMessageDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="addImageMessageDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("barcode.helper.the_image_was_added_successfully", "The image was added successfully.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_add_image_message_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="remove_image_message_dialog" name="remove_image_message_dialog" tabindex="-1" role="dialog" aria-labelledby="removeImageMessageDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="removeImageMessageDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("barcode.helper.the_image_was_removed_from_the_catalog_item", "The image was removed from the catalog item.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_remove_image_message_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("seedlots.ui.close_reload", "Close & Reload") |h %></button>
            </div>
        </div>
    </div>
</div>

<& /order/edit_catalog_details_dialog.mas, item_name => $item_name, item_id => $item_id, species => $species, variety => $variety, item_type => $item_type, category => $category, material_type => $material_type, material_source => $material_source, breeding_program => $breeding_program, program_id => $program_id, additional_info => $additional_info, contact_person_username => $contact_person_username, item_prop_id => $item_prop_id, availability => $availability &>


<script>

jQuery(document).ready( function() {

    var selected_image_id = "<% $selected_image_id %>";

    var item_images_table = jQuery('#catalog_item_images_table').DataTable( {
            'autoWidth': false,
            'order': false,
            'searching': false,
            'ajax': '/ajax/catalog/image_list/' + <% $item_id %>,
            'columns': [
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.library_search.name", "Name") : "Name")).html(), "data": "image_name" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.image", "Image") : "Image")).html(), "data": "small_image" },
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_cxgn_dataset.table.description", "Description") : "Description")).html(), "data": "image_description"},
                { title: jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.add_or_remove_image", "Add or Remove Image") : "Add or Remove Image")).html(), "data": "null", "render": function ( data, type, row ) {
                    if (row.image_id == selected_image_id) {
                        return ("<a onclick='removeImage()' >" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.dataset_publish.action.remove", "Remove") : "Remove")).html() + "</a>")
                    } else {
                        return "<a onclick='addImage(\""+row.image_id+("\")' >" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.search_wizard.add", "Add") : "Add")).html() + "</a>")
                    }
                }},
            ],
    });

    jQuery('#delete_catalog_item_button').click( function() {
        var response = confirm((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.really_delete_this_catalog_item_this_action_cannot_be_undone", "Really delete this catalog item? This action cannot be undone.") : 'Really delete this catalog item? This action cannot be undone.'));
        if (response) {
            jQuery.ajax({
                url: '/ajax/catalog/delete',
                dataType: "json",
                type: 'POST',
                data : {'item_prop_id' : <% $item_prop_id %>},
                beforeSend: function(response){
                    jQuery('#working_modal').modal('show');
                },
                success: function(response) {
                    jQuery('#working_modal').modal('hide');
                    if (response.success == 1) {
                        jQuery('#delete_item_success_dialog').modal('show');
                    }
                    if (response.error_string) {
                        alert(response.error_string);
                    }
                }
            });
        }
    });

    jQuery("#dismiss_deleted_message_dialog").click(function(){
        location.reload();
    });

});


function addImage(image_id){

    var item_name = '<% $item_name %>';
    var item_prop_id = '<% $item_prop_id %>';
    var image_id = image_id;

    jQuery.ajax({
        url: '/ajax/catalog/edit_image',
        dataType: "json",
        type: 'POST',
        data : {
            'item_name': item_name,
            'item_prop_id': item_prop_id,
            'image_id': image_id
        },

        beforeSend: function(response){
            jQuery('#working_modal').modal('show');
        },
        success: function(response) {
            jQuery('#working_modal').modal('hide');
            if (response.success == 1) {
                jQuery('#add_image_message_dialog').modal('show');
            }
            if (response.error_string) {
                alert(response.error_string);
            }
        },
        error: function(response){
            jQuery('#working_modal').modal('hide');
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.an_error_occurred_adding_image", "An error occurred adding image") : 'An error occurred adding image'));
        }
    });

    jQuery("#dismiss_add_image_message_dialog").click(function(){
        location.reload();
    });

}


function removeImage(){

    var item_name = '<% $item_name %>';
    var item_prop_id = '<% $item_prop_id %>';
    var image_id = undefined;

    jQuery.ajax({
        url: '/ajax/catalog/edit_image',
        dataType: "json",
        type: 'POST',
        data : {
            'item_name': item_name,
            'item_prop_id': item_prop_id,
            'image_id': image_id
        },
        beforeSend: function(response){
            jQuery('#working_modal').modal('show');
        },
        success: function(response) {
            jQuery('#working_modal').modal('hide');
            if (response.success == 1) {
                jQuery('#remove_image_message_dialog').modal('show');
            }
            if (response.error_string) {
                alert(response.error_string);
            }
        },
        error: function(response){
            jQuery('#working_modal').modal('hide');
            alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.an_error_occurred_removing_image", "An error occurred removing image") : 'An error occurred removing image'));
        }
    });

    jQuery("#dismiss_remove_image_message_dialog").click(function(){
        location.reload();
    });

}


</script>

<%once>
use HTML::Entities ();
</%once>

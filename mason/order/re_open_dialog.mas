<%args>
$order_id
$order_to
</%args>


<div class="modal fade" id="requester_re_open_order_dialog" name="requester_re_open_order_dialog" tabindex="-1" role="dialog" aria-labelledby="requesterReOpenOrderDialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="requesterReOpenOrderDialog"><% $c->i18n->p("barcode.helper.re_open_order", "Re-Open Order") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="requester_re_open_order_div">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
                <button id="requester_re_open_order_submit" type="button" class="btn btn-primary" ><% $c->i18n->p("global.manage_file_share_dump.submit", "Submit") |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="re_open_saved_dialog" name="re_open_saved_dialog" tabindex="-1" role="dialog" aria-labelledby="reOpenSavedDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("global.dataset_publish.close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="reOpenSavedDialog"><% $c->i18n->p("cross.ui.success", "Success") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <p>
                        <span class="ui-icon ui-icon-circle-check" style="float: left; margin: 0 7px 50px 0;"></span>
                        <% $c->i18n->p("barcode.helper.the_order_has_been_re_opened", "The order has been re-opened.") |h %>
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button id="dismiss_re_open_saved_dialog" type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("global.dataset_publish.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>


<script>

jQuery(document).ready( function() {
    var order_id = "<% $order_id %>";
    var order_to = "<% $order_to %>";

    jQuery('#requester_re_open_link').click(function(){
        requesterReOpen(order_id, order_to)
    });

    jQuery('#requester_re_open_order_submit').click( function() {
        var order_id = jQuery('#requester_re_open_order_id').val();
        var re_open_status = jQuery('#requester_re_open_status').val();
        var requester_re_open_comments = jQuery('#requester_re_open_comments').val();
        if (!requester_re_open_comments) {
            alert ((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.please_add_comments_for_re_opening_the_order", "Please add comments for re-opening the order") : "Please add comments for re-opening the order"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/order/update',
            dataType: "json",
            type: 'POST',
            data : {
                'order_id' : order_id,
                'new_status': re_open_status,
                'contact_person_comments': requester_re_open_comments
            },
            beforeSend: function(response){
                jQuery('#working_modal').modal('show');
            },
            success: function(response) {
                jQuery('#working_modal').modal('hide');
                if (response.success == 1) {
                    jQuery('#re_open_saved_dialog').modal('show');
                    jQuery('#requester_re_open_order_dialog').modal('hide');
                }
                if (response.error_string) {
                    alert(response.error);
                }
            },
            error: function(response){
                jQuery('#working_modal').modal('hide');
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.an_error_occurred_re_opening_the_order", "An error occurred re-opening the order") : 'An error occurred re-opening the order'));
            }
        });
    });

    jQuery("#dismiss_re_open_saved_dialog").click(function(){
        location.reload();
    });

});


function requesterReOpen(order_id, order_to){
    var re_open = "re-opened"
    var html = '';
    html += ("<form class=\"form-horizontal\"><div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.order_number.a252e43", "Order Number:") : "Order Number:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"requester_re_open_order_id\" name=\"requester_re_open_order_id\" value=\"")+order_id+'" disabled></div></div>';
    html += ("<div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("barcode.helper.vendor", "Vendor:") : "Vendor:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"re_open_order_to\" name=\"re_open_order_to\" value=\"")+order_to+'" disabled></div></div>';
    html += ("<div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("global.est.status", "Status:") : "Status:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"requester_re_open_status\" name=\"requester_re_open_status\" value=\"")+re_open+'" disabled></div></div>';
    html += ("<div class=\"form-group\"><label class=\"col-sm-3 control-label\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.comments", "Comments:") : "Comments:")).html() + " </label><div class=\"col-sm-9\" ><input class=\"form-control\" id=\"requester_re_open_comments\" placeholder=\"" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("seedlot_split.ui.required", "Required") : "Required")).html() + "\"></div></div></form>")

    jQuery('#requester_re_open_order_div').html(html);
    jQuery('#requester_re_open_order_dialog').modal('show');

}

</script>

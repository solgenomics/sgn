
<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("help.datasets.title", "Dataset Help")) &>

<p><b><% $c->i18n->p("help.datasets.working_heading", "Working with Datasets") |h %></b></p>

<p><% $c->i18n->p("help.datasets.working_text", "Datasets are collections of identifiers that are stored in\nthe database. Datasets can be composed of accessions, plots, traits, locations,\nand trials. Datasets are attached to the individual user’s account, and can\nonly be created and seen by the user while logged in. SGN databases use \nDatasets in analysis tools on the website such as Wizard, GWAS, GS,\nHeritability, and Stability tools.") |h %></p>

<p><b><% $c->i18n->p("help.datasets.create_heading", "Creating Datasets") |h %></b></p>

<p><% $c->i18n->p("help.datasets.create_text", "Datasets are generated in the Wizard. Up to 4 identifiers\ncan be selected. First select the categories and entries in each column. In\nthis example we have selected Trials, Accessions, and Genotyping Protocols.\nThen enter a name in the “Create New Dataset” section. In this example we have\nused “Tinker QTL 2021”. After creating the dataset, you can make it public for\nothers to use by first selecting the dataset using the “Load Dataset”\nlist then selecting the “Make Public” button.") |h %></p>
<img src="/static/documents/help/screenshots/DatasetHelpImage001.png" width="1000px">
<img src="/static/documents/help/screenshots/DatasetHelpImage002.png" width="600px">

<p><b><% $c->i18n->p("help.datasets.retrieve_heading", "Retrieving Datasets") |h %></b></p>

<p><% $c->i18n->p("help.datasets.retrieve_text", "To retrieve a dataset in the Wizard, select the dataset in\nthe “Load Dataset” input then select the “Load” button. This will populate the\ncolumns in the Wizard and then allow you to download and analyze the dataset.") |h %></p><br>
<img src="/static/documents/help/screenshots/DatasetHelpImage003.png" width="600px">

<p><b><% $c->i18n->p("help.datasets.search_heading", "Searching Datasets") |h %></b></p>

<p><% $c->i18n->p("help.datasets.search_text", "To search for a dataset, select the “Datasets” link in the\ntoolbar at the top right of the website. Selecting the Dataset name will\ngive you a Dataset Detail page") |h %></p><br>
<img src="/static/documents/help/screenshots/DatasetHelpImage004.png" width="800px">
<img src="/static/documents/help/screenshots/DatasetHelpImage005.png" width="800px">

<br><br>
<p><% $c->i18n->p("help.datasets.publications_text", "Datasets can also be used in publications for linking available\ndata. Copy the URL from the detail page found in the Search Datasets\npage.") |h %></p>

<%once>
use HTML::Entities ();
</%once>

<%args>
$contact_form_human_answer => ''
$contact_form_human_question => ''
$website_name => ''
$email_address_to_display => ''
</%args>

<& "/page/page_title.mas", title => $c->i18n->p("help.contact.page_title", "Contact %{site}", { site => $website_name // '' }) &>

<div class="container-fluid">
    <div class="well">

    <div id="contact_form_return_message">
    </div>

% #The form
  <form class="form-horizontal" name="contactForm">

% #Uses Perl to print out the fields with similar HTML tags
<%perl>
my $infoNeeded = ["name", "email", "subject", ];
my %contact_fields = (
    "name" => $c->i18n->p("help.contact.field.name", "Name"),
    "email" => $c->i18n->p("help.contact.field.email", "Email"),
    "subject" => $c->i18n->p("help.contact.field.subject", "Subject"),
);

</%perl>

% foreach my $info_category (@$infoNeeded) {
    <div class="form-group">
      <label class="col-sm-2 control-label"><% $contact_fields{$info_category} |h %>* :
      </label>
      <div class="col-sm-10">
        <input type="text" class="form-control" value="" name="<% $info_category %>"></input>
      </div>
    </div>
% }

    <div class="form-group">
      <label class="col-sm-2 control-label"><% $c->i18n->p("help.contact.field.body", "Body") |h %>* :
      </label>
      <div class="col-sm-10">
        <textarea rows="12" class="form-control" name="body"></textarea>
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-2 control-label"><% $c->i18n->p("help.contact.challenge", "What is ") |h %><br/><% $contact_form_human_question %>?* :
      </label>
      <div class="col-sm-10">
        <input type="text" class="form-control" value="" name="contact_form_human_answer"></input>
      </div>
    </div>
    <div class="form-group">
      <label class="col-sm-2 control-label"></label>
      <div class="col-sm-10">
        <h5 valign="middle" style="color:red; font-size:90%; font-style:italic;"><% $c->i18n->p("help.contact.required_prefix", "Fields Marked With ") |h %><% '"*"' |h %><% $c->i18n->p("help.contact.required_suffix", " Are Required.") |h %></h5>
      </div>
    </div>
    <hr>
    <button style="float:right" type="submit" class="btn btn-primary btn-lg" id="contact_form_submit"><% $c->i18n->p("help.contact.submit", "Submit") |h %></button>
    <br/><br/>

  </form>
  </div>

  <br/>
  <h2><% $c->i18n->p("help.contact.title", "Contact Us") |h %></h2>
  <br/>
  <table class="table table-hover table-bordered">
     <tbody>
      <tr>
        <td><b><% $c->i18n->p("help.contact.field.email", "Email") |h %></b></td>
	<td><% $c->i18n->p("help.contact.deactivated_email", "Note that the contact email address %{email} has been deactivated due to extreme levels of spam. ", { email => $email_address_to_display // '' }) |h %><br/><% $c->i18n->p("help.contact.use_form", "Use this contact form instead.") |h %></td>
      </tr>
      <tr>
        <td><b><% $c->i18n->p("help.contact.mailing_address", "Mailing Address") |h %></b></td>
	<td>Sol Genomics Network<br />
	c/o Lukas Mueller<br />
	Boyce Thompson Institute<br />
	533, Tower Road<br />
	Ithaca, NY 14853<br />
	USA<br /></td>
      </tr>
      <!-- tr>
        <td><b>Mailing List</b></td>
        <td>To stay informed of developments at SGN you can subscribe to our <a href="http://rubisco.sgn.cornell.edu/mailman/listinfo/sgn-announce/">mailing list</a>. <br/>This is a low-volume list (usually no more than 2 messages per month).</td>
      </tr -->
    </tbody>
  </table>

  </div>
</div>

<div class="modal fade" id="submit_contact_form_response" name="submit_contact_form_response" tabindex="-1" role="dialog" aria-labelledby="submitContactResponseDialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align: center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p("help.contact.aria_close", "Close") |h %>"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="submitContactResponseDialog"><% $c->i18n->p("help.contact.form_title", "Contact Form") |h %></h4>
            </div>
            <div class="modal-body">
                <div class="container-fluid">
                    <div id="submit_contact_form_response_message">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal"><% $c->i18n->p("help.contact.close", "Close") |h %></button>
            </div>
        </div>
    </div>
</div>

<script>

jQuery(document).ready(function () {

    jQuery('#contact_form_submit').on('click',function (e){
        var subject = jQuery('input[name="subject"]').val();
        var name = jQuery('input[name="name"]').val();
        var email = jQuery('input[name="email"]').val();
        var body = jQuery('textarea[name="body"]').val();
        var challenge_answer = jQuery('input[name="contact_form_human_answer"]').val();
        if (challenge_answer != <% $contact_form_human_answer %>){
            jQuery('#submit_contact_form_response_message').html((window.SGN && window.SGN.i18n ? SGN.i18n.p("help.contact.human_check", "Please prove you are a human by answering the simple math question.") : "Please prove you are a human by answering the simple math question."));
            jQuery('#submit_contact_form_response').modal('show');
        } else if (subject == '' || !subject){
            jQuery('#submit_contact_form_response_message').html((window.SGN && window.SGN.i18n ? SGN.i18n.p("help.contact.validation.subject", "Subject is required. Please fill in this field.") : "Subject is required. Please fill in this field."));
            jQuery('#submit_contact_form_response').modal('show');
        } else if (name == '' || !name){
            jQuery('#submit_contact_form_response_message').html((window.SGN && window.SGN.i18n ? SGN.i18n.p("help.contact.validation.name", "Name is required. Please fill in this field.") : "Name is required. Please fill in this field."));
            jQuery('#submit_contact_form_response').modal('show');
        } else if (email == '' || !email){
            jQuery('#submit_contact_form_response_message').html((window.SGN && window.SGN.i18n ? SGN.i18n.p("help.contact.validation.email", "Email is required. Please fill in this field.") : "Email is required. Please fill in this field."));
            jQuery('#submit_contact_form_response').modal('show');
        } else if (body == '' || !body){
            jQuery('#submit_contact_form_response_message').html((window.SGN && window.SGN.i18n ? SGN.i18n.p("help.contact.validation.body", "Body is required. Please fill in this field.") : "Body is required. Please fill in this field."));
            jQuery('#submit_contact_form_response').modal('show');
        } else {
            jQuery.ajax ( {
                url : '/ajax/contact/submit',
                type: "POST",
                beforeSend: function(){
                    jQuery('#working_modal').modal('show');
                },
                data: {
                    "title": subject,
                    "body": body + '\n\nFrom: ' + name + '\nEmail: ' + email,
                    "security_answer": <% $contact_form_human_answer %>,
                    "security_attempt": challenge_answer
                },
                success: function(response){
                    //console.log(response);
                    jQuery('#working_modal').modal('hide');
                    var html = '';
                    var html_return;
                    if (response.error){
                        html = response.error;
                        html_return = ("<div class=\"panel panel-danger\"><div class=\"panel-heading\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("help.contact.error_heading", "Error") : "Error")).html().replace(/"/g, "&quot;").replace(/'/g, "&#39;") + "</div><div class=\"panel-body\">")+html+'</div></div>';
                    } else {
                        html = (window.SGN && window.SGN.i18n ? SGN.i18n.p("help.contact.thanks", "Thank you for your message. We will reply as soon as possible.") : "Thank you for your message. We will reply as soon as possible.");
                        html_return = ("<div class=\"panel panel-success\"><div class=\"panel-heading\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("help.contact.success_heading", "Success") : "Success")).html().replace(/"/g, "&quot;").replace(/'/g, "&#39;") + "</div><div class=\"panel-body\">")+html+'</div></div>';
                    }
                    jQuery('#contact_form_return_message').html(html_return);
                    jQuery('#submit_contact_form_response_message').html(html);
                    jQuery('#submit_contact_form_response').modal('show');
                },
                error: function(response){
                    console.log(response);
                    jQuery('#working_modal').modal('hide');
                    var html = (window.SGN && window.SGN.i18n ? SGN.i18n.p("help.contact.posting_error_prefix", "Error posting message! Please contact us. : ") : "Error posting message! Please contact us. : ")+response;
                    var html_return = ("<div class=\"panel panel-danger\"><div class=\"panel-heading\">" + jQuery("<span>").text((window.SGN && window.SGN.i18n ? SGN.i18n.p("help.contact.error_heading", "Error") : "Error")).html().replace(/"/g, "&quot;").replace(/'/g, "&#39;") + "</div><div class=\"panel-body\">")+html+'</div></div>';
                    jQuery('#contact_form_return_message').html(html_return);
                    jQuery('#submit_contact_form_response_message').html(html);
                    jQuery('#submit_contact_form_response').modal('show');
                }
            });
        }
        e.preventDefault();
    });

});

</script>

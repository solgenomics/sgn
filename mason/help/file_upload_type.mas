<%args>
  $type => undef
  $optional_column => undef
</%args>

<div class="file_upload_type">
  <span class="file_icon glyphicon glyphicon-file"></span>
  <div>
    <p>
      <% $c->i18n->p('upload.formats.supported', "%{type} may be uploaded using any of the supported file types: MS Excel (%{xls} or %{xlsx}), comma-separated file (%{csv}), LibreOffice / OpenOffice OpenDocument spreadsheet (%{ods}), tab-delimited file (%{txt} or %{tsv}), or semicolon-separated file (%{ssv}).", {type => $upload_type, xls => '.xls', xlsx => '.xlsx', csv => '.csv', ods => '.ods', txt => '.txt', tsv => '.tsv', ssv => '.ssv'}) |h %>
    </p>
% if ($optional_column) {
    <p>
      <% $c->i18n->p('upload.formats.optional_columns', 'Optional columns may be left out, if not used in your data.') |h %>
    </p>
% }
  </div>
</div>

<style>
  .file_upload_type {
    display: flex;
    align-items: center;
    gap: 15px;
    margin: 15px;
    padding: 5px;
    border-radius: 5px;
    background: rgba(252, 211, 77, 0.5);
    border: 1px solid #d97706;
  }
  .file_icon {
    color: #B96F1A;
    font-size: 200%;
  }
</style>

<%init>
my $upload_type = defined($type) ? $type : $c->i18n->p('upload.formats.default_type', 'Data');
</%init>

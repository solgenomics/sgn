<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("help.index.title", "Breedbase Help")) &>

<div><% $c->i18n->p("help.index.intro", "Breedbase is a comprehensive breeding management and analysis software. It can be used to design field layouts, collect ") |h %><a href="https://phenoapps.org"><% $c->i18n->p("help.index.phenotyping_link", "phenotypic and other information using Phenoapps software") |h %></a><% $c->i18n->p("help.index.intro_tail", ", support the collection of genotyping samples in a field, store large amounts of high density genotypic information, and provide Genomic Selection related analyses and predictions. Breedbase supports the ") |h %><a href="https://brapi.org"><% $c->i18n->p("help.index.brapi_standard", "BrAPI standard") |h %></a>.
</div>
<br />
<div class="panel panel-default">
<div class="panel-body">
<ul>
<li><% $c->i18n->p("help.index.manual_prefix", "The complete Breedbase help is available from the ") |h %><a href="https://solgenomics.github.io/sgn/" target="_new"><% $c->i18n->p("help.index.manual_link", "Breedbase and SGN manual") |h %></a>.</li>
<li><% $c->i18n->p("help.index.video_prefix", "Video Tutorials are available on ") |h %><a href="https://www.youtube.com/channel/UC3jrvvzGKKEHzOriDBgnj0A" target="_new">YouTube</a>.</li>
<li><% $c->i18n->p("help.index.developer_prefix", "A guide for ") |h %><a href="https://github.com/solgenomics/sgn/wiki/" target="_new"><% $c->i18n->p("help.index.developer_link", "developers is also available") |h %></a>.</li>
</ul>
</div>
</div>

<div class="panel panel-default">
<div class="panel-body">

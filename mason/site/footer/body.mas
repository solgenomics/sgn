<%init>
  use HTML::Entities ();
  my $footer_location = HTML::Entities::encode_entities(
      $c->i18n->p('footer.location', '%{site_name} is located at the %{institute}.', { site_name => "__SGN_SITE_NAME__", institute => "__SGN_INSTITUTE_LINK__" })
  );
  my $site_brand = '<span style="font-face:arial;font-size:10pt;color:darkgreen;font-weight:light;">BREE<b>DB</b>ASE</span>';
  my $institute_link = '<a href="https://btiscience.org">Boyce Thompson Institute</a>';
  $footer_location =~ s/__SGN_SITE_NAME__/$site_brand/g;
  $footer_location =~ s/__SGN_INSTITUTE_LINK__/$institute_link/g;
  my $tag;
    my $commit;
    my $updated;

    system("git -C . rev-parse 2>/dev/null");
    my $isGit = `echo $?`;
    if($isGit == 0) {
        $tag = `git describe --abbrev=0 --tags`;
        $commit = `git rev-parse --short HEAD`;
        $updated = `git log -1 --format=%cd`;
    } else {
        $tag = $ENV{VERSION};
        $updated = $ENV{BUILD_DATE};
    }
</%init>

<!-- BEGIN SITE SPECIFIC FOOTER. -->

<div id="pagefooter" class="navbar navbar-default" style="margin-top:80px;margin-bottom:0px;min-height:200px">

  <br />
    <div class="container-fluid">
      <div class="row">
          <div class="col-12 col-md-9">
            <% $footer_location %><br />
            <a href="https://btiscience.org"><img src="/static/img/bti_logo_2024.png" width="200" alt="Boyce Thompson Institute"></a>
          </div>


          <div class="col-12 col-md-3">
            <div class="git-version">
              <p>
                <strong><% $c->i18n->p('footer.version', 'Version') |h %></strong>
                <br />
% if($isGit == 0) {
                <span class="git-version-commit"><a href="https://github.com/solgenomics/sgn/commits/<% $commit |h %>"><% $commit |h %></a></span>&nbsp;
                <span class="git-version-tag"><a href="https://github.com/solgenomics/sgn/commits/<% $tag |h %>"><% $tag |h %></a></span>
% } else {
                <span class=""><% $tag |h %></span>&nbsp;
% }
                <br />
                <span class="git-version-updated"><% $updated |h %></span>
		<br /><br />
		<a target="_new" href="https://brapi.org/"><img src="/documents/img/brapi-logo.svg" width="160" alt="BrAPI" /></a>
              </p>
            </div>
          </div>
        </div>
    </div>

</div>



<style>
  .git-version {
    display: inline-block;
    margin-top: 10px;
  }
  .git-version p {
    color: #aaa;
    font-size: 90%;
  }
  .git-version a {
    color: #aaa
  }
  span.git-version-tag {
    float: right;
  }
</style>

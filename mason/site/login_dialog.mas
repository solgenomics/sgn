
<!-- Translation labels remain readable inside the native narrow dialogs. -->
<style>
  #site_login_dialog .btn,
  #site_login_forgot_username_dialog .btn,
  #site_login_reset_password_dialog .btn,
  #site_login_new_user_dialog .btn,
  #post_email_reset_password_dialog .btn {
    max-width: 100%;
    white-space: normal;
    overflow-wrap: anywhere;
  }
  /* Bootstrap's icon cells have 1% width; their buttons need intrinsic width. */
  #site_login_dialog .input-group-btn > .btn {
    max-width: none;
    white-space: nowrap;
    overflow-wrap: normal;
  }
  #site_login_dialog .modal-title,
  #site_login_forgot_username_dialog .modal-title,
  #site_login_reset_password_dialog .modal-title,
  #site_login_new_user_dialog .modal-title,
  #post_email_reset_password_dialog .modal-title {
    overflow-wrap: anywhere;
  }
</style>

<!-- Login Dialog -->

<%args>
$goto_url => '/'
</%args>

<%init>
    use HTML::Entities ();
    use JSON::PP ();
    my $directory_notice = HTML::Entities::encode_entities(
        $c->i18n->p('auth.registration.existing_account_notice', 'Before creating a new account, please check if you already have an account using the %{directory_search}.', { directory_search => "__SGN_DIRECTORY_SEARCH_LINK__" })
    );
    my $directory_anchor = '<a href="/search/direct_search.pl?search=directory">'
        . HTML::Entities::encode_entities($c->i18n->p('auth.registration.directory_search', 'directory search')) . '</a>';
    $directory_notice =~ s/__SGN_DIRECTORY_SEARCH_LINK__/$directory_anchor/g;
    my $join_breeding_programs = eval{ $c->get_conf('user_registration_join_breeding_programs') };
    my $random_factor = int rand(5);
    my $minimum = int(rand(10)) * 10**$random_factor;
    my $val_2 = int rand(20);
    my $challenge_question = "$minimum + $val_2";
    my $challenge_answer = $minimum + $val_2;
</%init>

<div class="modal fade" id="site_login_dialog" name="site_login_dialog" tabindex="-1" role="dialog" aria-labelledby="site_login_dialog_title">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align:center">
%  if (!$c->config->{require_login}) {
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('auth.common.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
%  }
                <h3 class="modal-title" id="site_login_dialog_title"><% $c->i18n->p('auth.login.title', 'Login') |h %></h3>
            </div>
            <div class="modal-body">
                <form id="login_form" name="login_form">
                    <div class="container-fluid">

% if ($c->config->{default_login_janedoe}) {
                        <input class="form-control" style="width:240px" id="username" name="username" placeholder="<% $c->i18n->p('auth.login.username', 'Username') |h %>" aria-label="<% $c->i18n->p('auth.login.username', 'Username') |h %>" type="text" value="janedoe"/>
                        <br />
                        <input class="form-control" style="width:240px" id="password" name="password" placeholder="<% $c->i18n->p('auth.login.password', 'Password') |h %>" aria-label="<% $c->i18n->p('auth.login.password', 'Password') |h %>" type="password" value="secretpw"/>
% } else {
                        <div class="input-group">
                            <input class="form-control" id="username" name="username" placeholder="<% $c->i18n->p('auth.login.username', 'Username') |h %>" aria-label="<% $c->i18n->p('auth.login.username', 'Username') |h %>" type="text" tabindex="1" />
                            <span class="input-group-btn">
                                <button id="forgot_username_modal_show" aria-label="<% $c->i18n->p('auth.login.forgot_username', 'Forgot Username') |h %>" class="btn btn-default" type="button" tabindex="4">&nbsp;<span class="glyphicon glyphicon-question-sign"></span>&nbsp;</button>
                            </span>
                        </div>
                        <br />
                        <div class="input-group">
                            <input class="form-control" id="password" name="password" placeholder="<% $c->i18n->p('auth.login.password', 'Password') |h %>" aria-label="<% $c->i18n->p('auth.login.password', 'Password') |h %>" type="password" tabindex="2" />
                            <span class="input-group-btn">
                                <button id="reset_password_modal_show" aria-label="<% $c->i18n->p('auth.login.reset_password', 'Reset Password') |h %>" class="btn btn-default" type="button" tabindex="5">&nbsp;<span class="glyphicon glyphicon-question-sign"></span>&nbsp;</button>
                            </span>
                        </div>
% }
                        <br />

                        <div>
                            <input type="checkbox" id="show_password"> <% $c->i18n->p('auth.login.show_password', 'Show Password') |h %>
                        </div>
                        <br />

                        <input type="hidden" value="<% $goto_url |h %>" id="goto_url" name="goto_url" />

                        <div>
                            <button class="btn btn-default" id="new_user_modal_show" style="float:left" tabindex="6"><% $c->i18n->p('auth.login.new_user', 'New User') |h %></button>
                            <button class="btn btn-primary" id="submit_password" name="submit_password" type="submit" style="float:right" tabindex="3"><% $c->i18n->p('auth.login.title', 'Login') |h %></button>
                        </div>
                    </div>
                </form>
% if ($c->config->{oidc_client}){
                <div class="container-fluid" style="display: grid; margin-top: 20px;">
% for my $provider (sort { $a <=> $b} keys %{$c->config->{oidc_client}}) {
                    <button class="btn btn-default" id="login_with_<% $provider |h %>" name="login_with_<% $provider |h %>" onclick="location.href = <% JSON::PP->new->ascii->encode('/authenticate/oidc/' . $provider . '/login') |h %>;" style="margin-bottom: 20px;">
% if ($provider =~ 'google') {
                        <img style="width:20px" src="/documents/img/Google_logo.png" alt="Google"/>
% } elsif ($provider =~ 'keycloak') {
                        <img style="width:20px" src="/documents/img/Keycloak_logo.png" alt="Keycloak"/>
% }
                        <% ucfirst($provider) |h %>
                    </button>
% }
                </div>
% }
            </div>
            <div class="modal-footer">
%  if (!$c->config->{require_login}) {
                <button id="close_site_login_dialog_button" type="button" class="btn btn-default" data-dismiss="modal" style="float:left"><% $c->i18n->p('auth.common.close', 'Close') |h %></button>
%  }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="site_login_forgot_username_dialog" name="site_login_forgot_username_dialog" tabindex="-1" role="dialog" aria-labelledby="site_login_forgot_username_dialog_title">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align:center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('auth.common.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h3 class="modal-title" id="site_login_forgot_username_dialog_title"><% $c->i18n->p('auth.login.forgot_username', 'Forgot Username') |h %></h3>
            </div>
            <div class="modal-body">
                <div>
                    <% $c->i18n->p('auth.recovery.username_help', 'If you\'ve forgotten your username, enter your email address below. An email will be sent with any account username(s) associated with your email address.') |h %>
                </div>
                <br />
                <div style="white-space:nowrap">
                    <form id="forgot_username_form" name="forgot_username_form" style="white-space:nowrap">
                        <div style="white-space:nowrap; align:center">
                            <label class="textlabel"><% $c->i18n->p('auth.common.email', 'Email Address') |h %></label>
                            <input class="form-control" style="width:200px; white-space:nowrap; float:center" id="forgot_username_email" name="forgot_username_email" /><br />
                            <button type="submit" class="btn btn-primary" id="submit_forgot_username_email" style="float:center" ><% $c->i18n->p('auth.recovery.get_usernames', 'Get Username(s)') |h %></button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_site_login_forgot_username_dialog_button" type="button" class="btn btn-default" data-dismiss="modal" style="float:left"><% $c->i18n->p('auth.common.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="site_login_reset_password_dialog" name="site_login_reset_password_dialog" tabindex="-1" role="dialog" aria-labelledby="site_login_reset_password_dialog_title">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align:center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('auth.common.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h3 class="modal-title" id="site_login_reset_password_dialog_title"><% $c->i18n->p('auth.login.reset_password', 'Reset Password') |h %></h3>
            </div>
            <div class="modal-body">
                <div>
                    <% $c->i18n->p('auth.recovery.password_help', 'To reset your password, please enter your email address. A link will be sent to that address with a link that will enable you to reset your password.') |h %>
                </div>
                <br />
                <div style="white-space:nowrap">
                    <form id="password_reset_form" name="password_reset_form" style="white-space:nowrap">
                        <div style="white-space:nowrap; align:center">
                            <label class="textlabel"><% $c->i18n->p('auth.common.email', 'Email Address') |h %></label>
                            <input class="form-control" style="width:200px; white-space:nowrap; float:center" id="password_reset_email" name="password_reset_email" /><br />
                            <button type="submit" class="btn btn-primary" id="submit_password_reset_email" style="float:center" ><% $c->i18n->p('auth.recovery.get_link', 'Get link') |h %></button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_site_login_reset_password_dialog_button" type="button" class="btn btn-default" data-dismiss="modal" style="float:left"><% $c->i18n->p('auth.common.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="site_login_new_user_dialog" name="site_login_new_user_dialog" tabindex="-1" role="dialog" aria-labelledby="site_login_new_user_dialog_title">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header" style="text-align:center">
                <button type="button" class="close" data-dismiss="modal" aria-label="<% $c->i18n->p('auth.common.close', 'Close') |h %>"><span aria-hidden="true">&times;</span></button>
                <h3 class="modal-title" id="site_login_new_user_dialog_title"><% $c->i18n->p('auth.registration.title', 'Create New User') |h %></h3>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-10 col-sm-offset-1">

                        <form id="new_account_form">
                            <div class="container-fluid">
                                <div class="panel panel-danger">
                                    <div class="panel-heading"><% $c->i18n->p('auth.registration.notice', 'Notice') |h %></div>
                                    <div class="panel-body">
                                        <ul>
                                            <li><% $directory_notice %></li>
                                            <li><% $c->i18n->p('auth.registration.activation_notice', 'A link will be emailed to you. Please click on it to activate the account.') |h %></li>
                                            <li><b><% $c->i18n->p('auth.registration.required_notice', 'All fields are required.') |h %></b></li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="form-horizontal">
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p('auth.registration.first_name', 'First Name: ') |h %></label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="text" name="first_name" value="" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p('auth.registration.last_name', 'Last Name: ') |h %></label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="text" name="last_name" value="" />
                                        </div>
                                    </div>
% if ( $join_breeding_programs ) { 
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p('auth.registration.programs', 'Breeding Program(s): ') |h %></label>
                                        <div class="col-sm-9">
                                            <div id="breeding_programs_div"></div>
                                      </div>
                                    </div>
% } else {  
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p('auth.registration.organization', 'Organization: ') |h %></label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="text" name="organization" value="" />
                                        </div>
                                    </div>
% }
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p('auth.registration.username', 'Username: ') |h %></label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="text" name="username" value="" />
                                            <p class="help-block"><% $c->i18n->p('auth.registration.username_help', 'Username must be at least 7 characters long.') |h %></p>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p('auth.registration.password', 'Password: ') |h %></label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="password" name="password" value="" />
                                            <p class="help-block"><% $c->i18n->p('auth.registration.password_help', 'Password must be at least 7 characters long and different from your username.') |h %></p>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p('auth.registration.confirm_password', 'Confirm Password: ') |h %></label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="password" name="confirm_password" value="" />
                                            <p class="help-block"><% $c->i18n->p('auth.registration.password_help', 'Password must be at least 7 characters long and different from your username.') |h %></p>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p('auth.registration.email', 'Email Address: ') |h %></label>
                                        <div class="col-sm-9">
                                            <input class="form-control" type="text" name="email_address" value="" />
                                            <p class="help-block"><% $c->i18n->p('auth.registration.email_help', 'An email will be sent to this address requiring you to confirm its receipt to activate your account.') |h %></p>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-3 control-label"><% $c->i18n->p('auth.registration.human', 'Are you Human? ') |h %></label>
                                        <div class="col-sm-9">
                                            <p style="padding-top: 7px"><% $c->i18n->p('auth.registration.challenge', 'What is %{question}?', { question => $challenge_question }) |h %></p>
                                            <input class="form-control" type="text" name="challenge_response" value="" />
                                        </div>
                                    </div>

                                    <div align="right">
                                        <button class="btn btn-default btn-lg" type="reset" ><% $c->i18n->p('auth.registration.reset', 'Reset') |h %></button>
                                        <button class="btn btn-primary btn-lg" type="submit" name="create_account" ><% $c->i18n->p('auth.registration.create_account', 'Create Account') |h %></button>
                                    </div>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="close_site_login_new_user_dialog_button" type="button" class="btn btn-default" data-dismiss="modal" style="float:left"><% $c->i18n->p('auth.common.close', 'Close') |h %></button>
            </div>
        </div>
    </div>
</div>

<script>
jQuery(document).ready( function() { 

    jQuery("#site_login_dialog").on('shown.bs.modal', function() {
        jQuery('#show_password').prop('checked', false);
        document.getElementById("password").type = "password";
        jQuery("#username").focus();
    });

    jQuery('#forgot_username_modal_show').click(function() {
        jQuery('#site_login_forgot_username_dialog').modal('show');
    });

    jQuery('#forgot_username_form').submit(function(event) {
        event.preventDefault();
        var form_data = jQuery('#forgot_username_form').serialize();
        jQuery.ajax( {
            url: '/ajax/user/forgot_username',
            headers: {'X-SGN-Locale': document.documentElement.getAttribute('data-sgn-locale') || document.documentElement.lang || 'en'},
            data: form_data,
            error: function(r) { alert((window.SGN && SGN.i18n ? SGN.i18n.p("auth.network_error", "An error occurred! Sorry!") : "An error occurred! Sorry!"));  },
            success: function(r) {
                if (r.error) { alert(r.error); }
                else { 
                    alert(r.message);
                    jQuery('#site_login_forgot_username_dialog').modal('hide');
                }
            }
        });
    });

    jQuery('#reset_password_modal_show').click(function(event){
        event.preventDefault();
        jQuery('#site_login_reset_password_dialog').modal('show');
    });

    jQuery('#password_reset_form').submit( function(event) {
        event.preventDefault();
        var form_data = jQuery('#password_reset_form').serialize();
        jQuery.ajax( {
            url: '/ajax/user/reset_password',
            headers: {'X-SGN-Locale': document.documentElement.getAttribute('data-sgn-locale') || document.documentElement.lang || 'en'},
            data: form_data,
            error: function(r) { alert((window.SGN && SGN.i18n ? SGN.i18n.p("auth.network_error", "An error occurred! Sorry!") : "An error occurred! Sorry!"));  },
            success: function(r) {
                if (r.error) { alert(r.error); }
                else { 
                    alert(r.message);
                    jQuery('#site_login_reset_password_dialog').modal('hide');
                }
            }
        });
    });

    jQuery('#show_password').change(function() {
        var pwd_status = document.getElementById("password");
        console.log('type', pwd_status.type);
        if (pwd_status.type === "password") {
            pwd_status.type = "text";
        } else {
            pwd_status.type = "password"
        }
    });

    jQuery('#new_user_modal_show').click(function(event){
        event.preventDefault();
        jQuery('#site_login_new_user_dialog').modal('show');
    });
    jQuery("#site_login_new_user_dialog").on('shown.bs.modal', function() {
        get_select_box('breeding_programs', 'breeding_programs_div', { 'name': 'breeding_programs', 'id': 'breeding_programs', 'default': -1, 'multiple': 1, 'empty': 1 });
    });

    jQuery('#new_account_form').submit(function(event) {
        event.preventDefault();
        var form_data = jQuery('#new_account_form').serialize();
        //alert(JSON.stringify(form_data));

        // Check bot challenge response and answer
        var response = jQuery("input[name='challenge_response']").val();
        if ( response !== "<% $challenge_answer %>" ) {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("auth.registration.challenge_error", "Are you a bot?  The response to the 'Are you Human?' question did not match the answer.  Try again!") : "Are you a bot?  The response to the 'Are you Human?' question did not match the answer.  Try again!"));
            return;
        }

        jQuery.ajax({
            url: '/ajax/user/new',
            headers: {'X-SGN-Locale': document.documentElement.getAttribute('data-sgn-locale') || document.documentElement.lang || 'en'},
            beforeSend: function(){
                jQuery('#working_modal').modal('show');
            },
            data: form_data,
            success: function(r) {
                jQuery('#working_modal').modal('hide');
                console.log(r);
                if (r.error) { alert(r.error); }
                else {
                    let message = r.message || (window.SGN && SGN.i18n ? SGN.i18n.p("auth.registration.account_added", "New account added. Check your email for the confirmation link - you must confirm your account before you can login.") : "New account added. Check your email for the confirmation link - you must confirm your account before you can login.");
                    alert(message);
                    jQuery('#site_login_new_user_dialog').modal('hide');
                    jQuery('#site_login_dialog').modal('hide');
                }
            }
        });
    });

    jQuery("#username, #password").keydown(function(event) {
        var key = event.keyCode ? event.keyCode : event.which;
        if ( key === 13 ) {
            jQuery("#login_form").submit();
            event.preventDefault();
        }
    });
    jQuery('#login_form').submit( function(event) { 
        event.preventDefault();
        var form_data = jQuery('#login_form').serialize();
        if (!jQuery('#username').val() || !jQuery('#password').val()) { 
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("auth.login.credentials_missing", "Please enter a username and password") : "Please enter a username and password"));
            return;
        }
        jQuery.ajax( { 
            url: '/ajax/user/login',
            headers: {'X-SGN-Locale': document.documentElement.getAttribute('data-sgn-locale') || document.documentElement.lang || 'en'},
            data: form_data,
            error: function(r) { alert((window.SGN && SGN.i18n ? SGN.i18n.p("auth.network_error", "An error occurred! Sorry!") : "An error occurred! Sorry!"));  },
            success: function(r) {
                if (r.error) { 
                    alert(r.error);
                    return;
                }
                if (r.goto_url.match('login')) {
                    location.href='/';
                } else if (r.goto_url && r.goto_url !== "" ) { 
                    location.href=r.goto_url;
                } else {
                    location.href='/';
                }
            }
        });
    });

    // Display New User Dialog if `new_user` query param set
    url = new URL(window.location.href);
    if ( url.searchParams.get('new_user') ) {
        jQuery('#site_login_new_user_dialog').modal('show');
    }
});
</script>


<!-- End login dialog -->

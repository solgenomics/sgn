<%init>
use HTML::Entities ();
</%init>
<%args>
 $organisms         => undef
 $feature_types     => undef
</%args>

<& /util/import_javascript.mas, classes => 'SGN.Search.Feature' &>


<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<div class="container-fluid">

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p('global.search.features.search_genomic_sequences_and_annotations', 'Search genomic sequences and annotations')) &>

<%perl>

use CXGN::Page::FormattingHelpers qw / simple_selectbox_html/;

my $f_type_select = simple_selectbox_html(
  choices   => $feature_types,
  id        => "feature_type_select",
);

my $organism_select = simple_selectbox_html(
  choices  =>  $organisms   ,
  id       => "organism_select",
);

</%perl>

<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p('global.search.features.search', 'Search')), collapsible=>1, collapsed=>0 &>
  <div id="feature_search_form" class="form-horizontal well">
    <div class="row">
      <div class="col-sm-6">
	<div class="form-group form-group-sm">
	  <label class="col-sm-3 control-label"><% $c->i18n->p('global.search.features.organism.596dffa', 'Organism:') |h %> </label>
	  <div class="col-sm-9" >
            <% $organism_select %>
	  </div>
	</div>
      </div>
      <div class="col-sm-6">
	<div class="form-group form-group-sm">
	  <label class="col-sm-3 control-label"><% $c->i18n->p('global.search.features.type.3e685b2', 'Type:') |h %> </label>
	  <div class="col-sm-9" >
            <% $f_type_select %>
	  </div>
	</div>
      </div>
    </div>
    <div class="row">
      <div class="col-sm-6">
	<div class="form-group form-group-sm">
	  <label class="col-sm-3 control-label"><% $c->i18n->p('global.search.features.name.9cc4b7b', 'Name:') |h %> </label>
	  <div class="col-sm-9" >
            <input type="text" class="form-control" id="name" />
	  </div>
	</div>
      </div>
      <div class="col-sm-6">
	<div class="form-group form-group-sm">
	  <label class="col-sm-3 control-label"><% $c->i18n->p('global.search.features.description.26f0cba', 'Description:') |h %> </label>
	  <div class="col-sm-9" >
            <input type="text" class="form-control" id="description" />
	  </div>
	</div>
      </div>
    </div>
 <button style="float:right" class="btn btn-primary" id="submit_feature_search" /><% $c->i18n->p('global.search.features.search', 'Search') |h %></button>
    <br/><br/>
  </div>
  
</&>


<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p('global.search.features.search_results', 'Search Results')), collapsible=>1, collapsed=>0 &>


<div class="well">
<table id="feature_search_results" class="display">
<thead>
  <tr>
    <th><% $c->i18n->p('global.search.features.organism.2f1e4a4', 'Organism') |h %></th>
    <th><% $c->i18n->p('global.search.features.type.f65b938', 'Type') |h %></th>
    <th><% $c->i18n->p('global.search.features.name.9ede896', 'Name') |h %></th>
    <th><% $c->i18n->p('global.search.features.description.3692b15', 'Description') |h %></th>
    <th><% $c->i18n->p('global.search.features.location', 'Location') |h %></th>
  </tr>
</thead>
</table>
</div>

</&>

<script>
  
jQuery(document).ready(function () {

   var table = jQuery('#feature_search_results').DataTable( { 
   
     'searching' : false,
     'ordering'  : false,
     'processing': true,
     'serverSide': true,
     'ajax': { 'url':  '/ajax/search/features',
               'data': function(d) { 
                  d.organism    = jQuery('#organism_select').val();
                  d.type_id     = jQuery('#feature_type_select').val();
                  d.name        = jQuery('#name').val(); 
                  d.description = jQuery('#description').val(); 
                  
             }
         }
     });


   jQuery('#submit_feature_search').click( function() { 
        var organism    = jQuery('#organism_select').val();
        var type_id     = jQuery('#feature_type_select').val();
        var name        = jQuery('#name').val(); 
        var description = jQuery('#description').val(); 
       
        table.search("feature_search_results").draw();
   });
  
   jQuery('#feature_search_form').keypress( function( e ) {
           var code = e.keyCode || e.which;
           if( code == 13 ) {
                jQuery('#submit_feature_search').click();
           }
    } );


    
});
  
</script>

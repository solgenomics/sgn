<%once>
use HTML::Entities ();
</%once>


<%args>
$nd_geolocation => 'not_provided'
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.genotyping_plate_search", "Genotyping Plate Search")) &>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="genotyping_trial_search_results" width="100%" class="table table-hover table-striped">
            <thead>
              <tr>
                  <th><% $c->i18n->p("genotype.plate.plate_name", "Plate Name") |h %></th>
                  <th><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></th>
                  <th><% $c->i18n->p("styleguide.demo.trial_table.breeding_program", "Breeding program") |h %></th>
                  <th><% $c->i18n->p("cross.ui.folder", "Folder") |h %></th>
                  <th><% $c->i18n->p("accession.sequencing.table.year", "Year") |h %></th>
                  <th><% $c->i18n->p("global.search.features.location", "Location") |h %></th>
                  <th><% $c->i18n->p("genotype.plate.genotyping_facility", "Genotyping Facility") |h %></th>
                  <th><% $c->i18n->p("global.search_wizard.format", "Format") |h %></th>
                  <th><% $c->i18n->p("genotype.plate.sample_type", "Sample Type") |h %></th>
                  <th><% $c->i18n->p("global.est.download", "Download") |h %></th>
            </tr>
            </thead>
            </table>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">
            <br><br>
            <&| /page/info_section.mas, anchor_title => 'Copy Results to a List', title => HTML::Entities::encode_entities($c->i18n->p("stock_search.section.copy", 'Copy Results to a List')), collapsible=>1, collapsed=>0, subtitle=>("<i>" . HTML::Entities::encode_entities($c->i18n->p("trial.search.copy_help", "Copy the trial names currently showing in the search results table to a new or exisiting list")) . "</i>")&>
                <br>
                <div style="text-align:right" id="genotyping_trials_to_list_menu"></div>
                <div id="genotyping_trial_result_names" style="display: none;"></div>
            </&>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function () {

    var trial_table = jQuery('#genotyping_trial_search_results').DataTable( {
        'ajax': '/ajax/tissue_samples/genotyping_trials',
        "scrollX": true
     });

    jQuery('#genotyping_trial_search_results').on( 'draw.dt', function () {
        var name_links = trial_table.column( 0, {page:'current'} ).data();
        var names = [];

        for (var i = 0; i < name_links.length; i++) { //extract text from anchor tags
            names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
        }

        jQuery('#genotyping_trial_result_names').html(names);
        addToListMenu('genotyping_trials_to_list_menu', 'genotyping_trial_result_names', {
            listType: 'genotyping_plates'
        });
    });

});

</script>

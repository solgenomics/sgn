<%once>
use HTML::Entities ();
</%once>

<%args>
$location_id => 'not_provided'
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("trial.search.title", "Trial Search")) &>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="trial_search_results" width="100%" class="table table-hover table-striped">
            <thead>
              <tr>
                <th><% $c->i18n->p("trial.search.trial_name", "Trial name") |h %></th>
                <th><% $c->i18n->p("trial.search.description", "Description") |h %></th>
                <th><% $c->i18n->p("trial.search.breeding_program", "Breeding program") |h %></th>
                <th><% $c->i18n->p("trial.search.folder", "Folder") |h %></th>
                <th><% $c->i18n->p("trial.search.year", "Year") |h %></th>
                <th><% $c->i18n->p("trial.search.location", "Location") |h %></th>
                <th><% $c->i18n->p("trial.search.trial_type", "Trial type") |h %></th>
                <th><% $c->i18n->p("trial.search.design", "Design") |h %></th>
                <th><% $c->i18n->p("trial.search.planting_date", "Planting Date") |h %></th>
                <th><% $c->i18n->p("trial.search.harvest_date", "Harvest Date") |h %></th>
                <th><% $c->i18n->p("trial.search.download", "Download") |h %></th>
            </tr>
            </thead>
            </table>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">
            <br><br>
            <&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p("trial.search.copy_title", "Copy Results to a List")), collapsible=>1, collapsed=>0, subtitle=>'<i>' . HTML::Entities::encode_entities($c->i18n->p("trial.search.copy_help", "Copy the trial names currently showing in the search results table to a new or existing list")) . '</i>'&>
                <br>
                <div style="text-align:right" id="trials_to_list_menu"></div>
                <div id="trial_result_names" style="display: none;"></div>
            </&>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function () {

   var trial_table = jQuery('#trial_search_results').DataTable( {
       'ajax': '/ajax/search/trials?location_id=<% $location_id |u %>',
       "scrollX": true
   });

   jQuery('#trial_search_results').on( 'draw.dt', function () {
     var name_links = trial_table.column( 0, {page:'current'} ).data();
     var names = [];

     for (var i = 0; i < name_links.length; i++) { //extract text from anchor tags
       names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
     }

     jQuery('#trial_result_names').html(names);
     addToListMenu('trials_to_list_menu', 'trial_result_names', {
       listType: 'trials'
     });

   });

});

</script>

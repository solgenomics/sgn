<%init>
use HTML::Entities ();
</%init>

<%args>
</%args>

<style>
#images_search_results {
    width: 100% !important;
}
</style>

<& /util/import_javascript.mas, classes => [ 'jquery', 'thickbox', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p('global.search.images.image_search', 'Image Search')) &>

<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p('global.search.images.image_search_criteria', 'Image Search Criteria')),  collapsible => 1, collapsed=>0, subtitle => HTML::Entities::encode_entities($c->i18n->p('global.search.images.all_images_may_not_have_names_descriptions_or_tags_associated_with_them', 'All images may not have names, descriptions, or tags associated with them.'))&>

    <div id="image_search_form" class="well well-sm">
        <div class="form-horizontal" >
            <div class="form-group">
                <label class="col-sm-6 control-label"><% $c->i18n->p('global.search.images.image_descriptors_name_description_or_filename', 'Image descriptors (name, description, or filename):') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_description_filename_composite" name="image_description_filename_composite" placeholder="e.g. MyImageName" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label"><% $c->i18n->p('global.search.images.submitter.31da5f6', 'Submitter:') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_submitter" name="image_submitter" placeholder="e.g. JaneDoe" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label"><% $c->i18n->p('global.search.images.image_tag', 'Image tag:') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_tag" name="image_tag" placeholder="e.g. ImageTagName" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label"><% $c->i18n->p('global.search.images.associated_stock', 'Associated stock:') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_stock_uniquename" name="image_stock_uniquename" placeholder="e.g. FieldPlot100" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label"><% $c->i18n->p('global.search.images.related_stock', 'Related stock:') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_related_stock" name="image_related_stock" placeholder="e.g. Accession/Plot/TissueSample" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-6 control-label"><% $c->i18n->p('global.search.images.associated_project', 'Associated project:') |h %> </label>
                <div class="col-sm-6" >
                    <input class="form-control" type="text" id="image_project_name" name="image_project_name" placeholder="e.g. DroneProject 01/01/2019" />
                </div>
            </div>
        </div>

        <center>
        <button class="btn btn-primary" id="image_search_submit" ><% $c->i18n->p('global.search.images.search', 'Search') |h %></button>
        </center>
    </div>
</&>

<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p('global.search.images.image_search_results', 'Image Search Results')),  collapsible => 1, collapsed=>0 &>
    <div class="well well-sm">
        <div class="panel panel-default">
            <div class="panel-body">
                <table id="images_search_results" class="table table-hover table-striped">
                <thead>
                  <tr>
                    <th><% $c->i18n->p('global.search.images.image_thumbnail', 'Image Thumbnail') |h %></th>
                    <th><% $c->i18n->p('global.search.images.filename', 'Filename') |h %></th>
                    <th><% $c->i18n->p('global.search.images.description', 'Description') |h %></th>
                    <th><% $c->i18n->p('global.search.images.submitter.5559e18', 'Submitter') |h %></th>
                    <th><% $c->i18n->p('global.search.images.associations', 'Associations') |h %></th>
                    <th><% $c->i18n->p('global.search.images.related_accession', 'Related Accession') |h %></th>
                    <th><% $c->i18n->p('global.search.images.tags', 'Tags') |h %></th>
                </tr>
                </thead>
                </table>
            </div>
        </div>
    </div>
</&>

<script>

var images_table;

jQuery(document).ready(function () {

    _load_image_search_results();

    jQuery("#image_submitter").autocomplete({
        source: '/ajax/people/autocomplete'
    });

    jQuery("#image_stock_uniquename").autocomplete({
        source: '/ajax/stock/stock_autocomplete'
    });

    jQuery("#image_related_stock").autocomplete({
        source: '/ajax/stock/stock_autocomplete'
    });

    jQuery("#image_project_name").autocomplete({
        source: '/ajax/trials/trial_autocomplete'
    });

    jQuery('#image_search_submit').click( function() {
        _load_image_search_results();
    });

    jQuery('#image_search_form').keypress( function( e ) {
        var code = e.keyCode || e.which;
        if( code == 13 ) {
            jQuery('#image_search_submit').click();
        }
    });

    jQuery('#images_search_results').on( 'draw.dt', function () {
        jQuery('a.image_search_group').colorbox({photo: true, onComplete: function () {
            var titleWidth = jQuery('#cboxTitle').outerWidth(true);
            var paddedWidth = titleWidth + 500;
            jQuery.colorbox.resize({width: paddedWidth + 'px'});
        }});
    });

});

function _load_image_search_results() {
    images_table = jQuery('#images_search_results').DataTable({
        'destroy' : true,
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'scrollX': true,
        'lengthMenu': [10,20,50,100,1000,5000],
        'ajax': { 'url':  '/ajax/search/images',
            'type': 'POST',
            'data': function(d) {
              d.image_description_filename_composite = jQuery('#image_description_filename_composite').val();
              d.image_person = jQuery('#image_submitter').val();
              d.image_tag = jQuery('#image_tag').val();
              d.image_stock_uniquename = jQuery('#image_stock_uniquename').val();
              d.image_related_stock = jQuery('#image_related_stock').val();
              d.image_project_name = jQuery('#image_project_name').val();
            }
        }
    });
}

</script>

<%once>
use HTML::Entities ();
</%once>


<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.genotyping_project_search", "Genotyping Project Search")) &>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="genotyping_data_project_search_results" width="100%" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th><% $c->i18n->p("folder.detail.genotyping_project_name", "Genotyping Project Name") |h %></th>
                        <th><% $c->i18n->p("global.dataset_publish.data_type", "Data Type") |h %></th>
                        <th><% $c->i18n->p("global.dataset_cxgn_dataset.table.description", "Description") |h %></th>
                        <th><% $c->i18n->p("styleguide.demo.trial_table.breeding_program", "Breeding program") |h %></th>
                        <th><% $c->i18n->p("cross.ui.folder", "Folder") |h %></th>
                        <th><% $c->i18n->p("accession.sequencing.table.year", "Year") |h %></th>
                        <th><% $c->i18n->p("global.search.features.location", "Location") |h %></th>
                        <th><% $c->i18n->p("genotype.plate.genotyping_facility", "Genotyping Facility") |h %></th>
                        <th><% $c->i18n->p("genotype.plate.number_of_plates", "Number of Plates") |h %></th>
                        <th><% $c->i18n->p("genotype.plate.total_number_of_accessions", "Total Number of Accessions") |h %></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">
            <br><br>
            <&| /page/info_section.mas, anchor_title => 'Copy Results to a List', title => HTML::Entities::encode_entities($c->i18n->p("stock_search.section.copy", 'Copy Results to a List')), collapsible=>1, collapsed=>0, subtitle=>("<i>" . HTML::Entities::encode_entities($c->i18n->p("genotype.plate.copy_the_genotyping_project_names_currently_showing_in_the_search", "Copy the genotyping project names currently showing in the search results table to a new or exisiting list")) . "</i>")&>
                <br>
                <div style="text-align:right" id="genotyping_data_project_to_list_menu"></div>
                <div id="genotyping_data_project_result_names" style="display: none;"></div>
            </&>
        </div>
    </div>
</div>

<br /><br />

<&| /page/info_section.mas, anchor_title => 'Filter Projects by Accessions', id=>"protocol_search_accession_filter", title => HTML::Entities::encode_entities($c->i18n->p("genotype.plate.filter_projects_by_accessions", 'Filter Projects by Accessions')), collapsible=>1, collapsed=>0 &>

<& /search/genotyping_projects_accession_filter.mas &>

</&>


<script>

jQuery(document).ready(function () {

   var trial_table = jQuery('#genotyping_data_project_search_results').DataTable( {
       'ajax': '/ajax/genotyping_data_project/search',
       "scrollX": true
   });

   jQuery('#genotyping_data_project_search_results').on( 'draw.dt', function () {
     var name_links = trial_table.column( 0, {page:'current'} ).data();
     var names = [];

     for (var i = 0; i < name_links.length; i++) { //extract text from anchor tags
       names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
     }

     jQuery('#genotyping_data_project_result_names').html(names);
     addToListMenu('genotyping_data_project_to_list_menu', 'genotyping_data_project_result_names', {
       listType: 'genotyping_projects'
     });

   });

});

</script>

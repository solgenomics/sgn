
<%once>
use SGN::I18N ();
</%once>

<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title => SGN::I18N::translate($c->i18n, 'genotype.protocol.search.title', 'Genotyping Protocol Search', undef, {entities => '<>&'}) &>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="genotyping_protocol_search_results" width="100%" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th><% $c->i18n->p('genotype.protocol.search.protocol', 'Protocol') |h %></th>
                        <th><% $c->i18n->p('genotype.plate.marker_type', 'Marker Type') |h %></th>
                        <th><% $c->i18n->p('genotype.protocol.search.header_description', 'Header Description') |h %></th>
                        <th><% $c->i18n->p('genotype.plate.number_of_markers', 'Number of Markers') |h %></th>
                        <th><% $c->i18n->p('genotype.plate.protocol_description', 'Protocol Description') |h %></th>
                        <th><% $c->i18n->p('genotype.plate.reference_genome', 'Reference Genome') |h %></th>
                        <th><% $c->i18n->p('genotype.plate.species_name', 'Species Name') |h %></th>
                        <th><% $c->i18n->p('genotype.plate.sample_type', 'Sample Type') |h %></th>
                        <th><% $c->i18n->p('cross.forms.create_date', 'Create Date') |h %></th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
<!--
    <div class="panel panel-default">
        <div class="panel-body">
            <br><br>
            <&| /page/info_section.mas, title => 'Copy Results to a List', collapsible=>1, collapsed=>0, subtitle=>'<i>Copy the protocol names currently showing in the search results table to a new or exisiting list</i>'&>
                <br>
                <div style="text-align:right" id="genotyping_protocol_to_list_menu"></div>
                <div id="genotyping_protocol_result_names" style="display: none;"></div>
            </&>
        </div>
    </div>
-->
</div>


<br /><br />


<&| /page/info_section.mas, id=>"protocol_search_accession_filter", title => SGN::I18N::translate($c->i18n, 'genotype.protocol.search.filter_accessions', 'Filter Protocols by Accessions', undef, {entities => '<>&'}), anchor_title => 'Filter Protocols by Accessions', collapsible=>1, collapsed=>0 &>

<& /search/genotyping_protocols_accession_filter.mas &>

</&>

<script>

jQuery(document).ready(function () {

   var trial_table = jQuery('#genotyping_protocol_search_results').DataTable( {
       'ajax': '/ajax/genotyping_protocol/search',
       "scrollX": true
   });

   jQuery('#genotyping_protocol_search_results').on( 'draw.dt', function () {
     var name_links = trial_table.column( 0, {page:'current'} ).data();
     var names = [];

     for (var i = 0; i < name_links.length; i++) { //extract text from anchor tags
       names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
     }

     jQuery('#genotyping_protocol_result_names').html(names);
     addToListMenu('genotyping_protocol_to_list_menu', 'genotyping_protocol_result_names', {
     });

   });

});

</script>

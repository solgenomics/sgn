<%args>


</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables' ] &>

<& /page/page_title.mas, title=>'Search Accessions Containing Specific Genotypes' &>

<!--
<&| /page/info_section.mas, title=>'Step 1: Select a set of accessiions (dataset)'&>
    <div class="row" id="search_form_1" >
        <div class="col-sm-1">
        </div>
        <div class="col-sm-12 well">
            <span style="width:240px" id="dataset_accessions"></span>
        </div>
    </div>
</&>
-->

<&| /page/info_section.mas, title=>'Step 1:'&>
    <div class="well" id="search_form_1" >
        <div class="row">
            <label class="control-label col-sm-3" style="text-align: right">Select a genotyping protocol (optional):</label>
            <div class="col-sm-9">
                <select class="form-control" id="protocol_select">
                    <option value="">Select a genotyping protocol</option>
                </select>
                <p class="small">Filter the lists of marker alleles that match this protocol.</p>
            </div>
        </div>

        <br />

        <div class="row">
            <label class="control-label col-sm-3" style="text-align: right">Select a list of marker alleles:</label>
            <div class="col-sm-9">
                <select class="form-control" id="markerset_select">
                    <option value="">Select a list of marker alleles</option>
                </select>
                <p class="small">This is the list of genotypes (markers with allele values) that will be used to filter the set of accessions.</p>
            </div>
        </div>

        <br /><br />

        <div class="row">
            <div class="col-sm-3"></div>
            <div class="col-sm-9">
                <a id="mal-btn" class="btn btn-primary" href="/breeders/markers" target="_blank">
                    <i class="glyphicon glyphicon-edit"></i> Manage Marker Allele Lists
                </a>
            </div>
        </div>
    </div>
</&>
<br />

<&| /page/info_section.mas, title=>'Step 2:'&>
    <div class="well" id="search_form_2" >
        <div class="row">
            <label class="control-label col-sm-3" style="text-align: right">Select a list of accessions (optional):</label>
            <div class="col-sm-9" >
                <select class="form-control" id="stock_list_select">
                    <option value="">Search all accessions in protocol of selected marker alleles</option>
                </select>
                <p class="small">This is the set of accessions that will be filtered by the selected genotypes.</p>
                <p class="small">If you don't select a list here, then all of the accessions in the protocol linked to the marker allele list will be used.</p>
                <p class="small">If you do select a list here, then the accessions in this list that are also in the protocol of the marker alleles will be used.</p>
            </div>
        </div>
    </div>
</&>
<br />

<&| /page/info_section.mas, title=>'Step 3:'&>
    <div class="well" id="search_form_3" >
        <div class="row">
            <label class="control-label col-sm-3" style="text-align: right">Search Type:</label>
            <div class="col-sm-9" >
                <select class="form-control" id="search_type_select">
                    <option value="all">All Genotypes</option>
                    <option value="any">Any Genotype</option>
                </select>
                <p class="small">All Genotypes = returned accessions will include <strong>all</strong> of the genotypes in the marker allele list</p>
                <p class="small">Any Genotypes = returned accessions will include <strong>at least one</strong> of the genotpyes in the marker allele list</p>
            </div>
        </div>
    </div>
</&>
<br />

<&| /page/info_section.mas, title=>'Step 4:'&>
    <div class="well" id="search_form_4" >
        <div class="row">
            <label class="control-label col-sm-3"></label>
            <div class="col-sm-9">
                <button class="btn btn-primary" id="search_accessions_using_markerset"><i class="glyphicon glyphicon-search"></i> Search Accessions</button>
            </div>
        </div>
    </div>
 </&>


<&| /page/info_section.mas, title => 'Search Results' , collapsible=>1, collapsed=>0 &>

    <link rel="stylesheet" type="text/css" href="/documents/inc/datatables/jquery.dataTables.css">

    <table id="genotype_search_results" width="100%" class="table table-hover table-striped">
    </table>
</&>

<script>

const updateMarkersetListOptions = () => {
    var lo = new CXGN.List();
    var lists = lo.getLists(['markers']);
    var select = jQuery('#markerset_select');
    var selected_protocol_id = jQuery("#protocol_select").val();

    select.empty();

    _addOption({ label: "Select a list of marker alleles" });
    _addOption({ label: "--------YOUR LISTS BELOW--------", disabled: true });
    lists?.private_lists?.forEach(([id, name]) => _addOption(_parseList(id, name)));
    _addOption({ label: "--------PUBLIC LISTS BELOW--------", disabled: true });
    lists?.public_lists?.forEach(([id, name]) => _addOption(_parseList(id, name)));

    function _parseList(id, name) {
        const { elements } = lo.getListData(id);
        const metadata = JSON.parse(elements[0][1] || '{}');
        const protocol_id = metadata.genotyping_protocol_id;
        const protocol_name = metadata.genotyping_protocol_name;
        return {
            value: id,
            label: `${name} [${protocol_name}]`,
            protocol_id: parseInt(protocol_id)
        };
    }

    function _addOption({ value, label, protocol_id, disabled = false } = {}) {
        if ( !selected_protocol_id || selected_protocol_id === "" || 
                !protocol_id || protocol_id === "" || 
                parseInt(selected_protocol_id) === parseInt(protocol_id) ) {
            var option = jQuery("<option></option>")
                .attr("value", value || '')
                .attr("data-protocol-id", protocol_id || '')
                .attr("disabled", disabled)
                .text(label);
            select.append(option);
        }
    }
}

jQuery(document).ready(function (){

    var data_set = new CXGN.Dataset();
    var lo = new CXGN.List();

//    get_select_box('datasets', 'dataset_accessions', {"checkbox_name":"dataset_accessions_checkbox"});
    jQuery('#stock_list_select').html(lo.listSelect('stock_list_select', ['accessions'], 'Search all accessions in protocol of selected marker alleles', undefined, undefined));

    get_select_box('genotyping_protocol', 'protocol_select', {'empty':1});
    jQuery('#protocol_select').on('change', updateMarkersetListOptions);
    updateMarkersetListOptions();

    jQuery("#search_accessions_using_markerset").click(function(){

//        var selected_datasets = [];
//        var dataset_id;
//        jQuery('input[name="dataset_accessions_checkbox"]:checked').each(function() {
//            selected_datasets.push(jQuery(this).val());
//        });

//        if (selected_datasets.length < 1){
//            alert('Please select a set of accessions!');
//            return false;
//        } else if (selected_datasets.length > 1){
//            alert('Please select only one set of accessions!');
//            return false;
//        } else {
//            dataset_id = selected_datasets[0];
//        }

        var stock_list_id = jQuery('#stock_list_select').val();

        var markerset_id = jQuery('#markerset_select').val();

        if (!markerset_id) {
            alert("Please choose a list of marker alleles");
            return;
        }

        var table = jQuery('#genotype_search_results').DataTable({
            'destroy' : true,
            'ajax': { 'url':'/ajax/search/search_stocks_using_markerset',
                'data':{
                    'stock_list_id': stock_list_id,
                    'markerset_id': markerset_id,
                }
            },
            columns: [
                {
                    title: "Accession Name",
                    data: null,
                    render: function(data, type, row){return "<a href='/stock/"+row.stock_id+"/view'>"+row.stock_name+"</a>";}
                },
                {
                    title: "Sample Name",
                    data: null,
                    render: function(data, type, row){return "<a href='/stock/"+row.sample_id+"/view'>"+row.sample_name+"</a>";}
                },
                {
                    title: "Sample Type",
                    data: "sample_type",
                },
                {
                    title: "Genotypes",
                    data: "genotypes",
                    render: function(data, type,row){
                        var parsed = JSON.parse(data);
                        var items = [];
                        Object.entries(parsed).forEach(([key, value]) => {
                            items.push(`<strong>${key}</strong>: ${JSON.stringify(value)}`);
                        });
                        return items.join('<br />');
                    }
                },
            ],
        });
    });

});


</script>


<style>
    #mal-btn {
        color: #fff;
    }
    #mal-btn:hover {
        background-color: #286090
    }
    p.small {
        margin: 5px 0;
    }
</style>

<%args>

  $sp_person_autocomplete_uri => '/ajax/people/autocomplete'
  $trait_autocomplete_uri     => '/ajax/stock/trait_autocomplete'
  $onto_autocomplete_uri      => '/ajax/cvterm/autocomplete'
  $trait_db_name              => 'SP'

  $organisms       => undef
  $stock_types     => undef
  $breeding_programs => undef
  $editable_stock_props => undef
</%args>

<%perl>
  my $user_role = '';
  if ($c->user) {
    $user_role = $c->user->get_object()->get_user_type();
  }
</%perl>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'CXGN.Effects', 'CXGN.List' ] &>
<& /util/import_javascript.mas, entries => [ 'search_state' ] &>
<& /util/import_javascript.mas, classes => ['jquery.dataTables-buttons-min', 'jszip-min', 'pdfmake.pdfmake-min', 'pdfmake.vfs_fonts', 'buttons.bootstrap-min', 'buttons.html5-min', 'buttons.print-min', 'buttons.colvis-min', 'dataTables.colReorder-min'] &>

<style>
#stock_search_results_div {
  margin-top: 10px;
}
#stock_search_results_div th {
    cursor: grab;
}
#stock_search_results_length {
  padding: 4px;
  margin-right: 4px;
}
</style>

<div class="container-fluid">

<& /page/page_title.mas, title=>'Search Accessions and Trees' &>

<%perl>

use CXGN::Page::FormattingHelpers qw / conditional_like_input_html simple_selectbox_html/;

my $accession_cvterm_id;

for (my $i=0; $i< scalar(@$stock_types); $i++) {
     if ( $stock_types->[$i][1] eq "" ) {
        $stock_types->[$i][1] = 'all';
     }
     if ( $stock_types->[$i][1] eq "accession" ) {
     	$accession_cvterm_id = $stock_types->[$i][0];
	last();
     }
}

my $stock_type_select = simple_selectbox_html(
  choices   => $stock_types,
  id        => "stock_type_select",
  selected => $accession_cvterm_id
);

my $organism_select = simple_selectbox_html(
  choices  =>  $organisms   ,
  id       => "organism_select",
);

my $breeding_programs_select = simple_selectbox_html(
    choices => $breeding_programs,
    id      => "breeding_program" ,
);
</%perl>

<&| /page/info_section.mas, title => 'Search', collapsible=>1, collapsed=>0 &>

  <div id="stock_search_form" class="well well-sm">


    <&| /page/info_section.mas, title => 'Name Search', collapsible=>1, collapsed=>0 &>

    <div class="row">
      <div class="col-sm-11">
        <div class="form-group form-group-sm">
      	  <label class="col-sm-3 control-label" for="any_name">Stock Name or Description: </label>
          <div class="col-sm-9" >
            <div class="form-group form-group-sm">
              <div class="input-group">
                <span class="input-group-btn" width="20%">
                  <select class="form-control" id="any_name_matchtype" name="any_name_matchtype">
                    <option title="starts_with" value="starts_with" selected="selected">starts with</option>
                    <option title="contains" value="contains">contains</option>
                    <option title="ends with" value="ends_with">ends with</option>
                    <option title="exactly" value="exactly">exactly</option>
                  </select>
                </span>
                  <span class="input-group-btn">
                  <input class="form-control" name="any_name" id="any_name" value="" size="30" type="text" placeholder="Type search here..."/>
                </span>
              </div>
            </div>
            <div class="form-group form-group-sm">
              <label class="col-sm-3 control-label">Stock Type: </label>
              <div class="col-sm-9" >
                <% $stock_type_select %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    </&>

    <&| /page/info_section.mas, title => 'Advanced Search', collapsible=>1, collapsed=>1, id=>'advanced_search_panel' &>

    <&| /page/info_section.mas, title => 'Properties', collapsible=>1, collapsed=>1, id=>'stock_search_properties_panel' &>

    <div class="row">
      <div class="form-group form-group-sm">
        <label class="col-sm-4 control-label">Organism:</label>
        <div class="col-sm-8" >
          <% $organism_select %>
        </div>
      </div>
    </div>

    <br />

    <div class="row">
      <div class="form-group form-group-sm">
        <label class="col-sm-4 control-label" for="organization">Organization:</label>
        <div class="col-sm-8" >
          <input type="text" class="form-control" id="organization" placeholder="Type to Autocomplete"/>
        </div>
      </div>
    </div>

    <br /><hr /><br />

    <div class="row">
      <div class="form-group form-group-sm">
        <label class="col-sm-4 control-label" for="editable_stockprop_search_term">Search By Another Property:</label>
        <div class="col-sm-8" >
          <div class="form-group">
            <div class="input-group">
              <span class="input-group-btn">
                <select class="form-control" id="editable_stockprop_search_term" name="editable_stockprop_search_term">
%  foreach my $stockprop (sort {uc($a) cmp uc($b)} @$editable_stock_props){
                  <option title="<% $stockprop %>" value="<% $stockprop %>" ><% $stockprop %></option>
%  }
                </select>
              </span>
              <span class="input-group-btn">
                <button class="btn btn-primary btn-sm" id="editable_stockprop_search_add">Add</button>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div id="editable_stockprop_search_div"></div>

% if (( $user_role eq 'curator' ) || ( $user_role eq 'submitter' )) {
    <br /><hr /><br />
    <div class="row">
      <div class="form-group form-group-sm">
        <label class="col-sm-4 control-label" for="obsolete_stock_search_term">Is Obsolete?:</label>
        <div class="col-sm-8" >
          <div class="form-group">
            <select class="form-control" id="obsolete_stock_search_term" name="obsolete_stock_search_term">
              <option value="false" selected>Not Obsolete</option>
              <option value="true">Is Obsolete</option>
              <option value="include_obsolete">Include Obsolete</option>
            </select>
          </div>
        </div>
      </div>
    </div>
% }

    </&>
    <&| /page/info_section.mas, title => 'Usage', collapsible=>1, collapsed=>1, id=>'stock_search_usage_panel' &>

    <div class="row">
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label" for="project">Project Name: </label>
          <div class="col-sm-9" >
            <input type="text" class="form-control" id="project" placeholder="Type to Autocomplete"/>
          </div>
        </div>
      </div>
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label" for="location">Project Location: </label>
          <div class="col-sm-9" >
            <input type="text" class="form-control" id="location" placeholder="Type to Autocomplete"/>
          </div>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label" for="year">Project Year: </label>
          <div class="col-sm-9" >
            <input type="text" class="form-control" id="year" placeholder="Type to Autocomplete"/>
          </div>
        </div>
      </div>
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label">Breeding Program: </label>
          <div class="col-sm-9" >
            <% $breeding_programs_select %>
          </div>
        </div>
      </div>
    </div>

    </&>
    <&| /page/info_section.mas, title => 'Phenotypes', collapsible=>1, collapsed=>1, id=>'stock_search_phenotypes_panel' &>

    <div class="row">
        <div class="col-sm-6">
          <div class="form-group form-group-sm">
            <label class="col-sm-3 control-label" for="trait">Trait: </label>
            <div class="col-sm-9" >
              <input type="text" class="form-control" id="trait" placeholder="Type to Autocomplete"/>
            </div>
          </div>
        </div>
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label" for="minimum_trait_value">Minimum Trait Value: </label>
          <div class="col-sm-9" >
            <input type="text" class="form-control" id="minimum_trait_value" />
          </div>
        </div>
      </div>
      </div>
      <div class="row">
      <div class="col-sm-6">
        <div class="form-group form-group-sm">
          <label class="col-sm-3 control-label" for="maximum_trait_value">Maximum Trait Value: </label>
          <div class="col-sm-9" >
            <input type="text" class="form-control" id="maximum_trait_value" />
          </div>
        </div>
      </div>
    </div>
    </&>

    <&| /page/info_section.mas, title => 'Search Accessions Using Genotypes', collapsible=>1, collapsed=>1 &>
        <div class="row">
            <a href="/search/stocks_using_genotypes"><p>Go to Search Accessions Using Genotypes Page.</p></a>
        </div>
    </&>

    </&> <!-- closes advanced search -->

    <center>
        <button class="btn btn-default" id="reset_stock_search">Reset</button>
        <button class="btn btn-primary" id="submit_stock_search">Search</button>
    </center>
    <br/><br/>
  </div>
</&>

<br />

<&| /page/info_section.mas, title => 'Search Results', collapsible=>1, collapsed=>0 &>

<div class="well well-sm">

    <div class="row">
      <div class="col-sm-11">
        <div class="form-group form-group-sm">
          <label class="col-sm-4 control-label" for="editable_stockprop_view_column_term">View Another Property: </label>
          <div class="col-sm-8" >
            <div class="form-group">
              <div class="input-group">
                <span class="input-group-btn">
                  <select class="form-control" id="editable_stockprop_view_column_term" name="editable_stockprop_view_column_term">
%  foreach my $stockprop (sort { "\L$a" cmp "\L$b" } @$editable_stock_props){
                    <option title="<% $stockprop %>" value="<% $stockprop %>" ><% $stockprop %></option>
%  }
                  </select>
                </span>
                  <span class="input-group-btn">
                    <button class="btn btn-primary btn-sm" id="editable_stockprop_view_column_add">Add</button>
                    <button class="btn btn-sm btn-danger" id="editable_stockprop_view_column_remove">Remove</button>
                    <button class="btn btn-sm btn-default" id="reset_stock_columns">Reset</button>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">
            <div id="stock_search_results_div" class="table-responsive">
                <table id="stock_search_results" width="100%" class="table table-hover table-striped">
                <thead>
                  <tr>
                    <th>Stock Id</th>
                    <th>Stock Name</th>
                    <th>Stock Type</th>
                    <th>Organism</th>
                    <th>Synonyms</th>
                    <th>Organization</th>
                </tr>
                </thead>

                </table>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">
            <&| /page/info_section.mas, title => 'Copy Results to a List', collapsible=>1, collapsed=>0, subtitle=>'<i>Copy the stock names currently showing in the search results table to a new or exisiting list. Use "Show All entries" to capture all results.</i>'&>
            <br>
            <div style="text-align:right" id="results_to_list_menu"></div>
            <div id="search_result_names" style="display: none;"></div>
            </&>
        </div>
    </div>

</div>

</&>

<& /page/detail_page_2_col_section.mas, info_section_title => "<h4 style='display:inline'>Graphical Filtering on Phenotype Performance</h4>", info_section_subtitle => 'Graphically filter an accessions average performance for combinations of traits', icon_class => "glyphicon glyphicon-equalizer", info_section_id => "stocks_search_graphical_filtering" &>


</div>

<script>

let stock_table;

jQuery(document).ready(function () {

    window.addEventListener('load', () => {
      // Skip reset routine if URL query parameters are present to protect deserialized values.
      if (window.location.search.length > 1) {
        return;
      }
      // Reset the advanced search form parameters on load.
      // Very similar to later functionality but that one is for advanced search and on load trigger only.
      const input_list = document.getElementById('advanced_search_panel_content').getElementsByTagName('input');
      for (const input_elem of input_list) {
        input_elem.value = '';
      }

      const select_list = document.getElementById('advanced_search_panel_content').getElementsByTagName('select');
      for (const select_elem of select_list) {
        select_elem.selectedIndex = 0;
      }

      const type_select = document.getElementById('stock_type_select');
      type_select.selectedIndex = [...type_select.options].findIndex(elem => elem.text.trim().toLowerCase() == 'accession') ?? 1;
    });


    const textFields = document.querySelectorAll('input[type="text"]');
    // Loop through the text fields and set their values to an empty string
      textFields.forEach(textField => {
        textField.value = '';
     });

     // Get all the dropdown select elements in the form
     // Reset all but 'stock_type_select' dropdown to zero value
     // Leave 'stock_type_select' with the default "selected" value from the mason file.
     const selectFields = document.querySelectorAll('select');
     selectFields.forEach(selectField => {
        if (selectField.id != 'stock_type_select') {
          selectField.selectedIndex = 0;
        }
     });

     jQuery("#person").autocomplete({
        source: '<% $sp_person_autocomplete_uri %>'
     });
     jQuery("#trait").autocomplete({
        source: '<% $trait_autocomplete_uri %>'
     });
     jQuery("#onto").autocomplete({
        source: '<% $onto_autocomplete_uri %>' + "?db_name=" + '<% $trait_db_name %>'
     });
     jQuery("#project").autocomplete({
        source: '/ajax/stock/project_autocomplete',
     });
     jQuery("#any_name").autocomplete({
        source: '/ajax/stock/stock_autocomplete?stock_type_id='+jQuery('#stock_type_select option:selected').val(),
     });
     jQuery('#stock_type_select').change(function(){
         jQuery("#any_name").autocomplete({
            source: '/ajax/stock/stock_autocomplete?stock_type_id='+jQuery('#stock_type_select option:selected').val(),
         });
     });
     jQuery("#location").autocomplete({
        source: '/ajax/stock/geolocation_autocomplete',
     });
     jQuery("#year").autocomplete({
        source: '/ajax/stock/project_year_autocomplete',
     });
     jQuery("#organization").autocomplete({
        source: '/ajax/stock/stockproperty_autocomplete?property=organization',
     });

    // Update changed organization
    jQuery(document).on("change", "#organization", function() {
      editable_stockprops_search["organization"] = {
        "matchtype": "contains",
        "value": jQuery(this).val()
      }
    });

    const editable_stockprops_search = {};
    let params = {};
    jQuery('#editable_stockprop_search_add').click( function(){
        // console.log("editable stockprops search is "+JSON.stringify(editable_stockprops_search));
        // console.log("Value is "+jQuery('#editable_stockprop_search_term').val());
        editable_stockprops_search[jQuery('#editable_stockprop_search_term').val()] = {"matchtype": "contains"};
        console.log("editable stockprops search is "+JSON.stringify(editable_stockprops_search));
        _draw_editable_stockprops_search_fields();
    });

    jQuery(document).on('click', 'button[name="editable_stockprop_search_remove"]', function(){
        delete editable_stockprops_search[jQuery(this).data('property')];
        _draw_editable_stockprops_search_fields();
    });
    jQuery(document).on("keyup", 'input[name="editable_stockprop_search_inputs"]', function(){
        //Store typed value in object, in case of redraw inputs (input deletion or addition) the value will be still there. Also for search submission
        editable_stockprops_search[jQuery(this).data('property')]["value"] = jQuery(this).val();
        console.log("editable stockprops search is "+JSON.stringify(editable_stockprops_search));
    });

    jQuery(document).on("change", 'select[name="editable_stockprop_matchtype"]', function(){

    // jQuery(document).on("change", 'input[name="editable_stockprop_matchtype"]', function(){
        //Store typed value in object, in case of redraw inputs (input deletion or addition) the value will be still there. Also for search submission
        console.log("prop is "+jQuery(this).data('property'));
        editable_stockprops_search[jQuery(this).data('property')]["matchtype"] = jQuery(this).val();
        console.log("editable stockprops search is "+JSON.stringify(editable_stockprops_search));
    });

    // Renders dynamic, search-by-property input fields (e.g. custom stock properties)
    function _draw_editable_stockprops_search_fields() {
        const $searchDiv = jQuery('#editable_stockprop_search_div');
        $searchDiv.html('');
        for (const property in editable_stockprops_search) {
            if (editable_stockprops_search.hasOwnProperty(property)) {
                // We filter out organization because it is handled directly as a first-class DOM element
                if (property === 'organization') continue;

                const matchtype_val = editable_stockprops_search[property].matchtype || 'contains';
                const input_val = editable_stockprops_search[property].value || '';
                const safe_id = property.replace(/[^a-zA-Z0-9_-]/g, '_') + '_input_id';

                // Draw input fields with corresponding selectors for custom mapping hooks
                $searchDiv.append(`
                    <div class="form-group form-group-sm">
                        <label class="col-sm-4 control-label">${property}: </label>
                        <div class="col-sm-8">
                            <div class="form-group">
                                <div class="input-group">
                                    <span class="input-group-btn tw:w-[20%]">
                                        <select class="form-control" id="editable_stockprop_matchtype" name="editable_stockprop_matchtype" data-property="${property}">
                                            <option title="contains" value="contains">contains</option>
                                            <option title="starts with" value="starts_with">starts with</option>
                                            <option title="ends with" value="ends_with">ends with</option>
                                            <option title="exactly" value="exactly">exactly</option>
                                            <option title="one of" value="one of">one of (separate multiple possibilities with commas)</option>
                                        </select>
                                    </span>
                                    <span class="input-group-btn">
                                        <input type="text" class="form-control" name="editable_stockprop_search_inputs" id="${safe_id}" data-property="${property}" placeholder="Type to Autocomplete"/>
                                    </span>
                                    <span class="input-group-btn">
                                        <button name="editable_stockprop_search_remove" data-property="${property}" class="btn">
                                            <span class="glyphicon glyphicon-remove"></span>
                                        </button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>`);

                // Assign value and match type properties dynamically
                $searchDiv.find('select[data-property="'+property+'"]').val(matchtype_val);
                $searchDiv.find('input[data-property="'+property+'"]').val(input_val);

                $searchDiv.find('input[data-property="'+property+'"]').autocomplete({
                   source: '/ajax/stock/stockproperty_autocomplete?property='+property,
                });
            }
        }
    }

    //For adding stockprop columns to search result
    let stockprop_extra_columns_view = { 'organization':1 };
    let stockprop_extra_columns_view_array = [ 'organization' ];

    function updateResultsHeader() {
        let table_header_html =
          '<table id="stock_search_results" class="table table-hover table-striped" width="100%">' +
            '<thead><tr>' +
              '<th>Stock Id</th>' +
              '<th>Stock Name</th>' +
              '<th>Stock Type</th>' +
              '<th>Organism</th>' +
              '<th>Synonyms</th>';
        for (let i = 0; i < stockprop_extra_columns_view_array.length; i++) {
          table_header_html += '<th>' + stockprop_extra_columns_view_array[i] + '</th>';
        }
        table_header_html +=
            '</tr></thead>' +
          '</table>';
        jQuery('#stock_search_results_div').html(table_header_html);
    }

    function updateResultsRows() {
        stock_table.destroy();
        _load_stock_search_results(jQuery('#stock_type_select option:selected').text(), editable_stockprops_search, stockprop_extra_columns_view, stockprop_extra_columns_view_array);
    }

    jQuery('#editable_stockprop_view_column_add').click(function(){
        const selected_property = jQuery('#editable_stockprop_view_column_term').val();
        if (!(selected_property in stockprop_extra_columns_view)){
            stockprop_extra_columns_view[selected_property] = 1;
            stockprop_extra_columns_view_array.push(selected_property);
            updateResultsHeader();
        }
        updateResultsRows();
    });
    jQuery('#editable_stockprop_view_column_remove').click(function(){
        const selected_property = jQuery('#editable_stockprop_view_column_term').val();
        if ((selected_property in stockprop_extra_columns_view)){
          delete stockprop_extra_columns_view[selected_property];
          const selected_index = stockprop_extra_columns_view_array.indexOf(selected_property);
          if (selected_index !== -1) {
            stockprop_extra_columns_view_array.splice(selected_index, 1);
            updateResultsHeader();
          }
        }
        updateResultsRows();
    })

    jQuery('#stock_search_results').on( 'draw.dt', function () {
        const name_links = stock_table.column(1).data();
        const names = [];
        for (let i = 0; i < name_links.length; i++) { //extract text from anchor tags
            names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
        }

        let is_obsolete = '';
        is_obsolete = jQuery("#obsolete_stock_search_term option:selected").val();

        let  list_type = '';
        if (is_obsolete == 'true') {
            list_type = 'obsoleted_stocks';
        } else if (is_obsolete == 'include_obsolete') {
            list_type = 'accessions_and_obsoleted_accessions';
        } else {
            list_type = jQuery('#stock_type_select option:selected').text()+'s' || 'null';
        }

        jQuery('#search_result_names').html(names);
        addToListMenu('results_to_list_menu', 'search_result_names', {
            listType: list_type
        });
    });

    // Instantiate the unified Search State Manager configuration
    const searchManager = window.jsMod['search_state'].create({
        submitButtonSelector: '#submit_stock_search',
        resetButtonSelector: '#reset_stock_search',
        onReset: function() {
            for (const key in editable_stockprops_search) {
                delete editable_stockprops_search[key];
            }
            _draw_editable_stockprops_search_fields();

            const type_select = document.getElementById('stock_type_select');
            if (type_select) {
                type_select.selectedIndex = [...type_select.options].findIndex(elem => elem.text.trim().toLowerCase() == 'accession') ?? 1;
            }
        },
        elements: {
            any_name: { selector: '#any_name' },
            any_name_matchtype: { selector: '#any_name_matchtype' },
            stock_type: { selector: '#stock_type_select' },
            organism: { selector: '#organism_select' },
            organization: { selector: '#organization' },
            obsolete_stock_search_term: { selector: '#obsolete_stock_search_term' },
            project: { selector: '#project' },
            location: { selector: '#location' },
            year: { selector: '#year' },
            breeding_program: { selector: '#breeding_program' },
            trait: { selector: '#trait' },
            minimum_trait_value: { selector: '#minimum_trait_value' },
            maximum_trait_value: { selector: '#maximum_trait_value' },
            // Set custom JSON mapping hook for complex, dynamically built custom properties
            editable_stockprops: {
                selector: '#editable_stockprop_search_div',
                type: 'json',
                getValue: function() { return editable_stockprops_search; },
                setValue: function(val) {
                    for (const key in editable_stockprops_search) {
                        delete editable_stockprops_search[key];
                    }
                    Object.assign(editable_stockprops_search, val);
                    _draw_editable_stockprops_search_fields();
                }
            }
        },
        onSearch: function() {
            // Standard search trigger reloads the DataTable using active criteria states
            const stock_type_selected = jQuery('#stock_type_select option:selected').text();
            _load_stock_search_results(stock_type_selected, editable_stockprops_search, stockprop_extra_columns_view, stockprop_extra_columns_view_array);
        }
    });

    // Instantiate a separate manager to independently persist and reset custom table columns
    const columnManager = window.jsMod['search_state'].create({
        submitButtonSelector: ['#editable_stockprop_view_column_add', '#editable_stockprop_view_column_remove'],
        resetButtonSelector: '#reset_stock_columns',
        elements: {
            extra_columns: {
                selector: '',
                type: 'json',
                getValue: function() { return stockprop_extra_columns_view_array; },
                setValue: function(val) {
                    if (Array.isArray(val)) {
                        stockprop_extra_columns_view_array.length = 0;
                        for (const key in stockprop_extra_columns_view) {
                            delete stockprop_extra_columns_view[key];
                        }
                        val.forEach(col => {
                            stockprop_extra_columns_view[col] = 1;
                            stockprop_extra_columns_view_array.push(col);
                        });
                        updateResultsHeader();
                    }
                }
            }
        },
        onReset: function() {
            stockprop_extra_columns_view_array.length = 0;
            stockprop_extra_columns_view = { 'organization': 1 };
            stockprop_extra_columns_view_array.push('organization');
            updateResultsHeader();
            updateResultsRows();
        }
    });

    // Initialize events, bindings and restore URL states
    columnManager.init();
    searchManager.init();

   jQuery('#stock_search_form').keypress( function( e ) {
           const code = e.keyCode || e.which;
           if( code === 13 ) {
                jQuery('#submit_stock_search').click();
           }
    } );


    // For graphical filtering, using same search params
    let run = false;
    jQuery('#stock_search_graphical_filter_onswitch').on("click", function(){
        const stock_type = jQuery('#stock_type_select option:selected').text();
        if (stock_type === 'accession'){
            jQuery.ajax ({
                url : '/ajax/search/stocks',
                data : {
                    minimal_info : 1,
                    any_name : jQuery('#any_name').val(),
                    any_name_matchtype : jQuery('#any_name_matchtype').val(),
                    stock_type,
                    organism : jQuery('#organism_select').val(),
                    person : jQuery('#person').val(),
                    trait : jQuery('#trait').val(),
                    minimum_trait_value : jQuery('#minimum_trait_value').val(),
                    maximum_trait_value : jQuery('#maximum_trait_value').val(),
                    project : jQuery('#project').val(),
                    location : jQuery('#location').val(),
                    year : jQuery('#year').val(),
                    breeding_program : jQuery('#breeding_program').val(),
                    editable_stockprop_values : JSON.stringify(editable_stockprops_search)
                },
                beforeSend: function() {
                    jQuery("#working_modal").modal("show");
                    jQuery('#stock_search_graphical_filter_div').html("[LOADING...]");
                },
                success: function(response){
                    //console.log(response);
                    jQuery("#working_modal").modal("hide");
                    const stock_ids = [];
                    for (var i=0; i<response.data.length; i++){
                        stock_ids.push(response.data[i][0]);
                    }

                    if (run) {
                        const $filterResultsDiv = jQuery('#stock_search_graphical_filter_results_div');
                        $filterResultsDiv.DataTable().destroy();
                        $filterResultsDiv.html("");
                    }
                    run = true;
                    params = {"germplasmDbIds" : stock_ids, "observationLevel" : 'plot'};
                    loadBrAPIData("<% $c->config->{main_production_site_url} %>",params,function(response){
                        useBrAPIData(response,true);
                    });

                },
                error: function(response){
                    jQuery("#working_modal").modal("hide");
                    alert("Error retrieving accessions in graphical filtering.");
                }
            });
        } else {
            jQuery('#stock_search_graphical_filter_div').html("Graphical Filtering only configured for accessions. Currently searching across "+stock_type+". Change your search to accesions to use graphical filtering.");
        }
    });


});

function _load_stock_search_results(stock_type, editable_stockprops_search, stockprop_extra_columns_view, stockprop_extra_columns_view_array){
    console.log(stock_type);
    console.log("Making AJAX request with editable stockprop "+JSON.stringify(editable_stockprops_search));

    let is_obsolete = '';
    let include_obsolete = '';
    const obsolete_stock_search_term = jQuery("#obsolete_stock_search_term option:selected").val();
    if (obsolete_stock_search_term == 'true') {
        is_obsolete = 'true';
    } else if (obsolete_stock_search_term == 'include_obsolete') {
        include_obsolete = 'true';
    }

    var export_message = 'Stock data from ' + window.location.href;
    var export_suffix = ' Stocks';
    stock_table = jQuery('#stock_search_results').DataTable({
        'destroy' : true,
        'searching' : false,
        'ordering'  : false,
        'processing': true,
        'serverSide': true,
        'lengthMenu': [
          [10,20,50,100,1000,10000,1000000000000000],
          [10,20,50,100,1000,10000,'All']
        ],
        'iDisplayLength': 100,
        'fixedFooter' : true,
        'scrollX' : true,
        'scrollY' : '350px',
        'ajax': { 'url':  '/ajax/search/stocks',
            'data': function(d) {
              d.any_name  = jQuery('#any_name').val();
              d.any_name_matchtype = jQuery('#any_name_matchtype').val();
              d.stock_type   = stock_type;
              d.organism     = jQuery('#organism_select').val();
              d.person       = jQuery('#person').val();
              d.trait        = jQuery('#trait').val();
              d.minimum_trait_value        = jQuery('#minimum_trait_value').val();
              d.maximum_trait_value        = jQuery('#maximum_trait_value').val();
              d.project      = jQuery('#project').val();
              d.location     = jQuery('#location').val();
              d.year         = jQuery('#year').val();
              d.breeding_program = jQuery('#breeding_program').val();
              d.editable_stockprop_values = JSON.stringify(editable_stockprops_search);
              d.extra_stockprop_columns_view = JSON.stringify(stockprop_extra_columns_view);
              d.stockprop_extra_columns_view_array = JSON.stringify(stockprop_extra_columns_view_array);
              d.is_obsolete = is_obsolete;
              d.include_obsolete = include_obsolete;
            },
            beforeSend: function() {
              jQuery("#working_modal").modal("show");
            },
            dataSrc: function ( json ) {
                jQuery("#working_modal").modal("hide");
                return json.data;
            },
            error: function(response){
                jQuery("#working_modal").modal("hide");
                alert("Error retrieving search results: ", response);
            },
        },
        'colReorder': true,
        'dom': 'lBfrtip',
        'rowId': 'Stock Id',
        'buttons': [ 'colvis',
            {
                extend: 'excelHtml5',
                title: document.title + export_suffix,
                exportOptions: {
                    columns: ':visible'
                }
            },
            {
                extend: 'csvHtml5',
                title: document.title + export_suffix,
                exportOptions: {
                    columns: ':visible'
                }
            },
            {
                extend: 'pdfHtml5',
                title: document.title + export_suffix,
                exportOptions: {
                    columns: ':visible'
                },
                orientation: 'landscape',
                pageSize: 'LEGAL',
            },
            {
                extend: 'print',
                exportOptions: {
                    columns: ':visible'
                },
            }
        ],
    });
}
</script>

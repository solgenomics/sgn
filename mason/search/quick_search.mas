<%args>

  $results

  $quick_search_term

  $show_times => 0

  $xrefs      => {}
  $xrefs_time => 0

</%args>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p('global.search.quick_search.quick_search_for_term', 'Quick search for "%{term}"', {term => $quick_search_term})) &>

<div class="page_introduction">
  <% $c->i18n->p('global.search.quick_search.note_the_quick_search_does_not_perform_exactly_the_same_queries_as_full_searches_for_', 'Note: The quick search does not perform exactly the same queries as full searches for the various data types. If your desired result does not appear, you may want to try again with one of the advanced search tools in the "search" menu.') |h %>
</div>

<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p('global.search.quick_search.exact_matches', 'Exact matches')) &>

<div class="well">

% if( $show_times ) {
  <div><% $c->i18n->p('global.search.quick_search.site_xref_search_time', 'Site xref search time:') |h %> <% sprintf('%0.1f sec', $xrefs_time) %></div>
% }
% if( @$xrefs ) {
  <& /sitefeatures/mixed/xref_set/link.mas, xrefs => $xrefs &>
    <hr style="border: 0; border-bottom: 1px solid #aaa; width: 90%; margin: 1.5em auto 1.2em auto"  />
% }

  <div>
    <dl>
      <dt><% $c->i18n->p('global.search.quick_search.identifiers_breeding_data', 'Identifiers - Breeding Data') |h %></dt>
      <dd>
	<div style="float: left; width: 50%">
	  <% $search{accessions} %>
	  <% $search{populations} %>
	  <% $search{vectors} %>
	  <% $search{trials} %>
	</div>
	<div style="float: right; width: 50%">
	  <% $search{traits} %>
	  <% $search{locations} %>
	  <% $search{breeding_programs} %>
	</div>
	<div style="clear: both;">&nbsp;</div>
      </dd>
      <dt><% $c->i18n->p('global.search.quick_search.identifiers_genomic_data', 'Identifiers - Genomic Data') |h %></dt>
      <dd >
	<div style="float: left; width: 50%">
          <% $search{marker} %>
          <% $search{clone} %>
          <% $search{est} %>
	</div>
	<div style="float: right; width: 50%;">
	  <% $search{unigene} %>
	  <% $search{microarray} %>
	</div>
      </dd>
    </dl>
    <span style="margin-bottom:20px;">&nbsp</span>
  </div>
</div>

</&>

<&| /page/info_section.mas,
    title => HTML::Entities::encode_entities($c->i18n->p('global.search.quick_search.fuzzy_searches', 'Fuzzy searches')),
    subtitle => HTML::Entities::encode_entities($c->i18n->p('global.search.quick_search.click_to_view_search_results', 'click to view search results')),
 &>

<div class="well">
  
  <div>
    <dl>
    <dt>
      <div style="float: left; width: 50%"><% $c->i18n->p('global.search.quick_search.identifiers', 'Identifiers') |h %></div>
      <div style="float: right; width: 50%"><% $c->i18n->p('global.search.quick_search.cdna_libraries', 'cDNA Libraries') |h %></div>
    </dt>
    <dd>
      <div style="float: left; width: 50%">
        <% $search{bac} %>
        <% $search{phenotype} %>
      </div>
      <div style="float: right; width: 50%">
	<% $search{locus_allele} %>
        <% $search{library} %>
      </div>
      <div style="clear: both; margin-bottom: -1.7em">&nbsp;</div>
    </dd>
    </dl>
  </div>

  <hr style="border: 0; border-bottom: 1px solid #aaa; width: 90%; margin: 1.5em auto 1.2em auto"  />

  <div>
    <dl>
    <dt>
      <div style="float: left; width: 50%"><% $c->i18n->p('global.search.quick_search.people_searching_by_name', 'People (searching by name)') |h %></div>
      <div style="float: right; width: 50%"><% $c->i18n->p('global.search.quick_search.annotations', 'Annotations') |h %></div>
    </dt>
    <dd>
      <div style="float: left; width: 50%">
        <% $search{people} %>
      </div>
      <div style="float: right; width: 50%">
        <% $search{manual_annotations} %>
        <% $search{automatic_annotations} %>
      </div>
      <div style="clear: both; margin-bottom: -1.7em">&nbsp;</div>
    </dd>
    </dl>
  </div>

  <hr style="border: 0; border-bottom: 1px solid #aaa; width: 90%; margin: 1.5em auto 1.2em auto"  />

  <div>
    <dl>
    <dt>
      <div style="float: left; width: 50%"><% $c->i18n->p('global.search.quick_search.images', 'Images') |h %></div>
      <div style="float: right; width: 50%"><% $c->i18n->p('global.search.quick_search.web_pages', 'Web Pages') |h %></div>
    </dt>
    <dd>
      <div style="float: left; width: 50%">
        <% $search{image} %>
      </div>
      <div style="float: right; width: 50%">
        <% $search{sgn_pages} %>
        <% $search{external_link} %>
        <% $search{web} %>
      </div>
      <div style="clear: both; margin-bottom: -1.7em">&nbsp;</div>
    </dd>
    </dl>
  </div>

</div>

</&>

<%init>

  use HTML::Entities;

  my %search = %$results;
  for my $search ( values %search ) {
      my ( $url, $desc ) = @{$search->{result}};
      $desc = HTML::Entities::encode_entities($desc);
      my $time  = $show_times ? sprintf(' (%0.1f sec)', $search->{time}) : '';
      my $html = $url ? qq|<div><a class="quicksearch_hit" href="$search->{result}[0]">$desc$time</a></div>|
                      : qq|<div class="ghosted">$desc$time</div>|;
      $search = $html;
  }

</%init>


<%once>
use HTML::Entities ();
</%once>


<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'jquery.dataTables-select-min' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css', '/documents/inc/datatables/custom_datatable_select_styles.css'] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("phenotype.root.trait_search", "Trait Search")) &>

    <&| /page/info_section.mas, anchor_title => 'Search', title => HTML::Entities::encode_entities($c->i18n->p("global.search.advanced_search.search", 'Search')), collapsible=>1, collapsed=>0 &>
        <div id="trait_search_form" class="form-horizontal well">
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.select_ontology_name_s", "Select Ontology Name(s):") |h %> </label>
                <div class="col-sm-9" >
                    <div id="trait_search_ontology_select"></div>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.search_trait_name", "Search Trait Name:") |h %> </label>
                <div class="col-sm-9" >
                    <input type="text" class="form-control" id="trait_search_name" placeholder="<% $c->i18n->p("phenotype.root.search_any_trait_name_or_piece_of_name", "Search any trait name or piece of name") |h %>"/>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.search_trait_id", "Search Trait ID:") |h %> </label>
                <div class="col-sm-9" >
                    <input type="text" class="form-control" id="trait_search_id" placeholder="<% $c->i18n->p("phenotype.root.search_any_trait_id_or_part_of_an_id", "Search any trait ID or part of an ID") |h %>"/>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.search_trait_synonym", "Search Trait Synonym:") |h %> </label>
                <div class="col-sm-9" >
                    <input type="text" class="form-control" id="trait_search_synonym" placeholder="<% $c->i18n->p("phenotype.root.search_any_trait_synonym_or_part_of_a_synonym", "Search any trait synonym or part of a synonym") |h %>"/>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.search_definition", "Search Definition:") |h %> </label>
                <div class="col-sm-9" >
                    <input type="text" class="form-control" id="trait_search_definition" placeholder="<% $c->i18n->p("phenotype.root.search_any_word_or_piece_of_definition", "Search any word or piece of definition") |h %>"/>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.subset_traits", "Subset Traits:") |h %> </label>
                <div class="col-sm-9" >
                    <div id="trait_search_list_select">
                        <% $c->i18n->p("accession.files.loading_upper", "[LOADING...]") |h %>
                    </div>
                </div>
            </div>
        </div>

        <center>
            <button class="btn btn-primary" id="submit_trait_search" /><% $c->i18n->p("global.search.advanced_search.search", "Search") |h %></button>
        </center>
    </&>

    <&| /page/info_section.mas, anchor_title => 'Results', title => HTML::Entities::encode_entities($c->i18n->p("global.gem_experiment_search.results", 'Results')), collapsible=>1, collapsed=>0 &>

        <div class="well well-sm">
            <div class="panel panel-default">
                <div class="panel-body">

                    <table id="trait_search_results" width="100%" class="table table-hover table-striped">
                    <thead>
                      <tr>
                        <th><% $c->i18n->p("styleguide.demo.trial_table.select", "Select") |h %></th>
                        <th><% $c->i18n->p("phenotype.root.copy_name_id", "Copy Name|ID") |h %></th>
                        <th><% $c->i18n->p("phenotype.root.trait_id", "Trait ID") |h %></th>
                        <th><% $c->i18n->p("phenotype.root.trait_name.4f1c8cb", "Trait Name") |h %></th>
                        <th><% $c->i18n->p("lists.validation.synonym_column", "Synonym") |h %></th>
                        <th><% $c->i18n->p("phenotype.root.definition.f21575b", "Definition") |h %></th>
                        <th><% HTML::Entities::decode_entities($c->i18n->p("phenotype.root.extra.trait_nbsp_usage", "Trait&nbsp;Usage")) |h %></th>
                      </tr>
                    </thead>
                    </table>

                    <button type="button" class="selectAll-dt"><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
                    <button type="button" class="deselectAll-dt"><% $c->i18n->p("phenotype.root.deselect_all", "Deselect All") |h %></button>

                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-body">

                    <&| /page/info_section.mas, anchor_title => 'Copy Selected Results to a List', title => HTML::Entities::encode_entities($c->i18n->p("phenotype.root.copy_selected_results_to_a_list", 'Copy Selected Results to a List')), collapsible=>1, collapsed=>0, subtitle=>("<i>" . HTML::Entities::encode_entities($c->i18n->p("phenotype.root.copy_the_trait_names_currently_selected_in_the_search_results", "Copy the trait names currently selected in the search results table to a new or exisiting list")) . "</i>")&>
                    <br>
                    <p><em><span id="trait_result_count">0</span> <% $c->i18n->p("phenotype.root.trait_s_selected", "trait(s) selected.") |h %></em></p>
                    <div style="text-align:right" id="traits_to_list_menu"></div>
                    <div id="trait_result_names" style="display: none;"></div>
                    </&>

                </div>
            </div>
        </div>
    </&>

<& /breeders_toolbox/add_new_trait_dialogs.mas &>

    <&| /page/info_section.mas, anchor_title => 'Help', title => HTML::Entities::encode_entities($c->i18n->p("global.search.datasets.help", 'Help')), collapsible=>1, collapsed=>0 &>
        <div class="well well-sm">
            <div class="panel panel-default">
                <div class="panel-body">
                    <h2><% $c->i18n->p("phenotype.root.is_the_trait_you_are_looking_for_not_here", "Is the trait you are looking for not here?") |h %></h2>

%  if ($c->config->{allow_observation_variable_submission_interface}) {
                        <button class="btn btn-primary" name="add_new_observation_variable_button"><% $c->i18n->p("phenotype.root.add_a_new_observation_variable_to_the_database", "Add A New Observation Variable To the Database") |h %></button>
%  } else {
                        <p><% $c->i18n->p("phenotype.root.please_submit_your_new_trait", "Please submit your new trait") |h %> <a href="http://submit.rtbbase.org/"><% $c->i18n->p("phenotype.root.using_the_trait_submission_form", "using the trait submission form") |h %></a>.</p>
                        <p><% $c->i18n->p("phenotype.root.to_speed_up_addition_of_your_trait_into_the_database", "To speed up addition of your trait into the database please contact us using the") |h %> <a href="/contact/form"><% $c->i18n->p("phenotype.root.contact_form", "Contact Form") |h %></a>.</p>
%  }
                </div>
            </div>
        </div>
    </&>

</div>

<script>

jQuery(document).ready(function () {

    get_select_box('trait_variable_ontologies', 'trait_search_ontology_select', { 'name' : 'trait_search_ontology_select_id', 'cvprop_type_name':JSON.stringify(['trait_ontology','composed_trait_ontology']) });

    jQuery('[data-toggle="tooltip"]').tooltip();

    var lo = new CXGN.List();
    jQuery('#trait_search_list_select').html(lo.listSelect('trait_search_list_select', [ 'traits' ], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("phenotype.root.leave_blank_to_see_all_traits", "Leave blank to see all traits") : 'Leave blank to see all traits'), undefined, undefined));

    jQuery(document).on('change', '#trait_search_list_select', function(){
        _draw_trait_search_result_table();
    });

    jQuery('#submit_trait_search').click(function(){
        _draw_trait_search_result_table();
    });

    jQuery('#trait_search_form').keypress(function(e){
        var code = e.keyCode || e.which;
        if( code == 13 ) {
             jQuery('#submit_trait_search').click();
        }
    });

    parseArgs();

    var trait_table;
    _draw_trait_search_result_table();

    function _draw_trait_search_result_table (){
        var selectedontologies = [];
        jQuery(document).find('input[name="trait_search_ontology_select_id"]:checked').each(function (i, ob) {
            selectedontologies.push(jQuery(ob).val());
        });

        trait_table = jQuery('#trait_search_results').DataTable({
            'destroy': true,
            'searching' : false,
            'ordering'  : false,
            'processing': true,
            'serverSide': true,
            'lengthMenu': [10,20,50],
            'columnDefs': [ {
                'orderable': false,
                'className': 'select-checkbox',
                'targets':   0
            } ],
            'select': {
                'style':    'multi',
                'selector': 'td:not(:nth-child(2))',
            },
            'ajax': {
                'url': '/ajax/search/traits',
                'data': function(d) {
                    d.trait_search_list_id  = jQuery('#trait_search_list_select_list_select').val();
                    d.trait_any_name  = jQuery('#trait_search_name').val();
                    d.trait_id = jQuery('#trait_search_id').val();
                    d.trait_synonym = jQuery('#trait_search_synonym').val();
                    d.trait_definition  = jQuery('#trait_search_definition').val();
                    d.ontology_db_id = selectedontologies;
                }
            },
            "order": [[ 1, "asc" ]]
        });
    }

   jQuery('.selectAll-dt').click(function(){
     trait_table.rows().select();
     return false;
   });
   jQuery('.deselectAll-dt').click(function(){
     trait_table.rows().deselect();
     return false;
   });
   var selection_changed = function () {
     var selected_rows = trait_table.rows({'selected':true});
     jQuery("#trait_result_count").text(selected_rows.count());
     //console.log(selected_rows.data());

     var name_links = selected_rows.data().map(function(row){
         return [row[6], row[7]];
         trait_table.rows().deselect();
     });

     var names = [];
     for (var i = 0; i < name_links.length; i++) { //extract and combine trait name and id from anchor tags
       names.push(name_links[i][0] + '|' + name_links[i][1] + '\n');
     }

     jQuery('#trait_result_names').html(names);
     addToListMenu('traits_to_list_menu', 'trait_result_names', {
       listType: 'traits'
     });
   };
   trait_table.on( 'deselect', selection_changed);
   trait_table.on( 'select', selection_changed);

});


/**
 * Parse query params sent to the page
 * - name = trait name to search on
 */
function parseArgs() {
    const params = new URLSearchParams(window.location.search);
    if ( params.has('name') ) {
        jQuery("#trait_search_name").val(params.get('name'));
    }
}

/**
 * Copy the specifed trait information to the user's clipboard
 * - name = trait name
 * - accession = trait accession term
 * - id = trait cvterm id
 */
async function copy(name, accession, id) {
    try {
        await navigator.clipboard.writeText([name, accession].join('|'));
        jQuery(".btn-" + id).removeClass("btn-info").addClass("btn-success").html("<span class='glyphicon glyphicon-ok'></span>");
    }
    catch (err) {
        jQuery(".btn-" + id).removeClass("btn-info").addClass("btn-danger").html("<span class='glyphicon glyphicon-remove'></span>");
    }
    finally {
        setTimeout(() => {
            jQuery(".btn-" + id).removeClass("btn-success btn-danger").addClass("btn-info").html("<span class='glyphicon glyphicon-copy'></span>");
        }, 2500)
    }
    return false;
}

</script>


<style type="text/css">
    #trait_search_results td:nth-child(2) {
        vertical-align: middle;
    }
</style>

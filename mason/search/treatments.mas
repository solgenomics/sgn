<%once>
use HTML::Entities ();
</%once>


<%args>
</%args>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'jquery.dataTables-select-min' ] &>
<& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css', '/documents/inc/datatables/custom_datatable_select_styles.css'] &>

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p("transformation.root.treatment_search", "Treatment Search")) &>

    <&| /page/info_section.mas, anchor_title => 'Search', title => HTML::Entities::encode_entities($c->i18n->p("global.search.advanced_search.search", 'Search')), collapsible=>1, collapsed=>0 &>
        <div id="treatment_search_form" class="form-horizontal well">
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.select_ontology_name_s", "Select Ontology Name(s):") |h %> </label>
                <div class="col-sm-9" >
                    <div id="treatment_search_ontology_select"></div>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.search_treatment_name", "Search Treatment Name:") |h %> </label>
                <div class="col-sm-9" >
                    <input type="text" class="form-control" id="treatment_search_name" placeholder="<% $c->i18n->p("transformation.root.search_any_treatment_name_or_piece_of_name", "Search any treatment name or piece of name") |h %>"/>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.search_treatment_id", "Search Treatment ID:") |h %> </label>
                <div class="col-sm-9" >
                    <input type="text" class="form-control" id="treatment_search_id" placeholder="<% $c->i18n->p("phenotype.root.search_any_trait_id_or_part_of_an_id", "Search any trait ID or part of an ID") |h %>"/>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.search_treatment_synonym", "Search Treatment Synonym:") |h %> </label>
                <div class="col-sm-9" >
                    <input type="text" class="form-control" id="treatment_search_synonym" placeholder="<% $c->i18n->p("phenotype.root.search_any_trait_synonym_or_part_of_a_synonym", "Search any trait synonym or part of a synonym") |h %>"/>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("phenotype.root.search_definition", "Search Definition:") |h %> </label>
                <div class="col-sm-9" >
                    <input type="text" class="form-control" id="treatment_search_definition" placeholder="<% $c->i18n->p("phenotype.root.search_any_word_or_piece_of_definition", "Search any word or piece of definition") |h %>"/>
                </div>
            </div>
            <div class="form-group form-group-sm">
                <label class="col-sm-3 control-label"><% $c->i18n->p("transformation.root.subset_treatments", "Subset Treatments:") |h %> </label>
                <div class="col-sm-9" >
                    <div id="treatment_search_list_select">
                        <% $c->i18n->p("accession.files.loading_upper", "[LOADING...]") |h %>
                    </div>
                </div>
            </div>
        </div>

        <center>
            <button class="btn btn-primary" id="submit_treatment_search" /><% $c->i18n->p("global.search.advanced_search.search", "Search") |h %></button>
        </center>
    </&>

    <&| /page/info_section.mas, anchor_title => 'Results', title => HTML::Entities::encode_entities($c->i18n->p("global.gem_experiment_search.results", 'Results')), collapsible=>1, collapsed=>0 &>

        <div class="well well-sm">
            <div class="panel panel-default">
                <div class="panel-body">

                    <table id="treatment_search_results" width="100%" class="table table-hover table-striped">
                    <thead>
                      <tr>
                        <th><% $c->i18n->p("styleguide.demo.trial_table.select", "Select") |h %></th>
                        <th><% $c->i18n->p("phenotype.root.copy_name_id", "Copy Name|ID") |h %></th>
                        <th><% $c->i18n->p("transformation.root.treatment_id", "Treatment ID") |h %></th>
                        <th><% $c->i18n->p("program.management_factor_details.name", "Treatment Name") |h %></th>
                        <th><% $c->i18n->p("phenotype.definition", "Definition") |h %></th>
                        <th><% $c->i18n->p("phenotype.treatment", "Treatment") |h %>&nbsp;<% $c->i18n->p("stock_search.section.usage", "Usage") |h %></th>
                      </tr>
                    </thead>
                    </table>

                    <button type="button" class="selectAll-dt"><% $c->i18n->p("global.search_wizard.select_all", "Select All") |h %></button>
                    <button type="button" class="deselectAll-dt"><% $c->i18n->p("phenotype.deselect_all", "Deselect All") |h %></button>

                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-body">

                    <&| /page/info_section.mas, anchor_title => 'Copy Selected Results to a List', title => HTML::Entities::encode_entities($c->i18n->p("phenotype.copy_selected_results_to_a_list", 'Copy Selected Results to a List')), collapsible=>1, collapsed=>0, subtitle=>("<i>" . HTML::Entities::encode_entities($c->i18n->p("transformation.root.copy_the_treatment_names_currently_selected_in_the_search_results", "Copy the treatment names currently selected in the search results table to a new or existing list")) . "</i>")&>
                    <br>
                    <p><em><span id="treatment_result_count">0</span> <% $c->i18n->p("transformation.root.treatment_s_selected", "treatment(s) selected.") |h %></em></p>
                    <div style="text-align:right" id="treatments_to_list_menu"></div>
                    <div id="treatment_result_names" style="display: none;"></div>
                    </&>

                </div>
            </div>
        </div>
    </&>

</div>

<script>

jQuery(document).ready(function () {

    get_select_box('trait_variable_ontologies', 'treatment_search_ontology_select', { 'name' : 'treatment_search_ontology_select_id', 'cvprop_type_name':JSON.stringify(['experiment_treatment_ontology', 'composed_experiment_treatment_ontology']) });

    jQuery('[data-toggle="tooltip"]').tooltip();

    var lo = new CXGN.List();
    jQuery('#treatment_search_list_select').html(lo.listSelect('treatment_search_list_select', [ 'traits' ], (window.SGN && window.SGN.i18n ? window.SGN.i18n.p("transformation.root.leave_blank_to_see_all_treatments", "Leave blank to see all treatments") : 'Leave blank to see all treatments'), undefined, undefined));

    jQuery(document).on('change', '#treatment_search_list_select', function(){
        _draw_treatment_search_result_table();
    });

    jQuery('#submit_treatment_search').click(function(){
        _draw_treatment_search_result_table();
    });

    jQuery('#treatment_search_form').keypress(function(e){
        var code = e.keyCode || e.which;
        if( code == 13 ) {
             jQuery('#submit_treatment_search').click();
        }
    });

    parseArgs();

    var treatment_table;
    _draw_treatment_search_result_table();

    function _draw_treatment_search_result_table (){
        var selectedontologies = [];
        jQuery(document).find('input[name="treatment_search_ontology_select_id"]:checked').each(function (i, ob) {
            selectedontologies.push(jQuery(ob).val());
        });

        treatment_table = jQuery('#treatment_search_results').DataTable({
            'destroy': true,
            'searching' : false,
            'ordering'  : false,
            'processing': true,
            'serverSide': true,
            'lengthMenu': [10,20,50],
            'columnDefs': [ {
                'orderable': false,
                'className': 'select-checkbox',
                'targets':   0
            } ],
            'select': {
                'style':    'multi',
                'selector': 'td:not(:nth-child(2))',
            },
            'ajax': {
                'url': '/ajax/search/treatments',
                'data': function(d) {
                    d.treatment_search_list_id  = jQuery('#treatment_search_list_select_list_select').val();
                    d.treatment_any_name  = jQuery('#treatment_search_name').val();
                    d.treatment_id = jQuery('#treatment_search_id').val();
                    d.treatment_synonym = jQuery('#treatment_search_synonym').val();
                    d.treatment_definition  = jQuery('#treatment_search_definition').val();
                    d.ontology_db_id = selectedontologies;
                }
            },
            "order": [[ 1, "asc" ]]
        });
    }

   jQuery('.selectAll-dt').click(function(){
     treatment_table.rows().select();
     return false;
   });
   jQuery('.deselectAll-dt').click(function(){
     treatment_table.rows().deselect();
     return false;
   });
   var selection_changed = function () {
     var selected_rows = treatment_table.rows({'selected':true});
     jQuery("#treatment_result_count").text(selected_rows.count());
     //console.log(selected_rows.data());

     var name_links = selected_rows.data().map(function(row){
         return [row[6], row[7]];
         treatment_table.rows().deselect();
     });

     var names = [];
     for (var i = 0; i < name_links.length; i++) { //extract and combine treatment name and id from anchor tags
       names.push(name_links[i][0] + '|' + name_links[i][1] + '\n');
     }

     jQuery('#treatment_result_names').html(names);
     addToListMenu('treatments_to_list_menu', 'treatment_result_names', {
       listType: 'traits'
     });
   };
   treatment_table.on( 'deselect', selection_changed);
   treatment_table.on( 'select', selection_changed);

});


/**
 * Parse query params sent to the page
 * - name = treatment name to search on
 */
function parseArgs() {
    const params = new URLSearchParams(window.location.search);
    if ( params.has('name') ) {
        jQuery("#treatment_search_name").val(params.get('name'));
    }
}

/**
 * Copy the specified treatment information to the user's clipboard
 * - name = treatment name
 * - accession = treatment accession term
 * - id = treatment cvterm id
 */
async function copy(name, accession, id) {
    try {
        await navigator.clipboard.writeText([name, accession].join('|'));
        jQuery(".btn-" + id).removeClass("btn-info").addClass("btn-success").html("<span class='glyphicon glyphicon-ok'></span>");
    }
    catch (err) {
        jQuery(".btn-" + id).removeClass("btn-info").addClass("btn-danger").html("<span class='glyphicon glyphicon-remove'></span>");
    }
    finally {
        setTimeout(() => {
            jQuery(".btn-" + id).removeClass("btn-success btn-danger").addClass("btn-info").html("<span class='glyphicon glyphicon-copy'></span>");
        }, 2500)
    }
    return false;
}

</script>


<style type="text/css">
    #treatment_search_results td:nth-child(2) {
        vertical-align: middle;
    }
</style>

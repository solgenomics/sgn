<%args>

  $db_name => 'SP'
  $search  => 'traits'

</%args>


<&| /page/info_section.mas, anchor_title => 'Search and browse tree of traits',
    title       => HTML::Entities::encode_entities($c->i18n->p("phenotype.root.search_and_browse_tree_of_traits", 'Search and browse tree of traits')),
    collapsible=>1, collapsed=>0
&>
  <&| /page/explanation.mas &>
     Browse trait terms using the expandable tree below, or use the
     search boxes to find traits by exact ID or by searching their
     descriptions.
  </&>


<& /ontology/browser.mas,
   root_nodes => $db_name,
   db_name    => $db_name,
   title      => $c->i18n->p("phenotype.root.search_and_browse_tree_of_traits", "Search and browse tree of traits"),
   expand => 1,
 &>



</&>


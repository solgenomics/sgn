<%once>
use HTML::Entities ();
</%once>

<%doc>
QTL search form.
</%doc>

<%perl>

my $qtl_tool = CXGN::Phenome::Qtl::Tools->new();
my $links    = $qtl_tool->browse_traits();
my @qtl_pops = $qtl_tool->has_qtl_data();

my  $pop_links;

foreach my $qtl_pop (@qtl_pops) 
  {
    my $is_public  = $qtl_pop->get_privacy_status();
    my $owner_id   = $qtl_pop->get_sp_person_id();
    my $user_type  = $c->user->get_object->get_user_type() if $c->user;
    my $user_id    = $c->user->get_object->get_sp_person_id if $c->user;
   
    if ( $is_public || $user_type eq 'curator' || $user_id == $owner_id )
      {
        my $pop_id   = $qtl_pop->get_population_id();
        my $pop_name = $qtl_pop->get_name();
        $pop_links  .= qq |<a href="/qtl/population/$pop_id">$pop_name</a> <br /> |;     
      }
  }
  
</%perl>

<div class="container-fluid">

<&| /page/info_section.mas, anchor_title => 'Search QTLs', title => HTML::Entities::encode_entities($c->i18n->p("phenotype.root.search_qtls", 'Search QTLs')), collapsible=>1, collapsed=>0, subtitle=>("[<a href=\"/qtl/form\">" . HTML::Entities::encode_entities($c->i18n->p("phenotype.root.submit_qtl_data", "Submit QTL Data")) . "</a>]   [<a href=\"/qtl/submission/guide\">" . HTML::Entities::encode_entities($c->i18n->p("phenotype.root.submission_guide", "Submission Guide")) . "</a>]   [<a href=\"/qtl/search/help\">" . HTML::Entities::encode_entities($c->i18n->p("phenotype.root.search_help", "Search Help")) . "</a>]") &>

<form  action= "/qtl/search/results" method="post">
  <table align=center cellpadding=20px>
    <tr>
      <td>
        <h4><% $c->i18n->p("phenotype.root.extra.browse_traits_with_qtls", "Browse Traits With QTLs:") |h %> <% $links %></h4>
      </td>
    </tr>
  </table>
  <br/>
  <div class="well">
  <table align=center>
    <tr>
      <td><h5><% $c->i18n->p("phenotype.root.search_qtls_with_trait_name", "Search QTLs With Trait Name:") |h %></h5></td>
    </tr>
    <tr>
      <td><input class="form-control" type="text" name="trait" >
      <br/><input class="btn btn-primary" type="submit" value="<% $c->i18n->p("global.search.advanced_search.search", "Search") |h %>"></td>
    </tr>
  </table>
  </div>
  <table align=center cellpadding=20px>
    <tr>
      <td>
        <h4><% $c->i18n->p("phenotype.root.browse_qtl_populations", "Browse QTL Populations:") |h %></h4><br/><% $pop_links %>
      </td>
    </tr>
  </table>
</form>

</&>

</div>

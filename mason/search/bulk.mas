<%init>
use HTML::Entities ();
</%init>

<& /util/import_javascript.mas, classes => [ 'jquery', 'jquery.dataTables', 'jquery.dataTables-buttons-min', 'jszip-min', 'buttons.bootstrap-min', 'buttons.html5-min' ],  &>

<div class="container-fluid">

<& /page/page_title.mas, title => HTML::Entities::encode_entities($c->i18n->p('global.search.bulk.bulk_search', 'Bulk Search')) &>

<p><% $c->i18n->p('global.search.bulk.the_bulk_search_will_check_a_list_of_data_items_if_they_exist_in_the_database_for_the', 'The Bulk Search will check a list of data items if they exist in the database for the specified data type.') |h %><p>

<br />

<!-- QUERY SECTION -->
<div id="bulk_search_query">

    <h3><% $c->i18n->p('global.search.bulk.data_type', 'Data Type') |h %></h3>

    <select id="bulk_search_type" class="form-control" disabled>
        <option><% $c->i18n->p('global.search.bulk.loading', 'Loading...') |h %></option>
    </select>

    <br />

    <h3><% $c->i18n->p('global.search.bulk.data_items', 'Data Items') |h %></h3>

    <p><% $c->i18n->p('global.search.bulk.enter_the_names_of_the_data_items_one_per_line', 'Enter the names of the data items (one per line)') |h %></p>

    <textarea id="bulk_search_items" class="form-control" rows="25"></textarea>

    <br />

    <button id="bulk_search_start" class="btn btn-primary btn-block"><% $c->i18n->p('global.search.bulk.search', 'Search') |h %></button>

</div>


<!-- RESULTS SECTION -->
<div id="bulk_search_results" style="display: none">

    <h3><% $c->i18n->p('global.search.bulk.existing_items', 'Existing Items') |h %></h3>

    <table id="bulk_search_existing" class="table table-striped table-hover">
        <tr>
            <th><% $c->i18n->p('global.search.bulk.name', 'Name') |h %></th>
        </tr>
    </table>

    <!-- Add existing items to List -->
    <br />
<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p('global.search.bulk.copy_existing_items_to_a_list', 'Copy Existing Items to a List')), collapsible=>1, collapsed=>0, subtitle => ''&>
    <div style="text-align:right" id="list_menu_existing"></div>
    <div id="list_item_names_existing" style="display: none;"></div>
</&>
    <br /><br />

    <h3><% $c->i18n->p('global.search.bulk.missing_items', 'Missing Items') |h %></h3>

    <table id="bulk_search_missing" class="table table-striped table-hover">
        <tr>
            <th><% $c->i18n->p('global.search.bulk.name', 'Name') |h %></th>
        </tr>
    </table>

    <!-- Add missing items to List -->
    <br />
<&| /page/info_section.mas, title => HTML::Entities::encode_entities($c->i18n->p('global.search.bulk.copy_missing_items_to_a_list', 'Copy Missing Items to a List')), collapsible=>1, collapsed=>1, subtitle => ''&>
    <div style="text-align:right" id="list_menu_missing"></div>
    <div id="list_item_names_missing" style="display: none;"></div>
</&>
    <br /><br />
    <br /><br />

    <button id="bulk_search_back" class="btn btn-primary btn-block"><span class="glyphicon glyphicon-chevron-left"></span>&nbsp;<% $c->i18n->p('global.search.bulk.back_to_search', 'Back to Search') |h %></button>

</div>

<br /><br />

</div>


<script type="text/javascript">
jQuery(document).ready(function() {

    // Get the supported data types
    updateDataTypes();

    // Click Listeners
    jQuery('#bulk_search_start').click(bulkSearch);
    jQuery('#bulk_search_back').click(toggleSections);

    // Init DataTables
    jQuery('#bulk_search_existing').DataTable({
        dom: 'Bfrtip',
        autoWidth: false,
        data: [],
        columns: [{ title: (window.SGN && SGN.i18n ? SGN.i18n.p("global.search.bulk.name.7e68cb0", "Name") : "Name") }],
        buttons: [
            {
                extend: 'excelHtml5',
                title: 'existing_items',
                exportOptions: {format: {header: function () { return 'Name'; }}}
            },
            {
                extend: 'csvHtml5',
                title: 'existing_items',
                exportOptions: {format: {header: function () { return 'Name'; }}}
            }
        ]
    });
    jQuery('#bulk_search_missing').DataTable({
        dom: 'Bfrtip',
        autoWidth: false,
        data: [],
        columns: [{ title: (window.SGN && SGN.i18n ? SGN.i18n.p("global.search.bulk.name.7e68cb0", "Name") : "Name") }],
        buttons: [
            {
                extend: 'excelHtml5',
                title: 'missing_items',
                exportOptions: {format: {header: function () { return 'Name'; }}}
            },
            {
                extend: 'csvHtml5',
                title: 'missing_items',
                exportOptions: {format: {header: function () { return 'Name'; }}}
            }
        ]
    });

});


/**
 * Get the supported data types
 * Update the select box with the data types
 */
function updateDataTypes() {
    let urlParams = new URLSearchParams(window.location.search);
    let type_name = urlParams.get('type');
    let type_id = urlParams.get('type_id');

    jQuery.ajax({
        url: '/list/alltypes',
        success: function(data) {
            if ( data && data.length > 0 ) {
                let html = "";
                data.sort((a,b) => a[1].toUpperCase().localeCompare(b[1].toUpperCase())); 
                for ( let i = 0; i < data.length; i++ ) {
                    let id = data[i][0];
                    let name = data[i][1];
                    let selected = parseInt(id) === parseInt(type_id) || name === type_name ? 'selected' : '';
                    html += "<option value='" + id + "' " + selected + ">" + name + "</option>";
                }
                jQuery('#bulk_search_type').html(html).attr('disabled', false);
            }
        },
        error: function() {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.search.bulk.could_not_get_supported_data_types", "Could not get supported data types!") : "Could not get supported data types!"));
        }
    })
}


/**
 * Perform the bulk search
 * call displayResults() when complete
 */
function bulkSearch() {
    let type_id = jQuery('#bulk_search_type').val();
    let type_name = jQuery("#bulk_search_type option:selected").text();
    let names = jQuery('#bulk_search_items').val().split('\n');
    names = names.filter(function(str) {
        return /\S/.test(str);
    });

    jQuery('#bulk_search_start').text((window.SGN && SGN.i18n ? SGN.i18n.p("global.search.bulk.searching", "Searching...") : "Searching...")).attr('disabled', true);

    jQuery.ajax({
        url: "/list/validate/temp",
        method: 'POST',
        data: {
            "type": type_name,
            "items": JSON.stringify(names),
        },
        success: function(data) {
            jQuery('#bulk_search_start').text((window.SGN && SGN.i18n ? SGN.i18n.p("global.search.bulk.search.7883f4b", "Search") : "Search")).attr('disabled', false);
            displayResults(data, type_name);
        },
        error: function() {
            alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.search.bulk.could_not_run_bulk_search", "Could not run bulk search!") : "Could not run bulk search!"));
            jQuery('#bulk_search_start').text((window.SGN && SGN.i18n ? SGN.i18n.p("global.search.bulk.search.7883f4b", "Search") : "Search")).attr('disabled', false);
        }
    });
}


/**
 * Display the results of the bulk search
 * @param {Object} data JSON response from server
 * @param {String} type List type name
 */
function displayResults(data, type) {
    let dte = jQuery('#bulk_search_existing').DataTable();
    let dtm = jQuery('#bulk_search_missing').DataTable();
    dte.clear();
    dtm.clear();

    if ( data ) {
        if ( data.error ) {
            alert(data.error);
        }
        else if ( data.existing && data.missing ) {

            // Setup data for adding to list
            jQuery('#list_item_names_existing').html(data.existing ? data.existing.join("\n") : "");
            addToListMenu('list_menu_existing', 'list_item_names_existing', {
                listType: type
            });
            jQuery('#list_item_names_missing').html(data.missing ? data.missing.join("\n") : "");
            addToListMenu('list_menu_missing', 'list_item_names_missing', {
                listType: type
            });

            // Setup data for data tables
            let e = [];
            while(data.existing.length) e.push(data.existing.splice(0,1));
            let m = [];
            while(data.missing.length) m.push(data.missing.splice(0,1));
            dte.rows.add(e);
            dtm.rows.add(m);
        }
    }
    else {
        alert((window.SGN && SGN.i18n ? SGN.i18n.p("global.search.bulk.invalid_response_from_the_server", "Invalid response from the server!") : "Invalid response from the server!"));
    }

    dte.draw();
    dtm.draw();

    toggleSections();
}

/**
 * Toggle the display of the query and results sections
 */
function toggleSections() {
    jQuery('#bulk_search_query').toggle();
    jQuery('#bulk_search_results').toggle();
}
</script>

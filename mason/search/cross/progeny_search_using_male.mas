<%once>
use HTML::Entities ();
</%once>


<& /page/page_title.mas, title=>HTML::Entities::encode_entities($c->i18n->p("cross.pages.search_progenies_of_male_parents_populations", "Search Progenies of Male Parents / Populations")) &>
<br>
<&| /page/info_section.mas, anchor_title => 'Search', title => HTML::Entities::encode_entities($c->i18n->p("global.search.advanced_search.search", "Search")), collapsible=>1, collapsed=>0&>
    <div class="row" id="progeny_search_form_male_parent" >
        <div class="col-sm-12 well">
            <div class="row">
                <div class="col-sm-10">
                    <div class="form-horizontal">
                        <div class="form-group form-group-sm">
                            <label class="control-label col-sm-3"><% $c->i18n->p("cross.pages.male_parent_population.bacba5a", "Male Parent / Population:") |h %></label>
                            <div class="col-sm-9">
                                <div class="input-group">
                                    <input type="text" class="form-control" id="male_parent" placeholder="<% $c->i18n->p("cross.pages.enter_male_parent", "Enter male parent") |h %>">
                                    <div class="input-group-btn">
                                        <button class="btn btn-info" id="search_pedigree_female_parents"><i class="glyphicon glyphicon-search"></i> <% $c->i18n->p("accession.related_stock.header.female_parent", "Female Parent") |h %> </button>
                                        <button class="btn btn-primary" id="search_all_progenies_using_male"><i class="glyphicon glyphicon-search"></i> <% $c->i18n->p("cross.pages.all_progenies_of_this_male_parent", "All Progenies of this Male Parent") |h %> </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group form-group-sm">
                            <label class="control-label col-sm-3"><% $c->i18n->p("cross.ui.female_parent.d4f10f0", "Female Parent:") |h %></label>
                            <div class="col-sm-9" >
                                <div class="input-group">
                                    <select class="form-control" id="female_parent">
                                        <option value=""><% $c->i18n->p("cross.pages.choose_male_parent_first", "Choose male parent first") |h %></option>
                                    </select>
                                    </select>
                                    <div class="input-group-btn">
                                        <button class="btn btn-info" id="search_pedigree_male_female"><i class="glyphicon glyphicon-search"></i> <% $c->i18n->p("cross.pages.progenies_of_these_parents", "Progenies of these Parents") |h %> </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</&>
<&| /page/info_section.mas, anchor_title => 'Search Results', title => HTML::Entities::encode_entities($c->i18n->p("global.search.annotation.genes.search_results", "Search Results")), collapsible=>1, collapsed=>0&>
    <div class="well well-sm">
        <& /util/import_css.mas, paths => ['/documents/inc/datatables/jquery.dataTables.css'] &>
        <div class="panel panel-default">
            <div class="panel-body">
                <table id="pedigree_male_female_search_results" width="100%" class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th><% $c->i18n->p("accession.related_stock.header.female_parent", "Female Parent") |h %></th>
                            <th><% $c->i18n->p("cross.pages.male_parent_population.ec4f8dc", "Male Parent / Population") |h %></th>
                            <th><% $c->i18n->p("cross.ui.progeny", "Progeny") |h %></th>
                            <th><% $c->i18n->p("accession.related_stock.header.cross_type_upper", "Cross Type") |h %></th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-body">
                <&| /page/info_section.mas, anchor_title => 'Copy Progenies to a List', title => HTML::Entities::encode_entities($c->i18n->p("cross.pages.copy_progenies_to_a_list", "Copy Progenies to a List")), collapsible=>1, collapsed=>1, subtitle=>("<i>" . HTML::Entities::encode_entities($c->i18n->p("cross.pages.copy_the_progeny_names_showing_in_table_to_a_new", "Copy the progeny names showing in table to a new or exisiting list")) . "</i>")&>
                    <br>
                    <div style="text-align:right" id="progenies_to_list_menu"></div>
                    <div id="progeny_names" style="display: none;"></div>
                </&>
            </div>
        </div>
    </div>
</&>


<script>

jQuery(document).ready(function (){

    jQuery("#male_parent").autocomplete({
        source:'/ajax/stock/pedigree_male_parent_autocomplete',
    });


    jQuery("#search_pedigree_female_parents").click(function(){

        jQuery.ajax({
            url:'/ajax/search/pedigree_female_parents',
            data:{'pedigree_male_parent':jQuery('#male_parent').val()},
            success: function(response){
                console.log(response);
                var html = '<select id = "female_parent" >';
                for (var i=0; i<response.data.length; i++) {
                    html = html + "<option value='"+response.data[i][0]+ "'>" + response.data[i][0] + "</option>";
                }
                html = html + "</select>";
                console.log(html);
                if(i ==''){
                    alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("cross.pages.no_female_parent", "No female parent") : "No female parent"));
                    return;
                }

                jQuery('#female_parent').html(html);
            },
            error:function(response){
                alert((window.SGN && window.SGN.i18n ? window.SGN.i18n.p("folder.new.request_error", "An error occurred") : "An error occurred"));
            }
        });
    });


    jQuery('#search_all_progenies_using_male').click(function(){

        var table = jQuery('#pedigree_male_female_search_results').DataTable({
            'searching': true,
            'paging': true,
            'ordering': false,
            'destroy': true,
            'ajax': {'url':'/ajax/search/progenies',
                data:{'pedigree_male_parent':jQuery('#male_parent').val()},
            }
        });

        jQuery('#pedigree_male_female_search_results').on( 'draw.dt', function (){
            var name_links = table.column(2).data();
            var names = [];
            //console.log("name links are: "+JSON.stringify(name_links));
            for (var i = 0; i < name_links.length; i++) {
                names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
            }
            jQuery('#progeny_names').html(names);

            addToListMenu('progenies_to_list_menu', 'progeny_names',{
                listType:'accessions'
            });
        });
    });


    jQuery('#search_pedigree_male_female').click(function(){

        var table = jQuery('#pedigree_male_female_search_results').DataTable({
            'searching': true,
            'paging': true,
            'ordering': false,
            'destroy': true,
            'ajax': {'url':'/ajax/search/progenies',
                data:{'pedigree_female_parent':jQuery('#female_parent').val(),
                    'pedigree_male_parent':jQuery('#male_parent').val(),
                    }
            }
        });

        jQuery('#pedigree_male_female_search_results').on( 'draw.dt', function (){
            var name_links = table.column(2).data();
            var names = [];
            //console.log("name links are: "+JSON.stringify(name_links));
            for (var i = 0; i < name_links.length; i++) {
                names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
            }

            jQuery('#progeny_names').html(names);

            addToListMenu('progenies_to_list_menu', 'progeny_names',{
                listType:'accessions'
            });
        });
    });


});


</script>

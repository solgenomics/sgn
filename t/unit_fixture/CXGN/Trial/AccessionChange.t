sub plants_of { my $plot_id = shift; return [ sort map { $_->object_id } $schema->resultset('Stock::StockRelationship')->search({ subject_id => $plot_id, type_id => $t{plant_of} })->all ]; }
sub tissue_samples_of {
    my $parent_ids = shift;
    return [ sort map { $_->subject_id } $schema->resultset('Stock::StockRelationship')->search({ 'me.object_id' => { -in => $parent_ids }, 'me.type_id' => $t{tissue_sample_of}, 'subject.type_id' => $t{tissue_sample} }, { join => 'subject' })->all ];
}

scenario 'RCBD: occurrences are rebuilt and design groups/blocks preserved; descendants follow their plot' => sub {
    my $ac = $rcbd_change->();
    my $plants = plants_of($plot_a->{plot_id});
    is(scalar(@$plants), 2, 'two plants');
    my $samples = tissue_samples_of($plants);
    is(scalar(@$samples), 2, 'two tissue samples');

    my $physical={map {$_->{plot_id}=>[$_->{design_replicate},$_->{block}]} values %{$ac->load_units}};
    my $plan = $ac->apply($ac->changes_for_stock(stock_id('review_rcbd_acc_A'), stock_id('review_rcbd_acc_B')));
    ok(@{$plan->{replicates}}>0,'RCBD merge rebuilds accession occurrences');
    my $units = $ac->load_units();
    foreach my $u (values %$units) {
        is_deeply([$u->{design_replicate},$u->{block}],$physical->{$u->{plot_id}},"$u->{plot_name}: actual design group and block preserved");
    }
    is_deeply([sort {$a<=>$b} map {$_->{replicate}} grep {$_->{stock_name} eq 'review_rcbd_acc_B'} values %$units],[1..4],'merged accession has four occurrences independent of its two design groups');
    my $plot = $units->{ $plot_a->{plot_id} };
    is($plot->{stock_name}, 'review_rcbd_acc_B', 'accession changed');
    (my $expected = $plot_a->{plot_name}) =~ s/review_rcbd_acc_A/review_rcbd_acc_B/;
    is($plot->{plot_name}, $expected, 'plot renamed: '.$expected);
    is_deeply(plants_of($plot_a->{plot_id}), $plants, 'the plants stay in the plot');
    foreach my $plant_id (@$plants) {
        is(linked_stock($plant_id, 'plant_of'), 'review_rcbd_acc_B', 'plant '.name_of($plant_id).' has the new accession');
        like(name_of($plant_id), qr/^\Q$expected\E_plant_/, 'plant renamed with the plot');
    }
    foreach my $sample_id (@$samples) {
        is(linked_stock($sample_id, 'tissue_sample_of'), 'review_rcbd_acc_B', 'tissue sample '.name_of($sample_id).' has the new accession');
        like(name_of($sample_id), qr/^\Q$expected\E_/, 'tissue sample renamed with the plot');
    }
    my $design = cached_design($rcbd_id);
    is($design->{$expected}->{accession_name}, 'review_rcbd_acc_B', 'cached layout');
    is_deeply([ sort @{ $design->{$expected}->{plant_names} } ], [ sort map { name_of($_) } @$plants ], 'cached layout has the new plant names');
};

scenario 'RCBD: the check mark of a plant follows its plot where the plant has one' => sub {
    my $ac = $rcbd_change->();
    my @units = values %{ $ac->load_units() };
    prop($_->{plot_id}, 'is_a_control', 1) for grep { $_->{stock_name} eq 'review_rcbd_acc_A' } @units;
    my ($plot_b) = grep { $_->{stock_name} eq 'review_rcbd_acc_B' } @units;
    my $plants = plants_of($plot_b->{plot_id});
    ok(scalar(@$plants) >= 2, 'the plot has plants');
    prop($plants->[0], 'is_a_control', 0);   # a plant with a mark; the others have none, as plants are created
    $ac->apply([ { plot_id => $plot_b->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_A') } ], { rename_plots => 'none' });
    is(is_check($plot_b->{plot_id}), 1, 'the plot of B with A is a check plot');
    is_deeply([ map { is_check($_) } @$plants ], [ 1, map { 0 } @$plants[1 .. $#$plants] ], 'the plant with a mark is a check plant, the others stay without a mark');
    is(prop($plants->[1], 'is_a_control'), undef, 'no mark is added');
    $ac->apply([ { plot_id => $plot_b->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_B') } ], { rename_plots => 'none' });
    is_deeply([ is_check($plot_b->{plot_id}), map { prop($_, 'is_a_control') } @$plants ], [ 0, map { undef } @$plants ], 'back to a test plot: the marks of the plot and its plants go');
};

scenario 'RCBD: swap the accessions of two plots, as Substitute does' => sub {
    my ($plot_b) = grep { $_->{stock_name} eq 'review_rcbd_acc_B' && $_->{block} == 1 } @rcbd_plots;
    my $ac = $rcbd_change->();
    # the stocks the caller read: a plot that has another stock now is not swapped over the other change
    my $stale = $ac->plan([ { plot_id => $plot_a->{plot_id}, new_stock_id => $plot_b->{stock_id}, old_stock_id => $plot_b->{stock_id} }, { plot_id => $plot_b->{plot_id}, new_stock_id => $plot_a->{stock_id}, old_stock_id => $plot_b->{stock_id} } ]);
    is_deeply($stale->{errors}, [ "Plot $plot_a->{plot_name} was changed by someone else in the meantime (it has review_rcbd_acc_A now); nothing was changed." ], 'a change with another old stock than the plot has is refused');
    $ac->apply([ { plot_id => $plot_a->{plot_id}, new_stock_id => $plot_b->{stock_id} }, { plot_id => $plot_b->{plot_id}, new_stock_id => $plot_a->{stock_id} } ]);
    my $units = $ac->load_units();
    is($units->{ $plot_a->{plot_id} }->{stock_name}, 'review_rcbd_acc_B', 'first plot');
    is($units->{ $plot_b->{plot_id} }->{stock_name}, 'review_rcbd_acc_A', 'second plot');
    is_deeply([ map { $units->{ $_->{plot_id} }->{plot_number} } ($plot_a, $plot_b) ], [ $plot_a->{plot_number}, $plot_b->{plot_number} ], 'plot numbers kept');
    is_deeply([ map { linked_stock($_, 'plant_of') } @{ plants_of($plot_a->{plot_id}) } ], [ 'review_rcbd_acc_B', 'review_rcbd_acc_B' ], 'plants of the first plot');
};

scenario 'RCBD: apply holds the trial until the change is committed, so that two corrections are not planned on the same old state' => sub {
    my $ac = $rcbd_change->();
    $ac->apply([ { plot_id => $plot_a->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_C') } ], { rename_plots => 'none' });
    # this scenario runs in a transaction that is not committed yet, as a change is while it is applied
    my $other = $f->dbh;   # another connection
    $other->begin_work;
    my ($free) = $other->selectrow_array("SELECT pg_try_advisory_xact_lock(hashtext('CXGN::Trial::AccessionChange'), ?)", undef, $rcbd_id);
    ok(!$free, 'another change of the trial waits');
    ($free) = $other->selectrow_array("SELECT pg_try_advisory_xact_lock(hashtext('CXGN::Trial::AccessionChange'), ?)", undef, $trial_id);
    ok($free, 'a change of another trial does not');
    $other->rollback;
};

scenario 'RCBD: a plot that someone else changed after the preview is not changed over their head' => sub {
    my $ac = $rcbd_change->();
    my $changes = [ { plot_id => $plot_a->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_C') } ];
    my $digest = $ac->summary($ac->plan($changes, { rename_plots => 'none' }))->{plan_digest};   # the preview said A -> C
    $schema->resultset('Stock::StockRelationship')->search({ subject_id => $plot_a->{plot_id}, type_id => $t{plot_of} })->update({ object_id => stock_id('review_rcbd_acc_B') });
    dies_with(sub { $ac->apply($changes, { rename_plots => 'none', plan_digest => $digest }) }, qr/The trial changed after the preview/, 'the same change, from another accession now (B -> C), is refused');
    is(linked_stock($plot_a->{plot_id}, 'plot_of'), 'review_rcbd_acc_B', 'the other change stays');
};

scenario 'RCBD: a well of a genotyping plate taken from the plot gets the accession too, and the plate layout is cached again' => sub {
    my $plate = $schema->resultset('Project::Project')->create({ name => 'review_plate_of_rcbd', description => 'AccessionChange.t' });
    $schema->resultset('Project::Projectprop')->create({ project_id => $plate->project_id, type_id => cvterm_id('design', 'project_property'), value => 'genotyping_plate' });
    my $geolocation = $schema->resultset('NaturalDiversity::NdGeolocation')->search({})->first;
    my $experiment = $schema->resultset('NaturalDiversity::NdExperiment')->create({ nd_geolocation_id => $geolocation->nd_geolocation_id, type_id => $t{genotyping_layout} });
    $experiment->create_related('nd_experiment_projects', { project_id => $plate->project_id });
    my $well = $schema->resultset('Stock::Stock')->create({ uniquename => 'review_plate_well_A01', name => 'review_plate_well_A01', type_id => $t{tissue_sample}, organism_id => stock('test_accession1')->organism_id });
    $experiment->create_related('nd_experiment_stocks', { stock_id => $well->stock_id, type_id => $t{genotyping_layout} });
    $schema->resultset('Stock::StockRelationship')->create({ subject_id => $well->stock_id, object_id => $plot_a->{plot_id}, type_id => $t{tissue_sample_of} });
    $schema->resultset('Stock::StockRelationship')->create({ subject_id => $well->stock_id, object_id => $plot_a->{stock_id}, type_id => $t{tissue_sample_of} });
    prop($well->stock_id, 'plot_number', 'A01');
    my $plate_well = sub { return (values %{ CXGN::Trial::TrialLayout->new({ schema => $schema, trial_id => $plate->project_id, experiment_type => 'genotyping_layout' })->get_design() })[0]; };
    CXGN::Trial::TrialLayout->new({ schema => $schema, trial_id => $plate->project_id, experiment_type => 'genotyping_layout' })->generate_and_cache_layout();
    is($plate_well->()->{accession_name}, 'review_rcbd_acc_A', 'the cached plate layout has the accession of the well');

    my $ac = $rcbd_change->();
    my $refused = $ac->plan([ { plot_id => $plot_a->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_C') } ], { curator => 0 });
    ok((grep { /^1 sample\(s\) in other trials were taken from these plots \(for example review_plate_well_A01 from plot .*\); they would get the new accession too, so only a curator can make this change\.$/ } @{$refused->{errors}}), 'a user who is not a curator cannot change it: the plate belongs to another trial') or diag(explain $refused->{errors});
    my $plan = $ac->apply([ { plot_id => $plot_a->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_C') } ], { curator => 1 });
    ok((grep { /^1 sample\(s\) of plot .* in other trials \(for example review_plate_well_A01\) get review_rcbd_acc_C too\.$/ } @{$plan->{warnings}}), 'the plan names the well') or diag(explain $plan->{warnings});
    is_deeply([ map { $_->{name} } @{$plan->{external_samples}} ], [ 'review_plate_well_A01' ], 'and lists it');
    is(linked_stock($well->stock_id, 'tissue_sample_of'), 'review_rcbd_acc_C', 'the well gets the accession too: it was taken from what grew in the plot');
    is(name_of($well->stock_id), 'review_plate_well_A01', 'and keeps its name');
    is($plate_well->()->{accession_name}, 'review_rcbd_acc_C', 'the cached plate layout has the new accession');
};

scenario 'RCBD: a change that breaks the design is allowed, with a warning; an accession not in the trial and a swap inside a block are not warned about' => sub {
    my ($plot_b) = grep { $_->{stock_name} eq 'review_rcbd_acc_B' && $_->{block} == $plot_a->{block} } @rcbd_plots;
    my $ac = $rcbd_change->();
    my $design_warnings = sub { return [ grep { /^Design: / } @{ $_[0]->{warnings} } ] };
    my $plan = $ac->plan([ { plot_id => $plot_b->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_A') } ], { rename_plots => 'none' });
    is_deeply($plan->{errors}, [], 'allowed') or diag(join("\n", @{$plan->{errors}}));
    my $text = join("\n", @{ $design_warnings->($plan) });
    like($text, qr/^Design: review_rcbd_acc_A will be in more than one plot of block $plot_a->{block}: in this design \(RCBD\) each accession is once in each block/m, 'twice in a block');
    like($text, qr/^Design: Every accession had (\d+) plot\(s\); after the change review_rcbd_acc_A has \d+\. The design is no longer balanced/m, 'more plots than the others');
    like($text, qr/^Design: To keep the design, use an accession that is not in the trial yet, or mark the plot as not planted/m, 'and the alternatives');
    is_deeply($design_warnings->($ac->plan([ { plot_id => $plot_b->{plot_id}, new_stock_id => $acc{1} } ], { rename_plots => 'none' })), [], 'an accession that is not in the trial: no design warning');
    is_deeply($design_warnings->($ac->plan($ac->changes_for_stock(stock_id('review_rcbd_acc_B'), $acc{1}), { rename_plots => 'none' })), [], 'Replace Accession by an accession that is not in the trial: no design warning');
    like(join("\n", @{ $design_warnings->($ac->plan($ac->changes_for_stock(stock_id('review_rcbd_acc_B'), stock_id('review_rcbd_acc_A')), { rename_plots => 'none' })) }), qr/^Design: review_rcbd_acc_B will have no plot left in this trial/m, 'merging an accession into another one of the trial: it leaves the trial');
    prop($plot_b->{plot_id}, 'not_planted', 1);
    like(join("\n", @{ $design_warnings->($ac->plan([ { plot_id => $plot_a->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_B') } ], { rename_plots => 'none' })) }), qr/^Design: Every accession had \d+ plot\(s\); after the change review_rcbd_acc_B has/m, 'a plot that was not planted still counts as a place of the design');
    is_deeply($design_warnings->($ac->plan([ { plot_id => $plot_a->{plot_id}, new_stock_id => $plot_b->{stock_id} }, { plot_id => $plot_b->{plot_id}, new_stock_id => $plot_a->{stock_id} } ], { rename_plots => 'none' })), [], 'two plots of a block swap their accessions: no design warning');
    $plan = $ac->apply([ { plot_id => $plot_b->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_A') } ], { rename_plots => 'none' });
    is($ac->load_units()->{ $plot_b->{plot_id} }->{stock_name}, 'review_rcbd_acc_A', 'and applied after the warning');
    is_deeply([@{$ac->load_units()->{$plot_b->{plot_id}}}{qw(design_replicate block)}],[@$plot_b{qw(design_replicate block)}],'the recorded design group and block stay with the physical plot');
};

scenario 'RCBD: the plants and tissue samples of a rejected plot are left out too; the storage path names the same units' => sub {
    my ($plot_b) = grep { $_->{stock_name} eq 'review_rcbd_acc_B' && $_->{block} == 1 } @rcbd_plots;
    my $plants = plants_of($plot_a->{plot_id});
    my @samples = map { $_->subject_id } $schema->resultset('Stock::StockRelationship')->search({ object_id => { -in => $plants }, type_id => $t{tissue_sample_of} })->all;
    ok(scalar(@$plants) && scalar(@samples), 'the plot has plants with tissue samples');
    my $ac = $rcbd_change->();
    $ac->apply([ { plot_id => $plot_a->{plot_id}, rejected => 1 } ], { rename_plots => 'none' });
    is_deeply([ map { prop($_, 'rejected') } @$plants ], [ map { undef } @$plants ], 'the property is on the plot only');
    my $ids = CXGN::Phenotypes::RejectedUnits->ids($schema, [ $plot_a->{plot_id}, @$plants, @samples, $plot_b->{plot_id}, $plot_a->{stock_id} ]);
    is_deeply([ sort { $a <=> $b } keys %$ids ], [ sort { $a <=> $b } ($plot_a->{plot_id}, @$plants, @samples) ], 'the rejected units: the plot, its plants and their samples; not another plot, not the accession');
    my $trait = 'dry matter content percentage|CO_334:0000092';
    my $store = phenotype_store({ map { name_of($_) => { $trait => [ 1, '' ] } } ($plot_a->{plot_id}, @$plants, @samples, $plot_b->{plot_id}) }, [ $trait ]);
    is_deeply([ sort @{ $store->rejected_units() } ], [ sort map { name_of($_) } ($plot_a->{plot_id}, @$plants, @samples) ], 'rejected_units() of the storage path names the same units');
    $store->store();
    my $trait_id = SGN::Model::Cvterm->get_cvterm_row_from_trait_name($schema, $trait)->cvterm_id;
    foreach my $level ([ 'plant', $plants ], [ 'tissue_sample', \@samples ]) {
        my ($data_level, $units) = @$level;
        my $found = sub { my ($data) = CXGN::Phenotypes::SearchFactory->instantiate('Native', { bcs_schema => $schema, data_level => $data_level, trial_list => [ $rcbd_id ], trait_list => [ $trait_id ], @_ })->search(); my %with_value = map { $_->{obsunit_stock_id} => 1 } grep { defined($_->{phenotype_value}) } @$data; return scalar(grep { $with_value{$_} } @$units); };
        is_deeply([ $found->(), $found->(exclude_rejected => 0) ], [ 0, scalar(@$units) ], "Native at the $data_level level: the values of the rejected plot's units are left out, and there when asked");
    }
};


    ok((grep { /^1 sample\(s\) in other trials were taken from these plots \(for example review_plate_well_A01 from plot .*\); they would get the new accession too, so only a curator can make this change\.$/ } @{$refused->{errors}}), 'a user who is not a curator cannot change it: the plate belongs to another trial') or diag(explain $refused->{errors});
    my $plan = $ac->apply([ { plot_id => $plot_a->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_C') } ], { curator => 1 });
    ok((grep { /^1 sample\(s\) of plot .* in other trials \(for example review_plate_well_A01\) get review_rcbd_acc_C too\.$/ } @{$plan->{warnings}}), 'the plan names the well') or diag(explain $plan->{warnings});
    is_deeply([ map { $_->{name} } @{$plan->{external_samples}} ], [ 'review_plate_well_A01' ], 'and lists it');
    is(linked_stock($well->stock_id, 'tissue_sample_of'), 'review_rcbd_acc_C', 'the well gets the accession too: it was taken from what grew in the plot');
    is(name_of($well->stock_id), 'review_plate_well_A01', 'and keeps its name');
    is($plate_well->()->{accession_name}, 'review_rcbd_acc_C', 'the cached plate layout has the new accession');
};


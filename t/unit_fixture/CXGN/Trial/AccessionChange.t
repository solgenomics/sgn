    my $plan = $change->()->apply([ { plot_id => $plot{5}, not_planted => 1 } ]);
    is($plan->{not_planted_phenotypes}, 0, 'the treatment is not a phenotype of what grew there');
    is($treatments_of->($plot{5}), 1, 'and stays');


like($plot_a->{plot_name}, qr/^review_rcbd_trial-rep1-review_rcbd_acc_A_\d+$/, 'default RCBD plot name: '.$plot_a->{plot_name});

sub plants_of { my $plot_id = shift; return [ sort map { $_->object_id } $schema->resultset('Stock::StockRelationship')->search({ subject_id => $plot_id, type_id => $t{plant_of} })->all ]; }
sub tissue_samples_of {
    my $parent_ids = shift;
    return [ sort map { $_->subject_id } $schema->resultset('Stock::StockRelationship')->search({ 'me.object_id' => { -in => $parent_ids }, 'me.type_id' => $t{tissue_sample_of}, 'subject.type_id' => $t{tissue_sample} }, { join => 'subject' })->all ];
}

scenario 'RCBD: blocks are kept, the replicates of the merged accession are numbered again; plants and tissue samples follow their plot' => sub {
    my $ac = $rcbd_change->();
    my $plants = plants_of($plot_a->{plot_id});
    is(scalar(@$plants), 2, 'two plants');
    my $samples = tissue_samples_of($plants);
    is(scalar(@$samples), 2, 'two tissue samples');
    my %block_before = map { $_->{plot_id} => $_->{block} } values %{ $ac->load_units() };

    my $plan = $ac->apply($ac->changes_for_stock(stock_id('review_rcbd_acc_A'), stock_id('review_rcbd_acc_B')));
    ok(scalar(@{$plan->{replicates}}) > 0, 'RCBD: replicates of review_rcbd_acc_B numbered again');
    my $units = $ac->load_units();
    is($units->{$_}->{block}, $block_before{$_}, "$units->{$_}->{plot_name}: block kept") for sort keys %block_before;
    my @b_plots = sort { $a->{plot_number} <=> $b->{plot_number} } grep { $_->{stock_name} eq 'review_rcbd_acc_B' } values %$units;
    is(scalar(@b_plots), 4, 'review_rcbd_acc_B is in four plots');
    is_deeply([ map { $_->{replicate} } @b_plots ], [ 1 .. 4 ], 'its replicates are 1..4 by plot number');
    foreach my $u (grep { $_->{stock_name} ne 'review_rcbd_acc_B' } values %$units) {
        is($u->{replicate}, $u->{block}, "$u->{plot_name}: an accession not involved keeps its replicate");
    }
    my $new_replicate = $units->{ $plot_a->{plot_id} }->{replicate};
    foreach my $id (@$plants, @$samples) {
        my $rep = prop($id, 'replicate');
        is($rep, $new_replicate, name_of($id).' has the replicate of its plot') if defined $rep;
    }
    my $plot = $units->{ $plot_a->{plot_id} };
    is($plot->{stock_name}, 'review_rcbd_acc_B', 'accession changed');
    (my $expected = $plot_a->{plot_name}) =~ s/review_rcbd_acc_A/review_rcbd_acc_B/;
    is($plot->{plot_name}, $expected, 'plot renamed: '.$expected);
    is_deeply(plants_of($plot_a->{plot_id}), $plants, 'the plants stay in the plot');
    foreach my $plant_id (@$plants) {
        is(linked_stock($plant_id, 'plant_of'), 'review_rcbd_acc_B', 'plant '.name_of($plant_id).' has the new accession');
        like(name_of($plant_id), qr/^\Q$expected\E_plant_/, 'plant renamed with the plot');
    }
    foreach my $sample_id (@$samples) {
        is(linked_stock($sample_id, 'tissue_sample_of'), 'review_rcbd_acc_B', 'tissue sample '.name_of($sample_id).' has the new accession');
        like(name_of($sample_id), qr/^\Q$expected\E_/, 'tissue sample renamed with the plot');
    }
    my $design = cached_design($rcbd_id);
    is($design->{$expected}->{accession_name}, 'review_rcbd_acc_B', 'cached layout');
    is_deeply([ sort @{ $design->{$expected}->{plant_names} } ], [ sort map { name_of($_) } @$plants ], 'cached layout has the new plant names');
};

scenario 'RCBD: the check mark of a plant follows its plot where the plant has one' => sub {
    my $ac = $rcbd_change->();
    my @units = values %{ $ac->load_units() };
    prop($_->{plot_id}, 'is_a_control', 1) for grep { $_->{stock_name} eq 'review_rcbd_acc_A' } @units;
    my ($plot_b) = grep { $_->{stock_name} eq 'review_rcbd_acc_B' } @units;
    my $plants = plants_of($plot_b->{plot_id});
    ok(scalar(@$plants) >= 2, 'the plot has plants');
    prop($plants->[0], 'is_a_control', 0);   # a plant with a mark; the others have none, as plants are created
    $ac->apply([ { plot_id => $plot_b->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_A') } ], { rename_plots => 'none' });
    is(is_check($plot_b->{plot_id}), 1, 'the plot of B with A is a check plot');
    is_deeply([ map { is_check($_) } @$plants ], [ 1, map { 0 } @$plants[1 .. $#$plants] ], 'the plant with a mark is a check plant, the others stay without a mark');
    is(prop($plants->[1], 'is_a_control'), undef, 'no mark is added');
    $ac->apply([ { plot_id => $plot_b->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_B') } ], { rename_plots => 'none' });
    is_deeply([ is_check($plot_b->{plot_id}), map { prop($_, 'is_a_control') } @$plants ], [ 0, map { undef } @$plants ], 'back to a test plot: the marks of the plot and its plants go');
};

scenario 'RCBD: swap the accessions of two plots, as Substitute does' => sub {
    my ($plot_b) = grep { $_->{stock_name} eq 'review_rcbd_acc_B' && $_->{block} == 1 } @rcbd_plots;
    my $ac = $rcbd_change->();
    # the stocks the caller read: a plot that has another stock now is not swapped over the other change
    my $stale = $ac->plan([ { plot_id => $plot_a->{plot_id}, new_stock_id => $plot_b->{stock_id}, old_stock_id => $plot_b->{stock_id} }, { plot_id => $plot_b->{plot_id}, new_stock_id => $plot_a->{stock_id}, old_stock_id => $plot_b->{stock_id} } ]);
    is_deeply($stale->{errors}, [ "Plot $plot_a->{plot_name} was changed by someone else in the meantime (it has review_rcbd_acc_A now); nothing was changed." ], 'a change with another old stock than the plot has is refused');
    $ac->apply([ { plot_id => $plot_a->{plot_id}, new_stock_id => $plot_b->{stock_id} }, { plot_id => $plot_b->{plot_id}, new_stock_id => $plot_a->{stock_id} } ]);
    my $units = $ac->load_units();
    is($units->{ $plot_a->{plot_id} }->{stock_name}, 'review_rcbd_acc_B', 'first plot');
    is($units->{ $plot_b->{plot_id} }->{stock_name}, 'review_rcbd_acc_A', 'second plot');
    is_deeply([ map { $units->{ $_->{plot_id} }->{plot_number} } ($plot_a, $plot_b) ], [ $plot_a->{plot_number}, $plot_b->{plot_number} ], 'plot numbers kept');
    is_deeply([ map { linked_stock($_, 'plant_of') } @{ plants_of($plot_a->{plot_id}) } ], [ 'review_rcbd_acc_B', 'review_rcbd_acc_B' ], 'plants of the first plot');
};

scenario 'RCBD: apply holds the trial until the change is committed, so that two corrections are not planned on the same old state' => sub {
    my $ac = $rcbd_change->();
    $ac->apply([ { plot_id => $plot_a->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_C') } ], { rename_plots => 'none' });
    # this scenario runs in a transaction that is not committed yet, as a change is while it is applied
    my $other = $f->dbh;   # another connection
    $other->begin_work;
    my ($free) = $other->selectrow_array("SELECT pg_try_advisory_xact_lock(hashtext('CXGN::Trial::AccessionChange'), ?)", undef, $rcbd_id);
    ok(!$free, 'another change of the trial waits');
    ($free) = $other->selectrow_array("SELECT pg_try_advisory_xact_lock(hashtext('CXGN::Trial::AccessionChange'), ?)", undef, $trial_id);
    ok($free, 'a change of another trial does not');
    $other->rollback;
};

scenario 'RCBD: a plot that someone else changed after the preview is not changed over their head' => sub {
    my $ac = $rcbd_change->();
    my $changes = [ { plot_id => $plot_a->{plot_id}, new_stock_id => stock_id('review_rcbd_acc_C') } ];
    my $digest = $ac->summary($ac->plan($changes, { rename_plots => 'none' }))->{plan_digest};   # the preview said A -> C
    $schema->resultset('Stock::StockRelationship')->search({ subject_id => $plot_a->{plot_id}, type_id => $t{plot_of} })->update({ object_id => stock_id('review_rcbd_acc_B') });
    dies_with(sub { $ac->apply($changes, { rename_plots => 'none', plan_digest => $digest }) }, qr/The trial changed after the preview/, 'the same change, from another accession now (B -> C), is refused');
    is(linked_stock($plot_a->{plot_id}, 'plot_of'), 'review_rcbd_acc_B', 'the other change stays');
};

scenario 'RCBD: a well of a genotyping plate taken from the plot gets the accession too, and the plate layout is cached again' => sub {
    my $plate = $schema->resultset('Project::Project')->create({ name => 'review_plate_of_rcbd', description => 'AccessionChange.t' });

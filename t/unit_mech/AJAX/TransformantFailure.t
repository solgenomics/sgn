use strict;
use warnings;
use lib 't/lib';
use Test::More;
use Test::WWW::Mechanize;
use JSON;
use HTML::Entities qw(encode_entities);
use File::Temp qw(tempfile);
use LWP::UserAgent;
use SGN::Test::Fixture;
use SGN::Model::Cvterm;
use CXGN::List;
use CXGN::People::Person;
use CXGN::Transformation::AddTransformant;

my $f = SGN::Test::Fixture->new;
my $schema = $f->bcs_schema;
my $dbh = $schema->storage->dbh;
my $seed = $schema->resultset('Stock::Stock')->find({uniquename => 'test_accession1'});
my $program = $schema->resultset('Project::Project')->find({name => 'test'});
BAIL_OUT('Required standard fixture stocks/program missing') unless $seed && $program;
my %type = map {$_ => SGN::Model::Cvterm->get_cvterm_row($schema, $_, 'stock_type')->cvterm_id}
    qw(accession transformation vector_construct tracking_identifier);
my %role = map {$_ => SGN::Model::Cvterm->get_cvterm_row($schema, $_, 'stock_relationship')->cvterm_id}
    qw(plant_material_of vector_construct_of material_of);
my @owned;
my $cleanup_complete;
sub stock {
    my ($name, $kind) = @_;
    my $row = $schema->resultset('Stock::Stock')->create({name => $name, uniquename => $name,
        type_id => $type{$kind}, organism_id => $seed->organism_id});
    push @owned, $row;
    return $row;
}
my $vector = stock('transformant_source_failure_vector', 'vector_construct');
my @sources;
for my $number (1, 2) {
    my $source = stock('transformant_source_failure_'.$number, 'transformation');
    for my $edge ([$seed, 'plant_material_of'], [$vector, 'vector_construct_of']) {
        $schema->resultset('Stock::StockRelationship')->create({object_id => $source->stock_id,
            subject_id => $edge->[0]->stock_id, type_id => $role{$edge->[1]}});
    }
    push @sources, $source;
}
my $tracking = stock('transformant_source_tracking', 'tracking_identifier');
my $tracking_link = $schema->resultset('Stock::StockRelationship')->create({subject_id => $sources[0]->stock_id,
    object_id => $tracking->stock_id, type_id => $role{material_of}});
my $metadata_type = SGN::Model::Cvterm->get_cvterm_row($schema,
    'transformant_autogenerated_name_metadata', 'project_property')->cvterm_id;
my @metadata = $program->projectprops({type_id => $metadata_type})->all;
BAIL_OUT('Ambiguous fixture naming metadata') if @metadata > 1;
my $metadata_was_present = @metadata ? 1 : 0;
my $original_metadata = @metadata ? $metadata[0]->value : undef;
my $formats = defined($original_metadata) ? decode_json($original_metadata) : {};
BAIL_OUT('Fixture naming metadata must be an object') unless ref($formats) eq 'HASH';
my $format = 'transformant_failure_regression_format';
$formats->{$format} = {name_attributes => [{text => 'transformant_failure_direct_'}], last_serial_number => 0};
my $metadata_failure_format = 'transformant_metadata_failure_format';
$formats->{$metadata_failure_format} = {name_attributes => [{text => 'transformant_allowed_metadata_'}], last_serial_number => 0};
my $tracking_format = 'transformant_tracking_failure_format';
$formats->{$tracking_format} = {name_attributes => [{text => 'transformant_allowed_tracking_'}], last_serial_number => 0};
my $count_format = 'transformant_count_guard_format';
$formats->{$count_format} = {name_attributes => [{text => 'transformant_allowed_count_'}], last_serial_number => 5};
my $metadata_row = @metadata ? $metadata[0] : $program->create_related('projectprops', {type_id => $metadata_type, value => '{}'});
$metadata_row->update({value => encode_json($formats)});
sub serial {
    my $selected_format = shift || $format;
    return decode_json($metadata_row->discard_changes->value)->{$selected_format}{last_serial_number};
}
my $mech = Test::WWW::Mechanize->new(timeout => 30);
$mech->post_ok('http://localhost:3010/brapi/v1/token',
    [username => 'janedoe', password => 'secretpw', grant_type => 'password']);
my $session = decode_json($mech->content)->{access_token};
BAIL_OUT('Fixture login did not produce a session') unless $session;
my $owner = CXGN::People::Person->get_person_by_username($f->dbh, 'janedoe');
my $list_id = CXGN::List::create_list($f->dbh, 'transformant_failure_names', 'factory rejection regression', $owner);
my $list = CXGN::List->new({dbh => $f->dbh, list_id => $list_id});
$list->type('accessions');
$list->add_bulk(['transformant_failure_list']);

my $trigger_installed;
sub remove_trigger {
    return unless $trigger_installed;
    $dbh->do('DROP TRIGGER IF EXISTS parentage_transformant_tracking_failure ON stockprop');
    $dbh->do('DROP FUNCTION IF EXISTS public.parentage_transformant_tracking_failure()');
    $dbh->do('DROP TRIGGER IF EXISTS parentage_transformant_owner_failure ON phenome.stock_owner');
    $dbh->do('DROP FUNCTION IF EXISTS public.parentage_transformant_owner_failure()');
    $dbh->do('DROP TRIGGER IF EXISTS parentage_transformant_metadata_failure ON projectprop');
    $dbh->do('DROP FUNCTION IF EXISTS public.parentage_transformant_metadata_failure()');
    $dbh->do('DROP TRIGGER IF EXISTS parentage_transformant_failure ON stock');
    $dbh->do('DROP FUNCTION IF EXISTS public.parentage_transformant_failure()');
    $dbh->do('DROP SEQUENCE IF EXISTS public.parentage_transformant_failure_probe');
    $trigger_installed = 0;
}
$dbh->do('CREATE SEQUENCE public.parentage_transformant_failure_probe');
$trigger_installed = 1;
$dbh->do(q{CREATE FUNCTION public.parentage_transformant_failure() RETURNS trigger LANGUAGE plpgsql AS $$
    BEGIN
        IF NEW.uniquename LIKE 'transformant_failure_%' THEN
            PERFORM nextval('public.parentage_transformant_failure_probe');
            RAISE EXCEPTION 'transformant failure regression marker';
        END IF;
        RETURN NEW;
    END $$});
$dbh->do('CREATE TRIGGER parentage_transformant_failure BEFORE INSERT ON stock FOR EACH ROW EXECUTE PROCEDURE public.parentage_transformant_failure()');
sub attempts {
    return $dbh->selectrow_array('SELECT CASE WHEN is_called THEN last_value ELSE 0 END FROM public.parentage_transformant_failure_probe');
}
sub decode_response {
    my ($response) = @_;
    return eval {decode_json($response->decoded_content)} || {http_status => $response->code};
}
sub post {
    my ($route, $params) = @_;
    return decode_response($mech->post('http://localhost:3010'.$route, $params));
}
sub upload {
    my ($rows) = @_;
    my ($fh, $path) = tempfile(SUFFIX => '.tsv', UNLINK => 1);
    print {$fh} "transformation_identifier\ttransgenic_line_name\n";
    print {$fh} join("\t", @$_)."\n" for @$rows;
    close $fh;
    my $ua = LWP::UserAgent->new(timeout => 30);
    return decode_response($ua->post('http://localhost:3010/ajax/transformation/upload_transgenic_lines',
        Content_Type => 'form-data', Content => [
            transgenic_lines_upload_file => [$path, 'transformant_failure.tsv', Content_Type => 'text/tab-separated-values'],
            project_breeding_program_name => 'test', sgn_session_id => $session,
        ]));
}
sub absent {
    return $schema->resultset('Stock::Stock')->search({uniquename => $_[0]})->count == 0;
}

subtest 'real model returns its transactional failure instead of throwing' => sub {
    my $before = attempts();
    my $result = CXGN::Transformation::AddTransformant->new(schema => $schema,
        phenome_schema => $f->phenome_schema, dbh => $f->dbh,
        transformation_stock_id => $sources[0]->stock_id,
        transformant_names => ['transformant_failure_factory'], owner_id => $owner)->add_transformant;
    ok($result->{error}, 'the unchanged real factory returns an error object');
    is(attempts(), $before + 1, 'controlled trigger executed inside the real factory');
    ok(absent('transformant_failure_factory'), 'factory rollback leaves no child');
};

subtest 'direct caller propagates factory failure before advancing its naming counter' => sub {
    my $before = attempts();
    my $result = post('/ajax/transformation/add_transformants', [
        transformation_stock_id => $sources[0]->stock_id, new_name_count => 1,
        name_format => $format, program_id => $program->project_id, program_name => 'test',
        source_info => '{}', last_number => 0,
    ]);
    diag('direct response: '.encode_json($result));
    is(attempts(), $before + 1, 'direct HTTP request reached the rejecting factory');
    ok(!$result->{success} && $result->{error}, 'direct HTTP result reports failure');
    ok(absent('transformant_failure_direct_1'), 'direct rollback stores no child');
    is(serial(), 0, 'failed creation does not consume naming serial numbers');
};

subtest 'list caller propagates a real factory rejection' => sub {
    my $before = attempts();
    my $result = post('/ajax/transformation/add_transformants_using_list', [
        transformation_name => $sources[0]->uniquename, list_id => $list_id, program_name => 'test',
    ]);
    diag('list response: '.encode_json($result));
    is(attempts(), $before + 1, 'list HTTP request reached the rejecting factory');
    ok(!$result->{success} && $result->{error}, 'list HTTP result reports failure');
    is($result->{error_string}, encode_entities($result->{error} // ''), 'legacy list consumer receives an escaped error_string');
    ok(absent('transformant_failure_list'), 'list rollback stores no child');
};

subtest 'file caller propagates a real factory rejection' => sub {
    my $before = attempts();
    my $result = upload([[$sources[0]->uniquename, 'transformant_failure_upload']]);
    diag('upload response: '.encode_json($result));
    is(attempts(), $before + 1, 'file HTTP request reached the rejecting factory');
    ok(!$result->{success} && $result->{error}, 'upload HTTP result reports failure');
    ok(absent('transformant_failure_upload'), 'upload rollback stores no child');
};

subtest 'multi-ID upload rolls back all groups and owners on a later failure' => sub {
    my $before = attempts();
    my $owners_before = $f->phenome_schema->resultset('StockOwner')->count;
    my $result = upload([
        [$sources[0]->uniquename, 'transformant_allowed_multigroup'],
        [$sources[1]->uniquename, 'transformant_failure_multigroup'],
    ]);
    diag('multi-ID response: '.encode_json($result));
    is(attempts(), $before + 1, 'one rejected transformation group reached the factory');
    ok(!$result->{success} && $result->{error}, 'failed file is not reported as success');
    ok(absent('transformant_allowed_multigroup'), 'earlier successful identifier is rolled back');
    ok(absent('transformant_failure_multigroup'), 'failed identifier creates no child');
    is($f->phenome_schema->resultset('StockOwner')->count, $owners_before, 'whole-file rollback leaves no owner rows');
};

subtest 'owner-insert failure rolls back the factory child and parent relationships' => sub {
    my $name = 'transformant_allowed_owner_failure';
    $dbh->do(q{CREATE FUNCTION public.parentage_transformant_owner_failure() RETURNS trigger LANGUAGE plpgsql AS $$
        BEGIN
            IF EXISTS(SELECT 1 FROM stock WHERE stock_id=NEW.stock_id AND uniquename='transformant_allowed_owner_failure') THEN
                PERFORM nextval('public.parentage_transformant_failure_probe');
                RAISE EXCEPTION 'transformant owner regression marker';
            END IF;
            RETURN NEW;
        END $$});
    $dbh->do('CREATE TRIGGER parentage_transformant_owner_failure BEFORE INSERT ON phenome.stock_owner FOR EACH ROW EXECUTE PROCEDURE public.parentage_transformant_owner_failure()');
    my $before = attempts();
    my $result;
    my $exception;
    eval {
        $result = CXGN::Transformation::AddTransformant->new(schema => $schema,
            phenome_schema => $f->phenome_schema, dbh => $f->dbh,
            transformation_stock_id => $sources[0]->stock_id,
            transformant_names => [$name], owner_id => $owner)->add_transformant;
    };
    $exception = $@;
    $dbh->do('DROP TRIGGER parentage_transformant_owner_failure ON phenome.stock_owner');
    $dbh->do('DROP FUNCTION public.parentage_transformant_owner_failure()');
    my $reported_error = $exception || ($result && $result->{error}) || '';
    diag('owner factory error: '."$reported_error");
    is(attempts(), $before + 1, 'real owner INSERT reached the rejecting trigger');
    ok($exception || ($result && $result->{error}), 'owner rejection is observable');
    ok(absent($name), 'owner failure leaves no saved child');
    my $owners = $dbh->selectrow_array(q{SELECT count(*) FROM phenome.stock_owner so JOIN stock s ON s.stock_id=so.stock_id WHERE s.uniquename=?}, undef, $name);
    is($owners, 0, 'owner failure leaves no ownership row');
};

subtest 'direct counter-update failure rolls back child and owner, then retry succeeds' => sub {
    $dbh->do(sprintf q{CREATE FUNCTION public.parentage_transformant_metadata_failure() RETURNS trigger LANGUAGE plpgsql AS $$
        BEGIN
            IF NEW.project_id=%d AND NEW.type_id=%d
                AND (NEW.value::jsonb -> 'transformant_metadata_failure_format' ->> 'last_serial_number')::integer=1 THEN
                PERFORM nextval('public.parentage_transformant_failure_probe');
                RAISE EXCEPTION 'transformant metadata regression marker';
            END IF;
            RETURN NEW;
        END $$}, $program->project_id, $metadata_type);
    $dbh->do('CREATE TRIGGER parentage_transformant_metadata_failure BEFORE UPDATE ON projectprop FOR EACH ROW EXECUTE PROCEDURE public.parentage_transformant_metadata_failure()');
    my $before = attempts();
    my @params = (transformation_stock_id => $sources[0]->stock_id, new_name_count => 1,
        name_format => $metadata_failure_format, program_id => $program->project_id, program_name => 'test',
        source_info => '{}', last_number => 0);
    my $result = post('/ajax/transformation/add_transformants', \@params);
    $dbh->do('DROP TRIGGER parentage_transformant_metadata_failure ON projectprop');
    $dbh->do('DROP FUNCTION public.parentage_transformant_metadata_failure()');
    diag('direct metadata response: '.encode_json($result));
    is(attempts(), $before + 1, 'real counter UPDATE reached the rejecting trigger');
    ok(!$result->{success} && $result->{error}, 'counter failure is a structured HTTP error');
    ok(absent('transformant_allowed_metadata_1'), 'counter failure leaves no child');
    my $owners = $dbh->selectrow_array(q{SELECT count(*) FROM phenome.stock_owner so JOIN stock s ON s.stock_id=so.stock_id WHERE s.uniquename=?}, undef, 'transformant_allowed_metadata_1');
    is($owners, 0, 'counter failure rolls back ownership too');
    is(serial($metadata_failure_format), 0, 'counter remains unchanged after its failed update');
    my $retry = post('/ajax/transformation/add_transformants', \@params);
    diag('metadata retry response: '.encode_json($retry));
    ok($retry->{success} && !$retry->{error}, 'same request succeeds after the fault is removed');
    ok(!absent('transformant_allowed_metadata_1'), 'retry creates the intended child once');
    is(serial($metadata_failure_format), 1, 'successful retry advances the counter once');
};

subtest 'expired explicit upload session cannot create transformants' => sub {
    my ($last_access) = $dbh->selectrow_array('SELECT last_access_time FROM sgn_people.sp_token WHERE cookie_string=?', undef, $session);
    ok(defined($last_access), 'test session timestamp exists');
    return unless defined $last_access;
    $dbh->do(q{UPDATE sgn_people.sp_token SET last_access_time=current_timestamp-interval '3 hours' WHERE cookie_string=?}, undef, $session);
    my ($result, $exception);
    eval { $result = upload([[$sources[0]->uniquename, 'transformant_allowed_expired_session']]); };
    $exception = $@;
    $dbh->do('UPDATE sgn_people.sp_token SET last_access_time=? WHERE cookie_string=?', undef, $last_access, $session);
    die $exception if $exception;
    diag('expired upload response: '.encode_json($result));
    ok(!$result->{success} && $result->{error}, 'expired-token upload returns an authentication error');
    ok(absent('transformant_allowed_expired_session'), 'expired-token upload stores no child');
};

subtest 'invalid generated-name counts cannot consume or rewind naming metadata' => sub {
    for my $count (0, -1, '1.5', undef) {
        my $label = defined($count) ? "$count" : 'missing';
        my $before_value = $metadata_row->discard_changes->value;
        my $before_serial = serial($count_format);
        my @params = (transformation_stock_id => $sources[0]->stock_id, name_format => $count_format,
            program_id => $program->project_id, program_name => 'test', source_info => '{}');
        push @params, new_name_count => $count if defined $count;
        my $result = post('/ajax/transformation/add_transformants', \@params);
        my $observed_serial = serial($count_format);
        # Restore the test's metadata even when the before-fix probe rewinds it.
        $metadata_row->discard_changes->update({value => $before_value});
        diag('count '.$label.' response: '.encode_json($result).'; observed serial='.$observed_serial);
        ok(!$result->{success} && $result->{error}, $label.' count returns a structured error');
        is($observed_serial, $before_serial, $label.' count cannot alter the serial counter');
        is($schema->resultset('Stock::Stock')->search({uniquename => {-like => 'transformant\\_allowed\\_count\\_%'}})->count,
            0, $label.' count creates no children');
    }
};


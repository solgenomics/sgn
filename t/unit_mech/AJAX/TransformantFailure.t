subtest 'list and complete-file retries succeed after the stock fault is removed' => sub {
    $dbh->do('DROP TRIGGER parentage_transformant_failure ON stock');
    my $list_result = post('/ajax/transformation/add_transformants_using_list', [
        transformation_name => $sources[0]->uniquename, list_id => $list_id, program_name => 'test',
    ]);
    ok($list_result->{success} && !$list_result->{error}, 'list retry succeeds');
    ok(!absent('transformant_failure_list'), 'list retry creates its child');
    my $upload_result = upload([[$sources[0]->uniquename, 'transformant_failure_upload']]);
    ok($upload_result->{success} && !$upload_result->{error}, 'single-ID file retry succeeds');
    my $both = upload([
        [$sources[0]->uniquename, 'transformant_allowed_multigroup'],
        [$sources[1]->uniquename, 'transformant_failure_multigroup'],
    ]);
    ok($both->{success} && !$both->{error}, 'same complete multi-ID file can be retried');
    for my $name ('transformant_allowed_multigroup', 'transformant_failure_multigroup') {
        my $child = $schema->resultset('Stock::Stock')->find({uniquename => $name});
        ok($child, 'retry creates '.$name);
        next unless $child;
        is($f->phenome_schema->resultset('StockOwner')->search({stock_id => $child->stock_id, sp_person_id => $owner})->count,
            1, 'retry creates exactly one standard owner row');
    }
};

subtest 'tracking-enabled direct creation rolls back every journal on failure' => sub {
    plan skip_all => 'tracking_transformation is disabled; run with explicit task-local tracking-on fixture override'
        unless $f->config->{tracking_transformation};
    my $tracking_type = SGN::Model::Cvterm->get_cvterm_row($schema, 'tracking_transformation_json', 'stock_property')->cvterm_id;
    my @base = (transformation_stock_id => $sources[0]->stock_id, name_format => $tracking_format,
        program_id => $program->project_id, program_name => 'test', source_info => '{}', last_number => 0);
    my $first = post('/ajax/transformation/add_transformants', [@base, new_name_count => 1]);
    diag('tracking positive response: '.encode_json($first));
    ok($first->{success} && !$first->{error}, 'valid owned tracking record permits direct creation');
    ok(!absent('transformant_allowed_tracking_1'), 'tracking-enabled request creates a child');
    is(serial($tracking_format), 1, 'tracking-enabled success advances the counter once');
    my $activity = $tracking->stockprops({type_id => $tracking_type})->first;
    ok($activity, 'ActivityInfo stores the transformation journal');
    return unless $activity;
    my $activity_before = $activity ? $activity->value : undef;
    my $owners_before = $f->phenome_schema->resultset('StockOwner')->count;
    my $check_rollback = sub {
        my ($result, $case) = @_;
        diag($case.' response: '.encode_json($result));
        ok(!$result->{success} && $result->{error}, $case.' is an HTTP error');
        ok(absent('transformant_allowed_tracking_2') && absent('transformant_allowed_tracking_3'), $case.' creates no children');
        is(serial($tracking_format), 1, $case.' preserves the counter');
        is($f->phenome_schema->resultset('StockOwner')->count, $owners_before, $case.' preserves owner rows');
        is($activity ? $activity->discard_changes->value : undef, $activity_before, $case.' preserves activity JSON');
    };
    $tracking_link->delete;
    $check_rollback->(post('/ajax/transformation/add_transformants', [@base, new_name_count => 2]), 'missing tracking link');
    $tracking_link = $schema->resultset('Stock::StockRelationship')->create({subject_id => $sources[0]->stock_id,
        object_id => $tracking->stock_id, type_id => $role{material_of}});
    my $other_tracking = stock('transformant_source_other_tracking', 'tracking_identifier');
    my $duplicate = $schema->resultset('Stock::StockRelationship')->create({subject_id => $sources[0]->stock_id,
        object_id => $other_tracking->stock_id, type_id => $role{material_of}});
    $check_rollback->(post('/ajax/transformation/add_transformants', [@base, new_name_count => 2]), 'duplicate tracking link');
    $duplicate->delete;
    my $rank = $tracking->stockprops({type_id => $tracking_type})->get_column('rank')->max;
    my $extra_activity = $tracking->create_related('stockprops', {type_id => $tracking_type,
        rank => defined($rank) ? $rank + 1 : 0, value => encode_json({duplicate_regression => 1})});
    my $extra_before = $extra_activity->value;
    $check_rollback->(post('/ajax/transformation/add_transformants', [@base, new_name_count => 2]), 'duplicate activity record');
    is($extra_activity->discard_changes->value, $extra_before, 'duplicate activity row remains unchanged');
    is($tracking->stockprops({type_id => $tracking_type})->count, 2, 'rejected request does not alter activity cardinality');
    $extra_activity->delete;
    $dbh->do(sprintf q{CREATE FUNCTION public.parentage_transformant_tracking_failure() RETURNS trigger LANGUAGE plpgsql AS $$
        BEGIN
            IF NEW.stock_id=%d AND NEW.type_id=%d THEN
                PERFORM nextval('public.parentage_transformant_failure_probe');
                RAISE EXCEPTION 'transformant tracking regression marker';
            END IF;
            RETURN NEW;
        END $$}, $tracking->stock_id, $tracking_type);
    $dbh->do('CREATE TRIGGER parentage_transformant_tracking_failure BEFORE INSERT OR UPDATE ON stockprop FOR EACH ROW EXECUTE PROCEDURE public.parentage_transformant_tracking_failure()');
    my $before = attempts();
    my $failed = post('/ajax/transformation/add_transformants', [@base, new_name_count => 2]);
    $dbh->do('DROP TRIGGER parentage_transformant_tracking_failure ON stockprop');
    $dbh->do('DROP FUNCTION public.parentage_transformant_tracking_failure()');
    is(attempts(), $before + 1, 'real ActivityInfo INSERT/UPDATE hit the rejecting trigger');
    $check_rollback->($failed, 'ActivityInfo write rejection');
    my $retry = post('/ajax/transformation/add_transformants', [@base, new_name_count => 2]);
    ok($retry->{success} && !$retry->{error}, 'tracking request retries successfully after the fault is removed');
    is(serial($tracking_format), 3, 'successful tracking retry consumes exactly its two names');
    ok(!absent('transformant_allowed_tracking_2') && !absent('transformant_allowed_tracking_3'), 'tracking retry creates both intended children');
};

sub cleanup_owned {
    return if $cleanup_complete;
    remove_trigger();
    if ($metadata_row) {
        my $stored = $schema->resultset('Project::Projectprop')->find($metadata_row->projectprop_id);
        if ($stored) {
            if ($metadata_was_present) { $stored->update({value => $original_metadata}); }
            else { $stored->delete; }
        }
    }
    my @children = $schema->resultset('Stock::Stock')->search({-or => [
        uniquename => {-like => 'transformant\\_allowed\\_%'}, uniquename => {-like => 'transformant\\_failure\\_%'}]})->all;
    my %seen;
    my @ids = grep {!$seen{$_}++} map {$_->stock_id} (@owned, @children);
    if (@ids) {
        $f->phenome_schema->resultset('StockOwner')->search({stock_id => {-in => \@ids}})->delete;
        $schema->resultset('Stock::StockRelationship')->search({-or => [object_id => {-in => \@ids}, subject_id => {-in => \@ids}]})->delete;
        for my $id (reverse @ids) {
            my $row = $schema->resultset('Stock::Stock')->find($id);
            $row->delete if $row;
        }
    }
    $f->clean_up_db;
    $cleanup_complete = 1;
}
cleanup_owned();
# Run Fixture::DEMOLISH while its schema attributes are still alive.
undef $f;
done_testing;
END {
    if (!$cleanup_complete && $schema && $dbh) {
        eval { cleanup_owned(); };
        warn "Could not finish transformant regression cleanup: $@" if $@;
    }
    undef $f;
}

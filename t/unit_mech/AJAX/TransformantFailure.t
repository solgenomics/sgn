    my $name = 'transformant_allowed_existing_<b> & parent';
    stock($name, 'accession');
    my $id = CXGN::List::create_list($f->dbh, 'transformant_failure_html_names', 'safe list error regression', $owner);
    my $html_list = CXGN::List->new({dbh => $f->dbh, list_id => $id});
    $html_list->type('accessions'); $html_list->add_bulk([$name]);
    my $result = post('/ajax/transformation/add_transformants_using_list', [
